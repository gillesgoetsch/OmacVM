+/*
+ * After a display change (omacvm-cocoa-fullpanel-retake.patch): a full
+ * screen the change left below the notch (the window on its display with a
+ * camera housing again, AppKit kept the menu bar's band) asks AppKit to lay
+ * its tile out again, which asks the reservation again: the whole display.
+ * Only when omacvm_fp_retake says now: the displays settled, unlocked, on
+ * its Space, WindowServer has it in place, never Split View, at most
+ * OMACVM_FP_RETAKE_TRIES per full screen and one per settle. The return
+ * check then engages ("strip taken again", "strip covered", the guest laid
+ * out again); without the whole display in OMACVM_FP_RETAKE_CHECK_S the
+ * line says so. Never a frame, a full-screen toggle or a Space.
+ */
+- (OmacVMFPRetakeFacts)retakeFacts
+{
+    NSScreen *screen = [window screen];
+    bool always = [[NSUserDefaults standardUserDefaults] boolForKey:@"AppleMenuBarVisibleInFullscreen"];
+    OmacVMFPRetakeFacts f = {
+        .inside = inside && omacvm_fullpanel_in_full_screen(window),
+        .armed = armed,
+        .entered = entered,
+        .rejected = rejected,
+        .lost = lost,
+        .display_changed = display_changed,
+        .given_up = retake_given_up,
+        .tries = retake_tries,
+        .tried_this_settle = retake_tries > 0 && retake_settle == omacvm_fullpanel_settles,
+        .pending = retake_pending,
+    };
+
+    if (!window || !screen || !f.inside || !f.armed || !f.entered || !f.display_changed) {
+        return f;   /* nothing to ask WindowServer or AppKit about */
+    }
+    f.notch = omacvm_fullpanel_notch(window);
+    f.covers = omacvm_fullpanel_covers(window);
+    f.band_kept = omacvm_fp_band_kept(omacvm_fullpanel_rect([window frame]),
+                                      omacvm_fullpanel_rect([screen frame]),
+                                      [screen safeAreaInsets].top);
+    f.display_live = omacvm_fullpanel_display_live(screen, &f.same_size);
+    f.on_space = [window isOnActiveSpace];
+    f.visible = ([window occlusionState] & NSWindowOcclusionStateVisible) != 0;
+    f.in_place = omacvm_fullpanel_compositor(window) == 1;
+    f.locked = omacvm_fullpanel_displays_locked();
+    f.moving = omacvm_fullpanel_displays_moving();
+    f.menu_bar_in_the_way = omacvm_fp_menu_bar_in_the_way(always, immersive_mode_enabled);
+    f.parts = omacvm_fullpanel_hook_state() == OMACVM_FP_HOOK_USABLE &&
+              omacvm_fullpanel_skylight() && !omacvm_fullpanel_menu_failed;
+    f.reshape = omacvm_fullpanel_tile_parts()->found;
+    /* Asked of AppKit only when everything else says now (-retake:). */
+    f.appkit_band = true;
+    return f;
+}
+
+- (void)retake:(const char *)why
+{
+    OmacVMFPRetakeFacts f = [self retakeFacts];
+    const char *reason;
+    OmacVMFPRetake r = omacvm_fp_retake(f, &reason);
+
+    if (r == OMACVM_FP_RETAKE_NOW) {
+        f.appkit_band = omacvm_fullpanel_appkit_band(window);
+        r = omacvm_fp_retake(f, &reason);
+    }
+    if (r == OMACVM_FP_RETAKE_GIVE_UP) {
