+/*
+ * AppKit's own "lay this full-screen tile out again", for a full screen a
+ * display change left below the notch (omacvm-cocoa-fullpanel-retake.patch):
+ * the window's full-screen content controller (-[NSWindow
+ * _fullScreenContentController]), its Space (-space, the object whose
+ * answer the reservation reads), the Space's -updateTileShapeAndReshapeContents
+ * (macOS 27: the tile's content rect asks the reservation again, the window
+ * gets the new frame) and its -alwaysReservesSpaceForMenuBarInFullScreen
+ * (yes only when the Space's display has a camera housing). Looked up once
+ * by name and type encoding, each the class's own method with its code in
+ * AppKit's image (no other code changed it); at each call the object's class
+ * must still use that code. Missing or changed: no retake, the line says
+ * so ("selector missing"). Main thread.
+ */
+typedef void (*OmacVMFullPanelVoidFn)(id, SEL);
+
+typedef struct {
+    bool looked, found;
+    Class window_cls, controller_cls, space_cls;
+    SEL controller_sel, space_sel, reshape_sel, band_sel;
+    IMP controller_imp, space_imp, reshape_imp, band_imp;
+} OmacVMFullPanelTileParts;
+
+static char omacvm_fullpanel_tile_differs[192];
+
+/*
+ * The class's own instance method `name` with the types `want`, its code in
+ * the class's image; else NULL, and what differs (logged with the line).
+ */
+static IMP omacvm_fullpanel_own_method(const char *cls_name, const char *name, const char *want,
+                                       Class *cls, SEL *sel)
+{
+    Class c = objc_getClass(cls_name);
+    Method m = c ? class_getInstanceMethod(c, sel_registerName(name)) : NULL;
+    Class parent = c ? class_getSuperclass(c) : Nil;
+    const char *has = m ? method_getTypeEncoding(m) : NULL;
+    const char *why = NULL;
+
+    if (!c) {
+        why = "(no such class)";
+    } else if (!m) {
+        why = "is not there";
+    } else if (!has || strcmp(has, want)) {
+        why = "has other types";
+    } else if (parent && class_getInstanceMethod(parent, method_getName(m)) == m) {
+        why = "is inherited";
+    } else if (!omacvm_fullpanel_in_image(method_getImplementation(m), c)) {
+        why = "is not AppKit's code";
+    }
+    if (why) {
+        if (!omacvm_fullpanel_tile_differs[0]) {
+            snprintf(omacvm_fullpanel_tile_differs, sizeof(omacvm_fullpanel_tile_differs),
+                     "%s -%s %s", cls_name, name, why);
+        }
+        return NULL;
+    }
+    *cls = c;
+    *sel = method_getName(m);
+    return method_getImplementation(m);
+}
+
+static const OmacVMFullPanelTileParts *omacvm_fullpanel_tile_parts(void)
+{
+    static OmacVMFullPanelTileParts p;
+
+    if (!p.looked) {
+        p.looked = true;
+        p.controller_imp = omacvm_fullpanel_own_method("NSWindow", "_fullScreenContentController",
+                                                       "@16@0:8", &p.window_cls, &p.controller_sel);
+        p.space_imp = omacvm_fullpanel_own_method("_NSFullScreenContentController", "space",
+                                                  "@16@0:8", &p.controller_cls, &p.space_sel);
+        p.reshape_imp = omacvm_fullpanel_own_method("_NSFullScreenSpace",
+                                                    "updateTileShapeAndReshapeContents", "v16@0:8",
+                                                    &p.space_cls, &p.reshape_sel);
+        p.band_imp = omacvm_fullpanel_own_method("_NSFullScreenSpace",
+                                                 "alwaysReservesSpaceForMenuBarInFullScreen",
+                                                 "B16@0:8", &p.space_cls, &p.band_sel);
+        p.found = p.controller_imp && p.space_imp && p.reshape_imp && p.band_imp;
+    }
+    return &p;
+}
+
+/* obj is a cls whose class still uses the code looked up for sel. */
+static bool omacvm_fullpanel_uses(id obj, Class cls, SEL sel, IMP imp)
+{
+    return obj && [obj isKindOfClass:cls] && class_getMethodImplementation(object_getClass(obj), sel) == imp;
+}
+
+/* The window's full-screen Space (AppKit's _NSFullScreenSpace), or nil. */
+static id omacvm_fullpanel_tile_space(NSWindow *w)
+{
+    const OmacVMFullPanelTileParts *p = omacvm_fullpanel_tile_parts();
+    id controller, space = nil;
+
+    if (!p->found || !omacvm_fullpanel_uses(w, p->window_cls, p->controller_sel, p->controller_imp)) {
+        return nil;
+    }
+    @try {
+        controller = ((OmacVMFullPanelObjectFn)p->controller_imp)(w, p->controller_sel);
+        if (omacvm_fullpanel_uses(controller, p->controller_cls, p->space_sel, p->space_imp)) {
+            space = ((OmacVMFullPanelObjectFn)p->space_imp)(controller, p->space_sel);
+        }
+    } @catch (NSException *exception) {
+        (void)exception;
+        return nil;
+    }
+    return omacvm_fullpanel_uses(space, p->space_cls, p->reshape_sel, p->reshape_imp) &&
+           omacvm_fullpanel_uses(space, p->space_cls, p->band_sel, p->band_imp) ? space : nil;
+}
+
+/* AppKit: the window's full-screen Space keeps the menu bar's band (its display has a housing). */
+static bool omacvm_fullpanel_appkit_band(NSWindow *w)
+{
+    const OmacVMFullPanelTileParts *p = omacvm_fullpanel_tile_parts();
+    id space = omacvm_fullpanel_tile_space(w);
+    bool band = false;
+
+    if (!space) {
+        return false;
+    }
+    @try {
+        band = ((OmacVMFullPanelBoolFn)p->band_imp)(space, p->band_sel);
+    } @catch (NSException *exception) {
+        (void)exception;
+    }
+    return band;
+}
+
+/*
+ * AppKit lays the window's full-screen tile out again (it asks the
+ * reservation again). No frame is set here, nothing toggled, no Space
+ * touched. false: not asked (a part missing, or AppKit raised).
+ */
+static bool omacvm_fullpanel_reshape(NSWindow *w)
+{
+    const OmacVMFullPanelTileParts *p = omacvm_fullpanel_tile_parts();
+    id space;
+
+    if (![NSThread isMainThread]) {
+        return false;
+    }
+    space = omacvm_fullpanel_tile_space(w);
+    if (!space) {
+        return false;
+    }
+    @try {
+        ((OmacVMFullPanelVoidFn)p->reshape_imp)(space, p->reshape_sel);
+    } @catch (NSException *exception) {
+        fprintf(stderr, "omacvm: full panel: AppKit's tile relayout raised %s\n",
+                [[exception name] UTF8String]);
+        return false;
+    }
+    return true;
+}
+
+/* The window's display: CoreGraphics has it on, awake and at NSScreen's size. */
+static bool omacvm_fullpanel_display_live(NSScreen *s, bool *same_size)
+{
+    NSNumber *n = [[s deviceDescription] objectForKey:@"NSScreenNumber"];
+    CGRect bounds = n ? CGDisplayBounds([n unsignedIntValue]) : CGRectZero;
+
+    *same_size = n && fabs(bounds.size.width - [s frame].size.width) < 0.5 &&
+                 fabs(bounds.size.height - [s frame].size.height) < 0.5;
+    return n && omacvm_screen_counts(s);
+}
+
