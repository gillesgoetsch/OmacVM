From: OmacVM
Subject: [PATCH] ui: which Shift change goes on to macOS (mac-ime), tested without AppKit

What: a header with no AppKit in it: whether a modifier change the VM took
in the full-grab tap also goes on to macOS (only the Shift keys, only while
mac-ime gives keys to an input method, no Command, Control, Option or fn
down; a release when its press went on), and how its copy is told when it
comes back through the app's event queue: key code and direction within
300 ms, one copy per event sent (the matcher of @Vocllum's prototype in
#655; macOS keeps neither the tap's time stamp nor always a CGEvent on the
copy). It also keeps which of those events mac-ime's input context is still
due, so ui/cocoa.m gives them to it in order. Used by
omacvm-cocoa-ime-shift.patch (which explains the why).

Why its own file: so the rules are tested without QEMU or a window
(app/runtime/Tests/keys/test-ime-shift.sh applies this patch and
omacvm-cocoa-ime-logic.patch to an empty folder; at build time and in CI).

Upstream: not sent (OmacVM's mac-ime only).
Test: app/runtime/Tests/keys/test-ime-shift.c; the real copy on a Mac:
app/runtime/Tests/keys/ime-shift-copy.sh (local, not in CI).

diff --git a/ui/omacvm-ime-shift.h b/ui/omacvm-ime-shift.h
new file mode 100644
--- /dev/null
+++ b/ui/omacvm-ime-shift.h
@@ -0,0 +1,241 @@
+/*
+ * OmacVM mac-ime: Shift also for macOS while an input method has the keys
+ * (#357, idea, captures and the copy matcher by @Vocllum in #655).
+ *
+ * No AppKit in here, so it is tested on its own
+ * (app/runtime/Tests/keys/test-ime-shift.c); ui/cocoa.m's full-grab tap
+ * feeds it.
+ *
+ * While the VM has the keyboard, the full-grab tap deletes every key event
+ * the VM took from macOS's event stream. An input method that switches
+ * between its modes on a lone Shift from a monitor on that stream (WeChat
+ * Input) never sees Shift then. So a Shift change goes on to macOS too, and
+ * only:
+ * - for the Shift keys (left 56, right 60), never Command, Control, Option,
+ *   fn or Caps Lock, and not while one of Command, Control, Option or fn is
+ *   down;
+ * - while mac-ime gives keys to an input method: a text field in the VM has
+ *   the focus, the VM's window the keyboard, the Mac's input source is an
+ *   input method (omacvm_ime_active), or its context is still on during the
+ *   short off delay (omacvm_ime_off_step). Nothing goes on with mac-ime off
+ *   or with a plain keyboard layout.
+ * A release goes on when its press did, also if the rules changed between
+ * the two, so macOS never sees a Shift that stays down.
+ *
+ * The tap decides before the VM gets the event. Such a Shift goes to the VM
+ * in the tap, and macOS gives a copy back through the app's event queue
+ * (2-15 ms later on a real Mac): mac-ime's input context gets the Shift from
+ * that copy, as in any Mac app, where the input context gets a key after
+ * the window server has delivered it (and other apps' monitors saw it).
+ * The copy is told by key code and direction within OMACVM_IME_SHIFT_BACK_NS,
+ * one copy per event sent: macOS keeps neither the tap's time stamp nor
+ * always a CGEvent on it. If another key reaches the input context first,
+ * the input context gets the saved Shift before it and the copy is only
+ * dropped when it comes (the order the person typed). A Shift whose copy
+ * never came goes to the input context on the next key event; a press older
+ * than OMACVM_IME_SHIFT_STALE_NS by then is dropped instead.
+ *
+ * OMACVM_IME_SHIFT=0: nothing goes on. OMACVM_IME_SHIFT=skip (a test): the
+ * input context never gets a Shift that goes on to macOS.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef OMACVM_IME_SHIFT_H
+#define OMACVM_IME_SHIFT_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "omacvm-ime.h"
+
+#define OMACVM_IME_SHIFT_LEFT  56          /* kVK_Shift */
+#define OMACVM_IME_SHIFT_RIGHT 60          /* kVK_RightShift */
+
+/* CGEventFlags bits (kCGEventFlagMask*, IOLLEvent.h's NX_DEVICE*KEYMASK); NSEvent's modifierFlags has the same. */
+#define OMACVM_IME_SHIFT_F_SHIFT   0x00020000ull   /* kCGEventFlagMaskShift */
+#define OMACVM_IME_SHIFT_F_CONTROL 0x00040000ull   /* kCGEventFlagMaskControl */
+#define OMACVM_IME_SHIFT_F_OPTION  0x00080000ull   /* kCGEventFlagMaskAlternate */
+#define OMACVM_IME_SHIFT_F_COMMAND 0x00100000ull   /* kCGEventFlagMaskCommand */
+#define OMACVM_IME_SHIFT_F_FN      0x00800000ull   /* kCGEventFlagMaskSecondaryFn */
+#define OMACVM_IME_SHIFT_F_LEFT    0x00000002ull   /* NX_DEVICELSHIFTKEYMASK */
+#define OMACVM_IME_SHIFT_F_RIGHT   0x00000004ull   /* NX_DEVICERSHIFTKEYMASK */
+#define OMACVM_IME_SHIFT_F_OTHERS  (OMACVM_IME_SHIFT_F_CONTROL | OMACVM_IME_SHIFT_F_OPTION | \
+                                    OMACVM_IME_SHIFT_F_COMMAND | OMACVM_IME_SHIFT_F_FN)
+
+/* Events that went on and whose copy may still come back (a few at most). */
+#define OMACVM_IME_SHIFT_SENT 8
+/* How long a copy is waited for (measured on a Mac: 2-15 ms). */
+#define OMACVM_IME_SHIFT_BACK_NS  300000000ull
+/* A Shift the input context never got is not given to it later than this. */
+#define OMACVM_IME_SHIFT_STALE_NS 1000000000ull
+
+typedef enum OmacVMImeShiftMode {
+    OMACVM_IME_SHIFT_ON,            /* goes on; the input context gets the copy */
+    OMACVM_IME_SHIFT_OFF,           /* OMACVM_IME_SHIFT=0 */
+    OMACVM_IME_SHIFT_SKIP,          /* OMACVM_IME_SHIFT=skip: goes on; never to the input context */
+} OmacVMImeShiftMode;
+
+typedef struct OmacVMImeShift {
+    bool passed[2];                 /* left, right: its press went on to macOS */
+    struct {
+        uint64_t at;                /* when the tap let it go on (monotonic ns, the caller's clock) */
+        uint64_t seq;               /* order of sending, from 1 */
+        int keycode;
+        bool down;                  /* a press */
+        bool live;                  /* its copy may still come back */
+        bool due;                   /* the input context has not had it yet */
+    } sent[OMACVM_IME_SHIFT_SENT];
+    uint64_t seq;
+} OmacVMImeShift;
+
+/* The mode for OMACVM_IME_SHIFT's value (NULL: not set). */
+static inline OmacVMImeShiftMode omacvm_ime_shift_mode(const char *env)
+{
+    if (env && env[0] == '0' && !env[1]) {
+        return OMACVM_IME_SHIFT_OFF;
+    }
+    if (env && env[0] == 's' && env[1] == 'k' && env[2] == 'i' && env[3] == 'p' && !env[4]) {
+        return OMACVM_IME_SHIFT_SKIP;
+    }
+    return OMACVM_IME_SHIFT_ON;
+}
+
+/*
+ * Whether a Shift key's flagsChanged is its press: its NX_DEVICE* bit, or,
+ * on an event without those bits (some apps post such), the Shift flag.
+ */
+static inline bool omacvm_ime_shift_down(int keycode, uint64_t flags)
+{
+    uint64_t bit = keycode == OMACVM_IME_SHIFT_RIGHT ? OMACVM_IME_SHIFT_F_RIGHT : OMACVM_IME_SHIFT_F_LEFT;
+
+    if (!(flags & OMACVM_IME_SHIFT_F_SHIFT)) {
+        return false;
+    }
+    if (flags & (OMACVM_IME_SHIFT_F_LEFT | OMACVM_IME_SHIFT_F_RIGHT)) {
+        return flags & bit;
+    }
+    return true;
+}
+
+/*
+ * A flagsChanged event in the full-grab tap, before the VM gets it: true
+ * when it goes on to macOS too. Called once per event. on: mac-ime is on for
+ * this VM (and not turned off with OMACVM_IME_SHIFT=0); s: mac-ime's state;
+ * waiting: its context's off is still due (omacvm_ime_off.waiting).
+ */
+static inline bool omacvm_ime_shift_pass(OmacVMImeShift *sh, int keycode, uint64_t flags,
+                                         bool on, const OmacVMImeState *s, bool waiting)
+{
+    int side;
+
+    if (keycode == OMACVM_IME_SHIFT_LEFT) {
+        side = 0;
+    } else if (keycode == OMACVM_IME_SHIFT_RIGHT) {
+        side = 1;
+    } else {
+        return false;
+    }
+    if (!omacvm_ime_shift_down(keycode, flags)) {
+        bool was = sh->passed[side];
+        sh->passed[side] = false;
+        return was;
+    }
+    sh->passed[side] = on && (omacvm_ime_active(s) || waiting) &&
+                       !(flags & OMACVM_IME_SHIFT_F_OTHERS);
+    return sh->passed[side];
+}
+
+/*
+ * The slot the next event that goes on takes: a free one, else the oldest.
+ * If that one is still due, the caller gives it to the input context first.
+ */
+static inline int omacvm_ime_shift_slot(const OmacVMImeShift *sh)
+{
+    int old = 0;
+
+    for (int i = 0; i < OMACVM_IME_SHIFT_SENT; i++) {
+        if (!sh->sent[i].live && !sh->sent[i].due) {
+            return i;
+        }
+        if (sh->sent[i].seq < sh->sent[old].seq) {
+            old = i;
+        }
+    }
+    return old;
+}
+
+/* An event that went on (in slot i): its copy will come back through the app's queue. */
+static inline void omacvm_ime_shift_sent(OmacVMImeShift *sh, int i, int keycode, uint64_t flags,
+                                         uint64_t now, bool due)
+{
+    sh->sent[i].at = now;
+    sh->sent[i].seq = ++sh->seq;
+    sh->sent[i].keycode = keycode;
+    sh->sent[i].down = omacvm_ime_shift_down(keycode, flags);
+    sh->sent[i].live = true;
+    sh->sent[i].due = due;
+}
+
+/*
+ * A flagsChanged from the app's queue (key code and flags as the NSEvent has
+ * them): the slot of the event it is the copy of, which is then no longer
+ * waited for; -1: not a copy. The oldest match, at most OMACVM_IME_SHIFT_BACK_NS
+ * after it went on.
+ */
+static inline int omacvm_ime_shift_copy(OmacVMImeShift *sh, int keycode, uint64_t flags, uint64_t now)
+{
+    bool down = omacvm_ime_shift_down(keycode, flags);
+    int hit = -1;
+
+    if (keycode != OMACVM_IME_SHIFT_LEFT && keycode != OMACVM_IME_SHIFT_RIGHT) {
+        return -1;
+    }
+    for (int i = 0; i < OMACVM_IME_SHIFT_SENT; i++) {
+        if (!sh->sent[i].live || sh->sent[i].keycode != keycode || sh->sent[i].down != down ||
+            now < sh->sent[i].at || now - sh->sent[i].at > OMACVM_IME_SHIFT_BACK_NS) {
+            continue;
+        }
+        if (hit < 0 || sh->sent[i].seq < sh->sent[hit].seq) {
+            hit = i;
+        }
+    }
+    if (hit >= 0) {
+        sh->sent[hit].live = false;
+    }
+    return hit;
+}
+
+/*
+ * The oldest event the input context is still due, sent before `before`
+ * (a seq; UINT64_MAX: any), or -1. expired_only: only one whose copy is no
+ * longer waited for. The caller gives it to the input context (or drops it,
+ * omacvm_ime_shift_stale) and clears its due.
+ */
+static inline int omacvm_ime_shift_due(const OmacVMImeShift *sh, uint64_t now, uint64_t before,
+                                       bool expired_only)
+{
+    int hit = -1;
+
+    for (int i = 0; i < OMACVM_IME_SHIFT_SENT; i++) {
+        if (!sh->sent[i].due || sh->sent[i].seq >= before ||
+            (expired_only && sh->sent[i].live && now >= sh->sent[i].at &&
+             now - sh->sent[i].at <= OMACVM_IME_SHIFT_BACK_NS)) {
+            continue;
+        }
+        if (hit < 0 || sh->sent[i].seq < sh->sent[hit].seq) {
+            hit = i;
+        }
+    }
+    return hit;
+}
+
+/*
+ * A press too old to give to the input context now: dropped instead (a late
+ * press and release would look like a lone tap). A release is always given.
+ */
+static inline bool omacvm_ime_shift_stale(const OmacVMImeShift *sh, int i, uint64_t now)
+{
+    return sh->sent[i].down && (now < sh->sent[i].at || now - sh->sent[i].at > OMACVM_IME_SHIFT_STALE_NS);
+}
+
+#endif
