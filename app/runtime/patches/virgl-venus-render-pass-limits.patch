diff --git a/src/venus/vkr_render_pass.c b/src/venus/vkr_render_pass.c
index 0cb3d70..5a565ca 100644
--- a/src/venus/vkr_render_pass.c
+++ b/src/venus/vkr_render_pass.c
@@ -6,12 +6,415 @@
 #include "vkr_render_pass.h"
 
 #include "vkr_render_pass_gen.h"
+#include "vkr_image.h"
+#include "vkr_physical_device.h"
+
+/* OmacVM (virgl-venus-render-pass-limits.patch, ADR 0065): a render pass's attachment
+ * references, counts and view masks stay inside the pass and the device's limits before
+ * the driver gets them. Mesa's vk_render_pass (KosmicKrisp) indexes the attachments by
+ * every reference and copies colors into arrays of 8 with its asserts compiled out;
+ * KosmicKrisp writes color attachments into fixed arrays at begin (more than 8 overflowed
+ * its stack) and renders N views with a Metal vertex amplification count of N (Metal ends
+ * the process past the GPU's). A refusal ends the app's context. */
+
+static bool
+vkr_attachment_ref_ok(uint32_t ref, uint32_t count)
+{
+   return ref == VK_ATTACHMENT_UNUSED || ref < count;
+}
+
+void
+vkr_render_pass_object_release(struct vkr_object *obj)
+{
+   if (obj->type == VK_OBJECT_TYPE_RENDER_PASS)
+      free(((struct vkr_render_pass *)obj)->subpasses);
+}
+
+/* the parts of VkSubpassDescription(2) both passes check */
+struct vkr_subpass_desc {
+   VkPipelineBindPoint bind_point;
+   uint32_t view_mask;
+   uint32_t input_count, color_count, preserve_count;
+   const uint32_t *preserve;
+};
+
+static bool
+vkr_subpass_ok(const struct vkr_physical_device *physical_dev,
+               uint32_t attachments,
+               uint32_t index,
+               const struct vkr_subpass_desc *s,
+               const uint32_t *refs,
+               uint32_t ref_count,
+               char *why,
+               size_t why_size)
+{
+   const struct vkr_limits *l = &physical_dev->limits;
+   if (s->bind_point != VK_PIPELINE_BIND_POINT_GRAPHICS ||
+       s->color_count > physical_dev->properties.limits.maxColorAttachments ||
+       !vkr_view_mask_ok(l, s->view_mask)) {
+      snprintf(why, why_size, "subpass %u: bind point %d, %u colors, view mask 0x%x (views %u)",
+               index, s->bind_point, s->color_count, s->view_mask, l->multiview_views);
+      return false;
+   }
+   for (uint32_t i = 0; i < ref_count; i++) {
+      if (!vkr_attachment_ref_ok(refs[i], attachments)) {
+         snprintf(why, why_size, "subpass %u: attachment %u of %u", index, refs[i], attachments);
+         return false;
+      }
+   }
+   for (uint32_t i = 0; i < s->preserve_count; i++) {
+      if (s->preserve[i] >= attachments) {
+         snprintf(why, why_size, "subpass %u: preserves attachment %u of %u", index,
+                  s->preserve[i], attachments);
+         return false;
+      }
+   }
+   return true;
+}
+
+static bool
+vkr_dependency_ok(uint32_t src, uint32_t dst, uint32_t subpasses)
+{
+   return (src == VK_SUBPASS_EXTERNAL || src < subpasses) &&
+          (dst == VK_SUBPASS_EXTERNAL || dst < subpasses);
+}
+
+/* the references of one subpass, gathered for vkr_subpass_ok */
+static uint32_t
+vkr_subpass_refs_1(const VkSubpassDescription *s, uint32_t *refs)
+{
+   uint32_t n = 0;
+   for (uint32_t i = 0; i < s->inputAttachmentCount; i++)
+      refs[n++] = s->pInputAttachments[i].attachment;
+   for (uint32_t i = 0; i < s->colorAttachmentCount; i++) {
+      refs[n++] = s->pColorAttachments[i].attachment;
+      if (s->pResolveAttachments)
+         refs[n++] = s->pResolveAttachments[i].attachment;
+   }
+   if (s->pDepthStencilAttachment)
+      refs[n++] = s->pDepthStencilAttachment->attachment;
+   return n;
+}
+
+static uint32_t
+vkr_subpass_refs_2(const VkSubpassDescription2 *s,
+                   const VkAttachmentReference2 *ds_resolve,
+                   uint32_t *refs)
+{
+   uint32_t n = 0;
+   for (uint32_t i = 0; i < s->inputAttachmentCount; i++)
+      refs[n++] = s->pInputAttachments[i].attachment;
+   for (uint32_t i = 0; i < s->colorAttachmentCount; i++) {
+      refs[n++] = s->pColorAttachments[i].attachment;
+      if (s->pResolveAttachments)
+         refs[n++] = s->pResolveAttachments[i].attachment;
+   }
+   if (s->pDepthStencilAttachment)
+      refs[n++] = s->pDepthStencilAttachment->attachment;
+   if (ds_resolve)
+      refs[n++] = ds_resolve->attachment;
+   return n;
+}
+
+/* the subpass table, or NULL with why */
+static struct vkr_subpass_info *
+vkr_render_pass_info_1(const struct vkr_physical_device *physical_dev,
+                       const VkRenderPassCreateInfo *info,
+                       char *why,
+                       size_t why_size)
+{
+   const VkPhysicalDeviceLimits *lim = &physical_dev->properties.limits;
+   const VkRenderPassMultiviewCreateInfo *mv =
+      vkr_find_struct(info->pNext, VK_STRUCTURE_TYPE_RENDER_PASS_MULTIVIEW_CREATE_INFO);
+   const VkRenderPassInputAttachmentAspectCreateInfo *aspects = vkr_find_struct(
+      info->pNext, VK_STRUCTURE_TYPE_RENDER_PASS_INPUT_ATTACHMENT_ASPECT_CREATE_INFO);
+   if (!info->subpassCount ||
+       (mv && ((mv->subpassCount && mv->subpassCount != info->subpassCount) ||
+               (mv->dependencyCount && mv->dependencyCount != info->dependencyCount)))) {
+      snprintf(why, why_size, "%u subpasses, multiview masks for %u, offsets for %u of %u "
+               "dependencies", info->subpassCount, mv ? mv->subpassCount : 0,
+               mv ? mv->dependencyCount : 0, info->dependencyCount);
+      return NULL;
+   }
+   for (uint32_t i = 0; i < info->attachmentCount; i++) {
+      if (!vkr_sample_count_ok(lim, info->pAttachments[i].samples)) {
+         snprintf(why, why_size, "attachment %u: %u samples", i, info->pAttachments[i].samples);
+         return NULL;
+      }
+   }
+   struct vkr_subpass_info *subpasses = calloc(info->subpassCount, sizeof(*subpasses));
+   uint32_t *refs = malloc(sizeof(*refs) * (2 * (size_t)lim->maxColorAttachments + 2 + 4096));
+   if (!subpasses || !refs) {
+      snprintf(why, why_size, "out of host memory");
+      goto fail;
+   }
+   for (uint32_t i = 0; i < info->subpassCount; i++) {
+      const VkSubpassDescription *s = &info->pSubpasses[i];
+      const struct vkr_subpass_desc d = {
+         .bind_point = s->pipelineBindPoint,
+         .view_mask = mv && mv->subpassCount ? mv->pViewMasks[i] : 0,
+         .input_count = s->inputAttachmentCount,
+         .color_count = s->colorAttachmentCount,
+         .preserve_count = s->preserveAttachmentCount,
+         .preserve = s->pPreserveAttachments,
+      };
+      /* inputs past 4096 are refused before they are gathered */
+      if (s->inputAttachmentCount > 4096 || s->colorAttachmentCount > lim->maxColorAttachments) {
+         snprintf(why, why_size, "subpass %u: %u inputs, %u colors", i, s->inputAttachmentCount,
+                  s->colorAttachmentCount);
+         goto fail;
+      }
+      const uint32_t n = vkr_subpass_refs_1(s, refs);
+      if (!vkr_subpass_ok(physical_dev, info->attachmentCount, i, &d, refs, n, why, why_size))
+         goto fail;
+      subpasses[i] = (struct vkr_subpass_info){ s->colorAttachmentCount, d.view_mask };
+   }
+   for (uint32_t i = 0; i < info->dependencyCount; i++) {
+      const VkSubpassDependency *d = &info->pDependencies[i];
+      if (!vkr_dependency_ok(d->srcSubpass, d->dstSubpass, info->subpassCount)) {
+         snprintf(why, why_size, "dependency %u: subpass %u to %u of %u", i, d->srcSubpass,
+                  d->dstSubpass, info->subpassCount);
+         goto fail;
+      }
+   }
+   for (uint32_t i = 0; aspects && i < aspects->aspectReferenceCount; i++) {
+      const VkInputAttachmentAspectReference *r = &aspects->pAspectReferences[i];
+      if (r->subpass >= info->subpassCount ||
+          r->inputAttachmentIndex >= info->pSubpasses[r->subpass].inputAttachmentCount) {
+         snprintf(why, why_size, "input aspect %u: subpass %u input %u", i, r->subpass,
+                  r->inputAttachmentIndex);
+         goto fail;
+      }
+   }
+   free(refs);
+   return subpasses;
+
+fail:
+   free(refs);
+   free(subpasses);
+   return NULL;
+}
+
+static struct vkr_subpass_info *
+vkr_render_pass_info_2(const struct vkr_physical_device *physical_dev,
+                       const VkRenderPassCreateInfo2 *info,
+                       char *why,
+                       size_t why_size)
+{
+   const VkPhysicalDeviceLimits *lim = &physical_dev->properties.limits;
+   if (!info->subpassCount) {
+      snprintf(why, why_size, "no subpass");
+      return NULL;
+   }
+   for (uint32_t i = 0; i < info->attachmentCount; i++) {
+      if (!vkr_sample_count_ok(lim, info->pAttachments[i].samples)) {
+         snprintf(why, why_size, "attachment %u: %u samples", i, info->pAttachments[i].samples);
+         return NULL;
+      }
+   }
+   struct vkr_subpass_info *subpasses = calloc(info->subpassCount, sizeof(*subpasses));
+   uint32_t *refs = malloc(sizeof(*refs) * (2 * (size_t)lim->maxColorAttachments + 2 + 4096));
+   if (!subpasses || !refs) {
+      snprintf(why, why_size, "out of host memory");
+      goto fail;
+   }
+   for (uint32_t i = 0; i < info->subpassCount; i++) {
+      const VkSubpassDescription2 *s = &info->pSubpasses[i];
+      const struct vkr_subpass_desc d = {
+         .bind_point = s->pipelineBindPoint,
+         .view_mask = s->viewMask,
+         .input_count = s->inputAttachmentCount,
+         .color_count = s->colorAttachmentCount,
+         .preserve_count = s->preserveAttachmentCount,
+         .preserve = s->pPreserveAttachments,
+      };
+      if (s->inputAttachmentCount > 4096 || s->colorAttachmentCount > lim->maxColorAttachments) {
+         snprintf(why, why_size, "subpass %u: %u inputs, %u colors", i, s->inputAttachmentCount,
+                  s->colorAttachmentCount);
+         goto fail;
+      }
+      const VkSubpassDescriptionDepthStencilResolve *ds = vkr_find_struct(
+         s->pNext, VK_STRUCTURE_TYPE_SUBPASS_DESCRIPTION_DEPTH_STENCIL_RESOLVE);
+      if (ds && (!vkr_resolve_mode_ok(ds->depthResolveMode) ||
+                 !vkr_resolve_mode_ok(ds->stencilResolveMode))) {
+         snprintf(why, why_size, "subpass %u: resolve modes %u, %u", i, ds->depthResolveMode,
+                  ds->stencilResolveMode);
+         goto fail;
+      }
+      const VkFragmentShadingRateAttachmentInfoKHR *fsr = vkr_find_struct(
+         s->pNext, VK_STRUCTURE_TYPE_FRAGMENT_SHADING_RATE_ATTACHMENT_INFO_KHR);
+      const uint32_t n =
+         vkr_subpass_refs_2(s, ds ? ds->pDepthStencilResolveAttachment : NULL, refs);
+      if (!vkr_subpass_ok(physical_dev, info->attachmentCount, i, &d, refs, n, why, why_size) ||
+          (fsr && fsr->pFragmentShadingRateAttachment &&
+           !vkr_attachment_ref_ok(fsr->pFragmentShadingRateAttachment->attachment,
+                                  info->attachmentCount))) {
+         if (fsr)
+            snprintf(why, why_size, "subpass %u: an attachment reference past %u", i,
+                     info->attachmentCount);
+         goto fail;
+      }
+      subpasses[i] = (struct vkr_subpass_info){ s->colorAttachmentCount, s->viewMask };
+   }
+   for (uint32_t i = 0; i < info->dependencyCount; i++) {
+      const VkSubpassDependency2 *d = &info->pDependencies[i];
+      if (!vkr_dependency_ok(d->srcSubpass, d->dstSubpass, info->subpassCount)) {
+         snprintf(why, why_size, "dependency %u: subpass %u to %u of %u", i, d->srcSubpass,
+                  d->dstSubpass, info->subpassCount);
+         goto fail;
+      }
+   }
+   free(refs);
+   return subpasses;
+
+fail:
+   free(refs);
+   free(subpasses);
+   return NULL;
+}
+
+static bool
+vkr_format_is_depth_stencil(VkFormat format)
+{
+   switch (format) {
+   case VK_FORMAT_D16_UNORM:
+   case VK_FORMAT_X8_D24_UNORM_PACK32:
+   case VK_FORMAT_D32_SFLOAT:
+   case VK_FORMAT_S8_UINT:
+   case VK_FORMAT_D16_UNORM_S8_UINT:
+   case VK_FORMAT_D24_UNORM_S8_UINT:
+   case VK_FORMAT_D32_SFLOAT_S8_UINT:
+      return true;
+   default:
+      return false;
+   }
+}
+
+/* the clear values a begin must give: up to the last attachment whose loadOp clears, or
+ * whose stencilLoadOp clears when it has a depth/stencil format (Vulkan ignores the
+ * stencil load op of a color attachment) */
+static uint32_t
+vkr_clear_count(uint32_t count,
+                const void *attachments,
+                size_t stride,
+                size_t format,
+                size_t load,
+                size_t stencil_load)
+{
+   uint32_t n = 0;
+   for (uint32_t i = 0; i < count; i++) {
+      const uint8_t *a = (const uint8_t *)attachments + i * stride;
+      if (*(const VkAttachmentLoadOp *)(a + load) == VK_ATTACHMENT_LOAD_OP_CLEAR ||
+          (*(const VkAttachmentLoadOp *)(a + stencil_load) == VK_ATTACHMENT_LOAD_OP_CLEAR &&
+           vkr_format_is_depth_stencil(*(const VkFormat *)(a + format))))
+         n = i + 1;
+   }
+   return n;
+}
+
+bool
+vkr_render_pass_begin_ok(struct vkr_context *ctx,
+                         const char *call,
+                         const struct vkr_limits *limits,
+                         const VkRenderPassBeginInfo *info)
+{
+   const struct vkr_render_pass *pass = vkr_render_pass_from_handle(info->renderPass);
+   const struct vkr_framebuffer *fb = vkr_framebuffer_from_handle(info->framebuffer);
+   const VkRenderPassAttachmentBeginInfo *views =
+      vkr_find_struct(info->pNext, VK_STRUCTURE_TYPE_RENDER_PASS_ATTACHMENT_BEGIN_INFO);
+   const uint32_t fb_count = fb && fb->imageless ? (views ? views->attachmentCount : 0)
+                                                 : fb ? fb->attachment_count : 0;
+   bool ok = pass && fb && fb_count == pass->attachment_count &&
+             info->clearValueCount >= pass->clear_count;
+   for (uint32_t i = 0; ok && fb->imageless && i < fb_count; i++)
+      ok = views->pAttachments[i] != VK_NULL_HANDLE;
+   if (!vkr_context_check(ctx, ok, call,
+                          "framebuffer of %u attachments%s for a pass of %u, %u clear values of %u",
+                          fb_count, fb && fb->imageless ? " (imageless)" : "",
+                          pass ? pass->attachment_count : 0, info->clearValueCount,
+                          pass ? pass->clear_count : 0))
+      return false;
+   const VkRenderPassSampleLocationsBeginInfoEXT *sl =
+      vkr_find_struct(info->pNext, VK_STRUCTURE_TYPE_RENDER_PASS_SAMPLE_LOCATIONS_BEGIN_INFO_EXT);
+   for (uint32_t i = 0; sl && i < sl->attachmentInitialSampleLocationsCount; i++) {
+      const VkAttachmentSampleLocationsEXT *a = &sl->pAttachmentInitialSampleLocations[i];
+      if (!vkr_context_check(ctx,
+                             a->attachmentIndex < pass->attachment_count &&
+                                vkr_sample_locations_ok(limits, &a->sampleLocationsInfo),
+                             call, "sample locations for attachment %u of %u",
+                             a->attachmentIndex, pass->attachment_count))
+         return false;
+   }
+   for (uint32_t i = 0; sl && i < sl->postSubpassSampleLocationsCount; i++) {
+      const VkSubpassSampleLocationsEXT *s = &sl->pPostSubpassSampleLocations[i];
+      if (!vkr_context_check(ctx,
+                             s->subpassIndex < pass->subpass_count &&
+                                vkr_sample_locations_ok(limits, &s->sampleLocationsInfo),
+                             call, "sample locations for subpass %u of %u", s->subpassIndex,
+                             pass->subpass_count))
+         return false;
+   }
+   return true;
+}
+
+/* a known resolve mode, and a resolve view where an attachment with a view resolves (Vulkan
+ * asks for none without a view; KosmicKrisp then skips the attachment's resolve) */
+static bool
+vkr_rendering_attachment_ok(const VkRenderingAttachmentInfo *a)
+{
+   return vkr_resolve_mode_ok(a->resolveMode) &&
+          (a->resolveMode == VK_RESOLVE_MODE_NONE || a->imageView == VK_NULL_HANDLE ||
+           a->resolveImageView != VK_NULL_HANDLE);
+}
+
+bool
+vkr_rendering_ok(struct vkr_context *ctx,
+                 const struct vkr_physical_device *physical_dev,
+                 const VkRenderingInfo *info)
+{
+   const VkPhysicalDeviceLimits *lim = &physical_dev->properties.limits;
+   bool ok = info->colorAttachmentCount <= lim->maxColorAttachments &&
+             vkr_view_mask_ok(&physical_dev->limits, info->viewMask) &&
+             (info->viewMask || info->layerCount <= lim->maxFramebufferLayers) &&
+             (!info->pDepthAttachment || vkr_rendering_attachment_ok(info->pDepthAttachment)) &&
+             (!info->pStencilAttachment || vkr_rendering_attachment_ok(info->pStencilAttachment));
+   for (uint32_t i = 0; ok && i < info->colorAttachmentCount; i++)
+      ok = vkr_rendering_attachment_ok(&info->pColorAttachments[i]);
+   return vkr_context_check(ctx, ok, "vkCmdBeginRendering",
+                            "%u colors (at most %u), view mask 0x%x (views %u), %u layers, or a "
+                            "resolve without its view", info->colorAttachmentCount,
+                            lim->maxColorAttachments, info->viewMask,
+                            physical_dev->limits.multiview_views, info->layerCount);
+}
 
