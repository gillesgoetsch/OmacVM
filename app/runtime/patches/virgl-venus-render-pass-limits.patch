diff --git a/src/venus/vkr_metal_limits.m b/src/venus/vkr_metal_limits.m
new file mode 100644
index 0000000..b26eb90
--- /dev/null
+++ b/src/venus/vkr_metal_limits.m
@@ -0,0 +1,35 @@
+/*
+ * Copyright 2026 OmacVM contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+/* OmacVM (virgl-venus-render-pass-limits.patch): how many views KosmicKrisp can render at
+ * once. It renders a multiview pass with Metal vertex amplification, one amplified vertex
+ * per view, and tells the guest 32 views; Metal ends the process (an assertion) on an
+ * amplification count the GPU does not support (Apple7: more than 8). Read once. */
+
+#import <Metal/Metal.h>
+
+#include <stdint.h>
+
+uint32_t
+vkr_metal_max_vertex_amplification(void);
+
+uint32_t
+vkr_metal_max_vertex_amplification(void)
+{
+   static uint32_t max;
+   static dispatch_once_t once;
+   dispatch_once(&once, ^{
+      @autoreleasepool {
+         id<MTLDevice> device = MTLCreateSystemDefaultDevice();
+         uint32_t n = 1;
+         /* every count up to n: a pass with fewer views uses a smaller count */
+         while (device && n < 32 && [device supportsVertexAmplificationCount:n + 1])
+            n++;
+         max = n;
+         [device release];
+      }
+   });
+   return max;
+}
