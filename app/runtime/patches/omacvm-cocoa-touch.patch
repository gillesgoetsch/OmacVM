+/*
+ * OmacVM: the guest gets what the touch rules decided (ui/omacvm-touch.h),
+ * in order, each with its own sync: the pointer to the finger, buttons,
+ * scrolling on the precise-scroll path, a coast. Never through the mouse
+ * path or the corner guard: the place is the finger's. A touch on the VM
+ * while another app is in front brings OmacVM forward and takes the pointer,
+ * as a click does. A pinch's two fingers go to the guest's touch screen
+ * (virtio-multitouch) as contacts 0 and 1, each at its share of the output
+ * touched: the guest's compositor puts them on its focused output, which is
+ * that one (the rules sent the pointer between the fingers first), and its
+ * apps zoom between them. Without that device nothing is sent. Main thread.
+ */
+- (void) omacvmTouch:(const OmacVMTouchActions *)acts view:(NSView *)view output:(int)output
+{
+    bool guest = false;
+
+    for (int i = 0; i < acts->n; i++) {
+        int k = acts->a[i].kind;
+        guest |= k != OMACVM_TA_STOP_COAST && k != OMACVM_TA_COAST;
+        if (k == OMACVM_TA_STOP_COAST) {
+            omacvm_coast_stop();
+        }
+    }
+    /* No tablet yet (the firmware's menu, the boot): nothing to place. */
+    if (!isAbsoluteEnabled) {
+        return;
+    }
+    if (guest && ![NSApp isActive]) {
+        [NSApp activate];
+    }
+    if (guest && !isMouseGrabbed) {
+        [self grabMouse];
+    }
+    for (int i = 0; i < acts->n; i++) {
+        const OmacVMTouchAction *a = &acts->a[i];
+        switch (a->kind) {
+        case OMACVM_TA_MOVE:
+            with_bql(^{
+                if ([self omacvmQueuePlace:NSMakePoint(a->x, a->y) view:view output:output]) {
+                    qemu_input_event_sync();
+                }
+            });
+            break;
+        case OMACVM_TA_LEFT_DOWN:
+        case OMACVM_TA_LEFT_UP:
+        case OMACVM_TA_RIGHT_DOWN:
+        case OMACVM_TA_RIGHT_UP: {
+            InputButton b = (a->kind == OMACVM_TA_LEFT_DOWN || a->kind == OMACVM_TA_LEFT_UP) ?
+                            INPUT_BUTTON_LEFT : INPUT_BUTTON_RIGHT;
+            bool down = a->kind == OMACVM_TA_LEFT_DOWN || a->kind == OMACVM_TA_RIGHT_DOWN;
+            with_bql(^{
+                qemu_input_queue_btn(dcl.con, b, down);
+                qemu_input_event_sync();
+            });
+            break;
+        }
+        case OMACVM_TA_SCROLL:
+            [self omacvmTouchScroll:a->dx dy:a->dy];
+            break;
+        case OMACVM_TA_PINCH_BEGIN:
+        case OMACVM_TA_PINCH_MOVE: {
+            InputMultiTouchType type = a->kind == OMACVM_TA_PINCH_BEGIN ?
+                                       INPUT_MULTI_TOUCH_TYPE_BEGIN : INPUT_MULTI_TOUCH_TYPE_UPDATE;
+            double u0, v0, u1, v1;
+
+            if (!omacvm_touch_screen() ||
+                ![self omacvmShare:NSMakePoint(a->x, a->y) view:view u:&u0 v:&v0] ||
+                ![self omacvmShare:NSMakePoint(a->dx, a->dy) view:view u:&u1 v:&v1]) {
+                break;
+            }
+            with_bql(^{
+                [self omacvmTouchContact:0 type:type u:u0 v:v0];
+                [self omacvmTouchContact:1 type:type u:u1 v:v1];
+                qemu_input_event_sync();
+            });
+            break;
+        }
+        case OMACVM_TA_PINCH_END:
+            if (!omacvm_touch_screen()) {
+                break;
+            }
+            with_bql(^{
+                qemu_input_queue_mtt(dcl.con, INPUT_MULTI_TOUCH_TYPE_END, 0, -1);
+                qemu_input_queue_mtt(dcl.con, INPUT_MULTI_TOUCH_TYPE_END, 1, -1);
+                qemu_input_event_sync();
+            });
+            break;
+        case OMACVM_TA_COAST:
+            omacvm_coast_stop();
+            omacvm_coast_vx = a->dx;
+            omacvm_coast_vy = a->dy;
+            omacvm_coast_last = CACurrentMediaTime();
+            /* The run loop holds the timer until it is invalidated (omacvm_coast_stop). */
+            omacvm_coast_timer = [NSTimer timerWithTimeInterval:1.0 / 120 repeats:YES
+                                                          block:^(NSTimer *t) {
+                double now = CACurrentMediaTime(), dx, dy;
+                (void)t;
+                bool on = omacvm_touch_coast_step(&omacvm_coast_vx, &omacvm_coast_vy,
+                                                  now - omacvm_coast_last, &dx, &dy);
+                omacvm_coast_last = now;
+                [self omacvmTouchScroll:dx dy:dy];
+                if (!on) {
+                    omacvm_coast_stop();
+                }
+            }];
+            /* Common modes: AppKit tracks touches in the event-tracking mode. */
+            [[NSRunLoop mainRunLoop] addTimer:omacvm_coast_timer forMode:NSRunLoopCommonModes];
+            break;
+        default:
+            break;
+        }
+    }
+}
+
+/*
+ * OmacVM: one finger of a pinch on the guest's touch screen: its contact
+ * (the slot, then its place: the device sends the place to the slot named
+ * last), at (u, v) of the output, kept on it. With the BQL; the caller syncs.
+ */
+- (void) omacvmTouchContact:(int)slot type:(InputMultiTouchType)type u:(double)u v:(double)v
+{
+    qemu_input_queue_mtt(dcl.con, type, slot, slot);
+    qemu_input_queue_mtt_abs(dcl.con, INPUT_AXIS_X,
+                             lround(MIN(1.0, MAX(0.0, u)) * INPUT_EVENT_ABS_MAX),
+                             0, INPUT_EVENT_ABS_MAX, slot, slot);
+    qemu_input_queue_mtt_abs(dcl.con, INPUT_AXIS_Y,
+                             lround(MIN(1.0, MAX(0.0, v)) * INPUT_EVENT_ABS_MAX),
+                             0, INPUT_EVENT_ABS_MAX, slot, slot);
+}
+
+/* OmacVM: the content moves (dx, dy) points under a touch: wheel units on the precise-scroll path. */
+- (void) omacvmTouchScroll:(double)dx dy:(double)dy
+{
+    double sx, sy;
+
+    omacvm_touch_scroll_deltas(dx, dy, omacvm_touch_gain, &sx, &sy);
+    CocoaScrollFrame frame = cocoa_scroll_update(&omacvm_touch_scroll, sx, sy);
+    if (!frame.x && !frame.y) {
+        return;
+    }
+    with_bql(^{
+        /* Cocoa's positive X means left; Linux REL_HWHEEL is right. */
+        if (frame.x) {
+            qemu_input_queue_rel(dcl.con, INPUT_AXIS_HWHEEL, -frame.x);
+        }
+        if (frame.y) {
+            qemu_input_queue_rel(dcl.con, INPUT_AXIS_WHEEL, frame.y);
+        }
+        qemu_input_event_sync();
+    });
+}
+@end
+
+static void omacvm_coast_stop(void)
+{
+    [omacvm_coast_timer invalidate];   /* the run loop lets go of it; also from its own block */
+    omacvm_coast_timer = nil;
+}
+
+/*
+ * OmacVM: the touch recognizer (#843). Direct touches only, never a mouse or
+ * a trackpad: those keep the view's own mouse methods. It begins at
+ * touch-down, which takes the touch from AppKit's mouse emulation, and hands
+ * the fingers to the rules: their centre, and their own movement (the mean
+ * over the fingers in both frames: a finger landing or lifting moves the
+ * centre, not the content); while exactly two touch, also the two fingers,
+ * the same one first every time (a pinch: each keeps its contact in the
+ * guest). The rules decide from the events' times.
+ */
+@implementation OmacVMTouchRecognizer
+- (instancetype)initWithOutput:(int)index
+{
+    self = [super initWithTarget:nil action:NULL];
+    if (self) {
+        output = index;
+        fingers = [[NSMutableDictionary alloc] init];
+        [self setAllowedTouchTypes:NSTouchTypeMaskDirect];
+        [self setDelaysPrimaryMouseButtonEvents:NO];
+        [self setDelaysSecondaryMouseButtonEvents:NO];
+        [self setDelaysOtherMouseButtonEvents:NO];
+        [self setDelaysKeyEvents:NO];
+        [self setDelaysMagnificationEvents:NO];
+        [self setDelaysRotationEvents:NO];
+    }
+    return self;
+}
+
+- (void)dealloc
+{
+    [fingers release];
+    [first release];
+    [super dealloc];
+}
+
+/* The direct touches touching now: identity -> place (view's points). */
+- (NSMutableDictionary *)touching:(NSEvent *)event
+{
+    NSMutableDictionary *now = [NSMutableDictionary dictionary];
+    for (NSTouch *t in [event touchesMatchingPhase:NSTouchPhaseTouching inView:[self view]]) {
+        if ([t type] == NSTouchTypeDirect) {
+            now[[t identity]] = [NSValue valueWithPoint:[t locationInView:[self view]]];
+        }
+    }
+    return now;
+}
+
+- (NSPoint)centreOf:(NSDictionary *)now
+{
+    double x = 0, y = 0;
+    for (NSValue *v in [now allValues]) {
+        x += [v pointValue].x;
+        y += [v pointValue].y;
+    }
+    return [now count] ? NSMakePoint(x / [now count], y / [now count]) : centre;
+}
+
+- (void)send:(const OmacVMTouchActions *)acts
+{
+    if (acts->n) {
+        [cocoaView omacvmTouch:acts view:[self view] output:output];
+    }
+}
+
+/* Exactly two fingers touch: both to the rules, the same one first every time. */
+- (void)two:(NSDictionary *)now
+{
+    OmacVMTouchActions acts;
+    NSArray *ids = [now allKeys];
+    NSPoint a, b;
+
+    if ([ids count] != 2) {
+        return;
+    }
+    if (!first || !now[first]) {
+        [first release];
+        first = [ids[0] retain];
+    }
+    a = [now[first] pointValue];
+    b = [now[[ids[0] isEqual:first] ? ids[1] : ids[0]] pointValue];
+    omacvm_touch_two(&omacvm_touch, a.x, a.y, b.x, b.y, &acts);
+    [self send:&acts];
+}
+
+- (void)touchesBeganWithEvent:(NSEvent *)event
+{
+    NSMutableDictionary *now = [self touching:event];
+    OmacVMTouchActions acts;
+
+    if (![now count]) {
+        return;
+    }
+    centre = [self centreOf:now];
+    if ([self state] == NSGestureRecognizerStatePossible) {
+        [self setState:NSGestureRecognizerStateBegan];
+    }
+    omacvm_touch_begin(&omacvm_touch, [event timestamp], centre.x, centre.y, (int)[now count], &acts);
+    [fingers setDictionary:now];
+    [self send:&acts];
+    [self two:now];
+}
+
+- (void)touchesMovedWithEvent:(NSEvent *)event
+{
+    NSMutableDictionary *now = [self touching:event];
+    OmacVMTouchActions acts;
+    double dx = 0, dy = 0;
+    int n = 0;
+
+    if (![now count]) {
+        return;
+    }
+    for (id k in now) {
+        NSValue *was = fingers[k];
+        if (was) {
+            dx += [now[k] pointValue].x - [was pointValue].x;
+            dy += [now[k] pointValue].y - [was pointValue].y;
+            n++;
+        }
+    }
+    centre = [self centreOf:now];
+    [fingers setDictionary:now];
+    omacvm_touch_move(&omacvm_touch, [event timestamp], centre.x, centre.y,
+                      n ? dx / n : 0, n ? dy / n : 0, &acts);
+    [self send:&acts];
+    [self two:now];
+    [self setState:NSGestureRecognizerStateChanged];
+}
+
+- (void)touchesEndedWithEvent:(NSEvent *)event
+{
+    NSMutableDictionary *now = [self touching:event];
+    OmacVMTouchActions acts;
+
+    omacvm_touch_lift(&omacvm_touch, [event timestamp], (int)[now count], &acts);
+    [fingers setDictionary:now];
+    [self send:&acts];
+    if (![now count]) {
+        [self setState:NSGestureRecognizerStateEnded];
+    }
+}
+
+- (void)touchesCancelledWithEvent:(NSEvent *)event
+{
+    OmacVMTouchActions acts;
+
+    omacvm_touch_cancel(&omacvm_touch, &acts);
+    [fingers removeAllObjects];
+    [self send:&acts];
+    [self setState:NSGestureRecognizerStateCancelled];
+}
+
+/* A mouse or a trackpad click is never ours: the view's own methods take it. */
+- (void)mouseDown:(NSEvent *)click { [self setState:NSGestureRecognizerStateFailed]; }
+- (void)rightMouseDown:(NSEvent *)click { [self setState:NSGestureRecognizerStateFailed]; }
+- (void)otherMouseDown:(NSEvent *)click { [self setState:NSGestureRecognizerStateFailed]; }
+
+/* The macOS 27 SDK's AppKit wants a subclass's own location. */
+- (NSPoint)locationInView:(NSView *)view
+{
+    NSView *mine = [self view];
+    return view && mine ? [view convertPoint:centre fromView:mine] : centre;
+}
+
+- (void)reset
+{
+    [super reset];
+    [fingers removeAllObjects];
+    [first release];
+    first = nil;
+}
 @end
 
+static void omacvm_touch_install(NSView *view, int output)
+{
+    omacvm_touch_settings();
+    if (omacvm_touch_off) {
+        return;
