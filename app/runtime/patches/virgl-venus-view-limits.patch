+/* OmacVM (virgl-venus-view-limits.patch): whether the texel offset is aligned: to
+ * minTexelBufferOffsetAlignment, or by the per-format rule of the texel buffer alignment
+ * properties when the device has that rule on (vkr_device.c) */
+static bool
+vkr_buffer_view_offset_aligned(const struct vkr_device *dev,
+                               VkBufferUsageFlags2 usage,
+                               uint32_t texel,
+                               VkDeviceSize offset)
+{
+   struct vkr_physical_device *physical_dev = dev->physical_device;
+   const VkDeviceSize min = physical_dev->properties.limits.minTexelBufferOffsetAlignment;
+   if (!min || !(offset % min))
+      return true;
+   if (!dev->texel_buffer_alignment)
+      return false;
+
+   VkPhysicalDeviceTexelBufferAlignmentProperties align = {
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_TEXEL_BUFFER_ALIGNMENT_PROPERTIES,
+   };
+   VkPhysicalDeviceProperties2 props = {
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2,
+      .pNext = &align,
+   };
+   physical_dev->proc_table.GetPhysicalDeviceProperties2(
+      physical_dev->base.handle.physical_device, &props);
+   /* a texel of three components: the size of one */
+   const VkDeviceSize single = texel % 3 ? texel : texel / 3;
+   VkDeviceSize storage = align.storageTexelBufferOffsetAlignmentBytes;
+   VkDeviceSize uniform = align.uniformTexelBufferOffsetAlignmentBytes;
+   if (align.storageTexelBufferOffsetSingleTexelAlignment)
+      storage = MIN2(storage, single);
+   if (align.uniformTexelBufferOffsetSingleTexelAlignment)
+      uniform = MIN2(uniform, single);
+   if ((usage & VK_BUFFER_USAGE_2_STORAGE_TEXEL_BUFFER_BIT) && (!storage || offset % storage))
+      return false;
+   if ((usage & VK_BUFFER_USAGE_2_UNIFORM_TEXEL_BUFFER_BIT) && (!uniform || offset % uniform))
+      return false;
+   return true;
+}
+
+/* OmacVM (virgl-venus-view-limits.patch): whether a texel buffer view may go to the Mac's
+ * Vulkan driver: a format it has texel buffer features for (KosmicKrisp crashes on one it
+ * has no entry for), the buffer's texel usage, an aligned offset and whole texels inside
+ * the buffer, at most maxTexelBufferElements of them (Metal ends the process past its
+ * texture width). KosmicKrisp hands offset and range on to Metal as a texture over the
+ * buffer's memory: past the buffer the GPU would read and write memory it must not. */
+static bool
+vkr_buffer_view_ok(const struct vkr_device *dev,
+                   const VkBufferViewCreateInfo *info,
+                   char *why,
+                   size_t why_size)
+{
+   const struct vkr_buffer *buffer = vkr_buffer_from_handle(info->buffer);
+   if (!buffer) {
+      snprintf(why, why_size, "no buffer");
+      return false;
+   }
+   struct vkr_physical_device *physical_dev = dev->physical_device;
+   const VkBufferUsageFlags2CreateInfo *usage2 =
+      vkr_find_struct(info->pNext, VK_STRUCTURE_TYPE_BUFFER_USAGE_FLAGS_2_CREATE_INFO);
+   const VkBufferUsageFlags2 usage = (usage2 ? usage2->usage : buffer->usage) &
+                                     (VK_BUFFER_USAGE_2_UNIFORM_TEXEL_BUFFER_BIT |
+                                      VK_BUFFER_USAGE_2_STORAGE_TEXEL_BUFFER_BIT);
+   VkFormatProperties props = { 0 };
+   physical_dev->proc_table.GetPhysicalDeviceFormatProperties(
+      physical_dev->base.handle.physical_device, info->format, &props);
+   const uint32_t texel = vkr_format_block_size(info->format);
+   if (!usage || !texel ||
+       ((usage & VK_BUFFER_USAGE_2_UNIFORM_TEXEL_BUFFER_BIT) &&
+        !(props.bufferFeatures & VK_FORMAT_FEATURE_UNIFORM_TEXEL_BUFFER_BIT)) ||
+       ((usage & VK_BUFFER_USAGE_2_STORAGE_TEXEL_BUFFER_BIT) &&
+        !(props.bufferFeatures & VK_FORMAT_FEATURE_STORAGE_TEXEL_BUFFER_BIT))) {
+      snprintf(why, why_size, "format %d (buffer features 0x%x) for texel usage 0x%" PRIx64,
+               info->format, props.bufferFeatures, (uint64_t)usage);
+      return false;
+   }
+   if (info->offset >= buffer->size) {
+      snprintf(why, why_size, "offset %" PRIu64 " of a %" PRIu64 "-byte buffer", info->offset,
+               buffer->size);
+      return false;
+   }
+   const VkDeviceSize range = info->range == VK_WHOLE_SIZE
+                                 ? (buffer->size - info->offset) / texel * texel
+                                 : info->range;
+   if (!range || range % texel || range > buffer->size - info->offset) {
+      snprintf(why, why_size,
+               "range %" PRIu64 " at %" PRIu64 " of a %" PRIu64 "-byte buffer (%u-byte texels)",
+               info->range, info->offset, buffer->size, texel);
+      return false;
+   }
+   if (range / texel > physical_dev->properties.limits.maxTexelBufferElements) {
+      snprintf(why, why_size, "%" PRIu64 " texels past the driver's %u", range / texel,
+               physical_dev->properties.limits.maxTexelBufferElements);
+      return false;
+   }
+   if (!vkr_buffer_view_offset_aligned(dev, usage, texel, info->offset)) {
+      snprintf(why, why_size, "offset %" PRIu64 " not aligned for format %d (minimum %" PRIu64 ")",
+               info->offset, info->format,
+               physical_dev->properties.limits.minTexelBufferOffsetAlignment);
+      return false;
+   }
+   return true;
+}
+
 static void
 vkr_dispatch_vkCreateBufferView(struct vn_dispatch_context *dispatch,
                                 struct vn_command_vkCreateBufferView *args)
 {
+   /* OmacVM: made without waiting for an answer: a refused view ends the app's context */
+   char why[192];
+   if (!vkr_buffer_view_ok(vkr_device_from_handle(args->device), args->pCreateInfo, why,
+                           sizeof(why))) {
+      vkr_context_refuse(dispatch->data, true, "vkCreateBufferView", "%s", why);
+      args->ret = VK_ERROR_UNKNOWN;
+      return;
+   }
+
    vkr_buffer_view_create_and_add(dispatch->data, args);
 }
 
