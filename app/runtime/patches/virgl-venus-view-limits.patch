+/* OmacVM (virgl-venus-view-limits.patch): whether a view may go to the Mac's Vulkan
+ * driver. KosmicKrisp makes a Metal texture view of the guest's ranges, type and format,
+ * and Metal ends the process on a level, slice or cube face past the texture, a 3D view
+ * of a 2D texture, or a format of another texel size; a format KosmicKrisp has no entry
+ * for crashes it. Ranges are checked as the spec has them; type and format only where a
+ * driver ends the process (a cube view of a 3D image, or a 2D view of a 3D image made
+ * without 2D_ARRAY_COMPATIBLE, live on both drivers and are left to them). */
+static bool
+vkr_image_view_ok(struct vkr_physical_device *physical_dev,
+                  const VkImageViewCreateInfo *info,
+                  char *why,
+                  size_t why_size)
+{
+   const struct vkr_image *image = vkr_image_from_handle(info->image);
+   if (!image) {
+      snprintf(why, why_size, "no image");
+      return false;
+   }
+   if ((uint32_t)info->viewType > VK_IMAGE_VIEW_TYPE_CUBE_ARRAY ||
+       (info->viewType == VK_IMAGE_VIEW_TYPE_3D && image->type != VK_IMAGE_TYPE_3D)) {
+      snprintf(why, why_size, "viewType %d of an imageType %d image", info->viewType,
+               image->type);
+      return false;
+   }
+
+   /* a format the driver knows for this tiling, of the image's texel block size (planes
+    * of a multi-planar image have formats of their own: not checked) */
+   VkFormatProperties props = { 0 };
+   physical_dev->proc_table.GetPhysicalDeviceFormatProperties(
+      physical_dev->base.handle.physical_device, info->format, &props);
+   const VkFormatFeatureFlags features = image->tiling == VK_IMAGE_TILING_LINEAR
+                                            ? props.linearTilingFeatures
+                                            : props.optimalTilingFeatures;
+   const uint32_t texel = vkr_format_block_size(info->format);
+   if (!texel || !features ||
+       (vkr_format_plane_count(image->format) == 1 &&
+        texel != vkr_format_block_size(image->format))) {
+      snprintf(why, why_size,
+               "format %d (%u bytes a texel block, features 0x%x) of an image of format %d",
+               info->format, texel, features, image->format);
+      return false;
+   }
+
+   /* levels; layers, or a 3D image's slices at the view's base level */
+   const VkImageSubresourceRange *r = &info->subresourceRange;
+   if (r->baseMipLevel >= image->mip_levels ||
+       (r->levelCount != VK_REMAINING_MIP_LEVELS &&
+        (!r->levelCount || r->levelCount > image->mip_levels - r->baseMipLevel))) {
+      snprintf(why, why_size, "levels %u+%u of %u", r->baseMipLevel, r->levelCount,
+               image->mip_levels);
+      return false;
+   }
+   uint32_t layers = image->array_layers;
+   if (image->type == VK_IMAGE_TYPE_3D && info->viewType != VK_IMAGE_VIEW_TYPE_3D)
+      layers = MAX2(image->extent.depth >> r->baseMipLevel, 1);
+   if (r->baseArrayLayer >= layers ||
+       (r->layerCount != VK_REMAINING_ARRAY_LAYERS &&
+        (!r->layerCount || r->layerCount > layers - r->baseArrayLayer))) {
+      snprintf(why, why_size, "layers %u+%u of %u", r->baseArrayLayer, r->layerCount, layers);
+      return false;
+   }
+   const uint32_t count =
+      r->layerCount == VK_REMAINING_ARRAY_LAYERS ? layers - r->baseArrayLayer : r->layerCount;
+   if ((info->viewType == VK_IMAGE_VIEW_TYPE_CUBE && count != 6) ||
+       (info->viewType == VK_IMAGE_VIEW_TYPE_CUBE_ARRAY && count % 6)) {
+      snprintf(why, why_size, "a cube view (viewType %d) of %u layers", info->viewType, count);
+      return false;
+   }
+   return true;
+}
+
 static void
 vkr_dispatch_vkCreateImageView(struct vn_dispatch_context *dispatch,
                                struct vn_command_vkCreateImageView *args)
 {
+   /* OmacVM: the guest makes views without waiting for an answer: a view the driver must
+    * not get ends the app's context here, with the reason in the log (made or skipped
+    * silently, the app's next use would end it anyway, or draw from a wrong range) */
+   struct vkr_device *dev = vkr_device_from_handle(args->device);
+   char why[192];
+   if (!vkr_image_view_ok(dev->physical_device, args->pCreateInfo, why, sizeof(why))) {
+      vkr_context_refuse(dispatch->data, true, "vkCreateImageView", "%s", why);
+      args->ret = VK_ERROR_UNKNOWN;
+      return;
+   }
+
    vkr_image_view_create_and_add(dispatch->data, args);
 }
 
@@ -630,10 +712,51 @@ vkr_dispatch_vkDestroyImageView(struct vn_dispatch_context *dispatch,
    vkr_image_view_destroy_and_remove(dispatch->data, args);
 }
 
+/* OmacVM (virgl-venus-view-limits.patch): a sampler's enums are ones the spec has
+ * (KosmicKrisp ends the process on an unknown filter; the rest are checked the same way).
+ * Values in range (anisotropy, LOD bias, LOD clamps) live on both drivers and are left
+ * to them. */
+static bool
+vkr_sampler_info_ok(const VkSamplerCreateInfo *info, char *why, size_t why_size)
+{
+#define VKR_FILTER_OK(f)                                                                    \
+   ((f) == VK_FILTER_NEAREST || (f) == VK_FILTER_LINEAR || (f) == VK_FILTER_CUBIC_EXT)
+#define VKR_ADDRESS_OK(a) ((uint32_t)(a) <= VK_SAMPLER_ADDRESS_MODE_MIRROR_CLAMP_TO_EDGE)
+   const bool border = info->addressModeU == VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_BORDER ||
+                       info->addressModeV == VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_BORDER ||
+                       info->addressModeW == VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_BORDER;
+   if (!VKR_FILTER_OK(info->magFilter) || !VKR_FILTER_OK(info->minFilter) ||
+       (uint32_t)info->mipmapMode > VK_SAMPLER_MIPMAP_MODE_LINEAR ||
+       !VKR_ADDRESS_OK(info->addressModeU) || !VKR_ADDRESS_OK(info->addressModeV) ||
+       !VKR_ADDRESS_OK(info->addressModeW) ||
+       (info->compareEnable && (uint32_t)info->compareOp > VK_COMPARE_OP_ALWAYS) ||
+       (border && (uint32_t)info->borderColor > VK_BORDER_COLOR_INT_OPAQUE_WHITE &&
+        info->borderColor != VK_BORDER_COLOR_FLOAT_CUSTOM_EXT &&
+        info->borderColor != VK_BORDER_COLOR_INT_CUSTOM_EXT)) {
+      snprintf(why, why_size,
+               "filters %d/%d mipmap %d address %d/%d/%d compare %d/%d border %d",
+               info->magFilter, info->minFilter, info->mipmapMode, info->addressModeU,
+               info->addressModeV, info->addressModeW, info->compareEnable, info->compareOp,
+               info->borderColor);
+      return false;
+   }
+#undef VKR_FILTER_OK
+#undef VKR_ADDRESS_OK
+   return true;
+}
+
 static void
 vkr_dispatch_vkCreateSampler(struct vn_dispatch_context *dispatch,
                              struct vn_command_vkCreateSampler *args)
 {
+   /* OmacVM: made without waiting for an answer, as views */
+   char why[192];
+   if (!vkr_sampler_info_ok(args->pCreateInfo, why, sizeof(why))) {
+      vkr_context_refuse(dispatch->data, true, "vkCreateSampler", "%s", why);
+      args->ret = VK_ERROR_UNKNOWN;
+      return;
+   }
+
    vkr_sampler_create_and_add(dispatch->data, args);
 }
 
