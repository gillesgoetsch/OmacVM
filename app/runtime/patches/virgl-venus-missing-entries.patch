diff --git a/src/venus/vkr_missing_entries.c b/src/venus/vkr_missing_entries.c
new file mode 100644
index 0000000..f9aa430
--- /dev/null
+++ b/src/venus/vkr_missing_entries.c
@@ -0,0 +1,76 @@
+/*
+ * Copyright 2026 OmacVM contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+/* OmacVM (virgl-venus-missing-entries.patch): the stubs of vkr_missing_entries.h, one per
+ * proc table entry, each with the entry's own type (vkr_proc_entries.h is generated from
+ * the PFN typedefs, so no call goes through a cast function type). */
+
+#include "vkr_missing_entries.h"
+
+#include "vkr_context.h"
+
+/* a stub ignores its parameters */
+#pragma GCC diagnostic ignored "-Wunused-parameter"
+
+static void
+vkr_missing_entry(const char *name)
+{
+   struct vkr_context *ctx = vkr_dispatching_context;
+   if (ctx) {
+      vkr_context_refuse(ctx, true, name,
+                         "the app's Vulkan instance or device has no such command (it was "
+                         "not made with the Vulkan version or extension of it)");
+      return;
+   }
+
+   /* vkr's own call outside an app's commands: no context to end, the caller fails */
+   static atomic_uint_fast64_t calls;
+   const uint64_t n = atomic_fetch_add(&calls, 1) + 1;
+   if (!(n & (n - 1)))
+      vkr_log("%s: the Vulkan driver has no such command for this device; vkr's call "
+              "failed (%" PRIu64 " so far)", name, n);
+}
+
+#define VKR_MISSING_DEFINE(ret, name, params, fallback)                                    \
+   VKAPI_ATTR ret VKAPI_CALL vkr_missing_vk##name params                                   \
+   {                                                                                       \
+      vkr_missing_entry("vk" #name);                                                       \
+      return fallback;                                                                     \
+   }
+#define VKR_MISSING_DEFINE_VOID(name, params)                                              \
+   VKAPI_ATTR void VKAPI_CALL vkr_missing_vk##name params                                  \
+   {                                                                                       \
+      vkr_missing_entry("vk" #name);                                                       \
+   }
+VKR_PHYSICAL_DEVICE_PROC_ENTRIES(VKR_MISSING_DEFINE, VKR_MISSING_DEFINE_VOID)
+VKR_DEVICE_PROC_ENTRIES(VKR_MISSING_DEFINE, VKR_MISSING_DEFINE_VOID)
+
+/* A member added to either table upstream stops the build here until
+ * vkr_proc_entries.h is made again (Tests/virgl/venus-missing-entries.py). */
+_Static_assert(sizeof(struct vn_physical_device_proc_table) ==
+                  VKR_PHYSICAL_DEVICE_PROC_ENTRY_COUNT * sizeof(PFN_vkVoidFunction),
+               "vn_physical_device_proc_table changed: make vkr_proc_entries.h again");
+_Static_assert(sizeof(struct vn_device_proc_table) ==
+                  VKR_DEVICE_PROC_ENTRY_COUNT * sizeof(PFN_vkVoidFunction),
+               "vn_device_proc_table changed: make vkr_proc_entries.h again");
+
+#define VKR_MISSING_FILL(ret, name, params, fallback)                                      \
+   if (!table->name)                                                                       \
+      table->name = vkr_missing_vk##name;
+#define VKR_MISSING_FILL_VOID(name, params)                                                \
+   if (!table->name)                                                                       \
+      table->name = vkr_missing_vk##name;
+
+void
+vkr_physical_device_proc_table_fill_missing(struct vn_physical_device_proc_table *table)
+{
+   VKR_PHYSICAL_DEVICE_PROC_ENTRIES(VKR_MISSING_FILL, VKR_MISSING_FILL_VOID)
+}
+
+void
+vkr_device_proc_table_fill_missing(struct vn_device_proc_table *table)
+{
+   VKR_DEVICE_PROC_ENTRIES(VKR_MISSING_FILL, VKR_MISSING_FILL_VOID)
+}
diff --git a/src/venus/vkr_missing_entries.h b/src/venus/vkr_missing_entries.h
new file mode 100644
index 0000000..5f4660a
--- /dev/null
+++ b/src/venus/vkr_missing_entries.h
@@ -0,0 +1,43 @@
+/*
+ * Copyright 2026 OmacVM contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+/* OmacVM (virgl-venus-missing-entries.patch): no entry of a physical device's or a
+ * device's proc table is ever NULL. An entry the driver did not give (a command of a
+ * Vulkan version or extension the app's instance or device was not made with) points at
+ * a stub of the entry's own type. Called while a thread dispatches an app's commands
+ * (vkr_dispatching_context), the stub ends that app's Venus context with a log line;
+ * called from vkr's own code, it logs and returns an error (or 0), so the caller fails.
+ * A guest can send any command, so without this a NULL entry was a call to address 0 in
+ * QEMU's process. */
+
+#ifndef VKR_MISSING_ENTRIES_H
+#define VKR_MISSING_ENTRIES_H
+
+#include "vkr_common.h"
+
+#include "venus-protocol/vn_protocol_renderer_util.h"
+#include "vkr_proc_entries.h"
+
+#define VKR_MISSING_DECLARE(ret, name, params, fallback)                                   \
+   VKAPI_ATTR ret VKAPI_CALL vkr_missing_vk##name params;
+#define VKR_MISSING_DECLARE_VOID(name, params)                                             \
+   VKAPI_ATTR void VKAPI_CALL vkr_missing_vk##name params;
+VKR_PHYSICAL_DEVICE_PROC_ENTRIES(VKR_MISSING_DECLARE, VKR_MISSING_DECLARE_VOID)
+VKR_DEVICE_PROC_ENTRIES(VKR_MISSING_DECLARE, VKR_MISSING_DECLARE_VOID)
+#undef VKR_MISSING_DECLARE
+#undef VKR_MISSING_DECLARE_VOID
+
+/* Whether the driver has no such command for this object: the entry is its stub. Test
+ * entries with this, never against NULL. */
+#define VKR_MISSING(table, name) ((table)->name == vkr_missing_vk##name)
+
+/* puts the stub into every NULL entry */
+void
+vkr_physical_device_proc_table_fill_missing(struct vn_physical_device_proc_table *table);
+
+void
+vkr_device_proc_table_fill_missing(struct vn_device_proc_table *table);
+
+#endif /* VKR_MISSING_ENTRIES_H */
diff --git a/src/venus/vkr_physical_device.c b/src/venus/vkr_physical_device.c
index 946b782..a3680a3 100644
--- a/src/venus/vkr_physical_device.c
+++ b/src/venus/vkr_physical_device.c
@@ -355,6 +355,40 @@ vkr_physical_device_init_extensions(struct vkr_physical_device *physical_dev)
    physical_dev->extension_count = advertised_count;
 }
 
+/* OmacVM (virgl-venus-missing-entries.patch): whether the guest is told of the extension */
+static bool
+vkr_physical_device_lists(const struct vkr_physical_device *physical_dev, const char *name)
+{
+   for (uint32_t i = 0; i < physical_dev->extension_count; i++) {
+      if (!strcmp(physical_dev->extensions[i].extensionName, name))
+         return true;
+   }
+   return false;
+}
+
+/* OmacVM (virgl-venus-missing-entries.patch): the queries of device extensions come from
+ * the Vulkan loader, which gives an entry for each whether the driver has the extension
+ * or not, and ends the process when the driver has not (MoltenVK: cooperative matrix and
+ * fragment shading rate queries); they count only when the device lists the extension.
+ * Then every NULL entry gets its stub (vkr_missing_entries.h). */
+static void
+vkr_physical_device_init_missing_entries(struct vkr_physical_device *physical_dev)
+{
+   struct vn_physical_device_proc_table *vk = &physical_dev->proc_table;
+
+   if (!vkr_physical_device_lists(physical_dev, VK_KHR_CALIBRATED_TIMESTAMPS_EXTENSION_NAME) &&
+       !vkr_physical_device_lists(physical_dev, VK_EXT_CALIBRATED_TIMESTAMPS_EXTENSION_NAME))
+      vk->GetPhysicalDeviceCalibrateableTimeDomainsKHR = NULL;
+   if (!vkr_physical_device_lists(physical_dev, VK_KHR_COOPERATIVE_MATRIX_EXTENSION_NAME))
+      vk->GetPhysicalDeviceCooperativeMatrixPropertiesKHR = NULL;
+   if (!vkr_physical_device_lists(physical_dev, VK_KHR_FRAGMENT_SHADING_RATE_EXTENSION_NAME))
+      vk->GetPhysicalDeviceFragmentShadingRatesKHR = NULL;
+   if (!vkr_physical_device_lists(physical_dev, VK_EXT_SAMPLE_LOCATIONS_EXTENSION_NAME))
+      vk->GetPhysicalDeviceMultisamplePropertiesEXT = NULL;
+
+   vkr_physical_device_proc_table_fill_missing(vk);
+}
+
 static void
 vkr_physical_device_init_properties(struct vkr_physical_device *physical_dev)
 {
@@ -512,6 +546,7 @@ vkr_dispatch_vkEnumeratePhysicalDevices(struct vn_dispatch_context *dispatch,
       physical_dev->api_version =
          MIN2(physical_dev->properties.apiVersion, instance->api_version);
       vkr_physical_device_init_extensions(physical_dev);
+      vkr_physical_device_init_missing_entries(physical_dev);
       vkr_physical_device_init_memory_properties(physical_dev);
       vkr_physical_device_init_id_properties(physical_dev);
       vkr_physical_device_init_queue_family_properties(physical_dev);
