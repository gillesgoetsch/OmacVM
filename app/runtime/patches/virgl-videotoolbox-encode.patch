+/* ------------------------------------------------------------------------ */
+/* Encoder                                                                   */
+/* ------------------------------------------------------------------------ */
+
+/* The guest's VA-API driver hands over one raw picture per frame plus the
+ * parameters it wants (rate control, frame rate, GOP, picture type). The Mac's
+ * media engine encodes it (VTCompressionSession) and writes the whole stream
+ * itself, parameter sets included; the guest gets an Annex B access unit (H.264:
+ * SPS and PPS, HEVC: VPS, SPS and PPS before every key frame). VideoToolbox keeps
+ * its own reference frames and never reorders (no B frames), so the guest's
+ * reference lists and picture order counts are not needed.
+ * Threading: all calls come from vrend's thread. The output callback may run on
+ * a VideoToolbox thread at any time after EncodeFrame; it writes codec->coded,
+ * enc_status and enc_info under enc_lock, and vrend's side takes the lock too.
+ * A frame the guest never ended is completed (and dropped) before the next one
+ * starts, so one frame's output never mixes into another's. */
+
+/* Limits on what a guest may ask for. */
+#define VT_ENC_MIN_SIZE 16
+#define VT_ENC_MAX_W 4096
+#define VT_ENC_MAX_H 2304
+#define VT_ENC_MAX_BITRATE (400u * 1000 * 1000)
+#define VT_ENC_MAX_CODED (32u * 1024 * 1024)
+#define VT_ENC_MAX_GOP 3600
+#define VT_ENC_MAX_FPS 240
+
+static CMVideoCodecType enc_codec_type(enum vt_codec_kind kind)
+{
+    return kind == VT_KIND_HEVC ? kCMVideoCodecType_HEVC : kCMVideoCodecType_H264;
+}
+
+/* Hardware encoders only: a software VideoToolbox encoder would just move the
+ * guest's CPU work to the Mac's CPU. Asked once per codec. */
+static bool vt_encoder_offered(enum vt_codec_kind kind)
+{
+    static int offered[2] = { -1, -1 };
+    int i = kind == VT_KIND_HEVC;
+
+    if (kind != VT_KIND_H264 && kind != VT_KIND_HEVC)
+        return false;
+    if (offered[i] < 0) {
+        CFMutableDictionaryRef spec = CFDictionaryCreateMutable(
+            kCFAllocatorDefault, 0, &kCFTypeDictionaryKeyCallBacks,
+            &kCFTypeDictionaryValueCallBacks);
+        CFDictionaryRef props = NULL;
+        CFStringRef id = NULL;
+
+        CFDictionarySetValue(spec,
+            kVTVideoEncoderSpecification_RequireHardwareAcceleratedVideoEncoder,
+            kCFBooleanTrue);
+        offered[i] = !getenv("OMACVM_VIDEO_NO_ENCODE") &&
+                     !(i && getenv("OMACVM_VIDEO_NO_HEVC")) &&
+                     VTCopySupportedPropertyDictionaryForEncoder(1280, 720, enc_codec_type(kind),
+                                                                 spec, &id, &props) == noErr;
+        if (props)
+            CFRelease(props);
+        if (id)
+            CFRelease(id);
+        CFRelease(spec);
+        virgl_info("vt-video: hardware %s encoding %s\n", i ? "HEVC" : "H.264",
+                   offered[i] ? "offered" : "not offered");
+    }
+    return offered[i];
+}
+
+/* Parameter set i of the stream (H.264: SPS, PPS; HEVC: VPS, SPS, PPS). */
+static OSStatus enc_param_set(enum vt_codec_kind kind, CMFormatDescriptionRef fmt, size_t i,
+                              const uint8_t **ps, size_t *size, size_t *count, int *nal_len)
+{
+    if (kind == VT_KIND_HEVC)
+        return CMVideoFormatDescriptionGetHEVCParameterSetAtIndex(fmt, i, ps, size, count, nal_len);
+    return CMVideoFormatDescriptionGetH264ParameterSetAtIndex(fmt, i, ps, size, count, nal_len);
+}
+
+static void enc_output_locked(struct virgl_video_codec *codec, OSStatus status,
+                              VTEncodeInfoFlags flags, CMSampleBufferRef sample);
+
+static void enc_output_callback(void *ref_con, void *frame_ref_con, OSStatus status,
+                                VTEncodeInfoFlags flags, CMSampleBufferRef sample)
+{
+    struct virgl_video_codec *codec = ref_con;
+
+    (void)frame_ref_con;
+    pthread_mutex_lock(&codec->enc_lock);
+    enc_output_locked(codec, status, flags, sample);
+    pthread_mutex_unlock(&codec->enc_lock);
+}
+
+/* The output callback's work, with enc_lock held. */
+static void enc_output_locked(struct virgl_video_codec *codec, OSStatus status,
+                              VTEncodeInfoFlags flags, CMSampleBufferRef sample)
+{
+    static const uint8_t start[4] = { 0, 0, 0, 1 };
+    CMFormatDescriptionRef fmt;
+    CMBlockBufferRef block;
+    CFArrayRef attachments;
+    bool key = true;
+    size_t total = 0, contiguous = 0;
+    char *data = NULL, *copy = NULL;
+    int nal_len = 4;
+
+    codec->enc_status = status;
+    codec->enc_info = flags;
+    if (status != noErr || !sample || (flags & kVTEncodeInfo_FrameDropped))
+        return;
+
+    attachments = CMSampleBufferGetSampleAttachmentsArray(sample, false);
+    if (attachments && CFArrayGetCount(attachments) > 0) {
+        CFDictionaryRef a = CFArrayGetValueAtIndex(attachments, 0);
+        key = !CFDictionaryContainsKey(a, kCMSampleAttachmentKey_NotSync);
+    }
+
+    fmt = CMSampleBufferGetFormatDescription(sample);
+    if (key && fmt) {
+        size_t count = 0;
+        enc_param_set(codec->kind, fmt, 0, NULL, NULL, &count, &nal_len);
+        for (size_t i = 0; i < count && i < 8; i++) {
+            const uint8_t *ps = NULL;
+            size_t ps_size = 0;
+            if (enc_param_set(codec->kind, fmt, i, &ps, &ps_size, NULL, NULL) != noErr)
+                continue;
+            bytes_append(&codec->coded, start, 4);
+            bytes_append(&codec->coded, ps, ps_size);
+        }
+    } else if (fmt) {
+        enc_param_set(codec->kind, fmt, 0, NULL, NULL, NULL, &nal_len);
+    }
+    if (nal_len < 1 || nal_len > 4)
+        nal_len = 4;
+
+    /* AVCC/HVCC: each NAL unit after an nal_len-byte big-endian length. A frame
+     * that does not fit the limit is dropped whole (enc_status). */
+    /* The data pointer is good for `contiguous` bytes only: a block buffer in
+     * pieces is copied into one (bounded by the limit) first. */
+    block = CMSampleBufferGetDataBuffer(sample);
+    if (!block || CMBlockBufferGetDataPointer(block, 0, &contiguous, &total, &data) != noErr ||
+        total > VT_ENC_MAX_CODED) {
+        codec->enc_status = kVTVideoEncoderMalfunctionErr;
+        return;
+    }
+    if (contiguous < total) {
+        copy = malloc(total);
+        if (!copy || CMBlockBufferCopyDataBytes(block, 0, total, copy) != kCMBlockBufferNoErr) {
+            free(copy);
+            codec->enc_status = kVTVideoEncoderMalfunctionErr;
+            return;
+        }
+        data = copy;
+    }
+    for (size_t off = 0; off + nal_len <= total;) {
+        uint32_t len = 0;
+        for (int i = 0; i < nal_len; i++)
+            len = (len << 8) | (uint8_t)data[off + i];
+        off += nal_len;
+        if (len > total - off)
+            break;
+        if (codec->coded.size + 4 + len > VT_ENC_MAX_CODED ||
+            !bytes_append(&codec->coded, start, 4) ||
+            !bytes_append(&codec->coded, data + off, len)) {
+            codec->enc_status = kVTVideoEncoderMalfunctionErr;
+            codec->coded.size = 0;
+            break;
+        }
+        off += len;
+    }
+    free(copy);
+}
+
+static void enc_session_destroy(struct virgl_video_codec *codec)
+{
+    if (codec->enc) {
+        VTCompressionSessionCompleteFrames(codec->enc, kCMTimeInvalid);
+        VTCompressionSessionInvalidate(codec->enc);
+        CFRelease(codec->enc);
+        codec->enc = NULL;
+    }
+}
+
+static CFStringRef enc_profile_level(enum pipe_video_profile p)
+{
+    switch (p) {
+    case PIPE_VIDEO_PROFILE_MPEG4_AVC_CONSTRAINED_BASELINE:
+    case PIPE_VIDEO_PROFILE_MPEG4_AVC_BASELINE:
+        return kVTProfileLevel_H264_ConstrainedBaseline_AutoLevel;
+    case PIPE_VIDEO_PROFILE_MPEG4_AVC_MAIN:
+        return kVTProfileLevel_H264_Main_AutoLevel;
+    case PIPE_VIDEO_PROFILE_HEVC_MAIN:
+        return kVTProfileLevel_HEVC_Main_AutoLevel;
+    default:
+        return kVTProfileLevel_H264_High_AutoLevel;
+    }
+}
+
+static bool enc_session_make(struct virgl_video_codec *codec, bool low_latency)
+{
+    VTCompressionOutputCallback cb = enc_output_callback;
+    CFMutableDictionaryRef spec, attrs, iosurface;
+    OSStatus st;
+
+    spec = CFDictionaryCreateMutable(kCFAllocatorDefault, 0, &kCFTypeDictionaryKeyCallBacks,
+                                     &kCFTypeDictionaryValueCallBacks);
+    CFDictionarySetValue(spec,
+        kVTVideoEncoderSpecification_RequireHardwareAcceleratedVideoEncoder, kCFBooleanTrue);
+    if (low_latency)
+        CFDictionarySetValue(spec, kVTVideoEncoderSpecification_EnableLowLatencyRateControl,
+                             kCFBooleanTrue);
+    attrs = CFDictionaryCreateMutable(kCFAllocatorDefault, 0, &kCFTypeDictionaryKeyCallBacks,
+                                      &kCFTypeDictionaryValueCallBacks);
+    cf_dict_set_int(attrs, kCVPixelBufferPixelFormatTypeKey,
+                    (int32_t)kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange);
+    cf_dict_set_int(attrs, kCVPixelBufferWidthKey, (int32_t)codec->enc_w);
+    cf_dict_set_int(attrs, kCVPixelBufferHeightKey, (int32_t)codec->enc_h);
+    iosurface = CFDictionaryCreateMutable(kCFAllocatorDefault, 0, &kCFTypeDictionaryKeyCallBacks,
+                                          &kCFTypeDictionaryValueCallBacks);
+    CFDictionarySetValue(attrs, kCVPixelBufferIOSurfacePropertiesKey, iosurface);
+    CFRelease(iosurface);
+
+    st = VTCompressionSessionCreate(kCFAllocatorDefault, (int32_t)codec->enc_w,
+                                    (int32_t)codec->enc_h, enc_codec_type(codec->kind), spec,
+                                    attrs, kCFAllocatorDefault, cb, codec, &codec->enc);
+    CFRelease(spec);
+    CFRelease(attrs);
+    if (st != noErr) {
+        virgl_error("vt-video: VTCompressionSessionCreate %ux%u failed: %d\n",
+                    codec->enc_w, codec->enc_h, (int)st);
+        codec->enc = NULL;
+        return false;
+    }
+    return true;
+}
+
+/* Bitrate modes: no low-latency rate control. It drops frames to keep the
+ * bitrate, and a VA-API encoder has no way to tell the guest a frame was
+ * dropped (Chrome then gives up on the hardware encoder); DataRateLimits keeps
+ * the rate instead. Constant QP: a low-latency session, which takes the QP per
+ * frame (BaseFrameQP; no rate control, so nothing is dropped). Where the
+ * encoder cannot, a normal session with VideoToolbox's quality from the QP
+ * (an approximation, logged). Settings and time stamps start over. */
+static bool enc_session_create(struct virgl_video_codec *codec, bool cqp)
+{
+    CFBooleanRef frame_qp = NULL;
+
+    codec->enc_frame_qp = false;
+    if (cqp) {
+        if (!enc_session_make(codec, true))
+            return false;
+        if (VTSessionCopyProperty(codec->enc, kVTCompressionPropertyKey_SupportsBaseFrameQP,
+                                  kCFAllocatorDefault, &frame_qp) == noErr && frame_qp) {
+            codec->enc_frame_qp = frame_qp == kCFBooleanTrue;
+            CFRelease(frame_qp);
+        }
+        if (!codec->enc_frame_qp) {
+            if (codec->enc_sessions < 4)
+                virgl_warn("vt-video: no per-frame QP; constant QP approximated by quality\n");
+            enc_session_destroy(codec);
+        }
+    }
+    if (!codec->enc && !enc_session_make(codec, false))
+        return false;
+    VTSessionSetProperty(codec->enc, kVTCompressionPropertyKey_RealTime, kCFBooleanTrue);
+    VTSessionSetProperty(codec->enc, kVTCompressionPropertyKey_AllowFrameReordering,
+                         kCFBooleanFalse);
+    VTSessionSetProperty(codec->enc, kVTCompressionPropertyKey_ProfileLevel,
+                         enc_profile_level(codec->profile));
+    VTCompressionSessionPrepareToEncodeFrames(codec->enc);
+    codec->enc_cqp = cqp;
+    codec->enc_bitrate = codec->enc_peak = codec->enc_qp = 0;
+    codec->enc_fps_num = codec->enc_fps_den = codec->enc_gop = 0;
+    codec->enc_frame = 0;
+    codec->enc_pts = kCMTimeZero;
+    /* A guest switching modes every frame gets a new session every frame: log a few. */
+    if (codec->enc_sessions++ < 4)
+        virgl_info("vt-video: %s encoder %ux%u (pictures %ux%u), %s\n",
+                   codec->kind == VT_KIND_HEVC ? "HEVC" : "H.264", codec->enc_w, codec->enc_h,
+                   codec->width, codec->height,
+                   !cqp ? "bitrate" : codec->enc_frame_qp ? "constant QP" : "quality from QP");
+    return true;
+}
+
+/* The stream's size: the guest's pictures are padded to whole macroblocks or
+ * coding blocks (1920x1088 for 1080p) and its SPS crops them (H.264 frame
+ * cropping, HEVC conformance window, in 2-pixel units for 4:2:0). VideoToolbox
+ * writes its own SPS, so the session gets the cropped size instead. Only
+ * right/bottom cropping (what encoders pad); anything else keeps the full size. */
+static void enc_visible_size(const struct virgl_video_codec *codec,
+                             const union virgl_picture_desc *desc, uint32_t *w, uint32_t *h)
+{
+    uint32_t left, right, top, bottom;
+    bool crop;
+
+    *w = codec->width;
+    *h = codec->height;
+    if (codec->kind == VT_KIND_HEVC) {
+        const struct virgl_h265_enc_seq_param *q = &desc->h265_enc.seq;
+        crop = q->conformance_window_flag;
+        left = q->conf_win_left_offset;
+        right = q->conf_win_right_offset;
+        top = q->conf_win_top_offset;
+        bottom = q->conf_win_bottom_offset;
+    } else {
+        const struct virgl_h264_enc_seq_param *q = &desc->h264_enc.seq;
+        crop = q->enc_frame_cropping_flag;
+        left = q->enc_frame_crop_left_offset;
+        right = q->enc_frame_crop_right_offset;
+        top = q->enc_frame_crop_top_offset;
+        bottom = q->enc_frame_crop_bottom_offset;
+    }
+    if (!crop || left || top || right > VT_ENC_MAX_W || bottom > VT_ENC_MAX_H)
+        return;
+    if (2 * right + VT_ENC_MIN_SIZE <= codec->width && 2 * bottom + VT_ENC_MIN_SIZE <= codec->height) {
+        *w = codec->width - 2 * right;
+        *h = codec->height - 2 * bottom;
+    }
+}
+
+/* Copies the top-left w x h of an NV12 picture into another (CPU; once per
+ * stream, for the first picture, which arrives before the stream's size). */
+static bool enc_copy_picture(CVPixelBufferRef from, CVPixelBufferRef to)
+{
+    bool ok = false;
+
+    if (CVPixelBufferLockBaseAddress(from, kCVPixelBufferLock_ReadOnly) != kCVReturnSuccess)
+        return false;
+    if (CVPixelBufferLockBaseAddress(to, 0) == kCVReturnSuccess) {
+        ok = CVPixelBufferGetPlaneCount(from) == 2 && CVPixelBufferGetPlaneCount(to) == 2;
+        for (size_t p = 0; ok && p < 2; p++) {
+            const uint8_t *src = CVPixelBufferGetBaseAddressOfPlane(from, p);
+            uint8_t *dst = CVPixelBufferGetBaseAddressOfPlane(to, p);
+            size_t src_row = CVPixelBufferGetBytesPerRowOfPlane(from, p);
+            size_t dst_row = CVPixelBufferGetBytesPerRowOfPlane(to, p);
+            size_t rows = CVPixelBufferGetHeightOfPlane(to, p);
+            size_t bytes = CVPixelBufferGetWidthOfPlane(to, p) * (p ? 2 : 1);   /* Y, UV pairs */
+
+            if (!src || !dst || rows > CVPixelBufferGetHeightOfPlane(from, p) ||
+                bytes > src_row || bytes > dst_row) {
+                ok = false;
+                break;
+            }
+            for (size_t r = 0; r < rows; r++)
+                memcpy(dst + r * dst_row, src + r * src_row, bytes);
+        }
+        CVPixelBufferUnlockBaseAddress(to, 0);
+    }
+    CVPixelBufferUnlockBaseAddress(from, kCVPixelBufferLock_ReadOnly);
+    return ok;
+}
+
+/* What a frame asks for, from either codec's picture description. */
+struct enc_params {
+    uint32_t bitrate, peak, fps_num, fps_den, gop, qp_i, qp_p;
+    bool cqp, idr;
+};
+
+static void enc_params_get(const struct virgl_video_codec *codec,
+                           const union virgl_picture_desc *desc, struct enc_params *e)
+{
+    memset(e, 0, sizeof(*e));
+    if (codec->kind == VT_KIND_HEVC) {
+        const struct virgl_h265_enc_picture_desc *d = &desc->h265_enc;
+        e->bitrate = d->rc.target_bitrate;
+        e->peak = d->rc.peak_bitrate;
+        e->fps_num = d->rc.frame_rate_num;
+        e->fps_den = d->rc.frame_rate_den;
+        e->gop = d->seq.intra_period;
+        e->qp_i = d->rc.quant_i_frames;
+        e->qp_p = d->rc.quant_p_frames;
+        e->cqp = d->rc.rate_ctrl_method == PIPE_H2645_ENC_RATE_CONTROL_METHOD_DISABLE;
+        e->idr = d->picture_type == PIPE_H2645_ENC_PICTURE_TYPE_IDR;
+    } else {
+        const struct virgl_h264_enc_picture_desc *d = &desc->h264_enc;
+        e->bitrate = d->rate_ctrl[0].target_bitrate;
+        e->peak = d->rate_ctrl[0].peak_bitrate;
+        e->fps_num = d->rate_ctrl[0].frame_rate_num;
+        e->fps_den = d->rate_ctrl[0].frame_rate_den;
+        e->gop = d->gop_size ? d->gop_size : d->intra_idr_period;
+        e->qp_i = d->quant_i_frames;
+        e->qp_p = d->quant_p_frames;
+        e->cqp = d->rate_ctrl[0].rate_ctrl_method == PIPE_H2645_ENC_RATE_CONTROL_METHOD_DISABLE;
+        e->idr = d->picture_type == PIPE_H2645_ENC_PICTURE_TYPE_IDR;
+    }
+    /* Guest numbers, clamped to what makes sense. */
+    if (e->bitrate > VT_ENC_MAX_BITRATE)
+        e->bitrate = VT_ENC_MAX_BITRATE;
+    if (e->peak > VT_ENC_MAX_BITRATE)
+        e->peak = VT_ENC_MAX_BITRATE;
+    if (!e->fps_num || !e->fps_den || e->fps_den > 1000000 || e->fps_num < e->fps_den ||
+        e->fps_num / e->fps_den > VT_ENC_MAX_FPS) {
+        e->fps_num = 30;
+        e->fps_den = 1;
+    }
+    if (e->gop > VT_ENC_MAX_GOP)
+        e->gop = VT_ENC_MAX_GOP;
+    /* QP 1..51 (0, lossless, is not offered); one given counts for both. */
+    if (!e->qp_i)
+        e->qp_i = e->qp_p;
+    if (!e->qp_p)
+        e->qp_p = e->qp_i;
+    if (!e->qp_i)
+        e->qp_i = e->qp_p = 26;
+    if (e->qp_i > 51)
+        e->qp_i = 51;
+    if (e->qp_p > 51)
+        e->qp_p = 51;
+}
+
+static void enc_set_int(VTCompressionSessionRef s, CFStringRef key, int32_t v)
+{
+    CFNumberRef n = CFNumberCreate(kCFAllocatorDefault, kCFNumberSInt32Type, &v);
+    VTSessionSetProperty(s, key, n);
+    CFRelease(n);
+}
+
+/* Rate control, frame rate and key frame interval; set again only on change.
+ * Bitrate: the guest's target as the average, at most 1.5 times it (or its
+ * peak, if higher) in any second, so a frame is never dropped for the rate.
+ * Constant QP: the QP goes with each frame (enc_encode); only an encoder without
+ * per-frame QP gets VideoToolbox's quality from the guest's P-frame QP. */
+static void enc_apply_settings(struct virgl_video_codec *codec, const struct enc_params *e)
+{
+    if (e->cqp) {
+        if (!codec->enc_frame_qp && e->qp_p != codec->enc_qp) {
+            float q = (51.0f - (float)e->qp_p) / 51.0f;
+            CFNumberRef n = CFNumberCreate(kCFAllocatorDefault, kCFNumberFloatType, &q);
+            VTSessionSetProperty(codec->enc, kVTCompressionPropertyKey_Quality, n);
+            CFRelease(n);
+            codec->enc_qp = e->qp_p;
+        }
+    } else if (e->bitrate && (e->bitrate != codec->enc_bitrate || e->peak != codec->enc_peak)) {
+        uint64_t limit = (uint64_t)e->bitrate * 3 / 2;
+        int32_t bytes;
+        double secs = 1.0;
+        CFNumberRef nb, ns;
+        CFArrayRef limits;
+        const void *v[2];
+
+        if (e->peak > limit)
+            limit = e->peak;
+        bytes = (int32_t)(limit / 8);
+        enc_set_int(codec->enc, kVTCompressionPropertyKey_AverageBitRate, (int32_t)e->bitrate);
+        nb = CFNumberCreate(kCFAllocatorDefault, kCFNumberSInt32Type, &bytes);
+        ns = CFNumberCreate(kCFAllocatorDefault, kCFNumberDoubleType, &secs);
+        v[0] = nb;
+        v[1] = ns;
+        limits = CFArrayCreate(kCFAllocatorDefault, v, 2, &kCFTypeArrayCallBacks);
+        VTSessionSetProperty(codec->enc, kVTCompressionPropertyKey_DataRateLimits, limits);
+        CFRelease(limits);
+        CFRelease(nb);
+        CFRelease(ns);
+        codec->enc_bitrate = e->bitrate;
+        codec->enc_peak = e->peak;
+    }
+    if (e->fps_num != codec->enc_fps_num || e->fps_den != codec->enc_fps_den) {
+        double fps = (double)e->fps_num / e->fps_den;
+        CFNumberRef n = CFNumberCreate(kCFAllocatorDefault, kCFNumberDoubleType, &fps);
+        VTSessionSetProperty(codec->enc, kVTCompressionPropertyKey_ExpectedFrameRate, n);
+        CFRelease(n);
+        codec->enc_fps_num = e->fps_num;
+        codec->enc_fps_den = e->fps_den;
+    }
+    if (e->gop && e->gop != codec->enc_gop) {
+        enc_set_int(codec->enc, kVTCompressionPropertyKey_MaxKeyFrameInterval, (int32_t)e->gop);
+        codec->enc_gop = e->gop;
+    }
+}
+
+/* begin_frame: a picture buffer from the session's pool; vrend copies the
+ * guest's picture (its plane textures) into it. The session comes with the
+ * first picture description (it has the stream's size): the first picture
+ * gets a buffer of its own, at the guest's full picture size. */
+static int enc_begin_frame(struct virgl_video_codec *codec, struct virgl_video_buffer *target)
+{
+    struct virgl_video_dma_buf dmabuf;
+    CVPixelBufferPoolRef pool;
+
+    /* A frame the guest began but never ended: wait for it, drop its output and
+     * give the guest failure feedback for it. */
+    if (codec->enc && codec->enc_have_desc)
+        VTCompressionSessionCompleteFrames(codec->enc, kCMTimeInvalid);
+    if (codec->enc_attempted && callbacks && callbacks->encode_completed)
+        callbacks->encode_completed(codec, NULL, NULL, 0, NULL, NULL);
+    codec->enc_have_desc = false;
+    codec->enc_attempted = false;
+    pthread_mutex_lock(&codec->enc_lock);
+    codec->coded.size = 0;
+    pthread_mutex_unlock(&codec->enc_lock);
+    if (codec->enc_broken || target->format != PIPE_FORMAT_NV12 ||
+        target->width < codec->width || target->height < codec->height)
+        return -1;
+    if (codec->enc_src) {
+        CVPixelBufferRelease(codec->enc_src);
+        codec->enc_src = NULL;
+    }
+    if (codec->enc) {
+        pool = VTCompressionSessionGetPixelBufferPool(codec->enc);
+        if (!pool || CVPixelBufferPoolCreatePixelBuffer(kCFAllocatorDefault, pool,
+                                                        &codec->enc_src) != kCVReturnSuccess)
+            return -1;
+    } else {
+        CFMutableDictionaryRef attrs = CFDictionaryCreateMutable(kCFAllocatorDefault, 0,
+            &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+        CFDictionaryRef iosurface = CFDictionaryCreate(kCFAllocatorDefault, NULL, NULL, 0,
+            &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+        CVReturn r;
+
+        CFDictionarySetValue(attrs, kCVPixelBufferIOSurfacePropertiesKey, iosurface);
+        r = CVPixelBufferCreate(kCFAllocatorDefault, codec->width, codec->height,
+                                kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange, attrs,
+                                &codec->enc_src);
+        CFRelease(iosurface);
+        CFRelease(attrs);
+        if (r != kCVReturnSuccess)
+            return -1;
+    }
+    if (callbacks && callbacks->encode_upload_picture) {
+        memset(&dmabuf, 0, sizeof(dmabuf));
+        dmabuf.buf = target;
+        dmabuf.width = (uint32_t)CVPixelBufferGetWidth(codec->enc_src);
+        dmabuf.height = (uint32_t)CVPixelBufferGetHeight(codec->enc_src);
+        dmabuf.flags = VIRGL_VIDEO_DMABUF_WRITE_ONLY;
+        dmabuf.num_planes = (uint32_t)CVPixelBufferGetPlaneCount(codec->enc_src);
+        dmabuf.native = codec->enc_src;
+        if (callbacks->encode_upload_picture(codec, &dmabuf)) {
+            /* No picture: this frame fails (encode finds no enc_src). */
+            CVPixelBufferRelease(codec->enc_src);
+            codec->enc_src = NULL;
+            return -1;
+        }
+    }
+    return 0;
+}
+
+static int enc_encode(struct virgl_video_codec *codec, const union virgl_picture_desc *desc)
+{
+    CFMutableDictionaryRef props = NULL;
+    VTEncodeInfoFlags info = 0;
+    struct enc_params e;
+    OSStatus st;
+    bool key;
+
+    /* One picture per frame (begin_frame gives a new one). */
+    if (!codec->enc_src || codec->enc_have_desc)
+        return -1;
+    enc_params_get(codec, desc, &e);
+    /* Rate control mode changed (bitrate <-> constant QP): a new session, so no
+     * setting of the old mode stays (it starts with parameter sets and a key frame). */
+    if (codec->enc && e.cqp != codec->enc_cqp) {
+        enc_session_destroy(codec);
+        if (!enc_session_create(codec, e.cqp)) {
+            codec->enc_broken = true;
+            return -1;
+        }
+    }
+    if (!codec->enc) {
+        CVPixelBufferPoolRef pool;
+        CVPixelBufferRef first = NULL;
+
+        enc_visible_size(codec, desc, &codec->enc_w, &codec->enc_h);
+        if (!enc_session_create(codec, e.cqp)) {
+            codec->enc_broken = true;   /* logged once; the guest falls back */
+            return -1;
+        }
+        if (codec->enc_w != codec->width || codec->enc_h != codec->height) {
+            pool = VTCompressionSessionGetPixelBufferPool(codec->enc);
+            if (!pool || CVPixelBufferPoolCreatePixelBuffer(kCFAllocatorDefault, pool,
+                                                            &first) != kCVReturnSuccess ||
+                !enc_copy_picture(codec->enc_src, first)) {
+                if (first)
+                    CVPixelBufferRelease(first);
+                return -1;
+            }
+            CVPixelBufferRelease(codec->enc_src);
+            codec->enc_src = first;
+        }
+    }
+    enc_apply_settings(codec, &e);
+    key = e.idr || codec->enc_frame == 0;
+    if (key || codec->enc_frame_qp)
+        props = CFDictionaryCreateMutable(kCFAllocatorDefault, 0, &kCFTypeDictionaryKeyCallBacks,
+                                          &kCFTypeDictionaryValueCallBacks);
+    if (key)
+        CFDictionarySetValue(props, kVTEncodeFrameOptionKey_ForceKeyFrame, kCFBooleanTrue);
+    if (codec->enc_frame_qp) {
+        /* Every frame of such a session must carry it. */
+        CFNumberRef n = CFNumberCreate(kCFAllocatorDefault, kCFNumberSInt32Type,
+                                       key ? &e.qp_i : &e.qp_p);
+        CFDictionarySetValue(props, kVTEncodeFrameOptionKey_BaseFrameQP, n);
+        CFRelease(n);
+    }
+    /* Time stamps: each frame lasts 1/fps of the guest's current frame rate
+     * (fps_num <= 240 * fps_den), added up, so they increase also when the rate
+     * changes during the stream. */
+    CMTime pts = codec->enc_pts;
+    CMTime dur = CMTimeMake(codec->enc_fps_den, (int32_t)codec->enc_fps_num);
+    codec->enc_pts = CMTimeAdd(pts, dur);
+    pthread_mutex_lock(&codec->enc_lock);
+    codec->enc_status = noErr;
+    codec->enc_info = 0;
+    pthread_mutex_unlock(&codec->enc_lock);
+    st = VTCompressionSessionEncodeFrame(codec->enc, codec->enc_src, pts, dur, props, NULL, &info);
+    if (props)
+        CFRelease(props);
+    if (st != noErr) {
+        virgl_error("vt-video: encode frame failed: %d\n", (int)st);
+        return -1;
+    }
+    codec->enc_frame++;
+    codec->enc_have_desc = true;
+    return 0;
+}
+
+/* end_frame: wait for this frame's output and hand it to vrend. Whenever the
+ * guest asked for an encode this frame it gets feedback: the coded data, or a
+ * failure (never the previous frame's result left in its feedback buffer). */
+static int enc_end_frame(struct virgl_video_codec *codec, struct virgl_video_buffer *target)
+{
+    const void *bufs[1];
+    unsigned sizes[1];
+    bool ok;
+
+    (void)target;
+    if (!codec->enc_attempted)
+        return 0;
+    codec->enc_attempted = false;
+    if (codec->enc && codec->enc_have_desc)
+        VTCompressionSessionCompleteFrames(codec->enc, kCMTimeInvalid);
+    if (codec->enc_src) {
+        CVPixelBufferRelease(codec->enc_src);
+        codec->enc_src = NULL;
+    }
+    /* All output of this frame is in (CompleteFrames returned). */
+    pthread_mutex_lock(&codec->enc_lock);
+    ok = codec->enc_have_desc && codec->enc_status == noErr && codec->coded.size;
+    if (!ok && codec->errors++ < 5)
+        virgl_warn("vt-video: frame %llu not encoded: %s, status %d, flags 0x%x\n",
+                   (unsigned long long)codec->enc_frame,
+                   codec->enc_have_desc ? "no output" : "not sent to the encoder",
+                   (int)codec->enc_status, (unsigned)codec->enc_info);
+    codec->enc_have_desc = false;
+    if (ok) {
+        codec->frames++;
+        bufs[0] = codec->coded.data;
+        sizes[0] = (unsigned)codec->coded.size;
+    }
+    if (callbacks && callbacks->encode_completed)
+        callbacks->encode_completed(codec, NULL, NULL, ok ? 1 : 0, ok ? bufs : NULL,
+                                    ok ? sizes : NULL);
+    codec->coded.size = 0;
+    pthread_mutex_unlock(&codec->enc_lock);
+    return ok ? 0 : -1;
+}
