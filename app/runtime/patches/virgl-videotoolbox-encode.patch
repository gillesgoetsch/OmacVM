+/* ------------------------------------------------------------------------ */
+/* Encoder                                                                   */
+/* ------------------------------------------------------------------------ */
+
+/* The guest's VA-API driver hands over one raw picture per frame plus the
+ * parameters it wants (rate control, frame rate, GOP, picture type). The Mac's
+ * media engine encodes it (VTCompressionSession) and writes the whole stream
+ * itself, parameter sets included; the guest gets an H.264 Annex B access unit
+ * with SPS and PPS before every key frame. VideoToolbox keeps its own reference
+ * frames and never reorders (no B frames), so the guest's reference lists and
+ * picture order counts are not needed. */
+
+/* Limits on what a guest may ask for. */
+#define VT_ENC_MAX_W 4096
+#define VT_ENC_MAX_H 2304
+#define VT_ENC_MAX_BITRATE (400u * 1000 * 1000)
+#define VT_ENC_MAX_CODED (32u * 1024 * 1024)
+
+static bool vt_encoder_offered(void)
+{
+    static int offered = -1;
+
+    if (offered < 0) {
+        CFMutableDictionaryRef spec = CFDictionaryCreateMutable(
+            kCFAllocatorDefault, 0, &kCFTypeDictionaryKeyCallBacks,
+            &kCFTypeDictionaryValueCallBacks);
+        CFDictionaryRef props = NULL;
+        CFStringRef id = NULL;
+
+        CFDictionarySetValue(spec,
+            kVTVideoEncoderSpecification_RequireHardwareAcceleratedVideoEncoder,
+            kCFBooleanTrue);
+        offered = !getenv("OMACVM_VIDEO_NO_ENCODE") &&
+                  VTCopySupportedPropertyDictionaryForEncoder(1280, 720, kCMVideoCodecType_H264,
+                                                              spec, &id, &props) == noErr;
+        if (props)
+            CFRelease(props);
+        if (id)
+            CFRelease(id);
+        CFRelease(spec);
+        virgl_info("vt-video: hardware H.264 encoding %s\n", offered ? "offered" : "not offered");
+    }
+    return offered;
+}
+
+static void enc_output_callback(void *ref_con, void *frame_ref_con, OSStatus status,
+                                VTEncodeInfoFlags flags, CMSampleBufferRef sample)
+{
+    struct virgl_video_codec *codec = ref_con;
+    static const uint8_t start[4] = { 0, 0, 0, 1 };
+    CMFormatDescriptionRef fmt;
+    CMBlockBufferRef block;
+    CFArrayRef attachments;
+    bool key = true;
+    size_t total = 0;
+    char *data = NULL;
+    int nal_len = 4;
+
+    (void)frame_ref_con;
+    codec->enc_status = status;
+    if (status != noErr || !sample || (flags & kVTEncodeInfo_FrameDropped))
+        return;
+
+    attachments = CMSampleBufferGetSampleAttachmentsArray(sample, false);
+    if (attachments && CFArrayGetCount(attachments) > 0) {
+        CFDictionaryRef a = CFArrayGetValueAtIndex(attachments, 0);
+        key = !CFDictionaryContainsKey(a, kCMSampleAttachmentKey_NotSync);
+    }
+
+    fmt = CMSampleBufferGetFormatDescription(sample);
+    if (key && fmt) {
+        size_t count = 0;
+        CMVideoFormatDescriptionGetH264ParameterSetAtIndex(fmt, 0, NULL, NULL, &count, &nal_len);
+        for (size_t i = 0; i < count; i++) {
+            const uint8_t *ps = NULL;
+            size_t ps_size = 0;
+            if (CMVideoFormatDescriptionGetH264ParameterSetAtIndex(fmt, i, &ps, &ps_size,
+                                                                   NULL, NULL) != noErr)
+                continue;
+            bytes_append(&codec->coded, start, 4);
+            bytes_append(&codec->coded, ps, ps_size);
+        }
+    } else if (fmt) {
+        CMVideoFormatDescriptionGetH264ParameterSetAtIndex(fmt, 0, NULL, NULL, NULL, &nal_len);
+    }
+    if (nal_len < 1 || nal_len > 4)
+        nal_len = 4;
+
+    /* AVCC: each NAL unit after an nal_len-byte big-endian length. */
+    block = CMSampleBufferGetDataBuffer(sample);
+    if (!block || CMBlockBufferGetDataPointer(block, 0, NULL, &total, &data) != noErr)
+        return;
+    for (size_t off = 0; off + nal_len <= total;) {
+        uint32_t len = 0;
+        for (int i = 0; i < nal_len; i++)
+            len = (len << 8) | (uint8_t)data[off + i];
+        off += nal_len;
+        if (len > total - off)
+            break;
+        if (codec->coded.size + 4 + len > VT_ENC_MAX_CODED)
+            break;
+        bytes_append(&codec->coded, start, 4);
+        bytes_append(&codec->coded, data + off, len);
+        off += len;
+    }
+}
+
+static void enc_session_destroy(struct virgl_video_codec *codec)
+{
+    if (codec->enc) {
+        VTCompressionSessionCompleteFrames(codec->enc, kCMTimeInvalid);
+        VTCompressionSessionInvalidate(codec->enc);
+        CFRelease(codec->enc);
+        codec->enc = NULL;
+    }
+}
+
+static CFStringRef enc_profile_level(enum pipe_video_profile p)
+{
+    switch (p) {
+    case PIPE_VIDEO_PROFILE_MPEG4_AVC_CONSTRAINED_BASELINE:
+    case PIPE_VIDEO_PROFILE_MPEG4_AVC_BASELINE:
+        return kVTProfileLevel_H264_ConstrainedBaseline_AutoLevel;
+    case PIPE_VIDEO_PROFILE_MPEG4_AVC_MAIN:
+        return kVTProfileLevel_H264_Main_AutoLevel;
+    default:
+        return kVTProfileLevel_H264_High_AutoLevel;
+    }
+}
+
+static bool enc_session_create(struct virgl_video_codec *codec)
+{
+    VTCompressionOutputCallback cb = enc_output_callback;
+    CFMutableDictionaryRef spec, attrs, iosurface;
+    OSStatus st;
+
+    spec = CFDictionaryCreateMutable(kCFAllocatorDefault, 0, &kCFTypeDictionaryKeyCallBacks,
+                                     &kCFTypeDictionaryValueCallBacks);
+    CFDictionarySetValue(spec,
+        kVTVideoEncoderSpecification_RequireHardwareAcceleratedVideoEncoder, kCFBooleanTrue);
+    CFDictionarySetValue(spec, kVTVideoEncoderSpecification_EnableLowLatencyRateControl,
+                         kCFBooleanTrue);
+    attrs = CFDictionaryCreateMutable(kCFAllocatorDefault, 0, &kCFTypeDictionaryKeyCallBacks,
+                                      &kCFTypeDictionaryValueCallBacks);
+    cf_dict_set_int(attrs, kCVPixelBufferPixelFormatTypeKey,
+                    (int32_t)kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange);
+    cf_dict_set_int(attrs, kCVPixelBufferWidthKey, (int32_t)codec->width);
+    cf_dict_set_int(attrs, kCVPixelBufferHeightKey, (int32_t)codec->height);
+    iosurface = CFDictionaryCreateMutable(kCFAllocatorDefault, 0, &kCFTypeDictionaryKeyCallBacks,
+                                          &kCFTypeDictionaryValueCallBacks);
+    CFDictionarySetValue(attrs, kCVPixelBufferIOSurfacePropertiesKey, iosurface);
+    CFRelease(iosurface);
+
+    st = VTCompressionSessionCreate(kCFAllocatorDefault, (int32_t)codec->width,
+                                    (int32_t)codec->height, kCMVideoCodecType_H264, spec, attrs,
+                                    kCFAllocatorDefault, cb, codec, &codec->enc);
+    CFRelease(spec);
+    CFRelease(attrs);
+    if (st != noErr) {
+        virgl_error("vt-video: VTCompressionSessionCreate %ux%u failed: %d\n",
+                    codec->width, codec->height, (int)st);
+        codec->enc = NULL;
+        return false;
+    }
+    VTSessionSetProperty(codec->enc, kVTCompressionPropertyKey_RealTime, kCFBooleanTrue);
+    VTSessionSetProperty(codec->enc, kVTCompressionPropertyKey_AllowFrameReordering,
+                         kCFBooleanFalse);
+    VTSessionSetProperty(codec->enc, kVTCompressionPropertyKey_ProfileLevel,
+                         enc_profile_level(codec->profile));
+    VTCompressionSessionPrepareToEncodeFrames(codec->enc);
+    codec->enc_bitrate = codec->enc_fps_num = codec->enc_fps_den = codec->enc_gop = 0;
+    codec->enc_frame = 0;
+    virgl_info("vt-video: H.264 encoder %ux%u\n", codec->width, codec->height);
+    return true;
+}
+
+/* Rate control, frame rate and key frame interval from the guest's picture
+ * description; set again only when they change. */
+static void enc_apply_settings(struct virgl_video_codec *codec,
+                               const struct virgl_h264_enc_picture_desc *d)
+{
+    const struct virgl_h264_enc_rate_control *rc = &d->rate_ctrl[0];
+    uint32_t bitrate = rc->target_bitrate;
+    uint32_t num = rc->frame_rate_num, den = rc->frame_rate_den;
+    uint32_t gop = d->gop_size ? d->gop_size : d->intra_idr_period;
+
+    if (bitrate > VT_ENC_MAX_BITRATE)
+        bitrate = VT_ENC_MAX_BITRATE;
+    if (!num || !den || num / den > 240) {
+        num = 30;
+        den = 1;
+    }
+    if (gop > 3600)
+        gop = 3600;
+
+    if (bitrate && bitrate != codec->enc_bitrate &&
+        rc->rate_ctrl_method != PIPE_H2645_ENC_RATE_CONTROL_METHOD_DISABLE) {
+        int32_t b = (int32_t)bitrate;
+        CFNumberRef n = CFNumberCreate(kCFAllocatorDefault, kCFNumberSInt32Type, &b);
+        VTSessionSetProperty(codec->enc, kVTCompressionPropertyKey_AverageBitRate, n);
+        CFRelease(n);
+        codec->enc_bitrate = bitrate;
+    }
+    if (num != codec->enc_fps_num || den != codec->enc_fps_den) {
+        double fps = (double)num / den;
+        CFNumberRef n = CFNumberCreate(kCFAllocatorDefault, kCFNumberDoubleType, &fps);
+        VTSessionSetProperty(codec->enc, kVTCompressionPropertyKey_ExpectedFrameRate, n);
+        CFRelease(n);
+        codec->enc_fps_num = num;
+        codec->enc_fps_den = den;
+    }
+    if (gop && gop != codec->enc_gop) {
+        int32_t g = (int32_t)gop;
+        CFNumberRef n = CFNumberCreate(kCFAllocatorDefault, kCFNumberSInt32Type, &g);
+        VTSessionSetProperty(codec->enc, kVTCompressionPropertyKey_MaxKeyFrameInterval, n);
+        CFRelease(n);
+        codec->enc_gop = gop;
+    }
+}
+
+/* begin_frame: a picture buffer from the session's pool; vrend copies the
+ * guest's picture (its plane textures) into it. */
+static int enc_begin_frame(struct virgl_video_codec *codec, struct virgl_video_buffer *target)
+{
+    struct virgl_video_dma_buf dmabuf;
+    CVPixelBufferPoolRef pool;
+
+    if (target->format != PIPE_FORMAT_NV12 || target->width < codec->width ||
+        target->height < codec->height)
+        return -1;
+    if (!codec->enc && !enc_session_create(codec))
+        return -1;
+    if (codec->enc_src) {
+        CVPixelBufferRelease(codec->enc_src);
+        codec->enc_src = NULL;
+    }
+    pool = VTCompressionSessionGetPixelBufferPool(codec->enc);
+    if (!pool || CVPixelBufferPoolCreatePixelBuffer(kCFAllocatorDefault, pool,
+                                                    &codec->enc_src) != kCVReturnSuccess)
+        return -1;
+    if (callbacks && callbacks->encode_upload_picture) {
+        memset(&dmabuf, 0, sizeof(dmabuf));
+        dmabuf.buf = target;
+        dmabuf.width = codec->width;
+        dmabuf.height = codec->height;
+        dmabuf.flags = VIRGL_VIDEO_DMABUF_WRITE_ONLY;
+        dmabuf.num_planes = (uint32_t)CVPixelBufferGetPlaneCount(codec->enc_src);
+        dmabuf.native = codec->enc_src;
+        callbacks->encode_upload_picture(codec, &dmabuf);
+    }
+    codec->coded.size = 0;
+    codec->enc_have_desc = false;
+    return 0;
+}
+
+static int enc_encode(struct virgl_video_codec *codec, const union virgl_picture_desc *desc)
+{
+    const struct virgl_h264_enc_picture_desc *d = &desc->h264_enc;
+    CFMutableDictionaryRef props = NULL;
+    VTEncodeInfoFlags info = 0;
+    OSStatus st;
+
+    if (!codec->enc || !codec->enc_src)
+        return -1;
+    enc_apply_settings(codec, d);
+    if (d->picture_type == PIPE_H2645_ENC_PICTURE_TYPE_IDR || codec->enc_frame == 0) {
+        props = CFDictionaryCreateMutable(kCFAllocatorDefault, 0, &kCFTypeDictionaryKeyCallBacks,
+                                          &kCFTypeDictionaryValueCallBacks);
+        CFDictionarySetValue(props, kVTEncodeFrameOptionKey_ForceKeyFrame, kCFBooleanTrue);
+    }
+    CMTime pts = CMTimeMake((int64_t)codec->enc_frame * codec->enc_fps_den,
+                            (int32_t)codec->enc_fps_num);
+    CMTime dur = CMTimeMake(codec->enc_fps_den, (int32_t)codec->enc_fps_num);
+    codec->enc_status = noErr;
+    st = VTCompressionSessionEncodeFrame(codec->enc, codec->enc_src, pts, dur, props, NULL, &info);
+    if (props)
+        CFRelease(props);
+    if (st != noErr) {
+        virgl_error("vt-video: encode frame failed: %d\n", (int)st);
+        return -1;
+    }
+    codec->enc_frame++;
+    codec->enc_have_desc = true;
+    return 0;
+}
+
+/* end_frame: wait for this frame's output and hand it to vrend. */
+static int enc_end_frame(struct virgl_video_codec *codec, struct virgl_video_buffer *target)
+{
+    const void *bufs[1];
+    unsigned sizes[1];
+
+    (void)target;
+    if (!codec->enc || !codec->enc_have_desc)
+        return 0;
+    VTCompressionSessionCompleteFrames(codec->enc, kCMTimeInvalid);
+    codec->enc_have_desc = false;
+    if (codec->enc_src) {
+        CVPixelBufferRelease(codec->enc_src);
+        codec->enc_src = NULL;
+    }
+    if (codec->enc_status != noErr || !codec->coded.size) {
+        codec->errors++;
+        return -1;
+    }
+    codec->frames++;
+    bufs[0] = codec->coded.data;
+    sizes[0] = (unsigned)codec->coded.size;
+    if (callbacks && callbacks->encode_completed)
+        callbacks->encode_completed(codec, NULL, NULL, 1, bufs, sizes);
+    codec->coded.size = 0;
+    return 0;
+}
