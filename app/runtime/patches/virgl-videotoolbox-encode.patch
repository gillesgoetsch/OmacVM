+/* Encoding: copy the guest's picture (plane 0 Y as R8, plane 1 UV as RG8) into
+ * the encoder's IOSurface-backed CVPixelBuffer. The GPU blits each plane into
+ * a rectangle texture on the IOSurface plane; CPU readback when that fails.
+ * GL state touched here is put back exactly as it was. */
+/* Plane i of an NV12 video buffer: an R8 (Y) or RG8 (UV) 2D texture. */
+static struct vrend_resource *encode_plane(struct vrend_video_buffer *buf, unsigned i)
+{
+    struct vrend_resource *res = vrend_renderer_ctx_res_lookup(buf->ctx->ctx,
+                                                               buf->planes[i].res_handle);
+
+    if (!res || res->base.target == PIPE_BUFFER ||
+        res->base.format != (i ? PIPE_FORMAT_R8G8_UNORM : PIPE_FORMAT_R8_UNORM))
+        return NULL;
+    return res;
+}
+
+static bool blit_video_buffer_to_pixbuf(struct vrend_video_buffer *buf, CVPixelBufferRef pix)
+{
+    IOSurfaceRef surface = CVPixelBufferGetIOSurface(pix);
+    CGLContextObj cgl = CGLGetCurrentContext();
+    GLint old_read = 0, old_draw = 0, old_rect = 0;
+    GLboolean scissor, srgb, mask[4];
+    GLuint tex[2] = { 0 }, fbo[2] = { 0 };
+    bool ok = true;
+
+    if (!surface || !cgl || IOSurfaceGetPlaneCount(surface) != 2 || buf->num_planes < 2)
+        return false;
+
+    glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &old_read);
+    glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &old_draw);
+    glGetIntegerv(GL_TEXTURE_BINDING_RECTANGLE, &old_rect);
+    scissor = glIsEnabled(GL_SCISSOR_TEST);
+    srgb = glIsEnabled(GL_FRAMEBUFFER_SRGB);
+    glGetBooleanv(GL_COLOR_WRITEMASK, mask);
+    glDisable(GL_SCISSOR_TEST);
+    glDisable(GL_FRAMEBUFFER_SRGB);
+    glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+    while (glGetError() != GL_NO_ERROR)
+        ;   /* earlier errors are not this copy's */
+    glGenTextures(2, tex);
+    glGenFramebuffers(2, fbo);
+
+    for (unsigned i = 0; ok && i < 2; i++) {
+        struct vrend_resource *res;
+        GLsizei w = (GLsizei)IOSurfaceGetWidthOfPlane(surface, i);
+        GLsizei h = (GLsizei)IOSurfaceGetHeightOfPlane(surface, i);
+
+        res = encode_plane(buf, i);
+        if (!res || (uint32_t)w > res->base.width0 || (uint32_t)h > res->base.height0) {
+            ok = false;
+            break;
+        }
+        glBindTexture(GL_TEXTURE_RECTANGLE, tex[i]);
+        if (CGLTexImageIOSurface2D(cgl, GL_TEXTURE_RECTANGLE, i ? GL_RG8 : GL_R8, w, h,
+                                   i ? GL_RG : GL_RED, GL_UNSIGNED_BYTE, surface, i) != kCGLNoError) {
+            ok = false;
+            break;
+        }
+        glBindFramebuffer(GL_READ_FRAMEBUFFER, fbo[0]);
+        if (res->target == GL_TEXTURE_2D_ARRAY)
+            glFramebufferTextureLayer(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, res->gl_id, 0, 0);
+        else
+            glFramebufferTexture2D(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, res->target,
+                                   res->gl_id, 0);
+        glBindFramebuffer(GL_DRAW_FRAMEBUFFER, fbo[1]);
+        glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_RECTANGLE,
+                               tex[i], 0);
+        if (glCheckFramebufferStatus(GL_READ_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE ||
+            glCheckFramebufferStatus(GL_DRAW_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE) {
+            ok = false;
+            break;
+        }
+        glBlitFramebuffer(0, 0, w, h, 0, 0, w, h, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+        if (glGetError() != GL_NO_ERROR)
+            ok = false;
+    }
+
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, old_read);
