+        glPixelStorei(GL_PACK_ROW_LENGTH, row / texel);
+        glGetTexImage(GL_TEXTURE_2D, 0, i ? GL_RG : GL_RED, GL_UNSIGNED_BYTE, base);
+    }
+    glPixelStorei(GL_PACK_ROW_LENGTH, old_row);
+    glPixelStorei(GL_PACK_ALIGNMENT, old_align);
+    glBindBuffer(GL_PIXEL_PACK_BUFFER, old_pbo);
+    glBindTexture(GL_TEXTURE_2D, old_tex);
+    CVPixelBufferUnlockBaseAddress(pix, 0);
+}
