+/* OmacVM (virgl-resource-logical-size.patch): the size the guest samples a texture at. The
+ * guest is untrusted: the resource must be one of this context's, a one-level, single-sample
+ * 2D or 2D-array GL texture, and 0 < width <= its width, 0 < height <= its height; its own
+ * size takes the logical size away again. Anything else is ignored (logged once).
+ * OMACVM_VIDEO_LOGICAL=0 in QEMU's environment ignores every declaration. */
+bool vrend_renderer_resource_set_logical_size(struct vrend_context *ctx, uint32_t handle,
+                                              uint32_t width, uint32_t height)
+{
+   static int on = -1, refused;
+   struct vrend_resource *res;
+
+   if (on < 0) {
+      const char *env = getenv("OMACVM_VIDEO_LOGICAL");
+      on = !(env && !strcmp(env, "0"));
+   }
+   if (!on)
+      return false;
+   res = handle ? vrend_renderer_ctx_res_lookup(ctx, (int)handle) : NULL;
+   if (!res || !has_bit(res->storage_bits, VREND_STORAGE_GL_TEXTURE) ||
+       (res->base.target != PIPE_TEXTURE_2D && res->base.target != PIPE_TEXTURE_2D_ARRAY) ||
+       (res->target != GL_TEXTURE_2D && res->target != GL_TEXTURE_2D_ARRAY) ||
+       res->base.last_level || res->base.nr_samples > 1 || !width || !height ||
+       width > res->base.width0 || height > res->base.height0) {
+      if (!refused++)
+         virgl_warn("logical size: %ux%u for resource %u does not fit it, ignored (logged once)\n",
+                    width, height, handle);
+      return false;
+   }
+   if (width == res->base.width0 && height == res->base.height0)
+      width = height = 0;
+   virgl_debug("logical size: resource %u (%ux%u) sampled at %ux%u\n", handle,
+               res->base.width0, res->base.height0, width, height);
+   res->logical_width = width;
+   res->logical_height = height;
+   return true;
+}
