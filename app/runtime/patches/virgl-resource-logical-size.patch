+/* OmacVM (virgl-resource-logical-size.patch): a NOP may carry a private payload that older
+ * hosts skip like any NOP: "OMLS", version 1, then up to 8 x (resource, width, height), the
+ * size the guest samples each texture at (its VA-API driver's video planes, rounded up to
+ * 16). Anything else in a NOP is ignored, as before; a declaration that does not fit its
+ * resource is ignored on its own. Never an error: the context goes on. */
+#define VREND_NOP_LOGICAL_MAGIC 0x534c4d4fu   /* "OMLS" */
+#define VREND_NOP_LOGICAL_VERSION 1u
+#define VREND_NOP_LOGICAL_MAX 8u
+
+static int vrend_decode_nop(struct vrend_context *ctx, const uint32_t *buf, uint32_t length)
+{
+   uint32_t n;
+
+   if (length < 2 || buf[1] != VREND_NOP_LOGICAL_MAGIC)
+      return 0;
+   n = (length - 2) / 3;
+   if (buf[2] != VREND_NOP_LOGICAL_VERSION || (length - 2) % 3 || !n || n > VREND_NOP_LOGICAL_MAX) {
+      virgl_debug("logical size: a payload of %u words, version %u, ignored\n", length,
+                  buf[2]);
+      return 0;
+   }
+   for (uint32_t i = 0; i < n; i++)
+      vrend_renderer_resource_set_logical_size(ctx, buf[3 + 3 * i], buf[4 + 3 * i],
+                                               buf[5 + 3 * i]);
+   return 0;
+}
