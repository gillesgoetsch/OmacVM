+/* OmacVM (virgl-resource-logical-size.patch): a sampler the shader reads at its view's logical
+ * size gets vec4(scale, hi): normalized coordinates c become min(c * scale, hi), scale the
+ * logical size over the texture's, hi the centre of the last logical texel (sampling stops
+ * there, as at a texture's own edge). A view without one (its key bit not dropped yet)
+ * reads the whole texture. Set only when it changed: Apple's GL redoes much of its draw
+ * setup after a glUniform call. */
+static void vrend_set_logical_uniform(struct vrend_linked_shader_program *sprog,
+                                      int shader_type, int sampler_index,
+                                      const struct vrend_sampler_view *view)
+{
+   const struct vrend_resource *res = view ? view->texture : NULL;
+   GLfloat *cur = sprog->logical_vals[shader_type][sampler_index];
+   GLfloat v[4] = { 1.0f, 1.0f, 1.0f, 1.0f };
+
+   if (res && res->base.width0 && res->base.height0) {
+      float w = res->base.width0, h = res->base.height0;
+      float lw = vrend_view_logical(view) ? res->logical_width : w;
+      float lh = vrend_view_logical(view) ? res->logical_height : h;
+      v[0] = lw / w;
+      v[1] = lh / h;
+      v[2] = (lw - 0.5f) / w;
+      v[3] = (lh - 0.5f) / h;
+   }
+   if (!memcmp(cur, v, sizeof(v)))
+      return;
+   glUniform4f(sprog->logical_locs[shader_type][sampler_index], v[0], v[1], v[2], v[3]);
+   memcpy(cur, v, sizeof(v));
+}
