+/*
+ * OmacVM test hook (OMACVM_TEST_PACE_CHECK=1): as each whole frame goes on the layer, QEMU
+ * reads its surface (plain 8-bit or 10-bit surfaces: not the lossless ones, which nothing
+ * may read). Written while shown: the frame shown before must still hold the pixels it went
+ * up with (a 16 x 16 grid of them). With tests/graphics/pacing's page and its second
+ * counter strip at the bottom (8-bit): torn, the two counters differ; the steps between the
+ * frames' counters; and the marker cell's flips (QMP keys toggle it), for input latency.
+ */
+static int present_pace_on = -1;
+static struct {
+    IOSurfaceRef prev;                  /* shown before (retained) */
+    uint64_t prev_hash;
+    int last_n, mark;
+    uint64_t shown, unread, torn, overwritten, steps[4];   /* steps: 0, 1, 2, more */
+    int64_t log_ns, show_ns;
+} present_pace = { .last_n = -1, .mark = -1 };
+static os_unfair_lock present_pace_lock = OS_UNFAIR_LOCK_INIT;
+
+static int present_pace_lum(const uint8_t *base, size_t bpr, size_t w, size_t h, double x, double y)
+{
+    size_t xi = (size_t)x, yi = (size_t)y;
+    if (xi >= w || yi >= h) {
+        return -1;
+    }
+    const uint8_t *p = base + yi * bpr + xi * 4;
+    return (p[0] + p[1] + p[2]) / 3;
+}
+
+/* The counter of the strip at row y (cells of W/24), or -1. */
+static int present_pace_strip(const uint8_t *base, size_t bpr, size_t w, size_t h, double y)
+{
+    double cell = w / 24.0;
+    if (present_pace_lum(base, bpr, w, h, 1.5 * cell, y) < 200 ||
+        present_pace_lum(base, bpr, w, h, 18.5 * cell, y) > 60) {
+        return -1;
+    }
+    int v = 0;
+    for (int b = 0; b < 16; b++) {
+        if (present_pace_lum(base, bpr, w, h, (b + 2.5) * cell, y) > 128) {
+            v |= 1 << b;
+        }
+    }
+    return v;
+}
+
+/* The grid's hash, and the page's counters and marker (-1: none). False: not readable. */
+static bool present_pace_read(IOSurfaceRef s, uint64_t *hash, int *top, int *bottom, int *mark)
+{
+    OSType fmt = IOSurfaceGetPixelFormat(s);
+    if ((fmt != 'BGRA' && fmt != 'l10r') ||
+        IOSurfaceLock(s, kIOSurfaceLockReadOnly, NULL) != kIOReturnSuccess) {
+        return false;
+    }
+    const uint8_t *base = IOSurfaceGetBaseAddress(s);
+    size_t bpr = IOSurfaceGetBytesPerRow(s), w = IOSurfaceGetWidth(s), h = IOSurfaceGetHeight(s);
+    uint64_t x = 1469598103934665603ull;
+    for (int i = 0; i < 16; i++) {
+        for (int j = 0; j < 16; j++) {
+            uint32_t v;
+            memcpy(&v, base + (h * (2 * i + 1) / 32) * bpr + (w * (2 * j + 1) / 32) * 4, 4);
+            x = (x ^ v) * 1099511628211ull;
+        }
+    }
+    *hash = x;
+    double cell = w / 24.0;
+    *top = *bottom = *mark = -1;
+    if (fmt == 'BGRA') {
+        *top = present_pace_strip(base, bpr, w, h, 1.5 * cell);
+        *bottom = present_pace_strip(base, bpr, w, h, h - 1.5 * cell);
+        int m = present_pace_lum(base, bpr, w, h, 1.5 * cell, 2.7 * cell);
+        *mark = m < 0 ? -1 : m > 128;
+    }
+    IOSurfaceUnlock(s, kIOSurfaceLockReadOnly, NULL);
+    return true;
+}
+
+static void present_pace_check(IOSurfaceRef s)
+{
+    uint64_t hash = 0;
+    int top, bottom, mark;
+
+    if (present_pace_on < 0) {
+        present_pace_on = getenv("OMACVM_TEST_PACE_CHECK") != NULL;
+    }
+    if (!present_pace_on) {
+        return;
+    }
+    os_unfair_lock_lock(&present_pace_lock);
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_REALTIME);
+    if (present_pace.show_ns && now - present_pace.show_ns > 500 * SCALE_MS) {
+        /* the end of a burst: the last frame shown before the pause */
+        info_report("cocoa: pace-check: after %.1f s without a frame; the counter before: %d",
+                    (now - present_pace.show_ns) / 1e9, present_pace.last_n);
+    }
+    present_pace.show_ns = now;
+    present_pace.shown++;
+    if (present_pace.prev && present_pace.prev != s) {
+        uint64_t ph;
+        int pt, pb, pm;
+        if (present_pace_read(present_pace.prev, &ph, &pt, &pb, &pm) && ph != present_pace.prev_hash) {
+            present_pace.overwritten++;
+        }
+    }
+    bool read = present_pace_read(s, &hash, &top, &bottom, &mark);
+    if (!read) {
+        present_pace.unread++;
+    } else if (top >= 0) {
+        if (bottom >= 0 && bottom != top) {
+            present_pace.torn++;
+        }
+        if (present_pace.last_n >= 0) {
+            int d = (top - present_pace.last_n + 65536) % 65536;
+            present_pace.steps[d > 2 ? 3 : d]++;
+        }
+        present_pace.last_n = top;
+        if (mark >= 0 && present_pace.mark >= 0 && mark != present_pace.mark) {
+            info_report("cocoa: pace-check: marker %d shown", mark);
+        }
+        present_pace.mark = mark;
+    }
+    if (present_pace.prev) {
+        CFRelease(present_pace.prev);
+    }
+    present_pace.prev = read ? (IOSurfaceRef)CFRetain(s) : NULL;
+    present_pace.prev_hash = hash;
+    if (!present_pace.log_ns) {
+        present_pace.log_ns = now;
+    } else if (now - present_pace.log_ns >= 5 * NANOSECONDS_PER_SECOND) {
+        info_report("cocoa: pace-check: %" PRIu64 " shown, %" PRIu64 " not readable, %" PRIu64
+                    " torn, %" PRIu64 " written while shown; counter steps 0/1/2/more: %"
+                    PRIu64 "/%" PRIu64 "/%" PRIu64 "/%" PRIu64 ", last %d in 5 s",
+                    present_pace.shown, present_pace.unread, present_pace.torn,
+                    present_pace.overwritten, present_pace.steps[0], present_pace.steps[1],
+                    present_pace.steps[2], present_pace.steps[3], present_pace.last_n);
+        present_pace.shown = present_pace.unread = present_pace.torn = present_pace.overwritten = 0;
+        memset(present_pace.steps, 0, sizeof(present_pace.steps));
+        present_pace.log_ns = now;
+    }
+    os_unfair_lock_unlock(&present_pace_lock);
+}
+
+/*
+ * QEMU thread: SURF (retained and in use until shown or dropped) goes to the layer once
+ * the GPU is done with it: SYNC (QEMU's draw into it, present_ctx) or GFENCE (the guest's
+ * last write, a direct frame; through OPS). READ_SURF (retained, in use) is the guest's
+ * IOSurface a draw read: given back then.
+ */
+static void cocoa_gl_present_send(IOSurfaceRef surf, GLsync sync, void *gfence,
+                                  const DisplayGLIOSurfaceOps *ops, IOSurfaceRef read_surf,
+                                  GLint filter, bool linear)
+{
+    double flushed = CACurrentMediaTime();
