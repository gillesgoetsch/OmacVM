+/*
+ * OmacVM, direct present: a scanout buffer that virgl made as an IOSurface
+ * (virgl-scanout-iosurface.patch) goes on the layer as it is, with no draw into the
+ * present's surfaces. It waits for the guest's GPU work on it (virgl's fence after its
+ * last write) as a drawn frame waits for its draw, and takes the vsync queue like any
+ * frame; virgl moves the guest's next write into a buffer still in use to another
+ * IOSurface (virgl makes no IOSurface of a buffer whose first row is not the top). A
+ * frame of extra brightness is drawn from the IOSurface into the present's surfaces; the
+ * buffer sent last, flushed again with nothing written, is not sent again. Once a minute
+ * qemu.log says how the frames went.
+ */
+enum { PD_DIRECT, PD_BRIGHT, PD_SAME, PD_N };
+static const char *const present_direct_names[PD_N] = {
+    "on the layer as they are", "drawn for extra brightness", "the buffer sent last",
+};
+/* QEMU thread: the IOSurface sent to the layer last, as it is (NULL after a drawn frame) */
+static IOSurfaceRef present_direct_last;
+static int present_direct_last_how;
+static uint64_t present_direct_n[PD_N];
+static int64_t present_direct_log_ns;
+
+/* QEMU thread: the next flush of the guest's IOSurface sends it again (its layout changed). */
+static void omacvm_present_resend(void)
+{
+    present_direct_last = NULL;
+}
+
+static void present_direct_count(int why)
+{
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_REALTIME);
+
+    present_direct_n[why]++;
+    if (!present_direct_log_ns) {
+        present_direct_log_ns = now;
+    } else if (now - present_direct_log_ns >= 60 * NANOSECONDS_PER_SECOND) {
+        GString *line = g_string_new("");
+        for (int i = 0; i < PD_N; i++) {
+            if (present_direct_n[i]) {
+                g_string_append_printf(line, "%s%" PRIu64 " %s", line->len ? ", " : "",
+                                       present_direct_n[i], present_direct_names[i]);
+            }
+        }
+        info_report("cocoa: the guest's IOSurface frames, last minute: %s", line->str);
+        g_string_free(line, true);
+        memset(present_direct_n, 0, sizeof(present_direct_n));
+        present_direct_log_ns = now;
+    }
+}
+
+/* The colour space the guest's IOSurface shows in, as the present's surfaces would. */
+static void present_direct_tag(IOSurfaceRef surf, bool deep)
+{
+    CGColorSpaceRef cs = cocoa_gl_present_colorspace(deep, false);
+    CFPropertyListRef want = cs ? CGColorSpaceCopyPropertyList(cs) : NULL;
+    CFTypeRef now = IOSurfaceCopyValue(surf, kIOSurfaceColorSpace);
+
+    if (want && !(now && CFEqual(now, want))) {
+        IOSurfaceSetValue(surf, kIOSurfaceColorSpace, want);
+    } else if (!want && now) {
+        IOSurfaceRemoveValue(surf, kIOSurfaceColorSpace);
+    }
+    if (now) {
+        CFRelease(now);
+    }
+    if (want) {
+        CFRelease(want);
+    }
+    CGColorSpaceRelease(cs);
+}
+
+/*
+ * Drawing a RECTANGLE texture (an IOSurface) into the bound framebuffer: as QEMU's blit
+ * (flip as texture_blit_flip), or with gain_c as omacvm_bright_blit (linear light times
+ * gain, from PQ with pq). Any context of the display's share group: the programs are
+ * shared, each context has a vertex array of its own (none of them has an attribute).
+ */
+#define OMACVM_RECT_VERT \
+    "#version 140\n" \
+    "uniform vec2 size;\n" \
+    "uniform float yflip;\n" \
+    "out vec2 ex_tex_coord;\n" \
+    "void main(void) {\n" \
+    "    vec2 p = vec2(float(gl_VertexID & 1), float(gl_VertexID >> 1)) * 2.0 - 1.0;\n" \
+    "    gl_Position = vec4(p, 0.0, 1.0);\n" \
+    "    ex_tex_coord = vec2(1.0 + p.x, 1.0 + yflip * p.y) * 0.5 * size;\n" \
+    "}\n"
+#define OMACVM_RECT_FRAG \
+    "#version 140\n" \
+    "uniform sampler2DRect image;\n" \
+    "in vec2 ex_tex_coord;\n" \
+    "out vec4 out_frag_color;\n" \
+    "void main(void) {\n" \
+    "    out_frag_color = texture(image, ex_tex_coord);\n" \
+    "}\n"
+#define OMACVM_RECT_CTXS 8
+static struct { CGLContextObj ctx; GLuint vao; } omacvm_rect_vaos[OMACVM_RECT_CTXS];
+static unsigned omacvm_rect_next;
+static GLuint omacvm_rect_prog[2];          /* plain, extra brightness */
+static GLint omacvm_rect_u[2][4];           /* size, yflip, gain, pq */
+static int omacvm_rect_made;                /* 1 made, -1 failed */
+
+static bool omacvm_rect_programs(void)
+{
+    if (omacvm_rect_made) {
+        return omacvm_rect_made > 0;
+    }
+    /* the brightness shader as it is, reading a RECTANGLE texture */
+    GString *bright = g_string_new(OMACVM_BRIGHT_FRAG);
+    g_string_replace(bright, "uniform sampler2D image;", "uniform sampler2DRect image;", 1);
+    const char *frag[2] = { OMACVM_RECT_FRAG, bright->str };
+    omacvm_rect_made = 1;
+    for (int b = 0; b < 2 && omacvm_rect_made > 0; b++) {
+        GLuint vs = omacvm_bright_shader(GL_VERTEX_SHADER, OMACVM_RECT_VERT);
+        GLuint fs = omacvm_bright_shader(GL_FRAGMENT_SHADER, frag[b]);
+        GLint ok = 0;
+        if (vs && fs) {
+            omacvm_rect_prog[b] = glCreateProgram();
+            glAttachShader(omacvm_rect_prog[b], vs);
+            glAttachShader(omacvm_rect_prog[b], fs);
+            glLinkProgram(omacvm_rect_prog[b]);
+            glGetProgramiv(omacvm_rect_prog[b], GL_LINK_STATUS, &ok);
+        }
+        glDeleteShader(vs);
+        glDeleteShader(fs);
+        if (!ok) {
+            omacvm_rect_made = -1;
+            break;
+        }
+        glUseProgram(omacvm_rect_prog[b]);
+        glUniform1i(glGetUniformLocation(omacvm_rect_prog[b], "image"), 0);
+        omacvm_rect_u[b][0] = glGetUniformLocation(omacvm_rect_prog[b], "size");
+        omacvm_rect_u[b][1] = glGetUniformLocation(omacvm_rect_prog[b], "yflip");
+        omacvm_rect_u[b][2] = glGetUniformLocation(omacvm_rect_prog[b], "gain");
+        omacvm_rect_u[b][3] = glGetUniformLocation(omacvm_rect_prog[b], "pq");
+    }
+    g_string_free(bright, true);
+    if (omacvm_rect_made < 0) {
+        error_report("cocoa: no program for the guest's IOSurface frames: they stay black");
+    }
+    return omacvm_rect_made > 0;
+}
+
+static bool omacvm_rect_draw(GLuint tex, uint32_t w, uint32_t h, bool flip, GLint filter,
+                             int gain_c, bool pq)
+{
+    CGLContextObj ctx = CGLGetCurrentContext();
+    GLuint vao = 0;
+    int b = gain_c > 0;
+
+    if (!omacvm_rect_programs()) {
+        return false;
+    }
+    for (unsigned i = 0; i < OMACVM_RECT_CTXS && !vao; i++) {
+        if (omacvm_rect_vaos[i].ctx == ctx && glIsVertexArray(omacvm_rect_vaos[i].vao)) {
+            vao = omacvm_rect_vaos[i].vao;
+        }
+    }
+    if (!vao) {
+        unsigned i = omacvm_rect_next++ % OMACVM_RECT_CTXS;
+        glGenVertexArrays(1, &vao);
+        omacvm_rect_vaos[i].ctx = ctx;
+        omacvm_rect_vaos[i].vao = vao;
+    }
+    glActiveTexture(GL_TEXTURE0);
+    glBindTexture(GL_TEXTURE_RECTANGLE, tex);
+    glTexParameteri(GL_TEXTURE_RECTANGLE, GL_TEXTURE_MAG_FILTER, filter);
+    glTexParameteri(GL_TEXTURE_RECTANGLE, GL_TEXTURE_MIN_FILTER, filter);
+    glUseProgram(omacvm_rect_prog[b]);
+    glUniform2f(omacvm_rect_u[b][0], w, h);
+    glUniform1f(omacvm_rect_u[b][1], flip ? 1.0f : -1.0f);
+    if (b) {
+        glUniform1f(omacvm_rect_u[b][2], gain_c / 100.0f);
+        glUniform1f(omacvm_rect_u[b][3], pq ? 1.0f : 0.0f);
+    }
+    glBindVertexArray(vao);
+    glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+    glBindVertexArray(0);
+    glBindTexture(GL_TEXTURE_RECTANGLE, 0);
+    return true;
+}
+
+/* A RECTANGLE texture of the current context on the IOSurface, 0 when it cannot be bound. */
+static GLuint omacvm_iosurface_texture(IOSurfaceRef surf)
+{
+    bool deep = IOSurfaceGetPixelFormat(surf) == 'l10r';
+    GLuint tex = 0;
+
+    glGenTextures(1, &tex);
+    glBindTexture(GL_TEXTURE_RECTANGLE, tex);
+    if (CGLTexImageIOSurface2D(CGLGetCurrentContext(), GL_TEXTURE_RECTANGLE,
+                               deep ? GL_RGB10_A2 : GL_RGBA,
+                               IOSurfaceGetWidth(surf), IOSurfaceGetHeight(surf), GL_BGRA,
+                               deep ? GL_UNSIGNED_INT_2_10_10_10_REV :
+                                      GL_UNSIGNED_INT_8_8_8_8_REV,
+                               surf, 0) != kCGLNoError) {
+        glDeleteTextures(1, &tex);
+        tex = 0;
+    }
+    glBindTexture(GL_TEXTURE_RECTANGLE, 0);
+    return tex;
+}
+
+/* The current context (gpu) or the caller waits for the guest's writes into the buffer. */
+static void omacvm_iosurface_wait(const DisplayGLTexture *texture, uint32_t id, bool gpu)
+{
+    if (texture->iosurface_ops) {
+        texture->iosurface_ops->wait(texture->iosurface_ops->fence(id), gpu);
+    }
+}
+
+/*
+ * A layer's GL context (GPU safe mode, a second output's window), after the GPU wait for
+ * the guest's writes: the RECTANGLE texture of the guest's IOSurface drawn into the bound
+ * framebuffer. The IOSurface stays in use until the GPU is done with the draw, so the
+ * guest's next write moves it to another IOSurface instead of changing what is read.
+ */
+static void omacvm_iosurface_layer_draw(const DisplayGLTexture *texture, GLint filter)
+{
+    /* a queue and a context of their own: GPU safe mode makes no present queue */
+    static dispatch_queue_t queue;
+    static CGLContextObj wait_ctx;
+    IOSurfaceRef surf = texture->iosurface;
+
+    if (!queue && !wait_ctx) {
+        CGLPixelFormatObj pf = cocoa_gl_create_cgl_pixel_format(32);
+        if (CGLCreateContext(pf, gl_view_ctx, &wait_ctx) != kCGLNoError) {
+            wait_ctx = NULL;
+        }
+        CGLDestroyPixelFormat(pf);
+        if (wait_ctx) {
+            queue = dispatch_queue_create("org.omacvm.iosurface-reads",
+                dispatch_queue_attr_make_with_qos_class(DISPATCH_QUEUE_SERIAL,
+                                                        QOS_CLASS_USER_INTERACTIVE, 0));
+        }
+    }
+    if (!queue) {
+        /* no context to wait in: the draw is done before the IOSurface is let go */
+        omacvm_rect_draw(texture->id, texture->width, texture->height, texture->y_0_top,
+                         filter, 0, false);
+        glFinish();
+        return;
+    }
+    CFRetain(surf);
+    IOSurfaceIncrementUseCount(surf);
+    omacvm_rect_draw(texture->id, texture->width, texture->height, texture->y_0_top,
+                     filter, 0, false);
+    GLsync sync = glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+    glFlush();
+    dispatch_async(queue, ^{
+        CGLSetCurrentContext(wait_ctx);
+        for (int t = 0; t < 10000 && glClientWaitSync(sync, 0, 0) == GL_TIMEOUT_EXPIRED; t++) {
+            g_usleep(100);
+        }
