+    IOSurfaceIncrementUseCount(surf);
+    dispatch_async(present_queue, ^{
+        CGLSetCurrentContext(present_wait_ctx);
+        if (sync) {
+            /*
+             * Apple's glClientWaitSync spins a core until the fence
+             * signals: test it, and nap 100 us between tests (the queue is
+             * user-interactive, so naps are not stretched). At most 1 s,
+             * as before.
+             */
+            for (int t = 0; t < 10000; t++) {
+                if (glClientWaitSync(sync, 0, 0) != GL_TIMEOUT_EXPIRED) {
+                    break;
+                }
+                g_usleep(100);
+            }
+            glDeleteSync(sync);
+        }
+        if (ops) {
+            ops->wait(gfence, false);
+        }
+        CGLSetCurrentContext(NULL);
+        if (read_surf) {
+            surface_put(read_surf);
+        }
+        if (present_vsync) {
+            cocoa_gl_present_queue_frame((PresentFrame){
+                .surf = surf, .filter = filter, .flushed = flushed, .linear = linear,
+            });
+            return;
+        }
+        dispatch_async(dispatch_get_main_queue(), ^{
+            CALayer *layer = [cocoaView layer];
+            [CATransaction begin];
+            [CATransaction setDisableActions:YES];
+            NSString *f = filter == GL_LINEAR ? kCAFilterLinear : kCAFilterNearest;
+            [layer setMagnificationFilter:f];
+            [layer setMinificationFilter:f];
+            cocoa_gl_layer_follow(layer, surf, linear);
+            omacvm_present_gravity(layer, surf);
+            [layer setContents:(id)surf];
+            qatomic_set(&present_shown, surf);
+            present_tiles_whole_shown(layer, surf);
+            [CATransaction commit];
+            omacvm_park_frame_shown(flushed);
+            IOSurfaceDecrementUseCount(surf);
+            CFRelease(surf);
+        });
+    });
+    present_last_ns = qemu_clock_get_ns(QEMU_CLOCK_REALTIME);
+    if (present_pv_back_ns) {
+        info_report("cocoa: present: first frame %.1f ms after the window was seen again",
+                    (present_last_ns - present_pv_back_ns) / 1e6);
+        present_pv_back_ns = 0;
+    }
+}
