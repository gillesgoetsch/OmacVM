+
+/*
+ * OmacVM: the guest stops drawing while the VM's window cannot be seen
+ * (OmacVM.app's "Pause drawing while hidden", experimental; rules in
+ * ui/omacvm-guest-pause.h). Out of sight = macOS's occlusion says none of
+ * the window is on screen (minimised, wholly covered, on a Space not shown,
+ * closed with Keep running), or the screen is locked, the displays asleep
+ * or another user on the console. Then the guest's display agent is told
+ * {"unseen": ["Virtual-1"]} and turns that output's display off: no frames,
+ * no vblank, so Wayland apps stop drawing, as macOS apps do for a window
+ * nobody sees; sound, downloads and timers go on. Seen again: {"unseen": []}
+ * at once, and the window keeps its last picture until the guest's first
+ * frame. Visible windows are not touched: every frame, at the display's rate.
+ *
+ * The switch is the app's own defaults key pauseWhileHidden (QEMU runs as
+ * the app), watched with KVO so it works at once in a running VM;
+ * OMACVM_GUEST_PAUSE=1 or 0 decides instead (a QEMU not started as the app,
+ * tests). OMACVM_PRESENT_HIDDEN=1 (frames drawn for an unseen window) keeps
+ * the guest drawing too. Only an agent that says "pause": 1 in its hello is
+ * told (older agents would not know the word). Main thread.
+ */
+static int omacvm_gp_switch = -1;       /* -1: not read yet */
+static bool omacvm_gp_able;             /* the display agent can pause (its hello) */
+static unsigned omacvm_gp_gen;          /* the pending "unseen" timer's */
+static unsigned omacvm_gp_again_gen;    /* the next lease or "seen" again */
+static double omacvm_gp_unable_at;      /* out of sight with nobody to tell, since (0: not) */
+static unsigned omacvm_gp_unable_gen;   /* its timer's */
+
+static void omacvm_gp_read_switch(void)
+{
+    const char *e = getenv("OMACVM_GUEST_PAUSE");
+
+    if (e && (!strcmp(e, "1") || !strcmp(e, "0"))) {
+        omacvm_gp_switch = !strcmp(e, "1");
+    } else if (omacvm_bright_as_app()) {
+        CFPreferencesAppSynchronize((CFStringRef)[[NSBundle mainBundle] bundleIdentifier]);
+        omacvm_gp_switch = [[NSUserDefaults standardUserDefaults] boolForKey:@"pauseWhileHidden"];
+    } else {
+        omacvm_gp_switch = 0;
+    }
+}
+
+/* Whether the guest's display agent can be told now. */
+static OmacVMGpWhy omacvm_gp_why(void)
+{
+    return omacvm_chan_fd < 0 ? OMACVM_GP_NO_CHANNEL : !omacvm_guest_ready ? OMACVM_GP_NO_HELLO :
+           !omacvm_gp_able ? OMACVM_GP_NOT_ABLE : OMACVM_GP_SENT;
+}
+
+/*
+ * qemu.log: the word for the guest and what became of it, when that changed
+ * (the lease and the repeated "seen" log nothing new; omacvm_gp_log).
+ */
+static void omacvm_gp_say(OmacVMGpTell tell, OmacVMGpWhy why)
+{
+    static OmacVMGpLog said;
+    static const char *const whys[] = {
+        [OMACVM_GP_SENT] = "",
+        [OMACVM_GP_NO_CHANNEL] = "its display channel is closed",
+        [OMACVM_GP_NO_HELLO] = "its display agent has not said hello",
+        [OMACVM_GP_NOT_ABLE] = "its display agent cannot pause",
+        [OMACVM_GP_NOT_TAKEN] = "the display channel did not take the line",
+    };
+    __block double out_s = 0;
+    __block bool dark = false;
+    OmacVMGpSay say = omacvm_gp_log(&said, tell, why, CACurrentMediaTime());
+
+    if (say == OMACVM_GP_QUIET) {
+        return;
+    }
+    if (tell == OMACVM_GP_UNSEEN && why == OMACVM_GP_SENT) {
+        info_report("OmacVM: pause drawing while hidden: told the VM to stop drawing (the window is out of sight)");
+    } else if (tell == OMACVM_GP_UNSEEN) {
+        info_report("OmacVM: pause drawing while hidden: the window is out of sight, but the VM was not told (%s)",
+                    whys[why]);
+    } else if (why == OMACVM_GP_SENT) {
+        with_bql(^{
+            out_s = omacvm_gp.paused_s;
+            dark = omacvm_gp_dark;
+        });
+        /* Without OpenGL (GPU safe mode) the guest's display off is not seen here. */
+        info_report("OmacVM: pause drawing while hidden: told the VM to draw again after %.0f s%s", out_s,
+                    !display_opengl ? "" : dark ? " (its display went off)" : " (its display did not go off)");
+    } else {
+        info_report("OmacVM: pause drawing while hidden: the VM was not told to draw again (%s)", whys[why]);
+    }
+    if (say == OMACVM_GP_SAY_LAST) {
+        info_report("OmacVM: pause drawing while hidden: %d such lines in %.0f minutes, the next ones are left out",
+                    OMACVM_GP_LOG_MAX, OMACVM_GP_LOG_EVERY_S / 60);
+    }
+}
+
+static void omacvm_gp_send(OmacVMGpTell tell)
+{
+    OmacVMGpWhy why = omacvm_gp_why();
+
+    if (tell == OMACVM_GP_NONE) {
+        return;
+    }
+    if (why == OMACVM_GP_SENT) {
+        omacvm_chan_write(tell == OMACVM_GP_UNSEEN ? @"{\"unseen\":[\"Virtual-1\"]}" : @"{\"unseen\":[]}");
+        why = omacvm_chan_short ? OMACVM_GP_NOT_TAKEN : OMACVM_GP_SENT;
+    }
+    omacvm_gp_say(tell, why);
+}
+
+/*
+ * The channel drops a line it cannot write at once (a full socket): the
+ * lease ("unseen" again every 5 s while it holds) and "seen" again until the
+ * guest's first frame, from omacvm_gp_again.
+ */
+static void omacvm_gp_again_arm(void)
+{
+    __block double at = 0;
+    unsigned gen = ++omacvm_gp_again_gen;
+
+    with_bql(^{
+        at = omacvm_gp_again_at(&omacvm_gp);
+    });
+    if (at <= 0) {
+        return;
+    }
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW,
+                                 (int64_t)(MAX(0.0, at - CACurrentMediaTime()) * NSEC_PER_SEC)),
+                   dispatch_get_main_queue(), ^{
+        __block OmacVMGpTell again = OMACVM_GP_NONE;
+        if (gen != omacvm_gp_again_gen) {
+            return;
+        }
+        with_bql(^{
+            again = omacvm_gp_again(&omacvm_gp, CACurrentMediaTime());
+        });
+        omacvm_gp_send(again);
+        omacvm_gp_again_arm();
+    });
 }
 
+static void omacvm_gp_tell(OmacVMGpTell tell)
+{
+    if (tell == OMACVM_GP_NONE) {
+        return;
+    }
+    omacvm_gp_send(tell);
+    omacvm_gp_again_arm();
+}
+
+static void omacvm_gp_fire(unsigned gen)
+{
+    __block OmacVMGpTell tell = OMACVM_GP_NONE;
+
+    if (gen != omacvm_gp_gen) {
+        return;
+    }
+    with_bql(^{
+        tell = omacvm_gp_due(&omacvm_gp, CACurrentMediaTime());
+    });
+    omacvm_gp_tell(tell);
+}
+
+@interface OmacVMGuestPauseWatch : NSObject
+@end
+
+@implementation OmacVMGuestPauseWatch
+/* Any thread: the app's switch changed (this process or another). */
+- (void)observeValueForKeyPath:(NSString *)keyPath ofObject:(id)object
+                        change:(NSDictionary *)change context:(void *)context
+{
+    dispatch_async(dispatch_get_main_queue(), ^{
+        int was = omacvm_gp_switch;
+        omacvm_gp_read_switch();
+        if (was != omacvm_gp_switch) {
+            info_report("OmacVM: pause drawing while hidden: %s (the switch)",
+                        omacvm_gp_switch ? "on" : "off");
+            omacvm_gp_update();
+        }
+    });
+}
+@end
+
+static void omacvm_gp_update(void)
+{
+    static int always = -1;
+    __block OmacVMGpTell tell = OMACVM_GP_NONE;
+    __block double due = 0;
+    double now = CACurrentMediaTime();
+
+    if (omacvm_gp_switch < 0) {
+        static OmacVMGuestPauseWatch *watch;
+        const char *e = getenv("OMACVM_GUEST_PAUSE");
+        omacvm_gp_read_switch();
+        if (omacvm_bright_as_app() && !(e && *e)) {
+            watch = [[OmacVMGuestPauseWatch alloc] init];
+            [[NSUserDefaults standardUserDefaults] addObserver:watch
+                                                    forKeyPath:@"pauseWhileHidden"
+                                                       options:0
+                                                       context:NULL];
+        }
+        info_report("OmacVM: pause drawing while hidden: %s (%s)", omacvm_gp_switch ? "on" : "off",
+                    e && *e ? "OMACVM_GUEST_PAUSE" : "the app's switch");
+    }
+    if (always < 0) {
+        always = getenv("OMACVM_PRESENT_HIDDEN") != NULL;
+    }
+    /*
+     * The window's own state now, not only the last occlusion notice: a
+     * window that was never shown (ordered out from the start) sends none.
+     */
+    NSWindow *w = [cocoaView window];
+    bool on_screen = !w || ([w isVisible] && ([w occlusionState] & NSWindowOcclusionStateVisible));
+    bool seen = always || (on_screen && !omacvm_ds_screen_locked &&
+                           !omacvm_ds_asleep && !omacvm_ds_away && !omacvm_ds_test_locked);
+    with_bql(^{
+        tell = omacvm_gp_feed(&omacvm_gp, omacvm_gp_switch == 1 && omacvm_gp_able, seen, now);
+        due = omacvm_gp_due_at(&omacvm_gp);
+    });
+    /*
+     * Out of sight with the switch on while nothing can be told (no channel,
+     * an agent that cannot pause): said once it lasted OMACVM_GP_AFTER_S, as
+     * a pause would be (not for a window that is not shown yet at start).
+     */
+    if (!seen && omacvm_gp_switch == 1 && omacvm_gp_why() != OMACVM_GP_SENT) {
+        if (omacvm_gp_unable_at == 0) {
+            unsigned ugen = ++omacvm_gp_unable_gen;
+            omacvm_gp_unable_at = now;
+            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(OMACVM_GP_AFTER_S * NSEC_PER_SEC)),
+                           dispatch_get_main_queue(), ^{
+                if (ugen == omacvm_gp_unable_gen) {
+                    omacvm_gp_update();
+                }
+            });
+        } else if (now - omacvm_gp_unable_at >= OMACVM_GP_AFTER_S - 0.05) {
+            omacvm_gp_say(OMACVM_GP_UNSEEN, omacvm_gp_why());
+        }
+    } else if (omacvm_gp_unable_at != 0) {
+        omacvm_gp_unable_at = 0;
+        omacvm_gp_unable_gen++;
+    }
+    omacvm_gp_tell(tell);
+    unsigned gen = ++omacvm_gp_gen;
+    if (due > 0) {
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(MAX(0.0, due - now) * NSEC_PER_SEC)),
+                       dispatch_get_main_queue(), ^{ omacvm_gp_fire(gen); });
+    }
+}
+
+/* The guest's display agent said hello (again): whether it can pause; it knows nothing yet. */
+static void omacvm_gp_hello(NSDictionary *hello)
+{
+    __block bool told = false;
+    id p = hello[@"pause"];
+    bool able = [p isKindOfClass:[NSNumber class]] && [p intValue] == 1;
+
+    if (able != omacvm_gp_able && omacvm_gp_switch == 1) {
+        info_report("OmacVM: pause drawing while hidden: %s", able ? "the VM's display agent can pause"
+                    : "the VM's display agent cannot pause yet (Update VM)");
+    }
+    omacvm_gp_able = able;
+    omacvm_gp_update();
+    with_bql(^{
+        told = omacvm_gp.told;
+    });
+    if (told) {
+        omacvm_gp_tell(OMACVM_GP_UNSEEN);
+    }
+}
