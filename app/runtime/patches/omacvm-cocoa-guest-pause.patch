+/*
+ * OmacVM: the guest stops drawing while the window cannot be seen
+ * (omacvm-cocoa-guest-pause.patch, ui/omacvm-guest-pause.h). Fed on the
+ * main thread, read by the present and the guest's flushes, all with the
+ * BQL.
+ */
+static OmacVMGuestPause omacvm_gp = { .seen = true };
+static bool omacvm_chan_short;  /* the last line to the display channel was not all written (main thread) */
+static bool omacvm_gp_dark;     /* the guest's display went off while told (BQL) */
+static void omacvm_gp_update(void);
+static void omacvm_gp_hello(NSDictionary *hello);
+
+/*
+ * QEMU thread, BQL: the guest drew a frame, from a GL scanout's flush or a
+ * plain surface's update (GPU safe mode). The first one after "seen" ends
+ * the hold; the second goes into qemu.log after a pause.
+ */
+static void omacvm_gp_guest_frame(void)
+{
+    static double first_ms;
+    unsigned n = omacvm_gp_frame(&omacvm_gp);
+
+    if (n == 1) {
+        first_ms = 1000 * (CACurrentMediaTime() - omacvm_gp.seen_at);
+    } else if (n == 2 && omacvm_gp_dark) {
+        omacvm_gp_dark = false;
+        fprintf(stderr, "omacvm: guest drawing: paused for %.0f s while the window was out of sight; "
+                "frames again %.0f and %.0f ms after it was seen\n", omacvm_gp.paused_s, first_ms,
+                1000 * (CACurrentMediaTime() - omacvm_gp.seen_at));
+    }
+}
