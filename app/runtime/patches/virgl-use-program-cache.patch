+/* OmacVM: bumped whenever program bindings may have changed outside
+ * vrend_use_program() (a program or pipeline deleted, the blitter, a bind in an
+ * unknown context); it makes every sub context's bound_prog stale. Starts at 1 so
+ * a zeroed sub context never matches; 64 bits never wrap. Render thread only. */
+static uint64_t vrend_program_bind_gen = 1;
+
+/* OMACVM_VIRGL_PROGRAM_CACHE=0: bind the program on every draw again (as before). */
+static bool vrend_program_cache_on = true;
+
+static void vrend_program_bindings_changed(void)
+{
+   vrend_program_bind_gen++;
 }
 
