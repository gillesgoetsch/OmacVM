+#include "vkr_render_pass.h"
 
 static void
 vkr_dispatch_vkCreateShaderModule(struct vn_dispatch_context *dispatch,
@@ -195,6 +196,311 @@ vkr_pipeline_set_bind_point(struct object_array *arr, VkPipelineBindPoint bind_p
