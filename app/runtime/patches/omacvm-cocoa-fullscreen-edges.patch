+/*
+ * While the VM has the pointer in full screen, the Mac's cursor never reaches
+ * a corner of its display (a macOS hot corner: one put the Mac's display to
+ * sleep from inside the VM) nor the Dock's edge (on another display than the
+ * main window's the Dock came up there). Moving the cursor back after it got
+ * there is too late, so within 200 points of a corner or the Dock's edge the
+ * cursor is detached from the mouse and QEMU moves it from the mouse's
+ * motion, never closer than 3 points to such an outer edge. Edges shared
+ * with another display stay open, so the pointer still crosses to it. The guest's pointer is absolute: it simply
+ * stops short of the edge. Off with immersive=off; leaving full screen or the
+ * VM gives the cursor back.
+ */
+/* The detached cursor's place as a point in one of our views; false when not detached. */
+static bool omacvm_guarded_target(NSView **view, int *output, NSPoint *p)
+{
+    NSPoint q;
+
+    if (!omacvm_corner_held) {
+        return false;
+    }
+    q = NSMakePoint(omacvm_corner_pos.x,
+                    NSMaxY([[[NSScreen screens] firstObject] frame]) - omacvm_corner_pos.y);
+    for (int i = 0; i < omacvm_outputs; i++) {
+        NSWindow *w = i ? omacvm_heads[i].window : [cocoaView window];
+        NSView *v = i ? omacvm_heads[i].view : cocoaView;
+        if (w && v && [w isVisible] && NSPointInRect(q, [w frame])) {
+            *view = v;
+            *output = i;
+            *p = [v convertPoint:[w convertPointFromScreen:q] fromView:nil];
+            return true;
+        }
+    }
+    return false;
+}
+
+static void omacvm_corner_release(void)
+{
+    if (omacvm_corner_held) {
+        omacvm_corner_held = false;
+        CGAssociateMouseAndMouseCursorPosition(true);
+    }
+}
+
+static bool omacvm_display_at(CGFloat x, CGFloat y)
+{
+    CGDirectDisplayID id;
+    uint32_t n = 0;
+
+    return CGGetDisplaysWithPoint(CGPointMake(x, y), 1, &id, &n) == kCGErrorSuccess && n > 0;
+}
+
+/* The edge the Dock sits on: 0 bottom, 1 left, 2 right (read again on each full screen). */
+static int omacvm_dock_edge(void)
+{
+    if (omacvm_dock_edge_cache < 0) {
+        CFPropertyListRef v = CFPreferencesCopyAppValue(CFSTR("orientation"),
+                                                        CFSTR("com.apple.dock"));
+        omacvm_dock_edge_cache = 0;
+        if (v && CFGetTypeID(v) == CFStringGetTypeID()) {
+            if (CFStringCompare((CFStringRef)v, CFSTR("left"), 0) == kCFCompareEqualTo) {
+                omacvm_dock_edge_cache = 1;
+            } else if (CFStringCompare((CFStringRef)v, CFSTR("right"), 0) == kCFCompareEqualTo) {
+                omacvm_dock_edge_cache = 2;
+            }
+        }
+        if (v) {
+            CFRelease(v);
+        }
+    }
+    return omacvm_dock_edge_cache;
+}
+
+static void omacvm_guard_corners(NSEvent *event)
+{
+    const CGFloat zone = 200, g = 3;
+    CGDirectDisplayID id;
+    uint32_t n = 0;
+    CGPoint p;
+    CGRect r;
+    CGFloat minx, maxx, miny, maxy;
+    bool outl, outr, outt, outb, corner, dock;
+    int edge;
+
+    if (!immersive_mode_enabled || !omacvm_main_full_screen()) {
+        omacvm_corner_release();
+        return;
+    }
+    if (omacvm_corner_held) {
+        /* Detached: the cursor goes where the mouse's motion takes it. */
+        p = omacvm_corner_pos;
+        p.x += [event deltaX];
+        p.y += [event deltaY];
+    } else {
+        CGEventRef e = CGEventCreate(NULL);
+        if (!e) {
+            return;
+        }
+        p = CGEventGetLocation(e);
+        CFRelease(e);
+    }
+    if (CGGetDisplaysWithPoint(p, 1, &id, &n) != kCGErrorSuccess || n == 0) {
+        /* Past the outer edge of the displays: stay on the one it was on. */
+        if (!omacvm_corner_held ||
+            CGGetDisplaysWithPoint(omacvm_corner_pos, 1, &id, &n) != kCGErrorSuccess ||
+            n == 0) {
+            omacvm_corner_release();
+            return;
+        }
+    }
+    r = CGDisplayBounds(id);
+    minx = CGRectGetMinX(r);
+    maxx = CGRectGetMaxX(r) - 1;
+    miny = CGRectGetMinY(r);
+    maxy = CGRectGetMaxY(r) - 1;
+    p.x = MIN(MAX(p.x, minx), maxx);
+    p.y = MIN(MAX(p.y, miny), maxy);
+    /* Outer edges: no display beyond them. */
+    outl = !omacvm_display_at(minx - 1, p.y);
+    outr = !omacvm_display_at(maxx + 1, p.y);
+    outt = !omacvm_display_at(p.x, miny - 1);
+    outb = !omacvm_display_at(p.x, maxy + 1);
+    corner = MIN(p.x - minx, maxx - p.x) < zone && MIN(p.y - miny, maxy - p.y) < zone;
+    edge = omacvm_dock_edge();
+    dock = (edge == 0 && outb && maxy - p.y < zone) ||
+           (edge == 1 && outl && p.x - minx < zone) ||
+           (edge == 2 && outr && maxx - p.x < zone);
+    if (!corner && !dock) {
+        if (omacvm_corner_held) {
+            CGWarpMouseCursorPosition(p);
+            omacvm_corner_release();
+        }
+        return;
+    }
+    if (outl && (corner || edge == 1)) {
+        p.x = MAX(p.x, minx + g);
+    }
+    if (outr && (corner || edge == 2)) {
+        p.x = MIN(p.x, maxx - g);
+    }
+    if (outt && corner) {
+        p.y = MAX(p.y, miny + g);
+    }
+    if (outb && (corner || edge == 0)) {
+        p.y = MIN(p.y, maxy - g);
+    }
+    if (!omacvm_corner_held) {
+        /* Without this the cursor stalls for a moment after each warp. */
+        CGEventSourceRef src = CGEventSourceCreate(kCGEventSourceStateCombinedSessionState);
+        if (src) {
+            CGEventSourceSetLocalEventsSuppressionInterval(src, 0);
+            CFRelease(src);
+        }
+        omacvm_corner_held = true;
+        CGAssociateMouseAndMouseCursorPosition(false);
+    }
+    omacvm_corner_pos = p;
+    CGWarpMouseCursorPosition(p);
+}
+
 /* A display's rectangle in points, top-left origin (CoreGraphics' global space). */
 static OmacVMBox omacvm_display_box(NSScreen *s, bool below_notch)
 {
@@ -3692,6 +3883,22 @@ - (BOOL)windowShouldClose:(id)sender
     return NO;
 }
 
+/*
+ * The other displays' full-screen Spaces hide the Dock and the menu bar like
+ * the main window's (macOS's default there auto-hides them: the Dock came up
+ * at the bottom edge of an external display).
+ */
+- (NSApplicationPresentationOptions)window:(NSWindow *)window
+      willUseFullScreenPresentationOptions:(NSApplicationPresentationOptions)proposedOptions
+{
+    if (!immersive_mode_enabled) {
+        return proposedOptions;
+    }
+    return (proposedOptions & ~(NSApplicationPresentationAutoHideDock |
+                                NSApplicationPresentationAutoHideMenuBar)) |
+           NSApplicationPresentationHideDock | NSApplicationPresentationHideMenuBar;
+}
