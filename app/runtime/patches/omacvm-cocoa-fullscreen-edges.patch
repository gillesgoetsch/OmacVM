+/*
+ * The other displays' full-screen Spaces hide the Dock and the menu bar like
+ * the main window's (macOS's default there auto-hides them: the Dock came up
+ * at the bottom edge of an external display).
+ */
+- (NSApplicationPresentationOptions)window:(NSWindow *)window
+      willUseFullScreenPresentationOptions:(NSApplicationPresentationOptions)proposedOptions
+{
+    if (!immersive_mode_enabled) {
+        return proposedOptions;
+    }
+    return (proposedOptions & ~(NSApplicationPresentationAutoHideDock |
+                                NSApplicationPresentationAutoHideMenuBar)) |
+           NSApplicationPresentationHideDock | NSApplicationPresentationHideMenuBar;
+}
