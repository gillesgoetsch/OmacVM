+
+/* The GPU reads or writes a resource bound as a vertex, index, uniform, stream output,
+ * indirect, query or storage buffer through its GL buffer object. Only real GL buffers
+ * may be bound there: a texture's GL name means something else in the buffer namespace
+ * (or nothing, and the GL keeps the previous binding), and a buffer that lives only in
+ * guest memory has no GL object. */
+static bool vrend_res_is_gl_buffer(const struct vrend_resource *res)
+{
+   return res && res->base.target == PIPE_BUFFER &&
+          has_bit(res->storage_bits, VREND_STORAGE_GL_BUFFER) && res->gl_id;
+}
+
+/* [offset, offset + size) lies inside the buffer; 64-bit, so no 32-bit wrap. */
+static bool vrend_buffer_range_ok(const struct vrend_resource *res, uint64_t offset,
+                                  uint64_t size)
+{
+   return offset <= res->base.width0 && size <= res->base.width0 - offset;
 }
 
