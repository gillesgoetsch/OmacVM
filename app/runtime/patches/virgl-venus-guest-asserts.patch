index 640e760..f116286 100644
--- a/src/venus/vkr_ring.c
+++ b/src/venus/vkr_ring.c
@@ -342,7 +342,7 @@ vkr_ring_thread(void *arg)
    return ret;
 }
 
-void
+bool
 vkr_ring_start(struct vkr_ring *ring)
 {
    int ret;
@@ -352,17 +352,23 @@ vkr_ring_start(struct vkr_ring *ring)
    ret = thrd_create(&ring->thread, vkr_ring_thread, ring);
    if (ret != thrd_success)
       ring->started = false;
+   return ring->started;
 }
 
 bool
 vkr_ring_stop(struct vkr_ring *ring)
 {
    mtx_lock(&ring->mutex);
+   /* OmacVM (virgl-venus-guest-asserts.patch): a ring vkCreateRingMESA listed but never
+    * started (a guest's bad monitor period, or no thread) has no thread to stop */
+   if (!ring->started) {
+      mtx_unlock(&ring->mutex);
+      return true;
+   }
    if (thrd_equal(ring->thread, thrd_current())) {
       mtx_unlock(&ring->mutex);
       return false;
    }
-   assert(ring->started);
    ring->started = false;
    cnd_signal(&ring->cond);
    mtx_unlock(&ring->mutex);
