+/* Zero-copy path: bind the decoded frame's IOSurface planes as rectangle
+ * textures and let the GPU copy them into the guest's plane textures.
+ * GL state touched here is put back exactly as it was. */
+static bool blit_pixbuf_to_video_buffer(struct vrend_video_buffer *buf,
+                                        CVPixelBufferRef pix,
+                                        bool sixteen, bool interleaved)
+{
+    IOSurfaceRef surface = CVPixelBufferGetIOSurface(pix);
+    CGLContextObj cgl = CGLGetCurrentContext();
+    GLint old_read = 0, old_draw = 0, old_rect = 0;
+    GLboolean scissor, srgb, discard, mask[4];
+    GLuint tex[3] = { 0 }, fbo[2] = { 0 };
+    size_t planes;
+    bool ok = true;
+
+    if (!surface || !cgl)
+        return false;
+    planes = IOSurfaceGetPlaneCount(surface);
+    if (planes > 3)
+        planes = 3;
+
+    /* The guest's state must not touch the copy: conditional rendering (and
+     * on some drivers rasterizer discard) can drop a blit without a GL error,
+     * and the guest would show its old picture. Both are off for the copy, as
+     * vrend's own blits do it. */
+    vrend_renderer_pause_render_condition(buf->ctx->ctx, true);
+    discard = glIsEnabled(GL_RASTERIZER_DISCARD);
+    glDisable(GL_RASTERIZER_DISCARD);
+
+    glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &old_read);
+    glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &old_draw);
+    glGetIntegerv(GL_TEXTURE_BINDING_RECTANGLE, &old_rect);
+    scissor = glIsEnabled(GL_SCISSOR_TEST);
+    srgb = glIsEnabled(GL_FRAMEBUFFER_SRGB);
+    glGetBooleanv(GL_COLOR_WRITEMASK, mask);
+
+    glDisable(GL_SCISSOR_TEST);
+    glDisable(GL_FRAMEBUFFER_SRGB);
+    glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+    glGenTextures((GLsizei)planes, tex);
+    glGenFramebuffers(2, fbo);
+
+    for (unsigned i = 0; ok && i < planes && i < buf->num_planes; i++) {
+        struct vrend_resource *res;
+        bool rg = i && interleaved;
+        GLsizei sw = (GLsizei)IOSurfaceGetWidthOfPlane(surface, i);
+        GLsizei sh = (GLsizei)IOSurfaceGetHeightOfPlane(surface, i);
+        GLsizei w = sw, h = sh;
+        GLenum internal = sixteen ? (rg ? GL_RG16 : GL_R16) : (rg ? GL_RG8 : GL_R8);
+
+        res = vrend_renderer_ctx_res_lookup(buf->ctx->ctx, buf->planes[i].res_handle);
+        if (!res) {
+            ok = false;
+            break;
+        }
+        if ((uint32_t)w > res->base.width0)
+            w = res->base.width0;
+        if ((uint32_t)h > res->base.height0)
+            h = res->base.height0;
+
+        glBindTexture(GL_TEXTURE_RECTANGLE, tex[i]);
+        if (CGLTexImageIOSurface2D(cgl, GL_TEXTURE_RECTANGLE, internal, sw, sh,
+                                   rg ? GL_RG : GL_RED,
