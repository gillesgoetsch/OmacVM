+ * it neither floods the log nor goes quiet for good. */
+struct virgl_video_log_limit {
+    int64_t last_ns;        /* 0: not logged yet */
+    unsigned skipped;
+};
+
+static inline bool virgl_video_log_ok(struct virgl_video_log_limit *l, unsigned *skipped)
+{
+    struct timespec ts;
+    int64_t now;
+
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    now = (int64_t)ts.tv_sec * 1000000000 + ts.tv_nsec + 1;
+    if (l->last_ns && now - l->last_ns < 10 * (int64_t)1000000000) {
+        l->skipped++;
+        return false;
+    }
+    *skipped = l->skipped;
+    l->skipped = 0;
+    l->last_ns = now;
+    return true;
+}
+
+/* " (and N more since the last message)", or "" (one buffer: vrend's thread only) */
+static inline const char *virgl_video_log_since(unsigned skipped)
+{
+    static char s[64];
+
+    if (!skipped)
+        return "";
+    snprintf(s, sizeof(s), " (and %u more since the last message)", skipped);
+    return s;
+}
