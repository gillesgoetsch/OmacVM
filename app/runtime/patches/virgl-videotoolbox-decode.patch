+    VT_KIND_NONE,
+    VT_KIND_H264,
+    VT_KIND_HEVC,
+    VT_KIND_VP9,
+    VT_KIND_AV1,
+};
+
+/* Guest numbering (Mesa >= 26.0, src/gallium/include/pipe/p_video_enums.h). */
+enum {
+    G26_AVC_BASELINE = 7,
+    G26_AVC_CONSTRAINED_BASELINE = 8,
+    G26_AVC_MAIN = 9,
+    G26_AVC_EXTENDED = 10,
+    G26_AVC_HIGH = 11,
+    G26_AVC_HIGH10 = 12,
+    G26_AVC_HIGH422 = 13,
+    G26_AVC_HIGH444 = 14,
+    G26_HEVC_MAIN = 15,
+    G26_HEVC_MAIN_10 = 16,
+    G26_JPEG_BASELINE = 23,
+    G26_VP9_PROFILE0 = 24,
+    G26_VP9_PROFILE2 = 25,
+    G26_AV1_MAIN = 26,
+};
+
+static bool abi_legacy;
+
+/* Guest profile value -> virglrenderer's enum pipe_video_profile. */
+static enum pipe_video_profile host_profile(uint32_t guest)
+{
+    if (abi_legacy)
+        return (enum pipe_video_profile)guest;
+
+    switch (guest) {
+    case G26_AVC_BASELINE: return PIPE_VIDEO_PROFILE_MPEG4_AVC_BASELINE;
+    case G26_AVC_CONSTRAINED_BASELINE: return PIPE_VIDEO_PROFILE_MPEG4_AVC_CONSTRAINED_BASELINE;
+    case G26_AVC_MAIN: return PIPE_VIDEO_PROFILE_MPEG4_AVC_MAIN;
+    case G26_AVC_EXTENDED: return PIPE_VIDEO_PROFILE_MPEG4_AVC_EXTENDED;
+    case G26_AVC_HIGH: return PIPE_VIDEO_PROFILE_MPEG4_AVC_HIGH;
+    case G26_AVC_HIGH10: return PIPE_VIDEO_PROFILE_MPEG4_AVC_HIGH10;
+    case G26_AVC_HIGH422: return PIPE_VIDEO_PROFILE_MPEG4_AVC_HIGH422;
+    case G26_AVC_HIGH444: return PIPE_VIDEO_PROFILE_MPEG4_AVC_HIGH444;
+    case G26_HEVC_MAIN: return PIPE_VIDEO_PROFILE_HEVC_MAIN;
+    case G26_HEVC_MAIN_10: return PIPE_VIDEO_PROFILE_HEVC_MAIN_10;
+    case G26_JPEG_BASELINE: return PIPE_VIDEO_PROFILE_JPEG_BASELINE;
+    case G26_VP9_PROFILE0: return PIPE_VIDEO_PROFILE_VP9_PROFILE0;
+    case G26_VP9_PROFILE2: return PIPE_VIDEO_PROFILE_VP9_PROFILE2;
+    case G26_AV1_MAIN: return PIPE_VIDEO_PROFILE_AV1_MAIN;
+    default: return PIPE_VIDEO_PROFILE_UNKNOWN;
+    }
+}
+
+/* virglrenderer's enum -> the value the guest uses (for the caps). */
+static uint32_t guest_profile(enum pipe_video_profile host)
+{
+    if (abi_legacy)
+        return host;
+
+    switch (host) {
+    case PIPE_VIDEO_PROFILE_MPEG4_AVC_BASELINE: return G26_AVC_BASELINE;
+    case PIPE_VIDEO_PROFILE_MPEG4_AVC_CONSTRAINED_BASELINE: return G26_AVC_CONSTRAINED_BASELINE;
+    case PIPE_VIDEO_PROFILE_MPEG4_AVC_MAIN: return G26_AVC_MAIN;
+    case PIPE_VIDEO_PROFILE_MPEG4_AVC_EXTENDED: return G26_AVC_EXTENDED;
+    case PIPE_VIDEO_PROFILE_MPEG4_AVC_HIGH: return G26_AVC_HIGH;
+    case PIPE_VIDEO_PROFILE_MPEG4_AVC_HIGH10: return G26_AVC_HIGH10;
+    case PIPE_VIDEO_PROFILE_MPEG4_AVC_HIGH422: return G26_AVC_HIGH422;
+    case PIPE_VIDEO_PROFILE_MPEG4_AVC_HIGH444: return G26_AVC_HIGH444;
+    case PIPE_VIDEO_PROFILE_HEVC_MAIN: return G26_HEVC_MAIN;
+    case PIPE_VIDEO_PROFILE_HEVC_MAIN_10: return G26_HEVC_MAIN_10;
+    case PIPE_VIDEO_PROFILE_JPEG_BASELINE: return G26_JPEG_BASELINE;
+    case PIPE_VIDEO_PROFILE_VP9_PROFILE0: return G26_VP9_PROFILE0;
+    case PIPE_VIDEO_PROFILE_VP9_PROFILE2: return G26_VP9_PROFILE2;
+    case PIPE_VIDEO_PROFILE_AV1_MAIN: return G26_AV1_MAIN;
+    default: return 0;
+    }
+}
+
+static enum vt_codec_kind kind_of(enum pipe_video_profile p)
+{
+    switch (p) {
+    case PIPE_VIDEO_PROFILE_MPEG4_AVC_BASELINE:
+    case PIPE_VIDEO_PROFILE_MPEG4_AVC_CONSTRAINED_BASELINE:
+    case PIPE_VIDEO_PROFILE_MPEG4_AVC_MAIN:
+    case PIPE_VIDEO_PROFILE_MPEG4_AVC_EXTENDED:
+    case PIPE_VIDEO_PROFILE_MPEG4_AVC_HIGH:
+        return VT_KIND_H264;
+    case PIPE_VIDEO_PROFILE_HEVC_MAIN:
+    case PIPE_VIDEO_PROFILE_HEVC_MAIN_10:
+        return VT_KIND_HEVC;
+    case PIPE_VIDEO_PROFILE_VP9_PROFILE0:
+    case PIPE_VIDEO_PROFILE_VP9_PROFILE2:
+        return VT_KIND_VP9;
+    case PIPE_VIDEO_PROFILE_AV1_MAIN:
+        return VT_KIND_AV1;
+    default:
+        return VT_KIND_NONE;
+    }
+}
