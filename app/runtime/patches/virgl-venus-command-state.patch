+/* OmacVM (virgl-venus-command-state.patch): what a command buffer records into now. A
+ * draw needs a graphics pipeline bound and a pass, a dispatch a compute pipeline and no
+ * pass, the subpass commands their pass; KosmicKrisp dereferences the missing ones (its
+ * asserts are compiled out). Reset on begin, reset and pool reset. A command buffer is
+ * recorded by one guest thread at a time (the spec's external synchronization). */
+struct vkr_render_pass;
+
+enum vkr_cmd_pass {
+   VKR_CMD_PASS_NONE,
+   VKR_CMD_PASS_RENDER_PASS,
+   VKR_CMD_PASS_RENDERING,
+};
+
+struct vkr_cmd_state {
+   bool recording;
+   /* enum vkr_cmd_pass; a secondary begun to continue a pass has it from its inheritance */
+   uint8_t pass;
+   bool continues_pass;
+   uint32_t subpass, subpass_count;
+   /* the color attachments and view mask of the current subpass or rendering */
+   uint32_t colors, view_mask;
+   const struct vkr_render_pass *render_pass;
+   bool graphics_bound, compute_bound;
+   bool conditional;
+};
+
 struct vkr_command_buffer {
    struct vkr_object base;
 
    struct vkr_device *device;
    /* OmacVM (virgl-venus-command-limits.patch): only a primary executes secondaries */
    VkCommandBufferLevel level;
+   struct vkr_cmd_state state;
 };
 VKR_DEFINE_OBJECT_CAST(command_buffer, VK_OBJECT_TYPE_COMMAND_BUFFER, VkCommandBuffer)
 
