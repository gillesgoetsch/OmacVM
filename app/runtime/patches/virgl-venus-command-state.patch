    vn_replace_vkBeginCommandBuffer_args_handle(args);
    args->ret = vk->BeginCommandBuffer(args->commandBuffer, args->pBeginInfo);
+   cmd->state = st;
+   cmd->state.recording = args->ret == VK_SUCCESS;
