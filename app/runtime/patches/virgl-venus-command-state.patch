+ * records (begun, not ended or reset) */
 #define VKR_CMD_CALL(cmd_name, args, ...)                                                \
    do {                                                                                  \
       struct vkr_command_buffer *_cmd =                                                  \
          vkr_command_buffer_from_handle(args->commandBuffer);                            \
       struct vn_device_proc_table *_vk = &_cmd->device->proc_table;                      \
