+/* OmacVM (virgl-venus-command-state.patch): the state checks */
+static struct vkr_cmd_state *
+vkr_cmd_state(VkCommandBuffer handle)
+{
+   return &vkr_command_buffer_from_handle(handle)->state;
+}
+
+static void
+vkr_cmd_state_reset(struct vkr_command_buffer *cmd)
+{
+   memset(&cmd->state, 0, sizeof(cmd->state));
+}
+
+static bool
+vkr_cmd_draw_ok(struct vn_dispatch_context *dispatch, VkCommandBuffer handle, const char *call)
+{
+   const struct vkr_cmd_state *st = vkr_cmd_state(handle);
+   return vkr_context_check(dispatch->data, st->pass != VKR_CMD_PASS_NONE && st->graphics_bound,
+                            call, "%s", st->pass == VKR_CMD_PASS_NONE ? "outside a render pass"
+                                                                      : "no graphics pipeline bound");
+}
+
+static bool
+vkr_cmd_dispatch_ok(struct vn_dispatch_context *dispatch, VkCommandBuffer handle, const char *call)
+{
+   const struct vkr_cmd_state *st = vkr_cmd_state(handle);
+   return vkr_context_check(dispatch->data, st->pass == VKR_CMD_PASS_NONE && st->compute_bound,
+                            call, "%s", st->pass != VKR_CMD_PASS_NONE ? "inside a render pass"
+                                                                      : "no compute pipeline bound");
+}
+
+/* a pass begins: none may be open */
+static bool
+vkr_cmd_pass_begin_ok(struct vn_dispatch_context *dispatch, VkCommandBuffer handle, const char *call)
+{
+   return vkr_context_check(dispatch->data, vkr_cmd_state(handle)->pass == VKR_CMD_PASS_NONE, call,
+                            "inside a render pass already");
+}
+
+/* a pass this command buffer began ends, or moves to its next subpass */
+static bool
+vkr_cmd_pass_own_ok(struct vn_dispatch_context *dispatch,
+                    VkCommandBuffer handle,
+                    const char *call,
+                    enum vkr_cmd_pass kind,
+                    bool next)
+{
+   const struct vkr_cmd_state *st = vkr_cmd_state(handle);
+   return vkr_context_check(dispatch->data,
+                            st->pass == kind && !st->continues_pass &&
+                               (!next || st->subpass + 1 < st->subpass_count),
+                            call, "%s (subpass %u of %u)",
+                            st->pass != kind ? "no such pass begun here"
+                            : st->continues_pass ? "in a secondary that continues a pass"
+                                                 : "past the last subpass",
+                            st->subpass, st->subpass_count);
+}
+
+/* a pass ends: nothing of it stays for the commands after it (a query or timestamp after a
+ * multiview pass takes one query, not one per view of that pass) */
+static void
+vkr_cmd_leave_pass(struct vkr_cmd_state *st)
+{
+   st->pass = VKR_CMD_PASS_NONE;
+   st->subpass = 0;
+   st->subpass_count = 0;
+   st->colors = 0;
+   st->view_mask = 0;
+   st->render_pass_id = 0;
+   st->render_pass_serial = 0;
+   st->framebuffer_id = 0;
+   st->framebuffer_serial = 0;
+}
+
+/* pass: the open pass's render pass, looked up just now */
+static void
+vkr_cmd_enter_subpass(struct vkr_cmd_state *st,
+                      const struct vkr_render_pass *pass,
+                      uint32_t subpass)
+{
+   st->subpass = subpass;
+   if (pass && subpass < pass->subpass_count) {
+      st->colors = pass->subpasses[subpass].colors;
+      st->view_mask = pass->subpasses[subpass].view_mask;
+   }
+}
+
+/* a render pass begins: its pass and framebuffer by id and serial (begin_ok found both) */
+static void
+vkr_cmd_begin_render_pass(struct vkr_cmd_state *st,
+                          const struct vkr_render_pass *pass,
+                          const struct vkr_framebuffer *fb)
+{
+   st->pass = VKR_CMD_PASS_RENDER_PASS;
+   st->render_pass_id = pass->base.id;
+   st->render_pass_serial = pass->serial;
+   st->framebuffer_id = fb->base.id;
+   st->framebuffer_serial = fb->serial;
+   st->subpass_count = pass->subpass_count;
+   vkr_cmd_enter_subpass(st, pass, 0);
+}
+
+/* the open pass's render pass, if it and its framebuffer still exist: NextSubpass and
+ * EndRenderPass read both (vkr the subpass table, Mesa's vk_render_pass both); an app that
+ * destroyed one while recording has an invalid command buffer, and its context ends */
+static const struct vkr_render_pass *
+vkr_cmd_pass_objects(struct vn_dispatch_context *dispatch,
+                     const struct vkr_cmd_state *st,
+                     const char *call)
+{
+   struct vkr_context *ctx = dispatch->data;
+   const struct vkr_render_pass *pass =
+      vkr_render_pass_lookup(ctx, st->render_pass_id, st->render_pass_serial);
+   const bool fb =
+      vkr_framebuffer_lookup(ctx, st->framebuffer_id, st->framebuffer_serial) != NULL;
+   if (!vkr_context_check(ctx, pass && fb, call, "the pass's %s was destroyed",
+                          !pass ? "render pass" : "framebuffer"))
+      return NULL;
+   return pass;
+}
