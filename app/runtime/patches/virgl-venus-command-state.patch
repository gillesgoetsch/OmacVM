+   /* OmacVM (virgl-venus-command-state.patch): a secondary that continues a pass has the
+    * pass, subpass and colors of its inheritance (read before the handles are replaced) */
+   struct vkr_cmd_state st = { .recording = true };
+   const VkCommandBufferInheritanceInfo *inh = args->pBeginInfo->pInheritanceInfo;
+   if (cmd->level == VK_COMMAND_BUFFER_LEVEL_SECONDARY && inh &&
+       (args->pBeginInfo->flags & VK_COMMAND_BUFFER_USAGE_RENDER_PASS_CONTINUE_BIT)) {
+      const struct vkr_render_pass *pass = vkr_render_pass_from_handle(inh->renderPass);
+      const VkCommandBufferInheritanceRenderingInfo *rendering = vkr_find_struct(
+         inh->pNext, VK_STRUCTURE_TYPE_COMMAND_BUFFER_INHERITANCE_RENDERING_INFO);
+      st.continues_pass = true;
+      if (pass) {
+         st.pass = VKR_CMD_PASS_RENDER_PASS;
+         st.render_pass = pass;
+         st.subpass_count = pass->subpass_count;
+         vkr_cmd_enter_subpass(&st, inh->subpass);
+      } else {
+         st.pass = VKR_CMD_PASS_RENDERING;
+         st.colors = rendering ? rendering->colorAttachmentCount : 0;
+         st.view_mask = rendering ? rendering->viewMask : 0;
+      }
+   }
