+/* OmacVM (virgl-venus-command-state.patch): the state checks */
+static struct vkr_cmd_state *
+vkr_cmd_state(VkCommandBuffer handle)
+{
+   return &vkr_command_buffer_from_handle(handle)->state;
+}
+
+static void
+vkr_cmd_state_reset(struct vkr_command_buffer *cmd)
+{
+   memset(&cmd->state, 0, sizeof(cmd->state));
+}
+
+static bool
+vkr_cmd_draw_ok(struct vn_dispatch_context *dispatch, VkCommandBuffer handle, const char *call)
+{
+   const struct vkr_cmd_state *st = vkr_cmd_state(handle);
+   return vkr_context_check(dispatch->data, st->pass != VKR_CMD_PASS_NONE && st->graphics_bound,
+                            call, "%s", st->pass == VKR_CMD_PASS_NONE ? "outside a render pass"
+                                                                      : "no graphics pipeline bound");
+}
+
+static bool
+vkr_cmd_dispatch_ok(struct vn_dispatch_context *dispatch, VkCommandBuffer handle, const char *call)
+{
+   const struct vkr_cmd_state *st = vkr_cmd_state(handle);
+   return vkr_context_check(dispatch->data, st->pass == VKR_CMD_PASS_NONE && st->compute_bound,
+                            call, "%s", st->pass != VKR_CMD_PASS_NONE ? "inside a render pass"
+                                                                      : "no compute pipeline bound");
+}
+
+/* a pass begins: none may be open */
+static bool
+vkr_cmd_pass_begin_ok(struct vn_dispatch_context *dispatch, VkCommandBuffer handle, const char *call)
+{
+   return vkr_context_check(dispatch->data, vkr_cmd_state(handle)->pass == VKR_CMD_PASS_NONE, call,
+                            "inside a render pass already");
+}
+
+/* a pass this command buffer began ends, or moves to its next subpass */
+static bool
+vkr_cmd_pass_own_ok(struct vn_dispatch_context *dispatch,
+                    VkCommandBuffer handle,
+                    const char *call,
+                    enum vkr_cmd_pass kind,
+                    bool next)
+{
+   const struct vkr_cmd_state *st = vkr_cmd_state(handle);
+   return vkr_context_check(dispatch->data,
+                            st->pass == kind && !st->continues_pass &&
+                               (!next || st->subpass + 1 < st->subpass_count),
+                            call, "%s (subpass %u of %u)",
+                            st->pass != kind ? "no such pass begun here"
+                            : st->continues_pass ? "in a secondary that continues a pass"
+                                                 : "past the last subpass",
+                            st->subpass, st->subpass_count);
+}
+
+static void
+vkr_cmd_enter_subpass(struct vkr_cmd_state *st, uint32_t subpass)
+{
+   st->subpass = subpass;
+   if (st->render_pass && subpass < st->render_pass->subpass_count) {
+      st->colors = st->render_pass->subpasses[subpass].colors;
+      st->view_mask = st->render_pass->subpasses[subpass].view_mask;
+   }
+}
