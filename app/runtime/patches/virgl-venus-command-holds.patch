+/* OmacVM (virgl-venus-command-holds.patch, ADR 0065): a command buffer holds the image
+ * views, their images, the framebuffers and render passes its passes and renderings named,
+ * until it is reset, begun again or freed (its pool reset or destroyed): Mesa's
+ * vk_render_pass and KosmicKrisp read a pass's views wherever they split or end it, and
+ * MoltenVK's recorded commands keep raw view, framebuffer and render pass pointers that a
+ * submit reads. An image view holds its image (KosmicKrisp's view reads its image). The
+ * app may destroy a held object (the command buffer becomes invalid, which is legal): the
+ * id leaves the table at once, so a new object may take it, and the driver's destroy waits
+ * for the last holder. A command buffer holds objects of its own device only, so the
+ * device's teardown, which frees its command pools, lets go of every zombie of it. */
+
+/* tests tell a vkr with holds by this */
+#define VKR_COMMAND_HOLDS 1
+
+/* the device of a holdable object */
+struct vkr_device *
+vkr_holdable_device(const struct vkr_object *obj);
+
+/* the guest destroys obj, or its device goes (destroy_vk: as for the others there): true
+ * when it is held, then it is a zombie (out of the table and the device's list) and the
+ * caller destroys nothing */
+bool
+vkr_device_object_held(struct vkr_context *ctx, struct vkr_object *obj, bool destroy_vk);
+
+static inline void
+vkr_object_hold(struct vkr_object *obj)
+{
+   obj->holds++;
+}
+
+/* the last holder of a zombie destroys it */
+void
+vkr_object_unhold(struct vkr_object *obj);
+
 #endif /* VKR_DEVICE_H */
