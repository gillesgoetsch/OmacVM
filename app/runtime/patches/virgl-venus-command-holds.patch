+/* OmacVM (virgl-venus-command-holds.patch, vkr_device.h): the command buffer holds obj
+ * (NULL: none) until the driver let go of what it recorded. An object of another device is
+ * refused (the commonparent VUIDs of the begin infos); false after a refusal. */
+static bool
+vkr_cmd_hold(struct vkr_context *ctx,
+             struct vkr_command_buffer *cmd,
+             void *handle,
+             const char *call)
+{
+   struct vkr_object *obj = handle;
+   if (!obj)
+      return true;
+   if (!vkr_context_check(ctx, vkr_holdable_device(obj) == cmd->device, call,
+                          "an object of another device"))
+      return false;
+   if (!cmd->held) {
+      cmd->held = _mesa_hash_table_create(NULL, _mesa_hash_pointer, _mesa_key_pointer_equal);
+      if (!vkr_context_check(ctx, cmd->held != NULL, call, "out of host memory"))
+         return false;
+   }
+   const uint32_t hash = _mesa_hash_pointer(obj);
+   if (_mesa_hash_table_search_pre_hashed(cmd->held, hash, obj))
+      return true;
+   if (!vkr_context_check(ctx, _mesa_hash_table_insert_pre_hashed(cmd->held, hash, obj, obj),
+                          call, "out of host memory"))
+      return false;
+   vkr_object_hold(obj);
+   return true;
+}
+
+/* the driver let go of what the command buffer recorded (reset, begin, free): a zombie it
+ * held last is destroyed now */
+static void
+vkr_cmd_unhold_all(struct vkr_command_buffer *cmd)
+{
+   if (!cmd->held || !_mesa_hash_table_num_entries(cmd->held))
+      return;
+   hash_table_foreach (cmd->held, entry)
+      vkr_object_unhold((struct vkr_object *)entry->key);
+   _mesa_hash_table_clear(cmd->held, NULL);
+}
