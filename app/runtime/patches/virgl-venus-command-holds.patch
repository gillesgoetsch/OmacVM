+struct vkr_device *
+vkr_holdable_device(const struct vkr_object *obj)
+{
+   switch (obj->type) {
+   case VK_OBJECT_TYPE_IMAGE:
+      return ((const struct vkr_image *)obj)->device;
+   case VK_OBJECT_TYPE_IMAGE_VIEW:
+      return ((const struct vkr_image_view *)obj)->device;
+   case VK_OBJECT_TYPE_FRAMEBUFFER:
+      return ((const struct vkr_framebuffer *)obj)->device;
+   case VK_OBJECT_TYPE_RENDER_PASS:
+      return ((const struct vkr_render_pass *)obj)->device;
+   default:
+      return NULL;
+   }
+}
+
+bool
+vkr_device_object_held(struct vkr_context *ctx, struct vkr_object *obj, bool destroy_vk)
+{
+   if (likely(!obj->holds))
+      return false;
+   struct vkr_device *dev = vkr_holdable_device(obj);
+   assert(dev && !obj->zombie);
+
+   mtx_lock(&ctx->object_mutex);
+   struct hash_entry *entry = _mesa_hash_table_search(ctx->object_table, &obj->id);
+   if (entry && entry->data == obj)
+      _mesa_hash_table_remove(ctx->object_table, entry);
+   mtx_unlock(&ctx->object_mutex);
+
+   mtx_lock(&dev->object_mutex);
+   list_del(&obj->track_head);
+   list_add(&obj->track_head, &dev->zombies);
+   mtx_unlock(&dev->object_mutex);
+
+   obj->zombie = true;
+   obj->zombie_destroy_vk = destroy_vk;
+   return true;
+}
+
+void
+vkr_object_unhold(struct vkr_object *obj)
+{
+   assert(obj->holds);
+   if (--obj->holds || !obj->zombie)
+      return;
+
+   struct vkr_device *dev = vkr_holdable_device(obj);
+   struct vn_device_proc_table *vk = &dev->proc_table;
+   VkDevice device = dev->base.handle.device;
+
+   mtx_lock(&dev->object_mutex);
+   list_del(&obj->track_head);
+   mtx_unlock(&dev->object_mutex);
+
+   switch (obj->type) {
+   case VK_OBJECT_TYPE_IMAGE: {
+      /* dedicated memory alive: its free destroys the image (memory first) */
+      const bool waits =
+         vkr_dedicated_target_destroyed(dev, ((struct vkr_image *)obj)->dedicated);
+      if (obj->zombie_destroy_vk && !waits)
+         vk->DestroyImage(device, obj->handle.image, NULL);
+      break;
+   }
+   case VK_OBJECT_TYPE_IMAGE_VIEW:
+      if (obj->zombie_destroy_vk)
+         vk->DestroyImageView(device, obj->handle.image_view, NULL);
+      break;
+   case VK_OBJECT_TYPE_FRAMEBUFFER:
+      if (obj->zombie_destroy_vk)
+         vk->DestroyFramebuffer(device, obj->handle.framebuffer, NULL);
+      break;
+   case VK_OBJECT_TYPE_RENDER_PASS:
+      if (obj->zombie_destroy_vk)
+         vk->DestroyRenderPass(device, obj->handle.render_pass, NULL);
+      break;
+   default:
+      assert(false);
+      break;
+   }
+   /* a view lets go of its image here (vkr_image_object_release) */
+   vkr_object_free(obj);
+}
+
 static void
 vkr_dispatch_vkDestroyDevice(struct vn_dispatch_context *dispatch,
                              struct vn_command_vkDestroyDevice *args)
