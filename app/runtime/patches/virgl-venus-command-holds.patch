+      vkr_cmd_set_views(cmd, NULL, 0);
+      /* OmacVM (virgl-venus-command-holds.patch): the driver freed it already */
+      vkr_cmd_unhold_all(cmd);
+      _mesa_hash_table_destroy(cmd->held, NULL);
+      cmd->held = NULL;
+   }
 }
 
