+         * Only a click does (it also brings OmacVM.app to the front). The
+         * guest still gets the pointer's place (omacvmHover).
          */
         if (button < 0 && (!isAbsoluteEnabled || ![NSApp isActive])) {
+            if ([self omacvmHoverWanted:event view:view output:output button:button]) {
+                [self omacvmHover:event view:view output:output];
+            }
             return;
         }
         [self grabMouse];
@@ -3190,6 +3292,11 @@
         qemu_input_event_sync();
     });
 }
+@end
+
+/* OmacVM: the owner of the main view's second tracking area (omacvmHoverMain). */
+@implementation OmacVMHoverWatch
+- (void)mouseMoved:(NSEvent *)e { [cocoaView omacvmHoverMain:e]; }
 @end
 
