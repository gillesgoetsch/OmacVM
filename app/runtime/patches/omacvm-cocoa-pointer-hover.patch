+}
+
+/*
+ * OmacVM: may this event over one of the VM's windows give the guest the
+ * pointer's place without taking the pointer (ui/omacvm-pointer-hover.h)?
+ * button < 0: a move. Main thread.
+ */
+- (bool) omacvmHoverWanted:(NSEvent *)event view:(NSView *)view output:(int)output
+                    button:(int)button
+{
+    NSWindow *w = [view window];
+    OmacVMHoverIn in = {
+        .off = omacvm_hover_off,
+        .absolute = isAbsoluteEnabled,
+        .grabbed = isMouseGrabbed,
+        .active = [NSApp isActive],
+        .move = button < 0,
+        .buttons = [NSEvent pressedMouseButtons] != 0,
+        .touchid = omacvm_touchid_up,
+        .displays = omacvm_active_outputs(),
+        .full = output > 0 || omacvm_main_full_screen(),
+        .top = w && [NSWindow windowNumberAtPoint:[NSEvent mouseLocation]
+                      belowWindowWithWindowNumber:0] == [w windowNumber],
+    };
+
+    return omacvm_pointer_hover(&in);
 }
 
+/*
+ * OmacVM: only the pointer's place to the guest, while another app is in
+ * front. That app keeps the pointer and the keyboard: no grab, no corner
+ * guard (it detaches and moves the Mac's cursor), the Mac's cursor as it is,
+ * no window made key, nothing activated. Main thread.
+ */
+- (void) omacvmHover:(NSEvent *)event view:(NSView *)view output:(int)output
+{
+    /* A place the corner guard kept from the last grab is not this move's. */
+    omacvm_guard_place = false;
+    if (omacvm_pointer_debug &&
+        omacvm_hover_log_due(CACurrentMediaTime(), &omacvm_hover_logged)) {
+        info_report("omacvm-pointer: hover (output %d): the place only, another app in front",
+                    output);
+    }
+    with_bql(^{
+        if ([self omacvmQueuePointer:event view:view output:output]) {
+            qemu_input_event_sync();
+        }
+    });
+}
+
+/*
+ * OmacVM: a move over the main window from its second tracking area. That
+ * area is active always, so every move over the main view comes here, also
+ * in normal use with the pointer grabbed. The cheap checks first, before the
+ * rule's input (it asks the WindowServer which window is on top): they drop
+ * only moves the rule drops too.
+ */
+- (void) omacvmHoverMain:(NSEvent *)event
+{
+    if (isMouseGrabbed || [NSApp isActive] || omacvm_active_outputs() < 2) {
+        return;
+    }
+    if ([self omacvmHoverWanted:event view:self output:0 button:-1]) {
+        [self omacvmHover:event view:self output:0];
+    }
+}
+
 /* OmacVM: mouse events from the window of another output (button < 0: a move). */
 - (void) omacvmHeadEvent:(NSEvent *)event view:(NSView *)view output:(int)output
                   button:(int)button down:(bool)down
@@ -3166,9 +3264,13 @@
         /*
          * The pointer just passing over this display while another app is
