@@ -1307,6 +1322,24 @@
 
         [self addTrackingArea:trackingArea];
         [trackingArea release];
+        /*
+         * OmacVM: the area above sees moves only in the key window. This one
+         * also while another app is in front, for the pointer's place only
+         * (omacvmHoverMain). Its own owner, so the view gets no second
