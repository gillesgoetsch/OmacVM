index eb3a16f..ff64d66 100644
--- a/src/venus/vkr_command_buffer.c
+++ b/src/venus/vkr_command_buffer.c
@@ -430,10 +430,133 @@ vkr_cmd_queries(VkCommandBuffer handle)
