+/* OmacVM (virgl-venus-pass-views.patch): the image views of the open pass. Mesa's
+ * vk_render_pass reads the framebuffer's (or an imageless begin's) views at the begin, at
+ * each next subpass and at the end, and KosmicKrisp a rendering's at its end (its
+ * resolves): a view the app destroyed while recording is freed memory there, and the
+ * command buffer is invalid (as with a destroyed render pass, the context ends). A
+ * framebuffer keeps its views by id and serial; an imageless begin and vkCmdBeginRendering
+ * leave theirs with the command buffer. (KosmicKrisp also reads a pass's resolve views
+ * where it splits the pass inside: barriers, compute: still open, ADR 0065.) */
+static void
+vkr_cmd_set_views(struct vkr_command_buffer *cmd, struct vkr_view_ref *views, uint32_t count)
+{
+   if (cmd->views != cmd->view_storage)
+      free(cmd->views);
+   cmd->views = views;
+   cmd->view_count = count;
+}
+
+/* room for count views: the command buffer's own storage when they fit, else the heap;
+ * NULL when out of host memory. The open pass's views are dropped first. */
+static struct vkr_view_ref *
+vkr_cmd_view_room(struct vkr_command_buffer *cmd, uint32_t count)
+{
+   vkr_cmd_set_views(cmd, NULL, 0);
+   return count <= VKR_CMD_VIEW_STORAGE ? cmd->view_storage
+                                        : malloc(sizeof(struct vkr_view_ref) * count);
+}
+
+void
+vkr_command_buffer_object_release(struct vkr_object *obj)
+{
+   if (obj->type == VK_OBJECT_TYPE_COMMAND_BUFFER)
+      vkr_cmd_set_views((struct vkr_command_buffer *)obj, NULL, 0);
+}
+
+static bool
+vkr_cmd_views_ok(struct vkr_context *ctx,
+                 const char *call,
+                 const struct vkr_view_ref *views,
+                 uint32_t count)
+{
+   for (uint32_t i = 0; i < count; i++) {
+      if (views[i].id && !vkr_view_ref_alive(ctx, &views[i]))
+         return vkr_context_check(ctx, false, call, "view %u of the pass was destroyed", i);
+   }
+   return true;
+}
+
+/* the views a render pass begin names: the framebuffer's (checked here), or an imageless
+ * begin's (kept with the command buffer); false after a refusal */
+static bool
+vkr_cmd_begin_views(struct vn_dispatch_context *dispatch,
+                    struct vkr_command_buffer *cmd,
+                    const char *call,
+                    const VkRenderPassBeginInfo *info)
+{
+   struct vkr_context *ctx = dispatch->data;
+   const struct vkr_framebuffer *fb = vkr_framebuffer_from_handle(info->framebuffer);
+   if (!fb->imageless) {
+      vkr_cmd_set_views(cmd, NULL, 0);
+      return vkr_cmd_views_ok(ctx, call, fb->views, fb->attachment_count);
+   }
+   const VkRenderPassAttachmentBeginInfo *att =
+      vkr_find_struct(info->pNext, VK_STRUCTURE_TYPE_RENDER_PASS_ATTACHMENT_BEGIN_INFO);
+   const uint32_t count = att ? att->attachmentCount : 0;
+   struct vkr_view_ref *views = vkr_cmd_view_room(cmd, count);
+   if (!vkr_context_check(ctx, views != NULL, call, "out of host memory"))
+      return false;
+   for (uint32_t i = 0; i < count; i++)
+      views[i] = vkr_view_ref_of(vkr_image_view_from_handle(att->pAttachments[i]));
+   vkr_cmd_set_views(cmd, views, count);
+   return true;
+}
+
+/* the open render pass's views at a next subpass or its end */
+static bool
+vkr_cmd_pass_views_ok(struct vn_dispatch_context *dispatch,
+                      const struct vkr_command_buffer *cmd,
+                      const char *call)
+{
+   struct vkr_context *ctx = dispatch->data;
+   const struct vkr_framebuffer *fb =
+      vkr_framebuffer_lookup(ctx, cmd->state.framebuffer_id, cmd->state.framebuffer_serial);
+   if (!fb) /* vkr_cmd_pass_objects refused it first */
+      return false;
+   return fb->imageless ? vkr_cmd_views_ok(ctx, call, cmd->views, cmd->view_count)
+                        : vkr_cmd_views_ok(ctx, call, fb->views, fb->attachment_count);
+}
+
+/* the views a dynamic rendering names: colors and their resolves, depth, stencil and their
+ * resolves, shading rate and density map */
+static bool
+vkr_cmd_rendering_views(struct vn_dispatch_context *dispatch,
+                        struct vkr_command_buffer *cmd,
+                        const VkRenderingInfo *info)
+{
+   const VkRenderingFragmentShadingRateAttachmentInfoKHR *fsr = vkr_find_struct(
+      info->pNext, VK_STRUCTURE_TYPE_RENDERING_FRAGMENT_SHADING_RATE_ATTACHMENT_INFO_KHR);
+   const VkRenderingFragmentDensityMapAttachmentInfoEXT *fdm = vkr_find_struct(
+      info->pNext, VK_STRUCTURE_TYPE_RENDERING_FRAGMENT_DENSITY_MAP_ATTACHMENT_INFO_EXT);
+   const uint32_t max = 2 * info->colorAttachmentCount + 6;
+   struct vkr_view_ref *views = vkr_cmd_view_room(cmd, max);
+   if (!vkr_context_check(dispatch->data, views != NULL, "vkCmdBeginRendering", "out of host memory"))
+      return false;
+   uint32_t n = 0;
+   for (uint32_t i = 0; i < info->colorAttachmentCount; i++) {
+      views[n++] =
+         vkr_view_ref_of(vkr_image_view_from_handle(info->pColorAttachments[i].imageView));
+      views[n++] =
+         vkr_view_ref_of(vkr_image_view_from_handle(info->pColorAttachments[i].resolveImageView));
+   }
+   const VkRenderingAttachmentInfo *ds[2] = { info->pDepthAttachment, info->pStencilAttachment };
+   for (uint32_t i = 0; i < 2; i++) {
+      views[n++] = vkr_view_ref_of(ds[i] ? vkr_image_view_from_handle(ds[i]->imageView) : NULL);
+      views[n++] =
+         vkr_view_ref_of(ds[i] ? vkr_image_view_from_handle(ds[i]->resolveImageView) : NULL);
+   }
+   views[n++] = vkr_view_ref_of(fsr ? vkr_image_view_from_handle(fsr->imageView) : NULL);
+   views[n++] = vkr_view_ref_of(fdm ? vkr_image_view_from_handle(fdm->imageView) : NULL);
+   vkr_cmd_set_views(cmd, views, n);
+   return true;
+}
+
 static void
 vkr_cmd_state_reset(struct vkr_command_buffer *cmd)
 {
    memset(&cmd->state, 0, sizeof(cmd->state));
+   vkr_cmd_set_views(cmd, NULL, 0);
 }
 
