    PRINTFLIKE(4, 5);
 
+/* OmacVM (virgl-venus-chain-repeats.patch): no structure type twice in chain (the pNext
+ * of OF), or the call is refused as vkr_context_check does. vkr's checks read the first
+ * struct of a type and the Mac's drivers the last (VUID-<OF>-sType-unique). */
+static inline bool
+vkr_context_chain_ok(struct vkr_context *ctx, const char *call, const void *chain, const char *of)
+{
+   const VkStructureType type = vkr_chain_repeat(chain);
+   return vkr_context_check(ctx, !type, call, "structure type %u twice in the chain of %s",
+                            (unsigned)type, of);
+}
