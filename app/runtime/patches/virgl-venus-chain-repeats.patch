diff --git a/src/venus/vkr_common.h b/src/venus/vkr_common.h
index 8e4fa1f..a3e4be7 100644
--- a/src/venus/vkr_common.h
+++ b/src/venus/vkr_common.h
@@ -15,6 +15,7 @@
 #include <stdbool.h>
 #include <stddef.h>
 #include <stdint.h>
+#include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
 
@@ -263,6 +264,33 @@ vkr_chain_repeats(const void *chain)
    return false;
 }
 
+/* OmacVM (virgl-venus-chain-repeats.patch, ADR 0065): the first structure type chained a
+ * second time, or 0 (no chain vkr reads takes VkApplicationInfo). Each struct is compared
+ * with the ones before it and the walk stops at the first repeat: the decoder takes only
+ * a few types in a chain, so at most (known types)^2 compares, however long the chain. */
+static inline VkStructureType
+vkr_chain_repeat(const void *chain)
+{
+   for (const VkBaseInStructure *s = chain; s; s = s->pNext) {
+      for (const VkBaseInStructure *t = chain; t != s; t = t->pNext) {
+         if (t->sType == s->sType)
+            return s->sType;
+      }
+   }
+   return 0;
+}
+
+/* the same with why ("structure type N twice in the chain of OF") for the checks that
+ * write one */
+static inline bool
+vkr_chain_once(const void *chain, const char *of, char *why, size_t why_size)
+{
+   const VkStructureType type = vkr_chain_repeat(chain);
+   if (type)
+      snprintf(why, why_size, "structure type %u twice in the chain of %s", (unsigned)type, of);
+   return !type;
+}
+
 /*
  * Find struct in the pNext of chain and return its previous struct.
  */
