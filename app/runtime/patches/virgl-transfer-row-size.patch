 }
 
+/* OmacVM: refuse a texture transfer whose GL rows are longer than the
+ * guest's (vrend_format_gl_rows_fit); logged once. Uses the GL format the
+ * upload falls back to for formats without one. */
+static bool vrend_transfer_rows_fit(const struct vrend_resource *res, uint32_t width)
+{
+   static bool said;
+   GLenum glformat = tex_conv_table[res->base.format].glformat;
+   GLenum gltype = tex_conv_table[res->base.format].gltype;
+
+   if (!glformat) {
+      glformat = GL_BGRA;
+      gltype = GL_UNSIGNED_BYTE;
+   }
+   if (vrend_format_gl_rows_fit(res->base.format, glformat, gltype, width))
+      return true;
+   if (!said) {
+      said = true;
+      virgl_warn("transfer refused: format %d moves more bytes per row in GL than in the guest\n",
+                 res->base.format);
+   }
+   return false;
+}
+
 static int vrend_renderer_transfer_write_iov(struct vrend_context *ctx,
                                              struct vrend_resource *res,
                                              const struct iovec *iov, int num_iovs,
@@ -9538,6 +9561,9 @@ static int vrend_renderer_transfer_write_iov(struct vrend_context *ctx,
       GLenum gltype;
       int need_temp = 0;
       int elsize = util_format_get_blocksize(res->base.format);
+
+      if (!vrend_transfer_rows_fit(res, info->box->width))
+         return EINVAL;
       int x = 0, y = 0;
       bool compressed;
       bool invert = false;
@@ -10190,6 +10216,11 @@ static int vrend_renderer_transfer_send_iov(struct vrend_context *ctx,
       int ret = -1;
       bool can_readpixels = true;
 
+      /* glGetTexImage reads whole levels: check the level's width too. */
+      if (!vrend_transfer_rows_fit(res, info->box->width) ||
+          !vrend_transfer_rows_fit(res, u_minify(res->base.width0, info->level)))
+         return EINVAL;
+
       can_readpixels = vrend_format_can_render(res->base.format) || vrend_format_is_ds(res->base.format);
 
       if (can_readpixels)
