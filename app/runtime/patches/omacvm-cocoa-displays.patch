+/*
+ * OmacVM: the pointer in a window that shows one of several outputs, as the
+ * one tablet's position within the box around all the guest's outputs.
+ * With the BQL.
+ */
+- (bool) omacvmQueuePointer:(NSEvent *)event view:(NSView *)view output:(int)output
+{
+    NSPoint p = [view convertPoint:[event locationInWindow] fromView:nil];
+    NSSize size = [view bounds].size;
+    double nx, ny;
+
+    if (size.width <= 0 || size.height <= 0 ||
+        !omacvm_map_pointer(output, p.x / size.width, 1.0 - p.y / size.height,
+                            &nx, &ny)) {
+        return false;
+    }
+    qemu_input_queue_abs(dcl.con, INPUT_AXIS_X, lround(nx * INPUT_EVENT_ABS_MAX),
+                         0, INPUT_EVENT_ABS_MAX);
+    qemu_input_queue_abs(dcl.con, INPUT_AXIS_Y, lround(ny * INPUT_EVENT_ABS_MAX),
+                         0, INPUT_EVENT_ABS_MAX);
+    return true;
+}
