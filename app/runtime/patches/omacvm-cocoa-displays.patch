+/* Test mode: the main window starts on OMACVM_TEST_MAIN_DISPLAY. */
+static void omacvm_place_main_window(void)
+{
+    const char *v = getenv("OMACVM_TEST_MAIN_DISPLAY");
+    NSScreen *s = v && *v ? omacvm_screen_with_id((CGDirectDisplayID)atoll(v)) : nil;
+
+    if (s) {
+        NSRect r = NSInsetRect([s visibleFrame], 40, 40);
+        [[cocoaView window] setFrame:r display:YES];
+    }
+}
