+/*
+ ------------------------------------------------------
+    OmacVM: one window per Mac display
+ ------------------------------------------------------
+ * With the window in full screen, every other Mac display gets a full-screen
+ * window of its own (its own Space) showing the next virtio-gpu output:
+ * Virtual-2, Virtual-3, ... in the guest, each at that display's size and
+ * scale. Displays plugged in or out while in full screen come and go live.
+ * Leaving full screen closes them: one window, one output.
+ *
+ * The guest says it can handle this (and whether it wants it: "Use external
+ * displays") over the virtio port org.omacvm.display, whose socket QEMU's
+ * chardev serves at OMACVM_DISPLAY_SOCKET. QEMU sends it the arrangement in
+ * points ({"layout": [...]}); the guest answers with where Hyprland put its
+ * outputs ({"monitors": [...]}), so the one virtio tablet can point at the
+ * right output: Hyprland maps an absolute pointer onto the box around all
+ * its outputs.
+ *
+ * Testing on virtual displays (OMACVM_TEST_SKIP_DISPLAYS=ID,ID,...: the real
+ * ones, left alone): full screen is a borderless window over the display (no
+ * Space, no menu bar change) and the app never takes the focus;
+ * OMACVM_TEST_MAIN_DISPLAY=ID puts the main window on that display.
+ */
+
+typedef struct OmacVMHead {
+    DisplayChangeListener dcl;      /* first: the listener callbacks cast back */
+    int output;                     /* console index = virtio-gpu scanout */
+    DisplaySurface *surface;
+    DisplayGLTextureBorrower borrow;
+    uint32_t scanout_id;
+    bool dirty;
+    CGDirectDisplayID display;      /* the Mac display it is on; 0 = off */
+    NSWindow *window;
+    NSView *view;
+    bool want_full;                 /* waiting for macOS full screen */
+    bool full;                      /* in macOS full screen */
+    int full_tries;
+} OmacVMHead;
+
+static OmacVMHead omacvm_heads[OMACVM_MAX_OUTPUTS];   /* [0] = the main window */
+static int omacvm_outputs = 1;                         /* graphic consoles */
+static bool omacvm_external_enabled = true;
+
+/* Consoles 1..N-1 belong to the windows of the other displays. */
+static bool omacvm_is_head_console(unsigned int index)
+{
+    return index >= 1 && index < (unsigned int)omacvm_outputs;
+}
+static bool omacvm_guest_ready;                        /* the guest said hello */
+static bool omacvm_full_busy;
+static int omacvm_full_busy_output;              /* the window macOS is moving */
+static OmacVMBox omacvm_mac_box[OMACVM_MAX_OUTPUTS];  /* points, top-left origin */
+static OmacVMBox omacvm_mac_bounds;
+static int omacvm_mac_count = 1;
+static OmacVMBox omacvm_guest_box[OMACVM_MAX_OUTPUTS];
+static OmacVMBox omacvm_guest_bounds;
+static bool omacvm_guest_known;
+static NSString *omacvm_last_layout;
+
+static void omacvm_send_layout(void);
+static void omacvm_full_next(void);
+
+static bool omacvm_map_pointer(int output, double u, double v,
+                               double *nx, double *ny)
+{
+    const OmacVMBox *b, *all;
+
+    if (output < 0 || output >= OMACVM_MAX_OUTPUTS) {
+        return false;
+    }
+    if (omacvm_guest_known && omacvm_guest_box[output].w > 0) {
+        b = &omacvm_guest_box[output];
+        all = &omacvm_guest_bounds;
+    } else if (omacvm_mac_count > 1 && omacvm_mac_box[output].w > 0) {
+        b = &omacvm_mac_box[output];
+        all = &omacvm_mac_bounds;
+    } else {
+        return false;
+    }
+    if (all->w <= 0 || all->h <= 0) {
+        return false;
+    }
+    *nx = MIN(1.0, MAX(0.0, (b->x + u * b->w - all->x) / all->w));
+    *ny = MIN(1.0, MAX(0.0, (b->y + v * b->h - all->y) / all->h));
+    return true;
+}
+
+static int omacvm_active_outputs(void)
+{
+    return omacvm_mac_count;
+}
+
+static CGDirectDisplayID omacvm_screen_id(NSScreen *s)
+{
+    return [[[s deviceDescription] objectForKey:@"NSScreenNumber"] unsignedIntValue];
+}
+
+static NSScreen *omacvm_screen_with_id(CGDirectDisplayID id)
+{
+    for (NSScreen *s in [NSScreen screens]) {
+        if (omacvm_screen_id(s) == id) {
+            return s;
+        }
+    }
+    return nil;
+}
+
+static bool omacvm_test_mode(void)
+{
+    const char *v = getenv("OMACVM_TEST_SKIP_DISPLAYS");
+    return v && *v;
+}
+
+/* In test mode the listed displays (the real ones) are left alone. */
+static bool omacvm_test_allows(CGDirectDisplayID id)
+{
+    const char *v = getenv("OMACVM_TEST_SKIP_DISPLAYS");
+    if (!v || !*v) {
+        return true;
+    }
+    for (NSString *s in [[NSString stringWithUTF8String:v]
+                         componentsSeparatedByString:@","]) {
+        if ((CGDirectDisplayID)[s longLongValue] == id) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool omacvm_is_our_window(NSWindow *w)
+{
+    if (!w) {
+        return false;
+    }
+    if (w == [cocoaView window]) {
+        return true;
+    }
+    for (int i = 1; i < omacvm_outputs; i++) {
+        if (omacvm_heads[i].window == w) {
+            return true;
+        }
+    }
+    return false;
+}
+
+/*
+ * A window of ours that is on screen now and under point p. A full-screen
+ * window in a Space that is not shown is occluded, though its frame still
+ * covers its display.
+ */
+static bool omacvm_window_under(NSWindow *w, NSPoint p)
+{
+    return w && [w isVisible] &&
+           ([w occlusionState] & NSWindowOcclusionStateVisible) &&
+           NSPointInRect(p, [w frame]);
+}
+
+static bool omacvm_pointer_over_ours(void)
+{
+    NSPoint p = [NSEvent mouseLocation];
+
+    if (![NSApp isActive]) {
+        return false;
+    }
+    if (omacvm_window_under([cocoaView window], p)) {
+        return true;
+    }
+    for (int i = 1; i < omacvm_outputs; i++) {
+        if (omacvm_window_under(omacvm_heads[i].window, p)) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static bool omacvm_main_full_screen(void)
+{
+    return notchFull ||
+           ([[cocoaView window] styleMask] & NSWindowStyleMaskFullScreen);
+}
+
+/* A display's rectangle in points, top-left origin (CoreGraphics' global space). */
+static OmacVMBox omacvm_display_box(NSScreen *s, bool below_notch)
+{
+    CGRect r = CGDisplayBounds(omacvm_screen_id(s));
+    OmacVMBox b = { r.origin.x, r.origin.y, r.size.width, r.size.height };
+
+    if (below_notch) {
+        NSEdgeInsets in = [s safeAreaInsets];
+        b.x += in.left;
+        b.y += in.top;
+        b.w -= in.left + in.right;
+        b.h -= in.top + in.bottom;
+    }
+    return b;
 }
 
+/* Where a view is on the Mac, in points, top-left origin like omacvm_display_box. */
+static OmacVMBox omacvm_view_box(NSView *v)
+{
+    NSRect r = [[v window] convertRectToScreen:[v convertRect:[v bounds] toView:nil]];
+    NSArray *screens = [NSScreen screens];
+    CGFloat top = [screens count] ? NSMaxY([screens[0] frame]) : 0;
+
+    return (OmacVMBox){ r.origin.x, top - NSMaxY(r), r.size.width, r.size.height };
+}
+
+/* An extra output's place: its window once in full screen, else a guess from its display. */
+static OmacVMBox omacvm_head_box(OmacVMHead *hd, NSScreen *s)
+{
+    if (hd->full && hd->view && omacvm_screen_id(s) == hd->display) {
+        return omacvm_view_box(hd->view);
+    }
+    return omacvm_display_box(s, true);
+}
+
+static void omacvm_update_mac_layout(void)
+{
+    NSWindow *mw = [cocoaView window];
+    double minx = 0, miny = 0, maxx = 0, maxy = 0;
+    bool first = true;
+
+    memset(omacvm_mac_box, 0, sizeof(omacvm_mac_box));
+    if (omacvm_main_full_screen() && [mw screen]) {
+        omacvm_mac_box[0] = omacvm_main_full_settled && !notchFull ?
+            omacvm_view_box(cocoaView) : omacvm_display_box([mw screen], !notchFull);
+    } else {
+        NSSize size = [cocoaView frame].size;
+        omacvm_mac_box[0] = (OmacVMBox){ 0, 0, size.width, size.height };
+    }
+    for (int i = 1; i < omacvm_outputs; i++) {
+        NSScreen *s = omacvm_heads[i].display ?
+            omacvm_screen_with_id(omacvm_heads[i].display) : nil;
+        if (s) {
+            omacvm_mac_box[i] = omacvm_head_box(&omacvm_heads[i], s);
+        }
+    }
+    omacvm_mac_count = 0;
+    for (int i = 0; i < omacvm_outputs; i++) {
+        OmacVMBox b = omacvm_mac_box[i];
+        if (b.w <= 0) {
+            continue;
+        }
+        omacvm_mac_count++;
+        if (first) {
+            minx = b.x; miny = b.y; maxx = b.x + b.w; maxy = b.y + b.h;
+            first = false;
+        } else {
+            minx = MIN(minx, b.x); miny = MIN(miny, b.y);
+            maxx = MAX(maxx, b.x + b.w); maxy = MAX(maxy, b.y + b.h);
+        }
+    }
+    for (int i = 0; i < omacvm_outputs; i++) {
+        if (omacvm_mac_box[i].w > 0) {
+            omacvm_mac_box[i].x -= minx;
+            omacvm_mac_box[i].y -= miny;
+        }
+    }
+    omacvm_mac_bounds = (OmacVMBox){ 0, 0, maxx - minx, maxy - miny };
+}
+
+#ifdef CONFIG_OPENGL
+
+/* The listener of one extra output: draws into its own window. */
+
+static void omacvm_head_gfx_update(DisplayChangeListener *dcl,
+                                   int x, int y, int w, int h)
+{
+    OmacVMHead *hd = (OmacVMHead *)dcl;
+
+    with_gl_view_ctx(^{
+        surface_gl_update_texture(dgc.gls, hd->surface, x, y, w, h);
+    });
+    hd->dirty = true;
+}
+
+static void omacvm_head_gfx_switch(DisplayChangeListener *dcl,
+                                   DisplaySurface *new_surface)
+{
+    OmacVMHead *hd = (OmacVMHead *)dcl;
+
+    with_gl_view_ctx(^{
+        surface_gl_destroy_texture(dgc.gls, hd->surface);
+        if (new_surface) {
+            surface_gl_create_texture(dgc.gls, new_surface);
+        }
+    });
+    hd->surface = new_surface;
+    hd->dirty = true;
+}
+
+static void omacvm_head_refresh(DisplayChangeListener *dcl)
+{
+    OmacVMHead *hd = (OmacVMHead *)dcl;
+
+    qemu_console_hw_update(dcl->con);
+    if (hd->dirty && hd->display) {
+        int output = hd->output;
+        dispatch_async(dispatch_get_main_queue(), ^{
+            [[omacvm_heads[output].view layer] setNeedsDisplay];
+        });
+    }
+}
+
+static void omacvm_head_scanout_disable(DisplayChangeListener *dcl)
+{
+    OmacVMHead *hd = (OmacVMHead *)dcl;
+
+    hd->borrow = NULL;
+    hd->dirty = true;
+}
+
+static void omacvm_head_scanout_texture(DisplayChangeListener *dcl,
+                                        uint32_t backing_id,
+                                        DisplayGLTextureBorrower backing_borrow,
+                                        uint32_t x, uint32_t y,
+                                        uint32_t w, uint32_t h)
+{
+    OmacVMHead *hd = (OmacVMHead *)dcl;
+
+    hd->scanout_id = backing_id;
+    hd->borrow = backing_borrow;
+    hd->dirty = true;
+}
+
+static void omacvm_head_scanout_flush(DisplayChangeListener *dcl,
+                                      uint32_t x, uint32_t y,
+                                      uint32_t w, uint32_t h)
+{
+    ((OmacVMHead *)dcl)->dirty = true;
+}
