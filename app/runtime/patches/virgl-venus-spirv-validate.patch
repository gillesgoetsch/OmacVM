+      return true;
+   }
+   /* what spirv-val could not safely read is refused also when refusals are logged */
+   if (VKR_SPIRV_VALIDATE_ENFORCE || unsafe)
+      return false;
+   static atomic_uint_fast64_t logged;
+   const uint64_t n = atomic_fetch_add(&logged, 1) + 1;
+   if (n <= 256 || !(n & (n - 1)))
+      vkr_log("SPIR-V of %zu bytes passed on, though not valid (log-only, %" PRIu64 " so far): %s",
+              bytes, n, why);
+   return true;
+}
