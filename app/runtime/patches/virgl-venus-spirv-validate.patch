+static bool
+vkr_spirv_valid(const struct vkr_physical_device *physical_dev,
+                const struct vkr_spirv_info *spirv,
+                const uint32_t *code,
+                size_t bytes,
+                char *why,
+                size_t why_size)
+{
+   bool unsafe = false;
+   if (!physical_dev->spirv_target_ok) {
+      snprintf(why, why_size, "no SPIR-V target for Vulkan 0x%x",
+               physical_dev->properties.apiVersion);
+   } else if (vkr_spirv_validate(&physical_dev->spirv_target, spirv, code, bytes, why, why_size,
