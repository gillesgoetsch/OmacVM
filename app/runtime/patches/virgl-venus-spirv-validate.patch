+/* OmacVM (virgl-venus-spirv-validate.patch): the target guest SPIR-V is validated for. The
+ * device's Vulkan version as vkr reports it, which is the version the guest's driver tells
+ * the app (Mesa's Venus caps it; only VK_VERSION_OVERRIDE raises it), VK_KHR_spirv_1_4 on
+ * 1.1, the layouts and modes the device's features allow, not the ones an app enabled: a
+ * module the device runs passes, so a sloppy app that works on the driver keeps working
+ * (DXVK's d3d9 shaders use scalar layout), and the validator still refuses what neither
+ * driver can take. KosmicKrisp reports its own version whatever the instance asked (an app
+ * asking for 1.0 may still send SPIR-V 1.6); MoltenVK reports the instance's (MVKDevice.mm),
+ * at least 1.1 as vkr creates it, so there an app asking for 1.0 or 1.1 is told 1.1 and its
+ * SPIR-V is validated as Vulkan 1.1's (up to 1.4 with VK_KHR_spirv_1_4). */
+static void
+vkr_physical_device_init_spirv_target(struct vkr_physical_device *physical_dev)
+{
+   struct vn_physical_device_proc_table *vk = &physical_dev->proc_table;
+   VkPhysicalDevice handle = physical_dev->base.handle.physical_device;
+   const uint32_t version = physical_dev->properties.apiVersion;
+
+   VkPhysicalDeviceVulkan12Features f12 = {
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES,
+   };
+   VkPhysicalDeviceScalarBlockLayoutFeatures scalar = {
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SCALAR_BLOCK_LAYOUT_FEATURES,
+   };
+   VkPhysicalDeviceUniformBufferStandardLayoutFeatures std_layout = {
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_UNIFORM_BUFFER_STANDARD_LAYOUT_FEATURES,
+   };
+   VkPhysicalDeviceMaintenance4Features m4 = {
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MAINTENANCE_4_FEATURES,
+   };
+   VkPhysicalDeviceWorkgroupMemoryExplicitLayoutFeaturesKHR wg = {
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_WORKGROUP_MEMORY_EXPLICIT_LAYOUT_FEATURES_KHR,
+   };
+   VkPhysicalDeviceFeatures2 f2 = {
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2,
+   };
+   void **tail = &f2.pNext;
+   if (version >= VK_API_VERSION_1_2) {
+      *tail = &f12;
+      tail = &f12.pNext;
+   } else {
+      if (vkr_physical_device_lists(physical_dev, VK_EXT_SCALAR_BLOCK_LAYOUT_EXTENSION_NAME)) {
+         *tail = &scalar;
+         tail = &scalar.pNext;
+      }
+      if (vkr_physical_device_lists(physical_dev,
+                                    VK_KHR_UNIFORM_BUFFER_STANDARD_LAYOUT_EXTENSION_NAME)) {
+         *tail = &std_layout;
+         tail = &std_layout.pNext;
+      }
+   }
+   if (version >= VK_API_VERSION_1_3 ||
+       vkr_physical_device_lists(physical_dev, VK_KHR_MAINTENANCE_4_EXTENSION_NAME)) {
+      *tail = &m4;
+      tail = &m4.pNext;
+   }
+   if (vkr_physical_device_lists(physical_dev,
+                                 VK_KHR_WORKGROUP_MEMORY_EXPLICIT_LAYOUT_EXTENSION_NAME)) {
+      *tail = &wg;
+      tail = &wg.pNext;
+   }
+   vk->GetPhysicalDeviceFeatures2(handle, &f2);
+
+   /* VK_KHR_relaxed_block_layout is core from 1.1, the oldest version vkr runs on */
+   uint32_t options = VKR_SPIRV_RELAXED_LAYOUT;
+   if (f12.scalarBlockLayout || scalar.scalarBlockLayout)
+      options |= VKR_SPIRV_SCALAR_LAYOUT;
+   if (f12.uniformBufferStandardLayout || std_layout.uniformBufferStandardLayout)
+      options |= VKR_SPIRV_STD_UNIFORM_LAYOUT;
+   if (m4.maintenance4)
+      options |= VKR_SPIRV_LOCAL_SIZE_ID;
+   if (wg.workgroupMemoryExplicitLayoutScalarBlockLayout)
+      options |= VKR_SPIRV_WORKGROUP_SCALAR_LAYOUT;
+   /* Mesa's spirv_to_nir skips the globals outside a SPIR-V 1.4 entry point's interface;
+    * MoltenVK's SPIRV-Cross declares every Private and Workgroup variable in each entry point */
+   if (physical_dev->limits.kosmickrisp)
+      options |= VKR_SPIRV_INTERFACE_GLOBALS;
+   /* interface variables may take the locations the device's limits give, checked before
+    * spirv-val, whose walk over them grows with them (vkr_spirv_target_init: a stage the
+    * device lacks keeps Vulkan's minimum) */
+   const VkPhysicalDeviceLimits *l = &physical_dev->properties.limits;
+   const struct vkr_spirv_device_io io = {
+      .vertex_input_attributes = l->maxVertexInputAttributes,
+      .vertex_output_components = l->maxVertexOutputComponents,
+      .tess_control_input_components = l->maxTessellationControlPerVertexInputComponents,
+      .tess_control_output_components = l->maxTessellationControlPerVertexOutputComponents,
+      .tess_control_patch_output_components = l->maxTessellationControlPerPatchOutputComponents,
+      .tess_eval_input_components = l->maxTessellationEvaluationInputComponents,
+      .tess_eval_output_components = l->maxTessellationEvaluationOutputComponents,
+      .geometry_input_components = l->maxGeometryInputComponents,
+      .geometry_output_components = l->maxGeometryOutputComponents,
+      .fragment_input_components = l->maxFragmentInputComponents,
+      .fragment_output_attachments = l->maxFragmentOutputAttachments,
+   };
+   physical_dev->spirv_target_ok = vkr_spirv_target_init(
+      &physical_dev->spirv_target, version,
+      vkr_physical_device_lists(physical_dev, VK_KHR_SPIRV_1_4_EXTENSION_NAME), options, &io);
 
+   /* once per process and Vulkan version (MoltenVK's follows the app): which target, and
+    * whether a refusal ends the app's context */
+   static atomic_uint_fast64_t logged;
+   const uint64_t bit = (uint64_t)1 << (physical_dev->spirv_target.env & 63);
+   if (physical_dev->spirv_target_ok && !(atomic_fetch_or(&logged, bit) & bit)) {
+      char text[128];
+      vkr_spirv_target_text(&physical_dev->spirv_target, text, sizeof(text));
+      vkr_log("guest SPIR-V is validated for %s (%s)", text,
+              VKR_SPIRV_VALIDATE_ENFORCE ? "a refusal ends the app's context" : "log-only");
+   }
 }
 
