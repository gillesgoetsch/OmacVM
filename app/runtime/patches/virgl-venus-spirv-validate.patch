diff --git a/src/venus/vkr_spirv_validate.c b/src/venus/vkr_spirv_validate.c
new file mode 100644
--- /dev/null
+++ b/src/venus/vkr_spirv_validate.c
@@ -0,0 +1,318 @@
+/*
+ * Copyright 2026 OmacVM contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+/* OmacVM (virgl-venus-spirv-validate.patch): see vkr_spirv_validate.h. The cache keeps the
+ * SHA-256 of (target, code) of modules that passed: CACHE_SIZE entries in a fixed array,
+ * chained by hash in BUCKETS lists and kept in least-recently-used order in a second list,
+ * so a lookup, an insert and an eviction cost O(1) and the cache never grows. Refusals are
+ * not kept (a refused module ends its context). The validator runs outside the lock. */
+
+#include "vkr_spirv_validate.h"
+
+#include <CommonCrypto/CommonDigest.h>
+#include <inttypes.h>
+#include <pthread.h>
+#include <spirv-tools/libspirv.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "vkr_spirv.h"
+
+#define CACHE_SIZE 4096
+#define BUCKETS 4096 /* a power of two */
+#define NONE UINT16_MAX
+
+struct entry {
+   uint8_t key[CC_SHA256_DIGEST_LENGTH];
+   uint16_t chain;      /* the next entry of its bucket */
+   uint16_t prev, next; /* the LRU list, most recent first */
+};
+
+static struct {
+   pthread_mutex_t lock;
+   struct entry entries[CACHE_SIZE];
+   uint16_t buckets[BUCKETS];
+   uint16_t head, tail; /* most and least recently used */
+   uint32_t count;
+   uint64_t hits, misses, evictions;
+   bool ready;
+} cache = { .lock = PTHREAD_MUTEX_INITIALIZER };
+
+static uint32_t
+at_least(uint32_t minimum, uint32_t value)
+{
+   return value > minimum ? value : minimum;
+}
+
+bool
+vkr_spirv_target_init(struct vkr_spirv_target *target,
+                      uint32_t api_version,
+                      bool spirv_1_4,
+                      uint32_t options,
+                      const struct vkr_spirv_device_io *device)
+{
+   /* VK_API_VERSION_MAJOR/MINOR without the variant */
+   const uint32_t major = (api_version >> 22) & 0x7f, minor = (api_version >> 12) & 0x3ff;
+   spv_target_env env;
+   /* Vulkan's required minimums (maxVertexInputAttributes 16, 64 components, 120 per patch,
+    * maxFragmentOutputAttachments 4), raised to the device's */
+   struct vkr_spirv_io_limits *io = &target->io;
+   *io = (struct vkr_spirv_io_limits){ 16, 16, 16, 16, 30, 16, 16, 16, 16, 16, 4 };
+   if (device) {
+      io->vertex_in = at_least(io->vertex_in, device->vertex_input_attributes);
+      io->vertex_out = at_least(io->vertex_out, device->vertex_output_components / 4);
+      io->tess_control_in =
+         at_least(io->tess_control_in, device->tess_control_input_components / 4);
+      io->tess_control_out =
+         at_least(io->tess_control_out, device->tess_control_output_components / 4);
+      io->tess_control_patch_out =
+         at_least(io->tess_control_patch_out, device->tess_control_patch_output_components / 4);
+      io->tess_eval_in = at_least(io->tess_eval_in, device->tess_eval_input_components / 4);
+      io->tess_eval_out = at_least(io->tess_eval_out, device->tess_eval_output_components / 4);
+      io->geometry_in = at_least(io->geometry_in, device->geometry_input_components / 4);
+      io->geometry_out = at_least(io->geometry_out, device->geometry_output_components / 4);
+      io->fragment_in = at_least(io->fragment_in, device->fragment_input_components / 4);
+      io->fragment_out = at_least(io->fragment_out, device->fragment_output_attachments);
+   }
+   if (major != 1 || minor < 1)
+      return false;
+   if (minor == 1)
+      env = spirv_1_4 ? SPV_ENV_VULKAN_1_1_SPIRV_1_4 : SPV_ENV_VULKAN_1_1;
+   else if (minor == 2)
+      env = SPV_ENV_VULKAN_1_2;
+   else if (minor == 3)
+      env = SPV_ENV_VULKAN_1_3;
+   else
+      env = SPV_ENV_VULKAN_1_4;
+   target->env = env;
+   target->options = options;
+   return true;
+}
+
+void
+vkr_spirv_target_text(const struct vkr_spirv_target *target, char *out, size_t out_size)
+{
+   static const char *const names[] = { "scalar", "std", "workgroup-scalar", "local-size-id",
+                                         "relaxed", "interface-globals" };
+   size_t n = (size_t)snprintf(out, out_size, "%s", spvTargetEnvDescription(target->env));
+   for (unsigned i = 0; i < sizeof(names) / sizeof(names[0]) && n < out_size; i++) {
+      if (target->options & (1u << i))
+         n += (size_t)snprintf(out + n, out_size - n, " %s", names[i]);
+   }
+}
+
+static void
+cache_init_locked(void)
+{
+   if (cache.ready)
+      return;
+   memset(cache.entries, 0, sizeof(cache.entries));
+   for (unsigned i = 0; i < BUCKETS; i++)
+      cache.buckets[i] = NONE;
+   cache.head = cache.tail = NONE;
+   cache.count = 0;
+   cache.ready = true;
+}
+
+static uint32_t
+bucket_of(const uint8_t *key)
+{
+   uint32_t b;
+   memcpy(&b, key, sizeof(b));
+   return b & (BUCKETS - 1);
+}
+
+static void
+lru_unlink(uint16_t i)
+{
+   struct entry *e = &cache.entries[i];
+   if (e->prev != NONE)
+      cache.entries[e->prev].next = e->next;
+   else
+      cache.head = e->next;
+   if (e->next != NONE)
+      cache.entries[e->next].prev = e->prev;
+   else
+      cache.tail = e->prev;
+}
+
+static void
+lru_push_front(uint16_t i)
+{
+   struct entry *e = &cache.entries[i];
+   e->prev = NONE;
+   e->next = cache.head;
+   if (cache.head != NONE)
+      cache.entries[cache.head].prev = i;
+   cache.head = i;
+   if (cache.tail == NONE)
+      cache.tail = i;
+}
+
+static bool
+cache_lookup(const uint8_t *key)
+{
+   pthread_mutex_lock(&cache.lock);
+   cache_init_locked();
+   bool hit = false;
+   for (uint16_t i = cache.buckets[bucket_of(key)]; i != NONE; i = cache.entries[i].chain) {
+      if (!memcmp(cache.entries[i].key, key, CC_SHA256_DIGEST_LENGTH)) {
+         lru_unlink(i);
+         lru_push_front(i);
+         hit = true;
+         break;
+      }
+   }
+   if (hit)
+      cache.hits++;
+   else
+      cache.misses++;
+   pthread_mutex_unlock(&cache.lock);
+   return hit;
+}
+
+static void
+cache_insert(const uint8_t *key)
+{
+   pthread_mutex_lock(&cache.lock);
+   cache_init_locked();
+   const uint32_t b = bucket_of(key);
+   /* another thread may have validated the same module meanwhile */
+   for (uint16_t i = cache.buckets[b]; i != NONE; i = cache.entries[i].chain) {
+      if (!memcmp(cache.entries[i].key, key, CC_SHA256_DIGEST_LENGTH)) {
+         pthread_mutex_unlock(&cache.lock);
+         return;
+      }
+   }
+   uint16_t slot;
+   if (cache.count < CACHE_SIZE) {
+      slot = (uint16_t)cache.count++;
+   } else {
+      /* the least recently used one goes: out of its bucket's chain and the list */
+      slot = cache.tail;
+      struct entry *old = &cache.entries[slot];
+      uint16_t *p = &cache.buckets[bucket_of(old->key)];
+      while (*p != slot)
+         p = &cache.entries[*p].chain;
+      *p = old->chain;
+      lru_unlink(slot);
+      cache.evictions++;
+   }
+   struct entry *e = &cache.entries[slot];
+   memcpy(e->key, key, CC_SHA256_DIGEST_LENGTH);
+   e->chain = cache.buckets[b];
+   cache.buckets[b] = slot;
+   lru_push_front(slot);
+   pthread_mutex_unlock(&cache.lock);
+}
+
+void
+vkr_spirv_cache_stats(struct vkr_spirv_cache_stats *stats)
+{
+   pthread_mutex_lock(&cache.lock);
+   stats->hits = cache.hits;
+   stats->misses = cache.misses;
+   stats->evictions = cache.evictions;
+   stats->entries = cache.count;
+   pthread_mutex_unlock(&cache.lock);
+}
+
+void
+vkr_spirv_cache_reset(void)
+{
+   pthread_mutex_lock(&cache.lock);
+   cache.ready = false;
+   cache_init_locked();
+   cache.hits = cache.misses = cache.evictions = 0;
+   pthread_mutex_unlock(&cache.lock);
+}
+
+static spv_validator_options
+options_for(const struct vkr_spirv_target *target)
+{
+   spv_validator_options o = spvValidatorOptionsCreate();
+   if (!o)
+      return NULL;
+   const uint32_t f = target->options;
+   spvValidatorOptionsSetScalarBlockLayout(o, f & VKR_SPIRV_SCALAR_LAYOUT);
+   spvValidatorOptionsSetUniformBufferStandardLayout(o, f & VKR_SPIRV_STD_UNIFORM_LAYOUT);
+   spvValidatorOptionsSetWorkgroupScalarBlockLayout(o, f & VKR_SPIRV_WORKGROUP_SCALAR_LAYOUT);
+   spvValidatorOptionsSetAllowLocalSizeId(o, f & VKR_SPIRV_LOCAL_SIZE_ID);
+   spvValidatorOptionsSetRelaxBlockLayout(o, f & VKR_SPIRV_RELAXED_LAYOUT);
+   /* the same bound as the scan (spirv-val's own is 4M ids) */
+   spvValidatorOptionsSetUniversalLimit(o, spv_validator_limit_max_id_bound, VKR_SPIRV_MAX_BOUND);
+   /* names only matter in messages; without them no pass over OpName */
+   spvValidatorOptionsSetFriendlyNames(o, false);
+   return o;
+}
+
+bool
+vkr_spirv_validate(const struct vkr_spirv_target *target,
+                   const struct vkr_spirv_info *info,
+                   const uint32_t *code,
+                   size_t bytes,
+                   char *why,
+                   size_t why_size,
+                   bool *unsafe)
+{
+   bool ignored;
+   unsafe = unsafe ? unsafe : &ignored;
+   *unsafe = true;
+   if (bytes > VKR_SPIRV_MAX_CODE_SIZE) {
+      snprintf(why, why_size, "SPIR-V of %zu bytes (at most %u)", bytes, VKR_SPIRV_MAX_CODE_SIZE);
+      return false;
+   }
+   if (info->type_cost > VKR_SPIRV_MAX_TYPE_COST) {
+      snprintf(why, why_size, "SPIR-V: types too costly to validate (%" PRIu64 ", at most %u)",
+               info->type_cost, VKR_SPIRV_MAX_TYPE_COST);
+      return false;
+   }
+   /* the key: target first (fixed size), then the code */
+   uint8_t key[CC_SHA256_DIGEST_LENGTH];
+   CC_SHA256_CTX sha;
+   CC_SHA256_Init(&sha);
+   CC_SHA256_Update(&sha, target, sizeof(*target));
+   CC_SHA256_Update(&sha, code, (CC_LONG)bytes);
+   CC_SHA256_Final(key, &sha);
+   if (cache_lookup(key))
+      return true;
+   /* spirv-val's walk over interface locations grows with them: the device's limits first */
+   if (!vkr_spirv_interface_ok(info, &target->io, NULL, NULL, why, why_size))
+      return false;
+
+   spv_context ctx = spvContextCreate(target->env);
+   spv_validator_options opt = ctx ? options_for(target) : NULL;
+   if (!opt) {
+      if (ctx)
+         spvContextDestroy(ctx);
+      snprintf(why, why_size, "SPIR-V validator: out of host memory");
+      return false;
+   }
+   *unsafe = false;
+   spv_const_binary_t binary = { code, bytes / 4 };
+   spv_diagnostic diag = NULL;
+   /* spirv-tools-val-catch-throws.patch: an exception inside (an at() past the end, out of
+    * memory) is SPV_ERROR_INTERNAL, not the end of QEMU */
+   const spv_result_t r = omacvmValidateWithOptions(ctx, opt, &binary, &diag);
+   if (r != SPV_SUCCESS) {
+      if (diag && diag->error)
+         snprintf(why, why_size, "spirv-val (%s): %s (word %zu)", spvTargetEnvDescription(target->env),
+                  diag->error, diag->position.index);
+      else if (r == SPV_ERROR_INTERNAL)
+         snprintf(why, why_size, "spirv-val (%s): an exception inside it", spvTargetEnvDescription(target->env));
+      else
+         snprintf(why, why_size, "spirv-val (%s): error %d", spvTargetEnvDescription(target->env), r);
+   }
+   spvDiagnosticDestroy(diag);
+   spvValidatorOptionsDestroy(opt);
+   spvContextDestroy(ctx);
+   if (r != SPV_SUCCESS) {
+      /* spirv-val's own out of memory (its allocations throw, caught by its C API) */
+      *unsafe = r == SPV_ERROR_OUT_OF_MEMORY || r == SPV_ERROR_INTERNAL;
+      return false;
+   }
+   cache_insert(key);
+   return true;
+}
diff --git a/src/venus/vkr_spirv_validate.h b/src/venus/vkr_spirv_validate.h
new file mode 100644
--- /dev/null
+++ b/src/venus/vkr_spirv_validate.h
@@ -0,0 +1,111 @@
+/*
+ * Copyright 2026 OmacVM contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+/* OmacVM (virgl-venus-spirv-validate.patch, ADR 0065): the guest's SPIR-V through
+ * SPIRV-Tools' validator (spirv-val) after vkr_spirv_scan and before the Mac's shader
+ * compilers. The scan alone let 66 of 138 modules that end QEMU (KosmicKrisp's
+ * spirv_to_nir, MoltenVK's SPIRV-Cross) through; the validator refuses 65 of those, and
+ * the scan the two it misses. The target follows the device: its Vulkan version as vkr
+ * reports it (VK_KHR_spirv_1_4 on a 1.1 device) and the layouts and modes its features
+ * allow, never what one app enabled, so code a device runs passes. A module that passed
+ * is remembered by the SHA-256 of its code and target (a bounded cache shared by every
+ * context, behind a mutex). Self-contained but for SPIRV-Tools' C API and CommonCrypto,
+ * so it is tested on the CPU alone (Tests/virgl/test-venus-spirv-validate.sh). */
+
+#ifndef VKR_SPIRV_VALIDATE_H
+#define VKR_SPIRV_VALIDATE_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#include "vkr_spirv.h"
+
+/* the largest module the validator takes: past it the module is refused unread (64 times
+ * the largest real one seen, 67 KB; spirv-val's time grows with the size, see the patch's
+ * header for the numbers) */
+#define VKR_SPIRV_MAX_CODE_SIZE (4u << 20)
+
+/* 1: a module the validator refuses ends the app's context; 0: it is only logged (one
+ * line per module) and goes on to the driver. Built in, no switch. */
+#ifndef VKR_SPIRV_VALIDATE_ENFORCE
+#define VKR_SPIRV_VALIDATE_ENFORCE 1
+#endif
+
+/* what the device allows beyond its Vulkan version's defaults */
+enum {
+   VKR_SPIRV_SCALAR_LAYOUT = 1 << 0,           /* scalarBlockLayout */
+   VKR_SPIRV_STD_UNIFORM_LAYOUT = 1 << 1,      /* uniformBufferStandardLayout */
+   VKR_SPIRV_WORKGROUP_SCALAR_LAYOUT = 1 << 2, /* workgroupMemoryExplicitLayoutScalarBlockLayout */
+   VKR_SPIRV_LOCAL_SIZE_ID = 1 << 3,           /* maintenance4 */
+   VKR_SPIRV_RELAXED_LAYOUT = 1 << 4,          /* VK_KHR_relaxed_block_layout, core in 1.1 */
+   /* not a validator option: the device's compiler makes only the Private and Workgroup
+    * variables in a SPIR-V 1.4 entry point's interface (Mesa's spirv_to_nir: KosmicKrisp), so
+    * the pipeline counts only those (vkr_spirv_function_elements) */
+   VKR_SPIRV_INTERFACE_GLOBALS = 1 << 5,
+};
+
+struct vkr_spirv_target {
+   uint32_t env;     /* spv_target_env */
+   uint32_t options; /* VKR_SPIRV_* above */
+   /* the device's interface limits, checked before spirv-val (vkr_spirv_interface_ok) */
+   struct vkr_spirv_io_limits io;
+};
+
+/* the device's interface limits as VkPhysicalDeviceLimits gives them (the fields of the same
+ * names: maxVertexInputAttributes, the component limits, maxFragmentOutputAttachments) */
+struct vkr_spirv_device_io {
+   uint32_t vertex_input_attributes, vertex_output_components;
+   uint32_t tess_control_input_components, tess_control_output_components;
+   uint32_t tess_control_patch_output_components;
+   uint32_t tess_eval_input_components, tess_eval_output_components;
+   uint32_t geometry_input_components, geometry_output_components;
+   uint32_t fragment_input_components, fragment_output_attachments;
+};
+
+/* the target for a device of api_version (VK_MAKE_API_VERSION) with or without
+ * VK_KHR_spirv_1_4, its VKR_SPIRV_* options and its interface limits (a component limit / 4;
+ * NULL: Vulkan's required minimums); false for a version below 1.1. A limit below Vulkan's
+ * minimum keeps the minimum: a stage the device lacks, as MoltenVK's geometry stage (0
+ * components), would else refuse every module that has one (vkd3d-proton's geometry module
+ * at vkCreateShaderModule). */
+bool
+vkr_spirv_target_init(struct vkr_spirv_target *target,
+                      uint32_t api_version,
+                      bool spirv_1_4,
+                      uint32_t options,
+                      const struct vkr_spirv_device_io *device);
+
+/* "vulkan1.3 scalar std ..." for log lines */
+void
+vkr_spirv_target_text(const struct vkr_spirv_target *target, char *out, size_t out_size);
+
+/* `bytes` bytes of SPIR-V whose scan is `info` valid for the target: true, or false with
+ * the reason in why. *unsafe (may be NULL) tells a module refused before spirv-val read
+ * it: past VKR_SPIRV_MAX_CODE_SIZE, interface variables past the device's limits (spirv-val's
+ * own walk over them grows with them) or out of host memory; those are refused also when
+ * refusals are only logged. */
+bool
+vkr_spirv_validate(const struct vkr_spirv_target *target,
+                   const struct vkr_spirv_info *info,
+                   const uint32_t *code,
+                   size_t bytes,
+                   char *why,
+                   size_t why_size,
+                   bool *unsafe);
+
+/* the cache's counts (tests) and a reset (tests: a cold run) */
+struct vkr_spirv_cache_stats {
+   uint64_t hits, misses, evictions;
+   uint32_t entries;
+};
+
+void
+vkr_spirv_cache_stats(struct vkr_spirv_cache_stats *stats);
+
+void
+vkr_spirv_cache_reset(void);
+
+#endif /* VKR_SPIRV_VALIDATE_H */
