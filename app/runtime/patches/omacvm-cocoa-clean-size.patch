@@ -4763,6 +4968,42 @@ static void cocoa_gl_layer_follow(CALayer *layer, IOSurfaceRef surf)
     }
 }
 
+/*
+ * OmacVM: the guest at the top of the full-screen window, pixel for pixel,
+ * only for a frame of its size (as wide as the view, a few rows shorter).
+ * Any other frame (on the way to a new mode, the boot logo) fills the view
+ * as before. In the transaction that shows the frame; the only place that
+ * sets the gravity. The black rows it leaves go to omacvm_shown_band.
+ */
+static void omacvm_present_gravity(CALayer *layer, IOSurfaceRef surf)
+{
+    NSString *g = kCAGravityResize;
+    uint32_t band = 0;
+
+    if (qatomic_read(&omacvm_guest_top) && surf) {
+        CGFloat s = [layer contentsScale];
+        CGSize b = [layer bounds].size;
+
+        band = omacvm_top_band(lround(b.width * s), lround(b.height * s),
+                               (long)IOSurfaceGetWidth(surf),
+                               (long)IOSurfaceGetHeight(surf), s);
+    }
+    if (band) {
+        /* "Top" is the larger y, unless the contents are flipped. */
+        g = [layer contentsAreFlipped] ? kCAGravityBottom : kCAGravityTop;
+    }
+    if (![[layer contentsGravity] isEqualToString:g]) {
+        [layer setContentsGravity:g];
+    }
+    if (qatomic_xchg(&omacvm_shown_band, band) != band) {
+        /* The cursor and the layout follow the picture. */
+        dispatch_async(dispatch_get_main_queue(), ^{
+            [cocoaView updateCursorLayout];
+            omacvm_displays_update();
+        });
+    }
+}
+
