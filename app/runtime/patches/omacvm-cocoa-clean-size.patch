+static uint32_t omacvm_clean_logged;
+/* OmacVM: points cut off the bottom of the full-screen area for the guest. */
+static CGFloat omacvm_full_cut;
+/*
+ * OmacVM: the full-screen window fills the area and shows the guest at its
+ * top, pixel for pixel, the cut rows black below it. The window keeps the
+ * area's size so Omanotch (and anything else that looks for a full-screen
+ * window down to the bottom edge) still finds it. Set on the main thread,
+ * read where frames are shown.
+ */
+static bool omacvm_guest_top;
+/*
+ * OmacVM: rows of black (pixels) below the frame on screen now, set where
+ * frames are shown. The pointer, the cursor and the display layout use it,
+ * so they always match the picture.
+ */
+static uint32_t omacvm_shown_band;
+#ifdef CONFIG_OPENGL
+static void omacvm_present_gravity(CALayer *layer, IOSurfaceRef surf);
+#endif
+
 QemuCocoaView *cocoaView;
 
 /*
@@ -1022,6 +1046,7 @@ - (void)updateCursorLayout
 
         position.x = mouseX * scale;
         position.y = (screen.height - mouseY) * scale;
+        position.y += [self omacvmBlackRows];   /* the black rows below the guest */
 
         bounds.size.width = cursor->width * scale;
