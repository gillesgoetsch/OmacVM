 {
    switch (obj->type) {
+   case VK_OBJECT_TYPE_COMMAND_BUFFER:
+      return ((const struct vkr_command_buffer *)obj)->device;
+   case VK_OBJECT_TYPE_COMMAND_POOL:
+      return ((const struct vkr_command_pool *)obj)->device;
    case VK_OBJECT_TYPE_IMAGE:
       return ((const struct vkr_image *)obj)->device;
    case VK_OBJECT_TYPE_IMAGE_VIEW:
@@ -570,6 +602,9 @@ vkr_device_object_held(struct vkr_context *ctx, struct vkr_object *obj, bool des
 
    obj->zombie = true;
    obj->zombie_destroy_vk = destroy_vk;
+   /* OmacVM (virgl-venus-secondary-holds.patch): a command buffer lives in its pool */
+   if (obj->type == VK_OBJECT_TYPE_COMMAND_BUFFER)
+      vkr_object_hold(&((struct vkr_command_buffer *)obj)->pool->base);
