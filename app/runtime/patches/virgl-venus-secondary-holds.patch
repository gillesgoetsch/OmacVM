index 6958901..15b3bad 100644
--- a/src/venus/vkr_command_buffer.c
+++ b/src/venus/vkr_command_buffer.c
@@ -769,11 +769,54 @@ static void
 vkr_dispatch_vkCreateCommandPool(struct vn_dispatch_context *dispatch,
                                  struct vn_command_vkCreateCommandPool *args)
 {
+   struct vkr_device *dev = vkr_device_from_handle(args->device);
    struct vkr_command_pool *pool = vkr_command_pool_create_and_add(dispatch->data, args);
    if (!pool)
       return;
 
    list_inithead(&pool->command_buffers);
+   /* OmacVM (virgl-venus-secondary-holds.patch) */
+   pool->device = dev;
+}
+
+/* OmacVM (virgl-venus-secondary-holds.patch): a command buffer a primary holds (it
+ * executed it) stays in the driver as a zombie, and the pool with it until its last zombie
+ * goes (vkr_object_unhold); the others are freed in the driver first, then vkr lets go of
+ * what they held. Without such a command buffer: the pool goes at once, as before. */
+void
+vkr_command_pool_destroy(struct vkr_context *ctx,
+                         struct vkr_device *dev,
+                         struct vkr_command_pool *pool,
+                         bool destroy_vk)
+{
+   struct vn_device_proc_table *vk = &dev->proc_table;
+   VkDevice device = dev->base.handle.device;
+   VkCommandPool handle = pool->base.handle.command_pool;
+
+   list_for_each_entry_safe (struct vkr_command_buffer, cmd, &pool->command_buffers,
+                             base.track_head)
+      vkr_device_object_held(ctx, &cmd->base, destroy_vk);
+
+   if (pool->base.holds && destroy_vk) {
+      list_for_each_entry (struct vkr_command_buffer, cmd, &pool->command_buffers,
+                           base.track_head)
+         vk->FreeCommandBuffers(device, handle, 1, &cmd->base.handle.command_buffer);
+   } else if (destroy_vk) {
+      vk->DestroyCommandPool(device, handle, NULL);
+   }
+   const bool destroyed = !pool->base.holds;
+   /* the zombies of the pool may go here (their last holders were of this pool) */
+   vkr_command_pool_release(ctx, pool);
+
+   if (destroyed) {
+      vkr_device_remove_object(ctx, dev, &pool->base);
+   } else if (!pool->base.holds) {
+      if (destroy_vk)
+         vk->DestroyCommandPool(device, handle, NULL);
+      vkr_device_remove_object(ctx, dev, &pool->base);
+   } else {
+      vkr_device_object_held(ctx, &pool->base, destroy_vk);
+   }
 }
 
