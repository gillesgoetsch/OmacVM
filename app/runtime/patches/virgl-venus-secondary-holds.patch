 }
 
@@ -609,6 +644,23 @@ vkr_object_unhold(struct vkr_object *obj)
       if (obj->zombie_destroy_vk)
          vk->DestroyRenderPass(device, obj->handle.render_pass, NULL);
       break;
+   case VK_OBJECT_TYPE_COMMAND_BUFFER: {
