+/* OmacVM (virgl-venus-secondary-holds.patch): the teardown's order for zombies left over: holders first */
+static int
+vkr_zombie_rank(const struct vkr_object *obj)
+{
+   switch (obj->type) {
+   case VK_OBJECT_TYPE_COMMAND_BUFFER:
+      return 0;
+   case VK_OBJECT_TYPE_IMAGE:
+      return 2;
+   case VK_OBJECT_TYPE_COMMAND_POOL:
+      return 3;
+   default:
+      return 1;
+   }
+}
+
 static void
 vkr_device_object_destroy(struct vkr_context *ctx,
                           struct vkr_device *dev,
@@ -362,6 +378,13 @@ vkr_device_object_destroy(struct vkr_context *ctx,
 
    assert(vkr_device_should_track_object(obj));
 
+   /* OmacVM (virgl-venus-secondary-holds.patch): a pool's command buffers a primary of
+    * another pool holds wait for it, and so does the pool */
+   if (obj->type == VK_OBJECT_TYPE_COMMAND_POOL) {
+      vkr_command_pool_destroy(ctx, dev, (struct vkr_command_pool *)obj, ctx->on_worker_thread);
+      return;
+   }
+
    /* OmacVM (virgl-venus-command-holds.patch): a held object waits for its holders (the
     * command pools of this device, destroyed in this walk) */
    if (vkr_device_object_held(ctx, obj, ctx->on_worker_thread))
@@ -504,10 +527,15 @@ vkr_device_destroy(struct vkr_context *ctx, struct vkr_device *dev, bool destroy
    }
 
    /* OmacVM (virgl-venus-command-holds.patch): the pools above let go of every zombie; one
-    * left would be a holder vkr lost track of. Always take the first: freeing a view can
-    * free its image, which may be the next entry */
+    * left would be a holder vkr lost track of. Holders before what they hold (a command
+    * buffer, then views, framebuffers and passes, then images, then pools), each time from
+    * the list again: freeing one can free others (virgl-venus-secondary-holds.patch) */
    while (!list_is_empty(&dev->zombies)) {
-      struct vkr_object *obj = list_first_entry(&dev->zombies, struct vkr_object, track_head);
+      struct vkr_object *obj = NULL;
+      list_for_each_entry (struct vkr_object, z, &dev->zombies, track_head) {
+         if (!obj || vkr_zombie_rank(z) < vkr_zombie_rank(obj))
+            obj = z;
+      }
       vkr_log("device teardown: a zombie of type %d still held %u times", obj->type, obj->holds);
       obj->holds = 1;
       vkr_object_unhold(obj);
@@ -536,6 +564,10 @@ struct vkr_device *
