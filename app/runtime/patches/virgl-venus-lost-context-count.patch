+/*
+ * OmacVM (virgl-venus-lost-context-count.patch): Venus contexts lost for good. vkr's ring
+ * threads tell them (virgl_gpu_budget_venus_lost); the renderer thread, which owns the
+ * status file, counts them at its next poll (vrend_memory_take_venus_losses). More than
+ * eight between two polls: the newest eight keep their names, all are counted.
+ */
+static struct {
+   pthread_mutex_t mutex;
+   atomic_uint pending;         /* told since the last take; read without the lock first */
+   struct {
+      char name[64];
+      const char *why;
+   } slot[8];                   /* the newest, oldest first */
+} vrend_venus_lost = { .mutex = PTHREAD_MUTEX_INITIALIZER };
+
+void virgl_gpu_budget_venus_lost(const char *name, const char *why)
+{
+   pthread_mutex_lock(&vrend_venus_lost.mutex);
+   unsigned n = atomic_load(&vrend_venus_lost.pending);
+   unsigned i = MIN2(n, 7u);
+   if (n >= 8)
+      memmove(&vrend_venus_lost.slot[0], &vrend_venus_lost.slot[1], sizeof(vrend_venus_lost.slot[0]) * 7);
+   snprintf(vrend_venus_lost.slot[i].name, sizeof(vrend_venus_lost.slot[i].name), "%s", name ? name : "");
+   vrend_venus_lost.slot[i].why = why && !strcmp(why, "guard") ? "guard" : "venus";
+   atomic_store(&vrend_venus_lost.pending, n + 1);
+   pthread_mutex_unlock(&vrend_venus_lost.mutex);
+}
+
+/* Renderer thread: counts what the ring threads told since the last poll. */
+static void vrend_memory_take_venus_losses(void)
+{
+   char names[8][64];
+   const char *why[8];
+   unsigned n;
+
+   if (!atomic_load(&vrend_venus_lost.pending))
+      return;
+   pthread_mutex_lock(&vrend_venus_lost.mutex);
+   n = atomic_load(&vrend_venus_lost.pending);
+   for (unsigned i = 0; i < MIN2(n, 8u); i++) {
+      memcpy(names[i], vrend_venus_lost.slot[i].name, sizeof(names[i]));
+      why[i] = vrend_venus_lost.slot[i].why;
+   }
+   atomic_store(&vrend_venus_lost.pending, 0);
+   pthread_mutex_unlock(&vrend_venus_lost.mutex);
+   /* the ones past eight, oldest first: counted, their names gone */
+   if (n > 8)
+      vrend_memory.lost += n - 8;
+   for (unsigned i = 0; i < MIN2(n, 8u); i++) {
+      vrend_memory.lost_why_next = why[i];
+      vrend_memory.lost_kind_next = "venus";
+      vrend_memory_status_lost(names[i]);
+   }
+}
