+/* OmacVM (#692): the guest's Mesa (virgl_tgsi.c) writes the clip distance outputs through
+ * two temps, TEMP[F] and TEMP[F+1]. A write with an index (a loop) goes to TEMP[ADDR+F], and
+ * the copy after it is always MOV OUT[clip 0..3], TEMP[F]: distances 4..7 never reached
+ * their output, so gl_ClipDistance[4..7] was undefined (the M4 did not clip with them, the
+ * M1 Max dropped the draw). When the shader never writes the second clip distance register
+ * itself and copies the first from a temp it indexes at run time, also copy the next temp to
+ * the second: what a guest Mesa that copied both temps sends. */
+static void emit_guest_clip_copyback(struct dump_ctx *ctx, const struct tgsi_full_instruction *inst)
+{
+   const struct tgsi_full_dst_register *dst = &inst->Dst[0];
+   const struct tgsi_full_src_register *src = &inst->Src[0];
+   if (ctx->num_out_clip_dist <= 4 || ctx->writes_clip_out1 || !ctx->clip_out_reg1[0] ||
+       !ctx->clip_out_reg1[1] || inst->Instruction.Saturate)
+      return;
+   if (dst->Register.File != TGSI_FILE_OUTPUT || dst->Register.Indirect ||
+       dst->Register.Index != ctx->clip_out_reg1[0] - 1 || dst->Register.WriteMask != TGSI_WRITEMASK_XYZW)
+      return;
+   if (src->Register.File != TGSI_FILE_TEMPORARY || src->Register.Indirect || src->Register.Dimension ||
+       src->Register.Negate || src->Register.Absolute || src->Register.SwizzleX != TGSI_SWIZZLE_X ||
+       src->Register.SwizzleY != TGSI_SWIZZLE_Y || src->Register.SwizzleZ != TGSI_SWIZZLE_Z ||
+       src->Register.SwizzleW != TGSI_SWIZZLE_W)
+      return;
+   const struct vrend_temp_range *range = find_temp_range(ctx, src->Register.Index);
+   if (!range || range->array_id != INDIRECT_TEMP_ARRAY_ID || src->Register.Index + 1 > range->last)
+      return;
+   emit_buff(&ctx->glsl_strbufs, "clip_dist_temp[1] = vec4(temp%d[%d]);\n", range->first,
+             src->Register.Index + 1 - range->first);
+}
+
