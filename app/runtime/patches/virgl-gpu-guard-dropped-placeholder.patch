+   /* Venus memory is an app's: it stops at the apps' share (virgl_gpu_guard.h) */
+   if (!charge && n && !(n & (n - 1)) && virgl_gpu_budget_apps_share_full(bytes))
+      vkr_log("guest GPU memory: apps' share of %" PRIu64 " MB reached (the last %" PRIu64
+              " MB of the %" PRIu64 " MB budget are kept for the desktop): refused %" PRIu64
+              " KB of %s with %" PRIu64 " MB in use (%" PRIu64 " refused so far)",
