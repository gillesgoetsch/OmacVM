+/*
+ * OmacVM: an empty 1x1 stand-in for PRES (same target, format and layers), charged
+ * nothing; NULL when it cannot be made. A lost app's dropped buffer gets one
+ * (virglrenderer.c): the app may already have handed the buffer to the compositor,
+ * and Hyprland's commands that name it (a sampler view to draw the window) must still
+ * find a resource, or Hyprland is lost too (a black VM). The window shows empty.
+ */
+struct pipe_resource *vrend_renderer_resource_stand_in(struct pipe_resource *pres)
+{
+   struct vrend_resource *old = (struct vrend_resource *)pres;
+   struct vrend_renderer_resource_create_args args = {
+      .target = old->base.target,
+      .format = old->base.format,
+      .bind = old->base.bind,
+      .width = 1,
+      .height = 1,
+      .depth = 1,
+      .array_size = old->base.array_size ? old->base.array_size : 1,
+      .nr_samples = old->base.nr_samples,
+      .last_level = 0,
+      .flags = old->y_0_top ? VIRGL_RESOURCE_Y_0_TOP : 0,
+   };
+
+   vrend_state.resource_stand_in = true;
+   struct pipe_resource *stand_in = vrend_renderer_resource_create(&args, NULL);
+   vrend_state.resource_stand_in = false;
+   return stand_in;
+}
+
 static struct vrend_resource *
 vrend_resource_create(const struct vrend_renderer_resource_create_args *args)
 {
