@@ -760,6 +760,29 @@ vkr_physical_device_linear_usage(struct vkr_physical_device *physical_dev,
    return usage;
 }
 
+/* OmacVM (virgl-venus-linear-input-attachment.patch): a LINEAR image with INPUT_ATTACHMENT
+ * usage only where the format's own linear tiling has a colour or depth attachment feature
+ * (what the usage needs without VK_IMAGE_CREATE_EXTENDED_USAGE_BIT). KosmicKrisp makes every
+ * 2D image with that usage a 2D array texture, and Metal ends the process at
+ * vkBindImageMemory2 for a linear one ("Linear texture: must be of type MTLTextureType2D").
+ * With EXTENDED_USAGE KosmicKrisp's format query does not check usages against features
+ * and says yes; Zink asks that way (Mesa 26.3, X11 windows through Xwayland). Neither Mac
+ * driver has linear attachment features, so this refuses every such image there. */
+bool
+vkr_physical_device_linear_input_ok(struct vkr_physical_device *physical_dev,
+                                    VkFormat format,
+                                    VkImageTiling tiling,
+                                    VkImageUsageFlags usage)
+{
+   if (tiling != VK_IMAGE_TILING_LINEAR || !(usage & VK_IMAGE_USAGE_INPUT_ATTACHMENT_BIT))
+      return true;
+   VkFormatProperties props = { 0 };
+   physical_dev->proc_table.GetPhysicalDeviceFormatProperties(
+      physical_dev->base.handle.physical_device, format, &props);
+   return props.linearTilingFeatures & (VK_FORMAT_FEATURE_COLOR_ATTACHMENT_BIT |
+                                        VK_FORMAT_FEATURE_DEPTH_STENCIL_ATTACHMENT_BIT);
+}
