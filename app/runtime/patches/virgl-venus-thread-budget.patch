+/* OmacVM (virgl-venus-thread-budget.patch, ADR 0065): one process-wide count of the
+ * threads guest calls make: a render worker and a proxy sync thread per Venus context, a
+ * thread per ring and the ring monitor, a sync thread per device queue. QEMU, Metal and
+ * GCD need threads too, and QEMU ends the process when it cannot make one (macOS allows
+ * kern.num_taskthreads, 4096, per process). Taken before each such thread is made,
+ * given back when it is joined; past the budget (1024, OMACVM_VENUS_THREADS for tests)
+ * the guest's call fails and one line names `what` (the 1st, 2nd, 4th ... time). */
+bool virgl_thread_budget_take(const char *what);
+void virgl_thread_budget_give(void);
+int virgl_thread_budget_used(void);
+
+/* the Venus contexts that may live at once: at most `workers`, and no more than half of
+ * the open-file limit at 8 files each (sockets, shared memory, fence FIFOs), read at run
+ * time: QEMU raises the soft limit to OPEN_MAX (10240) on macOS */
+int virgl_context_budget(int workers);
+
 #endif /* VIRGL_UTIL_H */
