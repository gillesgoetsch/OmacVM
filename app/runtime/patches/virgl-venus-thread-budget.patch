diff --git a/src/virgl_util.c b/src/virgl_util.c
index 6e100de..be96e74 100644
--- a/src/virgl_util.c
+++ b/src/virgl_util.c
@@ -28,6 +28,9 @@
 
 #include "virgl_util.h"
 
+#include <stdatomic.h>
+#include <sys/resource.h>
+
 #include <errno.h>
 #ifdef HAVE_EVENTFD_H
 #include <sys/eventfd.h>
@@ -101,6 +104,64 @@ bool has_eventfd(void)
 #endif
 }
 
+static atomic_int virgl_threads_used;
+
+static void PRINTFLIKE(1, 2) virgl_thread_budget_log(const char *fmt, ...)
+{
+   va_list va;
+   va_start(va, fmt);
+   virgl_prefixed_logv("vkr", VIRGL_LOG_LEVEL_INFO, fmt, va);
+   va_end(va);
+}
+
+static int virgl_thread_budget_max(void)
+{
+   static atomic_int max;
+   int m = atomic_load(&max);
+   if (!m) {
+      const char *env = getenv("OMACVM_VENUS_THREADS");
+      m = env && atoi(env) > 0 ? atoi(env) : 1024;
+      atomic_store(&max, m);
+   }
+   return m;
+}
+
+bool virgl_thread_budget_take(const char *what)
+{
+   static atomic_uint refusals;
+   const int max = virgl_thread_budget_max();
+   int n = atomic_load(&virgl_threads_used);
+   do {
+      if (n >= max) {
+         const unsigned r = atomic_fetch_add(&refusals, 1) + 1;
+         if (!(r & (r - 1)))
+            virgl_thread_budget_log("%d threads for guest calls already (at most %d): the %s "
+                                    "is not made, that call fails (%u so far)", n, max, what, r);
+         return false;
+      }
+   } while (!atomic_compare_exchange_weak(&virgl_threads_used, &n, n + 1));
+   return true;
+}
+
+void virgl_thread_budget_give(void)
+{
+   atomic_fetch_sub(&virgl_threads_used, 1);
+}
+
+int virgl_thread_budget_used(void)
+{
+   return atomic_load(&virgl_threads_used);
+}
+
+int virgl_context_budget(int workers)
+{
+   struct rlimit r;
+   int max = workers;
+   if (!getrlimit(RLIMIT_NOFILE, &r) && r.rlim_cur != RLIM_INFINITY && r.rlim_cur / 16 < (rlim_t)max)
+      max = (int)(r.rlim_cur / 16);
+   return max > 0 ? max : 1;
+}
+
 int create_eventfd(unsigned int initval)
 {
 #ifdef HAVE_EVENTFD_H
