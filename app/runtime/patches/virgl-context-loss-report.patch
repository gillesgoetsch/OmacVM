+static void vrend_notify_context_lost(struct vrend_context *ctx)
+{
+   const uint32_t status = VIRGL_RESET_STATUS_GUILTY;
+   struct vrend_resource *res = ctx->reset_status_res;
+
+   virgl_error("context %d (%s) is lost, it draws nothing from now on; %s\n",
+               ctx->ctx_id, ctx->debug_name,
+               res ? "the guest driver was told (context reset)"
+                   : "the guest driver cannot be told, the app must be restarted");
+   if (res) {
+      memcpy(res->ptr, &status, sizeof(status));
+      if (res->iov)
+         vrend_write_to_iovec(res->iov, res->num_iovs, 0, (const char *)&status, sizeof(status));
+   }
+}
+
 void vrend_report_context_error_internal(const char *fname, struct vrend_context *ctx,
                                          enum virgl_ctx_errors error, uint32_t value)
 {
+   bool first = !ctx->in_error;
+
    ctx->in_error = true;
    ctx->last_error = error;
    virgl_error("%s: context error reported %d \"%s\" %s %d\n", fname,
                ctx->ctx_id, ctx->debug_name, vrend_ctx_error_strings[error],
                value);
+   if (first && ctx->ctx_id)
+      vrend_notify_context_lost(ctx);
 }
 
