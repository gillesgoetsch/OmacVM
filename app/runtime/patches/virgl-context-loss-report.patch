+
+void vrend_renderer_set_reset_status_buffer(struct vrend_context *ctx, uint32_t res_handle)
+{
+   struct vrend_resource *res = NULL;
+
+   if (res_handle) {
+      res = vrend_renderer_ctx_res_lookup(ctx, res_handle);
+      /* Like query results: no GL object, the host writes into guest memory. */
+      if (!res || res->base.target != PIPE_BUFFER ||
+          res->base.bind != VIRGL_BIND_CUSTOM ||
+          res->base.width0 < sizeof(uint32_t) || !res->ptr) {
+         vrend_report_context_error(ctx, VIRGL_ERROR_CTX_ILLEGAL_RESOURCE, res_handle);
+         return;
+      }
+   }
+   vrend_resource_reference(&ctx->reset_status_res, res);
 }
 
