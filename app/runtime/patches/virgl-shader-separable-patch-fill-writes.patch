+/* OmacVM (#589): those padding patch varyings: between two separable stages on desktop GL,
+ * the ones below the highest one declared that are not declared themselves */
+static uint64_t patch_fill_mask(const struct dump_ctx *ctx, uint64_t declared, enum io_type iot)
+{
+   if (ctx->cfg->use_gles || !declared ||
+       !(iot == io_in ? ctx->key->separable_in : ctx->key->separable_out))
+      return 0;
+   int top = 64 - __builtin_clzll(declared);
+   return (top == 64 ? ~0ull : (1ull << top) - 1) & ~declared;
+}
+
+/* OmacVM (#589): the patch slots one patch io takes, as emit_ios_patch counts them */
+static uint64_t patch_io_mask(const struct vrend_shader_io *io)
+{
+   if (io->last == io->first)
+      return 1ull << io->sid;
+   return ((1ull << (io->last - io->first + 1)) - 1) << io->sid;
+}
+
+/* OmacVM (#589): the patch outputs emit_ios_tcs declares */
+static uint64_t tcs_out_patches(const struct dump_ctx *ctx)
+{
+   uint64_t mask = 0;
+   /* patch_ios.output_range.used is never set upstream; kept as emit_ios_tcs has it */
+   if (ctx->patch_ios.output_range.used)
+      mask |= patch_io_mask(&ctx->patch_ios.output_range.io);
+   for (uint32_t i = 0; i < ctx->num_outputs; i++) {
+      if (!ctx->outputs[i].glsl_predefined_no_emit && ctx->outputs[i].name == TGSI_SEMANTIC_PATCH)
+         mask |= patch_io_mask(&ctx->outputs[i]);
+   }
+   return mask;
+}
