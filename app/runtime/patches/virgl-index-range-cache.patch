+/* OmacVM: the index range cache (virgl-index-range-cache.patch). The read-back above
+ * runs for every indexed draw; WebGL pages that draw each object on its own read the
+ * same indices tens of thousands of times a frame. Each buffer remembers its last four
+ * ranges, valid until vrend writes the buffer (content_gen). Buffers the GPU may write
+ * or the guest may map are never cached (index_range_never). OMACVM_VIRGL_INDEX_RANGE_CACHE=0
+ * reads back on every draw again; OMACVM_VIRGL_CACHE_STATS=1 logs hits every 10 s.
+ * Render thread only. */
+static bool vrend_index_range_cache_on = true;
+static bool vrend_index_range_stats_on;
+static uint64_t vrend_index_range_clock;
+static struct {
+   uint64_t hits, misses, uncached;
+   struct timespec since;
+} vrend_index_range_stats;
+
+static void vrend_index_range_cache_init(void)
+{
+   const char *env = getenv("OMACVM_VIRGL_INDEX_RANGE_CACHE");
+   const char *stats = getenv("OMACVM_VIRGL_CACHE_STATS");
+
+   vrend_index_range_cache_on = !(env && !strcmp(env, "0"));
+   vrend_index_range_stats_on = stats && !strcmp(stats, "1");
+   clock_gettime(CLOCK_MONOTONIC, &vrend_index_range_stats.since);
+   virgl_info("index range cache: %s\n", vrend_index_range_cache_on ?
+              "on (indices are read back once per buffer write)" :
+              "off (OMACVM_VIRGL_INDEX_RANGE_CACHE=0): every indexed draw reads its indices back");
+}
+
+static void vrend_index_range_count(uint64_t *counter)
+{
+   struct timespec now;
+
+   (*counter)++;
+   if (!vrend_index_range_stats_on || (vrend_index_range_clock & 1023))
+      return;
+   clock_gettime(CLOCK_MONOTONIC, &now);
+   double secs = (double)(now.tv_sec - vrend_index_range_stats.since.tv_sec) +
+                 (now.tv_nsec - vrend_index_range_stats.since.tv_nsec) / 1e9;
+   if (secs < 10)
+      return;
+   uint64_t all = vrend_index_range_stats.hits + vrend_index_range_stats.misses +
+                  vrend_index_range_stats.uncached;
+   virgl_info("index range cache: %llu hits, %llu misses, %llu not cacheable in %.0f s "
+              "(%.1f %% hits)\n", (unsigned long long)vrend_index_range_stats.hits,
+              (unsigned long long)vrend_index_range_stats.misses,
+              (unsigned long long)vrend_index_range_stats.uncached, secs,
+              all ? 100.0 * vrend_index_range_stats.hits / all : 0.0);
+   vrend_index_range_stats.hits = vrend_index_range_stats.misses = 0;
+   vrend_index_range_stats.uncached = 0;
+   vrend_index_range_stats.since = now;
+}
+
+/* Only plain GL buffers that nothing but vrend writes: no persistent, coherent, blob,
+ * imported or memory-object storage, never bound where the GPU writes. */
+static bool vrend_index_range_cacheable(const struct vrend_resource *ib)
+{
+   return vrend_index_range_cache_on && !ib->index_range_never &&
+          ib->base.target == PIPE_BUFFER &&
+          (ib->storage_bits & ~VREND_STORAGE_GUEST_MEMORY) == VREND_STORAGE_GL_BUFFER &&
+          !ib->buffer_storage_flags && !ib->blob_id && !ib->is_imported;
+}
+
+static bool vrend_draw_state_ok(struct vrend_context *ctx);
+
+/* vrend_draw_index_range through the buffer's cache. A miss is remembered only when no
+ * GL error is pending after the read: a read the GL refused (or an error of the draw's
+ * setup) skips the draw, as the check right before the GL draw call would, and is
+ * read again next time. */
+static bool vrend_draw_index_range_cached(struct vrend_context *ctx, struct vrend_resource *ib,
+                                          uint32_t index_size, uint64_t offset,
+                                          uint32_t count, bool restart,
+                                          uint32_t restart_index, uint32_t *min_index,
+                                          uint32_t *max_index, const char **why)
+{
+   vrend_index_range_clock++;
+   if (!vrend_index_range_cacheable(ib)) {
+      vrend_index_range_count(&vrend_index_range_stats.uncached);
+      if (!vrend_draw_index_range(ib, index_size, offset, count, restart, restart_index,
+                                  min_index, max_index)) {
+         *why = "indices that could not be read back";
+         return false;
+      }
+      return true;
+   }
+
+   if (!restart)
+      restart_index = 0; /* not used by the scan */
+   const uint64_t gen = ib->content_gen + 1;
+   struct vrend_index_range *slot = &ib->index_ranges[0];
+   for (unsigned i = 0; i < ARRAY_SIZE(ib->index_ranges); i++) {
+      struct vrend_index_range *e = &ib->index_ranges[i];
+      if (e->gen == gen && e->offset == offset && e->count == count &&
+          e->index_size == index_size && e->restart == restart &&
+          e->restart_index == restart_index) {
+         e->used = vrend_index_range_clock;
+         *min_index = e->min_index;
+         *max_index = e->max_index;
+         vrend_index_range_count(&vrend_index_range_stats.hits);
+         return true;
+      }
+      /* replace a stale or empty slot first, else the least recently used */
+      if (slot->gen == gen && (e->gen != gen || e->used < slot->used))
+         slot = e;
+   }
+
+   vrend_index_range_count(&vrend_index_range_stats.misses);
+   if (!vrend_draw_index_range(ib, index_size, offset, count, restart, restart_index,
+                               min_index, max_index) ||
+       !vrend_draw_state_ok(ctx)) {
+      *why = "indices that could not be read back";
+      return false;
+   }
+   slot->gen = gen;
+   slot->used = vrend_index_range_clock;
+   slot->offset = offset;
+   slot->count = count;
+   slot->index_size = index_size;
+   slot->restart = restart;
+   slot->restart_index = restart_index;
+   slot->min_index = *min_index;
+   slot->max_index = *max_index;
+   return true;
+}
