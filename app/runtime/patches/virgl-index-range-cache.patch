+   /* OmacVM: index ranges of this buffer that indexed draws read back
+    * (virgl-index-range-cache.patch). content_gen counts the writes vrend makes to the
+    * buffer (vrend_resource_contents_changed); a range counts only for the generation it
+    * was read at. index_range_never is set, and never cleared, once the GPU may write
+    * the buffer or the guest may map it: then every draw reads its indices back. */
+   uint64_t content_gen;
+   bool index_range_never;
+   struct vrend_index_range {
+      uint64_t gen; /* content_gen + 1 at the read; 0: an empty slot */
+      uint64_t used; /* for least recently used replacement */
+      uint64_t offset;
+      uint32_t count;
+      uint32_t restart_index; /* 0 without primitive restart */
+      uint32_t min_index, max_index;
+      uint8_t index_size;
+      bool restart;
+   } index_ranges[4];
 };
 
+/* OmacVM: before every write vrend makes to a resource's contents from the CPU
+ * (transfers, video output): index ranges read before it no longer count. */
+static inline void vrend_resource_contents_changed(struct vrend_resource *res)
+{
+   if (res)
+      res->content_gen++;
+}
+
+/* OmacVM: the GPU writes the resource (a buffer copy, stream output, storage buffer,
+ * image, atomic counter, query result) or the guest can map it: its index ranges are
+ * read back on every draw from now on. A GPU write runs in one GL context's order, and
+ * another GL context could read the indices back before it lands. */
+static inline void vrend_resource_no_index_range_cache(struct vrend_resource *res)
+{
+   if (res)
+      res->index_range_never = true;
+}
