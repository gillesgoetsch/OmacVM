+- (void)dealloc
+{
+    if (workspace_observing) {
+        [[[NSWorkspace sharedWorkspace] notificationCenter] removeObserver:self];
+    }
+    [self showMenuBar];
+    [[NSNotificationCenter defaultCenter] removeObserver:self];
+    [super dealloc];
+}
