+- (void)activeSpaceChanged:(NSNotification *)notification
+{
+    [self scheduleRefresh:@"active Space changed"];
+}
+
+/*
+ * Mission Control may rebuild the menu bar while the window keeps its frame
+ * and Space: apply the reveal state again at once, then once WindowServer
+ * has the window back in place (one at a time; never a new frame).
+ */
+- (void)scheduleRefresh:(NSString *)reason
+{
+    if (![NSThread isMainThread]) {
+        dispatch_async(dispatch_get_main_queue(), ^{
+            [self scheduleRefresh:reason];
+        });
+        return;
+    }
+    if (refresh_pending) {
+        return;
+    }
+    refresh_pending = true;
+    [self refreshForReason:reason];
+    dispatch_async(dispatch_get_main_queue(), ^{
+        [self finishReturn:reason checksLeft:240];
+    });
+}
+
+/* At most 2 s (240 x 1/120 s), then it gives up and logs it. */
+- (void)finishReturn:(NSString *)reason checksLeft:(unsigned)checks
+{
+    if ([self refreshForReason:reason]) {
+        refresh_pending = false;
+        return;
+    }
+    if (!checks) {
+        refresh_pending = false;
+        fprintf(stderr, "omacvm: full panel: return not settled in 2 s (%s); nothing forced\n",
+                [reason UTF8String]);
+        return;
+    }
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, NSEC_PER_SEC / 120),
+                   dispatch_get_main_queue(), ^{
+        [self finishReturn:reason checksLeft:checks - 1];
+    });
+}
+
+/* true: done or nothing to do; false: wait for WindowServer. */
+- (bool)refreshForReason:(NSString *)reason
+{
+    (void)reason;
+    if (!in_full_screen_space || !full_screen_frame_kept || !frame_accepted || area_lost ||
+        !menu_bar_hidden_space ||
+        !([window styleMask] & NSWindowStyleMaskFullScreen) ||
+        ![window isKeyWindow] || ![window isVisible] || ![window isOnActiveSpace] ||
+        !([window occlusionState] & NSWindowOcclusionStateVisible) ||
+        ![self usable] || ![window screen] ||
+        !omacvm_fp_rect_equal(omacvm_fullpanel_rect([window frame]),
+                              omacvm_fullpanel_rect([[window screen] frame])) ||
+        omacvm_fullpanel_full_screen_space(window) != menu_bar_hidden_space) {
+        return true;
+    }
+    int compositor = omacvm_fullpanel_compositor_ready(window);
+    if (compositor != 1) {
+        return compositor < 0;   /* not known: stop, force nothing */
+    }
+    [self updatePresentationOptions];
+    [self applyMenuBarReveal];
+    return true;
+}
+
+- (void)otherWindowDidChangeOcclusionState:(NSNotification *)notification
+{
+    if (!menu_bar_hidden_space) {
+        return;
+    }
+    NSWindow *changed = [notification object];
+    if (changed == window && ([window occlusionState] & NSWindowOcclusionStateVisible)) {
+        [self scheduleRefresh:@"window became visible"];
+    }
+    if (changed && changed == [self fullScreenToolbarWindow]) {
+        [self applyMenuBarReveal];
+    }
+}
+
+- (void)windowDidBecomeKey:(NSNotification *)notification
+{
+    [self updatePresentationOptions];
+    [self scheduleRefresh:@"window became key"];
+}
+
+- (void)observeValueForKeyPath:(NSString *)keyPath
+                      ofObject:(id)object
+                        change:(NSDictionary *)change
+                       context:(void *)context
+{
+    if ([keyPath isEqualToString:@"currentSystemPresentationOptions"]) {
+        dispatch_async(dispatch_get_main_queue(), ^{
+            [self updatePresentationOptions];
+        });
+        return;
+    }
+    [super observeValueForKeyPath:keyPath ofObject:object change:change context:context];
+}
