+/*
+ * ---------------------------------------------------------------------------
+ * OmacVM FullPanel (experimental): the full-screen window over the whole
+ * notched display, the strip beside the camera housing included.
+ * ---------------------------------------------------------------------------
+ *
+ * Only with OMACVM_FULLPANEL=1 (OmacVM.app sets it for one start, for a VM
+ * whose notch setting is FullPanel; Omanotch is off for that start). The
+ * window stays a real macOS full-screen window in a Space of its own; macOS
+ * normally keeps such a window below the camera housing in two ways:
+ *
+ *   1. AppKit proposes a full-screen frame below the notch;
+ *   2. the full-screen Space's menu bar covers the strip.
+ *
+ * Here, per window and only on a display with a camera housing:
+ *
+ *   - AppKit's private full-screen frame (-_frameForFullScreenMode) becomes
+ *     the whole display, only while the window has the display to itself
+ *     (ui/omacvm-fullpanel.h, omacvm_fp_frame), and stays so for that full
+ *     screen when AppKit asks again with its camera-safe tile;
+ *   - the menu bar layer of that one full-screen Space is transparent
+ *     (SkyLight), and comes down as usual from the display's top row;
+ *   - AppKit's full-screen toolbar window is hidden while the menu bar is.
+ *
+ * Every private class, selector, function and type encoding is looked up at
+ * run time; anything missing or changed, an external display, or macOS's
+ * "Always show the menu bar in full screen" gives normal full screen (logged
+ * once). Once a full screen loses the strip it is not forced back.
+ *
+ * Based on Brian Merchant's FullPanel branch for OmacVM (issue #339), which
+ * follows the camera-housing full screen of UTM (Turing Software, LLC; UTM
+ * PR #7885 and #7910, Apache-2.0) as an independent Objective-C
+ * implementation; no UTM code is copied.
+ *
+ * Main thread (AppKit), as all of cocoa.m's window code.
+ */
+
+static bool omacvm_fullpanel_requested(void)
+{
+    return omacvm_fp_requested(getenv("OMACVM_FULLPANEL"));
+}
+
+static OmacVMFPRect omacvm_fullpanel_rect(NSRect r)
+{
+    return (OmacVMFPRect){ r.origin.x, r.origin.y, r.size.width, r.size.height };
+}
+
+typedef NSRect (*OmacVMFullPanelFrameFn)(id, SEL);
+static SEL omacvm_fullpanel_frame_selector;
+static SEL omacvm_fullpanel_tile_selector;
+static OmacVMFullPanelFrameFn omacvm_fullpanel_appkit_frame;
+static OmacVMFullPanelFrameFn omacvm_fullpanel_tile_frame;
+static const char *omacvm_fullpanel_frame_types;
+static Class omacvm_fullpanel_hooked_classes[8];
+static int omacvm_fullpanel_hooked_count;
+
+typedef int32_t (*OmacVMSLSMainConnectionIDFn)(void);
+typedef CFArrayRef (*OmacVMSLSCopySpacesForWindowsFn)(int32_t, int32_t, CFArrayRef);
+typedef int32_t (*OmacVMSLSSpaceGetTypeFn)(int32_t, uint64_t);
+typedef CFTypeRef (*OmacVMSLSTransactionCreateFn)(int32_t);
+typedef void (*OmacVMSLSTransactionSetMenuBarAlphaFn)(CFTypeRef, uint64_t, float);
+/* Private: UTM's VMDisplayWindow.swift and yabai's src/misc/extern.h agree
+ * that commit returns a CGError and its second argument means synchronous. */
+typedef int32_t (*OmacVMSLSTransactionCommitFn)(CFTypeRef, int32_t);
+
+static void *omacvm_fullpanel_skylight;
+static int omacvm_fullpanel_skylight_state;
+static OmacVMSLSMainConnectionIDFn omacvm_fullpanel_sls_main;
+static OmacVMSLSCopySpacesForWindowsFn omacvm_fullpanel_sls_spaces;
+static OmacVMSLSSpaceGetTypeFn omacvm_fullpanel_sls_space_type;
+static OmacVMSLSTransactionCreateFn omacvm_fullpanel_sls_transaction_create;
+static OmacVMSLSTransactionSetMenuBarAlphaFn omacvm_fullpanel_sls_menu_alpha;
+static OmacVMSLSTransactionCommitFn omacvm_fullpanel_sls_transaction_commit;
+
+@class OmacVMFullPanelState;
+static char omacvm_fullpanel_state_key;
+static int omacvm_fullpanel_reveal_state;
+
+static OmacVMFullPanelState *omacvm_fullpanel_state(NSWindow *window)
+{
+    return window ? objc_getAssociatedObject(window, &omacvm_fullpanel_state_key) : nil;
+}
+
+static bool omacvm_fullpanel_load_skylight(void)
+{
+    if (omacvm_fullpanel_skylight_state) {
+        return omacvm_fullpanel_skylight_state > 0;
+    }
+    omacvm_fullpanel_skylight_state = -1;
+    omacvm_fullpanel_skylight = dlopen(
+        "/System/Library/PrivateFrameworks/SkyLight.framework/SkyLight",
+        RTLD_LAZY | RTLD_LOCAL);
+    if (!omacvm_fullpanel_skylight) {
+        fprintf(stderr, "omacvm: full panel: SkyLight is not there; using normal full screen\n");
+        return false;
+    }
+
+#define OMACVM_FULLPANEL_SYM(dst, type, name) \
+    dst = (type)dlsym(omacvm_fullpanel_skylight, name)
+    OMACVM_FULLPANEL_SYM(omacvm_fullpanel_sls_main,
+                         OmacVMSLSMainConnectionIDFn, "SLSMainConnectionID");
+    OMACVM_FULLPANEL_SYM(omacvm_fullpanel_sls_spaces,
+                         OmacVMSLSCopySpacesForWindowsFn, "SLSCopySpacesForWindows");
+    OMACVM_FULLPANEL_SYM(omacvm_fullpanel_sls_space_type,
+                         OmacVMSLSSpaceGetTypeFn, "SLSSpaceGetType");
+    OMACVM_FULLPANEL_SYM(omacvm_fullpanel_sls_transaction_create,
+                         OmacVMSLSTransactionCreateFn, "SLSTransactionCreate");
+    OMACVM_FULLPANEL_SYM(omacvm_fullpanel_sls_menu_alpha,
+                         OmacVMSLSTransactionSetMenuBarAlphaFn,
+                         "SLSTransactionSetMenuBarSystemOverrideAlpha");
+    OMACVM_FULLPANEL_SYM(omacvm_fullpanel_sls_transaction_commit,
+                         OmacVMSLSTransactionCommitFn, "SLSTransactionCommit");
+#undef OMACVM_FULLPANEL_SYM
+
+    if (!omacvm_fullpanel_sls_main || !omacvm_fullpanel_sls_spaces ||
+        !omacvm_fullpanel_sls_space_type || !omacvm_fullpanel_sls_transaction_create ||
+        !omacvm_fullpanel_sls_menu_alpha || !omacvm_fullpanel_sls_transaction_commit) {
+        fprintf(stderr, "omacvm: full panel: SkyLight lacks a function it needs; using normal full screen\n");
+        return false;
+    }
+    omacvm_fullpanel_skylight_state = 1;
+    return true;
+}
+
+static uint64_t omacvm_fullpanel_space_id(NSWindow *window)
+{
+    if (!window || !omacvm_fullpanel_load_skylight()) {
+        return 0;
+    }
+    int32_t cid = omacvm_fullpanel_sls_main();
+    NSNumber *number = [NSNumber numberWithInteger:[window windowNumber]];
+    CFArrayRef windows = (CFArrayRef)[NSArray arrayWithObject:number];
+    CFArrayRef spaces = omacvm_fullpanel_sls_spaces(cid, 7, windows);
+    if (!spaces) {
+        return 0;
+    }
+
+    uint64_t space = 0;
+    if (CFArrayGetCount(spaces) == 1) {
+        CFTypeRef value = CFArrayGetValueAtIndex(spaces, 0);
+        if (value && CFGetTypeID(value) == CFNumberGetTypeID()) {
+            CFNumberGetValue((CFNumberRef)value, kCFNumberSInt64Type, &space);
+        }
+    }
+    CFRelease(spaces);
+    return space;
+}
+
+/* The window's own full-screen Space (never a desktop's). */
+static uint64_t omacvm_fullpanel_full_screen_space(NSWindow *window)
+{
+    uint64_t space = omacvm_fullpanel_space_id(window);
+    if (!space) {
+        return 0;
+    }
+    return omacvm_fullpanel_sls_space_type(omacvm_fullpanel_sls_main(), space) ==
+           OMACVM_FP_SPACE_FULL_SCREEN ? space : 0;
+}
+
+static void omacvm_fullpanel_set_menu_alpha(uint64_t space, float alpha, const char *why)
+{
+    if (!space || !omacvm_fullpanel_load_skylight()) {
+        return;
+    }
+    CFTypeRef transaction = omacvm_fullpanel_sls_transaction_create(omacvm_fullpanel_sls_main());
+    if (!transaction) {
+        fprintf(stderr, "omacvm: full panel: no menu bar transaction (%s)\n", why);
+        return;
+    }
+    omacvm_fullpanel_sls_menu_alpha(transaction, space, alpha);
+    int32_t result = omacvm_fullpanel_sls_transaction_commit(transaction, 1);
+    if (result) {
+        fprintf(stderr, "omacvm: full panel: menu bar transaction failed (%s): %d\n",
+                why, (int)result);
+    }
+    CFRelease(transaction);
+}
+
+static Method omacvm_fullpanel_private_method(const char *class_name,
+                                              const char *selector_name,
+                                              const char *expected_types)
+{
+    Class cls = NSClassFromString([NSString stringWithUTF8String:class_name]);
+    if (!cls) {
+        fprintf(stderr, "omacvm: full panel: no %s; using normal full screen\n", class_name);
+        return NULL;
+    }
+    SEL selector = NSSelectorFromString([NSString stringWithUTF8String:selector_name]);
+    Method method = class_getInstanceMethod(cls, selector);
+    const char *types = method ? method_getTypeEncoding(method) : NULL;
+    if (!method || !types || strcmp(types, expected_types)) {
+        fprintf(stderr, "omacvm: full panel: cannot use -[%s %s]; using normal full screen\n",
+                class_name, selector_name);
+        return NULL;
+    }
+    return method;
+}
+
+typedef void (*OmacVMFullPanelSetRevealFn)(id, SEL, double);
+typedef double (*OmacVMFullPanelGetRevealFn)(id, SEL);
+typedef id (*OmacVMFullPanelGetObjectFn)(id, SEL);
+
+@interface OmacVMFullPanelState : NSObject
+{
+    NSWindow *window;
+    bool full_screen_frame_kept;
+    /* Set once the frame hook gave out the whole display in this full screen. */
+    bool frame_accepted;
+    bool safe_tile_logged;
+    bool reject_logged;
+    bool display_logged;
+    bool in_full_screen_space;
+    bool area_lost;
+    uint64_t menu_bar_hidden_space;
+    NSApplicationPresentationOptions revealable_presentation;
+    bool revealable_presentation_valid;
+    bool menu_bar_revealed;
+    bool toolbar_revealed;
+    bool menu_bar_reveal_allowed;
+    bool presentation_forced;
+    bool presentation_observing;
+    id top_edge_monitor;
+    bool workspace_observing;
+    bool refresh_pending;
+}
+- (id)initWithWindow:(NSWindow *)w;
+- (bool)usable;
+- (NSRect)fullScreenFrameForAppKitFrame:(NSRect)frame;
+- (bool)keepSetFrame:(NSRect)proposed display:(bool)display;
+- (void)menuRevealChanged:(bool)menu toolbar:(bool)toolbar;
+- (void)activeSpaceChanged:(NSNotification *)notification;
+- (void)scheduleRefresh:(NSString *)reason;
+- (bool)refreshForReason:(NSString *)reason;
+- (void)finishReturn:(NSString *)reason checksLeft:(unsigned)checks;
+@end
+
+/*
+ * 1: WindowServer has the window at its frame, 0: still moving (Mission
+ * Control animates the real window while AppKit's frame stays), -1: not
+ * known. Only ever used to wait, never to force a frame.
+ */
+static int omacvm_fullpanel_compositor_ready(NSWindow *w)
+{
+    NSScreen *primary = [[NSScreen screens] firstObject];
+    if (!w || !primary || [w windowNumber] <= 0) {
+        return -1;
+    }
+    CFArrayRef info = CGWindowListCopyWindowInfo(
+        kCGWindowListOptionIncludingWindow, (CGWindowID)[w windowNumber]);
+    if (!info) {
+        return -1;
+    }
+    int ready = -1;
+    NSRect frame = [w frame];
+    NSRect expected = NSMakeRect(frame.origin.x,
+        NSMaxY([primary frame]) - NSMaxY(frame), frame.size.width, frame.size.height);
+    for (NSDictionary *entry in (NSArray *)info) {
+        if ([[entry objectForKey:(id)kCGWindowNumber] integerValue] != [w windowNumber]) {
+            continue;
+        }
+        CGRect bounds;
+        CFDictionaryRef value = (CFDictionaryRef)[entry objectForKey:(id)kCGWindowBounds];
+        if (value && CGRectMakeWithDictionaryRepresentation(value, &bounds)) {
+            ready = omacvm_fp_rect_equal(omacvm_fullpanel_rect(NSRectFromCGRect(bounds)),
+                                         omacvm_fullpanel_rect(expected)) ? 1 : 0;
+        }
+        break;
+    }
+    CFRelease(info);
+    return ready;
+}
+
+static bool omacvm_fullpanel_window_usable(NSWindow *window)
+{
+    OmacVMFullPanelState *state = omacvm_fullpanel_state(window);
+    return state && [state usable];
+}
+
+/* AppKit's menu bar companion says when the menu bar or toolbar comes down. */
+static bool omacvm_fullpanel_install_reveal_observer(void)
+{
+    if (omacvm_fullpanel_reveal_state) {
+        return omacvm_fullpanel_reveal_state > 0;
+    }
+    omacvm_fullpanel_reveal_state = -1;
+
+    Method set_menu = omacvm_fullpanel_private_method(
+        "_NSFullScreenMenuBarCompanionController", "setMenuBarReveal:", "v24@0:8d16");
+    Method set_toolbar = omacvm_fullpanel_private_method(
+        "_NSFullScreenMenuBarCompanionController", "setToolbarWindowReveal:", "v24@0:8d16");
+    Method get_menu = omacvm_fullpanel_private_method(
+        "_NSFullScreenMenuBarCompanionController", "menuBarReveal", "d16@0:8");
+    Method get_toolbar = omacvm_fullpanel_private_method(
+        "_NSFullScreenMenuBarCompanionController", "toolbarWindowReveal", "d16@0:8");
+    Method get_content = omacvm_fullpanel_private_method(
+        "_NSFullScreenMenuBarCompanionController", "contentController", "@16@0:8");
+    Method get_window = omacvm_fullpanel_private_method(
+        "_NSFullScreenContentController", "window", "@16@0:8");
+
+    if (!set_menu || !set_toolbar || !get_menu || !get_toolbar ||
+        !get_content || !get_window) {
+        return false;
+    }
+
+    SEL menu_get_sel = method_getName(get_menu);
+    SEL toolbar_get_sel = method_getName(get_toolbar);
+    SEL content_sel = method_getName(get_content);
+    SEL window_sel = method_getName(get_window);
+    OmacVMFullPanelGetRevealFn menu_get =
+        (OmacVMFullPanelGetRevealFn)method_getImplementation(get_menu);
+    OmacVMFullPanelGetRevealFn toolbar_get =
+        (OmacVMFullPanelGetRevealFn)method_getImplementation(get_toolbar);
+    OmacVMFullPanelGetObjectFn content_get =
+        (OmacVMFullPanelGetObjectFn)method_getImplementation(get_content);
+    OmacVMFullPanelGetObjectFn window_get =
+        (OmacVMFullPanelGetObjectFn)method_getImplementation(get_window);
+
+    Method setters[2] = { set_menu, set_toolbar };
+    for (int i = 0; i < 2; i++) {
+        Method setter = setters[i];
+        SEL setter_sel = method_getName(setter);
+        OmacVMFullPanelSetRevealFn original =
+            (OmacVMFullPanelSetRevealFn)method_getImplementation(setter);
+
+        id block = ^(id companion, double value) {
+            original(companion, setter_sel, value);
+
+            bool menu = menu_get(companion, menu_get_sel) > 0;
+            bool toolbar = toolbar_get(companion, toolbar_get_sel) > 0;
+            id content = content_get(companion, content_sel);
+            NSWindow *w = content ? window_get(content, window_sel) : nil;
+            OmacVMFullPanelState *state = omacvm_fullpanel_state(w);
+            if (!state) {
+                return;
+            }
+            void (^update)(void) = ^{
+                [state menuRevealChanged:menu toolbar:toolbar];
+            };
+            if ([NSThread isMainThread]) {
+                update();
+            } else {
+                dispatch_async(dispatch_get_main_queue(), update);
+            }
+        };
+        method_setImplementation(setter, imp_implementationWithBlock(block));
+    }
+
+    omacvm_fullpanel_reveal_state = 1;
+    return true;
+}
+
+static NSRect omacvm_fullpanel_frame_hook(id object, SEL selector)
+{
+    NSRect frame = omacvm_fullpanel_appkit_frame ?
+        omacvm_fullpanel_appkit_frame(object, selector) : [(NSWindow *)object frame];
+    OmacVMFullPanelState *state = omacvm_fullpanel_state((NSWindow *)object);
+    return state ? [state fullScreenFrameForAppKitFrame:frame] : frame;
+}
+
+static bool omacvm_fullpanel_class_hooked(Class cls)
+{
+    for (int i = 0; i < omacvm_fullpanel_hooked_count; i++) {
+        if (omacvm_fullpanel_hooked_classes[i] == cls) {
+            return true;
+        }
+    }
+    return false;
+}
+
+/* -_frameForFullScreenMode on the window's own class (QemuWindow, OmacVMHeadWindow). */
+static bool omacvm_fullpanel_install_frame_hook(Class cls)
+{
+    if (omacvm_fullpanel_class_hooked(cls)) {
+        return true;
+    }
+    if (!omacvm_fullpanel_appkit_frame) {
+        const char *expected = "{CGRect={CGPoint=dd}{CGSize=dd}}16@0:8";
+        omacvm_fullpanel_frame_selector = NSSelectorFromString(@"_frameForFullScreenMode");
+        omacvm_fullpanel_tile_selector = NSSelectorFromString(@"_tileFrameForFullScreen");
+
+        Method frame = class_getInstanceMethod([NSWindow class], omacvm_fullpanel_frame_selector);
+        Method tile = class_getInstanceMethod([NSWindow class], omacvm_fullpanel_tile_selector);
+        const char *frame_types = frame ? method_getTypeEncoding(frame) : NULL;
+        const char *tile_types = tile ? method_getTypeEncoding(tile) : NULL;
+        if (!frame || !tile || !frame_types || !tile_types ||
+            strcmp(frame_types, expected) || strcmp(tile_types, expected)) {
+            fprintf(stderr, "omacvm: full panel: AppKit's full-screen frame methods changed; using normal full screen\n");
+            return false;
+        }
+        omacvm_fullpanel_frame_types = frame_types;
+        omacvm_fullpanel_appkit_frame = (OmacVMFullPanelFrameFn)method_getImplementation(frame);
+        omacvm_fullpanel_tile_frame = (OmacVMFullPanelFrameFn)method_getImplementation(tile);
+    }
+    if (omacvm_fullpanel_hooked_count >=
+        (int)(sizeof(omacvm_fullpanel_hooked_classes) / sizeof(omacvm_fullpanel_hooked_classes[0]))) {
+        return false;
+    }
+    if (!class_addMethod(cls, omacvm_fullpanel_frame_selector,
+                         (IMP)omacvm_fullpanel_frame_hook, omacvm_fullpanel_frame_types)) {
+        fprintf(stderr, "omacvm: full panel: cannot hook %s's full-screen frame; using normal full screen\n",
+                class_getName(cls));
+        return false;
+    }
+    omacvm_fullpanel_hooked_classes[omacvm_fullpanel_hooked_count++] = cls;
+    return true;
+}
+
+@implementation OmacVMFullPanelState
+
+- (id)initWithWindow:(NSWindow *)w
+{
+    self = [super init];
+    if (!self) {
+        return nil;
+    }
+    window = w;
+
+    [[[NSWorkspace sharedWorkspace] notificationCenter]
+        addObserver:self selector:@selector(activeSpaceChanged:)
+        name:NSWorkspaceActiveSpaceDidChangeNotification object:nil];
+    workspace_observing = true;
+
+    NSNotificationCenter *center = [NSNotificationCenter defaultCenter];
+    [center addObserver:self selector:@selector(willEnterFullScreen:)
+                   name:NSWindowWillEnterFullScreenNotification object:w];
+    [center addObserver:self selector:@selector(didEnterFullScreen:)
+                   name:NSWindowDidEnterFullScreenNotification object:w];
+    [center addObserver:self selector:@selector(windowDidResize:)
+                   name:NSWindowDidResizeNotification object:w];
+    [center addObserver:self selector:@selector(willLeaveFullScreen:)
+                   name:NSWindowWillExitFullScreenNotification object:w];
+    [center addObserver:self selector:@selector(willLeaveFullScreen:)
+                   name:NSWindowWillCloseNotification object:w];
+    [center addObserver:self selector:@selector(otherWindowDidChangeOcclusionState:)
+                   name:NSWindowDidChangeOcclusionStateNotification object:nil];
+    [center addObserver:self selector:@selector(windowDidBecomeKey:)
+                   name:NSWindowDidBecomeKeyNotification object:w];
+    return self;
+}
