+- (bool)usable
+{
+    NSScreen *screen = window ? [window screen] : nil;
+    if (!screen || !omacvm_fp_display_ok(omacvm_fullpanel_requested(),
+                                         [screen safeAreaInsets].top,
+                                         [[NSUserDefaults standardUserDefaults]
+                                             boolForKey:@"AppleMenuBarVisibleInFullscreen"])) {
+        return false;
+    }
+    return omacvm_fullpanel_class_hooked([window class]) &&
+           omacvm_fullpanel_load_skylight() &&
+           omacvm_fullpanel_install_reveal_observer();
+}
+
+- (NSRect)fullScreenFrameForAppKitFrame:(NSRect)frame
+{
+    NSScreen *screen = [window screen];
+    if (!screen) {
+        return frame;
+    }
+    NSRect display = [screen frame];
+    NSRect tile = omacvm_fullpanel_tile_frame ?
+        omacvm_fullpanel_tile_frame(window, omacvm_fullpanel_tile_selector) : frame;
+    OmacVMFPFrameIn in = {
+        .usable = [self usable],
+        .area_lost = area_lost,
+        .accepted = frame_accepted,
+        .kept = full_screen_frame_kept,
+        .full_screen_style = ([window styleMask] & NSWindowStyleMaskFullScreen) != 0,
+        .notch = [screen safeAreaInsets].top,
+        .tile = omacvm_fullpanel_rect(tile),
+        .display = omacvm_fullpanel_rect(display),
+    };
+
+    switch (omacvm_fp_frame(&in)) {
+    case OMACVM_FP_DISPLAY:
+        break;
+    case OMACVM_FP_DISPLAY_KEPT:
+        if (!safe_tile_logged) {
+            safe_tile_logged = true;
+            fprintf(stderr, "omacvm: full panel: kept the whole display over AppKit's %.0fx%.0f tile\n",
+                    tile.size.width, tile.size.height);
+        }
+        break;
+    case OMACVM_FP_APPKIT:
+    default:
+        if (in.usable && frame_accepted && !reject_logged) {
+            reject_logged = true;
+            fprintf(stderr, "omacvm: full panel: AppKit's frame for tile (%.0f %.0f %.0fx%.0f) on display (%.0f %.0f %.0fx%.0f)\n",
+                    tile.origin.x, tile.origin.y, tile.size.width, tile.size.height,
+                    display.origin.x, display.origin.y, display.size.width, display.size.height);
+        }
+        return frame;
+    }
+    frame_accepted = true;
+    return display;
+}
+
+- (bool)keepSetFrame:(NSRect)proposed display:(bool)display
+{
+    NSScreen *screen = [window screen];
+    if (!screen || !full_screen_frame_kept || !frame_accepted) {
+        return false;
+    }
+    NSRect d = [screen frame];
+    NSRect tile = omacvm_fullpanel_tile_frame ?
+        omacvm_fullpanel_tile_frame(window, omacvm_fullpanel_tile_selector) : d;
+    OmacVMFPKeepIn in = {
+        .kept = full_screen_frame_kept,
+        .accepted = frame_accepted,
+        .full_screen_style = ([window styleMask] & NSWindowStyleMaskFullScreen) != 0,
+        .usable = [self usable],
+        .area_lost = area_lost,
+        .frame = omacvm_fullpanel_rect([window frame]),
+        .display = omacvm_fullpanel_rect(d),
+        .tile = omacvm_fullpanel_rect(tile),
+    };
+    if (!omacvm_fp_keep(&in)) {
+        return false;
+    }
+    if (!omacvm_fp_rect_equal(omacvm_fullpanel_rect(proposed), in.display)) {
+        fprintf(stderr, "omacvm: full panel: kept the whole display %.0fx%.0f over %.0fx%.0f\n",
+                d.size.width, d.size.height, proposed.size.width, proposed.size.height);
+    }
+    if (display) {
+        [window display];
+    }
+    return true;
+}
