+/* Before a window enters full screen: its state, the hooks (once per class). */
+static void omacvm_fullpanel_prepare_window(NSWindow *window)
+{
+    static bool logged;
+
+    if (!omacvm_fullpanel_requested() || !window || omacvm_fullpanel_state(window)) {
+        return;
+    }
+    if (!logged) {
+        logged = true;
+        fprintf(stderr, "omacvm: full panel: asked for (OMACVM_FULLPANEL=1)\n");
+    }
+    bool frame = omacvm_fullpanel_install_frame_hook([window class]);
+    bool sky = omacvm_fullpanel_load_skylight();
+    bool reveal = omacvm_fullpanel_install_reveal_observer();
+
+    OmacVMFullPanelState *state = [[OmacVMFullPanelState alloc] initWithWindow:window];
+    objc_setAssociatedObject(window, &omacvm_fullpanel_state_key, state,
+                             OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+    [state release];
+
+    if (!frame || !sky || !reveal) {
+        fprintf(stderr, "omacvm: full panel: a private part is missing; using normal full screen\n");
+    }
+}
+
+static bool omacvm_fullpanel_keep_frame(NSWindow *window, NSRect proposed, bool display)
+{
+    OmacVMFullPanelState *state = omacvm_fullpanel_state(window);
+    return state && [state keepSetFrame:proposed display:display];
+}
