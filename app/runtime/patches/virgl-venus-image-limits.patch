+/* OmacVM (virgl-venus-image-limits.patch): an image type and tiling the host driver can
+ * be asked about. KosmicKrisp ends its image queries in UNREACHABLE("Invalid image type"),
+ * undefined behaviour in its release build; neither Mac driver has DRM format modifiers,
+ * so that tiling must have become LINEAR (the emulated LINEAR modifier) by now. */
+bool
+vkr_physical_device_image_kind_ok(const struct vkr_physical_device *physical_dev,
+                                  VkImageType type,
+                                  VkImageTiling tiling)
+{
+   if (type != VK_IMAGE_TYPE_1D && type != VK_IMAGE_TYPE_2D && type != VK_IMAGE_TYPE_3D)
+      return false;
+   if (tiling == VK_IMAGE_TILING_OPTIMAL || tiling == VK_IMAGE_TILING_LINEAR)
+      return true;
+   return tiling == VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT &&
+          physical_dev->EXT_image_drm_format_modifier;
+}
