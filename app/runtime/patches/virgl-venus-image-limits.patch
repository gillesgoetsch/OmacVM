+   case VK_FORMAT_R64G64B64A64_SFLOAT: case VK_FORMAT_R64G64B64A64_SINT:
+   case VK_FORMAT_R64G64B64A64_UINT:
+      return 32;
+   default:
+      return 0;
+   }
+}
