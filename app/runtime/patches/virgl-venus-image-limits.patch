+/* OmacVM (virgl-venus-image-limits.patch): whether an image description may go to the
+ * Mac's Vulkan driver. Metal ends the process on a texture it cannot make (too many
+ * levels or texels, a sample count it has not, a linear texture it cannot back), and
+ * KosmicKrisp and MoltenVK hand the guest's values on to it. So the shape the spec allows
+ * is checked first (KosmicKrisp's own query has UNREACHABLE paths for bad values), then
+ * the driver's own format query is asked about exactly this description: what Metal can
+ * make is in that answer, vkr needs no Metal rules of its own. This checks what the Mac
+ * drivers end the process on, not every valid-usage rule. info is what the driver would
+ * get (after vkr_image_fix_create_info and vkr_image_fix_drm_format); the verdict depends
+ * only on the device and info. false: why says which value and which limit. */
+static bool
+vkr_image_info_ok(struct vkr_physical_device *physical_dev,
+                  const VkImageCreateInfo *info,
+                  char *why,
+                  size_t why_size)
+{
+   const VkExtent3D e = info->extent;
+
+   if (!vkr_physical_device_image_kind_ok(physical_dev, info->imageType, info->tiling)) {
+      snprintf(why, why_size, "imageType %d tiling %d", info->imageType, info->tiling);
+      return false;
+   }
+   if (!util_is_power_of_two_nonzero(info->samples) || info->samples > VK_SAMPLE_COUNT_64_BIT) {
+      snprintf(why, why_size, "samples 0x%x is not one sample count", info->samples);
+      return false;
+   }
+   if (!e.width || !e.height || !e.depth || !info->mipLevels || !info->arrayLayers) {
+      snprintf(why, why_size, "extent %ux%ux%u, %u levels, %u layers: none may be 0",
+               e.width, e.height, e.depth, info->mipLevels, info->arrayLayers);
+      return false;
+   }
+   if ((info->imageType == VK_IMAGE_TYPE_1D && (e.height != 1 || e.depth != 1)) ||
+       (info->imageType == VK_IMAGE_TYPE_2D && e.depth != 1)) {
+      snprintf(why, why_size, "imageType %d with extent %ux%ux%u", info->imageType, e.width,
+               e.height, e.depth);
+      return false;
+   }
+   if ((info->flags & VK_IMAGE_CREATE_CUBE_COMPATIBLE_BIT) &&
+       (info->imageType != VK_IMAGE_TYPE_2D || e.width != e.height || info->arrayLayers < 6)) {
+      snprintf(why, why_size, "cube compatible imageType %d %ux%u with %u layers",
+               info->imageType, e.width, e.height, info->arrayLayers);
+      return false;
+   }
+   const VkImageStencilUsageCreateInfo *stencil =
+      vkr_find_struct(info->pNext, VK_STRUCTURE_TYPE_IMAGE_STENCIL_USAGE_CREATE_INFO);
+   if ((info->flags & ~VKR_IMAGE_CREATE_FLAGS_KNOWN) || !info->usage ||
+       (info->usage & ~VKR_IMAGE_USAGE_FLAGS_KNOWN) ||
+       (stencil && (!stencil->stencilUsage ||
+                    (stencil->stencilUsage & ~VKR_IMAGE_USAGE_FLAGS_KNOWN)))) {
+      snprintf(why, why_size, "flags 0x%x usage 0x%x stencil usage 0x%x: unknown bits or none",
+               info->flags, info->usage, stencil ? stencil->stencilUsage : 0);
+      return false;
+   }
+
+   /* The driver's answer for this description. A new question: the external memory and
+    * format list structs of the create info stay out (KosmicKrisp's query refuses
+    * MTLTEXTURE handles, which every window buffer has). LINEAR asks the same as the
+    * emulated LINEAR modifier's query (virgl-venus-linear-modifier-usage.patch). */
+   const bool linear = info->tiling == VK_IMAGE_TILING_LINEAR;
+   VkImageStencilUsageCreateInfo stencil_q = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_STENCIL_USAGE_CREATE_INFO,
+   };
+   if (stencil)
+      stencil_q.stencilUsage =
+         linear ? vkr_physical_device_linear_usage(physical_dev, info->format,
+                                                   stencil->stencilUsage)
+                : stencil->stencilUsage;
+   const VkPhysicalDeviceImageFormatInfo2 q = {
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_IMAGE_FORMAT_INFO_2,
+      .pNext = stencil ? &stencil_q : NULL,
+      .format = info->format,
+      .type = info->imageType,
+      .tiling = info->tiling,
+      .usage = linear ? vkr_physical_device_linear_usage(physical_dev, info->format, info->usage)
+                      : info->usage,
+      .flags = info->flags,
+   };
+   VkImageFormatProperties2 answer = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_FORMAT_PROPERTIES_2,
+   };
+   const VkResult r = physical_dev->proc_table.GetPhysicalDeviceImageFormatProperties2(
+      physical_dev->base.handle.physical_device, &q, &answer);
+   const VkImageFormatProperties *l = &answer.imageFormatProperties;
+   if (r != VK_SUCCESS) {
+      snprintf(why, why_size,
+               "the driver has no format %d imageType %d tiling %d usage 0x%x flags 0x%x (%d)",
+               info->format, info->imageType, info->tiling, q.usage, info->flags, r);
+      return false;
+   }
+   if (e.width > l->maxExtent.width || e.height > l->maxExtent.height ||
+       e.depth > l->maxExtent.depth) {
+      snprintf(why, why_size, "format %d extent %ux%ux%u past the driver's %ux%ux%u",
+               info->format, e.width, e.height, e.depth, l->maxExtent.width,
+               l->maxExtent.height, l->maxExtent.depth);
+      return false;
+   }
+   const uint32_t largest = MAX3(e.width, e.height, e.depth);
+   const uint32_t levels = util_logbase2(largest) + 1;
+   if (info->mipLevels > l->maxMipLevels || info->mipLevels > levels) {
+      snprintf(why, why_size, "%u levels for %u texels (the driver's limit %u)",
+               info->mipLevels, largest, l->maxMipLevels);
+      return false;
+   }
+   if (info->arrayLayers > l->maxArrayLayers) {
+      snprintf(why, why_size, "%u layers past the driver's %u", info->arrayLayers,
+               l->maxArrayLayers);
+      return false;
+   }
+   if (!(info->samples & l->sampleCounts)) {
+      snprintf(why, why_size, "samples 0x%x not in the driver's 0x%x for format %d",
+               info->samples, l->sampleCounts, info->format);
+      return false;
+   }
+   return true;
+}
+
+/* OmacVM (virgl-venus-image-limits.patch): the plane index of a plane aspect, or 3 */
+static uint32_t
+vkr_image_plane_index(VkImageAspectFlags aspect)
+{
+   switch (aspect) {
+   case VK_IMAGE_ASPECT_PLANE_0_BIT:
+      return 0;
+   case VK_IMAGE_ASPECT_PLANE_1_BIT:
+      return 1;
+   case VK_IMAGE_ASPECT_PLANE_2_BIT:
+      return 2;
+   default:
+      return 3;
+   }
+}
+
+/* OmacVM (virgl-venus-image-limits.patch): whether a subresource is in an image of this
+ * format, levels and layers (MoltenVK reads past its plane array for PLANE_1 of a
+ * one-plane image and crashes). drm_linear: the guest made the image with the emulated
+ * LINEAR modifier and names its one memory plane. */
+static bool
+vkr_image_subresource_ok(VkFormat format,
+                         bool drm_linear,
+                         uint32_t levels,
+                         uint32_t layers,
+                         const VkImageSubresource *sub,
+                         char *why,
+                         size_t why_size)
+{
+   const uint32_t planes = vkr_format_plane_count(format);
+   VkImageAspectFlags allowed =
+      planes > 1 ? (VK_IMAGE_ASPECT_PLANE_0_BIT << planes) - VK_IMAGE_ASPECT_PLANE_0_BIT
+                 : vkr_format_aspects(format);
+   if (drm_linear)
+      allowed |= VK_IMAGE_ASPECT_MEMORY_PLANE_0_BIT_EXT;
+   if (!util_is_power_of_two_nonzero(sub->aspectMask) || !(sub->aspectMask & allowed) ||
+       sub->mipLevel >= levels || sub->arrayLayer >= layers) {
+      snprintf(why, why_size,
+               "aspect 0x%x level %u layer %u of format %d with %u levels, %u layers",
+               sub->aspectMask, sub->mipLevel, sub->arrayLayer, format, levels, layers);
+      return false;
+   }
+   return true;
+}
+
+/* OmacVM (virgl-venus-image-limits.patch): what the host image was made with, and the
+ * host's memory requirements of each plane bound on its own (one query each) */
+static void
+vkr_image_init_info(struct vkr_device *dev,
+                    struct vkr_image *image,
+                    const VkImageCreateInfo *info,
+                    bool drm_linear)
+{
+   image->type = info->imageType;
+   image->format = info->format;
+   image->tiling = info->tiling;
+   image->flags = info->flags;
+   image->extent = info->extent;
+   image->mip_levels = info->mipLevels;
+   image->array_layers = info->arrayLayers;
+   image->drm_linear = drm_linear;
+   image->plane_count =
+      info->flags & VK_IMAGE_CREATE_DISJOINT_BIT ? vkr_format_plane_count(info->format) : 1;
+
+   for (uint32_t i = 0; i < image->plane_count; i++) {
+      VkImagePlaneMemoryRequirementsInfo plane = {
+         .sType = VK_STRUCTURE_TYPE_IMAGE_PLANE_MEMORY_REQUIREMENTS_INFO,
+         .planeAspect = VK_IMAGE_ASPECT_PLANE_0_BIT << i,
+      };
+      const VkImageMemoryRequirementsInfo2 req_info = {
+         .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_REQUIREMENTS_INFO_2,
+         .pNext = image->plane_count > 1 ? &plane : NULL,
+         .image = image->base.handle.image,
+      };
+      VkMemoryRequirements2 req = {
+         .sType = VK_STRUCTURE_TYPE_MEMORY_REQUIREMENTS_2,
+      };
+      dev->proc_table.GetImageMemoryRequirements2(dev->base.handle.device, &req_info, &req);
+      image->memory[i] = (struct vkr_image_memory){
+         .size = req.memoryRequirements.size,
+         .alignment = req.memoryRequirements.alignment,
+         .type_bits = req.memoryRequirements.memoryTypeBits,
+      };
+   }
+}
+
+/* OmacVM (virgl-venus-image-limits.patch): whether memory may be bound to an image (or
+ * one plane of it): the type is one of the image's, the offset is aligned and the image
+ * ends inside the memory. KosmicKrisp rounds the offset up itself and makes a linear
+ * image's texture from the memory's buffer: past the end it keeps no texture, and the
+ * GPU later uses what is not there. next: the bind info's pNext (plane info). */
+static bool
+vkr_image_bind_ok(const struct vkr_image *image,
+                  const struct vkr_device_memory *mem,
+                  VkDeviceSize offset,
+                  const void *next,
+                  char *why,
+                  size_t why_size)
+{
+   const VkBindImagePlaneMemoryInfo *plane_info =
+      vkr_find_struct(next, VK_STRUCTURE_TYPE_BIND_IMAGE_PLANE_MEMORY_INFO);
+   if (!image || !mem) {
+      snprintf(why, why_size, "no %s", image ? "memory" : "image");
+      return false;
+   }
+   const uint32_t plane = plane_info ? vkr_image_plane_index(plane_info->planeAspect) : 0;
+   if (!plane_info != (image->plane_count == 1) || plane >= image->plane_count) {
+      snprintf(why, why_size, "plane aspect 0x%x for an image of %u memory planes",
+               plane_info ? plane_info->planeAspect : 0, image->plane_count);
+      return false;
+   }
+   const struct vkr_image_memory *req = &image->memory[plane];
+   if (mem->memory_type_index >= 32 || !(req->type_bits & (1u << mem->memory_type_index))) {
+      snprintf(why, why_size, "memory type %u not in the image's 0x%x",
+               mem->memory_type_index, req->type_bits);
+      return false;
+   }
+   if (req->alignment && offset % req->alignment) {
+      snprintf(why, why_size, "offset %" PRIu64 " not a multiple of %" PRIu64, offset,
+               req->alignment);
+      return false;
+   }
+   if (offset > mem->allocation_size || req->size > mem->allocation_size - offset) {
+      snprintf(why, why_size, "%" PRIu64 " bytes at %" PRIu64 " past the memory's %" PRIu64,
+               req->size, offset, mem->allocation_size);
+      return false;
+   }
+   return true;
+}
+
+/* OmacVM (virgl-venus-image-limits.patch): a create info a vkGetDeviceImage* query
+ * takes, changed as vkCreateImage changes it (the same order: dma-buf handles, then the
+ * emulated LINEAR modifier, then the check), so the driver judges what it would make */
+static bool
+vkr_image_device_info_ok(struct vkr_device *dev,
+                         VkImageCreateInfo *info,
+                         char *why,
+                         size_t why_size)
+{
+   if (dev->physical_device->is_dma_buf_emulated)
