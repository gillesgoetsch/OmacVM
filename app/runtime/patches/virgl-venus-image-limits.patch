+       vkr_image_fix_drm_format(dev, info) != VK_SUCCESS) {
+      snprintf(why, why_size, "a DRM format modifier other than LINEAR");
+      return false;
+   }
+   return vkr_image_info_ok(dev->physical_device, info, why, why_size);
+}
