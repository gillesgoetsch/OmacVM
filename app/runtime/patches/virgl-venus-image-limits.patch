index 5512b84..c1e85c4 100644
--- a/src/venus/vkr_context.h
+++ b/src/venus/vkr_context.h
@@ -173,6 +173,16 @@ vkr_context_get_fatal(struct vkr_context *ctx)
    return ctx->cs_fatal_error;
 }
 
+/* OmacVM (virgl-venus-image-limits.patch): a guest call vkr does not pass to the Mac's
+ * Vulkan driver, because the driver (Metal under it) would end QEMU on it or the spec
+ * forbids it. Logs the app, the call and why (fmt) at the 1st, 2nd, 4th ... refusal of
+ * the process. fatal: the call has no answer the guest waits for (the guest made the
+ * object without asking), so the app's Venus context ends; the guest's Mesa then ends
+ * that app, and the VM goes on. */
+void
+vkr_context_refuse(struct vkr_context *ctx, bool fatal, const char *call, const char *fmt, ...)
+   PRINTFLIKE(4, 5);
+
 static inline bool
 vkr_context_validate_object_id(struct vkr_context *ctx, vkr_object_id id)
 {
