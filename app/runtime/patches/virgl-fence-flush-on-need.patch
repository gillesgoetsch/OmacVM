@@ -533,6 +533,225 @@ struct sysval_uniform_block {
 
 static struct global_renderer_state vrend_state;
 
+/* OmacVM: a fence's glFlush only when something needs it
+ * (virgl-fence-flush-on-need.patch).
+ *
+ * Every guest command buffer comes with a fence, and Mesa sends one each time
+ * its 64K-dword buffer is full: a WebGL page with ~30k draws a frame sends ~40.
+ * Each glFlush ends Apple's Metal render pass and commits a command buffer
+ * (~6 % of the render thread at Aquarium 30k).
+ *
+ * The flush is there for two things. The fence must signal: the sync thread
+ * waits on it in its own context, and a fence that was never flushed may never
+ * signal. And another GL context must see the work: Apple's GL does not flush
+ * on a context switch. So while the same GL context goes on with its next
+ * command buffer, the flush waits, and it is done
+ *  - before any other GL context is made current (another guest context or sub
+ *    context, the blitter, a query check, vrend's own context outside the hop
+ *    QEMU makes before every command) or the context is destroyed;
+ *  - when QEMU asks (virgl_renderer_flush_fences: before every command that is
+ *    not a command buffer, after the last command of its queue), and in every
+ *    renderer call that may read guest work outside a command buffer (poll,
+ *    transfers, resources, cursor, scanout, a Venus command buffer);
+ *  - at the next fence once the oldest waiting one is
+ *    OMACVM_VIRGL_FENCE_FLUSH_US old (default 2000).
+ * The guest learns of a fence only between QEMU's commands, so a fence held
+ * while QEMU still has commands to run delays nothing the guest sees; the age
+ * limit keeps the GPU working alongside the render thread.
+ * Render thread only (the thread that ran vrend_renderer_init); fences made on
+ * any other thread are flushed at once. OMACVM_VIRGL_FENCE_FLUSH=0 flushes
+ * every fence at once (as before); OMACVM_VIRGL_FENCE_FLUSH_STATS=1 logs the
+ * counts every 10 s. */
+static struct {
+   bool on;
+   uint64_t max_age_ns;
+   thrd_t thread;               /* the render thread */
+   bool have_thread;
+   virgl_gl_context cur;        /* what the render thread last made current through vrend */
+   virgl_gl_context gl;         /* holds fences not flushed yet; NULL: none */
+   uint64_t since;              /* when the first of them was made */
+   bool hop;                    /* vrend_renderer_force_ctx_0 switches to ctx0 */
+   struct vrend_if_cbs cbs;     /* what vrend_clicbs points to: the hooks below */
+   const struct vrend_if_cbs *real;
+   bool warned;
+   bool stats_on;
+   uint64_t stats_at;
+   struct {
+      uint64_t fences, held, age, other_ctx, switched, destroyed, asked;
+   } stats;
+} fence_flush;
+
+static uint64_t fence_flush_now(void)
+{
+   struct timespec ts;
+   clock_gettime(CLOCK_MONOTONIC, &ts);
+   return (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
+}
+
+static bool fence_flush_render_thread(void)
+{
+   return fence_flush.have_thread && thrd_equal(thrd_current(), fence_flush.thread);
+}
+
+/* Flush the context holding fences, whatever is current now (QEMU may have
+ * made its own context current between two calls). With restore, make the
+ * context vrend made current last current again; without, the caller
+ * switches next. */
+static void fence_flush_held(bool restore)
+{
+   virgl_gl_context gl = fence_flush.gl;
+   if (!gl)
+      return;
+   fence_flush.gl = NULL;
+   if (fence_flush.real->make_current(gl) && !fence_flush.warned) {
+      fence_flush.warned = true;
+      virgl_warn("fence flush: could not make the context with held fences current\n");
+   }
+   glFlush();
+   if (restore && fence_flush.cur != gl)
+      fence_flush.real->make_current(fence_flush.cur);
+}
+
+static int fence_flush_make_current(virgl_gl_context ctx)
+{
+   if (fence_flush_render_thread()) {
+      if (fence_flush.gl && ctx != fence_flush.gl && !fence_flush.hop) {
+         fence_flush.stats.switched++;
+         fence_flush_held(false);
+      }
+      fence_flush.cur = ctx;
+   }
+   return fence_flush.real->make_current(ctx);
+}
+
+static int fence_flush_make_current_surfaceless(virgl_gl_context ctx)
+{
+   if (fence_flush_render_thread()) {
+      if (fence_flush.gl && ctx != fence_flush.gl && !fence_flush.hop) {
+         fence_flush.stats.switched++;
+         fence_flush_held(false);
+      }
+      fence_flush.cur = ctx;
+   }
+   return fence_flush.real->make_current_surfaceless(ctx);
+}
+
+/* Work never flushed in a context that goes away may never run: its fences
+ * would never signal. */
+static void fence_flush_before_destroy(virgl_gl_context ctx)
+{
+   if (!fence_flush_render_thread())
+      return;
+   if (ctx == fence_flush.gl) {
+      fence_flush.stats.destroyed++;
+      fence_flush_held(true);
+   }
+   if (ctx == fence_flush.cur)
+      fence_flush.cur = NULL;
+}
+
+static void fence_flush_destroy(virgl_gl_context ctx)
+{
+   fence_flush_before_destroy(ctx);
+   fence_flush.real->destroy_gl_context(ctx);
+}
+
+static void fence_flush_destroy_surfaceless(virgl_gl_context ctx)
+{
+   fence_flush_before_destroy(ctx);
+   fence_flush.real->destroy_gl_context_surfaceless(ctx);
+}
+
+static void fence_flush_init(const struct vrend_if_cbs *cbs)
+{
+   const char *on = getenv("OMACVM_VIRGL_FENCE_FLUSH");
+   const char *us = getenv("OMACVM_VIRGL_FENCE_FLUSH_US");
+   const char *stats = getenv("OMACVM_VIRGL_FENCE_FLUSH_STATS");
+   char *end = NULL;
+   unsigned long age = us ? strtoul(us, &end, 10) : 0;
+
+   memset(&fence_flush, 0, sizeof(fence_flush));
+   fence_flush.on = !(on && !strcmp(on, "0"));
+   if (!us || !*us || *end || age < 1 || age > 1000000)
+      age = 2000;
+   fence_flush.max_age_ns = (uint64_t)age * 1000;
+   fence_flush.stats_on = stats && !strcmp(stats, "1");
+   fence_flush.thread = thrd_current();
+   fence_flush.have_thread = true;
+   fence_flush.real = cbs;
+   fence_flush.cbs = *cbs;
+   fence_flush.cbs.make_current = fence_flush_make_current;
+   fence_flush.cbs.make_current_surfaceless = fence_flush_make_current_surfaceless;
+   fence_flush.cbs.destroy_gl_context = fence_flush_destroy;
+   fence_flush.cbs.destroy_gl_context_surfaceless = fence_flush_destroy_surfaceless;
+   vrend_clicbs = &fence_flush.cbs;
+   if (fence_flush.on)
+      virgl_info("fence flush: when needed (a fence waits at most %lu us)\n", age);
+   else
+      virgl_info("fence flush: every fence at once (OMACVM_VIRGL_FENCE_FLUSH=0)\n");
+}
+
+static void fence_flush_log(uint64_t now)
+{
+   if (!fence_flush.stats_on)
+      return;
+   if (!fence_flush.stats_at)
+      fence_flush.stats_at = now;
+   if (now - fence_flush.stats_at < 10000000000ull)
+      return;
+   fence_flush.stats_at = now;
+   virgl_info("fence flush: %" PRIu64 " fences, %" PRIu64 " held; flushes: %" PRIu64
+              " age, %" PRIu64 " other context, %" PRIu64 " switch, %" PRIu64
+              " destroy, %" PRIu64 " asked\n",
+              fence_flush.stats.fences, fence_flush.stats.held, fence_flush.stats.age,
+              fence_flush.stats.other_ctx, fence_flush.stats.switched,
+              fence_flush.stats.destroyed, fence_flush.stats.asked);
+}
+
+/* After glFenceSync in the current context: flush now or hold the flush. */
+static void fence_flush_after_fence(void)
+{
+   fence_flush.stats.fences++;
+   if (!fence_flush.on || !fence_flush_render_thread() || !fence_flush.cur
+#ifdef HAVE_EPOXY_EGL_H
+       || vrend_state.use_egl_fence
+#endif
+      ) {
+      glFlush();
+      return;
+   }
+   uint64_t now = fence_flush_now();
+   fence_flush_log(now);
+   if (fence_flush.gl && fence_flush.gl != fence_flush.cur) {
+      /* Made in another context than the held ones (only vrend's own context
+       * can be current with fences held elsewhere): the older first. */
+      fence_flush.stats.other_ctx++;
+      fence_flush_held(true);
+      glFlush();
+      return;
+   }
+   if (!fence_flush.gl) {
+      fence_flush.gl = fence_flush.cur;
+      fence_flush.since = now;
+   }
+   if (now - fence_flush.since >= fence_flush.max_age_ns) {
+      fence_flush.stats.age++;
+      fence_flush.gl = NULL;
+      glFlush();
+      return;
+   }
+   fence_flush.stats.held++;
+}
+
+/* Render thread: every held fence to the GPU now. */
+void vrend_renderer_flush_fences(void)
+{
+   if (!fence_flush.gl || !fence_flush_render_thread())
+      return;
+   fence_flush.stats.asked++;
+   fence_flush_held(true);
+}
+
