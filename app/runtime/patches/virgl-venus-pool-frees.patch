diff --git a/src/venus/vkr_device_object.py b/src/venus/vkr_device_object.py
index 343b9ba..4873c95 100644
--- a/src/venus/vkr_device_object.py
+++ b/src/venus/vkr_device_object.py
@@ -105,15 +105,37 @@ POOL_OBJECT_DESTROY_DRIVER_HANDLES_TEMPL = '''
 /* destroy an array of driver {vk_type}s from a pool, remove them from the
  * vkr_{pool_type}, and return the list of affected vkr_{vkr_type}s
  */
-static inline void
+static inline bool
 vkr_{destroy_func_name}_destroy_driver_handles(
-   UNUSED struct vkr_context *ctx,
+   struct vkr_context *ctx,
    struct vn_command_{destroy_cmd} *args,
    struct list_head *free_list)
 {{
    struct vkr_device *dev = vkr_device_from_handle(args->device);
    struct vn_device_proc_table *vk = &dev->proc_table;
 
+   /* OmacVM (virgl-venus-pool-frees.patch, ADR 0065): every object named is of this pool
+    * and named once, all checked before any is freed: the driver frees each one it is
+    * handed into the pool it is told (KosmicKrisp destroys a set named twice twice, and
+    * Mesa puts a command buffer of another pool into this one's free list), and the call
+    * has no answer, so a refusal ends the app's context. A stamp per call marks the named
+    * ones (no allocation); NULL handles stay allowed. */
+   static atomic_uint_fast64_t stamps;
+   const uint64_t stamp = atomic_fetch_add(&stamps, 1) + 1;
+   const struct vkr_{pool_type} *pool = vkr_{pool_type}_from_handle(args->{destroy_pool});
+   for (uint32_t i = 0; i < args->{destroy_count}; i++) {{
+      struct vkr_{vkr_type} *obj =
+         vkr_{vkr_type}_from_handle(args->{destroy_objs}[i]);
+      if (!obj)
+         continue;
+      if (obj->pool != pool || obj->free_stamp == stamp) {{
+         vkr_context_refuse(ctx, true, "{destroy_cmd}", "{vk_type} %u: %s", i,
+                            obj->pool != pool ? "of another pool" : "named twice");
+         return false;
+      }}
+      obj->free_stamp = stamp;
+   }}
+
    list_inithead(free_list);
    for (uint32_t i = 0; i < args->{destroy_count}; i++) {{
       struct vkr_{vkr_type} *obj =
@@ -129,6 +151,7 @@ vkr_{destroy_func_name}_destroy_driver_handles(
    vn_replace_{destroy_cmd}_args_handle(args);
    vk->{proc_destroy}(args->device, args->{destroy_pool},
       args->{destroy_count}, args->{destroy_objs});
+   return true;
 }}
 '''
 
@@ -241,6 +264,8 @@ void vkr_{create_func_name}_add_array(
 
       obj->base.handle.{vkr_type} = (({vk_type} *)arr->handle_storage)[i];
       obj->device = dev;
+      /* OmacVM (virgl-venus-pool-frees.patch): the pool it is freed from */
+      obj->pool = pool;
 
       /* pool objects are tracked by the pool other than the device */
       list_add(&obj->base.track_head, &pool->{vkr_type}s);
