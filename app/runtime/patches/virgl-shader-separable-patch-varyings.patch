+/* OmacVM (#589, patch_sid_width): between two separable stages on desktop GL, the patch
+ * varyings below the highest one declared that are not declared themselves */
+static void emit_patch_fill(const struct dump_ctx *ctx, struct vrend_glsl_strbufs *glsl_strbufs,
+                            uint64_t declared, enum io_type iot)
+{
+   if (ctx->cfg->use_gles || !declared ||
+       !(iot == io_in ? ctx->key->separable_in : ctx->key->separable_out))
+      return;
+   int top = 64 - __builtin_clzll(declared);
+   uint64_t fill = (top == 64 ? ~0ull : (1ull << top) - 1) & ~declared;
+   while (fill) {
+      int sid = u_bit_scan64(&fill);
+      emit_hdrf(glsl_strbufs, "patch %s vec4 patch%02d;\n", iot == io_in ? "in" : "out", sid);
+   }
+}
