+static bool
+vkr_cmd_hold(struct vkr_context *ctx,
+             struct vkr_command_buffer *cmd,
+             void *handle,
+             const char *call)
+{
+   return vkr_cmd_hold_data(ctx, cmd, handle, handle, call);
+}
+
+/* OmacVM (virgl-venus-submit-state.patch): every secondary the primary holds is still the
+ * recording it executed (not begun, reset or its pool reset since): MoltenVK encodes a
+ * secondary's content when it encodes the primary (at the submit, or at the primary's end
+ * with prefill), KosmicKrisp replays it at a reusable primary's 2nd and later submit, and
+ * vkr checked the Metal passes it opens and the pass it continues at the execute (Vulkan:
+ * such a primary is invalid). A secondary executed twice keeps its first serial. False
+ * after a refusal. */
+static bool
+vkr_cmd_secondaries_current(struct vkr_context *ctx,
+                            const struct vkr_command_buffer *cmd,
+                            const char *call)
+{
+   if (cmd->level != VK_COMMAND_BUFFER_LEVEL_PRIMARY || !cmd->held)
+      return true;
+   hash_table_foreach (cmd->held, entry) {
+      const struct vkr_object *obj = entry->key;
+      if (obj->type == VK_OBJECT_TYPE_COMMAND_BUFFER &&
+          !vkr_context_check(ctx,
+                             ((const struct vkr_command_buffer *)obj)->serial ==
+                                (uintptr_t)entry->data,
+                             call, "a secondary was recorded again after the primary executed it"))
+         return false;
+   }
+   return true;
+}
+
+bool
+vkr_command_buffer_submit_ok(struct vkr_context *ctx,
+                             VkCommandBuffer handle,
+                             const char *call,
+                             uint32_t batch,
+                             uint32_t index)
+{
+   const struct vkr_command_buffer *cmd = vkr_command_buffer_from_handle(handle);
+   const bool primary = cmd && cmd->level == VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+   if (!vkr_context_check(ctx, primary && cmd->executable, call,
+                          "batch %u: command buffer %u %s", batch, index,
+                          !cmd               ? "is none"
+                          : !primary         ? "is a secondary"
+                          : cmd->state.recording ? "still records"
+                                             : "was not ended since its begin or reset"))
+      return false;
+   return vkr_cmd_secondaries_current(ctx, cmd, call);
+}
+
 /* the driver let go of what the command buffer recorded (reset, begin, free): a zombie it
  * held last is destroyed now */
 static void
@@ -882,6 +937,9 @@ vkr_cmd_state_reset(struct vkr_command_buffer *cmd)
 {
    memset(&cmd->state, 0, sizeof(cmd->state));
    vkr_cmd_set_views(cmd, NULL, 0);
+   /* OmacVM (virgl-venus-submit-state.patch): whatever the driver's call returns */
+   cmd->serial++;
+   cmd->executable = false;
 }
 
