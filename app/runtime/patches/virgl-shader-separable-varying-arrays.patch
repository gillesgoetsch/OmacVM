+/* OmacVM (#589): a separable shader gives the generic varying of sid s the location 31 - s.
+ * An array from sid s took the locations from 31 - s up, past the last one (Apple's GL
+ * refuses that, the GPU too), and its elements never met the other stage's single varyings.
+ * On desktop GL such an array outside a block now ends at 31 - its last sid (emit_ios_generic);
+ * between two separable stages its elements are in reverse, element i is sid last - i at
+ * 31 - (last - i), where the other stage has that sid, as a single varying or in its own
+ * reversed array. Every access reverses its index (vrend_shader_write_io_as_src/dst,
+ * get_so_name), a dynamic one clamped into the array. With a whole stage next to it the
+ * program is linked as one, which matches by name: the order stays. Arrays in a block
+ * (geometry and tessellation IO without arrays of arrays) take no location: unchanged. */
+static void mark_reversed_arrays(struct dump_ctx *ctx)
+{
+   if (!ctx->separable_program || ctx->cfg->use_gles)
+      return;
+   if (ctx->key->separable_in && !prefer_generic_io_block(ctx, io_in))
+      for (uint32_t i = 0; i < ctx->num_inputs; i++)
+         ctx->inputs[i].reversed = ctx->inputs[i].name == TGSI_SEMANTIC_GENERIC &&
+                                   ctx->inputs[i].first != ctx->inputs[i].last;
+   if (ctx->key->separable_out && !prefer_generic_io_block(ctx, io_out))
+      for (uint32_t i = 0; i < ctx->num_outputs; i++)
+         ctx->outputs[i].reversed = ctx->outputs[i].name == TGSI_SEMANTIC_GENERIC &&
+                                    ctx->outputs[i].first != ctx->outputs[i].last;
+}
