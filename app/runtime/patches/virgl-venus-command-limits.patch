diff --git a/src/venus/vkr_limits.h b/src/venus/vkr_limits.h
new file mode 100644
index 0000000..acb0929
--- /dev/null
+++ b/src/venus/vkr_limits.h
@@ -0,0 +1,186 @@
+/*
+ * Copyright 2026 OmacVM contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+/* OmacVM (virgl-venus-command-limits.patch, ADR 0065 "Indices, counts and offsets"): what
+ * vkr knows of the device's limits and the helpers that bound a guest's indices, counts,
+ * offsets and enum values before the Mac's Vulkan driver uses them. KosmicKrisp is built
+ * with NDEBUG: Mesa's asserts on these are gone, so an index past a fixed array is a host
+ * memory access, and an enum value a switch does not know reaches __builtin_unreachable().
+ * Every check is spec validity (a VUID); semantic validation stays with the driver. */
+
+#ifndef VKR_LIMITS_H
+#define VKR_LIMITS_H
+
+#include "vkr_common.h"
+
+/* what the physical device reports beyond VkPhysicalDeviceLimits, read once at enumerate */
+struct vkr_limits {
+   uint32_t max_multiview_views;      /* the driver's maxMultiviewViewCount */
+   uint32_t max_push_descriptors;     /* 0 without VK_KHR_push_descriptor */
+   uint32_t max_inline_uniform_block; /* 0 without inline uniform blocks */
+   uint32_t max_xfb_buffers, max_xfb_streams;
+   VkSampleCountFlags sample_location_counts;
+   VkExtent2D max_sample_location_grid;
+   /* update-after-bind per-set limits (Vulkan 1.2), 0 when the device has none */
+   uint32_t uab_samplers, uab_uniform_buffers, uab_uniform_buffers_dynamic, uab_storage_buffers,
+      uab_storage_buffers_dynamic, uab_sampled_images, uab_storage_images, uab_input_attachments;
+   bool pipeline_statistics_query;
+   bool index_type_uint8;
+   bool advanced_blend;
+   bool ray_tracing;
+   bool transform_feedback;
+   bool primitives_generated_query;
+};
+
+/* first + count <= max, without overflow */
+static inline bool
+vkr_first_count_ok(uint32_t first, uint32_t count, uint32_t max)
+{
+   return (uint64_t)first + count <= max;
+}
+
+/* offset + size <= total, without overflow */
+static inline bool
+vkr_range_ok(uint64_t offset, uint64_t size, uint64_t total)
+{
+   return offset <= total && size <= total - offset;
+}
+
+/* a buffer range of a descriptor, a barrier or a bind: offset inside, size VK_WHOLE_SIZE
+ * or inside too */
+static inline bool
+vkr_whole_range_ok(uint64_t offset, uint64_t size, uint64_t total)
+{
+   return size == VK_WHOLE_SIZE ? offset < total : vkr_range_ok(offset, size, total);
+}
+
+/* first + (count - 1) * stride + elem <= total, count >= 1 */
+static inline bool
+vkr_strided_ok(uint64_t offset, uint32_t count, uint64_t stride, uint64_t elem, uint64_t total)
+{
+   if (!count)
+      return true;
+   const uint64_t span = (uint64_t)(count - 1) * stride; /* < 2^64: both < 2^32 */
+   return vkr_range_ok(offset, span, total) && vkr_range_ok(offset + span, elem, total);
+}
+
+static inline bool
+vkr_one_bit(uint32_t v)
+{
+   return v && !(v & (v - 1));
+}
+
+/* the enum values the drivers' switches know (KosmicKrisp's vk_to_mtl_map.c and Mesa's
+ * vk_blend.c end in UNREACHABLE for any other) */
+static inline bool
+vkr_compare_op_ok(VkCompareOp op)
+{
+   return (uint32_t)op <= VK_COMPARE_OP_ALWAYS;
+}
+
+static inline bool
+vkr_stencil_op_ok(VkStencilOp op)
+{
+   return (uint32_t)op <= VK_STENCIL_OP_DECREMENT_AND_WRAP;
+}
+
+static inline bool
+vkr_cull_mode_ok(VkCullModeFlags mode)
+{
+   return mode <= VK_CULL_MODE_FRONT_AND_BACK;
+}
+
+static inline bool
+vkr_topology_ok(VkPrimitiveTopology t)
+{
+   return (uint32_t)t <= VK_PRIMITIVE_TOPOLOGY_PATCH_LIST;
+}
+
+static inline bool
+vkr_logic_op_ok(VkLogicOp op)
+{
+   return (uint32_t)op <= VK_LOGIC_OP_SET;
+}
+
+static inline bool
+vkr_blend_factor_ok(VkBlendFactor f)
+{
+   return (uint32_t)f <= VK_BLEND_FACTOR_ONE_MINUS_SRC1_ALPHA;
+}
+
+static inline bool
+vkr_blend_op_ok(const struct vkr_limits *l, VkBlendOp op)
+{
+   return (uint32_t)op <= VK_BLEND_OP_MAX ||
+          (l->advanced_blend && op >= VK_BLEND_OP_ZERO_EXT && op <= VK_BLEND_OP_BLUE_EXT);
+}
+
+static inline bool
+vkr_blend_overlap_ok(VkBlendOverlapEXT o)
+{
+   return (uint32_t)o <= VK_BLEND_OVERLAP_CONJOINT_EXT;
+}
+
+static inline bool
+vkr_index_type_ok(const struct vkr_limits *l, VkIndexType t)
+{
+   return t == VK_INDEX_TYPE_UINT16 || t == VK_INDEX_TYPE_UINT32 ||
+          (l->index_type_uint8 && t == VK_INDEX_TYPE_UINT8);
+}
+
+static inline bool
+vkr_bind_point_ok(const struct vkr_limits *l, VkPipelineBindPoint p)
+{
+   return p == VK_PIPELINE_BIND_POINT_GRAPHICS || p == VK_PIPELINE_BIND_POINT_COMPUTE ||
+          (l->ray_tracing && p == VK_PIPELINE_BIND_POINT_RAY_TRACING_KHR);
+}
+
+/* one sample count the device renders with */
+static inline bool
+vkr_sample_count_ok(const VkPhysicalDeviceLimits *lim, VkSampleCountFlagBits s)
+{
+   const VkSampleCountFlags all =
+      lim->framebufferColorSampleCounts | lim->framebufferDepthSampleCounts |
+      lim->framebufferStencilSampleCounts | lim->framebufferNoAttachmentsSampleCounts;
+   return vkr_one_bit(s) && (s & all);
+}
+
+/* sample locations Mesa copies into a fixed array: count = grid x per pixel, inside the
+ * device's grid and sample counts */
+static inline bool
+vkr_sample_locations_ok(const struct vkr_limits *l, const VkSampleLocationsInfoEXT *info)
+{
+   if (!info)
+      return true;
+   const VkExtent2D g = info->sampleLocationGridSize;
+   return vkr_one_bit(info->sampleLocationsPerPixel) &&
+          (info->sampleLocationsPerPixel & l->sample_location_counts) &&
+          g.width <= l->max_sample_location_grid.width &&
+          g.height <= l->max_sample_location_grid.height &&
+          (uint64_t)g.width * g.height * info->sampleLocationsPerPixel ==
+             info->sampleLocationsCount;
+}
+
+/* the levels and layers a guest names exist in the image (VK_REMAINING_* resolved) */
+static inline bool
+vkr_levels_layers_ok(uint32_t mip_levels,
+                     uint32_t array_layers,
+                     uint32_t base_level,
+                     uint32_t level_count,
+                     uint32_t base_layer,
+                     uint32_t layer_count)
+{
+   if (base_level >= mip_levels || base_layer >= array_layers)
+      return false;
+   if (level_count != VK_REMAINING_MIP_LEVELS &&
+       (!level_count || !vkr_first_count_ok(base_level, level_count, mip_levels)))
+      return false;
+   if (layer_count != VK_REMAINING_ARRAY_LAYERS &&
+       (!layer_count || !vkr_first_count_ok(base_layer, layer_count, array_layers)))
+      return false;
+   return true;
+}
+
+#endif /* VKR_LIMITS_H */
