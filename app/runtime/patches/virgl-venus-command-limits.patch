+/* OmacVM (virgl-venus-command-limits.patch, ADR 0065): the guest's indices, counts,
+ * offsets and enum values in vkCmd* are bounded by the device's limits and the sizes of
+ * the objects they name before the driver records them: KosmicKrisp (built with NDEBUG)
+ * writes and reads host memory at such offsets, and Metal ends the process on level and
+ * layer ranges. A refused command ends the app's context (the guest records without
+ * waiting); the decoder stops there. */
+#define VKR_CMD_DEVICE(args) (vkr_command_buffer_from_handle((args)->commandBuffer)->device)
+#define VKR_CMD_LIMITS(args) (&VKR_CMD_DEVICE(args)->physical_device->limits)
+#define VKR_CMD_LIM(args) (&VKR_CMD_DEVICE(args)->physical_device->properties.limits)
+
+static bool
+vkr_cmd_buffer_ok(VkBuffer handle, VkDeviceSize offset, VkDeviceSize size)
+{
+   const struct vkr_buffer *buf = vkr_buffer_from_handle(handle);
+   return buf && vkr_range_ok(offset, size, buf->size);
+}
+
+static VkDeviceSize
+vkr_cmd_buffer_size(VkBuffer handle)
+{
+   const struct vkr_buffer *buf = vkr_buffer_from_handle(handle);
+   return buf ? buf->size : 0;
+}
+
+static bool
+vkr_cmd_layers_ok(VkImage handle, const VkImageSubresourceLayers *sub)
+{
+   const struct vkr_image *img = vkr_image_from_handle(handle);
+   return img && vkr_levels_layers_ok(img->mip_levels, img->array_layers, sub->mipLevel, 1,
+                                      sub->baseArrayLayer, sub->layerCount);
+}
+
+static bool
+vkr_cmd_range_ok(VkImage handle, const VkImageSubresourceRange *range)
+{
+   const struct vkr_image *img = vkr_image_from_handle(handle);
+   return img && vkr_levels_layers_ok(img->mip_levels, img->array_layers, range->baseMipLevel,
+                                      range->levelCount, range->baseArrayLayer,
+                                      range->layerCount);
+}
+
+/* barriers: images inside their levels and layers, buffers inside their size */
+static bool
+vkr_cmd_barriers_ok(struct vkr_context *ctx,
+                    const char *call,
+                    uint32_t buffer_count,
+                    const VkBufferMemoryBarrier *buffers,
+                    uint32_t image_count,
+                    const VkImageMemoryBarrier *images)
+{
+   for (uint32_t i = 0; i < buffer_count; i++) {
+      if (!vkr_context_check(ctx,
+                             vkr_whole_range_ok(buffers[i].offset, buffers[i].size,
+                                                vkr_cmd_buffer_size(buffers[i].buffer)),
+                             call, "buffer barrier %u: %" PRIu64 " bytes at %" PRIu64
+                             " of %" PRIu64, i, buffers[i].size, buffers[i].offset,
+                             vkr_cmd_buffer_size(buffers[i].buffer)))
+         return false;
+   }
+   for (uint32_t i = 0; i < image_count; i++) {
+      const VkImageSubresourceRange *r = &images[i].subresourceRange;
+      if (!vkr_context_check(ctx, vkr_cmd_range_ok(images[i].image, r), call,
+                             "image barrier %u: levels %u + %u, layers %u + %u outside the image",
+                             i, r->baseMipLevel, r->levelCount, r->baseArrayLayer,
+                             r->layerCount))
+         return false;
+   }
+   return true;
+}
+
+static bool
+vkr_cmd_dependency_ok(struct vkr_context *ctx, const char *call, const VkDependencyInfo *info)
+{
+   if (!info)
+      return true;
+   for (uint32_t i = 0; i < info->bufferMemoryBarrierCount; i++) {
+      const VkBufferMemoryBarrier2 *b = &info->pBufferMemoryBarriers[i];
+      if (!vkr_context_check(ctx,
+                             vkr_whole_range_ok(b->offset, b->size,
+                                                vkr_cmd_buffer_size(b->buffer)),
+                             call, "buffer barrier %u: %" PRIu64 " bytes at %" PRIu64
+                             " of %" PRIu64, i, b->size, b->offset,
+                             vkr_cmd_buffer_size(b->buffer)))
+         return false;
+   }
+   for (uint32_t i = 0; i < info->imageMemoryBarrierCount; i++) {
+      const VkImageSubresourceRange *r = &info->pImageMemoryBarriers[i].subresourceRange;
+      if (!vkr_context_check(ctx, vkr_cmd_range_ok(info->pImageMemoryBarriers[i].image, r),
+                             call,
+                             "image barrier %u: levels %u + %u, layers %u + %u outside the image",
+                             i, r->baseMipLevel, r->levelCount, r->baseArrayLayer,
+                             r->layerCount))
+         return false;
+   }
+   return true;
+}
+
+/* indirect commands: count records of elem bytes, stride apart, inside the buffer */
+static bool
+vkr_cmd_indirect_ok(struct vkr_context *ctx,
+                    const char *call,
+                    VkBuffer buffer,
+                    VkDeviceSize offset,
+                    uint32_t count,
+                    uint32_t max_count,
+                    uint32_t stride,
+                    uint32_t elem)
+{
+   const VkDeviceSize size = vkr_cmd_buffer_size(buffer);
+   return vkr_context_check(
+      ctx,
+      size && !(offset & 3) && count <= max_count &&
+         (count <= 1 || (!(stride & 3) && stride >= elem)) &&
+         vkr_strided_ok(offset, count, count > 1 ? stride : 0, elem, size),
+      call, "%u records of %u bytes, stride %u, at %" PRIu64 " of a %" PRIu64 "-byte buffer",
+      count, elem, stride, offset, size);
+}
+
+/* a secondary's inheritance: rendering counts inside the device's limits */
+static bool
+vkr_cmd_inheritance_ok(struct vkr_context *ctx,
+                       const struct vkr_physical_device *physical_dev,
+                       const VkCommandBufferInheritanceInfo *info)
+{
+   const VkPhysicalDeviceLimits *lim = &physical_dev->properties.limits;
+   const VkCommandBufferInheritanceRenderingInfo *rendering = vkr_find_struct(
+      info->pNext, VK_STRUCTURE_TYPE_COMMAND_BUFFER_INHERITANCE_RENDERING_INFO);
+   const VkRenderingAttachmentLocationInfo *locations =
+      vkr_find_struct(info->pNext, VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_LOCATION_INFO);
+   const VkRenderingInputAttachmentIndexInfo *inputs =
+      vkr_find_struct(info->pNext, VK_STRUCTURE_TYPE_RENDERING_INPUT_ATTACHMENT_INDEX_INFO);
+   return vkr_context_check(
+      ctx,
+      (!rendering ||
+       (rendering->colorAttachmentCount <= lim->maxColorAttachments &&
+        (!rendering->rasterizationSamples ||
+         vkr_sample_count_ok(lim, rendering->rasterizationSamples)))) &&
+         (!locations || locations->colorAttachmentCount <= lim->maxColorAttachments) &&
+         (!inputs || inputs->colorAttachmentCount <= lim->maxColorAttachments),
+      "vkBeginCommandBuffer",
+      "inheritance with %u colors (%u samples), %u locations, %u input indices (at most %u)",
+      rendering ? rendering->colorAttachmentCount : 0,
+      rendering ? rendering->rasterizationSamples : 0,
+      locations ? locations->colorAttachmentCount : 0,
+      inputs ? inputs->colorAttachmentCount : 0, lim->maxColorAttachments);
+}
+
+static bool
+vkr_cmd_equation_ok(const struct vkr_limits *l, const VkColorBlendEquationEXT *e)
+{
+   return vkr_blend_factor_ok(e->srcColorBlendFactor) &&
+          vkr_blend_factor_ok(e->dstColorBlendFactor) &&
+          vkr_blend_factor_ok(e->srcAlphaBlendFactor) &&
+          vkr_blend_factor_ok(e->dstAlphaBlendFactor) && vkr_blend_op_ok(l, e->colorBlendOp) &&
+          vkr_blend_op_ok(l, e->alphaBlendOp);
+}
