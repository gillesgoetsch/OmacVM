+/*
+ * OmacVM: a console's GL texture (QEMU's copy of its DisplaySurface) is made
+ * when it is first drawn, not at every switch. While the guest shows a GL
+ * scanout nothing draws it, and the boot logo stands in for the "display
+ * not active" placeholder; made at every switch it cost ~127 MiB of QEMU's
+ * footprint at 5K (Apple's GL keeps a second copy of a texture filled from
+ * client memory) and an upload under the BQL at every display off and on,
+ * mode change and reset. It is made whole (the surface holds the whole
+ * picture) on QEMU's thread: at the surface's first update (the firmware,
+ * the boot console: 2D), at a present that draws it, or at the refresh
+ * tick before a layer does. Readers on the AppKit thread (the CAOpenGLLayer
+ * path, other displays' layers) draw black until it is there.
+ * OMACVM_CONSOLE_TEXTURE=eager makes it at every switch, as before.
+ */
+static bool omacvm_console_tex_eager(void)
+{
+    static int eager = -1;
+
+    if (eager < 0) {
+        const char *v = getenv("OMACVM_CONSOLE_TEXTURE");
+        eager = v && !strcmp(v, "eager");
+        info_report("cocoa: console texture: %s", eager ?
+                    "made at every switch (OMACVM_CONSOLE_TEXTURE=eager)" :
+                    "made when first drawn (OMACVM_CONSOLE_TEXTURE=eager: at every switch)");
+    }
+    return eager;
+}
+
+/* BQL: does a listener draw S's texture (SCANOUT: it shows a GL scanout)? */
+static bool omacvm_console_tex_wanted(DisplaySurface *s, bool scanout)
+{
+    return s && !scanout && !omacvm_splash_wanted(NULL, s);
+}
+
+/* QEMU's thread, BQL: S's texture, made whole now if it is drawn and not there yet. */
+static bool omacvm_console_tex_ready(DisplaySurface *s, bool scanout)
+{
+    if (s && !s->texture && omacvm_console_tex_wanted(s, scanout)) {
+        CGLContextObj prev = CGLGetCurrentContext();
+        with_gl_view_ctx(^{
+            surface_gl_create_texture(dgc.gls, s);
+        });
+        CGLSetCurrentContext(prev);
+    }
+    return s && s->texture;
+}
+
+/*
+ * OmacVM tests: OMACVM_TEST_CONSOLE_CHECK=1 reads every frame drawn from the
+ * console texture (no GL scanout, not the boot logo) back at 8 x 8 points
+ * and compares them with the console surface there (either row order), so a
+ * test sees that the 2D picture shows, not only that QEMU has it. qemu.log:
+ * "cocoa: console check (PATH): ..." for the first frame, each one that
+ * differs (20 at most) and every 100th. The present's surfaces stay plain
+ * then (lossless ones cannot be read back). Off: nothing read.
+ */
+static bool omacvm_console_check_on(void)
+{
+    static int on = -1;
+
+    if (on < 0) {
+        const char *v = getenv("OMACVM_TEST_CONSOLE_CHECK");
+        on = v && !strcmp(v, "1");
+    }
+    return on;
+}
+
+/* The picture is in the current GL context's read framebuffer at VW x VH. */
+static void omacvm_console_check(const char *path, DisplaySurface *s, int vw, int vh)
+{
+    static unsigned ok, bad, blank, logged;
+    int sw, sh, content = 0, match[2] = { 0, 0 };
+
+    if (!s || surface_bits_per_pixel(s) != 32 || vw <= 0 || vh <= 0) {
+        return;
+    }
+    sw = surface_width(s);
+    sh = surface_height(s);
+    glPixelStorei(GL_PACK_ALIGNMENT, 4);
+    for (int j = 0; j < 8; j++) {
+        for (int i = 0; i < 8; i++) {
+            int sx = (2 * i + 1) * sw / 16, sy = (2 * j + 1) * sh / 16;
+            int vx = (int)((sx + 0.5) * vw / sw), vy = (int)((sy + 0.5) * vh / sh);
+            uint32_t want, got[2] = { 0, 0 };
+
+            memcpy(&want, (uint8_t *)surface_data(s) + (size_t)sy * surface_stride(s) + 4 * sx, 4);
+            want &= 0xffffff;
+            if (!want) {
+                continue;   /* black: says nothing about a missing picture */
+            }
+            content++;
+            glReadPixels(vx, vy, 1, 1, GL_BGRA, GL_UNSIGNED_INT_8_8_8_8_REV, &got[0]);
+            glReadPixels(vx, vh - 1 - vy, 1, 1, GL_BGRA, GL_UNSIGNED_INT_8_8_8_8_REV, &got[1]);
+            match[0] += (got[0] & 0xffffff) == want;
+            match[1] += (got[1] & 0xffffff) == want;
+        }
+    }
+    int m = MAX(match[0], match[1]);
+    bool differs = content && m * 4 < content * 3;
+    if (!content) {
+        blank++;
+    } else if (differs) {
+        bad++;
+    } else {
+        ok++;
+    }
+    if (ok + bad == 1 || (differs && logged < 20) || (ok + bad + blank) % 100 == 0) {
+        logged += differs;
+        info_report("cocoa: console check (%s): %ux%u drawn at %dx%d, %d of %d points with a picture as the "
+                    "surface (rows %s); so far %u as the surface, %u differ, %u blank",
+                    path, sw, sh, vw, vh, m, content, match[0] >= match[1] ? "top-down" : "bottom-up",
+                    ok, bad, blank);
+    }
+}
