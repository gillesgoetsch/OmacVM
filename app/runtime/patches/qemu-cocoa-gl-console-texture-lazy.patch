+/*
+ * OmacVM: a console's GL texture (QEMU's copy of its DisplaySurface) is made
+ * when it is first drawn, not at every switch. While the guest shows a GL
+ * scanout nothing draws it, and the boot logo stands in for the "display
+ * not active" placeholder; made at every switch it cost ~127 MiB of QEMU's
+ * footprint at 5K (Apple's GL keeps a second copy of a texture filled from
+ * client memory) and an upload under the BQL at every display off and on,
+ * mode change and reset. It is made whole (the surface holds the whole
+ * picture) on QEMU's thread: at the surface's first update (the firmware,
+ * the boot console: 2D), at a present that draws it, or at the refresh
+ * tick before a layer does. Readers on the AppKit thread (the CAOpenGLLayer
+ * path, other displays' layers) draw black until it is there.
+ * OMACVM_CONSOLE_TEXTURE=eager makes it at every switch, as before.
+ */
+static bool omacvm_console_tex_eager(void)
+{
+    static int eager = -1;
+
+    if (eager < 0) {
+        const char *v = getenv("OMACVM_CONSOLE_TEXTURE");
+        eager = v && !strcmp(v, "eager");
+        info_report("cocoa: console texture: %s", eager ?
+                    "made at every switch (OMACVM_CONSOLE_TEXTURE=eager)" :
+                    "made when first drawn (OMACVM_CONSOLE_TEXTURE=eager: at every switch)");
+    }
+    return eager;
+}
+
+/* BQL: does a listener draw S's texture (SCANOUT: it shows a GL scanout)? */
+static bool omacvm_console_tex_wanted(DisplaySurface *s, bool scanout)
+{
+    return s && !scanout && !omacvm_splash_wanted(NULL, s);
+}
+
+/* QEMU's thread, BQL: S's texture, made whole now if it is drawn and not there yet. */
+static bool omacvm_console_tex_ready(DisplaySurface *s, bool scanout)
+{
+    if (s && !s->texture && omacvm_console_tex_wanted(s, scanout)) {
+        CGLContextObj prev = CGLGetCurrentContext();
+        with_gl_view_ctx(^{
+            surface_gl_create_texture(dgc.gls, s);
+        });
+        CGLSetCurrentContext(prev);
+    }
+    return s && s->texture;
+}
