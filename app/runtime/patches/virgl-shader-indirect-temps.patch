+/* OmacVM (#589): a TEMP declaration without ARRAY that the shader still indexes at run
+ * time. The guest's Mesa sends one when it moves a clip distance output it writes in a loop
+ * into a temp (virgl_tgsi.c: DCL TEMP[18..19], then MOV TEMP[ADDR[0].x+18].x). Each such temp
+ * was a plain vec4, so "temp18[clamp(addr0 + 0, 0, 0)].x" picked a float and swizzled it:
+ * the Mac refused the shader ("Swizzle of non-vector primitive float") and a read gave one
+ * component in all four. The part of the declaration from the lowest indexed register on
+ * becomes one array (any array id > 0 makes the GLSL an array); the temps before it, and
+ * every declaration the shader never indexes, stay single vec4s as before. */
+#define INDIRECT_TEMP_ARRAY_ID 0x7fffffff
+
+static bool note_indirect_temp(struct dump_ctx *ctx, int index)
+{
+   for (uint32_t i = 0; i < ctx->num_indirect_temps; i++)
+      if (ctx->indirect_temps[i] == index)
+         return true;
+   int *n = realloc(ctx->indirect_temps, sizeof(int) * (ctx->num_indirect_temps + 1));
+   if (!n)
+      return false;
+   ctx->indirect_temps = n;
+   ctx->indirect_temps[ctx->num_indirect_temps++] = index;
    return true;
+}
+
+/* the lowest indexed register in first..last, or -1 */
+static int lowest_indirect_temp(const struct dump_ctx *ctx, int first, int last)
+{
+   int lowest = -1;
+   if (!(ctx->info.indirect_files & (1 << TGSI_FILE_TEMPORARY)))
+      return -1;
+   for (uint32_t i = 0; i < ctx->num_indirect_temps; i++) {
+      int index = ctx->indirect_temps[i];
+      if (index >= first && index <= last && (lowest < 0 || index < lowest))
+         lowest = index;
+   }
+   return lowest;
 }
 
