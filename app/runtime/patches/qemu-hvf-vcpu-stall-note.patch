diff --git a/accel/hvf/hvf-stall.c b/accel/hvf/hvf-stall.c
new file mode 100644
index 0000000..8f21fd8
--- /dev/null
+++ b/accel/hvf/hvf-stall.c
@@ -0,0 +1,176 @@
+/*
+ * OmacVM: the vCPU stall note (qemu-hvf-vcpu-stall-note.patch).
+ *
+ * When macOS runs out of free memory, a vCPU thread can stay blocked inside
+ * hv_vcpu_run on a stage-2 page fault (the Mac decompressing or swapping in
+ * guest RAM, or waiting for a free page) for seconds, while other vCPUs run
+ * on: the guest logs RCU stalls and its watchdogs fire, and nothing in
+ * qemu.log said why. A vCPU thread that is runnable but gets no Mac core
+ * looks the same to the guest.
+ *
+ * Each vCPU thread counts its hv_vcpu_run calls (odd while in the guest: one
+ * relaxed store before and one after the call). The stall watchdog's thread
+ * (util/main-loop.c) runs hvf_stall_check() each time it wakes anyway, every
+ * 2 s at most and every 250 ms while a vCPU stands: thread_info() on each vCPU
+ * thread gives its CPU time and Mach state, and include/qemu/omacvm-stall.h
+ * decides and words it. No timer of its own, nothing in the vCPU's run loop
+ * but the two stores. Nothing while the VM is not running, and nothing for a
+ * round in which the watchdog woke more than 1 s late or the Mac slept (its
+ * own delay is not the vCPUs').
+ *
+ * This work is licensed under the terms of the GNU GPL, version 2 or later.
+ */
+#include "qemu/osdep.h"
+#include "qemu/error-report.h"
+#include "qemu/omacvm-stall.h"
+#include "hw/core/cpu.h"
+#include "system/hvf.h"
+#include "system/hvf_int.h"
+#include "system/runstate.h"
+#include <mach/mach.h>
+#include <sys/sysctl.h>
+
+typedef struct HvfStallVcpu {
+    mach_port_t port;           /* 0: no thread (yet, or any more) */
+    uint64_t runs;              /* hv_vcpu_run count, odd while in the guest */
+} HvfStallVcpu;
+
+static HvfStallVcpu hvf_stall_vcpus[OMACVM_STALL_MAX_VCPUS];
+static int hvf_stall_count;     /* highest registered index + 1 */
+static OmacvmStallMonitor hvf_stall_monitor;    /* the watchdog's thread only */
+
+static mach_port_t hvf_stall_host(void)
+{
+    static mach_port_t host;
+
+    if (!host) {
+        host = mach_host_self();
+    }
+    return host;
+}
+
+static int hvf_stall_pressure(void)
+{
+    int level = 0;
+    size_t size = sizeof(level);
+
+    return sysctlbyname("kern.memorystatus_vm_pressure_level", &level, &size, NULL, 0) ?
+           0 : level;
+}
+
+/* The Mac's paging counters (one host_statistics64, one sysctl): each round. */
+static void hvf_stall_paging(OmacvmPagingLook *look, int64_t now)
+{
+    vm_statistics64_data_t vs;
+    mach_msg_type_number_t count = HOST_VM_INFO64_COUNT;
+    uint64_t page = vm_kernel_page_size;
+
+    memset(look, 0, sizeof(*look));
+    if (host_statistics64(hvf_stall_host(), HOST_VM_INFO64, (host_info64_t)&vs, &count) !=
+        KERN_SUCCESS) {
+        return;
+    }
+    look->valid = true;
+    look->at = now;
+    look->swapped = (vs.swapins + vs.swapouts) * page;
+    look->moved = (vs.compressions + vs.decompressions) * page + look->swapped;
+    look->pressure = hvf_stall_pressure();
+}
+
+static void hvf_stall_mac(OmacvmMacMemory *mac)
+{
+    vm_statistics64_data_t vs;
+    task_vm_info_data_t ti;
+    mach_msg_type_number_t count = HOST_VM_INFO64_COUNT;
+    double load[1];
+
+    memset(mac, 0, sizeof(*mac));
+    if (host_statistics64(hvf_stall_host(), HOST_VM_INFO64, (host_info64_t)&vs, &count) ==
+        KERN_SUCCESS) {
+        mac->free_mb = ((uint64_t)vs.free_count * vm_kernel_page_size) >> 20;
+    }
+    count = TASK_VM_INFO_COUNT;
+    if (task_info(mach_task_self(), TASK_VM_INFO, (task_info_t)&ti, &count) ==
+        KERN_SUCCESS) {
+        mac->vm_mb = ti.phys_footprint >> 20;
+        mac->vm_compressed_mb = ti.compressed >> 20;
+    }
+    mac->pressure = hvf_stall_pressure();
+    mac->load = getloadavg(load, 1) == 1 ? load[0] : -1;
+}
+
+/* The stall watchdog's thread: one round of vCPU samples. */
+static int64_t hvf_stall_check(int64_t now, bool late)
+{
+    OmacvmVcpuSample s[OMACVM_STALL_MAX_VCPUS];
+    OmacvmStallMonitor *m = &hvf_stall_monitor;
+    OmacvmMacMemory mac;
+    OmacvmPagingLook look;
+    int n = qatomic_read(&hvf_stall_count);
+    int64_t wait = 0;
+    char line[600];
+    int what;
+
+    if (late || !runstate_is_running()) {
+        /* start over: what the watchdog missed is not the vCPUs' */
+        omacvm_stall_reset(m);
+        return 0;
+    }
+    for (int i = 0; i < n; i++) {
+        mach_port_t port = qatomic_read(&hvf_stall_vcpus[i].port);
+        thread_basic_info_data_t bi;
+        mach_msg_type_number_t count = THREAD_BASIC_INFO_COUNT;
+
+        memset(&s[i], 0, sizeof(s[i]));
+        if (!port || thread_info(port, THREAD_BASIC_INFO, (thread_info_t)&bi, &count) !=
+            KERN_SUCCESS) {
+            continue;
+        }
+        s[i].valid = true;
+        s[i].runs = qatomic_read(&hvf_stall_vcpus[i].runs);
+        s[i].cpu_us = (uint64_t)bi.user_time.seconds * 1000000 + bi.user_time.microseconds +
+                      (uint64_t)bi.system_time.seconds * 1000000 +
+                      bi.system_time.microseconds;
+        s[i].state = bi.run_state;
+    }
+    hvf_stall_paging(&look, now);
+    what = omacvm_stall_step(m, s, n, now, &look, &wait);
+    if (what == OMACVM_STALL_NOTHING) {
+        return wait;
+    }
+    hvf_stall_mac(&mac);
+    omacvm_stall_line(m, what, &mac, line, sizeof(line));
+    warn_report("%s", line);
+    if (what == OMACVM_STALL_OVER) {
+        main_loop_stall_status_vcpus(m, &mac);
+    }
+    return wait;
+}
+
+/* The vCPU's own thread, once it has its Hypervisor vCPU. */
+void hvf_stall_vcpu_begin(CPUState *cpu)
+{
+    int i = cpu->cpu_index;
+
+    if (i < 0 || i >= OMACVM_STALL_MAX_VCPUS) {
+        cpu->accel->stall_runs = &cpu->accel->stall_runs_unwatched;
+        return;
+    }
+    cpu->accel->stall_runs = &hvf_stall_vcpus[i].runs;
+    qatomic_set(&hvf_stall_vcpus[i].runs, 0);
+    qatomic_set(&hvf_stall_vcpus[i].port, pthread_mach_thread_np(pthread_self()));
+    if (i >= qatomic_read(&hvf_stall_count)) {
+        qatomic_set(&hvf_stall_count, i + 1);
+    }
+    main_loop_stall_watchdog_hook(hvf_stall_check);
+}
+
+/* The vCPU's own thread, before it goes. */
+void hvf_stall_vcpu_end(CPUState *cpu)
+{
+    int i = cpu->cpu_index;
+
+    if (i >= 0 && i < OMACVM_STALL_MAX_VCPUS) {
+        qatomic_set(&hvf_stall_vcpus[i].port, 0);
+    }
+}
