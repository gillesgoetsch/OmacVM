+/*
+ * OmacVM: the spare surfaces volatile while the window is out of sight
+ * (ui/omacvm-present-volatile.h). QEMU thread, BQL: present_volatile_look()
+ * at every refresh tick (500 ms while out of sight) and present, and the
+ * present makes the surface it takes non-volatile first. Shown = in use
+ * (IOSurfaceIsInUse, as the present picks its next surface) or the layer's
+ * contents (present_shown, set where a frame goes on the layer).
+ * OMACVM_PRESENT_VOLATILE=0 keeps them all; so does OMACVM_PRESENT_HIDDEN,
+ * which draws out of sight. OMACVM_TEST_PRESENT_PURGE=1 (tests): every
+ * surface is emptied for real (kIOSurfacePurgeableEmpty: its picture gone,
+ * as when macOS takes its pages) before it comes back.
+ */
+static OmacvmPresentVolatile present_pv;
+static int64_t present_pv_back_ns;      /* in sight again after volatile surfaces: the first frame is timed */
+static IOSurfaceRef present_shown;      /* the layer's contents (any thread): compared, never used */
+static int present_pv_purge = -1;       /* OMACVM_TEST_PRESENT_PURGE; -1 not read yet */
+
 static void cocoa_gl_present_free(void)
 {
     for (int i = 0; i < present_nsurf; i++) {
@@ -9186,6 +9259,92 @@ static void cocoa_gl_present_free(void)
     present_w = present_h = 0;
     present_deep = false;
     present_linear = false;
+    omacvm_pv_reset(&present_pv, 0);
+}
+
+/* QEMU thread, BQL: surface I non-volatile again (taken for a frame, or in sight). */
+static void present_volatile_back(unsigned i)
+{
+    uint32_t old = kIOSurfacePurgeableNonVolatile;
+
+    if (present_pv_purge == 1) {
+        /* the test hook: macOS's purge, for real, before it comes back */
+        IOSurfaceSetPurgeable(present_surf[i], kIOSurfacePurgeableEmpty, &old);
+    }
+    kern_return_t kr = IOSurfaceSetPurgeable(present_surf[i], kIOSurfacePurgeableNonVolatile, &old);
+    bool emptied = kr != KERN_SUCCESS || old == kIOSurfacePurgeableEmpty;
+
+    if (kr != KERN_SUCCESS && !present_pv.off) {
+        present_pv.off = true;
+        warn_report("cocoa: present surfaces: one could not be made non-volatile (%d): "
+                    "drawn whole, all kept from now on", kr);
+    }
+    if (omacvm_pv_back(&present_pv, i, emptied)) {
+        omacvm_pd_all_full(&present_pd);    /* its picture is gone: whole draws next */
+    }
+}
+
+/* QEMU thread, BQL: the rule's look (refresh tick, present). */
+static void present_volatile_look(void)
+{
+    if (!present_ctx) {
+        return;     /* the CAOpenGLLayer path has no surfaces of its own */
+    }
+    if (present_pv_purge < 0) {
+        const char *e = getenv("OMACVM_PRESENT_VOLATILE");
+        const char *t = getenv("OMACVM_TEST_PRESENT_PURGE");
+        bool hidden = getenv("OMACVM_PRESENT_HIDDEN") != NULL;
+
+        present_pv_purge = t && !strcmp(t, "1");
+        present_pv.off = hidden || (e && !strcmp(e, "0"));
+        info_report("cocoa: present surfaces: %s%s",
+                    hidden ? "all kept (OMACVM_PRESENT_HIDDEN draws out of sight)" :
+                    present_pv.off ? "all kept (OMACVM_PRESENT_VOLATILE=0)" :
+                    "spare ones volatile while the window is out of sight "
+                    "(OMACVM_PRESENT_VOLATILE=0: all kept)",
+                    present_pv_purge ? "; test: each one emptied before it comes back "
+                                       "(OMACVM_TEST_PRESENT_PURGE)" : "");
+    }
+    if (!present_surf[0]) {
+        return;
+    }
+    int64_t now = qemu_clock_get_ms(QEMU_CLOCK_REALTIME);
+    bool was_away = present_pv.away;
+    omacvm_pv_sight(&present_pv, qatomic_read(&omacvm_window_seen), now);
+    if (omacvm_pv_idle(&present_pv)) {
+        return;
+    }
+    IOSurfaceRef shown = qatomic_read(&present_shown);
+    for (unsigned i = 0; i < present_nsurf; i++) {
+        bool busy = present_surf[i] == shown || IOSurfaceIsInUse(present_surf[i]);
+        int step = omacvm_pv_step(&present_pv, i, busy, now);
+        if (step > 0) {
+            uint32_t old;
+            kern_return_t kr = IOSurfaceSetPurgeable(present_surf[i], kIOSurfacePurgeableVolatile, &old);
+            omacvm_pv_made(&present_pv, i, kr == KERN_SUCCESS);
+            if (kr != KERN_SUCCESS) {
+                warn_report("cocoa: present surfaces: macOS refused a volatile one (%d): "
+                            "all kept from now on", kr);
+                for (unsigned k = 0; k < present_nsurf; k++) {
+                    if (omacvm_pv_needed(&present_pv, k)) {
+                        present_volatile_back(k);
+                    }
+                }
+                break;
+            }
+        } else if (step < 0) {
+            present_volatile_back(i);
+        }
+    }
+    if (was_away && !present_pv.away && present_pv.made) {
+        info_report("cocoa: present: in sight again: %u spare surfaces were volatile, "
+                    "%u emptied by macOS (drawn whole)", present_pv.made, present_pv.emptied);
+        present_pv.made = present_pv.emptied = 0;
+        present_pv_back_ns = qatomic_read(&omacvm_window_seen_ns);
+        if (!present_pv_back_ns) {
+            present_pv_back_ns = qemu_clock_get_ns(QEMU_CLOCK_REALTIME);
+        }
+    }
 }
 
