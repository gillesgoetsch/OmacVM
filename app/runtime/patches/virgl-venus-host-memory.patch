+/* OmacVM (virgl-venus-host-memory.patch, ADR 0065): no heap bigger than the apps' share of
+ * the GPU memory budget, which is all Venus device memory gets (MoltenVK reported all of the
+ * Mac's memory, KosmicKrisp three quarters, both more than the share) */
+static void
+vkr_memory_heaps_clamp(VkPhysicalDeviceMemoryProperties *props)
+{
+   const uint64_t apps = virgl_gpu_budget_apps_limit();
+   for (uint32_t i = 0; apps && i < props->memoryHeapCount && i < VK_MAX_MEMORY_HEAPS; i++) {
+      if (props->memoryHeaps[i].size > apps)
+         props->memoryHeaps[i].size = apps;
+   }
+}
+
+/* VK_EXT_memory_budget: this context's device memory as the usage, and as the budget that
+ * plus what the apps' share has left, at most the heap and never 0 (a page) */
+static void
+vkr_memory_budget_fill(struct vkr_context *ctx,
+                       const VkPhysicalDeviceMemoryProperties *props,
+                       VkPhysicalDeviceMemoryBudgetPropertiesEXT *budget)
+{
+   const uint64_t page = getpagesize();
+   const uint64_t apps = virgl_gpu_budget_apps_limit(), in_use = virgl_gpu_budget_in_use();
+   const uint64_t mine = atomic_load(&ctx->host.memory);
+   const uint64_t left = apps > in_use ? apps - in_use : 0;
+   for (uint32_t i = 0; apps && i < props->memoryHeapCount && i < VK_MAX_MEMORY_HEAPS; i++) {
+      const uint64_t size = props->memoryHeaps[i].size;
+      budget->heapUsage[i] = MIN2(mine, size);
+      budget->heapBudget[i] = MAX2(MIN2(mine + left, size), MIN2(page, size));
+   }
