    /* the zombie's driver object is destroyed when the last holder lets go */
    bool zombie_destroy_vk;
+
+   /* OmacVM (virgl-venus-host-memory.patch): what it holds of its context's account */
+   struct vkr_host_account *host_account;
+   uint64_t host_charge;
 };
 
