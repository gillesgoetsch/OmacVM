diff --git a/src/venus/vkr_context.c b/src/venus/vkr_context.c
index 8a278ba..afb7a24 100644
--- a/src/venus/vkr_context.c
+++ b/src/venus/vkr_context.c
@@ -613,6 +613,112 @@ vkr_context_refuse(struct vkr_context *ctx, bool fatal, const char *call, const
       vkr_context_set_fatal(ctx);
 }
 
+/* OmacVM (virgl-venus-host-memory.patch) */
+uint64_t
+vkr_host_cap(void)
+{
+   const char *env = getenv("OMACVM_VENUS_HOST_MB");
+   const unsigned long long mb = env ? strtoull(env, NULL, 0) : 0;
+   if (mb >= 1 && mb <= (1ull << 24))
+      return (uint64_t)mb << 20;
+   const uint64_t quarter = virgl_gpu_budget_apps_limit() / 4;
+   return MIN2(MAX2(quarter, (uint64_t)256 << 20), (uint64_t)4 << 30);
+}
+
+bool
+vkr_host_charge(struct vkr_context *ctx, uint64_t bytes, const char *call)
+{
+   struct vkr_host_account *acc = &ctx->host;
+   const uint64_t now = atomic_fetch_add(&acc->charged, bytes) + bytes;
+   if (unlikely(now > acc->cap)) {
+      atomic_fetch_sub(&acc->charged, bytes);
+      vkr_context_refuse(ctx, true, call,
+                         "host memory for recordings and objects at %" PRIu64
+                         " MB, past the app's %" PRIu64 " MB (OMACVM_VENUS_HOST_MB)",
+                         now >> 20, acc->cap >> 20);
+      return false;
+   }
+   if (unlikely(virgl_gpu_budget_charge(bytes, false))) {
+      atomic_fetch_sub(&acc->charged, bytes);
+      atomic_store(&ctx->budget_refused, true);
+      vkr_context_refuse(ctx, true, call,
+                         "%" PRIu64 " KB of host memory for recordings and objects: the guest "
+                         "GPU memory budget of %" PRIu64 " MB is full (%" PRIu64 " MB in use)",
+                         bytes >> 10, virgl_gpu_budget_limit() >> 20,
+                         virgl_gpu_budget_in_use() >> 20);
+      return false;
+   }
+   uint_fast64_t peak = atomic_load(&acc->peak);
+   while (now > peak && !atomic_compare_exchange_weak(&acc->peak, &peak, now))
+      ;
+   return true;
+}
+
+void
+vkr_host_uncharge(struct vkr_host_account *account, uint64_t bytes)
+{
+   virgl_gpu_budget_uncharge(bytes);
+   atomic_fetch_sub(&account->charged, bytes);
+}
+
+/* at least what one costs the Mac in the M1 probes (KosmicKrisp and MoltenVK, the larger;
+ * work/v624-hostmem/out run4: events 18366 B, command pools 142082, command buffers 34137,
+ * query pools 18976 + 12.6 MB per 2^20 timestamps, descriptor pools 9305 (49944 with 65536
+ * sets), pipelines 18384, shader modules 2383, images 1680, device memory 2089 untouched
+ * (2.4 KB past its pages written), held views with their framebuffer 13613 with the image,
+ * buffers 408, fences 331, semaphores 315, samplers 348, sets 315); 1 KB for the rest */
+static uint64_t
+vkr_object_host_cost(VkObjectType type)
+{
+   switch (type) {
+   case VK_OBJECT_TYPE_EVENT:
+   case VK_OBJECT_TYPE_QUERY_POOL:
+   case VK_OBJECT_TYPE_PIPELINE:
+   case VK_OBJECT_TYPE_PIPELINE_CACHE:
+      return 20 << 10;
+   case VK_OBJECT_TYPE_COMMAND_POOL:
+      return 160 << 10;
+   case VK_OBJECT_TYPE_COMMAND_BUFFER:
+      return 40 << 10;
+   case VK_OBJECT_TYPE_DESCRIPTOR_POOL:
+      return 12 << 10;
+   case VK_OBJECT_TYPE_SHADER_MODULE:
+   case VK_OBJECT_TYPE_DEVICE_MEMORY:
+   case VK_OBJECT_TYPE_IMAGE_VIEW:
+   case VK_OBJECT_TYPE_FRAMEBUFFER:
+   case VK_OBJECT_TYPE_RENDER_PASS:
+      return 4 << 10;
+   case VK_OBJECT_TYPE_IMAGE:
+      return 2 << 10;
+   case VK_OBJECT_TYPE_BUFFER:
+   case VK_OBJECT_TYPE_FENCE:
+   case VK_OBJECT_TYPE_SEMAPHORE:
+   case VK_OBJECT_TYPE_SAMPLER:
+   case VK_OBJECT_TYPE_DESCRIPTOR_SET:
+      return 512;
+   default:
+      return 1 << 10;
+   }
+}
+
+void
+vkr_object_charge(struct vkr_context *ctx, struct vkr_object *obj)
+{
+   obj->host_account = &ctx->host;
+   vkr_object_charge_more(ctx, obj, vkr_object_host_cost(obj->type), "an object create");
+}
+
+void
+vkr_object_charge_more(struct vkr_context *ctx,
+                       struct vkr_object *obj,
+                       uint64_t bytes,
+                       const char *call)
+{
+   /* refused: the context ends; the object stays and goes as the others do */
+   if (vkr_host_charge(ctx, bytes, call))
+      obj->host_charge += bytes;
+}
+
 bool
 vkr_context_check(struct vkr_context *ctx, bool ok, const char *call, const char *fmt, ...)
 {
@@ -851,6 +957,16 @@ vkr_context_destroy(struct vkr_context *ctx)
    mtx_destroy(&ctx->object_mutex);
    mtx_destroy(&ctx->dispatch_mutex);
 
+   /* OmacVM (virgl-venus-host-memory.patch): the peak, and nothing left charged */
