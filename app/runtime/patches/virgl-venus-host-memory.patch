+enum { VKR_CMD_COST_BASE = 512, VKR_CMD_COST_PASS = 188416 };
+enum vkr_cmd_cost_kind { VKR_COST_FILL, VKR_COST_CLEAR_ATTACHMENTS, VKR_COST_REGION, VKR_COST_KINDS };
+static const uint32_t vkr_cmd_costs_kosmickrisp[VKR_COST_KINDS] = { 3072, 3072, 40960 };
+static const uint32_t vkr_cmd_costs_moltenvk[VKR_COST_KINDS] = { 512, 512, 512 };
+/* the context's account is charged 1 MB at a time: no shared counter per command */
+#define VKR_CMD_RESERVE_CHUNK ((uint64_t)1 << 20)
+
+static bool
+vkr_cmd_reserve(struct vkr_context *ctx, struct vkr_command_buffer *cmd, const char *call)
+{
+   uint64_t need = cmd->state.cost - cmd->reserved;
+   struct vkr_command_pool *pool = cmd->pool;
+   if (pool && pool->spare) {
+      const uint64_t take = MIN2(pool->spare, need);
+      pool->spare -= take;
+      pool->base.host_charge -= take;
+      cmd->base.host_charge += take;
+      cmd->reserved += take;
+      need -= take;
+      if (!need)
+         return true;
+   }
+   const uint64_t chunk = MAX2(align64(need, VKR_CMD_RESERVE_CHUNK), VKR_CMD_RESERVE_CHUNK);
+   if (!vkr_host_charge(ctx, chunk, call))
+      return false;
+   cmd->base.host_charge += chunk;
+   cmd->reserved += chunk;
+   return true;
+}
+
+/* BYTES more for the recording: refused (the context ends) past the context's cap or the
+ * shared budget, before the driver gets the command */
+static inline bool
+vkr_cmd_cost(struct vkr_context *ctx, struct vkr_command_buffer *cmd, uint64_t bytes, const char *call)
+{
+   cmd->state.cost += bytes;
+   return likely(cmd->state.cost <= cmd->reserved) || vkr_cmd_reserve(ctx, cmd, call);
+}
+
+static inline uint64_t
+vkr_cmd_cost_of(const struct vkr_command_buffer *cmd, enum vkr_cmd_cost_kind kind)
+{
+   return cmd->device->physical_device->limits.kosmickrisp ? vkr_cmd_costs_kosmickrisp[kind]
+                                                           : vkr_cmd_costs_moltenvk[kind];
+}
+
+static bool
+vkr_cmd_extra(struct vn_dispatch_context *dispatch, VkCommandBuffer handle, uint64_t bytes,
+              const char *call)
+{
+   return vkr_cmd_cost(dispatch->data, vkr_command_buffer_from_handle(handle), bytes, call);
+}
