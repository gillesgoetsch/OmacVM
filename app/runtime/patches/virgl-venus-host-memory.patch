 };
 
+/*
+ * OmacVM (virgl-venus-host-memory.patch, ADR 0065): the Mac memory a context makes the
+ * driver hold besides device memory: objects (a fixed estimate per type, at least what the
+ * M1 probes measured) and command recordings (vkr_command_buffer.c: per command, per Metal
+ * pass). Charged to the context's cap (OMACVM_VENUS_HOST_MB, else a quarter of the apps'
+ * share, at most 4 GB) and to the shared GPU memory budget; past either the call is
+ * refused and the app's context ends (the guest made the object or recorded the command
+ * without waiting: it sees a lost device). Given back where vkr frees the object
+ * (vkr_object_free: after the driver's destroy, a zombie's too, and at the context's end).
+ */
+struct vkr_host_account {
+   atomic_uint_fast64_t charged;
+   /* the context's device memory (what vkGetPhysicalDeviceMemoryProperties2 reports as its
+    * heapUsage) */
+   atomic_uint_fast64_t memory;
+   atomic_uint_fast64_t peak;
+   uint64_t cap;
+};
+
 /* base class for all objects */
 struct vkr_object {
    VkObjectType type;
@@ -180,6 +199,10 @@ struct vkr_object {
