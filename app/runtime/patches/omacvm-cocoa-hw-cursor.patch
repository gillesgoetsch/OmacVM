     }
@@ -987,7 +1005,8 @@ - (void)updateCursorLayout
         [cursorLayer setPosition:position];
     }
 
-    [cursorLayer setHidden:!mouseOn];
+    [cursorLayer setHidden:!mouseOn ||
+                           omacvm_hwc_layer_hidden(&omacvm_hwc, isAbsoluteEnabled)];
     [CATransaction commit];
 }
 
@@ -1917,6 +1936,9 @@ - (void) handleMouseEvent:(NSEvent *)event
     if (isAbsoluteEnabled && !omacvm_test_pointer) {
         omacvm_guard_corners(event);
     }
+    if (omacvm_hwc_ours) {
+        omacvm_hwc_apply(true);
+    }
 
     with_bql(^{
         if (isAbsoluteEnabled &&
@@ -2083,6 +2105,9 @@ - (void) notifyMouseModeChange {
     }
 
     isAbsoluteEnabled = tIsAbsoluteEnabled;
+    if (omacvm_hwc.on) {
+        [self updateCursorLayout];
+    }
 
     if (isMouseGrabbed) {
         if (isAbsoluteEnabled) {
@@ -2203,6 +2228,9 @@ - (void) omacvmHeadEvent:(NSEvent *)event view:(NSView *)view output:(int)output
     if (isAbsoluteEnabled) {
         omacvm_guard_corners(event);
     }
+    if (omacvm_hwc_ours) {
+        omacvm_hwc_apply(true);
+    }
     with_bql(^{
         if (button >= 0) {
             qemu_input_queue_btn(dcl.con, button, down);
@@ -3334,14 +3362,123 @@ static void cocoa_mouse_set(DisplayChangeListener *dcl, int x, int y, bool on)
 {
     dispatch_async(dispatch_get_main_queue(), ^{
         [cocoaView setMouseX:x y:y on:on];
+        if (omacvm_hwc.on) {
+            omacvm_hwc_show(&omacvm_hwc, 0, on);
+            [cocoaView omacvmUpdateMacCursor];
+        }
     });
 }
 
+/*
+ * OmacVM: the guest's new pointer image on output o as the Mac's cursor
+ * (main thread, BQL). width: the output's width in guest pixels, view: the
+ * window that shows it (their ratio is the image's size in points). The
+ * image is copied: QEMU frees or reuses the guest's.
+ */
+static void omacvm_hwc_take(int o, QEMUCursor *c, NSView *view, int width)
+{
+    static bool warned;
+    double points = width > 0 && view ? [view bounds].size.width / width : 0;
+    OmacVMHwcImage im;
+    CFDataRef data;
+    CGDataProviderRef provider;
+    CGColorSpaceRef space;
+    CGImageRef cg;
+    NSImage *image;
+    NSCursor *cursor;
+
+    if (!c) {
+        return;
+    }
+    im = omacvm_hwc_image(c->width, c->height, c->hot_x, c->hot_y, points);
+    if (!im.ok) {
+        if (!warned) {
+            warned = true;
+            warn_report("cocoa: the guest's pointer image (%dx%d at %.2f points a pixel) "
+                        "is not used for the Mac's cursor", c->width, c->height, points);
+        }
+        return;
+    }
+    data = CFDataCreate(NULL, (const UInt8 *)c->data, (CFIndex)c->width * c->height * 4);
+    provider = CGDataProviderCreateWithCFData(data);
+    space = CGColorSpaceCreateWithName(kCGColorSpaceSRGB);
+    /* virtio-gpu's cursor is premultiplied BGRA (Xcursor themes are premultiplied). */
+    cg = CGImageCreate(c->width, c->height, 8, 32, c->width * 4, space,
+                       kCGBitmapByteOrder32Little | kCGImageAlphaPremultipliedFirst,
+                       provider, NULL, false, kCGRenderingIntentDefault);
+    CGColorSpaceRelease(space);
+    CGDataProviderRelease(provider);
+    CFRelease(data);
+    if (!cg) {
+        return;
+    }
+    image = [[NSImage alloc] initWithCGImage:cg size:NSMakeSize(im.w, im.h)];
+    CGImageRelease(cg);
+    cursor = [[NSCursor alloc] initWithImage:image hotSpot:NSMakePoint(im.hot_x, im.hot_y)];
+    [image release];
+    [omacvm_hwc_cursor release];
+    omacvm_hwc_cursor = cursor;
+    if (!omacvm_hwc.shape) {
+        info_report("cocoa: the guest's pointer is the Mac's cursor now (%dx%d, output %d)",
+                    c->width, c->height, o);
+    }
+    omacvm_hwc_define(&omacvm_hwc, o);
+    [cocoaView omacvmUpdateMacCursor];
+    [cocoaView updateCursorLayout];     /* QEMU's layer hides now */
+}
+
+/*
+ * The Mac's cursor while it carries the guest's pointer: the guest's image,
+ * or an empty one while the guest hides its pointer; the arrow again when
+ * that ends (main thread). Set again on each motion: AppKit puts its own
+ * cursor back at a window's edge. Test mode never sets the real cursor.
+ */
+static void omacvm_hwc_apply(bool active)
+{
+    static NSCursor *logged;
+    NSCursor *want = nil;
+
+    if (active) {
+        if (!omacvm_hwc_empty) {
+            NSImage *none = [[NSImage alloc] initWithSize:NSMakeSize(1, 1)];
+            omacvm_hwc_empty = [[NSCursor alloc] initWithImage:none hotSpot:NSZeroPoint];
+            [none release];
+        }
+        want = omacvm_hwc_visible(&omacvm_hwc) && omacvm_hwc_cursor ?
+               omacvm_hwc_cursor : omacvm_hwc_empty;
+    }
+    if (!want && !omacvm_hwc_ours) {
+        return;
+    }
+    if (omacvm_pointer_debug && want != logged) {
+        info_report("omacvm-pointer: Mac cursor is %s", !want ? "the arrow again" :
+                    want == omacvm_hwc_empty ? "empty (the guest hides its pointer)" :
+                    "the guest's pointer");
+        logged = want;
+    }
+    omacvm_hwc_ours = want != nil;
+    if (omacvm_test_pointer) {
+        return;     /* test: never the real cursor (the user works meanwhile) */
+    }
+    if (!want) {
+        [[NSCursor arrowCursor] set];
+    } else if ([NSCursor currentCursor] != want && omacvm_hwc_on_ours()) {
+        /* Not over another app's window (Omanotch's strip sets its own). */
+        [want set];
+    }
+}
+
 static void cocoa_cursor_define(DisplayChangeListener *dcl, QEMUCursor *cursor)
 {
+    unsigned seq = omacvm_hwc.on ? qatomic_fetch_inc(&omacvm_hwc_seq) + 1 : 0;
+
     dispatch_async(dispatch_get_main_queue(), ^{
         BQL_LOCK_GUARD();
         [cocoaView setCursor:qemu_console_get_cursor(dcl->con)];
+        if (seq && qatomic_read(&omacvm_hwc_seq) == seq) {
+            omacvm_hwc_take(0, qemu_console_get_cursor(dcl->con), cocoaView,
+                            qemu_console_get_width(dcl->con, 0));
+        }
     });
 }
 
@@ -5911,6 +6048,23 @@ static bool omacvm_pointer_over_ours(void)
     return false;
 }
 
+/* The pointer is on one of our windows with nothing above it (any app's). */
+static bool omacvm_hwc_on_ours(void)
+{
+    NSInteger n = [NSWindow windowNumberAtPoint:[NSEvent mouseLocation]
+                    belowWindowWithWindowNumber:0];
+
+    if (n == [[cocoaView window] windowNumber]) {
+        return true;
+    }
+    for (int i = 1; i < omacvm_outputs; i++) {
+        if (omacvm_heads[i].window && n == [omacvm_heads[i].window windowNumber]) {
+            return true;
+        }
+    }
+    return false;
+}
+
 static bool omacvm_main_full_screen(void)
 {
     return notchFull ||
@@ -6281,8 +6435,43 @@ static void omacvm_head_scanout_flush(DisplayChangeListener *dcl,
     cocoa_refresh_activity();
 }
 
+/* The guest's pointer on this output (hardware cursor only, see omacvm_hwc_take). */
+static void omacvm_head_mouse_set(DisplayChangeListener *dcl, int x, int y, bool on)
+{
+    int output = ((OmacVMHead *)dcl)->output;
+
+    if (!omacvm_hwc.on) {
+        return;
+    }
+    dispatch_async(dispatch_get_main_queue(), ^{
+        omacvm_hwc_show(&omacvm_hwc, output, on);
+        [cocoaView omacvmUpdateMacCursor];
+    });
+}
+
+static void omacvm_head_cursor_define(DisplayChangeListener *dcl, QEMUCursor *cursor)
+{
+    int output = ((OmacVMHead *)dcl)->output;
+    QemuConsole *con = dcl->con;
+    unsigned seq;
+
+    if (!omacvm_hwc.on) {
+        return;
+    }
+    seq = qatomic_fetch_inc(&omacvm_hwc_seq) + 1;
+    dispatch_async(dispatch_get_main_queue(), ^{
+        BQL_LOCK_GUARD();
+        if (qatomic_read(&omacvm_hwc_seq) == seq) {
+            omacvm_hwc_take(output, qemu_console_get_cursor(con),
+                            omacvm_heads[output].view, qemu_console_get_width(con, 0));
+        }
+    });
+}
+
 static const DisplayChangeListenerOps omacvm_head_gl_ops = {
     .dpy_name               = "cocoa-gl-head",
+    .dpy_mouse_set          = omacvm_head_mouse_set,
+    .dpy_cursor_define      = omacvm_head_cursor_define,
     .dpy_gfx_update         = omacvm_head_gfx_update,
     .dpy_gfx_switch         = omacvm_head_gfx_switch,
     .dpy_gfx_check_format   = console_gl_check_format,
@@ -7092,6 +7281,10 @@ static void omacvm_pointer_reset(void *opaque)
 {
     dispatch_async(dispatch_get_main_queue(), ^{
         omacvm_pointer_guest_reset(&omacvm_ptr);
+        omacvm_hwc_reset(&omacvm_hwc);
+        if (omacvm_hwc.on) {
+            [cocoaView updateCursorLayout];
+        }
         [cocoaView omacvmUpdateMacCursor];
     });
 }
@@ -7138,8 +7331,10 @@ static void omacvm_pointer_init(void)
 {
     const char *v = getenv("OMACVM_POINTER_START");
     const char *test = getenv("OMACVM_TEST_POINTER");
+    const char *hw = getenv("OMACVM_HW_CURSOR");
 
     omacvm_ptr.off = v && !strcmp(v, "0");
+    omacvm_hwc.on = hw && !strcmp(hw, "1");
     omacvm_test_pointer = test && atoi(test) > 0 && omacvm_test_mode();
     omacvm_pointer_debug = omacvm_test_pointer ||
                            (getenv("OMACVM_POINTER_DEBUG") &&
@@ -7148,6 +7343,10 @@ static void omacvm_pointer_init(void)
     info_report("cocoa: pointer: %s", omacvm_ptr.off ?
                 "taken on enter or click (OMACVM_POINTER_START=0)" :
                 "taken without a click when it is on the VM");
+    if (omacvm_hwc.on) {
+        info_report("cocoa: pointer: the Mac's cursor carries the guest's pointer once the "
+                    "guest puts it on the cursor plane (OMACVM_HW_CURSOR=1, experimental)");
+    }
     if (omacvm_test_pointer) {
         int ticks = atoi(test) * 4;
         dispatch_async(dispatch_get_main_queue(), ^{ omacvm_test_motion(0, ticks); });
