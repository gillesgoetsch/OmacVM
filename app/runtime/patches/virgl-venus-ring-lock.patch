+   vkr_locked_context = NULL;
+   mtx_unlock(&ctx->dispatch_mutex);
+   return true;
+}
+
+static inline void
+vkr_context_lock_again(struct vkr_context *ctx, bool given_up)
+{
+   if (given_up)
