+   for (uint32_t j = 0; j < arr->count; j++) {
+      const VkPipeline p = ((VkPipeline *)arr->handle_storage)[j];
+      if (p)
+         dev->proc_table.DestroyPipeline(dev->base.handle.device, p, NULL);
+   }
+   memset(out, 0, arr->count * sizeof(*out));
+   object_array_fini(arr);
+   vkr_context_refuse(ctx, true, call, "pipeline %u: its id was taken while it was made", i);
