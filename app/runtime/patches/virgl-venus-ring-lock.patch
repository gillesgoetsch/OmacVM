+/* OmacVM (virgl-venus-ring-lock.patch): the context whose dispatch lock this thread holds */
+extern _Thread_local struct vkr_context *vkr_locked_context;
+
+/* takes ctx's dispatch lock unless this thread holds it already; pass the result to
+ * vkr_context_unlock */
+static inline bool
+vkr_context_lock(struct vkr_context *ctx)
+{
+   if (vkr_locked_context == ctx)
+      return false;
+   mtx_lock(&ctx->dispatch_mutex);
+   vkr_locked_context = ctx;
+   return true;
+}
+
+static inline void
+vkr_context_unlock(struct vkr_context *ctx, bool locked)
+{
+   if (!locked)
+      return;
+   vkr_locked_context = NULL;
+   mtx_unlock(&ctx->dispatch_mutex);
