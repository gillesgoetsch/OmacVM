+/* OmacVM (virgl-venus-ring-lock.patch, ADR 0065): the objects a pipeline call names,
+ * pinned while the driver runs the call without the context's dispatch lock (vkr_context.h),
+ * so other rings go on meanwhile (Chromium's and Zink's compile threads). A destroy of a
+ * pinned object is refused (vkr_context_pinned): an app must not destroy what another
+ * thread's call uses, and a legal app never meets the refusal, because the pins go before
+ * the call's answer or ring position reaches the guest. The pins are counted under the
+ * lock; vkr reads nothing of its own while the driver runs. */
+struct vkr_pins {
+   struct vkr_object **objects;
+   uint32_t count;
+   uint32_t size;
+};
+
+static bool
+vkr_pin(struct vkr_pins *pins, const void *handle)
+{
+   struct vkr_object *obj = (struct vkr_object *)handle;
+   if (!obj)
+      return true;
+   if (pins->count == pins->size) {
+      const uint32_t size = pins->size ? 2 * pins->size : 16;
+      struct vkr_object **objects = realloc(pins->objects, sizeof(*objects) * size);
+      if (!objects)
+         return false;
+      pins->objects = objects;
+      pins->size = size;
+   }
+   obj->pins++;
+   pins->objects[pins->count++] = obj;
+   return true;
+}
+
+static void
+vkr_unpin(struct vkr_context *ctx, struct vkr_pins *pins)
+{
+   for (uint32_t i = 0; i < pins->count; i++)
+      pins->objects[i]->pins--;
+   free(pins->objects);
+   ctx->pinned_calls--;
+}
+
+/* the call's device and cache; false (refused) when out of host memory */
+static bool
+vkr_pins_begin(struct vkr_context *ctx,
+               struct vkr_pins *pins,
+               const char *call,
+               VkDevice device,
+               VkPipelineCache cache)
+{
+   *pins = (struct vkr_pins){ 0 };
+   ctx->pinned_calls++;
+   if (vkr_context_check(ctx, vkr_pin(pins, device) && vkr_pin(pins, cache), call,
+                         "out of host memory"))
+      return true;
+   vkr_unpin(ctx, pins);
+   return false;
+}
+
+/* a create info's pipeline libraries (VkPipelineLibraryCreateInfoKHR, each one chained) */
+static bool
+vkr_pin_libraries(struct vkr_pins *pins, const void *next)
+{
+   for (const VkBaseInStructure *s = next; s; s = s->pNext) {
+      if (s->sType != VK_STRUCTURE_TYPE_PIPELINE_LIBRARY_CREATE_INFO_KHR)
+         continue;
+      const VkPipelineLibraryCreateInfoKHR *lib = (const VkPipelineLibraryCreateInfoKHR *)s;
+      for (uint32_t i = 0; lib->pLibraries && i < lib->libraryCount; i++) {
+         if (!vkr_pin(pins, lib->pLibraries[i]))
+            return false;
+      }
+   }
+   return true;
+}
