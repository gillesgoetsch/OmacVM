+static bool
+vkr_pipeline_ids_free(struct vkr_context *ctx,
+                      struct vkr_device *dev,
+                      struct object_array *arr,
+                      VkPipeline *out,
+                      const char *call)
+{
+   uint32_t i = 0;
+   while (i < arr->count &&
+          !(((VkPipeline *)arr->handle_storage)[i] &&
+            vkr_context_get_object(ctx, ((struct vkr_object *)arr->objects[i])->id)))
+      i++;
