+/* the bytes a depth texel of a depth format takes in a buffer; 0 for other formats (a
+ * stencil texel always takes 1) */
+static inline uint32_t
+vkr_format_depth_copy_size(VkFormat format)
+{
+   switch (format) {
+   case VK_FORMAT_D16_UNORM: case VK_FORMAT_D16_UNORM_S8_UINT:
+      return 2;
+   case VK_FORMAT_D24_UNORM_S8_UINT: case VK_FORMAT_D32_SFLOAT:
+   case VK_FORMAT_D32_SFLOAT_S8_UINT: case VK_FORMAT_X8_D24_UNORM_PACK32:
+      return 4;
+   default:
+      return 0;
+   }
+}
