+/* OmacVM (virgl-venus-copy-regions.patch): generated by app/runtime/Tests/virgl/
+ * venus-format-extent.py from the Vulkan registry (vk.xml) and venus-protocol/vulkan_core.h.
+ * Do not edit; run the script again. */
+
+#ifndef VKR_FORMAT_EXTENT_H
+#define VKR_FORMAT_EXTENT_H
+
+#include "vkr_common.h"
+
+/* the texel block's width and height in texels (1 x 1 for most formats) */
+static inline VkExtent2D
+vkr_format_block_extent(VkFormat format)
+{
+   switch (format) {
+   case VK_FORMAT_B10X6G10X6R10X6G10X6_422_UNORM_4PACK16:
+   case VK_FORMAT_B12X4G12X4R12X4G12X4_422_UNORM_4PACK16:
+   case VK_FORMAT_B16G16R16G16_422_UNORM: case VK_FORMAT_B8G8R8G8_422_UNORM:
+   case VK_FORMAT_G10X6B10X6G10X6R10X6_422_UNORM_4PACK16:
+   case VK_FORMAT_G12X4B12X4G12X4R12X4_422_UNORM_4PACK16:
