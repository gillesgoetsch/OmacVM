 #include "vkr_pipeline.h"
@@ -74,6 +76,162 @@ vkr_cmd_range_ok(VkImage handle, const VkImageSubresourceRange *range)
                                       range->layerCount);
 }
 
+/* OmacVM (virgl-venus-copy-regions.patch): the texels a copy, blit or resolve names exist
+ * in its images, and a buffer-image copy's bytes in its buffer. Both drivers record regions
+ * outside them; the GPU would then read or write outside the resource (not run: it needs a
+ * submit, and a GPU fault once ended in a macOS panic). The aspect is one the image's format
+ * has (a plane of a multi-planar format, depth and/or stencil of a depth/stencil format, else
+ * color); offsets and extents are in that aspect's texels, whole texel blocks for block
+ * formats (VUIDs of VkImageCopy, VkImageBlit, VkImageResolve and VkBufferImageCopy). */
+struct vkr_cmd_aspect {
+   VkFormat format; /* a plane's format, else the image's */
+   uint32_t width_div;
+   uint32_t height_div;
+   uint32_t copy_size; /* the bytes of a texel block in a buffer */
+};
+
+static bool
+vkr_cmd_aspect(const struct vkr_image *img, VkImageAspectFlags aspect, bool one, struct vkr_cmd_aspect *a)
+{
+   a->format = img->format;
+   a->width_div = a->height_div = 1;
+   if (vkr_format_plane_count(img->format) > 1) {
+      const uint32_t plane = aspect == VK_IMAGE_ASPECT_PLANE_0_BIT   ? 0
+                             : aspect == VK_IMAGE_ASPECT_PLANE_1_BIT ? 1
+                             : aspect == VK_IMAGE_ASPECT_PLANE_2_BIT ? 2
+                                                                     : UINT32_MAX;
+      a->format = vkr_format_plane(img->format, plane, &a->width_div, &a->height_div);
+      a->copy_size = vkr_format_block_size(a->format);
+      return a->format != VK_FORMAT_UNDEFINED && a->copy_size;
+   }
+   const VkImageAspectFlags has = vkr_format_aspects(img->format);
+   if (!aspect || (aspect & ~has) || (one && !vkr_one_bit(aspect)))
+      return false;
+   a->copy_size = has == VK_IMAGE_ASPECT_COLOR_BIT          ? vkr_format_block_size(img->format)
+                  : aspect == VK_IMAGE_ASPECT_DEPTH_BIT     ? vkr_format_depth_copy_size(img->format)
+                  : aspect == VK_IMAGE_ASPECT_STENCIL_BIT   ? 1
+                                                            : 0;
+   return one ? a->copy_size != 0 : vkr_format_block_size(img->format) != 0;
+}
+
+/* offset + extent inside the level (a plane's share of it; block formats in whole blocks) */
+static bool
+vkr_cmd_region_ok(const struct vkr_image *img,
+                  const struct vkr_cmd_aspect *a,
+                  uint32_t level,
+                  VkOffset3D offset,
+                  uint64_t width,
+                  uint64_t height,
+                  uint64_t depth)
+{
+   if (level >= img->mip_levels || offset.x < 0 || offset.y < 0 || offset.z < 0)
+      return false;
+   const VkExtent2D b = vkr_format_block_extent(a->format);
+   const uint64_t w = MAX2(MAX2(img->extent.width >> level, 1u) / a->width_div, 1u);
+   const uint64_t h = MAX2(MAX2(img->extent.height >> level, 1u) / a->height_div, 1u);
+   const uint64_t d = MAX2(img->extent.depth >> level, 1u);
+   return (uint64_t)offset.x + width <= DIV_ROUND_UP(w, b.width) * b.width &&
+          (uint64_t)offset.y + height <= DIV_ROUND_UP(h, b.height) * b.height &&
+          (uint64_t)offset.z + depth <= d;
+}
+
+/* an image-to-image copy or resolve region */
+static bool
+vkr_cmd_image_copy_ok(VkImage src_image,
+                      const VkImageSubresourceLayers *src_sub,
+                      VkOffset3D src_offset,
+                      VkImage dst_image,
+                      const VkImageSubresourceLayers *dst_sub,
+                      VkOffset3D dst_offset,
+                      VkExtent3D extent)
+{
+   const struct vkr_image *s = vkr_image_from_handle(src_image), *d = vkr_image_from_handle(dst_image);
+   struct vkr_cmd_aspect sa, da;
+   if (!s || !d || !extent.width || !extent.height || !extent.depth ||
+       !vkr_cmd_aspect(s, src_sub->aspectMask, false, &sa) ||
+       !vkr_cmd_aspect(d, dst_sub->aspectMask, false, &da))
+      return false;
+   /* between a 3D image and a 2D array the 2D side's slices are its layers */
+   uint64_t src_depth = extent.depth, dst_depth = extent.depth;
+   if ((s->type == VK_IMAGE_TYPE_3D) != (d->type == VK_IMAGE_TYPE_3D)) {
+      if (s->type != VK_IMAGE_TYPE_3D)
+         src_depth = 1;
+      else
+         dst_depth = 1;
+   }
+   /* between formats of other block extents the extent is in the source's texels, one block
+    * of the source per block of the destination */
+   const VkExtent2D sb = vkr_format_block_extent(sa.format), db = vkr_format_block_extent(da.format);
+   const uint64_t dst_width = DIV_ROUND_UP((uint64_t)extent.width, sb.width) * db.width;
+   const uint64_t dst_height = DIV_ROUND_UP((uint64_t)extent.height, sb.height) * db.height;
+   return vkr_cmd_region_ok(s, &sa, src_sub->mipLevel, src_offset, extent.width, extent.height, src_depth) &&
+          vkr_cmd_region_ok(d, &da, dst_sub->mipLevel, dst_offset, dst_width, dst_height, dst_depth);
+}
+
+/* a blit region: its four corners inside the levels */
+static bool
+vkr_cmd_blit_ok(VkImage src_image,
+                const VkImageSubresourceLayers *src_sub,
+                const VkOffset3D src_offsets[2],
+                VkImage dst_image,
+                const VkImageSubresourceLayers *dst_sub,
+                const VkOffset3D dst_offsets[2])
+{
+   const struct vkr_image *s = vkr_image_from_handle(src_image), *d = vkr_image_from_handle(dst_image);
+   struct vkr_cmd_aspect sa, da;
+   return s && d && vkr_cmd_aspect(s, src_sub->aspectMask, false, &sa) &&
+          vkr_cmd_aspect(d, dst_sub->aspectMask, false, &da) &&
+          vkr_cmd_region_ok(s, &sa, src_sub->mipLevel, src_offsets[0], 0, 0, 0) &&
+          vkr_cmd_region_ok(s, &sa, src_sub->mipLevel, src_offsets[1], 0, 0, 0) &&
+          vkr_cmd_region_ok(d, &da, dst_sub->mipLevel, dst_offsets[0], 0, 0, 0) &&
+          vkr_cmd_region_ok(d, &da, dst_sub->mipLevel, dst_offsets[1], 0, 0, 0);
+}
+
+/* a buffer-image copy: the image region, and the buffer bytes from the offset to the end of
+ * the last texel block (row length and image height in texels, 0 for tightly packed) */
+static bool
+vkr_cmd_buffer_image_ok(VkBuffer buffer, VkImage image, const VkBufferImageCopy2 *r)
+{
+   const struct vkr_image *img = vkr_image_from_handle(image);
+   const VkExtent3D e = r->imageExtent;
+   struct vkr_cmd_aspect a;
+   if (!img || !e.width || !e.height || !e.depth ||
+       !vkr_cmd_aspect(img, r->imageSubresource.aspectMask, true, &a) ||
+       !vkr_cmd_region_ok(img, &a, r->imageSubresource.mipLevel, r->imageOffset, e.width, e.height,
+                          e.depth) ||
+       (r->bufferRowLength && r->bufferRowLength < e.width) ||
+       (r->bufferImageHeight && r->bufferImageHeight < e.height))
+      return false;
+   const VkExtent2D b = vkr_format_block_extent(a.format);
+   const uint64_t row = DIV_ROUND_UP((uint64_t)(r->bufferRowLength ? r->bufferRowLength : e.width), b.width);
+   const uint64_t rows =
+      DIV_ROUND_UP((uint64_t)(r->bufferImageHeight ? r->bufferImageHeight : e.height), b.height);
+   const uint64_t layers = r->imageSubresource.layerCount == VK_REMAINING_ARRAY_LAYERS
+                              ? img->array_layers - r->imageSubresource.baseArrayLayer
+                              : r->imageSubresource.layerCount;
+   /* slices < 2^64 (depth and layers inside the image); the rest overflow-checked, a
+    * guest's row length and image height reach 2^32 each */
+   const uint64_t slices = (uint64_t)e.depth * layers;
+   uint64_t bytes;
+   if (__builtin_mul_overflow(slices - 1, rows, &bytes) || __builtin_mul_overflow(bytes, row, &bytes) ||
+       __builtin_add_overflow(bytes, (DIV_ROUND_UP((uint64_t)e.height, b.height) - 1) * row, &bytes) ||
+       __builtin_add_overflow(bytes, DIV_ROUND_UP((uint64_t)e.width, b.width), &bytes) ||
+       __builtin_mul_overflow(bytes, (uint64_t)a.copy_size, &bytes))
+      return false;
+   return vkr_range_ok(r->bufferOffset, bytes, vkr_cmd_buffer_size(buffer));
+}
+
+static VkBufferImageCopy2
+vkr_cmd_region2(const VkBufferImageCopy *r)
+{
+   return (VkBufferImageCopy2){ .bufferOffset = r->bufferOffset,
+                                .bufferRowLength = r->bufferRowLength,
+                                .bufferImageHeight = r->bufferImageHeight,
+                                .imageSubresource = r->imageSubresource,
+                                .imageOffset = r->imageOffset,
+                                .imageExtent = r->imageExtent };
+}
