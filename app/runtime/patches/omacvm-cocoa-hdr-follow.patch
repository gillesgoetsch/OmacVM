+/*
+ * OmacVM, HDR only in full screen (ADR 0074, ui/omacvm-hdr-follow.h).
+ * Threads: omacvm_hf_switch is the main thread's (the app's key, read and
+ * watched there); QEMU's thread publishes the surfaces' state after each
+ * frame's alloc (qatomic) and the main thread reads it for the headroom
+ * it tells the guest (omacvm_hf_hold is the main thread's only).
+ */
+static int omacvm_hf_switch = -1;       /* main thread: -1 not read, 0 off, 1 on */
+static int omacvm_hf_pq;                /* qatomic: the surfaces show PQ now */
+static int64_t omacvm_hf_pq_ns;         /* qatomic: since when (REALTIME ns) */
+static unsigned omacvm_hf_flips;        /* qatomic: SDR <-> PQ changes since the last minute line */
 static uint64_t present_cap;           /* largest display: w << 32 | h */
 
 /*
@@ -10141,6 +10152,20 @@
         dispatch_async(dispatch_get_main_queue(), ^{
             omacvm_bright_look();
         });
+    }
+    /*
+     * OmacVM, HDR only in full screen: whether the surfaces show PQ now, and
+     * since when (the main thread's headroom rule, omacvm_hf_guest_edr), and
+     * how often that changed (its minute line).
