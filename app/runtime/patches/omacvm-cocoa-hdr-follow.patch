+/*
+ * OmacVM, HDR only in full screen (experimental, ADR 0074): the app's
+ * defaults key hdrFullScreenOnly (QEMU runs as the app), watched with KVO,
+ * so a running VM follows it at once; OMACVM_HDR_FULL_SCREEN_ONLY=1 for a
+ * QEMU not started as the app. Only with HDR at this start. On, the main
+ * output's layout entry carries "hdr_follow": true and the guest's display
+ * agent runs that output in SDR while no window there is in full screen;
+ * off, the layout is as before and the guest goes back to PQ. Main thread.
+ */
+@interface OmacVMHfWatch : NSObject
+@end
+
+static void omacvm_hf_read(void)
+{
+    int on;
+
+    if (!cocoa_gl_present_hdr_wanted()) {
+        return;
+    }
+    if (omacvm_bright_as_app()) {
+        CFPreferencesAppSynchronize((CFStringRef)[[NSBundle mainBundle] bundleIdentifier]);
+        on = [[NSUserDefaults standardUserDefaults] boolForKey:@"hdrFullScreenOnly"];
+    } else {
+        const char *e = getenv("OMACVM_HDR_FULL_SCREEN_ONLY");
+        on = e && !strcmp(e, "1");
+    }
+    if (on == omacvm_hf_switch) {
+        return;
+    }
+    if (on || omacvm_hf_switch == 1) {
+        info_report("cocoa: HDR in full screen only: %s", on ?
+                    "on (the VM's main display runs SDR until a window there is in full screen)" :
+                    "off (HDR as before)");
+    }
+    omacvm_hf_switch = on;
+    omacvm_send_layout();
+}
+
+@implementation OmacVMHfWatch
+/* Any thread: the app's switch changed (this process or another). */
+- (void)observeValueForKeyPath:(NSString *)keyPath ofObject:(id)object
+                        change:(NSDictionary *)change context:(void *)context
+{
+    dispatch_async(dispatch_get_main_queue(), ^{
+        omacvm_hf_read();
+    });
+}
+@end
+
+/* Main thread, at the guest's hello: the switch read, and watched from then on. */
+static void omacvm_hf_init(void)
+{
+    static OmacVMHfWatch *watch;
+
+    if (!watch && omacvm_bright_as_app() && cocoa_gl_present_hdr_wanted()) {
+        watch = [[OmacVMHfWatch alloc] init];
+        [[NSUserDefaults standardUserDefaults] addObserver:watch
+                                                forKeyPath:@"hdrFullScreenOnly"
+                                                   options:0
+                                                   context:NULL];
+    }
+    omacvm_hf_read();
+}
+
 /* Main thread, once the GL present is chosen. */
 static void omacvm_bright_init(void)
 {
