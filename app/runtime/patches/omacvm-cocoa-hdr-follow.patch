@@ -13325,7 +13350,26 @@
  */
 static double omacvm_edr_sent = -1;
 static dispatch_source_t omacvm_edr_timer;
+
+/*
+ * OmacVM, HDR only in full screen: with the switch on, the headroom while
+ * the frames are 8-bit is what the display had while PQ showed (else its
+ * most), and after they turn PQ not less until macOS's ramp is done
+ * (omacvm_hf_edr). Off: the current headroom, as before. Main thread.
+ */
+static OmacvmHfEdr omacvm_hf_hold = { .held = -1 };
 
+static double omacvm_hf_guest_edr(uint32_t display, double current, double potential,
+                                  bool use_potential)
+{
+    if (omacvm_hf_switch != 1) {
+        return omacvm_edr_value(current, potential, use_potential);
+    }
+    return omacvm_hf_edr(&omacvm_hf_hold, display, current, potential, use_potential,
+                         !qatomic_read(&omacvm_hf_pq), qatomic_read(&omacvm_hf_pq_ns),
+                         qemu_clock_get_ns(QEMU_CLOCK_REALTIME));
+}
