     dispatch_source_set_timer(omacvm_edr_timer, dispatch_time(DISPATCH_TIME_NOW, NSEC_PER_SEC),
                               NSEC_PER_SEC, NSEC_PER_SEC / 2);
     dispatch_source_set_event_handler(omacvm_edr_timer, ^{
+        static unsigned ticks;
