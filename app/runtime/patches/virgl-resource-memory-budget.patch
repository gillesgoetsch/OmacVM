+/*
+ * OmacVM: a memory budget for guest resources. Without it a guest can make
+ * textures and buffers until the Mac runs out of memory (QEMU's max_hostmem only
+ * covers 2D resources without virgl). Each resource is charged its estimated size
+ * (every level, layer and sample; at least one 4 KiB page, so many tiny resources
+ * count too) when it is made and gets it back when it is freed. A resource that
+ * would take the total past the budget is refused like a failed allocation.
+ * OMACVM_GPU_MEMORY_MB sets the budget, 0 turns it off; the default is a quarter
+ * of the Mac's memory (16 GB on a 64 GB Mac, 2 GB on an 8 GB one). Screens and
+ * cursors may go up to VREND_RESOURCE_DISPLAY_RESERVE past it, so one app that
+ * fills the budget does not also stop the desktop's next screen or cursor.
+ */
+#define VREND_RESOURCE_MIN_CHARGE 4096u
+#define VREND_RESOURCE_DISPLAY_RESERVE (256ull << 20)
+#define VREND_RESOURCE_DISPLAY_BINDS    (VIRGL_BIND_SCANOUT | VIRGL_BIND_DISPLAY_TARGET | VIRGL_BIND_CURSOR)
+
+static uint64_t budget_mul(uint64_t a, uint64_t b)
+{
+   return b && a > UINT64_MAX / b ? UINT64_MAX : a * b;
+}
+
+static uint64_t budget_add(uint64_t a, uint64_t b)
+{
+   return a > UINT64_MAX - b ? UINT64_MAX : a + b;
+}
+
+static uint64_t
+vrend_resource_estimated_size(const struct vrend_renderer_resource_create_args *args)
+{
+   uint64_t total = 0;
+
+   if (args->target == PIPE_BUFFER) {
+      /* staging buffers live in guest memory only */
+      if (args->bind != VIRGL_BIND_STAGING)
+         total = args->width;
+   } else {
+      enum pipe_format format = (enum pipe_format)args->format;
+      unsigned blocksize = util_format_get_blocksize(format);
+      uint64_t layers = args->target == PIPE_TEXTURE_3D ? 1 : MAX2(args->array_size, 1);
+
+      if (!blocksize)
+         blocksize = 16;
+      /* Apple's GL stores 3-component formats (RGB8, RGB16F, RGB32F) as 4 */
+      if (util_format_get_nr_components(format) == 3 && util_format_get_blockwidth(format) == 1 &&
+          blocksize % 3 == 0)
+         blocksize = blocksize / 3 * 4;
+      for (uint32_t l = 0; l <= args->last_level && l < 32; l++) {
+         uint64_t depth = args->target == PIPE_TEXTURE_3D ? u_minify(args->depth, l) : 1;
+         uint64_t level = budget_mul(util_format_get_nblocksx(format, u_minify(args->width, l)),
+                                     util_format_get_nblocksy(format, u_minify(args->height, l)));
+         level = budget_mul(budget_mul(budget_mul(level, blocksize), depth), layers);
+         total = budget_add(total, level);
+      }
+      total = budget_mul(total, MAX2(args->nr_samples, 1));
+   }
+   return MAX2(total, VREND_RESOURCE_MIN_CHARGE);
+}
+
+static void vrend_resource_budget_init(void)
+{
+   const char *env = getenv("OMACVM_GPU_MEMORY_MB");
+   long pages = sysconf(_SC_PHYS_PAGES), page_size = sysconf(_SC_PAGESIZE);
+   uint64_t budget = pages > 0 && page_size > 0 ? (uint64_t)pages * (uint64_t)page_size / 4 : 0;
+   const char *from = "a quarter of the Mac's memory";
+
+   if (env && *env) {
+      char *end = NULL;
+      unsigned long long mb = strtoull(env, &end, 10);
+      if (end && !*end && mb <= UINT64_MAX >> 20) {
+         budget = (uint64_t)mb << 20;
+         from = "OMACVM_GPU_MEMORY_MB";
+      } else {
+         virgl_warn("OMACVM_GPU_MEMORY_MB=%s is not a number of MB; using the default\n", env);
+      }
+   }
+   vrend_state.resource_budget = budget;
+   vrend_state.resource_bytes = 0;
+   vrend_state.resource_refusals = 0;
+   if (budget)
+      virgl_info("guest GPU memory budget: %llu MB (%s)\n",
+                 (unsigned long long)(budget >> 20), from);
+   else
+      virgl_info("guest GPU memory budget: none (%s)\n", from);
+}
+
+static bool vrend_resource_charge(struct vrend_resource *gr,
+                                  const struct vrend_renderer_resource_create_args *args)
+{
+   uint64_t size = vrend_resource_estimated_size(args);
+   uint64_t budget = vrend_state.resource_budget;
+   uint64_t limit = budget;
+
+   if (budget && (args->bind & VREND_RESOURCE_DISPLAY_BINDS))
+      limit = budget_add(budget, VREND_RESOURCE_DISPLAY_RESERVE);
+   if (budget && (size > limit || vrend_state.resource_bytes > limit - size)) {
+      /* logged at the 1st, 2nd, 4th, 8th ... refusal: a guest in a loop cannot flood the log */
+      uint64_t n = ++vrend_state.resource_refusals;
+      if (!(n & (n - 1)))
+         virgl_warn("guest GPU memory budget of %llu MB reached: refused a %ux%ux%u resource "
+                    "of %llu KB with %llu MB in use (%llu refused so far)\n",
+                    (unsigned long long)(budget >> 20), args->width, args->height,
+                    MAX2(args->depth, args->array_size), (unsigned long long)(size >> 10),
+                    (unsigned long long)(vrend_state.resource_bytes >> 20),
+                    (unsigned long long)n);
+      return false;
+   }
+   gr->budget_bytes = size;
+   vrend_state.resource_bytes += size;
+   return true;
+}
+
+static void vrend_resource_uncharge(struct vrend_resource *gr)
+{
+   vrend_state.resource_bytes -= MIN2(gr->budget_bytes, vrend_state.resource_bytes);
+   gr->budget_bytes = 0;
 }
 
