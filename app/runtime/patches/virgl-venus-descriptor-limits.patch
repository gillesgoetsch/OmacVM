+        db->type != VK_DESCRIPTOR_TYPE_MUTABLE_EXT) ||
+       !vkr_set_elements_ok(src->layout, si, src->variable_count, c->srcArrayElement,
+                            c->descriptorCount) ||
+       !vkr_set_elements_ok(dst->layout, di, dst->variable_count, c->dstArrayElement,
+                            c->descriptorCount)) {
+      snprintf(why, why_size, "binding %u elements %u + %u to binding %u elements %u + %u",
+               c->srcBinding, c->srcArrayElement, c->descriptorCount, c->dstBinding,
+               c->dstArrayElement, c->descriptorCount);
+      return false;
+   }
+   return true;
+}
 
