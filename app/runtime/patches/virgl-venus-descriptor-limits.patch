@@ -6,6 +6,8 @@
 #include "vkr_pipeline.h"
 
 #include "vkr_pipeline_gen.h"
+#include "vkr_descriptor_set.h"
+#include "vkr_physical_device.h"
 
 static void
 vkr_dispatch_vkCreateShaderModule(struct vn_dispatch_context *dispatch,
@@ -55,7 +57,84 @@ static void
 vkr_dispatch_vkCreatePipelineLayout(struct vn_dispatch_context *dispatch,
                                     struct vn_command_vkCreatePipelineLayout *args)
 {
-   vkr_pipeline_layout_create_and_add(dispatch->data, args);
+   /* OmacVM (virgl-venus-descriptor-limits.patch): Mesa's vk_pipeline_layout copies the
+    * set layouts into an array of 32 and the push constant ranges into one of 14;
+    * KosmicKrisp binds dynamic buffers into 64 slots from a uint8 offset */
+   struct vkr_context *ctx = dispatch->data;
+   struct vkr_device *dev = vkr_device_from_handle(args->device);
+   const VkPhysicalDeviceLimits *lim = &dev->physical_device->properties.limits;
+   const struct vkr_limits *l = &dev->physical_device->limits;
+   const VkPipelineLayoutCreateInfo *info = args->pCreateInfo;
+   if (!vkr_context_check(ctx, info->setLayoutCount <= lim->maxBoundDescriptorSets,
+                          "vkCreatePipelineLayout", "%u set layouts (at most %u)",
+                          info->setLayoutCount, lim->maxBoundDescriptorSets))
+      return;
+   /* push constant ranges: inside the limit, of the stages the device has (or
+    * VK_SHADER_STAGE_ALL), none twice: at most one range per stage */
+   VkShaderStageFlags stages = VK_SHADER_STAGE_ALL_GRAPHICS | VK_SHADER_STAGE_COMPUTE_BIT;
+   if (l->ray_tracing)
+      stages |= VK_SHADER_STAGE_RAYGEN_BIT_KHR | VK_SHADER_STAGE_ANY_HIT_BIT_KHR |
+                VK_SHADER_STAGE_CLOSEST_HIT_BIT_KHR | VK_SHADER_STAGE_MISS_BIT_KHR |
+                VK_SHADER_STAGE_INTERSECTION_BIT_KHR | VK_SHADER_STAGE_CALLABLE_BIT_KHR;
+   VkShaderStageFlags seen = 0;
+   for (uint32_t i = 0; i < info->pushConstantRangeCount; i++) {
+      const VkPushConstantRange *r = &info->pPushConstantRanges[i];
+      const VkShaderStageFlags flags =
+         r->stageFlags == VK_SHADER_STAGE_ALL ? stages : r->stageFlags;
+      if (!vkr_context_check(ctx,
+                             flags && !(flags & ~stages) && !(flags & seen) &&
+                                r->size && !(r->offset & 3) && !(r->size & 3) &&
+                                vkr_first_count_ok(r->offset, r->size, lim->maxPushConstantsSize),
+                             "vkCreatePipelineLayout",
+                             "push constant range %u: stages 0x%x, %u bytes at %u (at most %u)", i,
+                             r->stageFlags, r->size, r->offset, lim->maxPushConstantsSize))
+         return;
+      seen |= flags;
+   }
+   struct vkr_set_layout **sets = calloc(info->setLayoutCount ? info->setLayoutCount : 1,
+                                         sizeof(*sets));
+   if (!sets) {
+      args->ret = VK_ERROR_OUT_OF_HOST_MEMORY;
+      return;
+   }
+   uint32_t ubo_dynamic = 0, ssbo_dynamic = 0;
+   for (uint32_t i = 0; i < info->setLayoutCount; i++) {
+      const struct vkr_descriptor_set_layout *set =
+         vkr_descriptor_set_layout_from_handle(info->pSetLayouts[i]);
+      sets[i] = set ? set->info : NULL;
+      if (!vkr_context_check(ctx, sets[i], "vkCreatePipelineLayout", "set layout %u is NULL", i)) {
+         free(sets);
+         return;
+      }
+      for (uint32_t b = 0; b < sets[i]->binding_count; b++) {
+         if (sets[i]->bindings[b].type == VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER_DYNAMIC)
+            ubo_dynamic += sets[i]->bindings[b].count;
+         else if (sets[i]->bindings[b].type == VK_DESCRIPTOR_TYPE_STORAGE_BUFFER_DYNAMIC)
+            ssbo_dynamic += sets[i]->bindings[b].count;
+      }
+   }
+   const uint32_t ubo_max = MAX2(lim->maxDescriptorSetUniformBuffersDynamic,
+                                 l->uab_uniform_buffers_dynamic);
+   const uint32_t ssbo_max = MAX2(lim->maxDescriptorSetStorageBuffersDynamic,
+                                  l->uab_storage_buffers_dynamic);
+   if (!vkr_context_check(ctx, ubo_dynamic <= ubo_max && ssbo_dynamic <= ssbo_max,
+                          "vkCreatePipelineLayout",
+                          "%u + %u dynamic buffers (at most %u + %u)", ubo_dynamic,
+                          ssbo_dynamic, ubo_max, ssbo_max)) {
+      free(sets);
+      return;
+   }
+   const uint32_t set_count = info->setLayoutCount;
+
+   struct vkr_pipeline_layout *layout = vkr_pipeline_layout_create_and_add(ctx, args);
+   if (!layout) {
+      free(sets);
+      return;
+   }
+   for (uint32_t i = 0; i < set_count; i++)
+      vkr_set_layout_ref(sets[i]);
+   layout->sets = sets;
+   layout->set_count = set_count;
 }
 
