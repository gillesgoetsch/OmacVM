+      const struct vkr_set_layout *want = layout->sets[first + i];
+      if (!vkr_context_check(ctx, set && set->layout && set->layout->dynamic_count == want->dynamic_count,
+                             call, "set %u: %s", first + i,
+                             set ? "dynamic buffers unlike the pipeline layout's" : "NULL"))
+         return false;
+      dynamic += want->dynamic_count;
+   }
+   return vkr_context_check(ctx, offset_count == dynamic, call,
+                            "%u dynamic offsets for %u dynamic buffers", offset_count, dynamic);
