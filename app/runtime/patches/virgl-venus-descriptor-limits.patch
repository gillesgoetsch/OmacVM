diff --git a/src/venus/vkr_descriptor_set.c b/src/venus/vkr_descriptor_set.c
index 5ec209f..0c3215d 100644
--- a/src/venus/vkr_descriptor_set.c
+++ b/src/venus/vkr_descriptor_set.c
@@ -6,6 +6,690 @@
 #include "vkr_descriptor_set.h"
 
 #include "vkr_descriptor_set_gen.h"
+#include "vkr_buffer.h"
+#include "vkr_image.h"
+#include "vkr_physical_device.h"
+#include "vkr_pipeline.h"
+
+/* OmacVM (virgl-venus-descriptor-limits.patch, ADR 0065): descriptor set layouts, pools,
+ * sets and writes stay inside what the driver sizes. KosmicKrisp sizes a layout's binding
+ * array by the largest binding number + 1 (uint32: 0xffffffff wraps to 0), counts dynamic
+ * buffers in a uint8 into a bitset of 64, sizes sets and pools in 32-bit arithmetic, and
+ * writes each descriptor at the binding's offset + element * stride into the set's
+ * memory, with its asserts compiled out: a guest number there is a host address. */
+
+/* the largest binding number + 1, the most descriptors (bytes of inline uniform blocks)
+ * in one layout, pool size or variable count: KosmicKrisp's 64-byte descriptors times this
+ * stay far below 2^32 */
+#define VKR_MAX_BINDINGS (1u << 16)
+#define VKR_MAX_DESCRIPTORS (1u << 24)
+
+struct vkr_set_layout *
+vkr_set_layout_ref(struct vkr_set_layout *layout)
+{
+   if (layout)
+      atomic_fetch_add(&layout->refs, 1);
+   return layout;
+}
+
+void
+vkr_set_layout_unref(struct vkr_set_layout *layout)
+{
+   if (layout && atomic_fetch_sub(&layout->refs, 1) == 1)
+      free(layout);
+}
+
+void
+vkr_descriptor_object_release(struct vkr_object *obj)
+{
+   switch (obj->type) {
+   case VK_OBJECT_TYPE_DESCRIPTOR_SET_LAYOUT:
+      vkr_set_layout_unref(((struct vkr_descriptor_set_layout *)obj)->info);
+      break;
+   case VK_OBJECT_TYPE_DESCRIPTOR_SET:
+      vkr_set_layout_unref(((struct vkr_descriptor_set *)obj)->layout);
+      break;
+   case VK_OBJECT_TYPE_PIPELINE_LAYOUT: {
+      struct vkr_pipeline_layout *layout = (struct vkr_pipeline_layout *)obj;
+      for (uint32_t i = 0; i < layout->set_count; i++)
+         vkr_set_layout_unref(layout->sets[i]);
+      free(layout->sets);
+      break;
+   }
+   default:
+      break;
+   }
+}
+
+/* the core descriptor types and the extension ones the device has */
+static bool
+vkr_descriptor_type_ok(const struct vkr_limits *l, VkDescriptorType type)
+{
+   return (uint32_t)type <= VK_DESCRIPTOR_TYPE_INPUT_ATTACHMENT ||
+          (type == VK_DESCRIPTOR_TYPE_INLINE_UNIFORM_BLOCK && l->max_inline_uniform_block) ||
+          (type == VK_DESCRIPTOR_TYPE_MUTABLE_EXT && l->mutable_descriptors);
+}
+
+/* a MUTABLE binding's list: core types other than the dynamic buffers, none twice */
+static bool
+vkr_mutable_list_ok(const VkMutableDescriptorTypeListEXT *list, uint32_t *types)
+{
+   *types = 0;
+   for (uint32_t i = 0; i < list->descriptorTypeCount; i++) {
+      const VkDescriptorType t = list->pDescriptorTypes[i];
+      if ((uint32_t)t > VK_DESCRIPTOR_TYPE_INPUT_ATTACHMENT ||
+          t == VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER_DYNAMIC ||
+          t == VK_DESCRIPTOR_TYPE_STORAGE_BUFFER_DYNAMIC || (*types & (1u << t)))
+         return false;
+      *types |= 1u << t;
+   }
+   return true;
+}
+
+static int
+vkr_set_layout_binding_compare(const void *a, const void *b)
+{
+   const uint32_t x = ((const struct vkr_set_layout_binding *)a)->binding;
+   const uint32_t y = ((const struct vkr_set_layout_binding *)b)->binding;
+   return x < y ? -1 : x > y;
+}
+
+/* the layout's table, or NULL with why (a guest value outside what the driver sizes) */
+static struct vkr_set_layout *
+vkr_set_layout_create(const struct vkr_physical_device *physical_dev,
+                      const VkDescriptorSetLayoutCreateInfo *info,
+                      char *why,
+                      size_t why_size)
+{
+   const struct vkr_limits *l = &physical_dev->limits;
+   const VkPhysicalDeviceLimits *lim = &physical_dev->properties.limits;
+   const VkDescriptorSetLayoutBindingFlagsCreateInfo *flags_info = vkr_find_struct(
+      info->pNext, VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_BINDING_FLAGS_CREATE_INFO);
+   const VkMutableDescriptorTypeCreateInfoEXT *mutable_info =
+      vkr_find_struct(info->pNext, VK_STRUCTURE_TYPE_MUTABLE_DESCRIPTOR_TYPE_CREATE_INFO_EXT);
+   const bool push = info->flags & VK_DESCRIPTOR_SET_LAYOUT_CREATE_PUSH_DESCRIPTOR_BIT_KHR;
+
+   if (info->bindingCount > VKR_MAX_BINDINGS ||
+       (flags_info && flags_info->bindingCount && flags_info->bindingCount != info->bindingCount)) {
+      snprintf(why, why_size, "%u bindings, %u binding flags", info->bindingCount,
+               flags_info ? flags_info->bindingCount : 0);
+      return NULL;
+   }
+   struct vkr_set_layout *layout =
+      calloc(1, sizeof(*layout) + sizeof(layout->bindings[0]) * info->bindingCount);
+   if (!layout) {
+      snprintf(why, why_size, "out of host memory");
+      return NULL;
+   }
+   atomic_init(&layout->refs, 1);
+   layout->flags = info->flags;
+   layout->binding_count = info->bindingCount;
+
+   uint64_t descriptors = 0, inline_bytes = 0;
+   uint32_t ubo_dynamic = 0, ssbo_dynamic = 0, variable = UINT32_MAX;
+   for (uint32_t i = 0; i < info->bindingCount; i++) {
+      const VkDescriptorSetLayoutBinding *b = &info->pBindings[i];
+      struct vkr_set_layout_binding *t = &layout->bindings[i];
+      t->binding = b->binding;
+      t->type = b->descriptorType;
+      t->count = b->descriptorCount;
+      t->stages = b->stageFlags;
+      t->flags = flags_info && flags_info->bindingCount ? flags_info->pBindingFlags[i] : 0;
+      if (b->binding >= VKR_MAX_BINDINGS || !vkr_descriptor_type_ok(l, b->descriptorType)) {
+         snprintf(why, why_size, "binding %u of type %d", b->binding, b->descriptorType);
+         goto fail;
+      }
+      if (t->flags & VK_DESCRIPTOR_BINDING_VARIABLE_DESCRIPTOR_COUNT_BIT)
+         variable = i;
+      switch (b->descriptorType) {
+      case VK_DESCRIPTOR_TYPE_INLINE_UNIFORM_BLOCK:
+         if ((b->descriptorCount & 3) || b->descriptorCount > l->max_inline_uniform_block) {
+            snprintf(why, why_size, "binding %u: an inline uniform block of %u bytes (at most %u)",
+                     b->binding, b->descriptorCount, l->max_inline_uniform_block);
+            goto fail;
+         }
+         inline_bytes += b->descriptorCount;
+         continue;
+      case VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER_DYNAMIC:
+         ubo_dynamic += b->descriptorCount;
+         break;
+      case VK_DESCRIPTOR_TYPE_STORAGE_BUFFER_DYNAMIC:
+         ssbo_dynamic += b->descriptorCount;
+         break;
+      case VK_DESCRIPTOR_TYPE_MUTABLE_EXT:
+         /* KosmicKrisp reads the list at the binding's index in pBindings */
+         if (!mutable_info || i >= mutable_info->mutableDescriptorTypeListCount ||
+             !vkr_mutable_list_ok(&mutable_info->pMutableDescriptorTypeLists[i],
+                                  &t->mutable_types)) {
+            snprintf(why, why_size, "binding %u: a mutable binding without a valid type list",
+                     b->binding);
+            goto fail;
+         }
+         break;
+      case VK_DESCRIPTOR_TYPE_SAMPLER:
+      case VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER:
+         if (b->pImmutableSamplers) {
+            t->immutable_planes = 1;
+            for (uint32_t s = 0; s < b->descriptorCount; s++) {
+               const struct vkr_sampler *sampler = vkr_sampler_from_handle(b->pImmutableSamplers[s]);
+               if (!sampler) {
+                  snprintf(why, why_size, "binding %u: immutable sampler %u is NULL", b->binding, s);
+                  goto fail;
+               }
+               t->immutable_planes = MAX2(t->immutable_planes, sampler->planes);
+            }
+         }
+         break;
+      default:
+         break;
+      }
+      descriptors += b->descriptorCount;
+   }
+
+   qsort(layout->bindings, layout->binding_count, sizeof(layout->bindings[0]),
+         vkr_set_layout_binding_compare);
+   for (uint32_t i = 1; i < layout->binding_count; i++) {
+      if (layout->bindings[i].binding == layout->bindings[i - 1].binding) {
+         snprintf(why, why_size, "binding %u twice", layout->bindings[i].binding);
+         goto fail;
+      }
+   }
+   /* the variable binding is the largest one, and not of a dynamic buffer */
+   if (variable != UINT32_MAX) {
+      const struct vkr_set_layout_binding *last = &layout->bindings[layout->binding_count - 1];
+      if (info->pBindings[variable].binding != last->binding ||
+          last->type == VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER_DYNAMIC ||
+          last->type == VK_DESCRIPTOR_TYPE_STORAGE_BUFFER_DYNAMIC || push) {
+         snprintf(why, why_size, "a variable count on binding %u of type %d",
+                  info->pBindings[variable].binding, info->pBindings[variable].descriptorType);
+         goto fail;
+      }
+   }
+   const uint32_t ubo_dynamic_max = MAX2(lim->maxDescriptorSetUniformBuffersDynamic,
+                                         l->uab_uniform_buffers_dynamic);
+   const uint32_t ssbo_dynamic_max = MAX2(lim->maxDescriptorSetStorageBuffersDynamic,
+                                          l->uab_storage_buffers_dynamic);
+   if (descriptors > VKR_MAX_DESCRIPTORS || inline_bytes > VKR_MAX_DESCRIPTORS ||
+       ubo_dynamic > ubo_dynamic_max || ssbo_dynamic > ssbo_dynamic_max) {
+      snprintf(why, why_size,
+               "%" PRIu64 " descriptors, %" PRIu64 " inline bytes, %u + %u dynamic buffers "
+               "(at most %u, %u, %u + %u)", descriptors, inline_bytes, ubo_dynamic, ssbo_dynamic,
+               VKR_MAX_DESCRIPTORS, VKR_MAX_DESCRIPTORS, ubo_dynamic_max, ssbo_dynamic_max);
+      goto fail;
+   }
+   /* a push descriptor layout fits KosmicKrisp's push set (maxPushDescriptors of its
+    * largest descriptor) */
+   if (push && (!l->max_push_descriptors || descriptors > l->max_push_descriptors ||
+                ubo_dynamic || ssbo_dynamic || inline_bytes)) {
+      snprintf(why, why_size, "a push descriptor layout of %" PRIu64 " descriptors (at most %u), "
+               "%u dynamic, %" PRIu64 " inline bytes", descriptors, l->max_push_descriptors,
+               ubo_dynamic + ssbo_dynamic, inline_bytes);
+      goto fail;
+   }
+   layout->dynamic_count = ubo_dynamic + ssbo_dynamic;
+   return layout;
+
+fail:
+   free(layout);
+   return NULL;
+}
+
+static const struct vkr_set_layout_binding *
+vkr_set_layout_find(const struct vkr_set_layout *layout, uint32_t binding, uint32_t *index)
+{
+   uint32_t lo = 0, hi = layout->binding_count;
+   while (lo < hi) {
+      const uint32_t mid = lo + (hi - lo) / 2;
+      if (layout->bindings[mid].binding < binding) {
+         lo = mid + 1;
+      } else if (layout->bindings[mid].binding > binding) {
+         hi = mid;
+      } else {
+         *index = mid;
+         return &layout->bindings[mid];
+      }
+   }
+   return NULL;
+}
+
+/* a binding's descriptors in a set: the variable binding has the set's count */
+static uint32_t
+vkr_set_binding_count(const struct vkr_set_layout_binding *b, uint32_t variable_count)
+{
+   return (b->flags & VK_DESCRIPTOR_BINDING_VARIABLE_DESCRIPTOR_COUNT_BIT) ? variable_count
+                                                                            : b->count;
+}
+
+/* the consecutive binding update (VUID-VkWriteDescriptorSet-dstArrayElement-00321 and
+ * descriptorCount-00317, -00318, -10776, -10777): from element `first` of binding `index`,
+ * the descriptors fill the rest of that binding and go on into the bindings after it.
+ * Bindings with no descriptors, and numbers the layout lacks, are skipped; every other
+ * binding passed has the first one's type, stages, flags and immutable samplers or not.
+ * The walk gives one part per binding the update lands in: KosmicKrisp writes a whole
+ * write at its first binding's offset + element * that binding's stride and MoltenVK with
+ * that binding's layout, but strides and layouts differ between bindings of one type
+ * (immutable YCbCr samplers of 2 or 3 planes, a mutable binding sized by its largest
+ * type), so each part reaches the driver as a write of its own. Inline uniform blocks
+ * (bytes, a multiple of 4) and empty updates stay within the one binding. */
+void
+vkr_set_walk_init(struct vkr_set_walk *walk,
+                  const struct vkr_set_layout *layout,
+                  uint32_t variable_count,
+                  uint32_t index,
+                  uint32_t first,
+                  uint32_t count)
+{
+   *walk = (struct vkr_set_walk){ .layout = layout, .variable_count = variable_count,
+                                  .first_index = index, .index = index, .element = first,
+                                  .left = count };
+}
+
+bool
+vkr_set_walk_next(struct vkr_set_walk *walk, struct vkr_set_part *part)
+{
+   const struct vkr_set_layout *layout = walk->layout;
+   const struct vkr_set_layout_binding *b0 = &layout->bindings[walk->first_index];
+   if (walk->failed || (!walk->left && walk->parts))
+      return false;
+   if (b0->type == VK_DESCRIPTOR_TYPE_INLINE_UNIFORM_BLOCK || !walk->left) {
+      const uint64_t room = vkr_set_binding_count(b0, walk->variable_count);
+      const bool ok = b0->type == VK_DESCRIPTOR_TYPE_INLINE_UNIFORM_BLOCK
+                         ? !(walk->element & 3) && !(walk->left & 3) &&
+                              vkr_range_ok(walk->element, walk->left, room)
+                         : walk->element <= room;
+      if (!ok) {
+         walk->failed = true;
+         return false;
+      }
+      *part = (struct vkr_set_part){ walk->first_index, walk->element, walk->left, 0 };
+      walk->done = walk->left;
+      walk->left = 0;
+      walk->parts = 1;
+      return true;
+   }
+   for (; walk->index < layout->binding_count; walk->index++) {
+      const struct vkr_set_layout_binding *b = &layout->bindings[walk->index];
+      if (walk->index != walk->first_index) {
+         if (!b->count)
+            continue;
+         if (b->type != b0->type || b->stages != b0->stages || b->flags != b0->flags ||
+             !b->immutable_planes != !b0->immutable_planes)
+            break;
+      }
+      const uint32_t room = vkr_set_binding_count(b, walk->variable_count);
+      if (walk->element >= room) {
+         walk->element -= room;
+         continue;
+      }
+      const uint32_t n = MIN2(room - walk->element, walk->left);
+      *part = (struct vkr_set_part){ walk->index, walk->element, n, walk->done };
+      walk->done += n;
+      walk->left -= n;
+      walk->element = 0;
+      walk->index++;
+      walk->parts++;
+      return true;
+   }
+   /* past the layout's last binding, or a binding that differs */
+   walk->failed = true;
+   return false;
+}
+
+/* the descriptor type a write or copy may name for a binding */
+static bool
+vkr_set_type_ok(const struct vkr_set_layout_binding *b, VkDescriptorType type)
+{
+   return type == b->type ||
+          (b->type == VK_DESCRIPTOR_TYPE_MUTABLE_EXT && (uint32_t)type <= 31 &&
+           (b->mutable_types & (1u << type)));
+}
+
+/* a write's layout (a push layout, else its set's) and its variable count */
+static const struct vkr_set_layout *
+vkr_write_layout(const struct vkr_set_layout *push,
+                 const VkWriteDescriptorSet *w,
+                 uint32_t *variable_count)
+{
+   const struct vkr_descriptor_set *set =
+      push ? NULL : vkr_descriptor_set_from_handle(w->dstSet);
+   *variable_count = set ? set->variable_count : 0;
+   return push ? push : set ? set->layout : NULL;
+}
+
+/* one part of a write: its descriptors p->offset .. + p->count, in binding b */
+static bool
+vkr_write_part_ok(const struct vkr_device *dev,
+                  const struct vkr_set_layout_binding *b,
+                  const VkWriteDescriptorSet *w,
+                  const struct vkr_set_part *p,
+                  char *why,
+                  size_t why_size)
+{
+   const VkPhysicalDeviceLimits *lim = &dev->physical_device->properties.limits;
+   const bool null_ok = dev->null_descriptor;
+   if (!vkr_set_type_ok(b, w->descriptorType)) {
+      snprintf(why, why_size, "binding %u: type %d (the binding's: %d)", b->binding,
+               w->descriptorType, b->type);
+      return false;
+   }
+   switch (w->descriptorType) {
+   case VK_DESCRIPTOR_TYPE_SAMPLER:
+   case VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER:
+   case VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE:
+   case VK_DESCRIPTOR_TYPE_STORAGE_IMAGE:
+   case VK_DESCRIPTOR_TYPE_INPUT_ATTACHMENT:
+      for (uint32_t i = 0; i < p->count; i++) {
+         const VkDescriptorImageInfo *ii = &w->pImageInfo[p->offset + i];
+         const uint32_t e = p->element + i;
+         const bool sampler_type = w->descriptorType == VK_DESCRIPTOR_TYPE_SAMPLER ||
+                                   w->descriptorType == VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
+         const struct vkr_sampler *sampler = vkr_sampler_from_handle(ii->sampler);
+         /* KosmicKrisp dereferences the sampler; YCbCr samplers only as immutable ones */
+         if (sampler_type && !b->immutable_planes && (!sampler || sampler->planes)) {
+            snprintf(why, why_size, "binding %u element %u: %s sampler", b->binding, e,
+                     sampler ? "a YCbCr" : "no");
+            return false;
+         }
+         if (w->descriptorType == VK_DESCRIPTOR_TYPE_SAMPLER)
+            continue;
+         const struct vkr_image_view *view = vkr_image_view_from_handle(ii->imageView);
+         /* a multi-planar view takes a descriptor per plane: only in a binding sized for it */
+         const uint32_t room = w->descriptorType == VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER
+                                  ? b->immutable_planes
+                                  : 1;
+         if (view ? view->planes > MAX2(room, 1)
+                  : !null_ok || w->descriptorType == VK_DESCRIPTOR_TYPE_INPUT_ATTACHMENT) {
+            snprintf(why, why_size, "binding %u element %u: %s", b->binding, e,
+                     view ? "a multi-planar view without immutable YCbCr samplers"
+                          : "no image view");
+            return false;
+         }
+      }
+      break;
+   case VK_DESCRIPTOR_TYPE_UNIFORM_TEXEL_BUFFER:
+   case VK_DESCRIPTOR_TYPE_STORAGE_TEXEL_BUFFER:
+      for (uint32_t i = 0; i < p->count; i++) {
+         if (!w->pTexelBufferView[p->offset + i] && !null_ok) {
+            snprintf(why, why_size, "binding %u element %u: no texel buffer view", b->binding,
+                     p->element + i);
+            return false;
+         }
+      }
+      break;
+   case VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER:
+   case VK_DESCRIPTOR_TYPE_STORAGE_BUFFER:
+   case VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER_DYNAMIC:
+   case VK_DESCRIPTOR_TYPE_STORAGE_BUFFER_DYNAMIC: {
+      const bool uniform = w->descriptorType == VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER ||
+                           w->descriptorType == VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER_DYNAMIC;
+      const uint64_t max_range = uniform ? lim->maxUniformBufferRange : lim->maxStorageBufferRange;
+      for (uint32_t i = 0; i < p->count; i++) {
+         const VkDescriptorBufferInfo *bi = &w->pBufferInfo[p->offset + i];
+         const struct vkr_buffer *buf = vkr_buffer_from_handle(bi->buffer);
+         const uint32_t e = p->element + i;
+         bool ok;
+         if (!buf) {
+            /* dynamic ones too: KosmicKrisp gives a NULL buffer an empty range */
+            ok = null_ok && !bi->offset && bi->range == VK_WHOLE_SIZE;
+         } else {
+            const uint64_t range =
+               bi->range == VK_WHOLE_SIZE ? (bi->offset < buf->size ? buf->size - bi->offset : 0)
+                                          : bi->range;
+            ok = vkr_whole_range_ok(bi->offset, bi->range, buf->size) && range &&
+                 range <= max_range;
+         }
+         if (!ok) {
+            snprintf(why, why_size, "binding %u element %u: %" PRIu64 " bytes at %" PRIu64
+                     " of %" PRIu64 " (at most %" PRIu64 ")", b->binding, e, bi->range,
+                     bi->offset, buf ? buf->size : 0, max_range);
+            return false;
+         }
+      }
+      break;
+   }
+   case VK_DESCRIPTOR_TYPE_INLINE_UNIFORM_BLOCK: {
+      const VkWriteDescriptorSetInlineUniformBlock *data = vkr_find_struct(
+         w->pNext, VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET_INLINE_UNIFORM_BLOCK);
+      if (!data || data->dataSize != w->descriptorCount) {
+         snprintf(why, why_size, "binding %u: %u inline bytes, %u in the write", b->binding,
+                  data ? data->dataSize : 0, w->descriptorCount);
+         return false;
+      }
+      break;
+   }
+   default:
+      snprintf(why, why_size, "binding %u: type %d", b->binding, w->descriptorType);
+      return false;
+   }
+   return true;
+}
+
+/* a write's parts (the bindings it lands in), or 0 when it does not hold; *as_is: one
+ * part, where the write names it */
+static uint32_t
+vkr_descriptor_write_parts(const struct vkr_device *dev,
+                           const struct vkr_set_layout *push,
+                           const VkWriteDescriptorSet *w,
+                           bool *as_is,
+                           char *why,
+                           size_t why_size)
+{
+   uint32_t variable_count, index;
+   const struct vkr_set_layout *layout = vkr_write_layout(push, w, &variable_count);
+   const struct vkr_set_layout_binding *b =
+      layout ? vkr_set_layout_find(layout, w->dstBinding, &index) : NULL;
+   if (!b || !vkr_set_type_ok(b, w->descriptorType)) {
+      snprintf(why, why_size, "binding %u: %s", w->dstBinding,
+               b ? "another descriptor type" : "not in the set's layout");
+      return 0;
+   }
+   const bool image = w->descriptorType <= VK_DESCRIPTOR_TYPE_STORAGE_IMAGE ||
+                      w->descriptorType == VK_DESCRIPTOR_TYPE_INPUT_ATTACHMENT;
+   const bool texel = w->descriptorType == VK_DESCRIPTOR_TYPE_UNIFORM_TEXEL_BUFFER ||
+                      w->descriptorType == VK_DESCRIPTOR_TYPE_STORAGE_TEXEL_BUFFER;
+   const bool buffer = w->descriptorType >= VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER &&
+                       w->descriptorType <= VK_DESCRIPTOR_TYPE_STORAGE_BUFFER_DYNAMIC;
+   if (w->descriptorCount && ((image && !w->pImageInfo) || (texel && !w->pTexelBufferView) ||
+                              (buffer && !w->pBufferInfo))) {
+      snprintf(why, why_size, "binding %u: no %s", w->dstBinding,
+               image ? "image infos" : texel ? "texel buffer views" : "buffer infos");
+      return 0;
+   }
+   struct vkr_set_walk walk;
+   struct vkr_set_part p = { 0 };
+   vkr_set_walk_init(&walk, layout, variable_count, index, w->dstArrayElement,
+                     w->descriptorCount);
+   while (vkr_set_walk_next(&walk, &p)) {
+      if (!vkr_write_part_ok(dev, &layout->bindings[p.index], w, &p, why, why_size))
+         return 0;
+   }
+   if (walk.failed) {
+      snprintf(why, why_size, "binding %u, elements %u + %u, type %d (the binding: %d of %u)",
+               w->dstBinding, w->dstArrayElement, w->descriptorCount, w->descriptorType,
+               (int)b->type, vkr_set_binding_count(b, variable_count));
+      return 0;
+   }
+   *as_is = walk.parts == 1 && p.index == index && p.element == w->dstArrayElement;
+   return walk.parts;
+}
+
+bool
+vkr_descriptor_writes_ok(struct vn_dispatch_context *dispatch,
+                         const char *call,
+                         const struct vkr_device *dev,
+                         const struct vkr_set_layout *push,
+                         uint32_t *count,
+                         const VkWriteDescriptorSet **writes)
+{
+   const VkWriteDescriptorSet *in = *writes;
+   char why[192];
+   uint64_t parts = 0;
+   bool all_as_is = true;
+   for (uint32_t i = 0; i < *count; i++) {
+      bool as_is = false;
+      const uint32_t n = vkr_descriptor_write_parts(dev, push, &in[i], &as_is, why, sizeof(why));
+      if (!n) {
+         vkr_context_refuse(dispatch->data, true, call, "write %u: %s", i, why);
+         return false;
+      }
+      parts += n;
+      all_as_is &= as_is;
+   }
+   if (all_as_is)
+      return true;
+
+   /* the driver gets one write per binding (handles are replaced in these afterwards: the
+    * parts share the guest's info arrays, each element in one part) */
+   VkWriteDescriptorSet *out = vkr_cs_decoder_alloc_temp_array(
+      (struct vkr_cs_decoder *)dispatch->decoder, sizeof(*out), parts);
+   if (!out)
+      return false;
+   uint32_t n = 0;
+   for (uint32_t i = 0; i < *count; i++) {
+      const VkWriteDescriptorSet *w = &in[i];
+      uint32_t variable_count, index;
+      const struct vkr_set_layout *layout = vkr_write_layout(push, w, &variable_count);
+      vkr_set_layout_find(layout, w->dstBinding, &index);
+      struct vkr_set_walk walk;
+      struct vkr_set_part p;
+      vkr_set_walk_init(&walk, layout, variable_count, index, w->dstArrayElement,
+                        w->descriptorCount);
+      const uint32_t start = n;
+      while (vkr_set_walk_next(&walk, &p)) {
+         VkWriteDescriptorSet *o = &out[n++];
+         *o = *w;
+         o->dstBinding = layout->bindings[p.index].binding;
+         o->dstArrayElement = p.element;
+         o->descriptorCount = p.count;
+         if (w->pImageInfo)
+            o->pImageInfo = w->pImageInfo + p.offset;
+         if (w->pBufferInfo)
+            o->pBufferInfo = w->pBufferInfo + p.offset;
+         if (w->pTexelBufferView)
+            o->pTexelBufferView = w->pTexelBufferView + p.offset;
+      }
+      /* a split write's chain is for types that never split (inline uniform blocks) */
+      for (uint32_t j = start; n - start > 1 && j < n; j++)
+         out[j].pNext = NULL;
+   }
+   *writes = out;
+   *count = n;
+   return true;
+}
+
+/* a copy's types: the same, or a mutable binding on either side */
+static bool
+vkr_copy_types_ok(const struct vkr_set_layout_binding *s, const struct vkr_set_layout_binding *d)
+{
+   return s->type == d->type || s->type == VK_DESCRIPTOR_TYPE_MUTABLE_EXT ||
+          d->type == VK_DESCRIPTOR_TYPE_MUTABLE_EXT;
+}
+
+/* a copy's segments: each in one binding on either side; 0 when it does not hold. out:
+ * where to put them (NULL to count); *as_is: one segment, where the copy names it */
+static uint32_t
+vkr_descriptor_copy_segments(const VkCopyDescriptorSet *c,
+                             VkCopyDescriptorSet *out,
+                             bool *as_is)
+{
+   const struct vkr_descriptor_set *src = vkr_descriptor_set_from_handle(c->srcSet);
+   const struct vkr_descriptor_set *dst = vkr_descriptor_set_from_handle(c->dstSet);
+   uint32_t si, di;
+   const struct vkr_set_layout_binding *sb =
+      src && src->layout ? vkr_set_layout_find(src->layout, c->srcBinding, &si) : NULL;
+   const struct vkr_set_layout_binding *db =
+      dst && dst->layout ? vkr_set_layout_find(dst->layout, c->dstBinding, &di) : NULL;
+   if (!sb || !db)
+      return 0;
+   struct vkr_set_walk sw, dw;
+   struct vkr_set_part sp, dp;
+   vkr_set_walk_init(&sw, src->layout, src->variable_count, si, c->srcArrayElement,
+                     c->descriptorCount);
+   vkr_set_walk_init(&dw, dst->layout, dst->variable_count, di, c->dstArrayElement,
+                     c->descriptorCount);
+   if (!c->descriptorCount) {
+      if (!vkr_set_walk_next(&sw, &sp) || !vkr_set_walk_next(&dw, &dp) ||
+          !vkr_copy_types_ok(sb, db))
+         return 0;
+      if (out)
+         out[0] = *c;
+      *as_is = true;
+      return 1;
+   }
+   /* both sides place the same count, a part of at least one descriptor at a time */
+   uint32_t n = 0, s_left = 0, d_left = 0;
+   do {
+      if (!s_left) {
+         if (!vkr_set_walk_next(&sw, &sp))
+            return 0;
+         s_left = sp.count;
+      }
+      if (!d_left) {
+         if (!vkr_set_walk_next(&dw, &dp))
+            return 0;
+         d_left = dp.count;
+      }
+      const struct vkr_set_layout_binding *s = &src->layout->bindings[sp.index];
+      const struct vkr_set_layout_binding *d = &dst->layout->bindings[dp.index];
+      if (!vkr_copy_types_ok(s, d))
+         return 0;
+      const uint32_t m = MIN2(s_left, d_left);
+      if (out) {
+         out[n] = *c;
+         out[n].srcBinding = s->binding;
+         out[n].srcArrayElement = sp.element + (sp.count - s_left);
+         out[n].dstBinding = d->binding;
+         out[n].dstArrayElement = dp.element + (dp.count - d_left);
+         out[n].descriptorCount = m;
+      }
+      n++;
+      s_left -= m;
+      d_left -= m;
+   } while (s_left || d_left || sw.left || dw.left);
+   *as_is = n == 1 && sp.index == si && sp.element == c->srcArrayElement && dp.index == di &&
+            dp.element == c->dstArrayElement;
+   return n;
+}
+
+bool
+vkr_descriptor_copies_ok(struct vn_dispatch_context *dispatch,
+                         const char *call,
+                         uint32_t *count,
+                         const VkCopyDescriptorSet **copies)
+{
+   const VkCopyDescriptorSet *in = *copies;
+   uint64_t segments = 0;
+   bool all_as_is = true;
+   for (uint32_t i = 0; i < *count; i++) {
+      const VkCopyDescriptorSet *c = &in[i];
+      bool as_is = false;
+      const uint32_t n = vkr_descriptor_copy_segments(c, NULL, &as_is);
+      if (!n) {
+         vkr_context_refuse(dispatch->data, true, call,
+                            "copy %u: binding %u elements %u + %u to binding %u elements %u + %u",
+                            i, c->srcBinding, c->srcArrayElement, c->descriptorCount,
+                            c->dstBinding, c->dstArrayElement, c->descriptorCount);
+         return false;
+      }
+      segments += n;
+      all_as_is &= as_is;
+   }
+   if (all_as_is)
+      return true;
+
+   VkCopyDescriptorSet *out = vkr_cs_decoder_alloc_temp_array(
+      (struct vkr_cs_decoder *)dispatch->decoder, sizeof(*out), segments);
+   if (!out)
+      return false;
+   uint32_t n = 0;
+   for (uint32_t i = 0; i < *count; i++) {
+      bool as_is;
+      n += vkr_descriptor_copy_segments(&in[i], &out[n], &as_is);
+   }
+   *copies = out;
+   *count = n;
+   return true;
+}
 
