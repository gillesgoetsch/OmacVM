+/* OmacVM (#589): the same for a vertex shader whose clip distances go straight to an
+ * evaluation shader (no control shader): gl_ClipDistance in its gl_PerVertex block and in
+ * the evaluation shader's gl_in[] made Apple's Metal pipeline build fail as well. On a
+ * desktop GL without cull distances it writes them to the varyings omacvm_clip0 (and
+ * omacvm_clip1), no location, and says so in its variable info (tess_clip_out); the
+ * evaluation shader reads them as above (tess_clip_in). Not as the last stage (no
+ * evaluation shader: it writes the user clip planes), not with a control shader (#684's
+ * case), not with cull distances, nor when the varyings would not fit. The count is the
+ * shader's own, not key->num_out_clip: the evaluation shader takes its count from here.
+ * Returns the number of clip distances passed that way, 0: none. */
+static int vs_clip_varyings(const struct dump_ctx *ctx)
+{
+   if (ctx->prog_type != TGSI_PROCESSOR_VERTEX || !ctx->key->tes_present ||
+       ctx->key->tcs_present || ctx->is_last_vertex_stage || ctx->cfg->use_gles ||
+       ctx->cfg->has_cull_distance || !ctx->num_out_clip_dist ||
+       ctx->num_cull_dist_prop || ctx->key->num_out_cull)
+      return 0;
+   int n = ctx->num_clip_dist_prop ? ctx->num_clip_dist_prop : ctx->num_out_clip_dist;
+   if (n > 8 || ctx->num_outputs + (n > 4 ? 2 : 1) > MAX_VARYING)
+      return 0;
+   return n;
+}
+
