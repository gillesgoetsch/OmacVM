+/* OmacVM prototype 2: would the tap pass this Shift on to macOS? The same
+ * rule as omacvm_ime_shift_pass(), without its side effects. */
+static bool omacvm_ime_shift_would_pass(int keycode, uint64_t flags)
+{
+    int side;
+
+    if (keycode == OMACVM_IME_SHIFT_LEFT) {
+        side = 0;
+    } else if (keycode == OMACVM_IME_SHIFT_RIGHT) {
+        side = 1;
+    } else {
+        return false;
+    }
+    if (!omacvm_ime_shift_down(keycode, flags)) {
+        return omacvm_ime_shift.passed[side];
+    }
+    return !omacvm_ime_shift_off &&
+           (omacvm_ime_active(&omacvm_ime) || omacvm_ime_off.waiting) &&
+           !(flags & OMACVM_IME_SHIFT_F_OTHERS);
+}
