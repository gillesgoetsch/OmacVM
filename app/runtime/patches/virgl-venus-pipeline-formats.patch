+/* OmacVM (virgl-venus-pipeline-formats.patch): the attachments a subpass uses (color, input,
+ * resolve, depth/stencil and its resolve, shading rate) have formats the device renders to;
+ * one no subpass uses needs only a format vkr knows (Mesa computes aspects for every
+ * attachment), as Vulkan puts the format feature rules on the references
+ * (VUID-VkSubpassDescription-pColorAttachments-02648, -pInputAttachments-02647, ...) */
+static bool
+vkr_subpass_formats_ok(const struct vkr_physical_device *physical_dev,
+                       uint32_t subpass,
+                       const uint32_t *refs,
+                       uint32_t n,
+                       const VkFormat *formats,
+                       size_t stride,
+                       char *why,
+                       size_t why_size)
+{
+   for (uint32_t r = 0; r < n; r++) {
+      if (refs[r] == VK_ATTACHMENT_UNUSED)
+         continue;
+      const VkFormat format = *(const VkFormat *)((const char *)formats + stride * refs[r]);
+      if (!vkr_physical_device_format_ok(physical_dev, format,
+                                         VK_FORMAT_FEATURE_COLOR_ATTACHMENT_BIT |
+                                            VK_FORMAT_FEATURE_DEPTH_STENCIL_ATTACHMENT_BIT |
+                                            VK_FORMAT_FEATURE_FRAGMENT_SHADING_RATE_ATTACHMENT_BIT_KHR)) {
+         snprintf(why, why_size, "subpass %u: attachment %u of format %d", subpass, refs[r],
+                  format);
+         return false;
+      }
+   }
+   return true;
+}
