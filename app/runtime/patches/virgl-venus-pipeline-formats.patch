 #include "vkr_context.h"
 #include "vkr_device.h"
 #include "vkr_instance.h"
+#include "vkr_format_table.h"
 
 #ifdef HAVE_LINUX_UDMABUF_H
 #include <fcntl.h>
@@ -85,6 +86,24 @@ vkr_physical_device_get_gbm_device(void)
 
 #endif /* ENABLE_GBM_ALLOCATION */
 
+/* OmacVM (virgl-venus-pipeline-formats.patch): attachment formats. An unknown VkFormat ended
+ * both drivers' pipeline creation (MoltenVK: strlen(NULL) in getMTLPixelFormat), and
+ * KosmicKrisp ended it on an R64G64B64A64 color attachment, which Metal has no pixel format
+ * for. Linear or optimal: the Vulkan "potential format features" an attachment needs. */
+bool
+vkr_physical_device_format_ok(const struct vkr_physical_device *physical_dev,
+                              VkFormat format,
+                              VkFormatFeatureFlags features)
+{
+   if (!vkr_format_block_size(format))
+      return false;
+   VkFormatProperties props;
+   memset(&props, 0, sizeof(props));
+   physical_dev->proc_table.GetPhysicalDeviceFormatProperties(
+      physical_dev->base.handle.physical_device, format, &props);
+   return (props.linearTilingFeatures | props.optimalTilingFeatures) & features;
+}
+
 void
 vkr_physical_device_destroy(struct vkr_context *ctx,
                             struct vkr_physical_device *physical_dev)
diff --git a/src/venus/vkr_physical_device.h b/src/venus/vkr_physical_device.h
index 64a3859..8871ddf 100644
--- a/src/venus/vkr_physical_device.h
+++ b/src/venus/vkr_physical_device.h
@@ -66,6 +66,38 @@ vkr_physical_device_image_kind_ok(const struct vkr_physical_device *physical_dev
                                   VkImageType type,
                                   VkImageTiling tiling);
 
+/* OmacVM (virgl-venus-pipeline-formats.patch): a format vkr's format table knows with one
+ * of `features` among its linear or optimal tiling features on the host */
+bool
+vkr_physical_device_format_ok(const struct vkr_physical_device *physical_dev,
+                              VkFormat format,
+                              VkFormatFeatureFlags features);
+
+/* the formats of dynamic rendering (a pipeline's or an inherited one): UNDEFINED for no
+ * attachment, else a color (depth, stencil) attachment format of the device; a color format
+ * list of the count */
+static inline bool
+vkr_rendering_formats_ok(const struct vkr_physical_device *physical_dev,
+                         uint32_t color_count,
+                         const VkFormat *colors,
+                         VkFormat depth,
+                         VkFormat stencil)
+{
+   if (color_count && !colors)
+      return false;
+   for (uint32_t i = 0; i < color_count; i++) {
+      if (colors[i] != VK_FORMAT_UNDEFINED &&
+          !vkr_physical_device_format_ok(physical_dev, colors[i], VK_FORMAT_FEATURE_COLOR_ATTACHMENT_BIT))
+         return false;
+   }
+   return (depth == VK_FORMAT_UNDEFINED ||
+           vkr_physical_device_format_ok(physical_dev, depth,
+                                         VK_FORMAT_FEATURE_DEPTH_STENCIL_ATTACHMENT_BIT)) &&
+          (stencil == VK_FORMAT_UNDEFINED ||
+           vkr_physical_device_format_ok(physical_dev, stencil,
+                                         VK_FORMAT_FEATURE_DEPTH_STENCIL_ATTACHMENT_BIT));
+}
+
 void
 vkr_physical_device_destroy(struct vkr_context *ctx,
                             struct vkr_physical_device *physical_dev);
