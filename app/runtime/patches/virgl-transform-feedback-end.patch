+
+/* Ends transform feedback that is still active on obj (paused after its last draw).
+ * Apple's GL reads the current program in glEndTransformFeedback: with none bound
+ * (vrend binds none for clears and transfers) it crashes, with another one it fails.
+ * So the program the recording began with is bound for the end, then restored. */
+static void vrend_end_streamout_object(struct vrend_sub_context *sub_ctx,
+                                       struct vrend_streamout_object *obj)
+{
+   if (obj->xfb_state != XFB_STATE_STARTED && obj->xfb_state != XFB_STATE_PAUSED)
+      return;
+
+   if (has_feature(feat_transform_feedback2))
+      glBindTransformFeedback(GL_TRANSFORM_FEEDBACK, obj->id);
+   vrend_use_program(obj->begin_prog);
+   glEndTransformFeedback();
+   vrend_use_program(sub_ctx->prog);
+   if (has_feature(feat_transform_feedback2))
+      glBindTransformFeedback(GL_TRANSFORM_FEEDBACK,
+                              sub_ctx->current_so ? sub_ctx->current_so->id : 0);
+   obj->xfb_state = XFB_STATE_STARTED_NEED_BEGIN;
+   obj->begin_prog = NULL;
 }
 
