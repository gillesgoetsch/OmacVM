+/*
+ * Any thread, in the transaction that shows the whole frame SURF on LAYER
+ * (both present modes): the tiles over it go; can later frames go in tiles?
+ */
+static void present_tiles_whole_shown(CALayer *layer, IOSurfaceRef surf)
+{
+    if (present_tiles_on <= 0) {
+        return;
+    }
+    uint32_t fw = IOSurfaceGetWidth(surf), fh = IOSurfaceGetHeight(surf);
+    qatomic_set(&present_tiles_fit, present_tiles_fits(layer, fw, fh) ?
+                                    (uint64_t)fw << 32 | fh : 0);
+    os_unfair_lock_lock(&present_tile_lock);
+    present_tiles_hide_locked();
+    os_unfair_lock_unlock(&present_tile_lock);
+}
