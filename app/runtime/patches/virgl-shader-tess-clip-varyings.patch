+/* OmacVM (#589): Apple's GL on Metal builds no pipeline for a draw whose tessellation
+ * control to evaluation interface holds gl_ClipDistance (the control shader's gl_out[] or
+ * the evaluation shader's gl_in[]): the draw ran on its CPU vertex path and Metal's shader
+ * compiler crashed. On a desktop GL without cull distances (the Mac's) the control shader
+ * passes them as plain per-vertex varyings omacvm_clip0[] (omacvm_clip1[] for more than
+ * 4), without a location (matched by name), and says so in its variable info; the
+ * evaluation shader gets it in its key (tess_clip_in). Not with cull distances, nor when
+ * the varyings would not fit: then both keep gl_PerVertex. Returns the number of clip
+ * distances the control shader passes that way (what it declares and stores), 0: none. */
+static int tcs_clip_varyings(const struct dump_ctx *ctx)
+{
+   if (ctx->prog_type != TGSI_PROCESSOR_TESS_CTRL || ctx->cfg->use_gles ||
+       ctx->cfg->has_cull_distance || !ctx->num_out_clip_dist ||
+       ctx->num_cull_dist_prop || ctx->key->num_out_cull)
+      return 0;
+   /* emit_ios_per_vertex_out()'s and emit_clip_dist_movs()'s counts */
+   int n = ctx->num_clip_dist_prop ? ctx->num_clip_dist_prop : ctx->key->num_out_clip;
+   if (!n)
+      n = ctx->num_out_clip_dist;
+   n = MAX2(n, ctx->num_clip_dist_prop ? ctx->num_clip_dist_prop : ctx->num_out_clip_dist);
+   if (n > 8 || ctx->num_outputs + (n > 4 ? 2 : 1) > MAX_VARYING)
+      return 0;
+   return n;
+}
+
+/* ... the evaluation shader's side: the clip distances it gets as omacvm_clip0[] (and
+ * omacvm_clip1[]), all declared also when it reads none (Apple places varyings without a
+ * location by their names, also between separate programs), 0: gl_in[] as before */
+static int tes_clip_varyings(const struct dump_ctx *ctx)
+{
+   if (ctx->prog_type != TGSI_PROCESSOR_TESS_EVAL || ctx->cfg->use_gles ||
+       ctx->cfg->has_cull_distance || !ctx->key->tess_clip_in || ctx->key->num_in_cull)
+      return 0;
+   return ctx->key->num_in_clip;
+}
