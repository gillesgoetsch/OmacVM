+ * org.omacvm.test.unlock (distributed) stand for them, so the locked path is
+ * tested without locking the test Mac.
+ */
+@interface OmacVMLockWatch : NSObject
+@end
+
+@implementation OmacVMLockWatch
+- (void)locked:(NSNotification *)n
+{
+    omacvm_ds_screen_locked = true;
+    omacvm_ds_lock_changed("screen locked");
+}
+- (void)unlocked:(NSNotification *)n
+{
+    omacvm_ds_screen_locked = false;
+    omacvm_ds_lock_changed("screen unlocked");
+}
