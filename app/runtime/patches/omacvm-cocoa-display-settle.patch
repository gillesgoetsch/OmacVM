+        fprintf(stderr, "omacvm: displays: %s (%s)\n", locked ?
+                "no window changes while locked or asleep" :
+                "windows follow the displays again once they settle", why);
+    }
+    if (omacvm_ds_lock(&omacvm_ds_timer, locked, omacvm_ds_clock(), &at)) {
+        omacvm_ds_arm(at);
+    }
+}
