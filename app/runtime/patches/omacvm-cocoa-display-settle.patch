+/*
+ * OmacVM (#428): a Mac display the VM can use now. macOS lists a display
+ * that is unplugged or wakes from sleep for a few seconds as inactive at
+ * 1 x 1: windows sized for it, or put in full screen on it, made a loop.
+ */
+static bool omacvm_screen_counts(NSScreen *s)
+{
+    CGDirectDisplayID id;
+    NSSize size;
+
+    if (!s) {
+        return false;
+    }
+    id = [[[s deviceDescription] objectForKey:@"NSScreenNumber"] unsignedIntValue];
+    size = [s frame].size;
+    return omacvm_ds_counts(CGDisplayIsActive(id), CGDisplayIsAsleep(id),
+                            size.width, size.height);
+}
