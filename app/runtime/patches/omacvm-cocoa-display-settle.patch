+/*
+ * OmacVM (#428): every display change asks for an update here, and it runs
+ * from a timer once the displays settle: never inside the window or screen
+ * notification that asked, never inside another update, never while the
+ * screen is locked or the displays sleep (ui/omacvm-display-settle.h).
+ */
+static bool omacvm_ds_screen_locked, omacvm_ds_asleep, omacvm_ds_away, omacvm_ds_test_locked;
+static double omacvm_ds_locked_at;
+
+static void omacvm_ds_fired(void);
+
+static void omacvm_ds_arm(double at)
+{
+    double wait = MAX(0.0, at - omacvm_ds_clock());
+
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(wait * NSEC_PER_SEC)),
+                   dispatch_get_main_queue(), ^{ omacvm_ds_fired(); });
+}
+
+static void omacvm_ds_fired(void)
+{
+    double at, retry;
+
+    switch (omacvm_ds_fire(&omacvm_ds_timer, omacvm_ds_clock(), &at)) {
+    case OMACVM_DS_REARM:
+        omacvm_ds_arm(at);
+        return;
+    case OMACVM_DS_SKIP:
+        return;
+    case OMACVM_DS_RUN:
+        break;
+    }
+    retry = omacvm_displays_apply();
+    if (omacvm_ds_done(&omacvm_ds_timer, omacvm_ds_clock(), retry, &at)) {
+        omacvm_ds_arm(at);
+    }
+}
