+/* The session's own word: locked, or another user on the console. */
+static void omacvm_ds_session(bool *locked, bool *away)
+{
+    CFDictionaryRef d = CGSessionCopyCurrentDictionary();
+    CFTypeRef v;
+    int n = 0;
+
+    *locked = *away = false;
+    if (!d) {
+        return;
+    }
+    v = CFDictionaryGetValue(d, CFSTR("CGSSessionScreenIsLocked"));
+    if (v && CFGetTypeID(v) == CFBooleanGetTypeID()) {
+        *locked = CFBooleanGetValue(v);
+    } else if (v && CFGetTypeID(v) == CFNumberGetTypeID()) {
+        *locked = CFNumberGetValue(v, kCFNumberIntType, &n) && n;
+    }
+    v = CFDictionaryGetValue(d, kCGSessionOnConsoleKey);
+    if (v && CFGetTypeID(v) == CFBooleanGetTypeID()) {
+        *away = !CFBooleanGetValue(v);
+    }
+    CFRelease(d);
+}
+
+static void omacvm_displays_update(void)
+{
+    double at;
+
+    /* A change while locked for a while: a missed unlock or wake must not stop them for good. */
+    if (omacvm_ds_timer.locked && omacvm_ds_clock() - omacvm_ds_locked_at > 5) {
+        bool locked, away;
+        omacvm_ds_session(&locked, &away);
+        if ((omacvm_ds_screen_locked && !locked) || (omacvm_ds_away && !away) ||
+            (omacvm_ds_asleep && !CGDisplayIsAsleep(CGMainDisplayID()))) {
+            omacvm_ds_screen_locked = locked;
+            omacvm_ds_away = away;
+            omacvm_ds_asleep = CGDisplayIsAsleep(CGMainDisplayID());
+            omacvm_ds_lock_changed("the session says so");
+        }
+    }
+    if (omacvm_ds_ask(&omacvm_ds_timer, omacvm_ds_clock(), OMACVM_DS_SETTLE_S, &at)) {
+        omacvm_ds_arm(at);
+    }
+}
