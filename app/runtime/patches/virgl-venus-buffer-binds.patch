@@ -133,25 +144,74 @@ vkr_dispatch_vkGetBufferMemoryRequirements2(
    vk->GetBufferMemoryRequirements2(args->device, args->pInfo, args->pMemoryRequirements);
 }
 
+/* OmacVM (virgl-venus-buffer-binds.patch): whether memory may be bound to the buffer at
+ * offset: not a sparse buffer (those bind with vkQueueBindSparse), and the memory type,
+ * alignment and range as for images (vkr_device_memory_bind_ok). KosmicKrisp and MoltenVK
+ * bind whatever they get: a buffer past its memory's end lets the GPU read and write
+ * outside the memory, and MoltenVK ends the process on a memory type the buffer cannot
+ * take (Metal's "Invalid storageMode"). */
+static bool
+vkr_buffer_bind_ok(const struct vkr_buffer *buffer,
+                   const struct vkr_device_memory *mem,
+                   VkDeviceSize offset,
+                   char *why,
+                   size_t why_size)
+{
+   if (!buffer || !mem) {
+      snprintf(why, why_size, "no %s", buffer ? "memory" : "buffer");
+      return false;
+   }
+   if (buffer->flags & VK_BUFFER_CREATE_SPARSE_BINDING_BIT) {
+      snprintf(why, why_size, "a sparse buffer (flags 0x%x)", buffer->flags);
+      return false;
+   }
+   return vkr_device_memory_bind_ok(mem, &buffer->memory, offset, why, why_size);
+}
+
 static void
-vkr_dispatch_vkBindBufferMemory(UNUSED struct vn_dispatch_context *dispatch,
+vkr_dispatch_vkBindBufferMemory(struct vn_dispatch_context *dispatch,
                                 struct vn_command_vkBindBufferMemory *args)
 {
    struct vkr_device *dev = vkr_device_from_handle(args->device);
    struct vn_device_proc_table *vk = &dev->proc_table;
 
+   /* OmacVM: the guest binds without waiting for an answer: a bind the driver must not
+    * get ends the app's context */
+   char why[192];
+   if (!vkr_buffer_bind_ok(vkr_buffer_from_handle(args->buffer),
+                           vkr_device_memory_from_handle(args->memory), args->memoryOffset,
+                           why, sizeof(why))) {
+      vkr_context_refuse(dispatch->data, true, "vkBindBufferMemory", "%s", why);
+      args->ret = VK_ERROR_UNKNOWN;
+      return;
+   }
+
    vn_replace_vkBindBufferMemory_args_handle(args);
    args->ret =
       vk->BindBufferMemory(args->device, args->buffer, args->memory, args->memoryOffset);
 }
 
 static void
-vkr_dispatch_vkBindBufferMemory2(UNUSED struct vn_dispatch_context *dispatch,
+vkr_dispatch_vkBindBufferMemory2(struct vn_dispatch_context *dispatch,
                                  struct vn_command_vkBindBufferMemory2 *args)
 {
    struct vkr_device *dev = vkr_device_from_handle(args->device);
    struct vn_device_proc_table *vk = &dev->proc_table;
 
+   /* OmacVM: as vkBindBufferMemory, for each bind */
+   for (uint32_t i = 0; i < args->bindInfoCount; i++) {
+      const VkBindBufferMemoryInfo *bind = &args->pBindInfos[i];
+      char why[192];
+      if (!vkr_buffer_bind_ok(vkr_buffer_from_handle(bind->buffer),
+                              vkr_device_memory_from_handle(bind->memory),
+                              bind->memoryOffset, why, sizeof(why))) {
+         vkr_context_refuse(dispatch->data, true, "vkBindBufferMemory2", "bind %u: %s", i,
+                            why);
+         args->ret = VK_ERROR_UNKNOWN;
+         return;
+      }
+   }
+
    vn_replace_vkBindBufferMemory2_args_handle(args);
    args->ret = vk->BindBufferMemory2(args->device, args->bindInfoCount, args->pBindInfos);
 }
