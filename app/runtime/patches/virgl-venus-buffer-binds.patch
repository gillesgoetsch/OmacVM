+bool
+vkr_device_memory_bind_ok(const struct vkr_device_memory *mem,
+                          const struct vkr_memory_requirements *req,
+                          VkDeviceSize offset,
+                          char *why,
+                          size_t why_size)
+{
+   if (mem->memory_type_index >= 32 || !(req->type_bits & (1u << mem->memory_type_index))) {
+      snprintf(why, why_size, "memory type %u not one of 0x%x", mem->memory_type_index,
+               req->type_bits);
+      return false;
+   }
+   if (req->alignment && offset % req->alignment) {
+      snprintf(why, why_size, "offset %" PRIu64 " not a multiple of %" PRIu64, offset,
+               req->alignment);
+      return false;
+   }
+   if (offset > mem->allocation_size || req->size > mem->allocation_size - offset) {
+      snprintf(why, why_size, "%" PRIu64 " bytes at %" PRIu64 " past the memory's %" PRIu64,
+               req->size, offset, mem->allocation_size);
+      return false;
+   }
+   return true;
+}
+
 void
 vkr_device_memory_release(struct vkr_device_memory *mem)
 {
