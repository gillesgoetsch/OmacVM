+/* OmacVM (virgl-venus-device-lost-backoff.patch): one state for the whole VM (this QEMU
+ * process); vkr_restart_guard.h has the rules */
+static pthread_mutex_t vkr_restart_mutex = PTHREAD_MUTEX_INITIALIZER;
+static struct vkr_restart_guard vkr_restart;
+
+static uint64_t
+vkr_restart_now_ns(void)
+{
+   struct timespec ts;
+   clock_gettime(CLOCK_MONOTONIC, &ts);
+   return (uint64_t)ts.tv_sec * VKR_RESTART_GUARD_SEC + (uint64_t)ts.tv_nsec;
+}
+
+void
+vkr_device_note_lost(struct vkr_context *ctx, VkResult result, const char *where)
+{
+   if (result != VK_ERROR_DEVICE_LOST)
+      return;
+   pthread_mutex_lock(&vkr_restart_mutex);
+   const bool counted = vkr_restart_guard_lost(&vkr_restart, vkr_restart_now_ns());
+   const uint32_t strikes = vkr_restart.strikes;
+   const uint64_t hold = vkr_restart_guard_hold_ns(strikes) / VKR_RESTART_GUARD_SEC;
+   pthread_mutex_unlock(&vkr_restart_mutex);
+   if (counted)
+      vkr_log("%s: the Mac's driver lost the device of %s (%u lost device%s in this VM "
+              "lately): new Vulkan devices wait %" PRIu64 " s",
+              where, ctx && ctx->debug_name ? ctx->debug_name : "?", strikes,
+              strikes == 1 ? "" : "s", hold);
+}
+
+/* true when a new device may be made now; else the reply is VK_ERROR_INITIALIZATION_FAILED */
+static bool
+vkr_device_restart_ok(struct vkr_context *ctx)
+{
+   pthread_mutex_lock(&vkr_restart_mutex);
+   const uint64_t wait = vkr_restart_guard_wait_ns(&vkr_restart, vkr_restart_now_ns());
+   const uint32_t strikes = vkr_restart.strikes;
+   pthread_mutex_unlock(&vkr_restart_mutex);
+   if (!wait)
+      return true;
+   vkr_log("vkCreateDevice of %s refused: the Mac's driver lost devices of this VM "
+           "(%u time%s lately), new devices wait %" PRIu64 " s more",
+           ctx->debug_name ? ctx->debug_name : "?", strikes, strikes == 1 ? "" : "s",
+           (wait + VKR_RESTART_GUARD_SEC - 1) / VKR_RESTART_GUARD_SEC);
+   return false;
+}
+
 static void
 vkr_dispatch_vkCreateDevice(struct vn_dispatch_context *dispatch,
                             struct vn_command_vkCreateDevice *args)
 {
    struct vkr_context *ctx = dispatch->data;
 
+   /* OmacVM (virgl-venus-device-lost-backoff.patch) */
+   if (!vkr_device_restart_ok(ctx)) {
+      args->ret = VK_ERROR_INITIALIZATION_FAILED;
+      return;
+   }
+
    struct vkr_physical_device *physical_dev =
       vkr_physical_device_from_handle(args->physicalDevice);
    struct vn_physical_device_proc_table *vk = &physical_dev->proc_table;
@@ -551,6 +609,8 @@ vkr_device_destroy(struct vkr_context *ctx, struct vkr_device *dev, bool destroy
       VkResult result = vk->DeviceWaitIdle(device);
       if (result != VK_SUCCESS)
          vkr_log("vkDeviceWaitIdle(%p) failed(%d)", dev, (int32_t)result);
+      /* OmacVM (virgl-venus-device-lost-backoff.patch) */
+      vkr_device_note_lost(ctx, result, "vkDeviceWaitIdle");
    }
 
    mtx_destroy(&dev->object_mutex);
