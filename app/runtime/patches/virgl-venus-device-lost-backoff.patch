diff --git a/src/venus/vkr_restart_guard.h b/src/venus/vkr_restart_guard.h
new file mode 100644
index 0000000..0dd764d
--- /dev/null
+++ b/src/venus/vkr_restart_guard.h
@@ -0,0 +1,63 @@
+/* OmacVM (virgl-venus-device-lost-backoff.patch): when the Mac's driver reports a lost
+ * device (VK_ERROR_DEVICE_LOST on work of this VM), vkr refuses new Venus devices for a
+ * while, so a guest app that its harness or the guest starts again and again after each
+ * lost device does not go straight back to the driver. The first lost device holds new
+ * devices back for 10 s; each further one within 30 min doubles that, up to 10 min; 30 min
+ * without one starts at 10 s again. Reports within 2 s of the last counted one are the
+ * same loss (every queue, fence and context of the VM sees it) and count once. Devices that
+ * exist go on; the driver ends the ones it lost. The rules only: vkr_device.c keeps one state per
+ * QEMU process (one VM) under a mutex; Tests/virgl/test-venus-restart-guard.c checks them. */
+#ifndef VKR_RESTART_GUARD_H
+#define VKR_RESTART_GUARD_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#define VKR_RESTART_GUARD_SEC 1000000000ull
+#define VKR_RESTART_GUARD_FIRST_NS (10ull * VKR_RESTART_GUARD_SEC)
+#define VKR_RESTART_GUARD_MAX_NS (600ull * VKR_RESTART_GUARD_SEC)
+#define VKR_RESTART_GUARD_FORGET_NS (1800ull * VKR_RESTART_GUARD_SEC)
+#define VKR_RESTART_GUARD_SAME_NS (2ull * VKR_RESTART_GUARD_SEC)
+
+struct vkr_restart_guard {
+   uint32_t strikes;     /* lost devices counted (one per loss) */
+   uint64_t counted_ns;  /* when the last counted loss was reported */
+   uint64_t last_ns;     /* when the last report came */
+   uint64_t until_ns;    /* new devices are refused before this */
+};
+
+/* how long new devices wait after the n-th counted loss (n >= 1) */
+static inline uint64_t
+vkr_restart_guard_hold_ns(uint32_t strikes)
+{
+   uint64_t hold = VKR_RESTART_GUARD_FIRST_NS;
+   for (uint32_t i = 1; i < strikes && hold < VKR_RESTART_GUARD_MAX_NS; i++)
+      hold *= 2;
+   return hold < VKR_RESTART_GUARD_MAX_NS ? hold : VKR_RESTART_GUARD_MAX_NS;
+}
+
+/* a lost device reported at now_ns; true when it counts as a new loss */
+static inline bool
+vkr_restart_guard_lost(struct vkr_restart_guard *g, uint64_t now_ns)
+{
+   if (g->strikes && now_ns >= g->counted_ns && now_ns - g->counted_ns < VKR_RESTART_GUARD_SAME_NS) {
+      g->last_ns = now_ns;
+      return false;
+   }
+   if (g->strikes && now_ns >= g->last_ns && now_ns - g->last_ns >= VKR_RESTART_GUARD_FORGET_NS)
+      g->strikes = 0;
+   if (g->strikes < UINT32_MAX)
+      g->strikes++;
+   g->counted_ns = g->last_ns = now_ns;
+   g->until_ns = now_ns + vkr_restart_guard_hold_ns(g->strikes);
+   return true;
+}
+
+/* nanoseconds a new device must still wait at now_ns (0: it may be made) */
+static inline uint64_t
+vkr_restart_guard_wait_ns(const struct vkr_restart_guard *g, uint64_t now_ns)
+{
+   return now_ns < g->until_ns ? g->until_ns - now_ns : 0;
+}
+
+#endif
