  */
 static bool present_deep_failed;
 static unsigned present_next;
+/*
+ * OmacVM: partial present. A surface keeps what it showed last, so only what
+ * the guest changed since then is drawn into it again: the union of the
+ * guest's flush rects since that surface's last draw (omacvm-present-damage.h).
+ * Full draws for anything else: new surfaces, another frame size, scaling,
+ * the boot logo, another colour path, a scanout buffer not seen among the
+ * last few (a compositor's own buffers rotate; a new one, as when a client's
+ * buffer goes straight to the screen, may come with damage that is not
+ * relative to what was shown). Only the guest's GL scanout, at its full size,
+ * is drawn in part. Off (every frame in full, as before) unless
+ * OMACVM_GL_PRESENT_DAMAGE=1 or =check, until a VM run shows partial draws
+ * right (ADR 0051). Guests before Linux 7.4 flush the whole plane on every
+ * page flip; a buffer flushed again (boot console, a TTY) comes with real
+ * rects.
+ */
+static OmacvmPresentDamage present_pd;
+static int present_damage_on = -1;
+static uint64_t present_pd_sig = UINT64_MAX;
+#define PRESENT_PD_IDS 4
+static uint32_t present_pd_ids[PRESENT_PD_IDS];   /* scanout ids seen last */
+static bool present_pd_logged;
+/*
+ * The guest switched the scanout to another buffer and has not flushed it
+ * yet: its rects come with that flush, so a present before it (timer, new
+ * surfaces, the window showing again) draws the new buffer in full.
+ */
+static bool present_pd_unflushed;
+static GLuint present_pd_check_tex, present_pd_check_fbo;
+static GLuint present_pd_shown_tex, present_pd_shown_fbo;   /* =check: surface n, copied */
+static uint32_t present_pd_check_w, present_pd_check_h;
+static bool present_pd_check_half;
+static uint64_t present_pd_checks, present_pd_bad, present_pd_frames_part;
+/*
+ * =check: every partial frame is checked for a while after a full draw (new
+ * surfaces, buffers, colour paths: where a wrong box would show first), then
+ * every 30th. OMACVM_TEST_PRESENT_DAMAGE_FAULT=shrink (=check only) draws each
+ * box 1 px narrower, so a test can show that the check finds wrong pixels.
+ */
+static unsigned present_pd_check_burst;
+static bool present_pd_fault;
+/*
+ * qemu.log once a minute while frames come (STANDARDS 3: which path the
+ * frames took): frames drawn in part (and how many of those had nothing to
+ * draw), frames drawn in full and why. QEMU thread.
+ */
+enum {
+    PD_WHY_COPY, PD_WHY_SCALED, PD_WHY_REGION, PD_WHY_SIG, PD_WHY_NEWBUF,
+    PD_WHY_UNFLUSHED, PD_WHY_BIG, PD_WHY_CATCHUP, PD_WHY_N
+};
+static const char *const present_pd_why[PD_WHY_N] = {
+    "not a plain copy (boot logo, console, extra brightness)", "scaled",
+    "part of its resource", "colour path or size changed", "new buffer",
+    "buffer not flushed yet", "three quarters or more changed",
+    "catching up after a change",
+};
+static uint64_t present_pd_n_part, present_pd_n_empty, present_pd_n_full[PD_WHY_N];
+static uint64_t present_pd_px_part;    /* pixels drawn in part (the boxes) */
+static int64_t present_pd_stats_ns;
+static uint64_t present_pd_stats_sig = UINT64_MAX;
+
+/* QEMU thread: the counts above in qemu.log, at most once a minute. */
+static void present_pd_stats(uint32_t w, uint32_t h)
+{
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_REALTIME);
+    uint64_t full = 0;
+
+    if (!present_pd_stats_ns) {
+        present_pd_stats_ns = now;
+        return;
+    }
+    if (now - present_pd_stats_ns < 60 * NANOSECONDS_PER_SECOND) {
+        return;
+    }
+    GString *why = g_string_new(NULL);
+    for (int k = 0; k < PD_WHY_N; k++) {
+        if (present_pd_n_full[k]) {
+            g_string_append_printf(why, "%s%s %" PRIu64, full ? ", " : ": ",
+                                   present_pd_why[k], present_pd_n_full[k]);
+        }
+        full += present_pd_n_full[k];
+        present_pd_n_full[k] = 0;
+    }
+    uint64_t drawn = present_pd_n_part - present_pd_n_empty;
+    info_report("cocoa: partial present, last %" PRId64 " s: %" PRIu64 " frames in part"
+                " (%" PRIu64 " with nothing to draw, the others %" PRIu64 " px a box on average),"
+                " %" PRIu64 " in full%s; frame %ux%u, surfaces %ux%u",
+                (now - present_pd_stats_ns) / NANOSECONDS_PER_SECOND,
+                present_pd_n_part, present_pd_n_empty, drawn ? present_pd_px_part / drawn : 0,
+                full, why->str, w, h, present_w, present_h);
+    if (present_damage_on == 2) {
+        info_report("cocoa: present check, so far: %" PRIu64 " of %" PRIu64 " checks bad",
+                    present_pd_bad, present_pd_checks);
+    }
+    g_string_free(why, true);
+    present_pd_n_part = present_pd_n_empty = present_pd_px_part = 0;
+    present_pd_stats_ns = now;
+}
+
+/*
+ * OMACVM_GL_PRESENT_DAMAGE=check (tests): a frame drawn in part is also drawn
+ * in full into a texture of its own, and the two are compared pixel for
+ * pixel (colour only: the window ignores alpha). The texture has the format
+ * of surface N, read from it (half float for 'RGhA' and '&RhA': deep colour
+ * and extra brightness; else 8-bit), so both round alike when read back.
+ * Surface N itself is never read with glReadPixels (that crashes on a
+ * lossless-compressed one): the GPU copies it into a plain texture of the
+ * same format first, which is exact for both kinds (work/power-1116/rects:
+ * lbread.m). qemu.log gets each frame that differs and every 100th check.
+ * Reads back two whole frames: for tests, not for use. QEMU thread,
+ * present_ctx current, SRC bound as the present left it.
+ */
+static void cocoa_gl_present_pd_check(GLuint src, bool flip, unsigned n,
+                                      OmacvmPDRect box)
+{
+    uint32_t w = present_w, h = present_h;
+    size_t bytes = (size_t)w * h * 4;
+    OSType fmt = IOSurfaceGetPixelFormat(present_surf[n]);
+    bool half = fmt == 'RGhA' || fmt == '&RhA';
+    if (present_pd_check_w != w || present_pd_check_h != h ||
+        present_pd_check_half != half) {
+        if (present_pd_check_tex) {
+            glDeleteTextures(1, &present_pd_check_tex);
+            glDeleteTextures(1, &present_pd_shown_tex);
+        }
+        if (!present_pd_check_fbo) {
+            glGenFramebuffers(1, &present_pd_check_fbo);
+            glGenFramebuffers(1, &present_pd_shown_fbo);
+        }
+        glGenTextures(1, &present_pd_check_tex);
+        glGenTextures(1, &present_pd_shown_tex);
+        for (int k = 0; k < 2; k++) {
+            glBindTexture(GL_TEXTURE_RECTANGLE, k ? present_pd_shown_tex : present_pd_check_tex);
+            glTexImage2D(GL_TEXTURE_RECTANGLE, 0,
+                         half ? GL_RGBA16F : GL_RGBA8, w, h, 0,
+                         half ? GL_RGBA : GL_BGRA,
+                         half ? GL_HALF_FLOAT : GL_UNSIGNED_INT_8_8_8_8_REV,
+                         NULL);
+        }
+        glBindTexture(GL_TEXTURE_RECTANGLE, 0);
+        present_pd_check_w = w;
+        present_pd_check_h = h;
+        present_pd_check_half = half;
+    }
+    uint8_t *a = g_try_malloc(bytes), *b = g_try_malloc(bytes);
+    if (!a || !b) {
+        g_free(a);
+        g_free(b);
+        return;
+    }
+    glBindFramebuffer(GL_FRAMEBUFFER, present_pd_check_fbo);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                           GL_TEXTURE_RECTANGLE, present_pd_check_tex, 0);
+    glViewport(0, 0, w, h);
+    glDisable(GL_SCISSOR_TEST);
+    glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+    glClearColor(0, 0, 0, 1);
+    glClear(GL_COLOR_BUFFER_BIT);
+    glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_FALSE);
+    glBindTexture(GL_TEXTURE_2D, src);
+    qemu_gl_run_texture_blit(present_gls, flip);
+    glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+    glPixelStorei(GL_PACK_ALIGNMENT, 4);
+    glReadPixels(0, 0, w, h, GL_BGRA, GL_UNSIGNED_INT_8_8_8_8_REV, b);
+    /* surface n, copied on the GPU into the plain texture, then read */
+    glBindFramebuffer(GL_FRAMEBUFFER, present_pd_shown_fbo);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                           GL_TEXTURE_RECTANGLE, present_pd_shown_tex, 0);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, present_fbo);
+    glBlitFramebuffer(0, 0, w, h, 0, 0, w, h, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+    glBindFramebuffer(GL_FRAMEBUFFER, present_pd_shown_fbo);
+    glReadPixels(0, 0, w, h, GL_BGRA, GL_UNSIGNED_INT_8_8_8_8_REV, a);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                           GL_TEXTURE_RECTANGLE, 0, 0);
+    glBindFramebuffer(GL_FRAMEBUFFER, present_pd_check_fbo);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                           GL_TEXTURE_RECTANGLE, 0, 0);
+    uint64_t diff = 0;
+    uint32_t x0 = w, y0 = h, x1 = 0, y1 = 0;
+    for (uint32_t y = 0; y < h; y++) {
+        const uint8_t *pa = a + (size_t)y * w * 4, *pb = b + (size_t)y * w * 4;
+        for (uint32_t x = 0; x < w; x++) {
+            if (pa[4 * x] != pb[4 * x] || pa[4 * x + 1] != pb[4 * x + 1] ||
+                pa[4 * x + 2] != pb[4 * x + 2]) {
+                diff++;
+                x0 = MIN(x0, x); y0 = MIN(y0, y);
+                x1 = MAX(x1, x); y1 = MAX(y1, y);
+            }
+        }
+    }
+    g_free(a);
+    g_free(b);
+    present_pd_checks++;
+    if (diff) {
+        present_pd_bad++;
+        warn_report("cocoa: present check: %" PRIu64 " pixels differ in %ux%u+%u+%u "
+                    "(drawn: %ux%u+%u+%u; %" PRIu64 " of %" PRIu64 " checks bad)",
+                    diff, x1 - x0 + 1, y1 - y0 + 1, x0, y0, box.w, box.h, box.x, box.y,
+                    present_pd_bad, present_pd_checks);
+    } else if (present_pd_checks % 100 == 0) {
+        info_report("cocoa: present check: %" PRIu64 " of %" PRIu64 " checks bad",
+                    present_pd_bad, present_pd_checks);
+    }
+}
 static dispatch_queue_t present_queue;
 static QEMUTimer *present_timer;
 static int64_t present_last_ns;
@@ -7988,6 +8192,7 @@
     present_deep = deep;
     present_linear = linear;
     present_next = 0;
+    omacvm_pd_reset(&present_pd, present_nsurf, present_pd.fw, present_pd.fh);
     return true;
 }
 
