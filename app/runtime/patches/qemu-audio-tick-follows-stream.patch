+/*
+ * Under the audio lock: the period is the shortest any registered tick can
+ * take (0: not known, the shortest of all), in 1-10 ms.
+ */
+static void audio_rt_update_period(void)
+{
+    int64_t p = AUDIO_RT_PERIOD_MAX;
+    int i;
+
+    if (audio_rt_period_fixed) {
+        return;
+    }
+    for (i = 0; i < audio_rt_nticks; i++) {
+        int64_t m = audio_rt_ticks[i]->max_period_ns;
+
+        p = MIN(p, m > 0 ? m : AUDIO_RT_PERIOD_MIN);
+    }
+    audio_rt_period_ns = MAX(p, AUDIO_RT_PERIOD_MIN);
+}
