+/*
+ * The longest period this tick can take (0: not known). Any thread; also
+ * from a tick itself (the audio lock is recursive).
+ */
+void audio_rt_tick_set_max_period(AudioRtTick *t, int64_t ns)
+{
+    if (!audio_rt_enabled()) {
+        return;
+    }
+    qemu_rec_mutex_lock(&audio_rt_mutex);
