diff --git a/hw/audio/hda-codec.c b/hw/audio/hda-codec.c
index 0b312f1..33ee44d 100644
--- a/hw/audio/hda-codec.c
+++ b/hw/audio/hda-codec.c
@@ -317,30 +317,69 @@ static void hda_audio_input_cb(void *opaque, int avail)
 #define HDA_PACE_BURST (B_SIZE / 8)
 #define HDA_PACE_PRIME (250 * SCALE_MS)
 
+/*
+ * OmacVM (qemu-audio-tick-follows-stream.patch): on the sound's own thread a
+ * tick moves the guest's audio of a whole period (1-10 ms), not of 1 ms. The
+ * burst is a period plus the slack a late tick had at 1 ms, so a regular
+ * tick is never taken for a stall.
+ */
+static int64_t hda_audio_pace_burst(int64_t bps)
+{
+    int64_t extra = 0;
+
+    if (audio_rt_enabled() && audio_rt_period() > HDA_TIMER_TICKS) {
+        extra = muldiv64(audio_rt_period() - HDA_TIMER_TICKS, bps,
+                         NANOSECONDS_PER_SECOND) & -4;
+    }
+    return HDA_PACE_BURST + extra;
+}
+
+/*
+ * OmacVM: the longest tick this stream can take: a quarter of the guest's
+ * shortest DMA entry (its periods; the guest sees its position move once a
+ * tick) and at most an eighth of the codec's buffer, which a tick fills or
+ * drains. 0 (not known): the thread's shortest period.
+ */
+static int64_t hda_audio_max_period(HDAAudioStream *st)
+{
+    int64_t bps = hda_bytes_per_second(st);
+    uint32_t entry = hda_codec_min_entry(&st->state->hda, st->stream,
+                                         st->output);
+    int64_t bytes;
+
+    if (bps <= 0 || entry < 16) {
+        return 0;
+    }
+    bytes = MIN((int64_t)entry / 4, (int64_t)(B_SIZE / 8));
+    return muldiv64(bytes, NANOSECONDS_PER_SECOND, bps);
+}
+
 static int64_t hda_audio_output_pace(HDAAudioStream *st, int64_t now,
                                      int64_t wanted, int64_t to_transfer)
 {
     int64_t bps = hda_bytes_per_second(st);
+    int64_t burst;
 
     if (!st->state->pace || bps <= 0) {
         return to_transfer;
     }
+    burst = hda_audio_pace_burst(bps);
     if (!st->primed) {
         if (now - st->run_ns < HDA_PACE_PRIME) {
             st->pace_ns = now;
             return to_transfer;
         }
         st->primed = true;
-        st->budget = HDA_PACE_BURST;
+        st->budget = burst;
     }
     if (st->pace_ns && now > st->pace_ns) {
         st->budget += muldiv64(now - st->pace_ns, bps + bps / 32,
                                NANOSECONDS_PER_SECOND);
     }
     st->pace_ns = now;
-    st->budget = MIN(st->budget, (int64_t)HDA_PACE_BURST);
-    if (wanted - st->wpos > (int64_t)HDA_PACE_BURST) {
-        int64_t excess = wanted - st->wpos - HDA_PACE_BURST;
+    st->budget = MIN(st->budget, burst);
+    if (wanted - st->wpos > burst) {
+        int64_t excess = wanted - st->wpos - burst;
 
         st->buft_start += muldiv64(excess, NANOSECONDS_PER_SECOND, bps);
         trace_hda_audio_pace_forgive(st->node->name, excess);
@@ -451,6 +490,8 @@ static void hda_audio_set_running(HDAAudioStream *st, bool running)
         st->budget = 0;
         if (audio_rt_enabled()) {
             /* OmacVM: the guest's DMA moves on the sound's own thread. */
+            audio_rt_tick_set_max_period(&st->rt_tick,
+                                         hda_audio_max_period(st));
             audio_rt_tick_add(&st->rt_tick, st->output ? hda_audio_output_timer
                                                        : hda_audio_input_timer,
                               st);
diff --git a/hw/audio/intel-hda.c b/hw/audio/intel-hda.c
index 8c6cee4..effadbc 100644
--- a/hw/audio/intel-hda.c
+++ b/hw/audio/intel-hda.c
@@ -115,6 +115,16 @@ bool hda_codec_xfer(HDACodecDevice *dev, uint32_t stnr, bool output,
     return bus->xfer(dev, stnr, output, buf, len);
 }
 
+/*
+ * OmacVM: the shortest DMA entry, in bytes, of the stream the guest runs as
+ * stnr (0: none, or not known). The codec ticks at a fraction of it.
+ */
+uint32_t hda_codec_min_entry(HDACodecDevice *dev, uint32_t stnr, bool output)
+{
+    HDACodecBus *bus = HDA_BUS(dev->qdev.parent_bus);
+    return bus->min_entry ? bus->min_entry(dev, stnr, output) : 0;
+}
+
 /* --------------------------------------------------------------------- */
 /* intel hda emulation                                                   */
 
@@ -536,6 +546,35 @@ static bool intel_hda_xfer(HDACodecDevice *dev, uint32_t stnr, bool output,
     return true;
 }
 
+/*
+ * OmacVM: the shortest entry of the stream's buffer list as parsed when the
+ * guest started it (guest values: only their minimum is used, 0 = not known),
+ * at most the stream's cyclic buffer. Under the audio lock (MMIO takes it).
+ */
+static uint32_t intel_hda_min_entry(HDACodecDevice *dev, uint32_t stnr,
+                                    bool output)
+{
+    HDACodecBus *bus = HDA_BUS(dev->qdev.parent_bus);
+    IntelHDAState *d = container_of(bus, IntelHDAState, codecs);
+    IntelHDAStream *st = output ? d->st + 4 : d->st;
+    uint32_t s, i, len;
+
+    for (s = 0; s < 4; s++) {
+        if (stnr == ((st[s].ctl >> 20) & 0x0f)) {
+            break;
+        }
+    }
+    if (s == 4 || st[s].bpl == NULL || !st[s].bentries) {
+        return 0;
+    }
+    st += s;
+    len = st->cbl;
+    for (i = 0; i < st->bentries; i++) {
+        len = MIN(len, st->bpl[i].len);
+    }
+    return len;
+}
+
 static void intel_hda_parse_bdl(IntelHDAState *d, IntelHDAStream *st)
 {
     const MemTxAttrs attrs = { .memory = true };
@@ -1213,6 +1252,7 @@ static void intel_hda_realize(PCIDevice *pci, Error **errp)
 
     hda_codec_bus_init(DEVICE(pci), &d->codecs, sizeof(d->codecs),
                        intel_hda_response, intel_hda_xfer);
+    d->codecs.min_entry = intel_hda_min_entry;
     d->irq_bh = qemu_bh_new_guarded(intel_hda_irq_bh, d,
                                     &DEVICE(d)->mem_reentrancy_guard);
 }
