+
+/* a decoration this scan keeps: SpecId, Binding or DescriptorSet with its value; Location,
+ * BuiltIn (a member's too, under its struct's id), Patch, PerVertexKHR, PerTaskNV or Block */
+struct deco {
+   uint32_t id, kind, value;
+};
+
+/* a LocalSize or LocalSizeId execution mode */
+struct mode {
+   uint32_t function, kind, v[3];
+};
+
+/* a pointer type: its id, pointee and storage class */
+struct pointer {
+   uint32_t id, pointee, storage;
+};
+
+/* a Function, Private or Workgroup variable: its id, the function it is in (0: none), its
+ * pointer type, or (untyped) its data type */
+struct local {
+   uint32_t id, function, type;
+   bool pointer;
+};
+
+/* an Input or Output variable as declared */
+struct io {
+   uint32_t id, type, storage;
+   bool pointer;
+};
+
+/* a growing array */
+struct vec {
+   void *p;
+   uint32_t n, cap;
+};
+
+struct scan {
+   const uint32_t *w;
+   size_t n; /* words */
+   uint32_t bound;
+   char *why;
+   size_t why_size;
+   struct vkr_spirv_info *info;
+   struct vec entries, names, decos, modes, consts, composites, functions, calls, uses;
+   struct vec scalars, bools, spec_ops;
+   struct vec types, members, pointers, locals, shared, ios, interface;
+   /* per id (bound entries): a type's weight (0: not a type), a value's type, struct types */
+   uint32_t *weight, *type_of;
+   uint8_t *is_struct;
+   uint64_t cost;
+   uint32_t workgroup_composite;
+   uint32_t function; /* the function the instruction is in, or 0 */
+};
+
+static bool
+fail(struct scan *s, const char *msg, size_t at)
+{
+   snprintf(s->why, s->why_size, "SPIR-V: %s (word %zu)", msg, at);
+   return false;
+}
+
+/* room for `count` more elements of `elem` bytes */
+static void *
+vec_add(struct vec *v, uint32_t count, size_t elem)
+{
+   /* an empty vec gets room even for 0, never NULL + 0 */
+   if (!v->p || v->n + (uint64_t)count > v->cap) {
+      uint64_t c = v->cap ? v->cap : 16;
+      while (c < v->n + (uint64_t)count)
+         c *= 2;
+      if (c > UINT32_MAX)
+         return NULL;
+      void *q = realloc(v->p, (size_t)c * elem);
+      if (!q)
+         return NULL;
+      v->p = q;
+      v->cap = (uint32_t)c;
+   }
+   void *at = (char *)v->p + (size_t)v->n * elem;
+   v->n += count;
+   return at;
+}
+
+static int
+cmp_u32(const void *a, const void *b)
+{
+   const uint32_t x = *(const uint32_t *)a, y = *(const uint32_t *)b;
+   return x < y ? -1 : x > y;
+}
+
+/* elements whose first uint32 is the key, sorted: the first with `key`, or NULL */
+static const void *
+find(const struct vec *v, size_t elem, uint32_t key)
+{
+   uint32_t lo = 0, hi = v->n;
+   while (lo < hi) {
+      const uint32_t mid = lo + (hi - lo) / 2;
+      const uint32_t k = *(const uint32_t *)((const char *)v->p + (size_t)mid * elem);
+      if (k < key)
+         lo = mid + 1;
+      else
+         hi = mid;
+   }
+   if (lo < v->n && *(const uint32_t *)((const char *)v->p + (size_t)lo * elem) == key)
+      return (const char *)v->p + (size_t)lo * elem;
+   return NULL;
+}
+
+/* a literal string in words [at, end): its length, or -1 when it does not end there */
+static int
+string_len(const struct scan *s, size_t at, size_t end)
+{
+   const char *p = (const char *)&s->w[at];
+   const void *nul = memchr(p, 0, (end - at) * 4);
+   return nul ? (int)((const char *)nul - p) : -1;
+}
+
+static bool
+id_ok(const struct scan *s, uint32_t id)
+{
+   return id && id < s->bound;
+}
+
+/* a function names id in a pointer instruction (outside functions nothing is used) */
+static bool
+use(struct scan *s, uint32_t id)
+{
+   if (!s->function)
+      return true;
+   struct vkr_spirv_pair *u = vec_add(&s->uses, 1, sizeof(*u));
+   if (u)
+      *u = (struct vkr_spirv_pair){ s->function, id };
+   return u != NULL;
+}
+
+/* the id operands of a spec constant operation this scan evaluates (CompositeExtract: its
+ * composite, then index literals); 0 for any other operation (VectorShuffle, CompositeInsert,
+ * QuantizeToF16, FConvert, the Kernel ones) */
+static uint32_t
+spec_op_ids(uint32_t opcode)
+{
+   switch (opcode) {
+   case OP_U_CONVERT:
+   case OP_S_CONVERT:
+   case OP_S_NEGATE:
+   case OP_NOT:
+   case OP_LOGICAL_NOT:
+   case OP_COMPOSITE_EXTRACT:
+      return 1;
+   case OP_I_ADD:
+   case OP_I_SUB:
+   case OP_I_MUL:
+   case OP_U_DIV:
+   case OP_S_DIV:
+   case OP_U_MOD:
+   case OP_S_REM:
+   case OP_S_MOD:
+   case OP_LOGICAL_EQUAL:
+   case OP_LOGICAL_NOT_EQUAL:
+   case OP_LOGICAL_OR:
+   case OP_LOGICAL_AND:
+   case OP_SHIFT_RIGHT_LOGICAL:
+   case OP_SHIFT_RIGHT_ARITHMETIC:
+   case OP_SHIFT_LEFT_LOGICAL:
+   case OP_BITWISE_OR:
+   case OP_BITWISE_XOR:
+   case OP_BITWISE_AND:
+      return 2;
+   case OP_SELECT:
+      return 3;
+   default:
+      return opcode >= OP_I_EQUAL && opcode <= OP_S_LESS_THAN_EQUAL ? 2 : 0;
+   }
+}
+
+static bool
+record(struct scan *s, size_t at, uint32_t op, uint32_t len)
+{
+   const uint32_t *w = &s->w[at];
+   switch (op) {
+   case OP_ENTRY_POINT: {
+      if (len < 4 || !id_ok(s, w[2]))
+         return fail(s, "an entry point without a function or name", at);
+      const int nl = string_len(s, at + 3, at + len);
+      if (nl < 0)
+         return fail(s, "an entry point name that does not end", at);
+      struct vkr_spirv_entry *e = vec_add(&s->entries, 1, sizeof(*e));
+      char *name = vec_add(&s->names, (uint32_t)nl + 1, 1);
+      if (!e || !name)
+         return fail(s, "out of host memory", at);
+      memset(e, 0, sizeof(*e));
+      e->model = w[1];
+      e->function = w[2];
+      e->name = (uint32_t)(name - (char *)s->names.p);
+      memcpy(name, &w[3], (size_t)nl + 1);
+      for (size_t i = 3 + ((size_t)nl + 4) / 4; i < len; i++) {
+         if (!id_ok(s, w[i]))
+            return fail(s, "an entry point interface id past the bound", at);
+         struct vkr_spirv_pair *p = vec_add(&s->interface, 1, sizeof(*p));
+         if (!p)
+            return fail(s, "out of host memory", at);
+         *p = (struct vkr_spirv_pair){ s->entries.n - 1, w[i] };
+      }
+      return true;
+   }
+   case OP_EXECUTION_MODE:
+   case OP_EXECUTION_MODE_ID: {
+      if (len < 3 || !id_ok(s, w[1]))
+         return fail(s, "an execution mode without an entry point", at);
+      if (!((op == OP_EXECUTION_MODE && w[2] == MODE_LOCAL_SIZE) ||
+            (op == OP_EXECUTION_MODE_ID && w[2] == MODE_LOCAL_SIZE_ID)))
+         return true;
+      if (len != 6)
+         return fail(s, "a workgroup size without three values", at);
+      if (op == OP_EXECUTION_MODE_ID && (!id_ok(s, w[3]) || !id_ok(s, w[4]) || !id_ok(s, w[5])))
+         return fail(s, "a workgroup size id past the bound", at);
+      struct mode *m = vec_add(&s->modes, 1, sizeof(*m));
+      if (!m)
+         return fail(s, "out of host memory", at);
+      *m = (struct mode){ .function = w[1], .kind = op == OP_EXECUTION_MODE ? 1 : 2 };
+      memcpy(m->v, &w[3], sizeof(m->v));
+      return true;
+   }
+   case OP_DECORATE:
+      if (len < 3 || !id_ok(s, w[1]))
+         return fail(s, "a decoration of an id past the bound", at);
+      if (w[2] == DEC_BUILT_IN && len >= 4 && w[3] == BUILT_IN_WORKGROUP_SIZE) {
+         s->workgroup_composite = w[1];
+      } else if (w[2] == DEC_SPEC_ID || w[2] == DEC_BINDING || w[2] == DEC_DESCRIPTOR_SET ||
+                 w[2] == DEC_LOCATION) {
+         if (len < 4)
+            return fail(s, "a decoration without its value", at);
+         struct deco *d = vec_add(&s->decos, 1, sizeof(*d));
+         if (!d)
+            return fail(s, "out of host memory", at);
+         *d = (struct deco){ w[1], w[2], w[3] };
+      } else if (w[2] == DEC_BUILT_IN || w[2] == DEC_PATCH || w[2] == DEC_PER_VERTEX ||
+                 w[2] == DEC_PER_TASK || w[2] == DEC_BLOCK) {
+         struct deco *d = vec_add(&s->decos, 1, sizeof(*d));
+         if (!d)
+            return fail(s, "out of host memory", at);
+         *d = (struct deco){ w[1], w[2], 0 };
+      }
+      return true;
+   case OP_MEMBER_DECORATE:
+      /* a struct with a BuiltIn member is a built-in block: kept as BuiltIn on the struct */
+      if (len >= 4 && w[3] == DEC_BUILT_IN && id_ok(s, w[1])) {
+         struct deco *d = vec_add(&s->decos, 1, sizeof(*d));
+         if (!d)
+            return fail(s, "out of host memory", at);
+         *d = (struct deco){ w[1], DEC_BUILT_IN, 0 };
+      }
+      return true;
+   case OP_CONSTANT:
+   case OP_SPEC_CONSTANT: {
+      if (len < 4 || !id_ok(s, w[2]))
+         return fail(s, "a constant without a value", at);
+      struct vkr_spirv_constant *c = vec_add(&s->consts, 1, sizeof(*c));
+      if (!c)
+         return fail(s, "out of host memory", at);
+      /* spec_id 0 marks a spec constant until the SpecId decorations are joined */
+      *c = (struct vkr_spirv_constant){ .id = w[2], .spec_id = op == OP_CONSTANT ? UINT32_MAX : 0,
+                                        .value = w[3], .high = len >= 5 ? w[4] : 0, .type = w[1],
+                                        .at = (uint32_t)at, .wide = len >= 5 };
+      return true;
+   }
+   /* what a spec constant operation is evaluated from (OmacVM 3.4.5, #624): bool types and
+    * constants and the operations, kept without refusing anything (spirv-val checks them) */
+   case OP_TYPE_BOOL:
+      if (len >= 2 && id_ok(s, w[1])) {
+         struct vkr_spirv_scalar *t = vec_add(&s->scalars, 1, sizeof(*t));
+         if (!t)
+            return fail(s, "out of host memory", at);
+         *t = (struct vkr_spirv_scalar){ .id = w[1], .width = 1, .boolean = true };
+      }
+      return true;
+   case OP_CONSTANT_TRUE:
+   case OP_CONSTANT_FALSE:
+   case OP_SPEC_CONSTANT_TRUE:
+   case OP_SPEC_CONSTANT_FALSE:
+      if (len >= 3 && id_ok(s, w[2])) {
+         struct vkr_spirv_constant *c = vec_add(&s->bools, 1, sizeof(*c));
+         if (!c)
+            return fail(s, "out of host memory", at);
+         const bool spec = op == OP_SPEC_CONSTANT_TRUE || op == OP_SPEC_CONSTANT_FALSE;
+         *c = (struct vkr_spirv_constant){ .id = w[2], .spec_id = spec ? 0 : UINT32_MAX,
+                                           .value = op == OP_CONSTANT_TRUE || op == OP_SPEC_CONSTANT_TRUE,
+                                           .type = w[1], .at = (uint32_t)at };
+      }
+      return true;
+   case OP_SPEC_CONSTANT_OP: {
+      if (len < 4 || !id_ok(s, w[2]))
+         return true;
+      struct vkr_spirv_spec_op *o = vec_add(&s->spec_ops, 1, sizeof(*o));
+      if (!o)
+         return fail(s, "out of host memory", at);
+      const uint32_t words = len - 4, ids = spec_op_ids(w[3]);
+      *o = (struct vkr_spirv_spec_op){ .id = w[2], .type = w[1], .opcode = w[3],
+                                       .n = words < 3 ? words : 3, .at = (uint32_t)at };
+      memcpy(o->operand, &w[4], o->n * sizeof(uint32_t));
+      /* malformed: n 0. Only the id operands are ids (CompositeExtract's indices are
+       * literals: glslang's gl_WorkGroupSize.x is index 0) */
+      if (ids && (w[3] == OP_COMPOSITE_EXTRACT ? words < 2 : words != ids))
+         o->n = 0;
+      for (uint32_t i = 0; i < ids && i < o->n; i++) {
+         if (!id_ok(s, o->operand[i]))
+            o->n = 0;
+      }
+      return true;
+   }
+   /* what variables' elements and locations are counted through */
+   case OP_TYPE_INT:
+   case OP_TYPE_FLOAT:
+   case OP_TYPE_VECTOR:
+   case OP_TYPE_MATRIX:
+   case OP_TYPE_RUNTIME_ARRAY: {
+      if (len < 3 || !id_ok(s, w[1]))
+         return fail(s, "a type without an id", at);
+      if (op == OP_TYPE_INT && len >= 4) {
+         struct vkr_spirv_scalar *i = vec_add(&s->scalars, 1, sizeof(*i));
+         if (!i)
+            return fail(s, "out of host memory", at);
+         *i = (struct vkr_spirv_scalar){ .id = w[1], .width = w[2], .sign = w[3] != 0 };
+      }
+      struct vkr_spirv_type *t = vec_add(&s->types, 1, sizeof(*t));
+      if (!t)
+         return fail(s, "out of host memory", at);
+      const uint32_t kind = op == OP_TYPE_INT || op == OP_TYPE_FLOAT ? VKR_SPIRV_TYPE_SCALAR
+                            : op == OP_TYPE_VECTOR                  ? VKR_SPIRV_TYPE_VECTOR
+                            : op == OP_TYPE_MATRIX                  ? VKR_SPIRV_TYPE_MATRIX
+                                                                    : VKR_SPIRV_TYPE_RUNTIME_ARRAY;
+      *t = (struct vkr_spirv_type){ w[1], kind, w[2], len >= 4 ? w[3] : 0 };
+      return true;
+   }
+   case OP_TYPE_ARRAY: {
+      if (len != 4 || !id_ok(s, w[1]) || !id_ok(s, w[2]) || !id_ok(s, w[3]))
+         return fail(s, "an array type without its element and length", at);
+      struct vkr_spirv_type *t = vec_add(&s->types, 1, sizeof(*t));
+      if (!t)
+         return fail(s, "out of host memory", at);
+      *t = (struct vkr_spirv_type){ w[1], VKR_SPIRV_TYPE_ARRAY, w[2], w[3] };
+      return true;
+   }
+   case OP_TYPE_STRUCT: {
+      if (len < 2 || !id_ok(s, w[1]))
+         return fail(s, "a struct type without an id", at);
+      for (uint32_t i = 2; i < len; i++) {
+         if (!id_ok(s, w[i]))
+            return fail(s, "a struct member past the bound", at);
+      }
+      const uint32_t first = s->members.n;
+      struct vkr_spirv_type *t = vec_add(&s->types, 1, sizeof(*t));
+      uint32_t *m = vec_add(&s->members, len - 2, sizeof(*m));
+      if (!t || (len > 2 && !m))
+         return fail(s, "out of host memory", at);
+      *t = (struct vkr_spirv_type){ w[1], VKR_SPIRV_TYPE_STRUCT, first, len - 2 };
+      if (len > 2)
+         memcpy(m, &w[2], (size_t)(len - 2) * sizeof(*m));
+      return true;
+   }
+   case OP_TYPE_POINTER:
+      if (len == 4) {
+         struct pointer *p = vec_add(&s->pointers, 1, sizeof(*p));
+         if (!p)
+            return fail(s, "out of host memory", at);
+         *p = (struct pointer){ w[1], w[3], w[2] };
+      }
+      return true;
+   case OP_VARIABLE:
+   case OP_UNTYPED_VARIABLE:
+      if (len < 4)
+         return fail(s, "a variable without a storage class", at);
+      /* an untyped variable's elements are its data type's, when it has one. Private
+       * variables are per invocation like Function ones and counted with them; Workgroup
+       * ones in bytes (vkr_spirv_workgroup_bytes) */
+      if ((w[3] == STORAGE_FUNCTION || w[3] == STORAGE_PRIVATE || w[3] == STORAGE_WORKGROUP) &&
+          (op == OP_VARIABLE || len >= 5)) {
+         struct local *l =
+            vec_add(w[3] == STORAGE_WORKGROUP ? &s->shared : &s->locals, 1, sizeof(*l));
+         if (!l)
+            return fail(s, "out of host memory", at);
+         *l = (struct local){ w[2], s->function, op == OP_VARIABLE ? w[1] : w[4],
+                              op == OP_VARIABLE };
+      }
+      if ((w[3] == STORAGE_INPUT || w[3] == STORAGE_OUTPUT) && id_ok(s, w[2]) &&
+          (op == OP_VARIABLE || len >= 5)) {
+         struct io *v = vec_add(&s->ios, 1, sizeof(*v));
+         if (!v)
+            return fail(s, "out of host memory", at);
+         *v = (struct io){ w[2], op == OP_VARIABLE ? w[1] : w[4], w[3], op == OP_VARIABLE };
+      }
+      return true;
+   case OP_FUNCTION: {
+      if (len < 5 || !id_ok(s, w[2]) || s->function)
+         return fail(s, "a function without an id or inside another", at);
+      uint32_t *f = vec_add(&s->functions, 1, sizeof(*f));
+      if (!f)
+         return fail(s, "out of host memory", at);
+      *f = s->function = w[2];
+      return true;
+   }
+   case OP_FUNCTION_END:
+      s->function = 0;
+      return true;
+   case OP_CONSTANT_COMPOSITE:
+   case OP_SPEC_CONSTANT_COMPOSITE:
+      if (len < 3 || !id_ok(s, w[2]))
+         return fail(s, "a composite without an id", at);
+      for (uint32_t i = 3; i < len; i++) {
+         if (!id_ok(s, w[i]))
+            return fail(s, "a composite constituent past the bound", at);
+      }
+      /* kept whatever the order of the decoration: the join finds the WorkgroupSize one */
+      {
+         struct vkr_spirv_composite *c = vec_add(&s->composites, 1, sizeof(*c));
+         if (!c)
+            return fail(s, "out of host memory", at);
+         *c = (struct vkr_spirv_composite){ .id = w[2], .count = len - 3, .at = (uint32_t)at };
+         if (len == 6)
+            memcpy(c->v, &w[3], sizeof(c->v));
+      }
+      return true;
+   /* instructions that take pointers: a descriptor variable they name is used (the pointer
+    * operand at word 3, at word 1 for stores; every operand of calls, selects, phis and
+    * pointer comparisons). Names, decorations and debug instructions are no use. */
+   case OP_LOAD:
+   case OP_ACCESS_CHAIN:
+   case OP_IN_BOUNDS_ACCESS_CHAIN:
+   case OP_PTR_ACCESS_CHAIN:
+   case OP_IN_BOUNDS_PTR_ACCESS_CHAIN:
+   case OP_IMAGE_TEXEL_POINTER:
+   case OP_ARRAY_LENGTH:
+   case OP_COPY_OBJECT:
+   case OP_COPY_LOGICAL:
+   case OP_CONVERT_PTR_TO_U:
+   case OP_PTR_CAST_TO_GENERIC:
+   case OP_GENERIC_CAST_TO_PTR:
+   case OP_BITCAST:
+   case OP_ATOMIC_LOAD:
+   case OP_ATOMIC_FLAG_TEST_AND_SET:
+   case OP_ATOMIC_FMIN:
+   case OP_ATOMIC_FMAX:
+   case OP_ATOMIC_FADD:
+   case OP_COOPERATIVE_MATRIX_LOAD:
+      return len < 4 || use(s, w[3]) || fail(s, "out of host memory", at);
+   case OP_STORE:
+   case OP_COPY_MEMORY:
+   case OP_COPY_MEMORY_SIZED:
+   case OP_ATOMIC_STORE:
+   case OP_ATOMIC_FLAG_CLEAR:
+   case OP_COOPERATIVE_MATRIX_STORE:
+      for (uint32_t i = 1; i < len && i < 3; i++) {
+         if (!use(s, w[i]))
+            return fail(s, "out of host memory", at);
+      }
+      return true;
+   case OP_SELECT:
+   case OP_PTR_EQUAL:
+   case OP_PTR_NOT_EQUAL:
+   case OP_PTR_DIFF:
+   case OP_PHI:
+   case OP_FUNCTION_CALL:
+      if (op == OP_FUNCTION_CALL && s->function && len >= 4) {
+         struct vkr_spirv_pair *c = vec_add(&s->calls, 1, sizeof(*c));
+         if (!c)
+            return fail(s, "out of host memory", at);
+         *c = (struct vkr_spirv_pair){ s->function, w[3] };
+      }
+      for (uint32_t i = op == OP_FUNCTION_CALL ? 4 : 3; i < len; i++) {
+         if (!use(s, w[i]))
+            return fail(s, "out of host memory", at);
+      }
+      return true;
+   default:
+      if (op >= OP_ATOMIC_EXCHANGE && op <= OP_ATOMIC_XOR)
+         return len < 4 || use(s, w[3]) || fail(s, "out of host memory", at);
+      return true;
+   }
+}
+
+static bool
+is_type(uint32_t op)
+{
+   return (op >= OP_TYPE_VOID && op <= OP_TYPE_PIPE) || op == OP_TYPE_PIPE_STORAGE ||
+          op == OP_TYPE_NAMED_BARRIER || op == OP_TYPE_UNTYPED_POINTER ||
+          op == OP_TYPE_COOPERATIVE_MATRIX || op == OP_TYPE_RAY_QUERY || op == OP_TYPE_VECTOR_ID ||
+          op == OP_TYPE_ACCELERATION_STRUCTURE || op == OP_TYPE_COOPERATIVE_MATRIX_NV;
+}
+
+/* a type's weight, 1 for an id that is none (yet) */
+static uint64_t
+weight(const struct scan *s, uint32_t id)
+{
+   return id < s->bound && s->weight[id] ? s->weight[id] : 1;
+}
+
+/* What spirv-val's walks over types may cost (vkr_spirv.h, VKR_SPIRV_MAX_TYPE_COST; refused
+ * in vkr_spirv_validate.c). A type
+ * weighs 1 plus its parts: an element, a pointee, members, a function's return and
+ * parameters; an array of structs 16 times its element (the layout check walks up to 16 of
+ * them, each one again). Every instruction then costs the weights of the types it names
+ * and of the values it reads; debug instructions cost nothing. Types come before their
+ * use (a forward pointer's pointee weighs 1), so one pass suffices. */
+static bool
+instruction(struct scan *s, size_t at, uint32_t op, uint32_t len)
+{
+   const uint32_t *w = &s->w[at];
+   if (!(op >= OP_SOURCE_CONTINUED && op <= OP_LINE) && op != OP_NO_LINE &&
+       op != OP_MODULE_PROCESSED) {
+      for (uint32_t i = 1; i < len; i++) {
+         if (!w[i] || w[i] >= s->bound)
+            continue;
+         const uint32_t t = s->weight[w[i]] ? w[i] : s->type_of[w[i]];
+         s->cost += t ? s->weight[t] : 0;
+      }
+   }
+   if (!record(s, at, op, len))
+      return false;
+   if (is_type(op) && len >= 2 && id_ok(s, w[1])) {
+      uint64_t n = 1;
+      switch (op) {
+      case OP_TYPE_ARRAY:
+         n += len >= 3 ? (s->is_struct[w[2] < s->bound ? w[2] : 0] ? 16 : 1) * weight(s, w[2]) : 0;
+         break;
+      case OP_TYPE_POINTER:
+         n += len >= 4 ? weight(s, w[3]) : 0;
+         break;
+      case OP_TYPE_STRUCT:
+      case OP_TYPE_FUNCTION:
+         for (uint32_t i = 2; i < len; i++)
+            n += weight(s, w[i]);
+         break;
+      case OP_TYPE_VECTOR:
+      case OP_TYPE_MATRIX:
+      case OP_TYPE_IMAGE:
+      case OP_TYPE_SAMPLED_IMAGE:
+      case OP_TYPE_RUNTIME_ARRAY:
+      case OP_TYPE_COOPERATIVE_MATRIX:
+      case OP_TYPE_VECTOR_ID:
+      case OP_TYPE_COOPERATIVE_MATRIX_NV:
+         n += len >= 3 ? weight(s, w[2]) : 0;
+         break;
+      default:
+         break;
+      }
+      s->weight[w[1]] = n < UINT32_MAX ? (uint32_t)n : UINT32_MAX;
+      s->is_struct[w[1]] = op == OP_TYPE_STRUCT;
+   } else if ((op == OP_UNDEF || op == OP_EXT_INST || op >= OP_CONSTANT_TRUE) &&
+              !(op >= OP_DECORATE && op <= OP_GROUP_MEMBER_DECORATE) && op != OP_DECORATE_ID &&
+              op != OP_DECORATE_STRING && op != OP_MEMBER_DECORATE_STRING && len >= 3 &&
+              w[1] < s->bound && s->weight[w[1]] && id_ok(s, w[2]) && !s->weight[w[2]]) {
+      /* a value: its type is word 1 */
+      s->type_of[w[2]] = w[1];
+   }
+   return true;
+}
+
+/* the joins: execution modes into entries, SpecIds into constants, used descriptor
+ * variables into bindings */
+static bool
+join(struct scan *s)
+{
+   struct vkr_spirv_info *info = s->info;
+   /* not the entry points' interfaces: from SPIR-V 1.4 they list globals, but glslang lists
+    * unused ones too, which a valid pipeline layout need not have */
+   qsort(s->modes.p, s->modes.n, sizeof(struct mode), cmp_u32);
+   qsort(s->decos.p, s->decos.n, sizeof(struct deco), cmp_u32);
+   qsort(s->consts.p, s->consts.n, sizeof(struct vkr_spirv_constant), cmp_u32);
+   qsort(s->composites.p, s->composites.n, sizeof(struct vkr_spirv_composite), cmp_u32);
+   qsort(s->scalars.p, s->scalars.n, sizeof(struct vkr_spirv_scalar), cmp_u32);
+   qsort(s->bools.p, s->bools.n, sizeof(struct vkr_spirv_constant), cmp_u32);
+   qsort(s->spec_ops.p, s->spec_ops.n, sizeof(struct vkr_spirv_spec_op), cmp_u32);
+   qsort(s->functions.p, s->functions.n, sizeof(uint32_t), cmp_u32);
+   qsort(s->calls.p, s->calls.n, sizeof(struct vkr_spirv_pair), cmp_u32);
+   qsort(s->uses.p, s->uses.n, sizeof(struct vkr_spirv_pair), cmp_u32);
+   qsort(s->types.p, s->types.n, sizeof(struct vkr_spirv_type), cmp_u32);
+   qsort(s->pointers.p, s->pointers.n, sizeof(struct pointer), cmp_u32);
+
+   struct vkr_spirv_entry *entries = s->entries.p;
+   for (uint32_t i = 0; i < s->entries.n; i++) {
+      const struct mode *m = find(&s->modes, sizeof(*m), entries[i].function);
+      if (!m)
+         continue;
+      entries[i].local_size_kind = (uint8_t)m->kind;
+      memcpy(m->kind == 1 ? entries[i].local_size : entries[i].local_size_id, m->v, sizeof(m->v));
+   }
+   /* a spec constant's SpecId: the decorations of its id (sorted by id, any kind); a bool
+    * one's too */
+   const struct deco *decos = s->decos.p;
+   for (int list = 0; list < 2; list++) {
+      struct vkr_spirv_constant *consts = list ? s->bools.p : s->consts.p;
+      const uint32_t count = list ? s->bools.n : s->consts.n;
+      for (uint32_t i = 0; i < count; i++) {
+         if (consts[i].spec_id == UINT32_MAX)
+            continue;
+         consts[i].spec_id = UINT32_MAX - 1; /* no SpecId: its default value only */
+         for (const struct deco *d = find(&s->decos, sizeof(*d), consts[i].id);
+              d && d < decos + s->decos.n && d->id == consts[i].id; d++) {
+            if (d->kind == DEC_SPEC_ID)
+               consts[i].spec_id = d->value;
+         }
+      }
+   }
+   /* descriptor variables: ids with a DescriptorSet decoration (sorted by id) */
+   struct vec vars = { 0 };
+   for (uint32_t i = 0; i < s->decos.n;) {
+      const uint32_t id = decos[i].id;
+      uint32_t set = UINT32_MAX, binding = 0;
+      for (; i < s->decos.n && decos[i].id == id; i++) {
+         if (decos[i].kind == DEC_DESCRIPTOR_SET)
+            set = decos[i].value;
+         else if (decos[i].kind == DEC_BINDING)
+            binding = decos[i].value;
+      }
+      if (set == UINT32_MAX)
+         continue;
+      struct vkr_spirv_var *v = vec_add(&vars, 1, sizeof(*v));
+      if (!v) {
+         free(vars.p);
+         return fail(s, "out of host memory", 0);
+      }
+      *v = (struct vkr_spirv_var){ id, set, binding };
+   }
+   info->entries = s->entries.p;
+   info->entry_count = s->entries.n;
+   info->names = s->names.p;
+   info->constants = s->consts.p;
+   info->constant_count = s->consts.n;
+   info->scalars = s->scalars.p;
+   info->scalar_count = s->scalars.n;
+   info->bools = s->bools.p;
+   info->bool_count = s->bools.n;
+   info->composites = s->composites.p;
+   info->composite_count = s->composites.n;
+   info->spec_ops = s->spec_ops.p;
+   info->spec_op_count = s->spec_ops.n;
+   s->scalars.p = s->bools.p = s->composites.p = s->spec_ops.p = NULL;
+   info->vars = vars.p;
+   info->var_count = vars.n;
+   info->functions = s->functions.p;
+   info->function_count = s->functions.n;
+   info->calls = s->calls.p;
+   info->call_count = s->calls.n;
+   info->uses = s->uses.p;
+   info->use_count = s->uses.n;
+   info->types = s->types.p;
+   info->type_count = s->types.n;
+   info->members = s->members.p;
+   info->member_count = s->members.n;
+   s->entries.p = s->names.p = s->consts.p = s->functions.p = s->calls.p = s->uses.p = NULL;
+   s->types.p = s->members.p = NULL;
+   /* each Function and Private variable's type: the pointee of its pointer type (0: none
+    * known), and the function it is in */
+   if (s->locals.n) {
+      info->locals = malloc(sizeof(*info->locals) * (size_t)s->locals.n);
+      if (!info->locals)
+         return fail(s, "out of host memory", 0);
+      const struct local *locals = s->locals.p;
+      for (uint32_t i = 0; i < s->locals.n; i++) {
+         const struct pointer *p =
+            locals[i].pointer ? find(&s->pointers, sizeof(*p), locals[i].type) : NULL;
+         info->locals[i] = (struct vkr_spirv_local){
+            locals[i].id, locals[i].function,
+            locals[i].pointer ? (p ? p->pointee : 0) : locals[i].type };
+      }
+      info->local_count = s->locals.n;
+   }
+   /* each Workgroup variable's type and whether it is a Block (those alias each other) */
+   if (s->shared.n) {
+      info->shared = calloc(s->shared.n, sizeof(*info->shared));
+      if (!info->shared)
+         return fail(s, "out of host memory", 0);
+      const struct local *shared = s->shared.p;
+      for (uint32_t i = 0; i < s->shared.n; i++) {
+         const struct pointer *p =
+            shared[i].pointer ? find(&s->pointers, sizeof(*p), shared[i].type) : NULL;
+         struct vkr_spirv_shared *v = &info->shared[i];
+         v->id = shared[i].id;
+         v->type = shared[i].pointer ? (p ? p->pointee : 0) : shared[i].type;
+         for (const struct deco *d = v->type ? find(&s->decos, sizeof(*d), v->type) : NULL;
+              d && d < decos + s->decos.n && d->id == v->type; d++) {
+            if (d->kind == DEC_BLOCK)
+               v->block = true;
+         }
+      }
+      info->shared_count = s->shared.n;
+   }
+   /* Input and Output variables: their data type, Location and the decorations that decide
+    * whether they are arrayed or built in, sorted by id */
+   if (s->ios.n) {
+      info->ios = calloc(s->ios.n, sizeof(*info->ios));
+      if (!info->ios)
+         return fail(s, "out of host memory", 0);
+      const struct io *ios = s->ios.p;
+      for (uint32_t i = 0; i < s->ios.n; i++) {
+         struct vkr_spirv_io *v = &info->ios[i];
+         const struct pointer *p = ios[i].pointer ? find(&s->pointers, sizeof(*p), ios[i].type) : NULL;
+         *v = (struct vkr_spirv_io){ .id = ios[i].id, .storage = ios[i].storage,
+                                     .type = ios[i].pointer ? (p ? p->pointee : 0) : ios[i].type,
+                                     .location = UINT32_MAX };
+         for (const struct deco *d = find(&s->decos, sizeof(*d), v->id);
+              d && d < decos + s->decos.n && d->id == v->id; d++) {
+            if (d->kind == DEC_LOCATION)
+               v->location = d->value;
+            else if (d->kind == DEC_BUILT_IN)
+               v->flags |= VKR_SPIRV_IO_BUILT_IN;
+            else if (d->kind == DEC_PATCH)
+               v->flags |= VKR_SPIRV_IO_PATCH;
+            else if (d->kind == DEC_PER_VERTEX)
+               v->flags |= VKR_SPIRV_IO_PER_VERTEX;
+            else if (d->kind == DEC_PER_TASK)
+               v->flags |= VKR_SPIRV_IO_PER_TASK;
+         }
+         /* a built-in block, also one arrayed per vertex */
+         const struct vkr_spirv_type *t = find(&(struct vec){ .p = info->types, .n = info->type_count },
+                                               sizeof(*t), v->type);
+         const uint32_t inner = t && (t->kind == VKR_SPIRV_TYPE_ARRAY ||
+                                      t->kind == VKR_SPIRV_TYPE_RUNTIME_ARRAY) ? t->a : 0;
+         for (const struct deco *d = find(&s->decos, sizeof(*d), v->type);
+              d && d < decos + s->decos.n && d->id == v->type; d++) {
+            if (d->kind == DEC_BUILT_IN)
+               v->flags |= VKR_SPIRV_IO_BUILT_IN_TYPE;
+         }
+         for (const struct deco *d = inner ? find(&s->decos, sizeof(*d), inner) : NULL;
+              d && d < decos + s->decos.n && d->id == inner; d++) {
+            if (d->kind == DEC_BUILT_IN)
+               v->flags |= VKR_SPIRV_IO_BUILT_IN_ELEMENT;
+         }
+      }
+      qsort(info->ios, s->ios.n, sizeof(*info->ios), cmp_u32);
+      info->io_count = s->ios.n;
+   }
+   info->interface = s->interface.p;
+   info->interface_count = s->interface.n;
+   s->interface.p = NULL;
+   info->type_cost = s->cost;
+   const struct vec composites = { .p = info->composites, .n = info->composite_count };
+   const struct vkr_spirv_composite *wg =
+      s->workgroup_composite ? find(&composites, sizeof(*wg), s->workgroup_composite) : NULL;
+   if (wg && wg->count != 3)
+      return fail(s, "a WorkgroupSize that is not three values", 0);
+   if (wg)
+      memcpy(info->workgroup_size, wg->v, sizeof(wg->v));
+   return true;
+}
+
+struct vkr_spirv_info *
+vkr_spirv_scan(const uint32_t *code, size_t bytes, char *why, size_t why_size)
+{
+   struct scan s = { .w = code, .n = bytes / 4, .why = why, .why_size = why_size };
+   if (!code || bytes % 4 || s.n < 5) {
+      fail(&s, "shorter than its header or not whole words", 0);
+      return NULL;
+   }
+   const uint32_t version = code[1];
+   if (code[0] != SPV_MAGIC) {
+      fail(&s, "not SPIR-V (magic)", 0);
+      return NULL;
+   }
+   if ((version >> 16) != 1 || ((version >> 8) & 0xff) > 6 || (version & 0xff)) {
+      fail(&s, "an unknown SPIR-V version", 1);
+      return NULL;
+   }
+   s.bound = code[3];
+   if (!s.bound || s.bound > VKR_SPIRV_MAX_BOUND || code[4]) {
+      snprintf(why, why_size, "SPIR-V: id bound %u (at most %u) or schema %u", s.bound,
+               VKR_SPIRV_MAX_BOUND, code[4]);
+      return NULL;
+   }
+   s.info = calloc(1, sizeof(*s.info));
+   if (s.info)
+      s.info->version = version;
+   s.weight = calloc(s.bound, 2 * sizeof(uint32_t));
+   s.type_of = s.weight ? s.weight + s.bound : NULL;
+   s.is_struct = calloc(s.bound, 1);
+   bool ok = (s.info && s.weight && s.is_struct) || fail(&s, "out of host memory", 0);
+   for (size_t at = 5; ok && at < s.n;) {
+      const uint32_t len = code[at] >> 16, op = code[at] & 0xffff;
+      if (!len || len > s.n - at) {
+         ok = fail(&s, "an instruction past the end of the code", at);
+         break;
+      }
+      ok = instruction(&s, at, op, len);
+      at += len;
+   }
+   if (ok && !s.entries.n)
+      ok = fail(&s, "no entry point", 0);
+   if (ok)
+      ok = join(&s);
+   free(s.entries.p);
+   free(s.names.p);
+   free(s.decos.p);
+   free(s.modes.p);
+   free(s.consts.p);
+   free(s.composites.p);
+   free(s.scalars.p);
+   free(s.bools.p);
+   free(s.spec_ops.p);
+   free(s.functions.p);
+   free(s.calls.p);
+   free(s.uses.p);
+   free(s.types.p);
+   free(s.members.p);
+   free(s.pointers.p);
+   free(s.locals.p);
+   free(s.shared.p);
+   free(s.ios.p);
+   free(s.interface.p);
+   free(s.weight);
+   free(s.is_struct);
+   if (!ok) {
+      vkr_spirv_free(s.info);
+      return NULL;
+   }
+   return s.info;
+}
+
+void
+vkr_spirv_free(struct vkr_spirv_info *info)
+{
+   if (!info)
+      return;
+   free(info->entries);
+   free(info->names);
+   free(info->constants);
+   free(info->scalars);
+   free(info->bools);
+   free(info->composites);
+   free(info->spec_ops);
+   free(info->vars);
+   free(info->functions);
+   free(info->calls);
+   free(info->uses);
+   free(info->types);
+   free(info->members);
+   free(info->locals);
+   free(info->shared);
+   free(info->ios);
+   free(info->interface);
+   free(info);
+}
+
+const struct vkr_spirv_entry *
+vkr_spirv_entry(const struct vkr_spirv_info *info, const char *name, uint32_t model)
+{
+   for (uint32_t i = 0; info && name && i < info->entry_count; i++) {
+      const struct vkr_spirv_entry *e = &info->entries[i];
+      if (e->model == model && !strcmp(info->names + e->name, name))
+         return e;
+   }
+   return NULL;
+}
+
+/* a constant's value after specialization (constants are sorted by id) */
+static bool
+constant_value(const struct vkr_spirv_info *info,
+               uint32_t id,
+               vkr_spirv_lookup lookup,
+               const void *data,
+               uint32_t *value)
+{
+   const struct vec v = { .p = info->constants, .n = info->constant_count };
+   const struct vkr_spirv_constant *c = find(&v, sizeof(*c), id);
+   if (!c)
+      return false;
+   *value = c->value;
+   uint32_t size;
+   if (c->spec_id < UINT32_MAX - 1 && lookup)
+      lookup(data, c->spec_id, value, &size);
+   return true;
+}
+
+bool
+vkr_spirv_workgroup_size(const struct vkr_spirv_info *info,
+                         const struct vkr_spirv_entry *entry,
+                         vkr_spirv_lookup lookup,
+                         const void *data,
+                         uint32_t size[3])
+{
+   size[0] = size[1] = size[2] = 1;
+   /* the WorkgroupSize built-in wins over the execution modes */
+   if (info->workgroup_size[0]) {
+      for (int i = 0; i < 3; i++) {
+         if (!constant_value(info, info->workgroup_size[i], lookup, data, &size[i]))
+            return false;
+      }
+      return true;
+   }
+   if (entry->local_size_kind == 1) {
+      memcpy(size, entry->local_size, sizeof(entry->local_size));
+      return true;
+   }
+   if (entry->local_size_kind == 2) {
+      for (int i = 0; i < 3; i++) {
+         if (!constant_value(info, entry->local_size_id[i], lookup, data, &size[i]))
+            return false;
+      }
+   }
+   return true;
+}
+
+/* the index of a function id in the sorted list, or UINT32_MAX */
+static uint32_t
+function_index(const struct vkr_spirv_info *info, uint32_t id)
+{
+   const struct vec v = { .p = info->functions, .n = info->function_count };
+   const uint32_t *f = find(&v, sizeof(*f), id);
+   return f ? (uint32_t)(f - info->functions) : UINT32_MAX;
+}
+
+/* the functions an entry point reaches through calls, itself too: 1 at their index in
+ * info->functions (breadth first, each function once); NULL out of host memory */
+static uint8_t *
+reached(const struct vkr_spirv_info *info, const struct vkr_spirv_entry *entry)
+{
+   uint8_t *seen = calloc(info->function_count + 1, 1);
+   uint32_t *queue = malloc(sizeof(*queue) * ((size_t)info->function_count + 1));
+   const uint32_t first = function_index(info, entry->function);
+   uint32_t head = 0, tail = 0;
+   if (seen && queue && first != UINT32_MAX) {
+      seen[first] = 1;
+      queue[tail++] = first;
+   }
+   const struct vec calls = { .p = info->calls, .n = info->call_count };
+   while (seen && queue && head < tail) {
+      const uint32_t function = info->functions[queue[head++]];
+      for (const struct vkr_spirv_pair *c = find(&calls, sizeof(*c), function);
+           c && c < info->calls + info->call_count && c->function == function; c++) {
+         const uint32_t callee = function_index(info, c->id);
+         if (callee != UINT32_MAX && !seen[callee]) {
+            seen[callee] = 1;
+            queue[tail++] = callee;
+         }
+      }
+   }
+   free(queue);
+   if (!queue) {
+      free(seen);
+      return NULL;
+   }
+   return seen;
+}
+
+bool
+vkr_spirv_bindings_ok(const struct vkr_spirv_info *info,
+                      const struct vkr_spirv_entry *entry,
+                      bool (*ok)(const void *data, uint32_t set, uint32_t binding),
+                      const void *data,
+                      uint32_t *set,
+                      uint32_t *binding)
+{
+   *set = *binding = UINT32_MAX;
+   uint8_t *seen = reached(info, entry);
+   bool result = seen != NULL;
+   const struct vec uses = { .p = info->uses, .n = info->use_count };
+   const struct vec vars = { .p = info->vars, .n = info->var_count };
+   for (uint32_t i = 0; result && i < info->function_count; i++) {
+      const uint32_t function = info->functions[i];
+      for (const struct vkr_spirv_pair *u = seen[i] ? find(&uses, sizeof(*u), function) : NULL;
+           result && u && u < info->uses + info->use_count && u->function == function; u++) {
+         const struct vkr_spirv_var *v = find(&vars, sizeof(*v), u->id);
+         if (v && !ok(data, v->set, v->binding)) {
+            *set = v->set;
+            *binding = v->binding;
+            result = false;
+         }
+      }
+   }
+   free(seen);
+   return result;
+}
+
+/* which Function, Private and Workgroup variables an entry point's code gets: see
+ * vkr_spirv_function_elements */
+struct reach {
+   const struct vkr_spirv_info *info;
+   uint8_t *seen;  /* reached(); NULL: every variable */
+   uint32_t *ids;  /* the entry point's interface, sorted; NULL: every global */
+   uint32_t id_count;
+};
+
+static bool
+reach_init(struct reach *r,
+           const struct vkr_spirv_info *info,
+           const struct vkr_spirv_entry *entry,
+           bool interface_globals)
+{
+   *r = (struct reach){ .info = info };
+   if (!entry)
+      return true;
+   r->seen = reached(info, entry);
+   if (!r->seen)
+      return false;
+   if (!interface_globals || info->version < 0x10400)
+      return true;
+   /* from SPIR-V 1.4 an entry point's interface lists every global it uses */
+   const uint32_t index = (uint32_t)(entry - info->entries);
+   r->ids = malloc(sizeof(*r->ids) * ((size_t)info->interface_count + 1));
+   if (!r->ids)
+      return false;
+   for (uint32_t i = 0; i < info->interface_count; i++) {
+      if (info->interface[i].function == index)
+         r->ids[r->id_count++] = info->interface[i].id;
+   }
+   qsort(r->ids, r->id_count, sizeof(*r->ids), cmp_u32);
+   return true;
+}
+
+static bool
+reach_has(const struct reach *r, uint32_t function, uint32_t id)
+{
+   if (!r->seen)
+      return true;
+   if (function) {
+      const uint32_t i = function_index(r->info, function);
+      return i != UINT32_MAX && r->seen[i];
+   }
+   const struct vec ids = { .p = r->ids, .n = r->id_count };
+   return !r->ids || find(&ids, sizeof(uint32_t), id);
+}
+
+static void
+reach_fini(struct reach *r)
+{
+   free(r->seen);
+   free(r->ids);
+}
+
+/* one type's elements (memo: 0 not yet, 1 counting, 2 counted into elems), or with bytes
+ * set its size in bytes at least: no padding or offsets, a scalar its width, a vector or
+ * matrix its parts', a runtime array 0, a type the scan does not keep (bool, pointer) 1,
+ * and an array whose length the scan does not keep as a constant (a 64-bit SpecId) its
+ * element's; with locations the locations of type_locations. vals: the spec constant operations' values (by their index
+ * in info->spec_ops), made when a length first needs one; why: the reason for a false */
+struct elements {
+   const struct vkr_spirv_info *info;
+   vkr_spirv_lookup lookup;
+   const void *data;
+   uint8_t *state;
+   uint64_t *elems;
+   bool bytes;
+   bool locations;
+   struct spec_value *vals;
+   const char *why;
+};
+
+static const char *const why_nested = "types nested past 64 levels or in a loop";
+static const char *const why_unsupported =
+   "an array length the scan does not evaluate (a 64-bit spec constant, or a spec constant "
+   "operation on vectors, floats or composites)";
+static const char *const why_invalid =
+   "an array length from a spec constant operation that is no valid length after "
+   "specialization (a wrap, a divisor of 0 or a negative operand of SDiv, SRem or SMod, a "
+   "shift past the width, mixed types, an entry size not the constant's, a bool not 0 or 1, "
+   "a length of 0 or less)";
+static const char *const why_memory = "out of host memory";
+
+/* --- spec constant operations (OmacVM 3.4.5, #624) ---
+ * An array length may be an OpSpecConstantOp (glslang's float a[WMITER * TM] or shared
+ * x[gl_WorkGroupSize.x * 2], as ggml's Vulkan shaders have them). Its value is the driver's
+ * only where SPIR-V gives every driver the same one, so it has three states:
+ *  - known: exact, with SPIR-V's semantics (a value is its bits masked to its type's width;
+ *    the S operations sign-extend their operands, the U ones zero-extend them; IAdd, ISub,
+ *    IMul, ShiftLeftLogical and SNegate fit their result type's signedness, the others their
+ *    opcode's);
+ *  - unsupported: what this does not evaluate (VectorShuffle, CompositeInsert,
+ *    QuantizeToF16, vectors, floats, a composite of other than three, a 64-bit SpecId);
+ *  - invalid: where drivers may disagree or SPIR-V has no value (any wrap or truncation, a
+ *    divisor of 0, SDiv, SRem or SMod on a negative operand, a shift count at or past the
+ *    width, a bool spec value other than 0 or 1, a specialization entry whose size is not
+ *    the constant's, an operand defined at or after the operation (SPIR-V forbids forward
+ *    references among constants), a type mismatch, a width other than 8, 16, 32 or 64).
+ * Operations are evaluated in the order of their words, each from earlier ones, so no
+ * recursion, no depth limit and no loop. */
+enum { SV_KNOWN, SV_UNSUPPORTED, SV_INVALID };
+
+struct spec_value {
+   uint64_t bits;
+   uint32_t width; /* 1 for a bool, 0 for no int or bool */
+   uint8_t state;
+   bool sign;
+   bool boolean;
+   bool spec; /* depends on a constant with a SpecId */
+};
+
+static uint64_t
+width_mask(uint32_t width)
+{
+   return width >= 64 ? UINT64_MAX : (1ull << width) - 1;
+}
+
+/* bits of `width` sign-extended */
+static int64_t
+sign_extend(uint64_t bits, uint32_t width)
+{
+   if (width >= 64)
+      return (int64_t)bits;
+   const uint64_t m = 1ull << (width - 1);
+   return (int64_t)((bits & width_mask(width)) ^ m) - (int64_t)m;
+}
+
+static bool
+fits_signed(int64_t v, uint32_t width)
+{
+   if (width >= 64)
+      return true;
+   const int64_t h = (int64_t)1 << (width - 1);
+   return v >= -h && v < h;
+}
+
+static const struct vkr_spirv_scalar *
+scalar_type(const struct vkr_spirv_info *info, uint32_t id)
+{
+   const struct vec v = { .p = info->scalars, .n = info->scalar_count };
+   return find(&v, sizeof(struct vkr_spirv_scalar), id);
+}
+
+/* a bool, or an int of a width Vulkan has */
+static bool
+scalar_ok(const struct vkr_spirv_scalar *t)
+{
+   return t && (t->boolean || t->width == 8 || t->width == 16 || t->width == 32 || t->width == 64);
+}
+
+static struct spec_value
+invalid(struct spec_value v)
+{
+   v.state = SV_INVALID;
+   return v;
+}
+
+/* an operand defined before word `before`: a constant, a bool constant or an earlier
+ * operation (already in e->vals) */
+static struct spec_value
+spec_operand(struct elements *e, uint32_t id, uint32_t before)
+{
+   const struct vkr_spirv_info *info = e->info;
+   struct spec_value v = { .state = SV_INVALID };
+   const struct vec consts = { .p = info->constants, .n = info->constant_count };
+   const struct vec bools = { .p = info->bools, .n = info->bool_count };
+   const struct vec ops = { .p = info->spec_ops, .n = info->spec_op_count };
+   const struct vkr_spirv_constant *c = find(&consts, sizeof(*c), id);
+   const struct vkr_spirv_constant *b = c ? NULL : find(&bools, sizeof(*b), id);
+   if (c || b) {
+      const struct vkr_spirv_constant *k = c ? c : b;
+      const struct vkr_spirv_scalar *t = scalar_type(info, k->type);
+      if (k->at >= before || !scalar_ok(t) || t->boolean != (b != NULL) ||
+          (c && (t->width == 64) != c->wide))
+         return v;
+      v.width = t->width;
+      v.sign = t->sign;
+      v.boolean = t->boolean;
+      v.bits = (c ? (uint64_t)c->high << 32 | c->value : b->value) & width_mask(v.width);
+      v.spec = k->spec_id < UINT32_MAX - 1;
+      uint32_t value, size;
+      if (v.spec && v.width == 64) {
+         v.state = SV_UNSUPPORTED; /* vkr_spec_lookup gives 4 bytes */
+         return v;
+      }
+      if (v.spec && e->lookup && e->lookup(e->data, k->spec_id, &value, &size)) {
+         /* VUID-VkSpecializationMapEntry-constantID-00776: the constant's size (a bool's
+          * VkBool32); Mesa reads a bool as != 0, Metal's may read a byte */
+         if (size != (b ? 4 : v.width / 8) || (b && value > 1))
+            return invalid(v);
+         v.bits = value & width_mask(v.width);
+      }
+      v.state = SV_KNOWN;
+      return v;
+   }
+   const struct vkr_spirv_spec_op *o = find(&ops, sizeof(*o), id);
+   if (!o || o->at >= before || !e->vals)
+      return v;
+   return e->vals[o - info->spec_ops];
+}
+
+/* CompositeExtract of one index from a constant composite of three (WorkgroupSize) */
+static struct spec_value
+spec_extract(struct elements *e, const struct vkr_spirv_spec_op *o, struct spec_value r)
+{
+   const struct vec composites = { .p = e->info->composites, .n = e->info->composite_count };
+   const struct vkr_spirv_composite *c = find(&composites, sizeof(*c), o->operand[0]);
+   if (!c) {
+      /* an operation's vector (VectorShuffle, CompositeInsert) or no composite at all */
+      const struct spec_value v = spec_operand(e, o->operand[0], o->at);
+      r.state = v.state == SV_UNSUPPORTED ? SV_UNSUPPORTED : SV_INVALID;
+      r.spec = v.spec;
+      return r;
+   }
+   if (c->at >= o->at)
+      return invalid(r);
+   if (o->n != 2 || c->count != 3)
+      return r; /* unsupported: several indices, or not the three of a WorkgroupSize */
+   if (o->operand[1] >= 3)
+      return invalid(r);
+   const struct spec_value v = spec_operand(e, c->v[o->operand[1]], c->at);
+   if (v.state != SV_KNOWN)
+      return v;
+   if (v.boolean != r.boolean || v.width != r.width)
+      return invalid(r);
+   r.bits = v.bits;
+   r.spec = v.spec;
+   r.state = SV_KNOWN;
+   return r;
+}
+
+/* the value of one operation, from constants and earlier operations */
+static struct spec_value
+spec_op_value(struct elements *e, const struct vkr_spirv_spec_op *o)
+{
+   struct spec_value r = { .state = SV_UNSUPPORTED };
+   const uint32_t ids = spec_op_ids(o->opcode);
+   const struct vkr_spirv_scalar *t = scalar_type(e->info, o->type);
+   if (!ids || !t)
+      return r; /* an operation this does not evaluate, or a vector or float result */
+   if (!scalar_ok(t))
+      return invalid(r);
+   r.width = t->width;
+   r.sign = t->sign;
+   r.boolean = t->boolean;
+   if (!o->n)
+      return invalid(r);
+   if (o->opcode == OP_COMPOSITE_EXTRACT)
+      return spec_extract(e, o, r);
+   struct spec_value a[3];
+   uint8_t worst = SV_KNOWN;
+   for (uint32_t i = 0; i < ids; i++) {
+      a[i] = spec_operand(e, o->operand[i], o->at);
+      r.spec |= a[i].spec;
+      worst = a[i].state > worst ? a[i].state : worst;
+   }
+   if (worst != SV_KNOWN) {
+      r.state = worst;
+      return r;
+   }
+   const uint32_t w = r.width, op = o->opcode;
+   const uint64_t mask = width_mask(w);
+   /* the operand types SPIR-V asks for: ints of the result's width (a shift count any int,
+    * a conversion's operand any int), comparisons' ints of one width, logical ones bools */
+   const bool int_result = !r.boolean;
+   const bool a0_int = !a[0].boolean, a1_int = ids > 1 && !a[1].boolean;
+   bool types_ok;
+   switch (op) {
+   case OP_U_CONVERT:
+   case OP_S_CONVERT:
+      types_ok = int_result && a0_int;
+      break;
+   case OP_S_NEGATE:
+   case OP_NOT:
+      types_ok = int_result && a0_int && a[0].width == w;
+      break;
+   case OP_SHIFT_RIGHT_LOGICAL:
+   case OP_SHIFT_RIGHT_ARITHMETIC:
+   case OP_SHIFT_LEFT_LOGICAL:
+      types_ok = int_result && a0_int && a1_int && a[0].width == w;
+      break;
+   case OP_LOGICAL_EQUAL:
+   case OP_LOGICAL_NOT_EQUAL:
+   case OP_LOGICAL_OR:
+   case OP_LOGICAL_AND:
+      types_ok = r.boolean && a[0].boolean && a[1].boolean;
+      break;
+   case OP_LOGICAL_NOT:
+      types_ok = r.boolean && a[0].boolean;
+      break;
+   case OP_SELECT:
+      types_ok = a[0].boolean && a[1].boolean == r.boolean && a[2].boolean == r.boolean &&
+                 a[1].width == w && a[2].width == w;
+      break;
+   default:
+      if (op >= OP_I_EQUAL && op <= OP_S_LESS_THAN_EQUAL)
+         types_ok = r.boolean && a0_int && a1_int && a[0].width == a[1].width;
+      else /* IAdd .. SMod, BitwiseOr/Xor/And */
+         types_ok = int_result && a0_int && a1_int && a[0].width == w && a[1].width == w;
+      break;
+   }
+   if (!types_ok)
+      return invalid(r);
+
+   const uint64_t x = a[0].bits, y = ids > 1 ? a[1].bits : 0;
+   const int64_t sx = sign_extend(x, a[0].width), sy = ids > 1 ? sign_extend(y, a[1].width) : 0;
+   int64_t sv;
+   uint64_t uv;
+   switch (op) {
+   /* a conversion of an operand whose type has the other signedness and whose top bit is
+    * set: SPIR-V and both Mac compilers extend by the opcode, spirv-opt's folding by the
+    * operand's type (10000 random modules) */
+   case OP_U_CONVERT:
+      if (x > mask || (a[0].sign && sx < 0))
+         return invalid(r);
+      r.bits = x;
+      break;
+   case OP_S_CONVERT:
+      if (!fits_signed(sx, w) || (!a[0].sign && sx < 0))
+         return invalid(r);
+      r.bits = (uint64_t)sx & mask;
+      break;
+   case OP_S_NEGATE:
+      if (sx == INT64_MIN || (r.sign ? !fits_signed(-sx, w) : (-sx < 0 || (uint64_t)-sx > mask)))
+         return invalid(r);
+      r.bits = (uint64_t)-sx & mask;
+      break;
+   case OP_NOT:
+      r.bits = ~x & mask;
+      break;
+   case OP_I_ADD:
+   case OP_I_SUB:
+   case OP_I_MUL:
+      if (r.sign) {
+         const bool over = op == OP_I_ADD   ? __builtin_add_overflow(sx, sy, &sv)
+                           : op == OP_I_SUB ? __builtin_sub_overflow(sx, sy, &sv)
+                                            : __builtin_mul_overflow(sx, sy, &sv);
+         if (over || !fits_signed(sv, w))
+            return invalid(r);
+         r.bits = (uint64_t)sv & mask;
+      } else {
+         const bool over = op == OP_I_ADD   ? __builtin_add_overflow(x, y, &uv)
+                           : op == OP_I_SUB ? __builtin_sub_overflow(x, y, &uv)
+                                            : __builtin_mul_overflow(x, y, &uv);
+         if (over || uv > mask)
+            return invalid(r);
+         r.bits = uv;
+      }
+      break;
+   case OP_U_DIV:
+   case OP_U_MOD:
+      if (!y)
+         return invalid(r);
+      r.bits = op == OP_U_DIV ? x / y : x % y;
+      break;
+   case OP_S_DIV:
+   case OP_S_REM:
+   case OP_S_MOD:
+      /* drivers differ on negative operands (C's % for SMod); no length needs them */
+      if (!sy || sx < 0 || sy < 0)
+         return invalid(r);
+      r.bits = (uint64_t)(op == OP_S_DIV ? sx / sy : sx % sy) & mask;
+      break;
+   case OP_SHIFT_RIGHT_LOGICAL:
+   case OP_SHIFT_RIGHT_ARITHMETIC:
+   case OP_SHIFT_LEFT_LOGICAL:
+      if (y >= w)
+         return invalid(r);
+      if (op == OP_SHIFT_RIGHT_LOGICAL) {
+         r.bits = x >> y;
+      } else if (op == OP_SHIFT_RIGHT_ARITHMETIC) {
+         sv = sx >= 0 ? sx >> y : ~(~sx >> y);
+         r.bits = (uint64_t)sv & mask;
+      } else if (r.sign) {
+         /* x * 2^y fits: x within +-2^(w-1-y) */
+         if (y && (sx < -((int64_t)1 << (w - 1 - y)) || sx >= (int64_t)1 << (w - 1 - y)))
+            return invalid(r);
+         r.bits = ((uint64_t)sx << y) & mask;
+      } else {
+         if (x > mask >> y)
+            return invalid(r);
+         r.bits = x << y;
+      }
+      break;
+   case OP_BITWISE_OR:
+      r.bits = x | y;
+      break;
+   case OP_BITWISE_XOR:
+      r.bits = x ^ y;
+      break;
+   case OP_BITWISE_AND:
+      r.bits = x & y;
+      break;
+   case OP_LOGICAL_EQUAL:
+      r.bits = x == y;
+      break;
+   case OP_LOGICAL_NOT_EQUAL:
+      r.bits = x != y;
+      break;
+   case OP_LOGICAL_OR:
+      r.bits = x | y;
+      break;
+   case OP_LOGICAL_AND:
+      r.bits = x & y;
+      break;
+   case OP_LOGICAL_NOT:
+      r.bits = !x;
+      break;
+   case OP_SELECT:
+      r.bits = x ? a[1].bits : a[2].bits;
+      break;
+   case OP_I_EQUAL:
+      r.bits = x == y;
+      break;
+   case OP_I_NOT_EQUAL:
+      r.bits = x != y;
+      break;
+   case OP_U_GREATER_THAN:
+      r.bits = x > y;
+      break;
+   case OP_S_GREATER_THAN:
+      r.bits = sx > sy;
+      break;
+   case OP_U_GREATER_THAN_EQUAL:
+      r.bits = x >= y;
+      break;
+   case OP_S_GREATER_THAN_EQUAL:
+      r.bits = sx >= sy;
+      break;
+   case OP_U_LESS_THAN:
+      r.bits = x < y;
+      break;
+   case OP_S_LESS_THAN:
+      r.bits = sx < sy;
+      break;
+   case OP_U_LESS_THAN_EQUAL:
+      r.bits = x <= y;
+      break;
+   case OP_S_LESS_THAN_EQUAL:
+      r.bits = sx <= sy;
+      break;
+   default:
+      return invalid(r);
+   }
+   r.state = SV_KNOWN;
+   return r;
+}
+
+/* every operation's value, in the order of their words; false out of host memory */
+static bool
+spec_evaluate(struct elements *e)
+{
+   const struct vkr_spirv_info *info = e->info;
+   const uint32_t n = info->spec_op_count;
+   struct vkr_spirv_pair *order = malloc(sizeof(*order) * ((size_t)n + 1));
+   e->vals = calloc((size_t)n + 1, sizeof(*e->vals));
+   if (!order || !e->vals) {
+      free(order);
+      free(e->vals);
+      e->vals = NULL;
+      return false;
+   }
+   /* (word, index): sorted by the word */
+   for (uint32_t i = 0; i < n; i++)
+      order[i] = (struct vkr_spirv_pair){ info->spec_ops[i].at, i };
+   qsort(order, n, sizeof(*order), cmp_u32);
+   for (uint32_t i = 0; i < n; i++)
+      e->vals[order[i].id] = spec_op_value(e, &info->spec_ops[order[i].id]);
+   free(order);
+   return true;
+}
+
+/* an array length that is no constant the scan keeps: a spec constant operation's value.
+ * Known: its value. Counted once: without the stage's specialization (a module), one an app
+ * may still specialize, where a SpecId length counts once (locations) or the result is no
+ * valid length with the defaults (bytes). Refused (with e->why): invalid, unsupported (none
+ * of the 1267 modules of llama.cpp b11791's ggml-vulkan or the CPU test's corpus has one in
+ * a Workgroup or interface variable; before 3.4.5 those counted once), out of host memory. */
+enum { LEN_KNOWN, LEN_ONCE, LEN_REFUSED };
+
+static int
+spec_length(struct elements *e, uint32_t id, uint64_t *length)
+{
+   const struct vec ops = { .p = e->info->spec_ops, .n = e->info->spec_op_count };
+   const struct vkr_spirv_spec_op *o = find(&ops, sizeof(*o), id);
+   struct spec_value v = { .state = SV_INVALID }; /* no int constant at all */
+   if (o) {
+      if (!e->vals && !spec_evaluate(e)) {
+         e->why = why_memory;
+         return LEN_REFUSED;
+      }
+      v = e->vals[o - e->info->spec_ops];
+      /* a length is an int's unsigned value, at least 1 (Mesa's vtn_constant_uint) */
+      if (v.state == SV_KNOWN && (v.boolean || !v.bits || (v.sign && sign_extend(v.bits, v.width) < 0)))
+         v.state = SV_INVALID;
+   }
+   if (!e->lookup && v.spec && (e->bytes || e->locations) && (e->locations || v.state != SV_KNOWN))
+      return LEN_ONCE;
+   if (v.state == SV_KNOWN) {
+      *length = v.bits;
+      return LEN_KNOWN;
+   }
+   e->why = v.state == SV_UNSUPPORTED ? why_unsupported : why_invalid;
+   return LEN_REFUSED;
+}
+
+static bool
+type_elements(struct elements *e, uint32_t id, unsigned depth, uint64_t *out)
+{
+   const struct vec types = { .p = e->info->types, .n = e->info->type_count };
+   const struct vkr_spirv_type *t = find(&types, sizeof(*t), id);
+   if (!t) {
+      *out = 1; /* a scalar, vector, matrix, pointer, image ... */
+      return true;
+   }
+   const size_t at = (size_t)(t - e->info->types);
+   if (e->state[at] == 2) {
+      *out = e->elems[at];
+      return true;
+   }
+   if (e->state[at] == 1 || depth > 64) {
+      e->why = why_nested;
+      return false;
+   }
+   e->state[at] = 1;
+   uint64_t n = 0;
+   if (t->kind == VKR_SPIRV_TYPE_ARRAY) {
+      uint32_t lo;
+      uint64_t inner, length = 1;
+      const struct vec v = { .p = e->info->constants, .n = e->info->constant_count };
+      const struct vkr_spirv_constant *c = find(&v, sizeof(*c), t->b);
+      if (!type_elements(e, t->a, depth + 1, &inner))
+         return false;
+      if (c) {
+         /* vkr_spec_lookup gives a specialized length's lower 32 bits: a 64-bit one with a
+          * SpecId is not known */
+         const bool known = constant_value(e->info, t->b, e->lookup, e->data, &lo) &&
+                            !(c->spec_id < UINT32_MAX - 1 && c->wide);
+         if (!known && !e->bytes) {
+            e->why = why_unsupported;
+            return false;
+         }
+         if (known)
+            length = c->spec_id < UINT32_MAX - 1 ? lo : ((uint64_t)c->high << 32 | lo);
+      } else {
+         const int k = spec_length(e, t->b, &length);
+         if (k == LEN_REFUSED)
+            return false;
+         if (k == LEN_ONCE)
+            length = 1;
+      }
+      if (__builtin_mul_overflow(length, inner, &n))
+         n = UINT64_MAX;
+   } else if (e->bytes && t->kind == VKR_SPIRV_TYPE_SCALAR) {
+      n = t->a >= 8 ? t->a / 8 : 1;
+   } else if (e->bytes && (t->kind == VKR_SPIRV_TYPE_VECTOR || t->kind == VKR_SPIRV_TYPE_MATRIX)) {
+      uint64_t part;
+      if (!type_elements(e, t->a, depth + 1, &part))
+         return false;
+      if (__builtin_mul_overflow((uint64_t)t->b, part, &n))
+         n = UINT64_MAX;
+   } else if (e->bytes && t->kind == VKR_SPIRV_TYPE_RUNTIME_ARRAY) {
+      n = 0;
+   } else if (t->kind != VKR_SPIRV_TYPE_STRUCT) {
+      n = 1; /* a scalar, vector, matrix or runtime array */
+   } else {
+      for (uint32_t i = 0; i < t->b; i++) {
+         uint64_t m;
+         if (t->a + (uint64_t)i >= e->info->member_count) {
+            e->why = why_nested;
+            return false;
+         }
+         if (!type_elements(e, e->info->members[t->a + i], depth + 1, &m))
+            return false;
+         if (__builtin_add_overflow(n, m, &n))
+            n = UINT64_MAX;
+      }
+   }
+   e->state[at] = 2;
+   e->elems[at] = n;
+   *out = n;
+   return true;
+}
+
+static void
+elements_fini(struct elements *e, const char **why)
+{
+   free(e->state);
+   free(e->elems);
+   free(e->vals);
+   if (why)
+      *why = e->why;
+}
+
+bool
+vkr_spirv_function_elements(const struct vkr_spirv_info *info,
+                            const struct vkr_spirv_entry *entry,
+                            bool interface_globals,
+                            vkr_spirv_lookup lookup,
+                            const void *data,
+                            uint64_t *count,
+                            const char **why)
+{
+   *count = 0;
+   if (why)
+      *why = NULL;
+   if (!info->local_count)
+      return true;
+   struct elements e = { info, lookup, data, calloc(info->type_count + 1, 1),
+                         calloc(info->type_count + 1, sizeof(uint64_t)), false, false, NULL,
+                         why_memory };
+   struct reach r;
+   bool ok = reach_init(&r, info, entry, interface_globals) && e.state && e.elems;
+   for (uint32_t i = 0; ok && i < info->local_count; i++) {
+      const struct vkr_spirv_local *l = &info->locals[i];
+      if (!reach_has(&r, l->function, l->id))
+         continue;
+      uint64_t n;
+      ok = type_elements(&e, l->type, 0, &n);
+      if (ok && __builtin_add_overflow(*count, n, count))
+         *count = UINT64_MAX;
+   }
+   reach_fini(&r);
+   elements_fini(&e, ok ? NULL : why);
+   return ok;
+}
+
+bool
+vkr_spirv_workgroup_bytes(const struct vkr_spirv_info *info,
+                          const struct vkr_spirv_entry *entry,
+                          bool interface_globals,
+                          vkr_spirv_lookup lookup,
+                          const void *data,
+                          uint64_t *bytes,
+                          const char **why)
+{
+   *bytes = 0;
+   if (why)
+      *why = NULL;
+   if (!info->shared_count)
+      return true;
+   struct elements e = { info, lookup, data, calloc(info->type_count + 1, 1),
+                         calloc(info->type_count + 1, sizeof(uint64_t)), true, false, NULL,
+                         why_memory };
+   struct reach r;
+   bool ok = reach_init(&r, info, entry, interface_globals) && e.state && e.elems;
+   uint64_t sum = 0, block = 0;
+   for (uint32_t i = 0; ok && i < info->shared_count; i++) {
+      if (!reach_has(&r, 0, info->shared[i].id))
+         continue;
+      uint64_t n;
+      ok = type_elements(&e, info->shared[i].type, 0, &n);
+      if (ok && info->shared[i].block)
+         block = n > block ? n : block;
+      else if (ok && __builtin_add_overflow(sum, n, &sum))
+         sum = UINT64_MAX;
+   }
+   reach_fini(&r);
+   elements_fini(&e, ok ? NULL : why);
+   /* Block ones alias each other (SPV_KHR_workgroup_memory_explicit_layout): the largest */
+   *bytes = sum > block ? sum : block;
+   return ok;
+}
+
+/* the locations a type takes as an interface variable, as SPIR-V's "Location Assignment"
+ * counts them: a scalar or vector one (a 64-bit vector of 3 or 4 two), a matrix one per
+ * column, an array its length times its element's, a struct its members' (at least one,
+ * so an array of empty structs is not free); memo as for elements */
+static bool
+type_locations(struct elements *e, uint32_t id, unsigned depth, uint64_t *out)
+{
+   const struct vec types = { .p = e->info->types, .n = e->info->type_count };
+   const struct vkr_spirv_type *t = find(&types, sizeof(*t), id);
+   if (!t) {
+      *out = 1; /* a pointer, or a type spirv-val refuses here */
+      return true;
+   }
+   const size_t at = (size_t)(t - e->info->types);
+   if (e->state[at] == 2) {
+      *out = e->elems[at];
+      return true;
+   }
+   if (e->state[at] == 1 || depth > 64) {
+      e->why = why_nested;
+      return false;
+   }
+   e->state[at] = 1;
+   uint64_t n = 1, inner = 1;
+   switch (t->kind) {
+   case VKR_SPIRV_TYPE_VECTOR: {
+      const struct vkr_spirv_type *c = find(&types, sizeof(*c), t->a);
+      n = c && c->kind == VKR_SPIRV_TYPE_SCALAR && c->a == 64 && t->b > 2 ? 2 : 1;
+      break;
+   }
+   case VKR_SPIRV_TYPE_MATRIX:
+      if (!type_locations(e, t->a, depth + 1, &inner))
+         return false;
+      if (__builtin_mul_overflow(inner, (uint64_t)t->b, &n))
+         n = UINT64_MAX;
+      break;
+   case VKR_SPIRV_TYPE_ARRAY:
+   case VKR_SPIRV_TYPE_RUNTIME_ARRAY: {
+      if (!type_locations(e, t->a, depth + 1, &inner))
+         return false;
+      /* a 64-bit length with its high word; a spec constant operation's value (spec_length) */
+      uint32_t lo = 1;
+      uint64_t length = 1;
+      const struct vec v = { .p = e->info->constants, .n = e->info->constant_count };
+      const struct vkr_spirv_constant *c =
+         t->kind == VKR_SPIRV_TYPE_ARRAY ? find(&v, sizeof(*c), t->b) : NULL;
+      if (c && constant_value(e->info, t->b, e->lookup, e->data, &lo))
+         length = c->wide && c->spec_id == UINT32_MAX ? ((uint64_t)c->high << 32 | lo) : lo;
+      /* without the stage's specialization (a shader module) a length an app may still
+       * specialize also counts once */
+      if (c && c->spec_id < UINT32_MAX - 1 && !e->lookup)
+         length = 1;
+      if (!c && t->kind == VKR_SPIRV_TYPE_ARRAY) {
+         const int k = spec_length(e, t->b, &length);
+         if (k == LEN_REFUSED)
+            return false;
+         if (k == LEN_ONCE)
+            length = 1;
+      }
+      if (__builtin_mul_overflow(length, inner, &n))
+         n = UINT64_MAX;
+      break;
+   }
+   case VKR_SPIRV_TYPE_STRUCT:
+      n = 0;
+      for (uint32_t i = 0; i < t->b; i++) {
+         uint64_t m;
+         if (t->a + (uint64_t)i >= e->info->member_count) {
+            e->why = why_nested;
+            return false;
+         }
+         if (!type_locations(e, e->info->members[t->a + i], depth + 1, &m))
+            return false;
+         if (__builtin_add_overflow(n, m, &n))
+            n = UINT64_MAX;
+      }
+      n = n ? n : 1;
+      break;
+   default:
+      break;
+   }
+   e->state[at] = 2;
+   e->elems[at] = n;
+   *out = n;
+   return true;
+}
+
+/* the most locations an Input or Output variable of an entry point of `model` may take */
+static uint32_t
+io_limit(const struct vkr_spirv_io_limits *l, uint32_t model, bool output, bool patch)
+{
+   switch (model) {
+   case 0:
+      return output ? l->vertex_out : l->vertex_in;
+   case MODEL_TESS_CONTROL:
+      return output ? (patch ? l->tess_control_patch_out : l->tess_control_out) : l->tess_control_in;
+   case MODEL_TESS_EVAL:
+      return output ? l->tess_eval_out : l->tess_eval_in;
+   case MODEL_GEOMETRY:
+      return output ? l->geometry_out : l->geometry_in;
+   case MODEL_FRAGMENT:
+      return output ? l->fragment_out : l->fragment_in;
+   default: {
+      /* mesh shading and models without such variables: the largest of them */
+      const uint32_t *v = &l->vertex_in;
+      uint32_t m = 0;
+      for (size_t i = 0; i < sizeof(*l) / sizeof(*v); i++)
+         m = v[i] > m ? v[i] : m;
+      return m;
+   }
+   }
+}
+
+bool
+vkr_spirv_interface_ok(const struct vkr_spirv_info *info,
+                       const struct vkr_spirv_io_limits *limits,
+                       vkr_spirv_lookup lookup,
+                       const void *data,
+                       char *why,
+                       size_t why_size)
+{
+   if (!info->io_count)
+      return true;
+   struct elements e = { info, lookup, data, calloc(info->type_count + 1, 1),
+                         calloc(info->type_count + 1, sizeof(uint64_t)), false, true, NULL,
+                         why_memory };
+   bool ok = e.state && e.elems;
+   if (!ok)
+      snprintf(why, why_size, "SPIR-V: out of host memory");
+   const struct vec ios = { .p = info->ios, .n = info->io_count };
+   const struct vec types = { .p = info->types, .n = info->type_count };
+   for (uint32_t i = 0; ok && i < info->interface_count; i++) {
+      const struct vkr_spirv_io *v = find(&ios, sizeof(*v), info->interface[i].id);
+      if (!v || (v->flags & (VKR_SPIRV_IO_BUILT_IN | VKR_SPIRV_IO_BUILT_IN_TYPE)))
+         continue;
+      const uint32_t model = info->entries[info->interface[i].function].model;
+      const bool out = v->storage == STORAGE_OUTPUT, patch = v->flags & VKR_SPIRV_IO_PATCH;
+      /* per-vertex variables have an outer array that takes no locations (SPIR-V 2.16.2,
+       * Vulkan "Shader Input and Output Interfaces") */
+      const bool arrayed = (model == MODEL_TESS_CONTROL && !patch) ||
+                           (model == MODEL_TESS_EVAL && !out && !patch) ||
+                           (model == MODEL_GEOMETRY && !out) ||
+                           (model == MODEL_FRAGMENT && !out && (v->flags & VKR_SPIRV_IO_PER_VERTEX)) ||
+                           ((model == MODEL_MESH_NV || model == MODEL_MESH_EXT) && out &&
+                            !(v->flags & VKR_SPIRV_IO_PER_TASK));
+      uint32_t type = v->type;
+      const struct vkr_spirv_type *t = find(&types, sizeof(*t), type);
+      if (arrayed && t && (t->kind == VKR_SPIRV_TYPE_ARRAY || t->kind == VKR_SPIRV_TYPE_RUNTIME_ARRAY)) {
+         if (v->flags & VKR_SPIRV_IO_BUILT_IN_ELEMENT)
+            continue;
+         type = t->a;
+      }
+      uint64_t n;
+      const uint32_t limit = io_limit(limits, model, out, patch);
+      const uint64_t base = v->location == UINT32_MAX ? 0 : v->location;
+      if (!type_locations(&e, type, 0, &n)) {
+         snprintf(why, why_size, "SPIR-V: %s variable %u: %s", out ? "an Output" : "an Input",
+                  v->id, e.why);
+         ok = false;
+      } else if (n > limit || base + n > limit) {
+         snprintf(why, why_size,
+                  "SPIR-V: %s variable %u of model %u takes %" PRIu64 " locations from %" PRIu64
+                  " (at most %u; VUID-RuntimeSpirv-Location-06272)",
+                  out ? "an Output" : "an Input", v->id, model, n, base, limit);
+         ok = false;
+      }
+   }
+   elements_fini(&e, NULL);
+   return ok;
+}
diff --git a/src/venus/vkr_spirv.h b/src/venus/vkr_spirv.h
new file mode 100644
index 0000000..1b79868
--- /dev/null
+++ b/src/venus/vkr_spirv.h
@@ -0,0 +1,308 @@
+/*
+ * Copyright 2026 OmacVM contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+/* OmacVM (virgl-venus-spirv-scan.patch, ADR 0065): a structural scan of a guest's SPIR-V
+ * before the Mac's shader compilers see it. Both compilers ended QEMU on malformed SPIR-V
+ * (KosmicKrisp's spirv_to_nir on a bad magic, in its own error path, and on a huge id bound;
+ * MoltenVK's SPIRV-Cross with an uncaught exception on a missing entry point), on a
+ * workgroup size past Metal's (MoltenVK) and on a shader using a descriptor set the layout
+ * lacks (KosmicKrisp). This is not a validator: it checks what those crashes need (the
+ * header, every instruction inside the code, the ids it reads inside the bound, entry
+ * points, workgroup sizes, descriptor sets) and keeps a summary for pipeline creation,
+ * with the types of Function and Private variables, whose elements a pipeline counts, and
+ * of Workgroup variables, whose bytes it counts (SPIRV-Tools' validator comes after it:
+ * virgl-venus-spirv-validate.patch).
+ * Self-contained (no Vulkan driver), so it is fuzzed on the CPU alone
+ * (Tests/virgl/fuzz-venus-spirv.sh). */
+
+#ifndef VKR_SPIRV_H
+#define VKR_SPIRV_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+/* the largest id bound: KosmicKrisp allocates per id (a bound of 0x3fffffff ended QEMU) */
+#define VKR_SPIRV_MAX_BOUND (1u << 20)
+
+/* the most elements in a module's Function and Private variables after specialization
+ * (arrays of arrays multiplied, struct members added): KosmicKrisp splits an unused
+ * Function array into one variable per element at about 360 bytes each; 2^20 peaked at
+ * 480 MB in 0.5 s, 2^24 passed 2 GB in 2.4 s, and uint[2^32-1] (legal SPIR-V) took 9 GB.
+ * Private variables are per invocation too (measured on the drivers only up to 2^24); a
+ * Private uint[2^32-1] passed the scan and spirv-val, so they count against the same cap. */
+#define VKR_SPIRV_MAX_FUNCTION_ELEMENTS (1u << 20)
+
+/* the most a module's types may cost spirv-val (info->type_cost, the sum vkr_spirv.c's
+ * instruction() counts: each instruction the weights of the types it names and reads;
+ * vkr_spirv_validate refuses more unread). spirv-val's walks over types are not memoized:
+ * a struct of two of the previous one, 30 deep, kept it busy past 20 s, and each
+ * instruction walks its types again; virgl-venus-spirv-validate.patch has the measured
+ * worst case under this cost. */
+#define VKR_SPIRV_MAX_TYPE_COST (1u << 24)
+
+struct vkr_spirv_entry {
+   uint32_t model;    /* SpvExecutionModel */
+   uint32_t function; /* id */
+   uint32_t name;     /* offset into the summary's name buffer */
+   uint32_t local_size[3];
+   uint32_t local_size_id[3];
+   uint8_t local_size_kind; /* 0 none, 1 LocalSize, 2 LocalSizeId */
+};
+
+/* a constant whose value a workgroup size or an array length may name; spec_id UINT32_MAX for
+ * a plain one, UINT32_MAX - 1 for a spec constant without a SpecId (a bool one: value 0 or 1) */
+struct vkr_spirv_constant {
+   uint32_t id;
+   uint32_t spec_id;
+   uint32_t value;
+   uint32_t high; /* the upper word of a 64-bit one */
+   uint32_t type; /* its result type */
+   uint32_t at;   /* the word it starts at */
+   bool wide;     /* 64 bits */
+};
+
+/* an OpTypeInt (width 8, 16, 32 or 64 for one a spec constant operation may use) or an
+ * OpTypeBool (width 1) */
+struct vkr_spirv_scalar {
+   uint32_t id;
+   uint32_t width;
+   bool sign;
+   bool boolean;
+};
+
+/* an OpConstantComposite or OpSpecConstantComposite: its constituents when it has three (the
+ * WorkgroupSize built-in's) */
+struct vkr_spirv_composite {
+   uint32_t id, count, v[3];
+   uint32_t at;
+};
+
+/* an OpSpecConstantOp: its operands (n of them, at most 3; CompositeExtract's composite and
+ * index literals); n 0 for one that is malformed */
+struct vkr_spirv_spec_op {
+   uint32_t id;
+   uint32_t type;
+   uint32_t opcode;
+   uint32_t n;
+   uint32_t operand[3];
+   uint32_t at;
+};
+
+/* a specialization constant's value in a pipeline stage's data (*value at most its low 4
+ * bytes) and its map entry's size in bytes; false when the stage does not specialize it */
+typedef bool (*vkr_spirv_lookup)(const void *data, uint32_t spec_id, uint32_t *value, uint32_t *size);
+
+/* a type variables' elements and locations are counted through (anything else is one
+ * element and one location) */
+enum {
+   VKR_SPIRV_TYPE_ARRAY = 1,         /* a: element, b: length id */
+   VKR_SPIRV_TYPE_STRUCT = 2,        /* members[a, a + b) */
+   VKR_SPIRV_TYPE_SCALAR = 3,        /* an int or float, a: width */
+   VKR_SPIRV_TYPE_VECTOR = 4,        /* a: component, b: count */
+   VKR_SPIRV_TYPE_MATRIX = 5,        /* a: column, b: count */
+   VKR_SPIRV_TYPE_RUNTIME_ARRAY = 6, /* a: element */
+};
+
+struct vkr_spirv_type {
+   uint32_t id;
+   uint32_t kind;
+   uint32_t a, b;
+};
+
+/* an Input or Output variable */
+enum {
+   VKR_SPIRV_IO_BUILT_IN = 1 << 0,         /* the variable */
+   VKR_SPIRV_IO_BUILT_IN_TYPE = 1 << 1,    /* its type is a built-in block */
+   VKR_SPIRV_IO_BUILT_IN_ELEMENT = 1 << 2, /* an array of built-in blocks */
+   VKR_SPIRV_IO_PATCH = 1 << 3,
+   VKR_SPIRV_IO_PER_VERTEX = 1 << 4, /* PerVertexKHR */
+   VKR_SPIRV_IO_PER_TASK = 1 << 5,   /* PerTaskNV */
+};
+
+struct vkr_spirv_io {
+   uint32_t id;
+   uint32_t storage;  /* Input or Output */
+   uint32_t type;     /* the data type */
+   uint32_t location; /* UINT32_MAX: none */
+   uint32_t flags;
+};
+
+/* how many locations an Input or Output variable may take, per execution model (the
+ * device's limits: components / 4, maxVertexInputAttributes, maxFragmentOutputAttachments) */
+struct vkr_spirv_io_limits {
+   uint32_t vertex_in, vertex_out;
+   uint32_t tess_control_in, tess_control_out, tess_control_patch_out;
+   uint32_t tess_eval_in, tess_eval_out;
+   uint32_t geometry_in, geometry_out;
+   uint32_t fragment_in, fragment_out;
+};
+
+/* a descriptor variable: an id with a DescriptorSet decoration */
+struct vkr_spirv_var {
+   uint32_t id;
+   uint32_t set;
+   uint32_t binding;
+};
+
+/* (function, id): a call from one function to another, or an id a function's pointer
+ * instruction names; (entry index, id) for an entry point's interface */
+struct vkr_spirv_pair {
+   uint32_t function;
+   uint32_t id;
+};
+
+/* a Function or Private variable: the function a Function one is in (0 for a Private one)
+ * and its data type (0: none known) */
+struct vkr_spirv_local {
+   uint32_t id;
+   uint32_t function;
+   uint32_t type;
+};
+
+/* a Workgroup variable: its data type (0: none known); block: a Block type, which aliases
+ * the other Block ones (SPV_KHR_workgroup_memory_explicit_layout) */
+struct vkr_spirv_shared {
+   uint32_t id;
+   uint32_t type;
+   bool block;
+};
+
+struct vkr_spirv_info {
+   uint32_t version; /* the header's: 0x00010400 is SPIR-V 1.4 */
+   uint32_t entry_count;
+   struct vkr_spirv_entry *entries;
+   char *names;
+   uint32_t constant_count;
+   struct vkr_spirv_constant *constants; /* sorted by id */
+   /* what an array length from a spec constant operation is evaluated from (sorted by id):
+    * int and bool types, bool constants, constant composites, the operations */
+   uint32_t scalar_count;
+   struct vkr_spirv_scalar *scalars;
+   uint32_t bool_count;
+   struct vkr_spirv_constant *bools;
+   uint32_t composite_count;
+   struct vkr_spirv_composite *composites;
+   uint32_t spec_op_count;
+   struct vkr_spirv_spec_op *spec_ops;
+   /* the WorkgroupSize built-in: its composite's three components, or 0 */
+   uint32_t workgroup_size[3];
+   /* sorted: an entry point's descriptor variables are the ones the functions it reaches
+    * through calls name */
+   uint32_t var_count;
+   struct vkr_spirv_var *vars;
+   uint32_t function_count;
+   uint32_t *functions;
+   uint32_t call_count;
+   struct vkr_spirv_pair *calls;
+   uint32_t use_count;
+   struct vkr_spirv_pair *uses;
+   /* arrays and structs (sorted by id), the structs' member types, the Function and
+    * Private variables and the Workgroup variables */
+   uint32_t type_count;
+   struct vkr_spirv_type *types;
+   uint32_t member_count;
+   uint32_t *members;
+   uint32_t local_count;
+   struct vkr_spirv_local *locals;
+   uint32_t shared_count;
+   struct vkr_spirv_shared *shared;
+   /* Input and Output variables (sorted by id) and the entry points' interfaces */
+   uint32_t io_count;
+   struct vkr_spirv_io *ios;
+   uint32_t interface_count;
+   struct vkr_spirv_pair *interface;
+   /* what the types cost (VKR_SPIRV_MAX_TYPE_COST) */
+   uint64_t type_cost;
+};
+
+/* the scan of `bytes` bytes of SPIR-V; NULL with a reason in why (malformed or too big) */
+struct vkr_spirv_info *
+vkr_spirv_scan(const uint32_t *code, size_t bytes, char *why, size_t why_size);
+
+void
+vkr_spirv_free(struct vkr_spirv_info *info);
+
+/* the entry point named `name` of execution model `model`, or NULL */
+const struct vkr_spirv_entry *
+vkr_spirv_entry(const struct vkr_spirv_info *info, const char *name, uint32_t model);
+
+/* a stage's workgroup size after specialization (lookup: vkr_spirv_lookup); false when an id
+ * it names is not a known constant */
+bool
+vkr_spirv_workgroup_size(const struct vkr_spirv_info *info,
+                         const struct vkr_spirv_entry *entry,
+                         vkr_spirv_lookup lookup,
+                         const void *data,
+                         uint32_t size[3]);
+
+/* each descriptor variable the entry point's functions use, to `ok` (in O(module size));
+ * false at the first one `ok` refuses (its set and binding in *set and *binding) or out of
+ * host memory (both UINT32_MAX) */
+bool
+vkr_spirv_bindings_ok(const struct vkr_spirv_info *info,
+                      const struct vkr_spirv_entry *entry,
+                      bool (*ok)(const void *data, uint32_t set, uint32_t binding),
+                      const void *data,
+                      uint32_t *set,
+                      uint32_t *binding);
+
+/* the elements of the Function and Private variables the code of `entry` gets, after
+ * specialization (lookup as for the workgroup size), at most UINT64_MAX; false with the
+ * reason in *why (a static string; why may be NULL) when an array length is one the scan does
+ * not evaluate (a 64-bit spec constant, a spec constant operation on vectors, floats or
+ * composites) or a spec constant operation that is no valid length after specialization
+ * (it wraps, divides by 0, ...: see vkr_spirv.c, spec_op_value), the types nest past 64
+ * levels or in a loop, or out of host memory. entry NULL: every one of the module's. Else the Function
+ * variables of the functions it reaches through calls (both Mac compilers translate only
+ * those) and the Private ones: every one of the module's (MoltenVK's SPIRV-Cross declares
+ * each in every entry point it compiles; Mesa's spirv_to_nir before SPIR-V 1.4 makes them all
+ * too), or with interface_globals and SPIR-V 1.4 or later only those in its interface (Mesa's
+ * spirv_to_nir skips the others: KosmicKrisp, VKR_SPIRV_INTERFACE_GLOBALS) */
+bool
+vkr_spirv_function_elements(const struct vkr_spirv_info *info,
+                            const struct vkr_spirv_entry *entry,
+                            bool interface_globals,
+                            vkr_spirv_lookup lookup,
+                            const void *data,
+                            uint64_t *count,
+                            const char **why);
+
+/* the bytes the Workgroup variables the code of `entry` gets take at least, after
+ * specialization (lookup as for the workgroup size): their sum, or the largest Block one
+ * when that is more; no padding, a 64-bit SpecId length counts once (without lookup also
+ * one from a spec constant operation an app may still specialize that is no valid length
+ * with the defaults).
+ * Which variables: as the Private ones of vkr_spirv_function_elements. Against
+ * maxComputeSharedMemorySize (VUID-RuntimeSpirv-Workgroup-06530): a Workgroup uint[2^32-1]
+ * passed the scan and spirv-val. False with the reason in *why (as for the elements) when a
+ * spec constant operation is no valid length after specialization or one the scan does not
+ * evaluate, the types nest past 64 levels or in a loop, or out of host memory. */
+bool
+vkr_spirv_workgroup_bytes(const struct vkr_spirv_info *info,
+                          const struct vkr_spirv_entry *entry,
+                          bool interface_globals,
+                          vkr_spirv_lookup lookup,
+                          const void *data,
+                          uint64_t *bytes,
+                          const char **why);
+
+/* every Input and Output variable of an entry point's interface, but built-ins, takes at
+ * most the locations `limits` gives its model and storage class (after the outer array of
+ * per-vertex ones; VUID-RuntimeSpirv-Location-06272), from its Location on; lookup as for
+ * the workgroup size, NULL for a module (a length from a SpecId, or from a spec constant
+ * operation on one, counts once, as spirv-val counts it, whose walk over locations grows with
+ * them: an Input of a struct of uint[2^32-1] took it past 512 MB). False with why set, also
+ * for a spec constant operation that is no valid length or that the scan does not evaluate
+ * (as for the elements). */
+bool
+vkr_spirv_interface_ok(const struct vkr_spirv_info *info,
+                       const struct vkr_spirv_io_limits *limits,
+                       vkr_spirv_lookup lookup,
+                       const void *data,
+                       char *why,
+                       size_t why_size);
+
+#endif /* VKR_SPIRV_H */
