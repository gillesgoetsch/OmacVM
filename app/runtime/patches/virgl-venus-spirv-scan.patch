+/* OmacVM (virgl-venus-spirv-scan.patch): a specialization constant's value in the stage's
+ * data, as the driver reads it (the entry's size, at most 4 bytes of it) */
+static bool
+vkr_spec_lookup(const void *data, uint32_t spec_id, uint32_t *value)
+{
+   const VkSpecializationInfo *spec = data;
+   for (uint32_t i = 0; spec && i < spec->mapEntryCount; i++) {
+      const VkSpecializationMapEntry *e = &spec->pMapEntries[i];
+      if (e->constantID != spec_id)
+         continue;
+      uint32_t v = 0;
+      if (e->size && spec->pData)
+         memcpy(&v, (const uint8_t *)spec->pData + e->offset, MIN2(e->size, sizeof(v)));
+      *value = v;
+      return true;
+   }
+   return false;
+}
+
+/* a descriptor a shader uses is in the pipeline layout */
