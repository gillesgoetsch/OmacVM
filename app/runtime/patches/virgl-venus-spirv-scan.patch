+vkr_layout_has(const void *data, uint32_t set, uint32_t binding)
+{
+   const struct vkr_pipeline_layout *layout = data;
+   uint32_t index;
+   return set < layout->set_count && layout->sets[set] &&
+          vkr_set_layout_find(layout->sets[set], binding, &index);
+}
+
+static uint32_t
+vkr_stage_model(VkShaderStageFlagBits stage)
+{
+   switch (stage) {
+   case VK_SHADER_STAGE_VERTEX_BIT: return 0;
+   case VK_SHADER_STAGE_TESSELLATION_CONTROL_BIT: return 1;
+   case VK_SHADER_STAGE_TESSELLATION_EVALUATION_BIT: return 2;
+   case VK_SHADER_STAGE_GEOMETRY_BIT: return 3;
+   case VK_SHADER_STAGE_FRAGMENT_BIT: return 4;
+   case VK_SHADER_STAGE_COMPUTE_BIT: return 5;
+   default: return UINT32_MAX;
+   }
+}
+
+/* the stage's SPIR-V (its module's summary, or a scan of the code chained into the stage)
+ * has an entry point of that name for the stage, a workgroup size inside the device's
+ * limits after specialization, and descriptor sets and bindings the layout has */
+static bool
+vkr_stage_shader_ok(const struct vkr_physical_device *physical_dev,
+                    const struct vkr_pipeline_layout *layout,
+                    const VkPipelineShaderStageCreateInfo *st,
+                    char *why,
+                    size_t why_size)
+{
+   const VkPhysicalDeviceLimits *lim = &physical_dev->properties.limits;
+   const struct vkr_shader_module *module = vkr_shader_module_from_handle(st->module);
+   struct vkr_spirv_info *own = NULL;
+   const struct vkr_spirv_info *spirv = module ? module->spirv : NULL;
+   if (!module) {
+      const VkShaderModuleCreateInfo *code =
+         vkr_find_struct(st->pNext, VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO);
+      own = vkr_spirv_scan(code->pCode, code->codeSize, why, why_size);
+      if (!own)
+         return false;
+      spirv = own;
+   }
+   bool ok = false;
+   const struct vkr_spirv_entry *entry = vkr_spirv_entry(spirv, st->pName, vkr_stage_model(st->stage));
+   uint32_t size[3];
+   if (!spirv) {
+      snprintf(why, why_size, "stage 0x%x: a shader module without its scan", st->stage);
+   } else if (!entry) {
+      snprintf(why, why_size, "stage 0x%x: no entry point \"%.64s\" for the stage", st->stage,
+               st->pName);
+   } else if (st->stage == VK_SHADER_STAGE_COMPUTE_BIT &&
+              (!vkr_spirv_workgroup_size(spirv, entry, vkr_spec_lookup, st->pSpecializationInfo, size) ||
+               !size[0] || !size[1] || !size[2] || size[0] > lim->maxComputeWorkGroupSize[0] ||
+               size[1] > lim->maxComputeWorkGroupSize[1] || size[2] > lim->maxComputeWorkGroupSize[2] ||
+               (uint64_t)size[0] * size[1] * size[2] > lim->maxComputeWorkGroupInvocations)) {
+      snprintf(why, why_size, "a workgroup of %u x %u x %u (at most %u x %u x %u, %u in all)", size[0],
+               size[1], size[2], lim->maxComputeWorkGroupSize[0], lim->maxComputeWorkGroupSize[1],
