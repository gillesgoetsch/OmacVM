+/*
+ * Copyright 2026 OmacVM contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+/* OmacVM (virgl-venus-spirv-scan.patch): see vkr_spirv.h. One pass over the words checks
+ * every instruction's word count against the code and the ids this scan reads against the
+ * bound, and collects entry points, execution modes, decorations, constants, functions,
+ * calls and the ids pointer instructions use into arrays; sorting them by id then joins
+ * them in O(n log n), so no module makes the scan quadratic, and an entry point's descriptor
+ * variables are a walk over its call graph. Plain C, no driver. */
+
+#include "vkr_spirv.h"
+
+#include <inttypes.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define SPV_MAGIC 0x07230203u
+
+enum {
+   OP_SOURCE_CONTINUED = 2, /* 2-8: debug instructions (OpSource ... OpLine) */
+   OP_LINE = 8,
+   OP_UNDEF = 1,
+   OP_EXT_INST = 12,
+   OP_ENTRY_POINT = 15,
+   OP_TYPE_VOID = 19,
+   OP_TYPE_INT = 21,
+   OP_TYPE_FLOAT = 22,
+   OP_TYPE_VECTOR = 23,
+   OP_TYPE_MATRIX = 24,
+   OP_TYPE_IMAGE = 25,
+   OP_TYPE_SAMPLED_IMAGE = 27,
+   OP_TYPE_RUNTIME_ARRAY = 29,
+   OP_TYPE_FUNCTION = 33,
+   OP_TYPE_PIPE = 38,
+   OP_CONSTANT_TRUE = 41,
+   OP_MEMBER_DECORATE = 72,
+   OP_GROUP_MEMBER_DECORATE = 75,
+   OP_NO_LINE = 317,
+   OP_TYPE_PIPE_STORAGE = 322,
+   OP_TYPE_NAMED_BARRIER = 327,
+   OP_MODULE_PROCESSED = 330,
+   OP_DECORATE_ID = 332,
+   OP_TYPE_UNTYPED_POINTER = 4417,
+   OP_TYPE_COOPERATIVE_MATRIX = 4456,
+   OP_TYPE_RAY_QUERY = 4472,
+   OP_TYPE_VECTOR_ID = 5288,
+   OP_TYPE_ACCELERATION_STRUCTURE = 5341,
+   OP_TYPE_COOPERATIVE_MATRIX_NV = 5358,
+   OP_DECORATE_STRING = 5632,
+   OP_MEMBER_DECORATE_STRING = 5633,
+   OP_EXECUTION_MODE = 16,
+   OP_TYPE_ARRAY = 28,
+   OP_TYPE_STRUCT = 30,
+   OP_TYPE_POINTER = 32,
+   OP_CONSTANT = 43,
+   OP_CONSTANT_COMPOSITE = 44,
+   OP_FUNCTION = 54,
+   OP_FUNCTION_END = 56,
+   OP_SPEC_CONSTANT = 50,
+   OP_SPEC_CONSTANT_COMPOSITE = 51,
+   OP_FUNCTION_CALL = 57,
+   OP_VARIABLE = 59,
+   OP_IMAGE_TEXEL_POINTER = 60,
+   OP_LOAD = 61,
+   OP_STORE = 62,
+   OP_COPY_MEMORY = 63,
+   OP_COPY_MEMORY_SIZED = 64,
+   OP_ACCESS_CHAIN = 65,
+   OP_IN_BOUNDS_ACCESS_CHAIN = 66,
+   OP_PTR_ACCESS_CHAIN = 67,
+   OP_ARRAY_LENGTH = 68,
+   OP_DECORATE = 71,
+   OP_IN_BOUNDS_PTR_ACCESS_CHAIN = 70,
+   OP_COPY_OBJECT = 83,
+   OP_CONVERT_PTR_TO_U = 117,
+   OP_PTR_CAST_TO_GENERIC = 121,
+   OP_GENERIC_CAST_TO_PTR = 122,
+   OP_BITCAST = 124,
+   OP_SELECT = 169,
+   OP_ATOMIC_LOAD = 227,
+   OP_ATOMIC_STORE = 228,
+   OP_ATOMIC_EXCHANGE = 229,
+   OP_ATOMIC_XOR = 242,
+   OP_PHI = 245,
+   OP_ATOMIC_FLAG_TEST_AND_SET = 318,
+   OP_ATOMIC_FLAG_CLEAR = 319,
+   OP_EXECUTION_MODE_ID = 331,
+   OP_COPY_LOGICAL = 400,
+   OP_PTR_EQUAL = 401,
+   OP_PTR_NOT_EQUAL = 402,
+   OP_PTR_DIFF = 403,
+   OP_COOPERATIVE_MATRIX_LOAD = 4457,
+   OP_COOPERATIVE_MATRIX_STORE = 4458,
+   OP_UNTYPED_VARIABLE = 4418, /* OpUntypedVariableKHR */
+   OP_ATOMIC_FMIN = 5614,
+   OP_ATOMIC_FMAX = 5615,
+   OP_ATOMIC_FADD = 6035,
+};
+
+enum {
+   DEC_SPEC_ID = 1,
+   DEC_BUILT_IN = 11,
+   DEC_PATCH = 15,
+   DEC_LOCATION = 30,
+   DEC_BINDING = 33,
+   DEC_PER_TASK = 5273,
+   DEC_PER_VERTEX = 5285,
+   DEC_DESCRIPTOR_SET = 34,
+   BUILT_IN_WORKGROUP_SIZE = 25,
+   MODE_LOCAL_SIZE = 17,
+   MODE_LOCAL_SIZE_ID = 38,
+   STORAGE_INPUT = 1,
+   STORAGE_OUTPUT = 3,
+   STORAGE_FUNCTION = 7,
+   MODEL_TESS_CONTROL = 1,
+   MODEL_TESS_EVAL = 2,
+   MODEL_GEOMETRY = 3,
+   MODEL_FRAGMENT = 4,
+   MODEL_MESH_NV = 5268,
+   MODEL_MESH_EXT = 5365,
+};
+
+/* a decoration this scan keeps: SpecId, Binding or DescriptorSet with its value; Location,
+ * BuiltIn (a member's too, under its struct's id), Patch, PerVertexKHR or PerTaskNV */
+struct deco {
+   uint32_t id, kind, value;
+};
+
+/* a constant composite (a WorkgroupSize built-in is one of three ids) */
+struct composite {
+   uint32_t id, count, v[3];
+};
+
+/* a LocalSize or LocalSizeId execution mode */
+struct mode {
+   uint32_t function, kind, v[3];
+};
+
+/* a pointer type: its id, pointee and storage class */
+struct pointer {
+   uint32_t id, pointee, storage;
+};
+
+/* a Function variable: its pointer type, or (untyped) its data type */
+struct local {
+   uint32_t type;
+   bool pointer;
+};
+
+/* an Input or Output variable as declared */
+struct io {
+   uint32_t id, type, storage;
+   bool pointer;
+};
+
+/* a growing array */
+struct vec {
+   void *p;
+   uint32_t n, cap;
+};
+
+struct scan {
+   const uint32_t *w;
+   size_t n; /* words */
+   uint32_t bound;
+   char *why;
+   size_t why_size;
+   struct vkr_spirv_info *info;
+   struct vec entries, names, decos, modes, consts, composites, functions, calls, uses;
+   struct vec types, members, pointers, locals, ios, interface;
+   /* per id (bound entries): a type's weight (0: not a type), a value's type, struct types */
+   uint32_t *weight, *type_of;
+   uint8_t *is_struct;
+   uint64_t cost;
+   uint32_t workgroup_composite;
+   uint32_t function; /* the function the instruction is in, or 0 */
+};
+
+static bool
+fail(struct scan *s, const char *msg, size_t at)
+{
+   snprintf(s->why, s->why_size, "SPIR-V: %s (word %zu)", msg, at);
+   return false;
+}
+
+/* room for `count` more elements of `elem` bytes */
+static void *
+vec_add(struct vec *v, uint32_t count, size_t elem)
+{
+   if (v->n + (uint64_t)count > v->cap) {
+      uint64_t c = v->cap ? v->cap : 16;
+      while (c < v->n + (uint64_t)count)
+         c *= 2;
+      if (c > UINT32_MAX)
+         return NULL;
+      void *q = realloc(v->p, (size_t)c * elem);
+      if (!q)
+         return NULL;
+      v->p = q;
+      v->cap = (uint32_t)c;
+   }
+   void *at = (char *)v->p + (size_t)v->n * elem;
+   v->n += count;
+   return at;
+}
+
+static int
+cmp_u32(const void *a, const void *b)
+{
+   const uint32_t x = *(const uint32_t *)a, y = *(const uint32_t *)b;
+   return x < y ? -1 : x > y;
+}
+
+/* elements whose first uint32 is the key, sorted: the first with `key`, or NULL */
+static const void *
+find(const struct vec *v, size_t elem, uint32_t key)
+{
+   uint32_t lo = 0, hi = v->n;
+   while (lo < hi) {
+      const uint32_t mid = lo + (hi - lo) / 2;
+      const uint32_t k = *(const uint32_t *)((const char *)v->p + (size_t)mid * elem);
+      if (k < key)
+         lo = mid + 1;
+      else
+         hi = mid;
+   }
+   if (lo < v->n && *(const uint32_t *)((const char *)v->p + (size_t)lo * elem) == key)
+      return (const char *)v->p + (size_t)lo * elem;
+   return NULL;
+}
+
+/* a literal string in words [at, end): its length, or -1 when it does not end there */
+static int
+string_len(const struct scan *s, size_t at, size_t end)
+{
+   const char *p = (const char *)&s->w[at];
+   const void *nul = memchr(p, 0, (end - at) * 4);
+   return nul ? (int)((const char *)nul - p) : -1;
+}
+
+static bool
+id_ok(const struct scan *s, uint32_t id)
+{
+   return id && id < s->bound;
+}
+
+/* a function names id in a pointer instruction (outside functions nothing is used) */
+static bool
+use(struct scan *s, uint32_t id)
+{
+   if (!s->function)
+      return true;
+   struct vkr_spirv_pair *u = vec_add(&s->uses, 1, sizeof(*u));
+   if (u)
+      *u = (struct vkr_spirv_pair){ s->function, id };
+   return u != NULL;
+}
+
+static bool
+record(struct scan *s, size_t at, uint32_t op, uint32_t len)
+{
+   const uint32_t *w = &s->w[at];
+   switch (op) {
+   case OP_ENTRY_POINT: {
+      if (len < 4 || !id_ok(s, w[2]))
+         return fail(s, "an entry point without a function or name", at);
+      const int nl = string_len(s, at + 3, at + len);
+      if (nl < 0)
+         return fail(s, "an entry point name that does not end", at);
+      struct vkr_spirv_entry *e = vec_add(&s->entries, 1, sizeof(*e));
+      char *name = vec_add(&s->names, (uint32_t)nl + 1, 1);
+      if (!e || !name)
+         return fail(s, "out of host memory", at);
+      memset(e, 0, sizeof(*e));
+      e->model = w[1];
+      e->function = w[2];
+      e->name = (uint32_t)(name - (char *)s->names.p);
+      memcpy(name, &w[3], (size_t)nl + 1);
+      for (size_t i = 3 + ((size_t)nl + 4) / 4; i < len; i++) {
+         if (!id_ok(s, w[i]))
+            return fail(s, "an entry point interface id past the bound", at);
+         struct vkr_spirv_pair *p = vec_add(&s->interface, 1, sizeof(*p));
+         if (!p)
+            return fail(s, "out of host memory", at);
+         *p = (struct vkr_spirv_pair){ s->entries.n - 1, w[i] };
+      }
+      return true;
+   }
+   case OP_EXECUTION_MODE:
+   case OP_EXECUTION_MODE_ID: {
+      if (len < 3 || !id_ok(s, w[1]))
+         return fail(s, "an execution mode without an entry point", at);
+      if (!((op == OP_EXECUTION_MODE && w[2] == MODE_LOCAL_SIZE) ||
+            (op == OP_EXECUTION_MODE_ID && w[2] == MODE_LOCAL_SIZE_ID)))
+         return true;
+      if (len != 6)
+         return fail(s, "a workgroup size without three values", at);
+      if (op == OP_EXECUTION_MODE_ID && (!id_ok(s, w[3]) || !id_ok(s, w[4]) || !id_ok(s, w[5])))
+         return fail(s, "a workgroup size id past the bound", at);
+      struct mode *m = vec_add(&s->modes, 1, sizeof(*m));
+      if (!m)
+         return fail(s, "out of host memory", at);
+      *m = (struct mode){ .function = w[1], .kind = op == OP_EXECUTION_MODE ? 1 : 2 };
+      memcpy(m->v, &w[3], sizeof(m->v));
+      return true;
+   }
+   case OP_DECORATE:
+      if (len < 3 || !id_ok(s, w[1]))
+         return fail(s, "a decoration of an id past the bound", at);
+      if (w[2] == DEC_BUILT_IN && len >= 4 && w[3] == BUILT_IN_WORKGROUP_SIZE) {
+         s->workgroup_composite = w[1];
+      } else if (w[2] == DEC_SPEC_ID || w[2] == DEC_BINDING || w[2] == DEC_DESCRIPTOR_SET ||
+                 w[2] == DEC_LOCATION) {
+         if (len < 4)
+            return fail(s, "a decoration without its value", at);
+         struct deco *d = vec_add(&s->decos, 1, sizeof(*d));
+         if (!d)
+            return fail(s, "out of host memory", at);
+         *d = (struct deco){ w[1], w[2], w[3] };
+      } else if (w[2] == DEC_BUILT_IN || w[2] == DEC_PATCH || w[2] == DEC_PER_VERTEX ||
+                 w[2] == DEC_PER_TASK) {
+         struct deco *d = vec_add(&s->decos, 1, sizeof(*d));
+         if (!d)
+            return fail(s, "out of host memory", at);
+         *d = (struct deco){ w[1], w[2], 0 };
+      }
+      return true;
+   case OP_MEMBER_DECORATE:
+      /* a struct with a BuiltIn member is a built-in block: kept as BuiltIn on the struct */
+      if (len >= 4 && w[3] == DEC_BUILT_IN && id_ok(s, w[1])) {
+         struct deco *d = vec_add(&s->decos, 1, sizeof(*d));
+         if (!d)
+            return fail(s, "out of host memory", at);
+         *d = (struct deco){ w[1], DEC_BUILT_IN, 0 };
+      }
+      return true;
+   case OP_CONSTANT:
+   case OP_SPEC_CONSTANT: {
+      if (len < 4 || !id_ok(s, w[2]))
+         return fail(s, "a constant without a value", at);
+      struct vkr_spirv_constant *c = vec_add(&s->consts, 1, sizeof(*c));
+      if (!c)
+         return fail(s, "out of host memory", at);
+      /* spec_id 0 marks a spec constant until the SpecId decorations are joined */
+      *c = (struct vkr_spirv_constant){ .id = w[2], .spec_id = op == OP_CONSTANT ? UINT32_MAX : 0,
+                                        .value = w[3], .high = len >= 5 ? w[4] : 0, .wide = len >= 5 };
+      return true;
+   }
+   /* what variables' elements and locations are counted through */
+   case OP_TYPE_INT:
+   case OP_TYPE_FLOAT:
+   case OP_TYPE_VECTOR:
+   case OP_TYPE_MATRIX:
+   case OP_TYPE_RUNTIME_ARRAY: {
+      if (len < 3 || !id_ok(s, w[1]))
+         return fail(s, "a type without an id", at);
+      struct vkr_spirv_type *t = vec_add(&s->types, 1, sizeof(*t));
+      if (!t)
+         return fail(s, "out of host memory", at);
+      const uint32_t kind = op == OP_TYPE_INT || op == OP_TYPE_FLOAT ? VKR_SPIRV_TYPE_SCALAR
+                            : op == OP_TYPE_VECTOR                  ? VKR_SPIRV_TYPE_VECTOR
+                            : op == OP_TYPE_MATRIX                  ? VKR_SPIRV_TYPE_MATRIX
+                                                                    : VKR_SPIRV_TYPE_RUNTIME_ARRAY;
+      *t = (struct vkr_spirv_type){ w[1], kind, w[2], len >= 4 ? w[3] : 0 };
+      return true;
+   }
+   case OP_TYPE_ARRAY: {
+      if (len != 4 || !id_ok(s, w[1]) || !id_ok(s, w[2]) || !id_ok(s, w[3]))
+         return fail(s, "an array type without its element and length", at);
+      struct vkr_spirv_type *t = vec_add(&s->types, 1, sizeof(*t));
+      if (!t)
+         return fail(s, "out of host memory", at);
+      *t = (struct vkr_spirv_type){ w[1], VKR_SPIRV_TYPE_ARRAY, w[2], w[3] };
+      return true;
+   }
+   case OP_TYPE_STRUCT: {
+      if (len < 2 || !id_ok(s, w[1]))
+         return fail(s, "a struct type without an id", at);
+      for (uint32_t i = 2; i < len; i++) {
+         if (!id_ok(s, w[i]))
+            return fail(s, "a struct member past the bound", at);
+      }
+      const uint32_t first = s->members.n;
+      struct vkr_spirv_type *t = vec_add(&s->types, 1, sizeof(*t));
+      uint32_t *m = vec_add(&s->members, len - 2, sizeof(*m));
+      if (!t || (len > 2 && !m))
+         return fail(s, "out of host memory", at);
+      *t = (struct vkr_spirv_type){ w[1], VKR_SPIRV_TYPE_STRUCT, first, len - 2 };
+      if (len > 2)
+         memcpy(m, &w[2], (size_t)(len - 2) * sizeof(*m));
+      return true;
+   }
+   case OP_TYPE_POINTER:
+      if (len == 4) {
+         struct pointer *p = vec_add(&s->pointers, 1, sizeof(*p));
+         if (!p)
+            return fail(s, "out of host memory", at);
+         *p = (struct pointer){ w[1], w[3], w[2] };
+      }
+      return true;
+   case OP_VARIABLE:
+   case OP_UNTYPED_VARIABLE:
+      if (len < 4)
+         return fail(s, "a variable without a storage class", at);
+      /* an untyped variable's elements are its data type's, when it has one */
+      if (w[3] == STORAGE_FUNCTION && (op == OP_VARIABLE || len >= 5)) {
+         struct local *l = vec_add(&s->locals, 1, sizeof(*l));
+         if (!l)
+            return fail(s, "out of host memory", at);
+         *l = (struct local){ op == OP_VARIABLE ? w[1] : w[4], op == OP_VARIABLE };
+      }
+      if ((w[3] == STORAGE_INPUT || w[3] == STORAGE_OUTPUT) && id_ok(s, w[2]) &&
+          (op == OP_VARIABLE || len >= 5)) {
+         struct io *v = vec_add(&s->ios, 1, sizeof(*v));
+         if (!v)
+            return fail(s, "out of host memory", at);
+         *v = (struct io){ w[2], op == OP_VARIABLE ? w[1] : w[4], w[3], op == OP_VARIABLE };
+      }
+      return true;
+   case OP_FUNCTION: {
+      if (len < 5 || !id_ok(s, w[2]) || s->function)
+         return fail(s, "a function without an id or inside another", at);
+      uint32_t *f = vec_add(&s->functions, 1, sizeof(*f));
+      if (!f)
+         return fail(s, "out of host memory", at);
+      *f = s->function = w[2];
+      return true;
+   }
+   case OP_FUNCTION_END:
+      s->function = 0;
+      return true;
+   case OP_CONSTANT_COMPOSITE:
+   case OP_SPEC_CONSTANT_COMPOSITE:
+      if (len < 3 || !id_ok(s, w[2]))
+         return fail(s, "a composite without an id", at);
+      for (uint32_t i = 3; i < len; i++) {
+         if (!id_ok(s, w[i]))
+            return fail(s, "a composite constituent past the bound", at);
+      }
+      /* kept whatever the order of the decoration: the join finds the WorkgroupSize one */
+      {
+         struct composite *c = vec_add(&s->composites, 1, sizeof(*c));
+         if (!c)
+            return fail(s, "out of host memory", at);
+         *c = (struct composite){ .id = w[2], .count = len - 3 };
+         if (len == 6)
+            memcpy(c->v, &w[3], sizeof(c->v));
+      }
+      return true;
+   /* instructions that take pointers: a descriptor variable they name is used (the pointer
+    * operand at word 3, at word 1 for stores; every operand of calls, selects, phis and
+    * pointer comparisons). Names, decorations and debug instructions are no use. */
+   case OP_LOAD:
+   case OP_ACCESS_CHAIN:
+   case OP_IN_BOUNDS_ACCESS_CHAIN:
+   case OP_PTR_ACCESS_CHAIN:
+   case OP_IN_BOUNDS_PTR_ACCESS_CHAIN:
+   case OP_IMAGE_TEXEL_POINTER:
+   case OP_ARRAY_LENGTH:
+   case OP_COPY_OBJECT:
+   case OP_COPY_LOGICAL:
+   case OP_CONVERT_PTR_TO_U:
+   case OP_PTR_CAST_TO_GENERIC:
+   case OP_GENERIC_CAST_TO_PTR:
+   case OP_BITCAST:
+   case OP_ATOMIC_LOAD:
+   case OP_ATOMIC_FLAG_TEST_AND_SET:
+   case OP_ATOMIC_FMIN:
+   case OP_ATOMIC_FMAX:
+   case OP_ATOMIC_FADD:
+   case OP_COOPERATIVE_MATRIX_LOAD:
+      return len < 4 || use(s, w[3]) || fail(s, "out of host memory", at);
+   case OP_STORE:
+   case OP_COPY_MEMORY:
+   case OP_COPY_MEMORY_SIZED:
+   case OP_ATOMIC_STORE:
+   case OP_ATOMIC_FLAG_CLEAR:
+   case OP_COOPERATIVE_MATRIX_STORE:
+      for (uint32_t i = 1; i < len && i < 3; i++) {
+         if (!use(s, w[i]))
+            return fail(s, "out of host memory", at);
+      }
+      return true;
+   case OP_SELECT:
+   case OP_PTR_EQUAL:
+   case OP_PTR_NOT_EQUAL:
+   case OP_PTR_DIFF:
+   case OP_PHI:
+   case OP_FUNCTION_CALL:
+      if (op == OP_FUNCTION_CALL && s->function && len >= 4) {
+         struct vkr_spirv_pair *c = vec_add(&s->calls, 1, sizeof(*c));
+         if (!c)
+            return fail(s, "out of host memory", at);
+         *c = (struct vkr_spirv_pair){ s->function, w[3] };
+      }
+      for (uint32_t i = op == OP_FUNCTION_CALL ? 4 : 3; i < len; i++) {
+         if (!use(s, w[i]))
+            return fail(s, "out of host memory", at);
+      }
+      return true;
+   default:
+      if (op >= OP_ATOMIC_EXCHANGE && op <= OP_ATOMIC_XOR)
+         return len < 4 || use(s, w[3]) || fail(s, "out of host memory", at);
+      return true;
+   }
+}
+
+static bool
+is_type(uint32_t op)
+{
+   return (op >= OP_TYPE_VOID && op <= OP_TYPE_PIPE) || op == OP_TYPE_PIPE_STORAGE ||
+          op == OP_TYPE_NAMED_BARRIER || op == OP_TYPE_UNTYPED_POINTER ||
+          op == OP_TYPE_COOPERATIVE_MATRIX || op == OP_TYPE_RAY_QUERY || op == OP_TYPE_VECTOR_ID ||
+          op == OP_TYPE_ACCELERATION_STRUCTURE || op == OP_TYPE_COOPERATIVE_MATRIX_NV;
+}
+
+/* a type's weight, 1 for an id that is none (yet) */
+static uint64_t
+weight(const struct scan *s, uint32_t id)
+{
+   return id < s->bound && s->weight[id] ? s->weight[id] : 1;
+}
+
+/* What spirv-val's walks over types may cost (vkr_spirv.h, VKR_SPIRV_MAX_TYPE_COST; refused
+ * in vkr_spirv_validate.c). A type
+ * weighs 1 plus its parts: an element, a pointee, members, a function's return and
+ * parameters; an array of structs 16 times its element (the layout check walks up to 16 of
+ * them, each one again). Every instruction then costs the weights of the types it names
+ * and of the values it reads; debug instructions cost nothing. Types come before their
+ * use (a forward pointer's pointee weighs 1), so one pass suffices. */
+static bool
+instruction(struct scan *s, size_t at, uint32_t op, uint32_t len)
+{
+   const uint32_t *w = &s->w[at];
+   if (!(op >= OP_SOURCE_CONTINUED && op <= OP_LINE) && op != OP_NO_LINE &&
+       op != OP_MODULE_PROCESSED) {
+      for (uint32_t i = 1; i < len; i++) {
+         if (!w[i] || w[i] >= s->bound)
+            continue;
+         const uint32_t t = s->weight[w[i]] ? w[i] : s->type_of[w[i]];
+         s->cost += t ? s->weight[t] : 0;
+      }
+   }
+   if (!record(s, at, op, len))
+      return false;
+   if (is_type(op) && len >= 2 && id_ok(s, w[1])) {
+      uint64_t n = 1;
+      switch (op) {
+      case OP_TYPE_ARRAY:
+         n += len >= 3 ? (s->is_struct[w[2] < s->bound ? w[2] : 0] ? 16 : 1) * weight(s, w[2]) : 0;
+         break;
+      case OP_TYPE_POINTER:
+         n += len >= 4 ? weight(s, w[3]) : 0;
+         break;
+      case OP_TYPE_STRUCT:
+      case OP_TYPE_FUNCTION:
+         for (uint32_t i = 2; i < len; i++)
+            n += weight(s, w[i]);
+         break;
+      case OP_TYPE_VECTOR:
+      case OP_TYPE_MATRIX:
+      case OP_TYPE_IMAGE:
+      case OP_TYPE_SAMPLED_IMAGE:
+      case OP_TYPE_RUNTIME_ARRAY:
+      case OP_TYPE_COOPERATIVE_MATRIX:
+      case OP_TYPE_VECTOR_ID:
+      case OP_TYPE_COOPERATIVE_MATRIX_NV:
+         n += len >= 3 ? weight(s, w[2]) : 0;
+         break;
+      default:
+         break;
+      }
+      s->weight[w[1]] = n < UINT32_MAX ? (uint32_t)n : UINT32_MAX;
+      s->is_struct[w[1]] = op == OP_TYPE_STRUCT;
+   } else if ((op == OP_UNDEF || op == OP_EXT_INST || op >= OP_CONSTANT_TRUE) &&
+              !(op >= OP_DECORATE && op <= OP_GROUP_MEMBER_DECORATE) && op != OP_DECORATE_ID &&
+              op != OP_DECORATE_STRING && op != OP_MEMBER_DECORATE_STRING && len >= 3 &&
+              w[1] < s->bound && s->weight[w[1]] && id_ok(s, w[2]) && !s->weight[w[2]]) {
+      /* a value: its type is word 1 */
+      s->type_of[w[2]] = w[1];
+   }
+   return true;
+}
+
+/* the joins: execution modes into entries, SpecIds into constants, used descriptor
+ * variables into bindings */
+static bool
+join(struct scan *s)
+{
+   struct vkr_spirv_info *info = s->info;
+   /* not the entry points' interfaces: from SPIR-V 1.4 they list globals, but glslang lists
+    * unused ones too, which a valid pipeline layout need not have */
+   qsort(s->modes.p, s->modes.n, sizeof(struct mode), cmp_u32);
+   qsort(s->decos.p, s->decos.n, sizeof(struct deco), cmp_u32);
+   qsort(s->consts.p, s->consts.n, sizeof(struct vkr_spirv_constant), cmp_u32);
+   qsort(s->composites.p, s->composites.n, sizeof(struct composite), cmp_u32);
+   qsort(s->functions.p, s->functions.n, sizeof(uint32_t), cmp_u32);
+   qsort(s->calls.p, s->calls.n, sizeof(struct vkr_spirv_pair), cmp_u32);
+   qsort(s->uses.p, s->uses.n, sizeof(struct vkr_spirv_pair), cmp_u32);
+   qsort(s->types.p, s->types.n, sizeof(struct vkr_spirv_type), cmp_u32);
+   qsort(s->pointers.p, s->pointers.n, sizeof(struct pointer), cmp_u32);
+
+   struct vkr_spirv_entry *entries = s->entries.p;
+   for (uint32_t i = 0; i < s->entries.n; i++) {
+      const struct mode *m = find(&s->modes, sizeof(*m), entries[i].function);
+      if (!m)
+         continue;
+      entries[i].local_size_kind = (uint8_t)m->kind;
+      memcpy(m->kind == 1 ? entries[i].local_size : entries[i].local_size_id, m->v, sizeof(m->v));
+   }
+   /* a spec constant's SpecId: the decorations of its id (sorted by id, any kind) */
+   struct vkr_spirv_constant *consts = s->consts.p;
+   const struct deco *decos = s->decos.p;
+   for (uint32_t i = 0; i < s->consts.n; i++) {
+      if (consts[i].spec_id == UINT32_MAX)
+         continue;
+      consts[i].spec_id = UINT32_MAX - 1; /* no SpecId: its default value only */
+      for (const struct deco *d = find(&s->decos, sizeof(*d), consts[i].id);
+           d && d < decos + s->decos.n && d->id == consts[i].id; d++) {
+         if (d->kind == DEC_SPEC_ID)
+            consts[i].spec_id = d->value;
+      }
+   }
+   /* descriptor variables: ids with a DescriptorSet decoration (sorted by id) */
+   struct vec vars = { 0 };
+   for (uint32_t i = 0; i < s->decos.n;) {
+      const uint32_t id = decos[i].id;
+      uint32_t set = UINT32_MAX, binding = 0;
+      for (; i < s->decos.n && decos[i].id == id; i++) {
+         if (decos[i].kind == DEC_DESCRIPTOR_SET)
+            set = decos[i].value;
+         else if (decos[i].kind == DEC_BINDING)
+            binding = decos[i].value;
+      }
+      if (set == UINT32_MAX)
+         continue;
+      struct vkr_spirv_var *v = vec_add(&vars, 1, sizeof(*v));
+      if (!v) {
+         free(vars.p);
+         return fail(s, "out of host memory", 0);
+      }
+      *v = (struct vkr_spirv_var){ id, set, binding };
+   }
+   info->entries = s->entries.p;
+   info->entry_count = s->entries.n;
+   info->names = s->names.p;
+   info->constants = s->consts.p;
+   info->constant_count = s->consts.n;
+   info->vars = vars.p;
+   info->var_count = vars.n;
+   info->functions = s->functions.p;
+   info->function_count = s->functions.n;
+   info->calls = s->calls.p;
+   info->call_count = s->calls.n;
+   info->uses = s->uses.p;
+   info->use_count = s->uses.n;
+   info->types = s->types.p;
+   info->type_count = s->types.n;
+   info->members = s->members.p;
+   info->member_count = s->members.n;
+   s->entries.p = s->names.p = s->consts.p = s->functions.p = s->calls.p = s->uses.p = NULL;
+   s->types.p = s->members.p = NULL;
+   /* each Function variable's type: the pointee of its pointer type (0: none known) */
+   if (s->locals.n) {
+      info->locals = malloc(sizeof(uint32_t) * (size_t)s->locals.n);
+      if (!info->locals)
+         return fail(s, "out of host memory", 0);
+      const struct local *locals = s->locals.p;
+      for (uint32_t i = 0; i < s->locals.n; i++) {
+         const struct pointer *p =
+            locals[i].pointer ? find(&s->pointers, sizeof(*p), locals[i].type) : NULL;
+         info->locals[i] = locals[i].pointer ? (p ? p->pointee : 0) : locals[i].type;
+      }
+      info->local_count = s->locals.n;
+   }
+   /* Input and Output variables: their data type, Location and the decorations that decide
+    * whether they are arrayed or built in, sorted by id */
+   if (s->ios.n) {
+      info->ios = calloc(s->ios.n, sizeof(*info->ios));
+      if (!info->ios)
+         return fail(s, "out of host memory", 0);
+      const struct io *ios = s->ios.p;
+      for (uint32_t i = 0; i < s->ios.n; i++) {
+         struct vkr_spirv_io *v = &info->ios[i];
+         const struct pointer *p = ios[i].pointer ? find(&s->pointers, sizeof(*p), ios[i].type) : NULL;
+         *v = (struct vkr_spirv_io){ .id = ios[i].id, .storage = ios[i].storage,
+                                     .type = ios[i].pointer ? (p ? p->pointee : 0) : ios[i].type,
+                                     .location = UINT32_MAX };
+         for (const struct deco *d = find(&s->decos, sizeof(*d), v->id);
+              d && d < decos + s->decos.n && d->id == v->id; d++) {
+            if (d->kind == DEC_LOCATION)
+               v->location = d->value;
+            else if (d->kind == DEC_BUILT_IN)
+               v->flags |= VKR_SPIRV_IO_BUILT_IN;
+            else if (d->kind == DEC_PATCH)
+               v->flags |= VKR_SPIRV_IO_PATCH;
+            else if (d->kind == DEC_PER_VERTEX)
+               v->flags |= VKR_SPIRV_IO_PER_VERTEX;
+            else if (d->kind == DEC_PER_TASK)
+               v->flags |= VKR_SPIRV_IO_PER_TASK;
+         }
+         /* a built-in block, also one arrayed per vertex */
+         const struct vkr_spirv_type *t = find(&(struct vec){ .p = info->types, .n = info->type_count },
+                                               sizeof(*t), v->type);
+         const uint32_t inner = t && (t->kind == VKR_SPIRV_TYPE_ARRAY ||
+                                      t->kind == VKR_SPIRV_TYPE_RUNTIME_ARRAY) ? t->a : 0;
+         for (const struct deco *d = find(&s->decos, sizeof(*d), v->type);
+              d && d < decos + s->decos.n && d->id == v->type; d++) {
+            if (d->kind == DEC_BUILT_IN)
+               v->flags |= VKR_SPIRV_IO_BUILT_IN_TYPE;
+         }
+         for (const struct deco *d = inner ? find(&s->decos, sizeof(*d), inner) : NULL;
+              d && d < decos + s->decos.n && d->id == inner; d++) {
+            if (d->kind == DEC_BUILT_IN)
+               v->flags |= VKR_SPIRV_IO_BUILT_IN_ELEMENT;
+         }
+      }
+      qsort(info->ios, s->ios.n, sizeof(*info->ios), cmp_u32);
+      info->io_count = s->ios.n;
+   }
+   info->interface = s->interface.p;
+   info->interface_count = s->interface.n;
+   s->interface.p = NULL;
+   info->type_cost = s->cost;
+   const struct composite *wg =
+      s->workgroup_composite ? find(&s->composites, sizeof(*wg), s->workgroup_composite) : NULL;
+   if (wg && wg->count != 3)
+      return fail(s, "a WorkgroupSize that is not three values", 0);
+   if (wg)
+      memcpy(info->workgroup_size, wg->v, sizeof(wg->v));
+   return true;
+}
+
+struct vkr_spirv_info *
+vkr_spirv_scan(const uint32_t *code, size_t bytes, char *why, size_t why_size)
+{
+   struct scan s = { .w = code, .n = bytes / 4, .why = why, .why_size = why_size };
+   if (!code || bytes % 4 || s.n < 5) {
+      fail(&s, "shorter than its header or not whole words", 0);
+      return NULL;
+   }
+   const uint32_t version = code[1];
+   if (code[0] != SPV_MAGIC) {
+      fail(&s, "not SPIR-V (magic)", 0);
+      return NULL;
+   }
+   if ((version >> 16) != 1 || ((version >> 8) & 0xff) > 6 || (version & 0xff)) {
+      fail(&s, "an unknown SPIR-V version", 1);
+      return NULL;
+   }
+   s.bound = code[3];
+   if (!s.bound || s.bound > VKR_SPIRV_MAX_BOUND || code[4]) {
+      snprintf(why, why_size, "SPIR-V: id bound %u (at most %u) or schema %u", s.bound,
+               VKR_SPIRV_MAX_BOUND, code[4]);
+      return NULL;
+   }
+   s.info = calloc(1, sizeof(*s.info));
+   s.weight = calloc(s.bound, 2 * sizeof(uint32_t));
+   s.type_of = s.weight ? s.weight + s.bound : NULL;
+   s.is_struct = calloc(s.bound, 1);
+   bool ok = (s.info && s.weight && s.is_struct) || fail(&s, "out of host memory", 0);
+   for (size_t at = 5; ok && at < s.n;) {
+      const uint32_t len = code[at] >> 16, op = code[at] & 0xffff;
+      if (!len || len > s.n - at) {
+         ok = fail(&s, "an instruction past the end of the code", at);
+         break;
+      }
+      ok = instruction(&s, at, op, len);
+      at += len;
+   }
+   if (ok && !s.entries.n)
+      ok = fail(&s, "no entry point", 0);
+   if (ok)
+      ok = join(&s);
+   free(s.entries.p);
+   free(s.names.p);
+   free(s.decos.p);
+   free(s.modes.p);
+   free(s.consts.p);
+   free(s.composites.p);
+   free(s.functions.p);
+   free(s.calls.p);
+   free(s.uses.p);
+   free(s.types.p);
+   free(s.members.p);
+   free(s.pointers.p);
+   free(s.locals.p);
+   free(s.ios.p);
+   free(s.interface.p);
+   free(s.weight);
+   free(s.is_struct);
+   if (!ok) {
+      vkr_spirv_free(s.info);
+      return NULL;
+   }
+   return s.info;
+}
+
+void
+vkr_spirv_free(struct vkr_spirv_info *info)
+{
+   if (!info)
+      return;
+   free(info->entries);
+   free(info->names);
+   free(info->constants);
+   free(info->vars);
+   free(info->functions);
+   free(info->calls);
+   free(info->uses);
+   free(info->types);
+   free(info->members);
+   free(info->locals);
+   free(info->ios);
+   free(info->interface);
+   free(info);
+}
+
+const struct vkr_spirv_entry *
+vkr_spirv_entry(const struct vkr_spirv_info *info, const char *name, uint32_t model)
+{
+   for (uint32_t i = 0; info && name && i < info->entry_count; i++) {
+      const struct vkr_spirv_entry *e = &info->entries[i];
+      if (e->model == model && !strcmp(info->names + e->name, name))
+         return e;
+   }
+   return NULL;
+}
+
+/* a constant's value after specialization (constants are sorted by id) */
+static bool
+constant_value(const struct vkr_spirv_info *info,
+               uint32_t id,
+               bool (*lookup)(const void *data, uint32_t spec_id, uint32_t *value),
+               const void *data,
+               uint32_t *value)
+{
+   const struct vec v = { .p = info->constants, .n = info->constant_count };
+   const struct vkr_spirv_constant *c = find(&v, sizeof(*c), id);
+   if (!c)
+      return false;
+   *value = c->value;
+   if (c->spec_id < UINT32_MAX - 1 && lookup)
+      lookup(data, c->spec_id, value);
+   return true;
+}
+
+bool
+vkr_spirv_workgroup_size(const struct vkr_spirv_info *info,
+                         const struct vkr_spirv_entry *entry,
+                         bool (*lookup)(const void *data, uint32_t spec_id, uint32_t *value),
+                         const void *data,
+                         uint32_t size[3])
+{
+   size[0] = size[1] = size[2] = 1;
+   /* the WorkgroupSize built-in wins over the execution modes */
+   if (info->workgroup_size[0]) {
+      for (int i = 0; i < 3; i++) {
+         if (!constant_value(info, info->workgroup_size[i], lookup, data, &size[i]))
+            return false;
+      }
+      return true;
+   }
+   if (entry->local_size_kind == 1) {
+      memcpy(size, entry->local_size, sizeof(entry->local_size));
+      return true;
+   }
+   if (entry->local_size_kind == 2) {
+      for (int i = 0; i < 3; i++) {
+         if (!constant_value(info, entry->local_size_id[i], lookup, data, &size[i]))
+            return false;
+      }
+   }
+   return true;
+}
+
+/* the index of a function id in the sorted list, or UINT32_MAX */
+static uint32_t
+function_index(const struct vkr_spirv_info *info, uint32_t id)
+{
+   const struct vec v = { .p = info->functions, .n = info->function_count };
+   const uint32_t *f = find(&v, sizeof(*f), id);
+   return f ? (uint32_t)(f - info->functions) : UINT32_MAX;
+}
+
+bool
+vkr_spirv_bindings_ok(const struct vkr_spirv_info *info,
+                      const struct vkr_spirv_entry *entry,
+                      bool (*ok)(const void *data, uint32_t set, uint32_t binding),
+                      const void *data,
+                      uint32_t *set,
+                      uint32_t *binding)
+{
+   *set = *binding = UINT32_MAX;
+   const uint32_t first = function_index(info, entry->function);
+   if (first == UINT32_MAX)
+      return true;
+   /* breadth first over the call graph: each function once */
+   uint8_t *seen = calloc(info->function_count, 1);
+   uint32_t *queue = malloc(sizeof(*queue) * (size_t)info->function_count);
+   bool result = seen && queue;
+   uint32_t head = 0, tail = 0;
+   if (result) {
+      seen[first] = 1;
+      queue[tail++] = first;
+   }
+   const struct vec calls = { .p = info->calls, .n = info->call_count };
+   const struct vec uses = { .p = info->uses, .n = info->use_count };
+   const struct vec vars = { .p = info->vars, .n = info->var_count };
+   while (result && head < tail) {
+      const uint32_t function = info->functions[queue[head++]];
+      for (const struct vkr_spirv_pair *c = find(&calls, sizeof(*c), function);
+           c && c < info->calls + info->call_count && c->function == function; c++) {
+         const uint32_t callee = function_index(info, c->id);
+         if (callee != UINT32_MAX && !seen[callee]) {
+            seen[callee] = 1;
+            queue[tail++] = callee;
+         }
+      }
+      for (const struct vkr_spirv_pair *u = find(&uses, sizeof(*u), function);
+           result && u && u < info->uses + info->use_count && u->function == function; u++) {
+         const struct vkr_spirv_var *v = find(&vars, sizeof(*v), u->id);
+         if (v && !ok(data, v->set, v->binding)) {
+            *set = v->set;
+            *binding = v->binding;
+            result = false;
+         }
+      }
+   }
+   free(seen);
+   free(queue);
+   return result;
+}
+
+/* one type's elements (memo: 0 not yet, 1 counting, 2 counted into elems) */
+struct elements {
+   const struct vkr_spirv_info *info;
+   bool (*lookup)(const void *data, uint32_t spec_id, uint32_t *value);
+   const void *data;
+   uint8_t *state;
+   uint64_t *elems;
+};
+
+static bool
+type_elements(struct elements *e, uint32_t id, unsigned depth, uint64_t *out)
+{
+   const struct vec types = { .p = e->info->types, .n = e->info->type_count };
+   const struct vkr_spirv_type *t = find(&types, sizeof(*t), id);
+   if (!t) {
+      *out = 1; /* a scalar, vector, matrix, pointer, image ... */
+      return true;
+   }
+   const size_t at = (size_t)(t - e->info->types);
+   if (e->state[at] == 2) {
+      *out = e->elems[at];
+      return true;
+   }
+   if (e->state[at] == 1 || depth > 64)
+      return false;
+   e->state[at] = 1;
+   uint64_t n = 0;
+   if (t->kind == VKR_SPIRV_TYPE_ARRAY) {
+      uint32_t lo;
+      uint64_t inner;
+      const struct vec v = { .p = e->info->constants, .n = e->info->constant_count };
+      const struct vkr_spirv_constant *c = find(&v, sizeof(*c), t->b);
+      if (!c || !constant_value(e->info, t->b, e->lookup, e->data, &lo) ||
+          !type_elements(e, t->a, depth + 1, &inner))
+         return false;
+      /* vkr_spec_lookup gives a specialized length's lower 32 bits: a 64-bit one with a
+       * SpecId is not known */
+      const bool specialized = c->spec_id < UINT32_MAX - 1;
+      if (specialized && c->wide)
+         return false;
+      const uint64_t length = specialized ? lo : ((uint64_t)c->high << 32 | lo);
+      if (__builtin_mul_overflow(length, inner, &n))
+         n = UINT64_MAX;
+   } else if (t->kind != VKR_SPIRV_TYPE_STRUCT) {
+      n = 1; /* a scalar, vector, matrix or runtime array */
+   } else {
+      for (uint32_t i = 0; i < t->b; i++) {
+         uint64_t m;
+         if (t->a + (uint64_t)i >= e->info->member_count ||
+             !type_elements(e, e->info->members[t->a + i], depth + 1, &m))
+            return false;
+         if (__builtin_add_overflow(n, m, &n))
+            n = UINT64_MAX;
+      }
+   }
+   e->state[at] = 2;
+   e->elems[at] = n;
+   *out = n;
+   return true;
+}
+
+bool
+vkr_spirv_function_elements(const struct vkr_spirv_info *info,
+                            bool (*lookup)(const void *data, uint32_t spec_id, uint32_t *value),
+                            const void *data,
+                            uint64_t *count)
+{
+   *count = 0;
+   if (!info->local_count)
+      return true;
+   struct elements e = { info, lookup, data, calloc(info->type_count + 1, 1),
+                         calloc(info->type_count + 1, sizeof(uint64_t)) };
+   bool ok = e.state && e.elems;
+   for (uint32_t i = 0; ok && i < info->local_count; i++) {
+      uint64_t n;
+      ok = type_elements(&e, info->locals[i], 0, &n);
+      if (ok && __builtin_add_overflow(*count, n, count))
+         *count = UINT64_MAX;
+   }
+   free(e.state);
+   free(e.elems);
+   return ok;
+}
+
+/* the locations a type takes as an interface variable, as SPIR-V's "Location Assignment"
+ * counts them: a scalar or vector one (a 64-bit vector of 3 or 4 two), a matrix one per
+ * column, an array its length times its element's, a struct its members' (at least one,
+ * so an array of empty structs is not free); memo as for elements */
+static bool
+type_locations(struct elements *e, uint32_t id, unsigned depth, uint64_t *out)
+{
+   const struct vec types = { .p = e->info->types, .n = e->info->type_count };
+   const struct vkr_spirv_type *t = find(&types, sizeof(*t), id);
+   if (!t) {
+      *out = 1; /* a pointer, or a type spirv-val refuses here */
+      return true;
+   }
+   const size_t at = (size_t)(t - e->info->types);
+   if (e->state[at] == 2) {
+      *out = e->elems[at];
+      return true;
+   }
+   if (e->state[at] == 1 || depth > 64)
+      return false;
+   e->state[at] = 1;
+   uint64_t n = 1, inner = 1;
+   switch (t->kind) {
+   case VKR_SPIRV_TYPE_VECTOR: {
+      const struct vkr_spirv_type *c = find(&types, sizeof(*c), t->a);
+      n = c && c->kind == VKR_SPIRV_TYPE_SCALAR && c->a == 64 && t->b > 2 ? 2 : 1;
+      break;
+   }
+   case VKR_SPIRV_TYPE_MATRIX:
+      if (!type_locations(e, t->a, depth + 1, &inner))
+         return false;
+      if (__builtin_mul_overflow(inner, (uint64_t)t->b, &n))
+         n = UINT64_MAX;
+      break;
+   case VKR_SPIRV_TYPE_ARRAY:
+   case VKR_SPIRV_TYPE_RUNTIME_ARRAY: {
+      if (!type_locations(e, t->a, depth + 1, &inner))
+         return false;
+      /* a length the scan cannot know (a spec constant operation) counts once, as
+       * spirv-val counts it; a 64-bit one with its high word */
+      uint32_t lo = 1;
+      uint64_t length = 1;
+      const struct vec v = { .p = e->info->constants, .n = e->info->constant_count };
+      const struct vkr_spirv_constant *c =
+         t->kind == VKR_SPIRV_TYPE_ARRAY ? find(&v, sizeof(*c), t->b) : NULL;
+      if (c && constant_value(e->info, t->b, e->lookup, e->data, &lo))
+         length = c->wide && c->spec_id == UINT32_MAX ? ((uint64_t)c->high << 32 | lo) : lo;
+      /* without the stage's specialization (a shader module) a length an app may still
+       * specialize also counts once */
+      if (c && c->spec_id < UINT32_MAX - 1 && !e->lookup)
+         length = 1;
+      if (__builtin_mul_overflow(length, inner, &n))
+         n = UINT64_MAX;
+      break;
+   }
+   case VKR_SPIRV_TYPE_STRUCT:
+      n = 0;
+      for (uint32_t i = 0; i < t->b; i++) {
+         uint64_t m;
+         if (t->a + (uint64_t)i >= e->info->member_count ||
+             !type_locations(e, e->info->members[t->a + i], depth + 1, &m))
+            return false;
+         if (__builtin_add_overflow(n, m, &n))
+            n = UINT64_MAX;
+      }
+      n = n ? n : 1;
+      break;
+   default:
+      break;
+   }
+   e->state[at] = 2;
+   e->elems[at] = n;
+   *out = n;
+   return true;
+}
+
+/* the most locations an Input or Output variable of an entry point of `model` may take */
+static uint32_t
+io_limit(const struct vkr_spirv_io_limits *l, uint32_t model, bool output, bool patch)
+{
+   switch (model) {
+   case 0:
+      return output ? l->vertex_out : l->vertex_in;
+   case MODEL_TESS_CONTROL:
+      return output ? (patch ? l->tess_control_patch_out : l->tess_control_out) : l->tess_control_in;
+   case MODEL_TESS_EVAL:
+      return output ? l->tess_eval_out : l->tess_eval_in;
+   case MODEL_GEOMETRY:
+      return output ? l->geometry_out : l->geometry_in;
+   case MODEL_FRAGMENT:
+      return output ? l->fragment_out : l->fragment_in;
+   default: {
+      /* mesh shading and models without such variables: the largest of them */
+      const uint32_t *v = &l->vertex_in;
+      uint32_t m = 0;
+      for (size_t i = 0; i < sizeof(*l) / sizeof(*v); i++)
+         m = v[i] > m ? v[i] : m;
+      return m;
+   }
+   }
+}
+
+bool
+vkr_spirv_interface_ok(const struct vkr_spirv_info *info,
+                       const struct vkr_spirv_io_limits *limits,
+                       bool (*lookup)(const void *data, uint32_t spec_id, uint32_t *value),
+                       const void *data,
+                       char *why,
+                       size_t why_size)
+{
+   if (!info->io_count)
+      return true;
+   struct elements e = { info, lookup, data, calloc(info->type_count + 1, 1),
+                         calloc(info->type_count + 1, sizeof(uint64_t)) };
+   bool ok = e.state && e.elems;
+   if (!ok)
+      snprintf(why, why_size, "SPIR-V: out of host memory");
+   const struct vec ios = { .p = info->ios, .n = info->io_count };
+   const struct vec types = { .p = info->types, .n = info->type_count };
+   for (uint32_t i = 0; ok && i < info->interface_count; i++) {
+      const struct vkr_spirv_io *v = find(&ios, sizeof(*v), info->interface[i].id);
+      if (!v || (v->flags & (VKR_SPIRV_IO_BUILT_IN | VKR_SPIRV_IO_BUILT_IN_TYPE)))
+         continue;
+      const uint32_t model = info->entries[info->interface[i].function].model;
+      const bool out = v->storage == STORAGE_OUTPUT, patch = v->flags & VKR_SPIRV_IO_PATCH;
+      /* per-vertex variables have an outer array that takes no locations (SPIR-V 2.16.2,
+       * Vulkan "Shader Input and Output Interfaces") */
+      const bool arrayed = (model == MODEL_TESS_CONTROL && !patch) ||
+                           (model == MODEL_TESS_EVAL && !out && !patch) ||
+                           (model == MODEL_GEOMETRY && !out) ||
+                           (model == MODEL_FRAGMENT && !out && (v->flags & VKR_SPIRV_IO_PER_VERTEX)) ||
+                           ((model == MODEL_MESH_NV || model == MODEL_MESH_EXT) && out &&
+                            !(v->flags & VKR_SPIRV_IO_PER_TASK));
+      uint32_t type = v->type;
+      const struct vkr_spirv_type *t = find(&types, sizeof(*t), type);
+      if (arrayed && t && (t->kind == VKR_SPIRV_TYPE_ARRAY || t->kind == VKR_SPIRV_TYPE_RUNTIME_ARRAY)) {
+         if (v->flags & VKR_SPIRV_IO_BUILT_IN_ELEMENT)
+            continue;
+         type = t->a;
+      }
+      uint64_t n;
+      const uint32_t limit = io_limit(limits, model, out, patch);
+      const uint64_t base = v->location == UINT32_MAX ? 0 : v->location;
+      if (!type_locations(&e, type, 0, &n)) {
+         snprintf(why, why_size, "SPIR-V: %s variable %u of types nested past 64 levels or in a loop",
+                  out ? "an Output" : "an Input", v->id);
+         ok = false;
+      } else if (n > limit || base + n > limit) {
+         snprintf(why, why_size,
+                  "SPIR-V: %s variable %u of model %u takes %" PRIu64 " locations from %" PRIu64
+                  " (at most %u; VUID-RuntimeSpirv-Location-06272)",
+                  out ? "an Output" : "an Input", v->id, model, n, base, limit);
+         ok = false;
+      }
+   }
+   free(e.state);
+   free(e.elems);
+   return ok;
+}
diff --git a/src/venus/vkr_spirv.h b/src/venus/vkr_spirv.h
new file mode 100644
index 0000000..1b79868
--- /dev/null
+++ b/src/venus/vkr_spirv.h
@@ -0,0 +1,209 @@
+/*
+ * Copyright 2026 OmacVM contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+/* OmacVM (virgl-venus-spirv-scan.patch, ADR 0065): a structural scan of a guest's SPIR-V
+ * before the Mac's shader compilers see it. Both compilers ended QEMU on malformed SPIR-V
+ * (KosmicKrisp's spirv_to_nir on a bad magic, in its own error path, and on a huge id bound;
+ * MoltenVK's SPIRV-Cross with an uncaught exception on a missing entry point), on a
+ * workgroup size past Metal's (MoltenVK) and on a shader using a descriptor set the layout
+ * lacks (KosmicKrisp). This is not a validator: it checks what those crashes need (the
+ * header, every instruction inside the code, the ids it reads inside the bound, entry
+ * points, workgroup sizes, descriptor sets) and keeps a summary for pipeline creation,
+ * with the types of Function variables, whose elements a pipeline counts (SPIRV-Tools'
+ * validator comes after it: virgl-venus-spirv-validate.patch).
+ * Self-contained (no Vulkan driver), so it is fuzzed on the CPU alone
+ * (Tests/virgl/fuzz-venus-spirv.sh). */
+
+#ifndef VKR_SPIRV_H
+#define VKR_SPIRV_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+/* the largest id bound: KosmicKrisp allocates per id (a bound of 0x3fffffff ended QEMU) */
+#define VKR_SPIRV_MAX_BOUND (1u << 20)
+
+/* the most elements in a module's Function variables after specialization (arrays of
+ * arrays multiplied, struct members added): KosmicKrisp splits an unused Function array
+ * into one variable per element at about 360 bytes each; 2^20 peaked at 480 MB in 0.5 s,
+ * 2^24 passed 2 GB in 2.4 s, and uint[2^32-1] (legal SPIR-V) took 9 GB */
+#define VKR_SPIRV_MAX_FUNCTION_ELEMENTS (1u << 20)
+
+/* the most a module's types may cost spirv-val (info->type_cost, the sum vkr_spirv.c's
+ * instruction() counts: each instruction the weights of the types it names and reads;
+ * vkr_spirv_validate refuses more unread). spirv-val's walks over types are not memoized:
+ * a struct of two of the previous one, 30 deep, kept it busy past 20 s, and each
+ * instruction walks its types again; virgl-venus-spirv-validate.patch has the measured
+ * worst case under this cost. */
+#define VKR_SPIRV_MAX_TYPE_COST (1u << 24)
+
+struct vkr_spirv_entry {
+   uint32_t model;    /* SpvExecutionModel */
+   uint32_t function; /* id */
+   uint32_t name;     /* offset into the summary's name buffer */
+   uint32_t local_size[3];
+   uint32_t local_size_id[3];
+   uint8_t local_size_kind; /* 0 none, 1 LocalSize, 2 LocalSizeId */
+};
+
+/* a constant whose value a workgroup size may name; spec_id UINT32_MAX for a plain one */
+struct vkr_spirv_constant {
+   uint32_t id;
+   uint32_t spec_id;
+   uint32_t value;
+   uint32_t high; /* the upper word of a 64-bit one */
+   bool wide;     /* 64 bits */
+};
+
+/* a type variables' elements and locations are counted through (anything else is one
+ * element and one location) */
+enum {
+   VKR_SPIRV_TYPE_ARRAY = 1,         /* a: element, b: length id */
+   VKR_SPIRV_TYPE_STRUCT = 2,        /* members[a, a + b) */
+   VKR_SPIRV_TYPE_SCALAR = 3,        /* an int or float, a: width */
+   VKR_SPIRV_TYPE_VECTOR = 4,        /* a: component, b: count */
+   VKR_SPIRV_TYPE_MATRIX = 5,        /* a: column, b: count */
+   VKR_SPIRV_TYPE_RUNTIME_ARRAY = 6, /* a: element */
+};
+
+struct vkr_spirv_type {
+   uint32_t id;
+   uint32_t kind;
+   uint32_t a, b;
+};
+
+/* an Input or Output variable */
+enum {
+   VKR_SPIRV_IO_BUILT_IN = 1 << 0,         /* the variable */
+   VKR_SPIRV_IO_BUILT_IN_TYPE = 1 << 1,    /* its type is a built-in block */
+   VKR_SPIRV_IO_BUILT_IN_ELEMENT = 1 << 2, /* an array of built-in blocks */
+   VKR_SPIRV_IO_PATCH = 1 << 3,
+   VKR_SPIRV_IO_PER_VERTEX = 1 << 4, /* PerVertexKHR */
+   VKR_SPIRV_IO_PER_TASK = 1 << 5,   /* PerTaskNV */
+};
+
+struct vkr_spirv_io {
+   uint32_t id;
+   uint32_t storage;  /* Input or Output */
+   uint32_t type;     /* the data type */
+   uint32_t location; /* UINT32_MAX: none */
+   uint32_t flags;
+};
+
+/* how many locations an Input or Output variable may take, per execution model (the
+ * device's limits: components / 4, maxVertexInputAttributes, maxFragmentOutputAttachments) */
+struct vkr_spirv_io_limits {
+   uint32_t vertex_in, vertex_out;
+   uint32_t tess_control_in, tess_control_out, tess_control_patch_out;
+   uint32_t tess_eval_in, tess_eval_out;
+   uint32_t geometry_in, geometry_out;
+   uint32_t fragment_in, fragment_out;
+};
+
+/* a descriptor variable: an id with a DescriptorSet decoration */
+struct vkr_spirv_var {
+   uint32_t id;
+   uint32_t set;
+   uint32_t binding;
+};
+
+/* (function, id): a call from one function to another, or an id a function's pointer
+ * instruction names; (entry index, id) for an entry point's interface */
+struct vkr_spirv_pair {
+   uint32_t function;
+   uint32_t id;
+};
+
+struct vkr_spirv_info {
+   uint32_t entry_count;
+   struct vkr_spirv_entry *entries;
+   char *names;
+   uint32_t constant_count;
+   struct vkr_spirv_constant *constants; /* sorted by id */
+   /* the WorkgroupSize built-in: its composite's three components, or 0 */
+   uint32_t workgroup_size[3];
+   /* sorted: an entry point's descriptor variables are the ones the functions it reaches
+    * through calls name */
+   uint32_t var_count;
+   struct vkr_spirv_var *vars;
+   uint32_t function_count;
+   uint32_t *functions;
+   uint32_t call_count;
+   struct vkr_spirv_pair *calls;
+   uint32_t use_count;
+   struct vkr_spirv_pair *uses;
+   /* arrays and structs (sorted by id), the structs' member types, and the type of each
+    * Function variable */
+   uint32_t type_count;
+   struct vkr_spirv_type *types;
+   uint32_t member_count;
+   uint32_t *members;
+   uint32_t local_count;
+   uint32_t *locals;
+   /* Input and Output variables (sorted by id) and the entry points' interfaces */
+   uint32_t io_count;
+   struct vkr_spirv_io *ios;
+   uint32_t interface_count;
+   struct vkr_spirv_pair *interface;
+   /* what the types cost (VKR_SPIRV_MAX_TYPE_COST) */
+   uint64_t type_cost;
+};
+
+/* the scan of `bytes` bytes of SPIR-V; NULL with a reason in why (malformed or too big) */
+struct vkr_spirv_info *
+vkr_spirv_scan(const uint32_t *code, size_t bytes, char *why, size_t why_size);
+
+void
+vkr_spirv_free(struct vkr_spirv_info *info);
+
+/* the entry point named `name` of execution model `model`, or NULL */
+const struct vkr_spirv_entry *
+vkr_spirv_entry(const struct vkr_spirv_info *info, const char *name, uint32_t model);
+
+/* a stage's workgroup size after specialization (lookup: SpecId -> value, false when the
+ * pipeline does not specialize it); false when an id it names is not a known constant */
+bool
+vkr_spirv_workgroup_size(const struct vkr_spirv_info *info,
+                         const struct vkr_spirv_entry *entry,
+                         bool (*lookup)(const void *data, uint32_t spec_id, uint32_t *value),
+                         const void *data,
+                         uint32_t size[3]);
+
+/* each descriptor variable the entry point's functions use, to `ok` (in O(module size));
+ * false at the first one `ok` refuses (its set and binding in *set and *binding) or out of
+ * host memory (both UINT32_MAX) */
+bool
+vkr_spirv_bindings_ok(const struct vkr_spirv_info *info,
+                      const struct vkr_spirv_entry *entry,
+                      bool (*ok)(const void *data, uint32_t set, uint32_t binding),
+                      const void *data,
+                      uint32_t *set,
+                      uint32_t *binding);
+
+/* the elements of all Function variables after specialization (lookup as for the
+ * workgroup size), at most UINT64_MAX; false when an array length is no known constant
+ * (a spec constant operation) or the types nest past 64 levels or in a loop */
+bool
+vkr_spirv_function_elements(const struct vkr_spirv_info *info,
+                            bool (*lookup)(const void *data, uint32_t spec_id, uint32_t *value),
+                            const void *data,
+                            uint64_t *count);
+
+/* every Input and Output variable of an entry point's interface, but built-ins, takes at
+ * most the locations `limits` gives its model and storage class (after the outer array of
+ * per-vertex ones; VUID-RuntimeSpirv-Location-06272), from its Location on; lookup as for
+ * the workgroup size, NULL for a module (a length from a SpecId counts once, as spirv-val
+ * counts it, whose walk over locations grows with them: an Input of a struct of uint[2^32-1]
+ * took it past 512 MB). False with why set. */
+bool
+vkr_spirv_interface_ok(const struct vkr_spirv_info *info,
+                       const struct vkr_spirv_io_limits *limits,
+                       bool (*lookup)(const void *data, uint32_t spec_id, uint32_t *value),
+                       const void *data,
+                       char *why,
+                       size_t why_size);
+
+#endif /* VKR_SPIRV_H */
