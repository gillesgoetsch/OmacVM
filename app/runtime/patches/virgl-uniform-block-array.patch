+
+/* The binding vrend never puts a buffer at. Before vrend binds a program's uniform
+ * blocks by name, every active block points there; a block still there afterwards is one
+ * vrend did not know by name. The GPU would read it from whatever buffer the binding
+ * holds, unchecked, so the program's draws are skipped (vrend_ubos_inside). */
+static GLuint vrend_unbound_ubo_binding(void)
+{
+   return vrend_state.max_ubo_bindings - 1;
+}
+
+/* The GL programs of a linked program: one, or one per stage of a pipeline. */
+static unsigned vrend_program_gl_ids(const struct vrend_linked_shader_program *sprog,
+                                     enum pipe_shader_type last_shader,
+                                     GLuint ids[PIPE_SHADER_TYPES])
+{
+   unsigned n = 0;
+
+   if (!sprog->is_pipeline) {
+      ids[n++] = sprog->id.program;
+      return n;
+   }
+   for (enum pipe_shader_type t = PIPE_SHADER_VERTEX; t <= last_shader; t++)
+      if (sprog->ss[t])
+         ids[n++] = sprog->ss[t]->program_id;
+   return n;
+}
+
+static void vrend_park_blocks(const GLuint *ids, unsigned n)
+{
+   if (!has_feature(feat_ubo))
+      return;
+   for (unsigned p = 0; p < n; p++) {
+      GLint blocks = 0;
+      glGetProgramiv(ids[p], GL_ACTIVE_UNIFORM_BLOCKS, &blocks);
+      for (GLint i = 0; i < blocks; i++)
+         glUniformBlockBinding(ids[p], i, vrend_unbound_ubo_binding());
+   }
+}
+
+/* next_ubo_id: one past the last binding vrend fills for the program (or its VirglBlock) */
+static bool vrend_blocks_all_bound(const GLuint *ids, unsigned n, GLuint next_ubo_id)
+{
+   if (!has_feature(feat_ubo))
+      return true;
+   if (next_ubo_id > vrend_unbound_ubo_binding())
+      return false;
+   for (unsigned p = 0; p < n; p++) {
+      GLint blocks = 0;
+      glGetProgramiv(ids[p], GL_ACTIVE_UNIFORM_BLOCKS, &blocks);
+      for (GLint i = 0; i < blocks; i++) {
+         GLint binding = -1;
+         glGetActiveUniformBlockiv(ids[p], i, GL_UNIFORM_BLOCK_BINDING, &binding);
+         if ((GLuint)binding == vrend_unbound_ubo_binding())
+            return false;
       }
    }
+   return true;
 }
 
