+/* OmacVM: sampler view i is declared 2D_ARRAY and bound to a plain 2D texture (the key);
+ * not for samplers indexed indirectly (their arrays keep one type) */
+static bool sampler_2d_for_array(const struct dump_ctx *ctx, int i)
+{
+   return i >= 0 && i < 32 && (ctx->key->sampler_views_2d_for_array_mask & (1u << i)) &&
+          !(ctx->info.indirect_files & (1 << TGSI_FILE_SAMPLER));
+}
