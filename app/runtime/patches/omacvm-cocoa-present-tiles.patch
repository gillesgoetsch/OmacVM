 static void cocoa_gl_present_request(void);
 
 /*
@@ -7964,6 +7968,303 @@ static bool cocoa_gl_present_on(void)
     return present_ctx != NULL;
 }
 
+/*
+ * OmacVM, tiled present (OMACVM_GL_PRESENT_TILES=1, env only: the app gets
+ * a switch with the guest side, #520; =check for tests). QEMU's present
+ * shows each guest frame as a new whole surface, so WindowServer composites the whole window for every
+ * frame, also when only a caret blinked: at 120 frames a second that is
+ * most of what showing the window costs. With tiles, the view's layer
+ * keeps the last whole frame and a grid of tile layers lies over it
+ * (ui/omacvm-present-tiles.h): a frame whose changed box (the guest's flush
+ * rects since the last frame) covers at most OMACVM_PT_FRAME_MAX tiles is
+ * drawn into those tiles' own small surfaces only, and WindowServer
+ * composites only them. A frame with nothing changed is not presented. Any
+ * other frame is a whole one, as before, and hides the tiles. Only with the
+ * vsync present, the guest's GL scanout at the surfaces' size, and the
+ * window showing it pixel for pixel (else the tiles hide and the next
+ * frame is whole). The guest must say what changed: Linux before 7.4 flushes
+ * the whole plane on every page flip (frame-path, #520), and then every
+ * frame is a whole one, as without the switch.
+ *
+ * Threads: the tile surfaces are drawn on QEMU's thread (BQL); the tile
+ * layers are changed by whoever shows a frame, under present_tile_lock.
+ */
+static int present_tiles_on = -1;       /* -1 not read, 0 off, 1 on, 2 check */
+static unsigned present_alloc_gen;      /* surfaces made again: a new grid */
+static unsigned present_tile_gen;       /* the grid's generation */
+static unsigned present_base_gen;       /* a whole frame of this generation was drawn */
+static OmacvmPTGrid present_tg;
+#define PRESENT_TILE_BUFS 5      /* as the whole surfaces: one shown, three queued, one drawn */
+static IOSurfaceRef present_tsurf[OMACVM_PT_MAX][PRESENT_TILE_BUFS];
+static GLuint present_ttex[OMACVM_PT_MAX][PRESENT_TILE_BUFS];
+/*
+ * Tiles keep their surfaces while they are used: at most PRESENT_TILE_KEEP
+ * tiles (the least recently drawn give theirs back first), and none once
+ * frames have been whole for PRESENT_TILE_IDLE_NS. A surface Core Animation
+ * still shows or that waits in the queue keeps its own reference.
+ */
+#define PRESENT_TILE_KEEP 32
+#define PRESENT_TILE_IDLE_NS (10 * NANOSECONDS_PER_SECOND)
+static uint64_t present_tile_used[OMACVM_PT_MAX];   /* tile frame it was last drawn in */
+static int64_t present_tile_last_ns;                 /* the last frame in tiles */
+static OmacvmPDRect present_td;         /* changed since the last frame drawn */
+static bool present_tiles_full;         /* the tiles were hidden: next frame whole */
+/*
+ * The frame size (w << 32 | h) the window shows pixel for pixel now, 0 for
+ * none. Measured where a whole frame is shown, and cleared when the tiles
+ * do not fit or the view changes size. Frames go in tiles only at this
+ * size: a window that scales the picture stays on whole frames.
+ */
+static uint64_t present_tiles_fit;
+static QEMUTimer *present_tile_idle_timer;
+static uint64_t present_tile_checks, present_tile_checks_bad;
+static uint64_t present_tile_frames, present_tile_skips, present_tile_whole;
+static os_unfair_lock present_tile_lock = OS_UNFAIR_LOCK_INIT;
+static CALayer *present_tile_layer[OMACVM_PT_MAX];  /* present_tile_lock */
+static int present_tiles_shown;         /* present_tile_lock: tiles not hidden */
+/*
+ * The tile program (ui/omacvm-present-tiles.h: QEMU's blit, the tile's part
+ * of the frame by texture coordinates) and its own quad: vertex arrays are
+ * not shared between contexts. Made on present_ctx where the switch is read.
+ */
+static GLuint present_tile_prog, present_tile_vao, present_tile_vbo;
+static GLint present_tile_u_rect, present_tile_u_flip;
+
+/* QEMU thread, present_ctx current: one shader of the tile program, 0 (and why) if it does not compile. */
+static GLuint present_tile_shader(GLenum type, const char *src, char *why, size_t n)
+{
+    GLuint s = glCreateShader(type);
+    GLint ok = 0;
+
+    glShaderSource(s, 1, &src, NULL);
+    glCompileShader(s);
+    glGetShaderiv(s, GL_COMPILE_STATUS, &ok);
+    if (!ok) {
+        glGetShaderInfoLog(s, (GLsizei)n, NULL, why);
+        glDeleteShader(s);
+        return 0;
+    }
+    return s;
+}
+
+/* QEMU thread, present_ctx current: the tile program and its quad. False (and why) if it does not build. */
+static bool present_tile_program(char *why, size_t n)
+{
+    static const GLfloat quad[] = { -1, -1, 1, -1, -1, 1, 1, 1 };
+    GLuint vs = present_tile_shader(GL_VERTEX_SHADER, OMACVM_PT_VERT, why, n);
+    GLuint fs = vs ? present_tile_shader(GL_FRAGMENT_SHADER, OMACVM_PT_FRAG, why, n) : 0;
+    GLint ok = 0;
+
+    if (vs && fs) {
+        present_tile_prog = glCreateProgram();
+        glAttachShader(present_tile_prog, vs);
+        glAttachShader(present_tile_prog, fs);
+        glBindAttribLocation(present_tile_prog, 0, "in_position");
+        glLinkProgram(present_tile_prog);
+        glGetProgramiv(present_tile_prog, GL_LINK_STATUS, &ok);
+        if (!ok) {
+            glGetProgramInfoLog(present_tile_prog, (GLsizei)n, NULL, why);
+            glDeleteProgram(present_tile_prog);
+            present_tile_prog = 0;
+        }
+    }
+    if (vs) {
+        glDeleteShader(vs);
+    }
+    if (fs) {
+        glDeleteShader(fs);
+    }
+    if (!ok) {
+        /* one line in qemu.log: the driver's log without its line breaks */
+        for (char *c = why; *c; c++) {
+            *c = *c == '\n' || *c == '\r' ? ' ' : *c;
+        }
+        if (!why[0]) {
+            snprintf(why, n, "no log");
+        }
+        return false;
+    }
+    glUseProgram(present_tile_prog);
+    glUniform1i(glGetUniformLocation(present_tile_prog, "image"), 0);
+    present_tile_u_rect = glGetUniformLocation(present_tile_prog, "rect");
+    present_tile_u_flip = glGetUniformLocation(present_tile_prog, "yflip");
+    glUseProgram(0);
+    glGenVertexArrays(1, &present_tile_vao);
+    glBindVertexArray(present_tile_vao);
+    glGenBuffers(1, &present_tile_vbo);
+    glBindBuffer(GL_ARRAY_BUFFER, present_tile_vbo);
+    glBufferData(GL_ARRAY_BUFFER, sizeof(quad), quad, GL_STATIC_DRAW);
+    glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, 0, 0);
+    glEnableVertexAttribArray(0);
+    glBindBuffer(GL_ARRAY_BUFFER, 0);
+    glBindVertexArray(0);
+    return true;
+}
+
+/*
+ * QEMU thread, present_ctx current (cocoa_gl_present). The switch is
+ * decided here once and never changes after (the present queues read
+ * present_tiles_on without a lock): the tile program is made first, and
+ * if it does not build, tiles stay off and frames are whole as before.
+ */
+static bool present_tiles_wanted(void)
+{
+    if (present_tiles_on < 0) {
+        const char *e = getenv("OMACVM_GL_PRESENT_TILES");
+        int on = e && !strcmp(e, "1") ? 1 : e && !strcmp(e, "check") ? 2 : 0;
+        char why[512] = "";
+        if (on && !present_vsync) {
+            present_tiles_on = 0;
+            info_report("cocoa: tiled present: off (needs the vsync present)");
+        } else if (on && !present_tile_program(why, sizeof(why))) {
+            present_tiles_on = 0;
+            info_report("cocoa: tiled present: off (the tile shader does not build: %s)", why);
+        } else {
+            present_tiles_on = on;
+            info_report("cocoa: tiled present: %s", on == 2 ?
+                        "on, checked against whole frames (OMACVM_GL_PRESENT_TILES=check)" :
+                        on ? "on (OMACVM_GL_PRESENT_TILES=1)" : "off");
+        }
+    }
+    return present_tiles_on > 0;
+}
+
+/* QEMU thread: once a minute in qemu.log, how the frames went (tiles on only). */
+static void present_tiles_stats(void)
+{
+    static int64_t since;
+    static uint64_t frames0, skips0, whole0;
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_REALTIME);
+
+    if (present_tiles_on <= 0) {
+        return;
+    }
+    if (!since) {
+        since = now;
+    } else if (now - since >= 60 * NANOSECONDS_PER_SECOND) {
+        info_report("cocoa: tiled present, last minute: %" PRIu64 " frames in tiles, %" PRIu64
+                    " whole, %" PRIu64 " not presented (nothing changed)",
+                    present_tile_frames - frames0, present_tile_whole - whole0,
+                    present_tile_skips - skips0);
+        if (present_tiles_on == 2) {
+            info_report("cocoa: tiles check, so far: %" PRIu64 " of %" PRIu64 " checks differed",
+                        present_tile_checks_bad, present_tile_checks);
+        }
+        frames0 = present_tile_frames;
+        skips0 = present_tile_skips;
+        whole0 = present_tile_whole;
+        since = now;
+    }
+}
+
+/* QEMU thread, present_ctx current: tile T's surfaces go. */
+static void cocoa_gl_present_tile_free(unsigned t)
+{
+    for (unsigned b = 0; b < PRESENT_TILE_BUFS; b++) {
+        if (present_ttex[t][b]) {
+            glDeleteTextures(1, &present_ttex[t][b]);
+            present_ttex[t][b] = 0;
+        }
+        if (present_tsurf[t][b]) {
+            CFRelease(present_tsurf[t][b]);
+            present_tsurf[t][b] = NULL;
+        }
+    }
+}
+
+/* QEMU thread, present_ctx current: the tile surfaces go (another size or format). */
+static void cocoa_gl_present_tiles_free(void)
+{
+    for (unsigned t = 0; t < OMACVM_PT_MAX; t++) {
+        for (unsigned b = 0; b < PRESENT_TILE_BUFS; b++) {
+            if (present_ttex[t][b]) {
+                glDeleteTextures(1, &present_ttex[t][b]);
+                present_ttex[t][b] = 0;
+            }
+            if (present_tsurf[t][b]) {
+                /* Core Animation keeps its own reference while it shows one. */
+                CFRelease(present_tsurf[t][b]);
+                present_tsurf[t][b] = NULL;
+            }
+        }
+    }
+}
+
+/*
+ * QEMU thread, present_ctx current: a surface of tile T Core Animation is
+ * not showing or waiting to show, made when first needed in the format and
+ * colour space of the whole-frame surfaces. -1 when there is none.
+ */
+static int cocoa_gl_present_tile_buf(unsigned t)
+{
+    for (unsigned b = 0; b < PRESENT_TILE_BUFS; b++) {
+        if (present_tsurf[t][b] && !IOSurfaceIsInUse(present_tsurf[t][b])) {
+            return b;
+        }
+    }
+    if (!present_tsurf[t][0]) {
+        /* a tile without surfaces yet: the least recently drawn one gives its back past the cap */
+        unsigned held = 0, lru = OMACVM_PT_MAX;
+        for (unsigned u = 0; u < OMACVM_PT_MAX; u++) {
+            if (present_tsurf[u][0]) {
+                held++;
+                if (lru == OMACVM_PT_MAX || present_tile_used[u] < present_tile_used[lru]) {
+                    lru = u;
+                }
+            }
+        }
+        if (held >= PRESENT_TILE_KEEP && lru < OMACVM_PT_MAX) {
+            cocoa_gl_present_tile_free(lru);
+        }
+    }
+    for (unsigned b = 0; b < PRESENT_TILE_BUFS; b++) {
+        if (present_tsurf[t][b]) {
+            continue;
+        }
+        uint32_t x, y, w, h;
+        omacvm_pt_rect(&present_tg, t, &x, &y, &w, &h);
+        OSType f = IOSurfaceGetPixelFormat(present_surf[0]);
+        /* Lossless-compressed whole frames: their plain kind for the tiles. */
+        f = f == '&BGA' ? 'BGRA' : f == '&RhA' ? 'RGhA' : f;
+        bool half = f == 'RGhA', ten = f == 'l10r';
+        NSDictionary *props = @{
+            (id)kIOSurfaceWidth: @(w),
+            (id)kIOSurfaceHeight: @(h),
+            (id)kIOSurfaceBytesPerElement: half ? @8 : @4,
+            (id)kIOSurfacePixelFormat: @(f),
+        };
+        IOSurfaceRef s = IOSurfaceCreate((CFDictionaryRef)props);
+        if (!s) {
+            return -1;
+        }
+        CFTypeRef cs = IOSurfaceCopyValue(present_surf[0], kIOSurfaceColorSpace);
+        if (cs) {
+            IOSurfaceSetValue(s, kIOSurfaceColorSpace, cs);
+            CFRelease(cs);
+        }
+        GLuint tex;
+        glGenTextures(1, &tex);
+        glBindTexture(GL_TEXTURE_RECTANGLE, tex);
+        bool ok = CGLTexImageIOSurface2D(present_ctx, GL_TEXTURE_RECTANGLE,
+                                         half ? GL_RGBA16F : ten ? GL_RGB10_A2 : GL_RGBA,
+                                         w, h, half ? GL_RGBA : GL_BGRA,
+                                         half ? GL_HALF_FLOAT :
+                                         ten ? GL_UNSIGNED_INT_2_10_10_10_REV :
+                                               GL_UNSIGNED_INT_8_8_8_8_REV,
+                                         s, 0) == kCGLNoError;
+        glBindTexture(GL_TEXTURE_RECTANGLE, 0);
+        if (!ok) {
+            glDeleteTextures(1, &tex);
+            CFRelease(s);
+            return -1;
+        }
+        present_tsurf[t][b] = s;
+        present_ttex[t][b] = tex;
+        return b;
+    }
+    return -1;
+}
+
 static void cocoa_gl_present_free(void)
 {
     for (int i = 0; i < present_nsurf; i++) {
@@ -8230,6 +8531,7 @@ static bool cocoa_gl_present_alloc(uint32_t w, uint32_t h, bool deep, bool linea
     present_packed_half = half;
     present_w = w;
     present_h = h;
+    present_alloc_gen++;
     present_deep = deep;
     present_linear = linear;
     present_next = 0;
@@ -8237,6 +8539,230 @@ static bool cocoa_gl_present_alloc(uint32_t w, uint32_t h, bool deep, bool linea
     return true;
 }
 
+/* QEMU thread, BQL: no frame in tiles for a while: the tiles give their surfaces back. */
+static void cocoa_gl_present_tile_idle(void *opaque)
+{
+    if (!present_tile_last_ns ||
+        qemu_clock_get_ns(QEMU_CLOCK_REALTIME) - present_tile_last_ns < PRESENT_TILE_IDLE_NS) {
+        return;
+    }
+    CGLContextObj prev = CGLGetCurrentContext();
+    CGLSetCurrentContext(present_ctx);
+    cocoa_gl_present_tiles_free();
+    CGLSetCurrentContext(prev);
+    present_tile_last_ns = 0;
+}
+
+/*
+ * OMACVM_GL_PRESENT_TILES=check (tests): the frame's tiles against the
+ * same frame drawn whole, pixel for pixel at the tiles' own precision,
+ * every 30th tile frame. QEMU thread, present_ctx current.
+ */
+static void cocoa_gl_present_tiles_check(GLuint src, bool flip, const unsigned *tl,
+                                         const int *bi, int nt)
+{
+    static GLuint ref_tex, ref_fbo;
+    static uint32_t ref_w, ref_h;
+    static GLenum ref_fmt;
+    OSType f = IOSurfaceGetPixelFormat(present_tsurf[tl[0]][bi[0]]);
+    GLenum fmt = f == 'RGhA' ? GL_RGBA16F : f == 'l10r' ? GL_RGB10_A2 : GL_RGBA8;
+    uint32_t w = present_w, h = present_h;
+
+    if (!ref_fbo) {
+        glGenFramebuffers(1, &ref_fbo);
+    }
+    if (ref_w != w || ref_h != h || ref_fmt != fmt) {
+        if (ref_tex) {
+            glDeleteTextures(1, &ref_tex);
+        }
+        glGenTextures(1, &ref_tex);
+        glBindTexture(GL_TEXTURE_RECTANGLE, ref_tex);
+        glTexImage2D(GL_TEXTURE_RECTANGLE, 0, fmt, w, h, 0, GL_RGBA,
+                     fmt == GL_RGBA16F ? GL_HALF_FLOAT :
+                     fmt == GL_RGB10_A2 ? GL_UNSIGNED_INT_2_10_10_10_REV : GL_UNSIGNED_BYTE,
+                     NULL);
+        glBindTexture(GL_TEXTURE_RECTANGLE, 0);
+        ref_w = w;
+        ref_h = h;
+        ref_fmt = fmt;
+    }
+    glBindFramebuffer(GL_FRAMEBUFFER, ref_fbo);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                           GL_TEXTURE_RECTANGLE, ref_tex, 0);
+    glViewport(0, 0, w, h);
+    glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+    glClearColor(0, 0, 0, 1);
+    glClear(GL_COLOR_BUFFER_BIT);
+    glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_FALSE);
+    glBindTexture(GL_TEXTURE_2D, src);
+    qemu_gl_run_texture_blit(present_gls, flip);
+    glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+    glPixelStorei(GL_PACK_ALIGNMENT, 4);
+    /* read back at the tiles' own precision: half float 8 bytes, 10-bit and 8-bit 4 */
+    GLenum rf = fmt == GL_RGBA16F ? GL_RGBA : GL_BGRA;
+    GLenum rt = fmt == GL_RGBA16F ? GL_HALF_FLOAT :
+                fmt == GL_RGB10_A2 ? GL_UNSIGNED_INT_2_10_10_10_REV : GL_UNSIGNED_INT_8_8_8_8_REV;
+    size_t px = fmt == GL_RGBA16F ? 8 : 4;
+    uint64_t bad = 0;
+    uint8_t *a = g_malloc((size_t)OMACVM_PT_SIZE * OMACVM_PT_SIZE * px);
+    uint8_t *b = g_malloc((size_t)OMACVM_PT_SIZE * OMACVM_PT_SIZE * px);
+    for (int k = 0; k < nt; k++) {
+        uint32_t x, y, tw, th;
+        omacvm_pt_rect(&present_tg, tl[k], &x, &y, &tw, &th);
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                               GL_TEXTURE_RECTANGLE, ref_tex, 0);
+        glReadPixels(x, y, tw, th, rf, rt, b);
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                               GL_TEXTURE_RECTANGLE, present_ttex[tl[k]][bi[k]], 0);
+        glReadPixels(0, 0, tw, th, rf, rt, a);
+        for (size_t i = 0; i < (size_t)tw * th; i++) {
+            /* colour only: the window ignores alpha */
+            if (px == 8) {
+                bad += memcmp(a + i * 8, b + i * 8, 6) != 0;
+            } else if (fmt == GL_RGB10_A2) {
+                uint32_t va, vb;
+                memcpy(&va, a + i * 4, 4);
+                memcpy(&vb, b + i * 4, 4);
+                bad += (va & 0x3fffffff) != (vb & 0x3fffffff);
+            } else {
+                bad += memcmp(a + i * 4, b + i * 4, 3) != 0;
+            }
+        }
+    }
+    g_free(a);
+    g_free(b);
