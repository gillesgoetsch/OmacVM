+/* OmacVM (virgl-venus-encoder-cap.patch) */
+uint32_t
+vkr_encoder_cap(void)
+{
+   static atomic_uint cap;
+   uint32_t c = atomic_load(&cap);
+   if (unlikely(!c)) {
+      const char *env = getenv("OMACVM_VENUS_ENCODER_CAP");
+      const unsigned long v = env ? strtoul(env, NULL, 0) : 0;
+      c = v >= 1 && v <= (1u << 20) ? (uint32_t)v : VKR_ENCODER_CAP;
+      atomic_store(&cap, c);
+   }
+   return c;
+}
+
+uint32_t
+vkr_command_buffer_weight(VkCommandBuffer handle)
+{
+   const struct vkr_command_buffer *cmd = vkr_command_buffer_from_handle(handle);
+   return cmd ? cmd->state.weight : 0;
+}
