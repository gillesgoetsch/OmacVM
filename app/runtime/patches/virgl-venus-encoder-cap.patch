+/* OmacVM (virgl-venus-encoder-cap.patch) */
+uint32_t
+vkr_encoder_cap(void)
+{
+   static atomic_uint cap;
+   uint32_t c = atomic_load(&cap);
+   if (unlikely(!c)) {
+      const char *env = getenv("OMACVM_VENUS_ENCODER_CAP");
+      const unsigned long v = env ? strtoul(env, NULL, 0) : 0;
+      c = v >= 1 && v <= (1u << 20) ? (uint32_t)v : VKR_ENCODER_CAP;
+      atomic_store(&cap, c);
+   }
+   return c;
+}
+
+uint32_t
+vkr_command_buffer_weight(VkCommandBuffer handle)
+{
+   const struct vkr_command_buffer *cmd = vkr_command_buffer_from_handle(handle);
+   return cmd ? cmd->state.weight : 0;
+}
+
+/* the command opens W more Metal passes in its command buffer: refused (the context ends)
+ * past the cap, before the driver gets it */
+static bool
+vkr_cmd_weigh(struct vn_dispatch_context *dispatch, VkCommandBuffer handle, uint64_t w,
+              const char *call)
+{
+   struct vkr_cmd_state *st = vkr_cmd_state(handle);
+   const uint64_t total = st->weight + w, cap = vkr_encoder_cap();
+   if (!vkr_context_check(dispatch->data, total <= cap, call,
+                          "%" PRIu64 " Metal passes in one command buffer, past vkr's %" PRIu64
+                          " (Metal ends the process at about 75000-98000)",
+                          total, cap))
+      return false;
+   st->weight = (uint32_t)total;
+   return true;
+}
+
+/* the levels of a clear's ranges (each level is a pass; the layers of one are one layered
+ * pass on both drivers: 2048 layers x 200 clears in the probes; so are a 3D image's depth
+ * slices: KosmicKrisp recorded 16384 clears of a 64 x 64 x 2048 image, 6072 B each) */
+static uint64_t
+vkr_cmd_range_levels(VkImage handle, uint32_t count, const VkImageSubresourceRange *ranges)
+{
+   const struct vkr_image *img = vkr_image_from_handle(handle);
+   uint64_t n = 0;
+   for (uint32_t i = 0; i < count; i++) {
+      const VkImageSubresourceRange *r = &ranges[i];
+      /* past vkr_cmd_range_ok: the base is inside the image */
+      n += r->levelCount == VK_REMAINING_MIP_LEVELS
+              ? (img && img->mip_levels > r->baseMipLevel ? img->mip_levels - r->baseMipLevel : 1)
+              : r->levelCount;
+   }
+   return n;
+}
+
+/* a barrier inside a pass: KosmicKrisp splits a multisampled pass there (a new Metal pass,
+ * 98304 such barriers ended the process); vkr does not keep the pass's samples, so every
+ * in-pass barrier counts on KosmicKrisp (1x passes did not split: 204800 in the probe) */
+static bool
+vkr_cmd_barrier_weigh(struct vn_dispatch_context *dispatch, VkCommandBuffer handle,
+                      bool kosmickrisp, const char *call)
+{
+   const struct vkr_cmd_state *st = vkr_cmd_state(handle);
+   if (!kosmickrisp || st->pass == VKR_CMD_PASS_NONE)
+      return true;
+   return vkr_cmd_weigh(dispatch, handle, 1, call);
+}
+
+/* a draw call that splits its Metal pass (the M1 probes, work/v624-hostmem/fix: draws in
+ * one pass, bytes of footprint per draw while recording, a plain draw 121-139):
+ * - on both drivers each tessellated draw (they run the tessellation stages as compute
+ *   between two passes; KosmicKrisp 112815 B per draw, MoltenVK with prefill ended the
+ *   process at the end of 114688 such draws): one per draw of the call;
+ * - on KosmicKrisp a draw call it unrolls in a compute pass first (kk_cmd_draw.c,
+ *   requires_unroll) or whose predicates it applies there (conditional rendering): one.
+ *   Unrolled: triangle fans, 8-bit indices, strips with 8- or 16-bit indices and restart
+ *   off, list restart with primitiveTopologyListRestart, the last vertex provoking with a
+ *   Flat fragment shader (77580-77603 B per draw each; 73728 fan draws recorded, the
+ *   process ended before 81920), and index robustness: a NULL index buffer, or with
+ *   robustBufferAccess2 or pipelineRobustness an indirect or over-reading draw (KosmicKrisp
+ *   also needs a misaligned buffer for those on macOS 27; vkr counts them on any).
+ *   Predicated: 60022 B per draw.
+ * Not split (121-139 B): lists, strips with restart on or 32-bit indices, flat inputs with
+ * the first vertex provoking, timestamps in a pass, robust direct draws inside the buffer.
+ * MAX_INDEX: the largest index the call reads (firstIndex + indexCount), UINT64_MAX for an
+ * indirect one. */
+static bool
+vkr_cmd_draw_weigh(struct vn_dispatch_context *dispatch,
+                   VkCommandBuffer handle,
+                   bool indexed,
+                   uint64_t max_index,
+                   uint32_t draws,
+                   const char *call)
+{
+   const struct vkr_command_buffer *cmd = vkr_command_buffer_from_handle(handle);
+   const struct vkr_cmd_state *st = &cmd->state;
+   const struct vkr_pipeline_draw *d = &st->draw;
+   if (d->tess)
+      return vkr_cmd_weigh(dispatch, handle, draws, call);
+   if (!cmd->device->physical_device->limits.kosmickrisp)
+      return true;
+   bool split = st->conditional || d->topology == VK_PRIMITIVE_TOPOLOGY_TRIANGLE_FAN ||
+                (d->flat && d->last);
+   if (indexed) {
+      const bool strip = d->topology == VK_PRIMITIVE_TOPOLOGY_LINE_STRIP ||
+                         d->topology == VK_PRIMITIVE_TOPOLOGY_TRIANGLE_STRIP;
+      const bool list = d->topology == VK_PRIMITIVE_TOPOLOGY_POINT_LIST ||
+                        d->topology == VK_PRIMITIVE_TOPOLOGY_LINE_LIST ||
+                        d->topology == VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST ||
+                        d->topology == VK_PRIMITIVE_TOPOLOGY_LINE_LIST_WITH_ADJACENCY ||
+                        d->topology == VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST_WITH_ADJACENCY;
+      const uint64_t bytes = max_index == UINT64_MAX ? UINT64_MAX : max_index * st->index_size;
+      split |= st->index_size < 2 || (strip && !d->restart && st->index_size < 4) ||
+               (list && d->restart && cmd->device->list_restart) ||
+               (cmd->device->robust_index && bytes > st->index_range);
+   }
+   return !split || vkr_cmd_weigh(dispatch, handle, 1, call);
+}
+
+/* sample locations or attachment locations that change inside a pass: the next draw starts
+ * a new Metal pass on both drivers (KosmicKrisp kk_flush_render_pass: 24178 B per draw
+ * with a color map change; MoltenVK with prefill ended the process at the end of 114688
+ * draws with either change). One per change, inside a pass. */
+static bool
+vkr_cmd_pass_state_weigh(struct vn_dispatch_context *dispatch, VkCommandBuffer handle, const char *call)
+{
+   return vkr_cmd_state(handle)->pass == VKR_CMD_PASS_NONE || vkr_cmd_weigh(dispatch, handle, 1, call);
+}
+
+/* the largest index of a multi draw */
+static uint64_t
+vkr_cmd_multi_max_index(uint32_t count, const VkMultiDrawIndexedInfoEXT *info)
+{
+   uint64_t m = 0;
+   for (uint32_t i = 0; info && i < count; i++)
+      m = MAX2(m, (uint64_t)info[i].firstIndex + info[i].indexCount);
+   return m;
+}
