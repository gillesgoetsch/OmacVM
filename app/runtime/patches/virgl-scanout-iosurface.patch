+   if (s) {
+      pthread_mutex_lock(&vrend_scanout_fence_lock);
+      f = s->fence;
+      if (f)
+         __atomic_add_fetch(&f->refs, 1, __ATOMIC_ACQ_REL);
+      pthread_mutex_unlock(&vrend_scanout_fence_lock);
+   }
+   return f;
+}
+
+void vrend_renderer_scanout_fence_wait(void *fence, bool gpu)
+{
+   struct vrend_scanout_fence *f = fence;
+   if (!f)
+      return;
+   if (gpu) {
+      glWaitSync(f->sync, 0, GL_TIMEOUT_IGNORED);
+   } else {
+      /* Apple's glClientWaitSync spins a core until the fence signals: test it, and nap
+       * 100 us between tests; at most 1 s */
+      for (int t = 0; t < 10000 && glClientWaitSync(f->sync, 0, 0) == GL_TIMEOUT_EXPIRED; t++)
+         usleep(100);
+   }
+   vrend_scanout_fence_put(f);
+}
