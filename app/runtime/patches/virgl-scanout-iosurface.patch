+void *vrend_renderer_resource_scanout_fence(UNUSED struct pipe_resource *pres) { return NULL; }
+void vrend_renderer_scanout_fence_wait(UNUSED void *fence, UNUSED bool gpu) { }
+void vrend_renderer_scanout_fences_make(void) { }
+#endif
