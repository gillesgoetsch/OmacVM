+#ifdef ENABLE_METAL
+/*
+ * OmacVM: scanout buffers as IOSurfaces, for QEMU's direct present
+ * (omacvm-cocoa-present-direct.patch). A single-level 2D buffer the guest makes for scanout in
+ * an 8-bit (BGRX, BGRA) or 10-bit (BGRX2101010, BGRA1010102) format lives in an IOSurface,
+ * bound as a RECTANGLE texture (gl_id): framebuffers write and read it as before, and QEMU
+ * puts the IOSurface itself on the window instead of drawing the buffer into one of its own.
+ * Samplers cannot read a RECTANGLE texture as 2D: they read a 2D shadow, copied when a draw
+ * samples the buffer after it changed.
+ *
+ * The guest's page flip completes in the guest without waiting for the Mac, so the guest may
+ * draw into a buffer that QEMU still queues, that is on the window, or that WindowServer
+ * still holds (it keeps the frame shown before the current one). Before the first write
+ * after QEMU took the buffer for the screen, a buffer still in use moves to a free IOSurface
+ * with its picture copied on the GPU (the guest redraws only what changed). Spares are
+ * charged to the guest's GPU memory budget as display memory; with VREND_SCANOUT_SPARES
+ * spares all in use, the oldest is let go (WindowServer frees it when done with it) for a
+ * new one. Only when the budget refuses a spare does a write wait, at most 25 ms.
+ *
+ * QEMU waits for a fence made after the guest's last write (vrend_scanout_fences_make, at
+ * the end of each submit or upload) before the buffer goes on the window: the guest's
+ * contexts and QEMU's are different GL contexts.
+ */
+static pthread_mutex_t vrend_scanout_fence_lock = PTHREAD_MUTEX_INITIALIZER;
+static struct vrend_resource **vrend_scanout_due;   /* written, no fence yet (referenced) */
+static unsigned vrend_scanout_ndue, vrend_scanout_due_cap;
+static unsigned vrend_scanout_count;   /* scanout IOSurfaces alive: the hooks skip when 0 */
+static struct {
+   uint64_t writes, moves, queued, made, dropped, uncharged, refreshes, last_log_us;
+} vrend_scanout_stats;
+
+static uint64_t vrend_scanout_now_us(void)
+{
+   struct timespec t;
+   clock_gettime(CLOCK_MONOTONIC, &t);
+   return (uint64_t)t.tv_sec * 1000000 + t.tv_nsec / 1000;
+}
+
+/* once every 5 s with something to say */
+static void vrend_scanout_stats_tick(void)
+{
+   uint64_t now = vrend_scanout_now_us();
+   if (!vrend_scanout_stats.last_log_us)
+      vrend_scanout_stats.last_log_us = now;
+   if (now - vrend_scanout_stats.last_log_us < 5000000)
+      return;
+   if (vrend_scanout_stats.moves || vrend_scanout_stats.refreshes)
+      virgl_info("scanout IOSurfaces, last 5 s: %" PRIu64 " writes, %" PRIu64 " moved to another "
+                 "IOSurface with a copy (%" PRIu64 " of them queued in QEMU, the others held by "
+                 "WindowServer; %" PRIu64 " made, %" PRIu64 " past the GPU memory budget, %" PRIu64
+                 " let go), %" PRIu64 " shadow copies\n",
+                 vrend_scanout_stats.writes, vrend_scanout_stats.moves, vrend_scanout_stats.queued,
+                 vrend_scanout_stats.made, vrend_scanout_stats.uncharged,
+                 vrend_scanout_stats.dropped, vrend_scanout_stats.refreshes);
+   memset(&vrend_scanout_stats, 0, sizeof(vrend_scanout_stats));
+   vrend_scanout_stats.last_log_us = now;
+}
+
+static void vrend_scanout_fence_put(struct vrend_scanout_fence *f)
+{
+   if (f && __atomic_sub_fetch(&f->refs, 1, __ATOMIC_ACQ_REL) == 0) {
+      glDeleteSync(f->sync);
+      free(f);
+   }
+}
+
+/* The current context: one fence after the writes into the buffers written since theirs. */
+void vrend_renderer_scanout_fences_make(void)
+{
+   if (!vrend_scanout_ndue)
+      return;
+   struct vrend_scanout_fence *f = calloc(1, sizeof(*f));
+   if (f) {
+      f->sync = glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+      f->refs = vrend_scanout_ndue;
+      glFlush();
+   }
+   for (unsigned i = 0; i < vrend_scanout_ndue; i++) {
+      struct vrend_scanout *s = vrend_scanout_due[i]->scanout;
+      pthread_mutex_lock(&vrend_scanout_fence_lock);
+      struct vrend_scanout_fence *old = s->fence;
+      s->fence = f;
+      pthread_mutex_unlock(&vrend_scanout_fence_lock);
+      vrend_scanout_fence_put(old);
+      s->fence_due = false;
+      vrend_resource_reference(&vrend_scanout_due[i], NULL);
+   }
+   vrend_scanout_ndue = 0;
+}
+
+/* The current context waits on the GPU for the buffer's last writes (another context's). */
+static void vrend_scanout_gpu_wait(struct vrend_scanout *s)
+{
+   pthread_mutex_lock(&vrend_scanout_fence_lock);
+   struct vrend_scanout_fence *f = s->fence;
+   if (f)
+      __atomic_add_fetch(&f->refs, 1, __ATOMIC_ACQ_REL);
+   pthread_mutex_unlock(&vrend_scanout_fence_lock);
+   vrend_renderer_scanout_fence_wait(f, true);
+}
+
+/* Copy one RECTANGLE texture into another (2D or RECTANGLE) on the GPU; GL state kept. */
+static void vrend_scanout_copy(struct vrend_context *ctx, GLuint from, GLuint to, GLenum to_target,
+                               unsigned w, unsigned h)
+{
+   GLint rfb = 0, dfb = 0;
+   GLboolean scissor = glIsEnabled(GL_SCISSOR_TEST);
+   GLuint fb[2];
+
+   if (ctx)
+      vrend_pause_render_condition(ctx, true);
+   glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &rfb);
+   glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &dfb);
+   glGenFramebuffers(2, fb);
+   glBindFramebuffer(GL_READ_FRAMEBUFFER, fb[0]);
+   glFramebufferTexture2D(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_RECTANGLE, from, 0);
+   glBindFramebuffer(GL_DRAW_FRAMEBUFFER, fb[1]);
+   glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, to_target, to, 0);
+   if (scissor)
+      glDisable(GL_SCISSOR_TEST);
+   glBlitFramebuffer(0, 0, w, h, 0, 0, w, h, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+   if (scissor)
+      glEnable(GL_SCISSOR_TEST);
+   glBindFramebuffer(GL_READ_FRAMEBUFFER, rfb);
+   glBindFramebuffer(GL_DRAW_FRAMEBUFFER, dfb);
+   glDeleteFramebuffers(2, fb);
+   if (ctx)
+      vrend_pause_render_condition(ctx, false);
+}
+
+static bool vrend_scanout_alloc(struct vrend_resource *gr, enum virgl_formats format)
+{
+   const struct pipe_resource *pr = &gr->base;
+   GLenum internal, glformat, type;
+   uint32_t fourcc;
+
+   switch (format) {
+   case VIRGL_FORMAT_B8G8R8X8_UNORM:
+   case VIRGL_FORMAT_B8G8R8A8_UNORM:
+      internal = GL_RGBA8;
+      glformat = GL_BGRA;
+      type = GL_UNSIGNED_INT_8_8_8_8_REV;
+      fourcc = 'BGRA';
+      break;
+   case VIRGL_FORMAT_B10G10R10X2_UNORM:
+   case VIRGL_FORMAT_B10G10R10A2_UNORM:
+      internal = GL_RGB10_A2;
+      glformat = GL_BGRA;
+      type = GL_UNSIGNED_INT_2_10_10_10_REV;
+      fourcc = 'l10r';   /* ARGB2101010, little endian: blue in the low bits */
+      break;
+   default:
+      return false;
+   }
+   /* not a buffer QEMU made (y_0_top: QEMU shows an IOSurface's first row at the top) */
+   if (vrend_state.use_gles || !(pr->bind & VIRGL_RES_BIND_SCANOUT) ||
+       gr->y_0_top || pr->target != PIPE_TEXTURE_2D || pr->last_level != 0 || pr->nr_samples > 1 ||
+       pr->array_size > 1 || pr->depth0 != 1 || !pr->width0 || !pr->height0 ||
+       pr->width0 > 16384 || pr->height0 > 16384)
+      return false;
+
+   struct vrend_scanout *s = calloc(1, sizeof(*s));
+   void *surface = s ? virgl_metal_scanout_iosurface_create(pr->width0, pr->height0, fourcc) : NULL;
+   GLuint tex = 0;
+   if (surface) {
+      glGenTextures(1, &tex);
+      glBindTexture(GL_TEXTURE_RECTANGLE, tex);
+      if (!virgl_metal_scanout_iosurface_bind(surface, internal, glformat, type)) {
+         glDeleteTextures(1, &tex);
+         tex = 0;
+      }
+   }
+   if (!tex) {
+      virgl_metal_iosurface_release(surface);
+      free(s);
+      static bool told;
+      if (!told) {
+         told = true;
+         virgl_warn("a %ux%u scanout buffer could not be an IOSurface: QEMU copies it\n",
+                    pr->width0, pr->height0);
+      }
+      return false;
+   }
+   glTexParameteri(GL_TEXTURE_RECTANGLE, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+   glTexParameteri(GL_TEXTURE_RECTANGLE, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+   glBindTexture(GL_TEXTURE_RECTANGLE, 0);
+   s->surface = surface;
+   s->internal = internal;
+   s->format = glformat;
+   s->type = type;
+   s->fourcc = fourcc;
+   s->bytes = (uint64_t)pr->width0 * pr->height0 * 4;
+   s->shadow_swizzle[0] = -1;
+   gr->scanout = s;
+   gr->gl_id = tex;
+   gr->target = GL_TEXTURE_RECTANGLE;
+   gr->storage_bits &= ~VREND_STORAGE_GL_IMMUTABLE;
+   gr->storage_bits |= VREND_STORAGE_GL_TEXTURE;
+   vrend_scanout_count++;
+   return true;
+}
+
+static void vrend_scanout_free(struct vrend_resource *res)
+{
+   struct vrend_scanout *s = res->scanout;
+   if (!s)
+      return;
+   if (s->shadow)
+      glDeleteTextures(1, &s->shadow);
+   if (s->shadow_sync)
+      glDeleteSync(s->shadow_sync);
+   virgl_metal_iosurface_release(s->surface);
+   for (unsigned k = 0; k < VREND_SCANOUT_SPARES; k++)
+      virgl_metal_iosurface_release(s->spare[k]);
+   virgl_gpu_budget_uncharge(s->charged);
+   vrend_scanout_fence_put(s->fence);
+   free(s);
+   res->scanout = NULL;
+   vrend_scanout_count--;
+}
+
+/* An IOSurface nothing uses for the buffer to move to; NULL only when none can be made. */
+static void **vrend_scanout_free_spare(struct vrend_resource *res)
+{
+   struct vrend_scanout *s = res->scanout;
+   unsigned k;
+
+   for (k = 0; k < VREND_SCANOUT_SPARES; k++) {
+      if (s->spare[k] && !virgl_metal_iosurface_in_use(s->spare[k]))
+         return &s->spare[k];
+   }
+   for (k = 0; k < VREND_SCANOUT_SPARES && s->spare[k]; k++)
+      ;
+   if (k == VREND_SCANOUT_SPARES) {
+      /* all in use: let the oldest go (WindowServer frees it when done) */
+      k = s->next_drop++ % VREND_SCANOUT_SPARES;
+      virgl_metal_iosurface_release(s->spare[k]);
+      s->spare[k] = NULL;
+      if (s->spare_charged & (1u << k)) {
+         virgl_gpu_budget_uncharge(s->bytes);
+         s->charged -= s->bytes;
+      }
+      vrend_scanout_stats.dropped++;
+   }
+   s->spare[k] = virgl_metal_scanout_iosurface_create(res->base.width0, res->base.height0, s->fourcc);
+   if (!s->spare[k])
+      return NULL;
+   /* charged as display memory; past the budget it is made all the same (at most three a
+    * buffer), as the guest must not write a buffer on the screen */
+   s->spare_charged &= ~(1u << k);
+   if (!virgl_gpu_budget_charge(s->bytes, true)) {
+      s->spare_charged |= 1u << k;
+      s->charged += s->bytes;
+   } else {
+      vrend_scanout_stats.uncharged++;
+   }
+   vrend_scanout_stats.made++;
+   return &s->spare[k];
+}
+
+/* The buffer moves to a free IOSurface with its picture. GL state kept. */
+static bool vrend_scanout_move(struct vrend_context *ctx, struct vrend_resource *res)
+{
+   struct vrend_scanout *s = res->scanout;
+   void **spare = vrend_scanout_free_spare(res);
+   GLint bound = 0;
+   GLuint to = 0;
+   bool ok;
+
+   if (!spare)
+      return false;
+   glGetIntegerv(GL_TEXTURE_BINDING_RECTANGLE, &bound);
+   glGenTextures(1, &to);
+   glBindTexture(GL_TEXTURE_RECTANGLE, to);
+   ok = virgl_metal_scanout_iosurface_bind(*spare, s->internal, s->format, s->type);
+   if (ok) {
+      vrend_scanout_gpu_wait(s);
+      vrend_scanout_copy(ctx, res->gl_id, to, GL_TEXTURE_RECTANGLE, res->base.width0,
+                         res->base.height0);
+      /* the buffer's own texture (every framebuffer and view of it) on the new IOSurface */
+      glBindTexture(GL_TEXTURE_RECTANGLE, res->gl_id);
+      ok = virgl_metal_scanout_iosurface_bind(*spare, s->internal, s->format, s->type);
+   }
+   glBindTexture(GL_TEXTURE_RECTANGLE, bound);
+   glDeleteTextures(1, &to);
+   if (!ok)
+      return false;
+   void *old = s->surface;
+   __atomic_store_n(&s->surface, *spare, __ATOMIC_RELEASE);
+   *spare = old;
+   s->moves++;
+   vrend_scanout_stats.moves++;
+   return true;
+}
+
+/*
+ * Before the guest writes the buffer. The first write after QEMU took it for the screen
+ * moves it when anything still uses it. True when its storage moved.
+ */
+static bool vrend_scanout_write(struct vrend_context *ctx, struct vrend_resource *res)
+{
+   struct vrend_scanout *s = res->scanout;
+   bool moved = false;
+
+   if (!s)
+      return false;
+   s->gen++;
+   vrend_scanout_stats.writes++;
+   if (!s->fence_due) {
+      if (vrend_scanout_ndue == vrend_scanout_due_cap) {
+         unsigned cap = MAX2(8, vrend_scanout_due_cap * 2);
+         struct vrend_resource **due = realloc(vrend_scanout_due, cap * sizeof(*due));
+         if (!due) {
+            /* no room: the writes so far get their fence now, this one with the next */
+            vrend_renderer_scanout_fences_make();
+            due = vrend_scanout_due;
+         } else {
+            vrend_scanout_due = due;
+            vrend_scanout_due_cap = cap;
+         }
+      }
+      if (vrend_scanout_ndue < vrend_scanout_due_cap) {
+         s->fence_due = true;
+         vrend_scanout_due[vrend_scanout_ndue] = NULL;
+         vrend_resource_reference(&vrend_scanout_due[vrend_scanout_ndue++], res);
+      }
+   }
+   if (__atomic_exchange_n(&s->may_be_shown, 0, __ATOMIC_ACQ_REL) &&
+       virgl_metal_iosurface_in_use(s->surface)) {
+      vrend_scanout_stats.queued += virgl_metal_iosurface_used_here(s->surface);
+      moved = vrend_scanout_move(ctx, res);
+      if (!moved)
+         virgl_error("a scanout IOSurface in use could not move: the guest writes it on screen\n");
+   }
+   vrend_scanout_stats_tick();
+   return moved;
+}
+
+/* Before a draw or clear into the bound framebuffer: its colour buffers are written. */
+static void vrend_scanout_write_fb(struct vrend_context *ctx, struct vrend_sub_context *sub_ctx)
+{
+   if (likely(!vrend_scanout_count))
+      return;
+   for (uint32_t i = 0; i < sub_ctx->nr_cbufs && i < PIPE_MAX_COLOR_BUFS; i++) {
+      struct vrend_surface *surf = sub_ctx->surf[i];
+      if (!surf || !surf->texture->scanout)
+         continue;
+      vrend_scanout_write(ctx, surf->texture);
+      /* attached before the storage moved (here or in another context): attach again */
+      if (sub_ctx->scanout_moves[i] != surf->texture->scanout->moves) {
+         glBindFramebuffer(GL_FRAMEBUFFER, sub_ctx->fb_id);
+         vrend_hw_set_color_surface(sub_ctx, i);
+      }
+   }
+}
+
+/* The 2D copy samplers read, copied from the buffer when it changed since. */
+static GLuint vrend_scanout_shadow(struct vrend_context *ctx, struct vrend_resource *res)
+{
+   struct vrend_scanout *s = res->scanout;
+
+   if (!s->shadow) {
+      GLint bound = 0;
+      if (!virgl_gpu_budget_charge(s->bytes, true))
+         s->charged += s->bytes;
+      glGetIntegerv(GL_TEXTURE_BINDING_2D, &bound);
+      glGenTextures(1, &s->shadow);
+      glBindTexture(GL_TEXTURE_2D, s->shadow);
+      glTexImage2D(GL_TEXTURE_2D, 0, s->internal, res->base.width0, res->base.height0, 0,
+                   s->format, s->type, NULL);
+      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_BASE_LEVEL, 0);
+      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAX_LEVEL, 0);
+      glBindTexture(GL_TEXTURE_2D, bound);
+      s->shadow_gen = s->gen - 1;
+   }
+   if (ctx && s->shadow_gen != s->gen) {
+      vrend_scanout_gpu_wait(s);
+      vrend_scanout_copy(ctx, res->gl_id, s->shadow, GL_TEXTURE_2D, res->base.width0,
+                         res->base.height0);
+      if (s->shadow_sync)
+         glDeleteSync(s->shadow_sync);
+      s->shadow_sync = glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+      glFlush();
+      s->shadow_gen = s->gen;
+      vrend_scanout_stats.refreshes++;
+      vrend_scanout_stats_tick();
+   } else if (ctx && s->shadow_sync) {
+      /* copied in this or another context: wait for that copy */
+      glWaitSync(s->shadow_sync, 0, GL_TIMEOUT_IGNORED);
+   }
+   return s->shadow;
+}
+
+/* Does the view read the texture it was made of (or the scanout's shadow), not a GL view? */
+static inline bool vrend_view_reads_texture(const struct vrend_sampler_view *view)
+{
+   return view->gl_id == view->texture->gl_id ||
+          (view->texture->scanout && view->gl_id == view->texture->scanout->shadow);
+}
