diff --git a/src/vrend/vrend_metal.m b/src/vrend/vrend_metal.m
index f2f7b2f..5670491 100644
--- a/src/vrend/vrend_metal.m
+++ b/src/vrend/vrend_metal.m
@@ -329,6 +329,46 @@ void virgl_metal_iosurface_release(void *iosurface)
       CFRelease(iosurface);
 }
 
+void *virgl_metal_scanout_iosurface_create(unsigned width, unsigned height, uint32_t fourcc)
+{
+   const int32_t values[4] = { (int32_t)width, (int32_t)height, 4, (int32_t)fourcc };
+   const void *keys[4] = { kIOSurfaceWidth, kIOSurfaceHeight, kIOSurfaceBytesPerElement,
+                           kIOSurfacePixelFormat };
+   CFNumberRef numbers[4];
+   for (int i = 0; i < 4; i++)
+      numbers[i] = CFNumberCreate(NULL, kCFNumberSInt32Type, &values[i]);
+   CFDictionaryRef props = CFDictionaryCreate(NULL, keys, (const void **)numbers, 4,
+                                              &kCFTypeDictionaryKeyCallBacks,
+                                              &kCFTypeDictionaryValueCallBacks);
+   IOSurfaceRef surface = IOSurfaceCreate(props);
+   CFRelease(props);
+   for (int i = 0; i < 4; i++)
+      CFRelease(numbers[i]);
+   return (void *)surface;
+}
+
+bool virgl_metal_scanout_iosurface_bind(void *iosurface, unsigned internal, unsigned format,
+                                        unsigned type)
+{
+   IOSurfaceRef surface = (IOSurfaceRef)iosurface;
+   CGLContextObj cgl = CGLGetCurrentContext();
+
+   return cgl && CGLTexImageIOSurface2D(cgl, GL_TEXTURE_RECTANGLE, internal,
+                                        (GLsizei)IOSurfaceGetWidth(surface),
+                                        (GLsizei)IOSurfaceGetHeight(surface), format, type,
+                                        surface, 0) == kCGLNoError;
+}
+
+bool virgl_metal_iosurface_in_use(void *iosurface)
+{
+   return iosurface && IOSurfaceIsInUse((IOSurfaceRef)iosurface);
+}
+
+bool virgl_metal_iosurface_used_here(void *iosurface)
+{
+   return iosurface && IOSurfaceGetUseCount((IOSurfaceRef)iosurface) > 0;
+}
+
 bool virgl_metal_iosurface_bind_rect(void *iosurface, unsigned *width, unsigned *height)
 {
    IOSurfaceRef surface = (IOSurfaceRef)iosurface;
