+
+static bool vrend_ubos_inside(struct vrend_sub_context *sub_ctx, int shader_type)
+{
+   uint32_t mask = sub_ctx->prog->ubo_used_mask[shader_type];
+
+   while (mask) {
+      int i = u_bit_scan(&mask);
+      if (i >= PIPE_MAX_CONSTANT_BUFFERS)
+         return false;
+      uint32_t block = sub_ctx->prog->ubo_block_size[shader_type][i];
+      if (!block)
+         continue; /* inactive: the GL reads nothing */
+      const struct pipe_constant_buffer *cb = &sub_ctx->cbs[shader_type][i];
+      const struct vrend_resource *res = (const struct vrend_resource *)cb->buffer;
+      if (!res || !cb->buffer_size ||
+          (uint64_t)cb->buffer_offset + block > vrend_gl_buffer_size(res))
+         return false;
+   }
+   return true;
 }
 
