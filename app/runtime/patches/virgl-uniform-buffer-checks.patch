+
+/* Bytes of a GL buffer. Up to 15 bytes of slack: vrend declares a uniform block as an
+ * array of vec4, so its data size is the guest's block size rounded up to 16, while apps
+ * size buffers to their C struct. Buffers seen through texel counts (texture buffers)
+ * and mapped ones (immutable storage) keep their exact size. */
+static uint64_t vrend_gl_buffer_size(const struct vrend_resource *res)
+{
+   if ((res->base.bind & VIRGL_BIND_SAMPLER_VIEW) ||
+       has_bit(res->storage_bits, VREND_STORAGE_GL_IMMUTABLE))
+      return res->base.width0;
+   return ((uint64_t)res->base.width0 + 15) & ~(uint64_t)15;
 }
 
 /* [offset, offset + size) lies inside the buffer; 64-bit, so no 32-bit wrap. */
