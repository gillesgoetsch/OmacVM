-- (void) toggleKey: (unsigned int)keycode {
-    qkbd_state_key_event(kbd, keycode, !qkbd_state_key_get(kbd, keycode));
+/*
+ * OmacVM (#412): the guest's modifier keys follow the event's flags
+ * (ui/omacvm-modifiers.h). QEMU flipped a key on each flagsChanged and let
+ * any event without the flag release it: with another Mac's keyboard through
+ * Universal Control, Shift went up the moment it went down (Shift+2 typed 2).
+ */
+- (void) omacvmSyncModifiers:(NSEvent *)event
+{
+    unsigned int keys[OMACVM_MOD_PAIRS][2] = {
+        [OMACVM_MOD_SHIFT]   = { KEY_LEFTSHIFT, KEY_RIGHTSHIFT },
+        [OMACVM_MOD_CONTROL] = { KEY_LEFTCTRL, KEY_RIGHTCTRL },
+        [OMACVM_MOD_OPTION]  = { KEY_LEFTALT, KEY_RIGHTALT },
+        [OMACVM_MOD_COMMAND] = { KEY_LEFTMETA, KEY_RIGHTMETA },
+    };
+    OmacVMModKeys now[OMACVM_MOD_PAIRS], next[OMACVM_MOD_PAIRS];
+    NSEventType type = [event type];
+    OmacVMModEvent kind = type == NSEventTypeKeyDown || type == NSEventTypeFlagsChanged ?
+        OMACVM_MOD_EV_KEY : OMACVM_MOD_EV_INPUT;
+    int code = type == NSEventTypeFlagsChanged ? [event keyCode] : -1;
+    /* Command goes to the guest only while it has the keyboard. */
+    bool captured = [self isKeyboardCaptured];
+
+    if (swap_opt_cmd) {
+        keys[OMACVM_MOD_OPTION][0] = KEY_LEFTMETA;
+        keys[OMACVM_MOD_OPTION][1] = KEY_RIGHTMETA;
+        keys[OMACVM_MOD_COMMAND][0] = KEY_LEFTALT;
+        keys[OMACVM_MOD_COMMAND][1] = KEY_RIGHTALT;
+    }
+    for (int p = 0; p < OMACVM_MOD_PAIRS; p++) {
+        bool command = p == OMACVM_MOD_COMMAND;
+        now[p].left = qkbd_state_key_get(kbd, keys[p][0]);
+        now[p].right = qkbd_state_key_get(kbd, keys[p][1]);
+        next[p] = omacvm_mod_next(p, now[p], kind, [event modifierFlags], code,
+                                  !command || (captured && left_command_key_enabled),
+                                  !command || captured);
+    }
+    /* Releases first: a key that moved from one side to the other. */
+    for (int p = 0; p < OMACVM_MOD_PAIRS; p++) {
+        if (now[p].left && !next[p].left) {
+            qkbd_state_key_event(kbd, keys[p][0], false);
+        }
+        if (now[p].right && !next[p].right) {
+            qkbd_state_key_event(kbd, keys[p][1], false);
+        }
+    }
+    for (int p = 0; p < OMACVM_MOD_PAIRS; p++) {
+        if (!now[p].left && next[p].left) {
+            qkbd_state_key_event(kbd, keys[p][0], true);
+        }
+        if (!now[p].right && next[p].right) {
+            qkbd_state_key_event(kbd, keys[p][1], true);
+        }
+    }
 }
 
