@@ -14543,6 +14543,21 @@
 }
 
 
+/*
+ * OmacVM: hand the work of a resource or transfer command from QEMU to the driver
+ * now. These run on vrend's own context (ctx0, made current for every QEMU
+ * command) or, for a transfer with a context id, on that context; nothing else
+ * flushes ctx0, and Apple's GL keeps the memory of textures made, deleted or
+ * uploaded on a context until that context is flushed. A guest switching modes
+ * (a new screen texture uploaded by QEMU's 2D path on every switch) grew QEMU's
+ * GPU memory without end.
+ */
+void vrend_renderer_flush_current(void)
+{
+   if (vrend_state.current_hw_ctx)
+      glFlush();
+}
+
 void vrend_renderer_force_ctx_0(void)
 {
    TRACE_FUNC();
