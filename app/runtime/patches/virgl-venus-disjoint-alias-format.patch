diff --git a/src/venus/vkr_physical_device.c b/src/venus/vkr_physical_device.c
index 8bbd7eb..f5bd808 100644
--- a/src/venus/vkr_physical_device.c
+++ b/src/venus/vkr_physical_device.c
@@ -614,6 +614,26 @@ vkr_physical_device_image_kind_ok(const struct vkr_physical_device *physical_dev
           physical_dev->EXT_image_drm_format_modifier;
 }
 
+/* OmacVM (virgl-venus-disjoint-alias-format.patch): the flags to ask the driver's format
+ * query once more with after it answered r to flags, or flags (nothing to ask again).
+ * DISJOINT with ALIAS on a one-plane format is legal (VUID-VkImageCreateInfo-format-01577):
+ * an image that aliases one plane of a disjoint YCbCr image. MoltenVK 1.4.2's query says
+ * FORMAT_NOT_SUPPORTED to DISJOINT on every format that is not multi-planar and does not
+ * look at ALIAS (MVKDevice.mm:1578); its vkCreateImage makes the image with one memory
+ * binding, as without DISJOINT (MVKImage.mm:1261). A one-plane image has one memory
+ * plane, so DISJOINT changes nothing its limits depend on: asked without it, the driver
+ * judges the same image. Only after a "no", so a driver that answers these flags itself
+ * (KosmicKrisp) keeps its own answer; only for a format vkr's table knows. */
+VkImageCreateFlags
+vkr_physical_device_retry_flags(VkFormat format, VkImageCreateFlags flags, VkResult r)
+{
+   const VkImageCreateFlags alias = VK_IMAGE_CREATE_DISJOINT_BIT | VK_IMAGE_CREATE_ALIAS_BIT;
+   if (r != VK_ERROR_FORMAT_NOT_SUPPORTED || (flags & alias) != alias ||
+       !vkr_format_block_size(format) || vkr_format_plane_count(format) != 1)
+      return flags;
+   return flags & ~VK_IMAGE_CREATE_DISJOINT_BIT;
+}
+
 static void
 vkr_physical_device_emulate_drm_props(VkDrmFormatModifierPropertiesListEXT *drm_props_list)
 {
@@ -906,6 +926,14 @@ vkr_dispatch_vkGetPhysicalDeviceImageFormatProperties(
    args->ret = vk->GetPhysicalDeviceImageFormatProperties(
       args->physicalDevice, args->format, args->type, args->tiling, args->usage,
       args->flags, args->pImageFormatProperties);
+   /* OmacVM (virgl-venus-disjoint-alias-format.patch): the answer vkCreateImage's check
+    * gives (vkr_image_info_ok), so the guest makes what it was told it may */
+   const VkImageCreateFlags again =
+      vkr_physical_device_retry_flags(args->format, args->flags, args->ret);
+   if (again != args->flags)
+      args->ret = vk->GetPhysicalDeviceImageFormatProperties(
+         args->physicalDevice, args->format, args->type, args->tiling, args->usage, again,
+         args->pImageFormatProperties);
 }
 
 static void
@@ -1122,6 +1150,16 @@ vkr_dispatch_vkGetPhysicalDeviceImageFormatProperties2(
    vn_replace_vkGetPhysicalDeviceImageFormatProperties2_args_handle(args);
    args->ret = vk->GetPhysicalDeviceImageFormatProperties2(
       args->physicalDevice, args->pImageFormatInfo, args->pImageFormatProperties);
+   /* OmacVM (virgl-venus-disjoint-alias-format.patch): as version 1, on a copy (the
+    * guest's chain stays as it is) */
+   const VkImageCreateFlags again = vkr_physical_device_retry_flags(
+      args->pImageFormatInfo->format, args->pImageFormatInfo->flags, args->ret);
+   if (again != args->pImageFormatInfo->flags) {
+      VkPhysicalDeviceImageFormatInfo2 info = *args->pImageFormatInfo;
+      info.flags = again;
+      args->ret = vk->GetPhysicalDeviceImageFormatProperties2(args->physicalDevice, &info,
+                                                              args->pImageFormatProperties);
+   }
 
    /* emulate handle for dmabuf */
    if (physical_dev->is_dma_buf_emulated && physical_dev->is_metal_export_supported) {
