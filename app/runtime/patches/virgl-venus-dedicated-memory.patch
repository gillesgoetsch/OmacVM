diff --git a/src/venus/vkr_device_memory.c b/src/venus/vkr_device_memory.c
index 3d42ced..c68665f 100644
--- a/src/venus/vkr_device_memory.c
+++ b/src/venus/vkr_device_memory.c
@@ -10,6 +10,7 @@
 #include "vkr_buffer.h"
 #include "vkr_device.h"
 #include "vkr_device_memory_gen.h"
+#include "vkr_image.h"
 #include "vkr_physical_device.h"
 
 #ifdef __APPLE__
@@ -427,6 +428,90 @@ vkr_gbm_get_fd_info_from_allocation_info(UNUSED struct vkr_physical_device *phys
 
 #endif /* ENABLE_GBM_ALLOCATION */
 
+bool
+vkr_device_memory_dedicated_ok(const struct vkr_device_memory *mem,
+                               const struct vkr_dedicated *target,
+                               VkDeviceSize offset)
+{
+   mtx_t *mutex = &mem->device->dedicated_mutex;
+   mtx_lock(mutex);
+   const bool ok = !mem->dedicated || (mem->dedicated == target && !offset);
+   mtx_unlock(mutex);
+   return ok;
+}
+
+bool
+vkr_dedicated_target_destroyed(struct vkr_device *dev, struct vkr_dedicated *d)
+{
+   if (!d)
+      return false;
+   mtx_lock(&dev->dedicated_mutex);
+   const bool wait = d->memories > 0;
+   d->destroyed = true;
+   mtx_unlock(&dev->dedicated_mutex);
+   if (!wait)
+      free(d);
+   return wait;
+}
+
+void
+vkr_dedicated_memory_freed(struct vkr_device *dev, struct vkr_dedicated *d, bool destroy_vk)
+{
+   if (!d)
+      return;
+   mtx_lock(&dev->dedicated_mutex);
+   const bool last = !--d->memories;
+   const bool gone = last && d->destroyed;
+   mtx_unlock(&dev->dedicated_mutex);
+   if (!gone)
+      return;
+   struct vn_device_proc_table *vk = &dev->proc_table;
+   if (destroy_vk && d->type == VK_OBJECT_TYPE_IMAGE)
+      vk->DestroyImage(dev->base.handle.device, d->handle.image, NULL);
+   else if (destroy_vk)
+      vk->DestroyBuffer(dev->base.handle.device, d->handle.buffer, NULL);
+   free(d);
+}
+
+/* links new memory to the image or buffer it is dedicated to (read from the guest's chain
+ * before the handles were replaced); out of host memory, the memory goes again and the
+ * guest gets the error */
+static void
+vkr_device_memory_link_dedicated(struct vkr_context *ctx,
+                                 struct vkr_device *dev,
+                                 struct vkr_device_memory *mem,
+                                 struct vkr_image *image,
+                                 struct vkr_buffer *buffer,
+                                 VkResult *ret)
+{
+   struct vkr_dedicated **slot = image ? &image->dedicated : &buffer->dedicated;
+   struct vkr_dedicated *fresh = calloc(1, sizeof(*fresh));
+   mtx_lock(&dev->dedicated_mutex);
+   struct vkr_dedicated *d = *slot;
+   if (!d && fresh) {
+      d = fresh;
+      fresh = NULL;
+      d->type = image ? VK_OBJECT_TYPE_IMAGE : VK_OBJECT_TYPE_BUFFER;
+      if (image)
+         d->handle.image = image->base.handle.image;
+      else
+         d->handle.buffer = buffer->base.handle.buffer;
+      *slot = d;
+   }
+   if (d) {
+      d->memories++;
+      mem->dedicated = d;
+   }
+   mtx_unlock(&dev->dedicated_mutex);
+   free(fresh);
+   if (!d) {
+      vkr_device_memory_release(mem);
+      dev->proc_table.FreeMemory(dev->base.handle.device, mem->base.handle.device_memory, NULL);
+      vkr_device_remove_object(ctx, dev, &mem->base);
+      *ret = VK_ERROR_OUT_OF_HOST_MEMORY;
+   }
+}
