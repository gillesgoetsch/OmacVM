+/* OmacVM (virgl-venus-dedicated-memory.patch, ADR 0065): the image or buffer device memory
+ * was made for (VkMemoryDedicatedAllocateInfo), shared by that object and the memories
+ * dedicated to it, under its device's dedicated_mutex (a leaf lock, never held across a
+ * driver call). MoltenVK keeps the target in the memory and writes to it when the memory
+ * is freed (~MVKDeviceMemory): a target destroyed before it was bound left the memory a
+ * dangling pointer. So the driver's destroy of a target waits for the last memory
+ * dedicated to it (memory first, then the target), and only the target binds to such
+ * memory, at offset 0. One exception, on KosmicKrisp alone: a swapchain's image (ALIAS_BIT)
+ * and an app's image bound to it (VkBindImageMemorySwapchainInfoKHR, ALIAS_BIT too; guest
+ * Mesa binds the swapchain image's dedicated memory). KosmicKrisp ignores dedicated
+ * allocations; MoltenVK does not count that image, so there the bind stays refused. */
+struct vkr_dedicated {
+   VkObjectType type; /* VK_OBJECT_TYPE_IMAGE or VK_OBJECT_TYPE_BUFFER */
+   union {
+      VkImage image;
+      VkBuffer buffer;
+   } handle; /* the driver's */
+   uint32_t memories;
+   /* the guest destroyed the target: the driver's destroy waits for the last memory */
+   bool destroyed;
+   /* an ALIAS_BIT image on KosmicKrisp: other ALIAS_BIT images may bind too */
+   bool alias;
+};
