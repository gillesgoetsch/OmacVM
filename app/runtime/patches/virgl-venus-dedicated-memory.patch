+/* OmacVM (virgl-venus-dedicated-memory.patch): whether a bind of the image or buffer
+ * whose record is `target` (NULL: none yet) may use this memory at offset: memory dedicated
+ * to nothing, or to that target at offset 0 (VUIDs vkBindImageMemory-memory-02628 and
+ * -10926, vkBindBufferMemory-memory-01508 and -10925; no Mac driver has
+ * dedicatedAllocationImageAliasing, 02629's exception) */
+bool
+vkr_device_memory_dedicated_ok(const struct vkr_device_memory *mem,
+                               const struct vkr_dedicated *target,
+                               VkDeviceSize offset);
+
+/* the guest destroys a dedicated image or buffer (its record d, may be NULL): true when the
+ * driver's destroy must wait for a memory dedicated to it, else the record is freed */
+bool
+vkr_dedicated_target_destroyed(struct vkr_device *dev, struct vkr_dedicated *d);
+
+/* a memory dedicated to d is freed (the driver's free is done): the last one destroys a
+ * target the guest destroyed before (when destroy_vk) and frees the record */
+void
+vkr_dedicated_memory_freed(struct vkr_device *dev, struct vkr_dedicated *d, bool destroy_vk);
+
