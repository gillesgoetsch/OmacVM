diff --git a/source/omacvm/assert.h b/source/omacvm/assert.h
new file mode 100644
--- /dev/null
+++ b/source/omacvm/assert.h
@@ -0,0 +1,11 @@
+// OmacVM (spirv-tools-val-catch-throws.patch): SPIRV-Tools' own assert(). The
+// validator asserts that what it looked up exists (assert(def) and then def->);
+// a release build (NDEBUG) dropped the check and a hostile module ended the
+// process there. Here the check stays in every build and throws, and
+// omacvmValidateWithOptions turns that into SPV_ERROR_INTERNAL. No include
+// guard, as for the system's <assert.h>.
+#undef assert
+[[noreturn]] void omacvm_spirv_assert(const char* expr, const char* file,
+                                      unsigned line);
+#define assert(e) \
+  ((e) ? (void)0 : omacvm_spirv_assert(#e, __FILE__, __LINE__))
diff --git a/source/omacvm/budget.h b/source/omacvm/budget.h
new file mode 100644
--- /dev/null
+++ b/source/omacvm/budget.h
@@ -0,0 +1,31 @@
+// OmacVM (spirv-tools-val-catch-throws.patch): a time budget for one
+// validation. The validator's walks over dominator chains, depth-first
+// traversals and the dominator calculation, construct blocks, types and block
+// layouts grow faster than the module (88 KB of 1000 nested loops kept it busy
+// 53 s); each step of them counts here, every 1024th step reads the thread's
+// CPU time, and past kMaxCpuNs since omacvmValidateWithOptions began the
+// validation throws, which it turns into SPV_ERROR_INTERNAL. Outside it
+// (deadline_ns 0) there is no budget.
+#ifndef OMACVM_BUDGET_H_
+#define OMACVM_BUDGET_H_
+
+#include <cstdint>
+
+namespace omacvm {
+constexpr uint64_t kMaxCpuNs = 2000000000;  // 2 s
+extern thread_local uint64_t steps;
+extern thread_local uint64_t deadline_ns;
+uint64_t ThreadCpuNs();
+inline void step() {
+  if ((++steps & 1023) == 0 && deadline_ns && ThreadCpuNs() > deadline_ns) throw 1;
+}
+// n cheap steps at once (a linear search of n)
+inline void add(uint64_t n) {
+  const uint64_t before = steps;
+  steps += n;
+  if ((before >> 10) != (steps >> 10) && deadline_ns && ThreadCpuNs() > deadline_ns)
+    throw 1;
+}
+}  // namespace omacvm
+
+#endif  // OMACVM_BUDGET_H_
