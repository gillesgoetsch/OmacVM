+spv_result_t omacvmValidateWithOptions(const spv_const_context context,
+                                       spv_const_validator_options options,
+                                       const spv_const_binary binary,
+                                       spv_diagnostic* pDiagnostic) {
+  omacvm::steps = 0;
+  omacvm::deadline_ns = omacvm::ThreadCpuNs() + omacvm::kMaxCpuNs;
+  spv_result_t result;
+  try {
+    result = spvValidateWithOptions(context, options, binary, pDiagnostic);
+  } catch (...) {
+    if (pDiagnostic) {
+      spvDiagnosticDestroy(*pDiagnostic);
+      *pDiagnostic = nullptr;
+    }
+    result = SPV_ERROR_INTERNAL;
+  }
+  omacvm::deadline_ns = 0;
+  return result;
 }
