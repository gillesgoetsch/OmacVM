+                 (unsigned long long)(vrend_state.resource_critical_grace >> 20),
+                 (unsigned long long)(vrend_memory.critical_base >> 20));
+   } else if (tick && level < VREND_PRESSURE_CRITICAL) {
+      vrend_memory.critical_set = false;
+   }
+}
