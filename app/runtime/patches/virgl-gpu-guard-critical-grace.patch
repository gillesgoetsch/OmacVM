+/* OmacVM (virgl-gpu-guard-critical-grace.patch): the first look that sees critical
+ * (a room check or the tick, whichever comes first) notes what is in use then; the
+ * tick's look below critical forgets it. Renderer thread. */
+static void vrend_memory_critical_look(int level, bool tick)
+{
+   if (level == VREND_PRESSURE_CRITICAL && !vrend_memory.critical_set) {
+      vrend_memory.critical_set = true;
+      vrend_memory.critical_base = virgl_gpu_budget_in_use();
+      virgl_info("macOS memory pressure critical: guest GPU memory may grow by %llu MB past the "
