+/* While macOS's memory pressure is critical (virgl-gpu-guard-critical-grace.patch): how
+ * far all guest GPU memory may grow past what was in use when critical began, for a Mac
+ * with MAC bytes of memory: a 32nd of it, 256 MB to 1 GB (8 GB Mac: 256 MB, 16 GB:
+ * 512 MB, 32 GB and more: 1 GB). */
+static inline uint64_t virgl_gpu_guard_critical_grace(uint64_t mac)
+{
+   uint64_t g = mac / 32;
+
+   if (g < VIRGL_GPU_GUARD_CRITICAL_GRACE_MIN)
+      g = VIRGL_GPU_GUARD_CRITICAL_GRACE_MIN;
+   if (g > VIRGL_GPU_GUARD_CRITICAL_GRACE_MAX)
+      g = VIRGL_GPU_GUARD_CRITICAL_GRACE_MAX;
+   return g;
+}
+
+/* Has macOS room, at critical, for a new resource of SIZE bytes? IN_USE: all guest GPU
+ * memory now (Venus and the desktop's own included: whose a new resource is is not
+ * known yet); BASE: what was in use when critical began; GRACE: how far it may grow
+ * past that (virgl_gpu_guard_critical_grace); AVAILABLE: macOS's free, inactive and
+ * purgeable memory. Room when it fits in what macOS has left (warn's rule) and keeps
+ * the whole within BASE + GRACE: a buffer that replaces freed ones always fits, growth
+ * stops after the grace. */
+static inline bool virgl_gpu_guard_critical_room(uint64_t in_use, uint64_t size, uint64_t base,
+                                                 uint64_t grace, uint64_t available)
+{
+   uint64_t limit = base > UINT64_MAX - grace ? UINT64_MAX : base + grace;
+
+   return size <= available && virgl_gpu_guard_fits(in_use, size, limit);
+}
