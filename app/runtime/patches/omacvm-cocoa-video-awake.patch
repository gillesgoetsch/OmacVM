+
+/*
+ * OmacVM: the Mac's display stays on while a video plays in the VM and its
+ * window can be seen, as with a Mac video player (ADR 0070; rules in
+ * ui/omacvm-video-awake.h). The guest's display agent sends
+ * {"inhibit": ["Virtual-1", ...]}: the outputs showing a window whose app
+ * asks Wayland not to idle, again every 10 s, [] when it ends. QEMU then
+ * holds PreventUserIdleDisplaySleep (the display only; the Mac still sleeps
+ * when the lid closes or someone picks Sleep), while a listed output's
+ * window can be seen (the sight guest-pause uses), the VM runs and the word
+ * is under 30 s old. Released at once on [], at the lease's end, out of
+ * sight, the screen locked or asleep, another user on the console, the
+ * channel closed, the VM stopped and before the Mac sleeps; powerd's own
+ * timeout (45 s, armed again every 10 s) backs that up, and it dies with
+ * QEMU. No switch: a Mac player does the same by itself. OMACVM_VIDEO_AWAKE=0
+ * leaves it out (tests); OMACVM_TEST_VIDEO_SEEN=1 counts a hidden test
+ * window as seen and leaves the test Mac's own lock, sleep and console out
+ * (a test Mac nobody sits at is locked): org.omacvm.test.lock stands for
+ * them (OMACVM_TEST_LOCK_HOOK=1). qemu.log:
+ * each hold and release with why, at most 10 lines a minute; never a word
+ * from the guest. Main thread, but for the VM's run state (QEMU's thread).
+ */
+static OmacVMVideoAwake omacvm_va;
+static IOPMAssertionID omacvm_va_id;    /* the assertion; 0 = none */
+static bool omacvm_va_ready;            /* omacvm_va_init ran */
+static bool omacvm_va_on;
+static bool omacvm_va_test_seen;
+static bool omacvm_va_running;          /* the VM runs (QEMU's run state; atomic) */
+static unsigned omacvm_va_gen;          /* the next look's */
+
+static void omacvm_va_say(const char *what, OmacVMVaWhy why)
+{
+    static double minute;
+    static int lines;
+    double now = CACurrentMediaTime();
+
+    if (now - minute >= 60) {
+        minute = now;
+        lines = 0;
+    }
+    if (++lines <= 10) {
+        info_report("OmacVM: video awake: %s (%s)", what, omacvm_va_why_text(why));
+    } else if (lines == 11) {
+        info_report("OmacVM: video awake: more changes this minute, not logged");
+    }
+}
+
+/* Which outputs' windows can be seen: bit i = output i (0 = the main window). */
+static unsigned omacvm_va_seen(void)
+{
+    unsigned seen = 0;
+    bool mac_locked = omacvm_ds_screen_locked || omacvm_ds_asleep || omacvm_ds_away;
+
+    /* Tests: the test lock stands for the test Mac's own (OMACVM_TEST_VIDEO_SEEN). */
+    if (omacvm_ds_test_locked || (mac_locked && !omacvm_va_test_seen)) {
+        return 0;
+    }
+    for (int i = 0; i < omacvm_outputs && i < OMACVM_VA_OUTPUTS; i++) {
+        NSWindow *w = i ? omacvm_heads[i].window : [cocoaView window];
+        if (w && (omacvm_va_test_seen ||
+                  ([w isVisible] && ([w occlusionState] & NSWindowOcclusionStateVisible)))) {
+            seen |= 1u << i;
+        }
+    }
+    return seen;
+}
+
+static bool omacvm_va_create(void)
+{
+    int secs = OMACVM_VA_POWERD_S, level = kIOPMAssertionLevelOn;
+    CFNumberRef timeout = CFNumberCreate(NULL, kCFNumberIntType, &secs);
+    CFNumberRef on = CFNumberCreate(NULL, kCFNumberIntType, &level);
+    const void *keys[] = { kIOPMAssertionTypeKey, kIOPMAssertionNameKey, kIOPMAssertionLevelKey,
+                           kIOPMAssertionTimeoutKey, kIOPMAssertionTimeoutActionKey };
+    const void *values[] = { kIOPMAssertionTypePreventUserIdleDisplaySleep,
+                             CFSTR("OmacVM: the VM is playing video"), on, timeout,
+                             kIOPMAssertionTimeoutActionRelease };
+    CFDictionaryRef props = CFDictionaryCreate(NULL, keys, values, 5, &kCFTypeDictionaryKeyCallBacks,
+                                               &kCFTypeDictionaryValueCallBacks);
+    IOReturn r = IOPMAssertionCreateWithProperties(props, &omacvm_va_id);
+
+    CFRelease(props);
+    CFRelease(on);
+    CFRelease(timeout);
+    if (r != kIOReturnSuccess) {
+        omacvm_va_id = 0;
+        info_report("OmacVM: video awake: macOS refused the assertion (0x%x)", r);
+        return false;
+    }
+    return true;
+}
+
+static void omacvm_va_release(void)
+{
+    if (omacvm_va_id) {
+        IOPMAssertionRelease(omacvm_va_id);
+        omacvm_va_id = 0;
+    }
+}
+
+/* powerd's timeout again; an assertion powerd let go meanwhile (a stuck main thread) is made anew. */
+static void omacvm_va_renew(void)
+{
+    int secs = OMACVM_VA_POWERD_S;
+    CFNumberRef timeout = CFNumberCreate(NULL, kCFNumberIntType, &secs);
+    IOReturn r = omacvm_va_id ? IOPMAssertionSetProperty(omacvm_va_id, kIOPMAssertionTimeoutKey, timeout)
+                              : kIOReturnNotFound;
+
+    CFRelease(timeout);
+    if (r != kIOReturnSuccess) {
+        omacvm_va_release();
+        omacvm_va_create();
+    }
+}
+
+/* Main thread: the rules asked with the sight and run state now; a look again while it matters. */
+static void omacvm_va_update(void)
+{
+    OmacVMVaWhy why;
+    double now = CACurrentMediaTime();
+
+    if (!omacvm_va_ready) {
+        return;
+    }
+    switch (omacvm_va_decide(&omacvm_va, omacvm_va_seen(), qatomic_read(&omacvm_va_running),
+                             omacvm_va_on, now, &why)) {
+    case OMACVM_VA_HOLD:
+        if (omacvm_va_create()) {
+            omacvm_va_say("the Mac's display stays on", why);
+        }
+        break;
+    case OMACVM_VA_RELEASE:
+        omacvm_va_release();
+        omacvm_va_say("the Mac's display may sleep again", why);
+        break;
+    case OMACVM_VA_RENEW:
+        omacvm_va_renew();
+        break;
+    case OMACVM_VA_KEEP:
+        break;
+    }
+    double at = omacvm_va_look_at(&omacvm_va, now);
+    unsigned gen = ++omacvm_va_gen;
+    if (at > 0) {
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(MAX(0.0, at - now) * NSEC_PER_SEC)),
+                       dispatch_get_main_queue(), ^{
+            if (gen == omacvm_va_gen) {
+                omacvm_va_update();
+            }
+        });
+    }
+}
+
+/*
+ * The guest's "inhibit": a list of at most OMACVM_VA_MAX output names
+ * (omacvm_va_name); a line with anything else changes nothing.
+ */
+static void omacvm_va_line(id list)
+{
+    unsigned outputs = 0;
+
+    if (![list isKindOfClass:[NSArray class]] || [list count] > OMACVM_VA_MAX) {
+        return;
+    }
+    for (id n in list) {
+        if (![n isKindOfClass:[NSString class]] || [n length] > 16) {
+            return;
+        }
+        NSData *u = [n dataUsingEncoding:NSUTF8StringEncoding];
+        int i = omacvm_va_name([u bytes], [u length]);
+        if (i == -2) {
+            return;
+        }
+        if (i >= 0) {
+            outputs |= 1u << i;
+        }
+    }
+    if (!omacvm_va_ready) {
+        return;
+    }
+    omacvm_va_list(&omacvm_va, outputs, CACurrentMediaTime());
+    omacvm_va_update();
+}
+
+/* The channel closed or the Mac goes to sleep: the guest's word no longer holds. */
+static void omacvm_va_lost(OmacVMVaWhy why)
+{
+    omacvm_va_forget(&omacvm_va, why);
+    omacvm_va_update();
+}
+
+/* QEMU's thread (BQL): the VM runs or stopped (QMP stop, the Mac's sleep pause, shutdown). */
+static void omacvm_va_vm_change(void *opaque, bool running, RunState state)
+{
+    qatomic_set(&omacvm_va_running, running);
+    dispatch_async(dispatch_get_main_queue(), ^{ omacvm_va_update(); });
+}
+
+static void omacvm_va_init(void)
+{
+    const char *e = getenv("OMACVM_VIDEO_AWAKE");
+    const char *t = getenv("OMACVM_TEST_VIDEO_SEEN");
+    __block bool running = false;
+
+    omacvm_va_on = !(e && !strcmp(e, "0"));
+    omacvm_va_test_seen = t && !strcmp(t, "1");
+    with_bql(^{
+        running = runstate_is_running();
+        qemu_add_vm_change_state_handler(omacvm_va_vm_change, NULL);
+    });
+    qatomic_set(&omacvm_va_running, running);
+    [[[NSWorkspace sharedWorkspace] notificationCenter]
+        addObserverForName:NSWorkspaceWillSleepNotification
+                    object:nil
+                     queue:[NSOperationQueue mainQueue]
+                usingBlock:^(NSNotification *note) {
+        omacvm_va_lost(OMACVM_VA_WHY_SLEEP);
+    }];
+    info_report("OmacVM: video awake: %s", omacvm_va_on ?
+                "on (the Mac's display stays on while a video plays in the VM and its window can be seen)" :
+                "off (OMACVM_VIDEO_AWAKE=0)");
+    if (omacvm_va_test_seen) {
+        info_report("OmacVM: video awake: test: hidden windows count as seen, only the test lock counts "
+                    "(OMACVM_TEST_VIDEO_SEEN)");
     }
+    omacvm_va_ready = true;
+    omacvm_va_update();
 }
 
