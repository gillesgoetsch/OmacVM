+/* OMACVM_VIRGL_SELECT_CACHE=0: the legacy vertex setup leaves vbo_dirty set, so every
+ * draw selects its shaders again (as before). OMACVM_VIRGL_VERTEX_CACHE=0: every draw
+ * sets its vertex attributes and its element buffer again (as before). */
+static bool vrend_select_cache_on = true;
+static bool vrend_vertex_cache_on = true;
+
+/* OMACVM_VIRGL_CACHE_STATS=1: draws, shader selects and skipped vertex setups, logged
+ * every 10 s while drawing and when a context is destroyed. */
+static struct {
+   bool on;
+   uint64_t draws, selects, vertex_skips, element_skips;
+   uint64_t last_ns, last_draws, last_selects, last_vertex_skips, last_element_skips;
+} vrend_vertex_stats;
+
+static void vrend_vertex_state_changed(void)
+{
+   vrend_vertex_state_gen++;
+}
