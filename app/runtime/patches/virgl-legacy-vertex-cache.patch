+/* OmacVM: whether the legacy vertex setup recorded for this sub context still holds:
+ * the same program (and not one freed with its address reused: vrend_program_bind_gen),
+ * the same vertex elements, the same buffer, stride and offset behind every element,
+ * nothing outside the draw path touched the VAO (vrend_vertex_state_gen), and no
+ * attribute takes its value from buffer contents (stride 0: glVertexAttrib*fv of what
+ * the buffer holds now). Every input of the setup is in this list. */
+static bool vrend_legacy_vertex_unchanged(const struct vrend_sub_context *sub,
+                                          const struct vrend_vertex_element_array *va)
+{
+   const struct vrend_vertex_setup_record *last = &sub->last_vertex_setup;
+
+   if (!vrend_vertex_cache_on || !last->valid || last->reads_buffer_contents ||
+       last->state_gen != vrend_vertex_state_gen ||
+       last->prog_gen != vrend_program_bind_gen ||
+       last->prog != sub->prog || last->ve != sub->ve || last->count != va->count ||
+       last->enabled_mask != sub->enabled_attribs_bitmask)
+      return false;
+
+   for (unsigned i = 0; i < va->count; i++) {
+      const struct vrend_vertex_buffer *vbo = &sub->vbo[va->elements[i].base.vertex_buffer_index];
+      const struct vrend_resource *res = (const struct vrend_resource *)vbo->base.buffer;
+
+      if (last->attr[i].gl_id != (res ? res->gl_id : 0) ||
+          last->attr[i].stride != vbo->base.stride ||
+          last->attr[i].offset != vbo->base.buffer_offset)
+         return false;
+   }
+   return true;
+}
+
+static void vrend_legacy_vertex_record(struct vrend_sub_context *sub,
+                                       const struct vrend_vertex_element_array *va)
+{
+   struct vrend_vertex_setup_record *last = &sub->last_vertex_setup;
+
+   last->valid = vrend_vertex_cache_on;
+   last->reads_buffer_contents = false;
+   last->state_gen = vrend_vertex_state_gen;
+   last->prog_gen = vrend_program_bind_gen;
+   last->prog = sub->prog;
+   last->ve = sub->ve;
+   last->count = va->count;
+   last->enabled_mask = sub->enabled_attribs_bitmask;
+   for (unsigned i = 0; i < va->count; i++) {
+      const struct vrend_vertex_buffer *vbo = &sub->vbo[va->elements[i].base.vertex_buffer_index];
+      const struct vrend_resource *res = (const struct vrend_resource *)vbo->base.buffer;
+
+      last->attr[i].gl_id = res ? res->gl_id : 0;
+      last->attr[i].stride = vbo->base.stride;
+      last->attr[i].offset = vbo->base.buffer_offset;
+      if (!vbo->base.stride)
+         last->reads_buffer_contents = true;
+   }
+}
+
+/* Drops the recorded vertex setup and element buffer binding of this sub context
+ * (a GL call of the setup was refused: the VAO kept older state). */
+static void vrend_forget_vertex_setup(struct vrend_sub_context *sub)
+{
+   sub->last_vertex_setup.valid = false;
+   sub->element_buffer_gen = 0;
+}
