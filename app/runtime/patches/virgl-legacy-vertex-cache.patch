+              (unsigned long long)vrend_vertex_stats.selects,
+              (unsigned long long)vrend_vertex_stats.vertex_skips,
+              (unsigned long long)vrend_vertex_stats.element_skips);
+   vrend_vertex_stats.last_ns = now;
+   vrend_vertex_stats.last_draws = vrend_vertex_stats.draws;
+   vrend_vertex_stats.last_selects = vrend_vertex_stats.selects;
+   vrend_vertex_stats.last_vertex_skips = vrend_vertex_stats.vertex_skips;
