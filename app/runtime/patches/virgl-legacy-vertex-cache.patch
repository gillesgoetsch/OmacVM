+/* Binds the draw's element buffer to this sub context's VAO, unless it already is.
+ * Only on the legacy path: there each sub context has one VAO (vaoid), while the
+ * vertex attrib binding path binds a VAO per vertex elements object. */
+static void vrend_bind_element_buffer(struct vrend_sub_context *sub, GLuint id)
+{
+   if (vrend_vertex_cache_on && !has_feature(feat_gles31_vertex_attrib_binding) &&
+       sub->element_buffer_gen == vrend_vertex_state_gen && sub->element_buffer_id == id) {
+      vrend_vertex_stats.element_skips++;
+      return;
+   }
+   glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, id);
+   sub->element_buffer_gen = vrend_vertex_state_gen;
+   sub->element_buffer_id = id;
+}
