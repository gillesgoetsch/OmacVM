+/* OmacVM: what vrend_fill_shader_key() takes from a bound sampler view (an emulated
+ * rectangle, a buffer's swizzle lowering). Shadow and integer sampling come from the
+ * shader's own declarations, not from the view. */
+static uint32_t vrend_view_key_bits(struct vrend_sampler_view *view)
+{
+   enum pipe_swizzle swizzle[4];
+   uint32_t bits = 0;
+
+   if (!view || !view->texture)
+      return 0;
+   if (view->emulated_rect)
+      bits |= 1u << 0;
+   if (view->texture->target == GL_TEXTURE_BUFFER && vrend_get_swizzle(view, swizzle))
+      bits |= 1u << 1 | swizzle[0] << 2 | swizzle[1] << 5 | swizzle[2] << 8 | swizzle[3] << 11;
+   return bits;
+}
