+/* A buffer bound to its own target outside the draw path: for an index buffer
+ * (GL_ELEMENT_ARRAY_BUFFER) that changes the bound VAO's element buffer. */
+static void vrend_buffer_target_bound(GLenum target)
+{
+   if (target == GL_ELEMENT_ARRAY_BUFFER)
+      vrend_vertex_state_changed();
+}
