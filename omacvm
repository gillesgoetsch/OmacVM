#!/bin/bash
# OmacVM: Omarchy in a VM on your Mac, feeling native.
#
#   omacvm                       asks what you want to do: build a VM, change
#                                its features, update, check
#   omacvm build                 a new Omarchy VM in Parallels, UTM, VMware Fusion or OmacVM.app, from nothing
#   omacvm features [--vm NAME]  a VM's features: see them, switch them
#                                (--in-vm: open the control centre on the VM's desktop)
#   omacvm enable FEATURE...     switch features on (omacvm enable scroll-momentum)
#   omacvm disable FEATURE...    ... or off
#   omacvm resources --vm NAME   a VM's CPUs and memory: see them, change them
#   omacvm graphics --vm NAME    an OmacVM.app VM's graphics: OpenGL, Vulkan or Automatic
#   omacvm apply [--vm NAME]     OmacVM onto a VM, also one installed by hand
#   omacvm update                this checkout, the Mac side and your VMs
#   omacvm check [--vm NAME]     is everything working, on the Mac and in the VM
#   omacvm vms                   your VMs and their OmacVM state
#   omacvm report [--vm NAME]    report a problem: what goes into the GitHub issue,
#                                without personal data, shown before it opens
#   omacvm uninstall [--purge]   OmacVM off this Mac (your VMs stay as they are)
#   omacvm help COMMAND          the options of a command (or COMMAND --help)
#   omacvm --version
#
# For scripts and coding agents: --json on vms, features, check, resources, graphics and build
# --plan; --yes (or no terminal) never asks; exit codes 0 done, 1 failed,
# 2 usage, 3 needs a person, 4 failed and rolled back (--transaction). See AGENTS.md.
set -euo pipefail
# A job from the control centre (OmacVM Bridge, src/bridge/mac/control.swift):
# the exit code goes to this file, also when an update restarts the Bridge
# that started it.
if [[ -n ${OMACVM_JOB_STATUS:-} ]]; then
  st=$OMACVM_JOB_STATUS; unset OMACVM_JOB_STATUS
  rc=0; "$0" "$@" || rc=$?
  echo "$rc" > "$st"
  exit "$rc"
fi
# The checkout, also when omacvm is called through a symlink on the PATH.
src=$0
while [[ -L $src ]]; do
  l=$(readlink "$src"); [[ $l == /* ]] && src=$l || src=$(dirname "$src")/$l
done
R=$(cd "$(dirname "$src")" && pwd)
C=$R/src/cmd
cmd=${1:-}; [[ $# -gt 0 ]] && shift
# OmacVM.app's own copy (Contents/Resources/omacvm, what the Bridge runs for
# the control centre when there is no checkout): the app's signed helpers and
# runtime, and commands that change things run from a copy, as the app's
# apply-vm.sh does, so nothing is ever written inside the signed app.
if [[ $R == */Contents/Resources/omacvm && -f $R/COMMIT && -z ${OMACVM_APP_COPY:-} ]]; then
  app=${R%/Resources/omacvm}
  export OMACVM_APP_CLI=$R/omacvm OMACVM_HELPERS=$app/Helpers OMACVM_APP_RUNTIME=$app/Resources/runtime
  case $cmd in
    build|apply|update|enable|disable|uninstall|features)
      if [[ $cmd != features || " $* " != *" --json "* ]]; then
        tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
        cp -R "$R" "$tmp/omacvm"
        rc=0; OMACVM_APP_COPY=1 "$tmp/omacvm/omacvm" "$cmd" "$@" || rc=$?
        exit "$rc"
      fi ;;
  esac
fi
case $cmd in
  "") exec "$C/home.sh" ;;
  build|apply|check|vms|update|resources|graphics) exec "$C/$cmd.sh" "$@" ;;
  features|enable|disable) exec "$C/features.sh" "$cmd" "$@" ;;
  uninstall) exec "$R/src/mac/uninstall.sh" "$@" ;;
  report) exec "$C/report.sh" "$@" ;;
  --version|-v|version) echo "OmacVM $(cat "$R/src/VERSION")"; exit 0 ;;
  help|-h|--help)
    case ${1:-} in
      "") sed -n '2,25s/^# \{0,1\}//p' "$0" ;;
      features|enable|disable) exec "$C/features.sh" "$1" --help ;;
      build|apply|check|vms|update|resources|graphics) exec "$C/$1.sh" --help ;;
      uninstall) exec "$R/src/mac/uninstall.sh" --help ;;
      report) exec "$C/report.sh" --help ;;
      *) echo "omacvm help: no command '$1'" >&2; exit 2 ;;
    esac ;;
  *) echo "omacvm: no command '$cmd' (omacvm help)" >&2; exit 2 ;;
esac
