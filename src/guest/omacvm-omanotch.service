[Unit]
Description=OmacVM: install Omanotch's VM side at the first login (feature omanotch)
After=graphical-session.target omacvm-plugins.service
PartOf=graphical-session.target
ConditionPathExists=/usr/local/share/omacvm/omanotch/guest/install.sh
# Missing, or left empty by an install that did not finish.
ConditionFileNotEmpty=!%h/.local/bin/notchcast

[Service]
Type=oneshot
# Omanotch's installer needs the running session and Omarchy's commands.
ExecStartPre=/bin/sleep 5
# notchcast's old unit may have hit its start limit while notchcast was missing.
ExecStartPre=-/usr/bin/systemctl --user reset-failed notchcast.service
ExecStart=/bin/bash -c 'source /usr/share/omarchy/default/bash/env-bootstrap; exec bash /usr/local/share/omacvm/omanotch/guest/install.sh'

[Install]
WantedBy=graphical-session.target
