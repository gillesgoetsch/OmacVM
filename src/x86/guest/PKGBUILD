# box64 for the x86-apps feature: runs x86_64 Linux programs on the VM's ARM
# CPU (it translates them; system libraries like glibc, GTK, X11, Wayland and
# OpenGL stay the VM's own, native). Arch Linux ARM has no box64 package, so
# OmacVM builds this one in the VM (install.sh here) and installs it with
# pacman: `pacman -R omacvm-box64` removes all of it. Not named box64: the AUR
# has a box64, and Omarchy's update (yay -Sua) would swap ours for it.
# Generic ARM64 build (not upstream's M1 profile: that one is for Asahi's
# 16 KiB pages; Omarchy's kernel uses 4 KiB). The binfmt rule goes to
# /usr/lib/binfmt.d, so systemd's pacman hook registers it; x86_64 programs
# and AppImages then start like native ones. Upstream's x86 library bundle
# (x86_64 part only) adds libraries box64 does not replace with the VM's own.
# A commit after 0.4.4: in 0.4.4 x86_64 programs with threads (Node.js,
# Electron) never exit (fixed by "thread cleanups" and exit_group, 2026-09-28).
pkgname=omacvm-box64
_tag=0.4.4
_commit=2558cfa20b76b4b54630643b66df5aa7cfc13300   # main, 2026-09-30
pkgver=$_tag.r347.g${_commit::7}
pkgrel=1
pkgdesc="Linux userspace x86_64 emulator (built by OmacVM for its x86-apps feature)"
arch=(aarch64)
url="https://github.com/ptitSeb/box64"
license=(MIT)
provides=("box64=$pkgver")
conflicts=(box64)
depends=(glibc gcc-libs fuse2)   # fuse2: AppImages mount themselves through it
makedepends=(cmake python)
backup=(etc/box64.box64rc)
options=(!debug !strip)
source=("box64-$_commit.tar.gz::https://github.com/ptitSeb/box64/archive/$_commit.tar.gz"
        "https://github.com/ptitSeb/box64/releases/download/v$_tag/box64-bundle-x86-libs-v$_tag.tar.gz")
noextract=("box64-bundle-x86-libs-v$_tag.tar.gz")
sha256sums=('4d836ccb3cca54c1c4a208baac9497013129304b06d339262f0fe429f66ae5cb'
            '1d4a8787a8a92267c1be673ec194c69e3bb33d14c800575d94131084142fcff0')

build() {
  cmake -S "box64-$_commit" -B build \
    -D CMAKE_BUILD_TYPE=RelWithDebInfo -D CMAKE_INSTALL_PREFIX=/usr \
    -D ARM64=ON -D ARM_DYNAREC=ON -D NOGIT=ON
  # One job per GB of free memory, at most one per core: 4 GB VMs build with the desktop open.
  local jobs mem
  jobs=$(nproc)
  mem=$(awk '/^MemAvailable:/ { print int($2 / 1048576) }' /proc/meminfo)
  if (( mem < jobs )); then jobs=$(( mem > 1 ? mem : 1 )); fi
  cmake --build build -j "$jobs"
}

package() {
  # The bundle first: box64's own copies of the same libraries win.
  rm -rf bundle; mkdir bundle
  bsdtar -xf "box64-bundle-x86-libs-v$_tag.tar.gz" -C bundle
  install -d "$pkgdir/usr/lib"
  cp -a bundle/usr/lib/box64-x86_64-linux-gnu "$pkgdir/usr/lib/"
  DESTDIR="$pkgdir" cmake --install build
  # Arch's place for packaged binfmt rules (/etc is the admin's).
  install -d "$pkgdir/usr/lib/binfmt.d"
  mv "$pkgdir/etc/binfmt.d/box64.conf" "$pkgdir/usr/lib/binfmt.d/box64.conf"
  rmdir "$pkgdir/etc/binfmt.d"
  # Chromium-based apps (Electron AppImages) bring their own memory allocator
  # and crash or hang without box64's malloc hack; box64 sets it only for the
  # apps it knows by name. For every program here (an app's own entry still
  # wins): Obsidian then opens; 7-Zip, ripgrep and Node.js run as fast as without.
  { printf '%s\n' '# OmacVM: for every program (Electron apps need it).' '[*]' 'BOX64_MALLOC_HACK=2' ''
    cat "$pkgdir/etc/box64.box64rc"; } > box64rc && install -m644 box64rc "$pkgdir/etc/box64.box64rc"
  # Its settings app needs PyQt, which Omarchy does not have: no menu entry that cannot start.
  rm -f "$pkgdir/usr/bin/box64-configurator" "$pkgdir/usr/share/applications/box64-configurator.desktop"
  rmdir --ignore-fail-on-non-empty "$pkgdir/usr/share/applications" 2>/dev/null || true
  strip --strip-debug "$pkgdir/usr/bin/box64"   # keeps its symbols; the x86 libraries are left as they are (!strip)
  install -Dm644 "box64-$_commit/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname"
  # The rule must point at the installed box64.
  grep -q ':/usr/bin/box64:$' "$pkgdir/usr/lib/binfmt.d/box64.conf" ||
    { echo "box64: unexpected binfmt rule: $(cat "$pkgdir/usr/lib/binfmt.d/box64.conf")" >&2; return 1; }
}
