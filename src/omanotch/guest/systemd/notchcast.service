[Unit]
Description=Omanotch: stream the Omarchy bar to the macOS notch helper
Documentation=https://github.com/gillesgoetsch/omacvm/tree/main/src/omanotch
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=%h/.local/bin/notchcast
Restart=always
RestartSec=2
# Belt and braces: never leave the guest cursor hidden.
ExecStopPost=-/usr/bin/hyprctl eval "hl.config({ cursor = { invisible = false } })"
# ... and bring the bar back right away instead of after the bar's watchdog.
ExecStopPost=-/usr/bin/qs ipc -n -p /usr/share/omarchy/shell call notchbar setParked false
# Turned off (not a session that ends): the next login must not start with
# the bar parked for a strip that will not come (see the bar patch, expect).
# (The link, not systemctl: no manager call while the session goes down.)
ExecStopPost=-/bin/sh -c '[ -e "$$HOME/.config/systemd/user/graphical-session.target.wants/notchcast.service" ] || rm -f "$${XDG_STATE_HOME:-$$HOME/.local/state}/omanotch/expect"'

[Install]
WantedBy=graphical-session.target
