[Unit]
Description=Omanotch: stream the Omarchy bar to the macOS notch helper
Documentation=https://github.com/gillesgoetsch/omacvm/tree/main/src/omanotch
After=graphical-session.target
PartOf=graphical-session.target
# Not built yet (an update builds it again at the next login): skip, do not
# crash-loop into systemd's start limit before the installer is done.
ConditionFileIsExecutable=%h/.local/bin/notchcast
# Room for an install's restart plus a config reload; still stops a real loop.
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
# OmacVM.app's FullPanel start (#339): the VM's full screen covers the strip
# and the bar sits in it itself, so there is nothing to stream; skipped (not
# failed) for that boot, back by itself at the next native start.
ExecCondition=/bin/sh -c '! grep -qs "^OMACVM_FULLPANEL=" /run/omacvm/host.env'
ExecStart=%h/.local/bin/notchcast
Restart=on-failure
RestartSec=2
# The display panel without NOTCH, built again when an Omarchy update changed it.
ExecStartPost=-%h/.local/bin/omanotch-display-panel --refresh
# Belt and braces: never leave the guest cursor hidden.
ExecStopPost=-/usr/bin/hyprctl eval "hl.config({ cursor = { invisible = false } })"
# ... and bring the bar back right away instead of after the bar's watchdog.
ExecStopPost=-/usr/bin/qs ipc -n -p /usr/share/omarchy/shell call notchbar setParked false
# Turned off (not a session that ends): the next login must not start with
# the bar parked for a strip that will not come (see the bar patch, expect).
# (The link, not systemctl: no manager call while the session goes down.)
ExecStopPost=-/bin/sh -c '[ -e "$$HOME/.config/systemd/user/graphical-session.target.wants/notchcast.service" ] || rm -f "$${XDG_STATE_HOME:-$$HOME/.local/state}/omanotch/expect"'

[Install]
WantedBy=graphical-session.target
