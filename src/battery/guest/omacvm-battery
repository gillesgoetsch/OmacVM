#!/usr/bin/python3
"""omacvm-battery: the Mac's battery in the VM (root, omacvm-battery.service).

Takes the Mac's battery snapshots and writes each one, as one line, to the
omacvm-battery kernel module, which shows them as BAT0 and ADP0 (UPower, and
so Omarchy's bar, read those). Where the snapshots come from:

  OmacVM.app      the virtio port org.omacvm.battery (the app's own bridge);
                  this agent asks once for a fresh one when it starts

A snapshot (JSON):
  {"present": true, "percentage": 57, "state": "discharging",
   "acConnected": false, "timeToEmptySeconds": 8100, "timeToFullSeconds": null,
   "chargeLimit": 80, "chargeNowMicroAh": ..., "chargeFullMicroAh": ...,
   "chargeFullDesignMicroAh": ..., "voltageMicroV": ..., "cycleCount": 213,
   "currentMicroA": -573000, "powerMicroW": 7183701}
currentMicroA is signed (below 0: the battery gives power). It and
powerMicroW come from Macs with OmacVM 3.0.6 or newer; older ones leave them
out. Other keys are ignored. Nothing goes back to the Mac but the refresh
request.

From try-omarchy (github.com/omacom/try-omarchy), MIT, (c) Try Omarchy
contributors: guest/native-overlay/usr/local/bin/omarchy-native-battery-bridge.
"""

from __future__ import annotations

import json
import sys
import time
from pathlib import Path
from typing import Any

PORT = Path("/dev/virtio-ports/org.omacvm.battery")
STATE_FILE = Path("/sys/devices/platform/omacvm-battery/state")
ENV_FILE = Path("/etc/omacvm/env")
STATES = ("charging", "discharging", "full", "not-charging", "unknown")
MAX_LINE_BYTES = 4096
REFRESH_LINE = b'{"type":"refresh","chargeLimit":true,"batteryDetails":true}\n'
# The module's own version (MODULE_VERSION): current_now and power_now go only
# to 1.1.0 or newer. An older module rejects a line with a word it does not
# know, whole, and the battery would stay as it was until the next boot.
MODULE_VERSION = Path("/sys/module/omacvm_battery/version")
RATE_SINCE = (1, 1, 0)
INT32_MAX = 2147483647
DETAIL_FIELDS = {
    "chargeNowMicroAh": "charge_now",
    "chargeFullMicroAh": "charge_full",
    "chargeFullDesignMicroAh": "charge_full_design",
    "voltageMicroV": "voltage_now",
    "cycleCount": "cycle_count",
}


def log(message: str) -> None:
    print(f"omacvm-battery: {message}", file=sys.stderr, flush=True)


def is_int(value: Any) -> bool:
    return isinstance(value, int) and not isinstance(value, bool)


def decode(message: Any) -> dict[str, Any]:
    """A checked snapshot, or ValueError."""
    if not isinstance(message, dict):
        raise ValueError("not a JSON object")
    if message.get("type", "state") != "state":
        raise ValueError("not a battery state")
    present, ac = message.get("present"), message.get("acConnected")
    if not isinstance(present, bool) or not isinstance(ac, bool):
        raise ValueError("present and acConnected must be true or false")
    if message.get("state") not in STATES:
        raise ValueError("unknown battery state")
    percentage = message.get("percentage")
    if present and not (is_int(percentage) and 0 <= percentage <= 100):
        raise ValueError("percentage must be 0-100")
    out = {"present": present, "acConnected": ac, "state": message["state"],
           "percentage": percentage if present else None}
    for key in ("timeToEmptySeconds", "timeToFullSeconds"):
        value = message.get(key)
        out[key] = value if is_int(value) and value >= 0 else None
    limit = message.get("chargeLimit")
    out["chargeLimit"] = limit if present and is_int(limit) and 1 <= limit <= 99 else None
    for key in DETAIL_FIELDS:
        value = message.get(key)
        minimum = 0 if key in ("chargeNowMicroAh", "cycleCount") else 1
        out[key] = value if present and is_int(value) and minimum <= value <= INT32_MAX else None
    current, power = message.get("currentMicroA"), message.get("powerMicroW")
    out["currentMicroA"] = current if present and is_int(current) and -INT32_MAX <= current <= INT32_MAX else None
    out["powerMicroW"] = power if present and is_int(power) and 0 <= power <= INT32_MAX else None
    return out


def module_has_rate() -> bool:
    """Whether the loaded module takes current_now and power_now."""
    try:
        parts = MODULE_VERSION.read_text().strip().split(".")
        return tuple(int(p) for p in parts[:3]) >= RATE_SINCE
    except (OSError, ValueError):
        return False


def state_line(s: dict[str, Any], rate: bool = False) -> bytes:
    """One whole snapshot for the kernel module. rate: the module takes
    current_now and power_now (left out when not known: the module then has
    none)."""
    ac = 1 if s["acConnected"] else 0
    if not s["present"]:
        return f"present=0 ac={ac}\n".encode()
    def n(v: Any) -> Any:
        return -1 if v is None else v
    details = " ".join(f"{field}={n(s[key])}" for key, field in DETAIL_FIELDS.items())
    if rate:
        details += "".join(f" {field}={s[key]}" for key, field in
                           (("currentMicroA", "current_now"), ("powerMicroW", "power_now"))
                           if s.get(key) is not None)
    return (f"present=1 status={s['state']} capacity={s['percentage']} ac={ac} "
            f"time_to_empty={n(s['timeToEmptySeconds'])} time_to_full={n(s['timeToFullSeconds'])} "
            f"charge_limit={n(s['chargeLimit'])} {details}\n").encode()


def unknown_line(last: dict[str, Any] | None) -> bytes:
    """The Mac is gone: keep the battery, drop what is no longer known."""
    if last is None or not last["present"]:
        return f"present=0 ac={1 if last is None or last['acConnected'] else 0}\n".encode()
    return (f"present=1 status=unknown capacity={last['percentage']} "
            f"ac={1 if last['acConnected'] else 0} time_to_empty=-1 time_to_full=-1 charge_limit=-1 "
            + " ".join(f"{field}=-1" for field in DETAIL_FIELDS.values()) + "\n").encode()


def write_state(line: bytes) -> None:
    STATE_FILE.write_bytes(line)


class Feeder:
    def __init__(self) -> None:
        self.last: dict[str, Any] | None = None

    def line(self, raw: bytes) -> None:
        try:
            snapshot = decode(json.loads(raw))
        except ValueError as error:   # JSONDecodeError is one too
            log(f"rejected a snapshot: {error}")
            return
        if snapshot != self.last:
            write_state(state_line(snapshot, module_has_rate()))
            self.last = snapshot

    def gone(self) -> None:
        try:
            write_state(unknown_line(self.last))
        except OSError as error:
            log(f"could not mark the battery unknown: {error}")


def from_port(feeder: Feeder) -> int:
    """OmacVM.app: newline-separated snapshots on the virtio port."""
    with PORT.open("r+b", buffering=0) as port:
        port.write(REFRESH_LINE)
        buffer = b""
        while True:
            chunk = port.read(4096)
            if not chunk:
                return 1
            buffer += chunk
            while b"\n" in buffer:
                raw, buffer = buffer.split(b"\n", 1)
                if raw:
                    feeder.line(raw)
            if len(buffer) > MAX_LINE_BYTES:
                log("a line from the app is too long")
                return 1


def env_value(text: str, key: str) -> str:
    value = ""
    for line in text.splitlines():
        if line.startswith(key + "="):
            value = line[len(key) + 1:]
    return value


def main() -> int:
    if not STATE_FILE.exists():
        log("the omacvm-battery module is not loaded")
        return 1
    vm_type = env_value(ENV_FILE.read_text(), "OMACVM_VM_TYPE") if ENV_FILE.exists() else ""
    feeder = Feeder()
    if vm_type == "app":
        for _ in range(30):   # udev names the port a moment after boot
            if PORT.exists():
                break
            time.sleep(0.5)
        if not PORT.exists():
            # An OmacVM.app from before the battery: nothing to wait for.
            log(f"no {PORT}: this OmacVM.app does not pass the battery (omacvm update)")
            return 0
        try:
            rc = from_port(feeder)
        except OSError as error:
            log(f"the battery port failed: {error}")
            rc = 1
    else:
        log(f"nothing to do on a {vm_type or 'unknown'} VM")
        return 0
    feeder.gone()
    log("the Mac's battery is gone for now")
    return rc


if __name__ == "__main__":
    sys.exit(main())
