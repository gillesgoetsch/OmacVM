def log(message: str) -> None:
    print(f"omacvm-displays: {message}", file=sys.stderr, flush=True)


def config_flag(name: str) -> bool:
    """A displays.conf switch; on when missing."""
    try:
        for line in CONFIG.read_text().splitlines():
            key, _, value = line.partition("=")
            if key.strip() == name:
                return value.strip().lower() not in ("off", "0", "no", "false")
    except OSError:
        pass
    return True


def external_on() -> bool:
    return config_flag("external")


def set_external(on: bool) -> None:
    CONFIG.parent.mkdir(parents=True, exist_ok=True)
    tmp = CONFIG.with_suffix(".tmp")
    tmp.write_text(f"external={'on' if on else 'off'}\n")
    tmp.replace(CONFIG)


def config_mtime() -> float:
    try:
        return CONFIG.stat().st_mtime
    except OSError:
        return 0.0


def wanted_scale() -> float | None:
    """Omarchy's scale for the main output (omarchy_monitor_scale in
    monitors.lua, which its scale buttons write); None for automatic."""
    try:
        m = re.search(r"^\s*local\s+omarchy_monitor_scale\s*=\s*([0-9]+(?:\.[0-9]+)?)\s*(?:--[^\n]*)?$",
                      MONITORS_LUA.read_text(), re.MULTILINE)
    except OSError:
        return None
    if not m:
        return None
    value = float(m.group(1))
    return round(value, 6) if 1 <= value <= 4 else None


def fullpanel_output() -> str | None:
    """The output in "Full screen including notch" this start (the app's
    SMBIOS line omacvm.fullpanel in host.env), else None."""
    try:
        if not any(line.startswith("OMACVM_FULLPANEL=") for line in HOST_ENV.read_text().splitlines()):
            return None
    except OSError:
        return None
    try:
        return BUILTIN.read_text().strip() or "Virtual-1"
    except OSError:
        return "Virtual-1"


def scale_fits(width: int, height: int, scale: float) -> bool:
    """Hyprland takes the scale as it is (whole logical pixels, 1/120 steps)."""
    k = round(scale * 120)
    return k > 0 and (width * 120) % k == 0 and (height * 120) % k == 0


def focused_monitor() -> dict | None:
    data = hypr_json("j/monitors")
    for m in data if isinstance(data, list) else []:
        if isinstance(m, dict) and m.get("focused"):
            return m
    return None


def set_scale(value: str, wait: float = SCALE_WAIT) -> int:
    """A scale button of the display panel. In "Full screen including notch"
    on that output the Mac first gives the output a size the scale fits (the
    agent passes it on). Secondary outputs keep their own zoom; the main
    output still uses Omarchy's command; named secondary rules are refused."""
    try:
        scale = float(value)
    except ValueError:
        scale = 0.0
    focused = focused_monitor() if scale >= 1 else None
    name = focused.get("name", "") if focused else ""
    secondary = bool(re.fullmatch(r"Virtual-[1-9][0-9]*", name)) and name != "Virtual-1"
    # The panel labels effective scales; a 4x preset may round up past 4.
    clean_secondary = (secondary and 4 < scale <= min(focused.get("width", 0), focused.get("height", 0))
                       and scale_fits(focused["width"], focused["height"], scale))
    if not (1 <= scale <= 4 or clean_secondary):
        print("usage: omacvm-displays scale SCALE (1 to 4, or a clean external scale)", file=sys.stderr)
        return 2
    if secondary:
        try:
            config = re.sub(r"--[^\n]*", "", MONITORS_LUA.read_text())
        except OSError:
            config = ""
        if re.search(r"output\s*=\s*[\"']" + re.escape(name) + r"[\"']", config):
            print(f"Refusing scale for {name}: edit its named monitor rule in {MONITORS_LUA}, "
                  "or remove that rule to use automatic sizing and independent zoom.", file=sys.stderr)
            return 2
    out = fullpanel_output()
    if out and focused and focused.get("name") == out:
        poke(message=f"scale {scale:g}\n".encode())
        end = time.monotonic() + wait
        while time.monotonic() < end:
            m = focused_monitor()
            if m and scale_fits(int(m.get("width", 0)), int(m.get("height", 0)), scale):
                break
            time.sleep(0.1)
        else:
            log(f"scale {scale:g}: the Mac gave {out} no size that fits it (older OmacVM.app?): Omarchy's nearest")
    if secondary:
        # Omarchy persists a global scale even when it changed an external
        # output. Keep that choice separately: no fixed mode, no change to
        # the main display or the other outputs' density defaults.
        import tempfile
        folder = CONFIG.parent / "scales"
        folder.mkdir(parents=True, exist_ok=True)
        with tempfile.NamedTemporaryFile(mode="w", dir=folder, delete=False) as f:
            f.write(f"{scale:g}\n")
        Path(f.name).replace(folder / name)
        return subprocess.call([SYNC, "--once"])
    return subprocess.call(["omarchy-hyprland-monitor-scaling", value])


class ConfigWatch:
    """Wakes the agent when displays.conf changes: inotify on its folder (a
    write, a rename onto it, a delete). Not available (no inotify, the folder
    cannot be watched): ok is False and the agent looks once a second."""

    IN_MODIFY, IN_CLOSE_WRITE, IN_MOVED_FROM, IN_MOVED_TO = 0x2, 0x8, 0x40, 0x80
    IN_CREATE, IN_DELETE, IN_DELETE_SELF, IN_MOVE_SELF = 0x100, 0x200, 0x400, 0x800
    IN_IGNORED = 0x8000
    IN_CLOEXEC, IN_NONBLOCK = 0o2000000, 0o4000
    MASK = (IN_MODIFY | IN_CLOSE_WRITE | IN_MOVED_FROM | IN_MOVED_TO | IN_CREATE | IN_DELETE
            | IN_DELETE_SELF | IN_MOVE_SELF)
    EVENT = struct.Struct("iIII")   # wd, mask, cookie, len (then the name)

    def __init__(self, folder: Path) -> None:
        self.fd = -1
        try:
            folder.mkdir(parents=True, exist_ok=True)
            libc = ctypes.CDLL(None, use_errno=True)
            fd = libc.inotify_init1(self.IN_NONBLOCK | self.IN_CLOEXEC)
            if fd < 0:
                return
            if libc.inotify_add_watch(fd, os.fsencode(folder), self.MASK) < 0:
                os.close(fd)
                return
            self.fd = fd
        except (OSError, AttributeError):
            pass

    @property
    def ok(self) -> bool:
        return self.fd >= 0

    def fileno(self) -> int:
        return self.fd

    def drain(self) -> None:
        """Reads the pending events. The folder gone or moved: the watch
        ends (ok turns False) and the agent falls back to looking."""
        gone = False
        while self.fd >= 0:
            try:
                data = os.read(self.fd, 4096)
            except BlockingIOError:
                break
            except OSError:
                gone = True
                break
            if not data:
                break
            offset = 0
            while offset + self.EVENT.size <= len(data):
                _, mask, _, size = self.EVENT.unpack_from(data, offset)
                if mask & (self.IN_IGNORED | self.IN_DELETE_SELF | self.IN_MOVE_SELF):
                    gone = True
                offset += self.EVENT.size + size
        if gone:
            self.close()

    def close(self) -> None:
        if self.fd >= 0:
            os.close(self.fd)
            self.fd = -1


def hypr_dir() -> Path | None:
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    base = RUNTIME / "hypr"
    if sig and (base / sig).is_dir():
        return base / sig
    try:
        dirs = [d for d in base.iterdir() if (d / ".socket.sock").exists()]
    except OSError:
        return None
    return max(dirs, key=lambda d: d.stat().st_mtime) if dirs else None


def hypr_request(command: str) -> str | None:
    d = hypr_dir()
    if not d:
        return None
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(2)
            s.connect(str(d / ".socket.sock"))
            s.sendall(command.encode())
            chunks = []
            while True:
                chunk = s.recv(65536)
                if not chunk:
                    break
                chunks.append(chunk)
        return b"".join(chunks).decode(errors="replace")
    except OSError:
        return None


def hypr_json(command: str):
    reply = hypr_request(command)
    if reply is None:
        return None
    try:
        return json.loads(reply)
    except ValueError:
        return None


def logical_monitors(data) -> list[dict]:
    """Enabled outputs from j/monitors, in logical pixels."""
    out = []
    for m in data if isinstance(data, list) else []:
        if not isinstance(m, dict) or m.get("disabled"):
            continue
        try:
            scale = float(m.get("scale") or 1) or 1.0
            w, h = m.get("width", 0) / scale, m.get("height", 0) / scale
        except (TypeError, ValueError):
            continue
        if m.get("transform", 0) % 2:
            w, h = h, w
        out.append({"name": m.get("name", ""), "x": m.get("x", 0), "y": m.get("y", 0),
                    "width": round(w, 3), "height": round(h, 3)})
    return sorted(out, key=lambda m: m["name"])


def monitors() -> list[dict] | None:
    """Hyprland's outputs in logical pixels, as its absolute pointer sees them."""
    data = hypr_json("j/monitors")
    return None if data is None else logical_monitors(data)


WALLPAPER = "omarchy-background"
HYPR_GREY = (0x11, 0x11, 0x11)   # Hyprland's default misc:background_color


def misplaced_wallpapers(monitors_data, layers_data) -> list[str]:
    """Mac displays (Virtual-N) whose wallpaper layer is not where they are.

    monitors_data is Hyprland's j/monitors, layers_data its j/layers (layer
    boxes in the same global logical coordinates). Nothing is reported while
    the shell has no wallpaper layer at all (not running yet, or no Omarchy
    shell), for an output without one, or for outputs that mirror another.
    """
    if not isinstance(layers_data, dict):
        return []
    boxes: dict[str, list[tuple]] = {}
    for name, entry in layers_data.items():
        levels = entry.get("levels") if isinstance(entry, dict) else None
        for level in (levels.values() if isinstance(levels, dict) else []):
            for layer in level if isinstance(level, list) else []:
                if isinstance(layer, dict) and layer.get("namespace") == WALLPAPER:
                    boxes.setdefault(name, []).append(
                        tuple(layer.get(k, 0) for k in ("x", "y", "w", "h")))
    if not boxes:
        return []
    mirrors = {m.get("name") for m in monitors_data if isinstance(m, dict)
               and m.get("mirrorOf") not in (None, "", "none")} if isinstance(monitors_data, list) else set()
    problems = []
    for m in logical_monitors(monitors_data):
        name = m["name"]
        if not re.fullmatch(r"Virtual-[0-9]+", name) or name in mirrors:
            continue
        want = (m["x"], m["y"], m["width"], m["height"])
        have = boxes.get(name, [])
        # No wallpaper layer at all is left alone: the shell may be making it,
        # or have it unmapped on purpose (a remap, the lock screen).
        # Rounding at fractional scales: a pixel or two either way.
        if not have or any(all(abs(float(a) - float(b)) <= 2 for a, b in zip(box, want))
                           for box in have):
            continue
        where = ", ".join(f"{b[0]},{b[1]} {b[2]}x{b[3]}" for b in have)
        problems.append(f"{name}: wallpaper at {where}, display at "
                        f"{want[0]},{want[1]} {round(want[2])}x{round(want[3])}")
    return problems


def background_colour(option) -> tuple[int, int, int]:
    """Hyprland's misc:background_color (j/getoption) as RGB."""
    try:
        value = int(option.get("int")) if isinstance(option, dict) else None
    except (TypeError, ValueError):
        value = None
    if value is None:
        return HYPR_GREY
    return ((value >> 16) & 255, (value >> 8) & 255, value & 255)


def desktop_outputs(monitors_data, workspaces_data, layers_data) -> list[str]:
    """Mac displays (Virtual-N) that should show the bare desktop now.

    Enabled, not mirroring another, with a wallpaper layer of the shell, and
    no window on the active workspace (nor a special workspace shown). Any
    other display may rightly show something dark.
    """
    if not isinstance(monitors_data, list) or not isinstance(layers_data, dict):
        return []
    # Hyprland 0.57 gives no id for a named or special workspace (0.56 a negative one): those by their name.
    def key(w):
        return w.get("id") if w.get("id") is not None else ("name", w.get("name"))
    windows = {key(w): w.get("windows", 0) for w in workspaces_data
               if isinstance(w, dict)} if isinstance(workspaces_data, list) else {}
    out = []
    for m in monitors_data:
        if not isinstance(m, dict) or m.get("disabled"):
            continue
        name = m.get("name", "")
        if not re.fullmatch(r"Virtual-[0-9]+", name):
            continue
        if m.get("mirrorOf") not in (None, "", "none") or m.get("dpmsStatus") is False:
            continue
        # a special workspace shown: 0.56 says its id (0 with none), 0.57 its name and address ("" with none)
        special = m.get("specialWorkspace")
        if isinstance(special, dict) and (special.get("id") or special.get("name") or special.get("address")):
            continue
        active = m.get("activeWorkspace")
        wid = key(active) if isinstance(active, dict) else None
        if wid in (None, ("name", None), ("name", "")) or windows.get(wid, 1) != 0:
            continue
        levels = layers_data.get(name, {}).get("levels") if isinstance(layers_data.get(name), dict) else None
        if not any(isinstance(layer, dict) and layer.get("namespace") == WALLPAPER
                   for level in (levels.values() if isinstance(levels, dict) else [])
                   for layer in (level if isinstance(level, list) else [])):
            continue
        out.append(name)
    return sorted(out)


PNG_MAX_PIXELS = 1 << 20   # grim -s 0.1 of an 8K display is 768 x 432


def png_pixels(data: bytes) -> tuple[int, int, int, bytes] | None:
    """(width, height, channels, pixels) of a PNG as grim writes it (-t png):
    8- or 16-bit RGB (3 channels) or RGBA (4), not interlaced; the pixels row
    after row, one byte per sample (a 16-bit sample gives its high byte).
    None for any other PNG or a damaged one."""
    if not data.startswith(b"\x89PNG\r\n\x1a\n"):
        return None
    pos, header, parts = 8, None, []
    while True:
        if pos + 12 > len(data):
            return None  # cut short: no IEND
        length, kind = struct.unpack_from(">I4s", data, pos)
        end = pos + 8 + length
        if end + 4 > len(data):
            return None
        body = data[pos + 8:end]
        if zlib.crc32(kind + body) != struct.unpack_from(">I", data, end)[0]:
            return None
        pos = end + 4
        if kind == b"IHDR":
            header = body
        elif kind == b"IDAT":
            parts.append(body)
        elif kind == b"IEND":
            break
    if header is None or len(header) != 13:
        return None
    w, h, depth, colour, method, filtering, interlace = struct.unpack(">IIBBBBB", header)
    if colour not in (2, 6) or depth not in (8, 16) or method or filtering or interlace:
        return None
    if not w or not h or w * h > PNG_MAX_PIXELS:
        return None
    channels = 3 if colour == 2 else 4
    step = channels * depth // 8   # bytes per pixel
    stride = w * step
    try:  # never more than the picture needs, whatever the stream says
        raw = zlib.decompressobj().decompress(b"".join(parts), h * (stride + 1))
    except zlib.error:
        return None
    if len(raw) < h * (stride + 1):
        return None
    out = bytearray()
    prev = bytes(stride)
    for y in range(h):
        start = y * (stride + 1)
        kind = raw[start]
        line = bytearray(raw[start + 1:start + 1 + stride])
        if kind == 1:  # Sub
            for i in range(step, stride):
                line[i] = (line[i] + line[i - step]) & 255
        elif kind == 2:  # Up
            line = bytearray((a + b) & 255 for a, b in zip(line, prev))
        elif kind == 3:  # Average
            for i in range(stride):
                left = line[i - step] if i >= step else 0
                line[i] = (line[i] + ((left + prev[i]) >> 1)) & 255
        elif kind == 4:  # Paeth
            for i in range(stride):
                a = line[i - step] if i >= step else 0
                b = prev[i]
                c = prev[i - step] if i >= step else 0
                pa, pb, pc = abs(b - c), abs(a - c), abs(a + b - 2 * c)
                line[i] = (line[i] + (a if pa <= pb and pa <= pc else b if pb <= pc else c)) & 255
        elif kind != 0:
            return None
        out += line
        prev = line
    return w, h, channels, bytes(out[::2] if depth == 16 else out)


def png_shown(data: bytes, grey: tuple[int, int, int]) -> tuple[float, float] | None:
    """(share of pixels with nothing drawn, spread of brightness) of grim's
    PNG below its top tenth (where a bar may be), or None when png_pixels
    cannot read it. Nothing drawn: Hyprland's background colour, or alpha 0.
    In HDR grim reads Hyprland's SDR copy for captures, and Hyprland clears
    its background colour into the screen's own buffer only: the copy has
    (0,0,0,0) there, while anything drawn, black too, has alpha 255."""
    image = png_pixels(data)
    if image is None:
        return None
    w, h, channels, pixels = image
    top = h // 10
    n = w * (h - top)
    if not n:
        return None
    hits = 0
    total = 0
    total2 = 0
    for i in range(top * w * channels, h * w * channels, channels):
        r, g, b = pixels[i], pixels[i + 1], pixels[i + 2]
        if ((channels == 4 and pixels[i + 3] == 0)
                or (abs(r - grey[0]) <= 3 and abs(g - grey[1]) <= 3 and abs(b - grey[2]) <= 3)):
            hits += 1
        y = (r * 299 + g * 587 + b * 114) // 1000
        total += y
        total2 += y * y
    mean = total / n
    return hits / n, max(0.0, total2 / n - mean * mean) ** 0.5


def undrawn(shown: tuple[float, float] | None) -> bool:
    """Nothing drawn where the wallpaper should be. A flat image of another
    colour (a plain wallpaper, black too) is not counted."""
    return shown is not None and shown[0] > 0.97


def grab(output: str) -> bytes | None:
    """A small screenshot of one output (grim, a tenth of its size). PNG, not
    PPM: only the PNG keeps the alpha that tells nothing drawn in HDR."""
    try:
        r = subprocess.run(["grim", "-s", "0.1", "-o", output, "-t", "png", "-"],
                           capture_output=True, timeout=3, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return r.stdout if r.returncode == 0 else None


grab_unread_said = False


def undrawn_outputs() -> list[str]:
    """Mac displays that should show the desktop but show nothing drawn
    (only Hyprland's background colour; in HDR's capture copy, nothing)."""
    global grab_unread_said
    names = desktop_outputs(hypr_json("j/monitors"), hypr_json("j/workspaces"),
                            hypr_json("j/layers"))
    if not names:
        return []
    grey = background_colour(hypr_json("j/getoption misc:background_color"))
    out = []
    for name in names:
        data = grab(name)
        shown = png_shown(data or b"", grey)
        if shown is None:
            if not grab_unread_said:  # once per run: a display that cannot be judged is not counted
                grab_unread_said = True
                log(f"desktop check: no readable picture of {name} ("
                    + (f"{len(data)} bytes, not an 8- or 16-bit RGB or RGBA PNG" if data else "grim gave none")
                    + "); not counted")
        elif undrawn(shown):
            out.append(name)
    return out


def screen_locked() -> bool:
    try:
        return subprocess.run(["omarchy-hyprland-session-locked"], timeout=5,
                              check=False).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def shell_pid() -> int | None:
    """The running Omarchy shell (Quickshell) of this user, if any."""
    uid = os.getuid()
    for d in Path("/proc").iterdir():
        if not d.name.isdigit():
            continue
        try:
            if d.stat().st_uid != uid or (d / "comm").read_text().strip() != "quickshell":
                continue
        except OSError:
            continue
        return int(d.name)
    return None


def layout_event(data: bytes) -> bool:
    """Hyprland events (socket2 lines "name>>data") that change the layout.
    Not "screencast>>1,monitor,...": every grim (also the desktop check's
    own) sends that."""
    for line in data.split(b"\n"):
        name = line.split(b">>", 1)[0]
        if name.startswith(b"monitor") or name == b"configreloaded":
            return True
    return False


def config_reloaded(data: bytes) -> bool:
    """Hyprland read its config again (socket2 "configreloaded>>"): its
    options are the config's again."""
    return any(line.split(b">>", 1)[0] == b"configreloaded" for line in data.split(b"\n"))


def shell_event(data: bytes) -> bool:
    """A layer surface opened (socket2 "openlayer>>namespace"): the shell may
    have (re)started; the agent then looks for it at once."""
    return any(line.startswith(b"openlayer>>") for line in data.split(b"\n"))


def run_sync() -> None:
    try:
        subprocess.run([SYNC, "--once"], timeout=20, check=False,
                       stdout=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired) as error:
        log(f"display sync failed: {error}")


def session_state() -> str:
    """The desktop session: down, busy, locked or open (guest/session-lock.sh;
    open without it). No word within 15 s: busy, the shell takes no calls."""
    try:
        out = subprocess.run(["bash", str(SESSION_LOCK)], capture_output=True, text=True,
                             timeout=15, check=False).stdout.strip()
    except subprocess.TimeoutExpired:
        return "busy"
    except (OSError, subprocess.SubprocessError):
        return "open"
    return out if out in ("down", "busy", "locked", "open") else "open"


def refresh_widget() -> None:
    """Rebuild omacvm.monitor when an Omarchy update changed its display panel.
    The installer may be rewriting the widget right now: a file gone midway
    is not an error (it used to stop the agent). Not while the session is
    locked: a write in the plugins folder or a rescan reloads Omarchy's lock
    screen without its password field (omarchy-mac 4.0.3); Update VM stages
    its own copy then, else the agent's next start does it. A shell that is
    starting gets 20 more looks, a second apart. Runs beside the agent (main):
    nothing of the display sync waits for it."""
    stamp = WIDGET / ".source-sha256"
    import hashlib
    try:
        if not stamp.exists() or not WIDGET_BUILD.exists() or not OMARCHY_PANEL.exists():
            return
        digest = hashlib.sha256(OMARCHY_PANEL.read_bytes()).hexdigest()
        if stamp.read_text().strip() == digest:
            return
    except OSError as error:
        log(f"display widget not checked: {error}")
        return
    state = session_state()
    for _ in range(20):
        if state != "busy":
            break
        time.sleep(1)
        state = session_state()
    if state in ("locked", "busy"):
        log("display widget not rebuilt while the session is locked (Update VM or the next start does it)")
        return
    try:
        subprocess.run([sys.executable, str(WIDGET_BUILD), str(WIDGET)], timeout=30, check=True)
        subprocess.run(["omarchy-shell", "-q", "shell", "rescanPlugins"], timeout=30, check=False)
        log("display widget rebuilt for the updated Omarchy")
    except (OSError, subprocess.SubprocessError) as error:
        log(f"display widget not rebuilt: {error}")


def write_state(message: dict) -> None:
    STATE.parent.mkdir(parents=True, exist_ok=True)
    tmp = STATE.with_suffix(".tmp")
    tmp.write_text(json.dumps(message) + "\n")
    tmp.replace(STATE)
    builtin = message.get("builtin")
    if isinstance(builtin, str) and re.fullmatch(r"Virtual-[0-9]+", builtin):
        tmp = BUILTIN.with_suffix(".tmp")
        tmp.write_text(builtin + "\n")
        tmp.replace(BUILTIN)
    else:
        BUILTIN.unlink(missing_ok=True)


PAUSED = RUNTIME / "omacvm/paused-displays"
LEASE = 15.0          # no "unseen" from the Mac for this long: the displays on again
CAST_SETTLE = 3.0     # after a start or a lost event socket: shares unknown for this long


def screencasts(data: bytes) -> list[tuple[bool, str, str]]:
    """Hyprland's socket2 lines "screencastv2>>STATE,TYPE,NAME" (a screen
    share, recording or screenshot starting or ending): (on, type, name)."""
    out = []
    for line in data.split(b"\n"):
        name, _, rest = line.partition(b">>")
        if name != b"screencastv2":
            continue
        state, _, rest = rest.partition(b",")
        kind, _, what = rest.partition(b",")
        if state in (b"0", b"1"):
            out.append((state == b"1", kind.decode(errors="replace"), what.decode(errors="replace")))
    return out


def dpms(name: str, on: bool) -> bool:
    """One output's display on or off (Hyprland's own DPMS)."""
    action = "enable" if on else "disable"
    return hypr_request(f'dispatch hl.dsp.dpms({{ action = "{action}", monitor = "{name}" }})') == "ok"


WAKE = RUNTIME / "omacvm/paused-wake"
# Hyprland turns every display on at a pointer move or a key while one is off.
WAKE_OPTIONS = ("misc:mouse_move_enables_dpms", "misc:key_press_enables_dpms")


def hypr_bool(name: str) -> bool | None:
    """A bool option (j/getoption): Hyprland 0.56 answers {"bool": true}, older
    ones {"int": 1}. None: no answer, or not a bool (then it is left alone)."""
    o = hypr_json(f"j/getoption {name}")
    if not isinstance(o, dict):
        return None
    v = o.get("bool", o.get("int"))
    if isinstance(v, bool):
        return v
    if isinstance(v, int) and v in (0, 1):
        return v == 1
    return None


def set_hypr_bool(name: str, on: bool) -> bool:
    """Sets a bool option until Hyprland reads its config again. True once
    Hyprland reports the new value."""
    section, _, key = name.partition(":")
    if not re.fullmatch(r"[a-z_]+", section) or not re.fullmatch(r"[a-z_]+", key):
        return False
    hypr_request(f"eval hl.config({{ {section} = {{ {key} = {'true' if on else 'false'} }} }})")
    return hypr_bool(name) is on


class WakeGuard:
    """Hyprland's own wake-ups off while the agent holds a display off.

    With misc:mouse_move_enables_dpms (Omarchy turns it on) any pointer move
    turns EVERY display on, also one paused while the person works on another
    display; the Mac's next "unseen" turned it off again, a fight at every
    move (key_press_enables_dpms the same for keys). follow(True) turns off
    the options that are on, follow(False) puts them back. Only options that
    were on are touched, one with an answer that is not a bool is left alone.
    What was turned off is kept in paused-wake, so a restarted agent puts it
    back (restore). A config reload puts the config's values back: the next
    follow(True) turns them off again, and one the config itself turns off is
    not put back later.
    """

    def __init__(self, get=hypr_bool, put=set_hypr_bool, path: Path = WAKE) -> None:
        self.get = get
        self.put = put
        self.path = path
        self.saved: dict[str, bool] = {}   # turned off, with the value they had
        self.held = False
        self.reloaded = False

    def recheck(self) -> None:
        """Hyprland may have its config's values again (a config reload, a
        new Hyprland after a lost event socket): the next hold looks again."""
        if self.held:
            self.reloaded = True

    def follow(self, hold: bool) -> None:
        if hold:
            self.hold()
        elif self.held or self.saved:
            self.release()

    def hold(self) -> None:
        if self.held and not self.reloaded:
            return
        reloaded, self.reloaded = self.reloaded, False
        before = dict(self.saved)
        done = True
        for name in WAKE_OPTIONS:
            value = self.get(name)
            if value is True:
                if self.put(name, False):
                    self.saved[name] = True
                else:
                    done = False       # Hyprland did not take it: again at the next look
            elif value is False and reloaded:
                self.saved.pop(name, None)   # the config says off itself now
        self.held = done
        if self.saved != before:
            if self.saved.keys() - before.keys():
                log(f"Hyprland's wake on {self.words(self.saved)} off while a display is paused")
            self.save()

    def release(self) -> None:
        for name in sorted(self.saved):
            if self.put(name, self.saved[name]):
                del self.saved[name]
                log(f"Hyprland's wake on {self.words([name])} on again")
        self.held = False
        self.reloaded = False
        self.save()

    @staticmethod
    def words(names) -> str:
        return " and ".join("pointer moves" if "mouse" in n else "key presses" for n in sorted(names))

    def save(self) -> None:
        try:
            if self.saved:
                self.path.parent.mkdir(parents=True, exist_ok=True)
                tmp = self.path.with_suffix(".tmp")
                tmp.write_text(json.dumps(self.saved, sort_keys=True) + "\n")
                tmp.replace(self.path)
            else:
                self.path.unlink(missing_ok=True)
        except OSError as error:
            log(f"paused wake options not written: {error}")

    def restore(self) -> None:
        """At start: options a former agent turned off, back as they were."""
        try:
            data = json.loads(self.path.read_text())
        except (OSError, ValueError):
            return
        if isinstance(data, dict):
            self.saved = {n: v for n, v in data.items() if n in WAKE_OPTIONS and isinstance(v, bool)}
            self.release()


def held_wake(path: Path | None = None) -> list[str]:
    """The wake options a running agent holds off now (for `pause`)."""
    try:
        data = json.loads((path or WAKE).read_text())
    except (OSError, ValueError):
        return []
    return sorted(n for n in data if n in WAKE_OPTIONS) if isinstance(data, dict) else []


class Pause:
    """The outputs whose Mac window nobody can see: their display off (DPMS).

    mac(names) takes the Mac's list, cast() a screen share starting or
    ending, apply() makes Hyprland match: off for an unseen output that is
    on (and not shared), on again only for outputs this agent turned off.
    An output the guest had turned off itself before the pause (Omarchy's
    idle) is left as it is; one it turns off during the pause cannot be told
    apart (it is off already) and comes on with the window. While an output
    is paused, Hyprland's wake on moves and keys is off (WakeGuard), unless
    another output is off too (the guest's idle: input wakes it as usual).
    """

    def __init__(self, set_dpms=dpms, monitors=lambda: hypr_json("j/monitors"), path: Path = PAUSED,
                 clock=time.monotonic, guard: WakeGuard | None = None) -> None:
        self.set_dpms = set_dpms
        self.monitors = monitors
        self.path = path
        self.clock = clock
        self.guard = guard if guard is not None else WakeGuard()
        self.unseen: set[str] = set()
        self.paused: set[str] = set()
        self.casts: dict[tuple[str, str], int] = {}
        self.casts_since = clock()     # share events seen from then on
        self.renewed = 0.0             # the Mac's last "unseen" with a display in it

    def mac(self, names) -> None:
        self.unseen = {n for n in names if isinstance(n, str) and re.fullmatch(r"Virtual-[0-9]+", n)}
        if self.unseen:
            self.renewed = self.clock()

    def due_at(self) -> float | None:
        """When the pause has something to do by itself: the lease's end, the end of the share settle."""
        if not self.unseen:
            return None
        at = self.renewed + LEASE
        settle = self.casts_since + CAST_SETTLE
        return min(at, settle) if self.clock() < settle else at

    def tick(self) -> None:
        """The lease ran out (the Mac's word got lost, or QEMU is gone): draw again."""
        if self.unseen and self.clock() - self.renewed > LEASE:
            log(f"no word from the Mac for {LEASE:.0f} s: drawing again")
            self.unseen = set()
        self.apply()

    def cast(self, on: bool, kind: str, name: str) -> None:
        key = (kind, name)
        count = self.casts.get(key, 0) + (1 if on else -1)
        if count > 0:
            self.casts[key] = min(count, 16)
        else:
            self.casts.pop(key, None)

    def casts_lost(self) -> None:
        """The event socket went away: its ends of shares are not known."""
        self.casts = {}
        self.casts_since = self.clock()

    def wanted_off(self) -> set[str]:
        if self.clock() - self.casts_since < CAST_SETTLE:
            return set()   # a share that started before may not be known yet
        if any(kind != "monitor" for kind, _ in self.casts):
            return set()   # a window shared: it may be on any output
        return {n for n in self.unseen if ("monitor", n) not in self.casts}

    def busy(self) -> bool:
        return bool(self.unseen or self.paused or self.guard.saved)

    def apply(self) -> None:
        data = self.monitors()
        if not isinstance(data, list):
            return
        state = {m.get("name"): m for m in data if isinstance(m, dict) and not m.get("disabled")}
        off = self.wanted_off()
        changed = False
        for name in sorted(off):
            m = state.get(name)
            if m is None or m.get("dpmsStatus") is not True:
                continue   # gone, or already off (by the guest itself)
            if self.set_dpms(name, False):
                if name not in self.paused:
                    log(f"drawing paused on {name}: its Mac window is out of sight")
                self.paused.add(name)
                changed = True
        woke = set()
        for name in sorted(self.paused - off):
            m = state.get(name)
            if m is not None and m.get("dpmsStatus") is False and not self.set_dpms(name, True):
                continue   # try again at the next look
            self.paused.discard(name)
            woke.add(name)
            changed = True
            log(f"drawing again on {name}")
        if changed:
            self.save()
        # Another output off that the agent did not turn off: the guest's own
        # idle; Hyprland's wake on input must reach it.
        dark = {n for n, m in state.items()
                if m.get("dpmsStatus") is False and re.fullmatch(r"Virtual-[0-9]+", str(n))}
        self.guard.follow(bool(self.paused) and not (dark - self.paused - woke))

    def save(self) -> None:
        try:
            if self.paused:
                self.path.parent.mkdir(parents=True, exist_ok=True)
                tmp = self.path.with_suffix(".tmp")
                tmp.write_text(json.dumps(sorted(self.paused)) + "\n")
                tmp.replace(self.path)
            else:
                self.path.unlink(missing_ok=True)
        except OSError as error:
            log(f"paused displays not written: {error}")

    def restore(self) -> None:
        """At start: displays a former agent turned off, on again (the Mac
        says at the hello which are still out of sight), Hyprland's wake
        options first."""
        self.guard.restore()
        try:
            names = json.loads(self.path.read_text())
        except (OSError, ValueError):
            return
        if isinstance(names, list):
            self.paused = {n for n in names if isinstance(n, str) and re.fullmatch(r"Virtual-[0-9]+", n)}
            self.apply()


REPAIRS = RUNTIME / "omacvm/shell-repairs"
REPAIR_EVERY = 120.0   # seconds between two shell restarts
REPAIR_MAX = 3         # per run of the agent (a session)
SETTLE = 3.0           # seconds without a layout change before checking
CONFIRM = 4.0          # the same problem again after this long: repair
SHELL_LOOKS = (10.0, 25.0)  # seconds after a shell (re)start to look
# A report and a look for the shell at least this often, in case an event
# slipped by: rarely while Hyprland's events come in, more often without.
SAFETY_WITH_EVENTS = 30.0
SAFETY_WITHOUT_EVENTS = 5.0
# Hyprland sends no event when an output only moves, so the agent also
# compares the layout itself (one IPC call; a report goes out only when it
# changed): twice a second for FOLLOW seconds after any change (a config
# reload moves outputs for a few seconds), else every REPORT_EVERY seconds.
FOLLOW = 15.0
FOLLOW_EVERY = 0.5
REPORT_EVERY = 10.0


class Poke:
    """The datagram socket `omacvm-displays poke` writes to (Hyprland's Lua
    hook monitor.layout_changed). Not available: ok is False; the agent then
    relies on its own comparing."""

    def __init__(self, path: Path) -> None:
        self.sock: socket.socket | None = None
        try:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.unlink(missing_ok=True)
            s = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
            s.bind(str(path))
            s.setblocking(False)
            self.sock = s
        except OSError:
            pass

    @property
    def ok(self) -> bool:
        return self.sock is not None

    def fileno(self) -> int:
        return self.sock.fileno() if self.sock else -1

    def drain(self) -> list[bytes]:
        """Reads the pending pokes: their lines (b"layout", b"scale 1.6")."""
        got: list[bytes] = []
        while self.sock:
            try:
                got.append(self.sock.recv(64).strip())
            except BlockingIOError:
                break
            except OSError:
                break
        return got

    def close(self) -> None:
        if self.sock:
            self.sock.close()
            self.sock = None


def poke(path: Path = POKE, message: bytes = b"layout\n") -> None:
    """Tells a running agent the layout moved (or the scale just picked).
    Nothing listening: nothing to do."""
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as s:
            s.setblocking(False)
            s.sendto(message, str(path))
    except OSError:
        pass


class Agent:
    def __init__(self) -> None:
        self.fd = os.open(PORT, os.O_RDWR | os.O_NONBLOCK | os.O_CLOEXEC)
        self.buffer = b""
        self.outbox = b""
        self.external = external_on()
        self.mtime = config_mtime()
        self.reported: list[dict] | None = None
        self.events: socket.socket | None = None
        self.check_at = 0.0
        self.last_check = 0.0
        self.last_report = 0.0
        self.follow_until = 0.0
        self.looks: list[float] = []   # when to look at the displays
        self.shell: int | None = None
        self.suspect: tuple[list[str], float] | None = None
        self.repairs = 0
        self.attempts = 0
        self.repaired_at = -REPAIR_EVERY
        self.repair: subprocess.Popen | None = None
        self.repairing: list[str] = []
        self.repaired_for: list[str] = []
        self.said: list[str] = []
        self.config_watch = ConfigWatch(CONFIG.parent)
        self.poke = Poke(POKE)
        self.pause = Pause()
        self.scale: float | None = None   # the scale last told to the Mac
        self.lua_scale: float | None = None   # monitors.lua's, when last looked at

    def send(self, message: dict) -> None:
        self.outbox += json.dumps(message, separators=(",", ":")).encode() + b"\n"
        self.flush()

    def flush(self) -> None:
        while self.outbox:
            try:
                n = os.write(self.fd, self.outbox)
            except OSError as error:
                if error.errno in (errno.EAGAIN, errno.EINTR):
                    return
                raise
            self.outbox = self.outbox[n:]

    def connect_events(self) -> None:
        d = hypr_dir()
        if not d or self.events:
            return
        try:
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.connect(str(d / ".socket2.sock"))
            s.setblocking(False)
            self.events = s
        except OSError:
            self.events = None

    def soon(self, delay: float) -> None:
        when = time.monotonic() + delay
        if not self.check_at or when < self.check_at:
            self.check_at = when

    def follow(self) -> None:
        """Compare the layout often for a while: outputs keep moving for a few
        seconds after a change, without events."""
        self.follow_until = time.monotonic() + FOLLOW

    def report_every(self, now: float) -> float:
        return FOLLOW_EVERY if now < self.follow_until else min(REPORT_EVERY, self.safety_every())

    def report(self) -> None:
        self.last_report = time.monotonic()
        current = monitors()
        if current is not None and current != self.reported:
            self.reported = current
            self.send({"monitors": current})
        self.lua_changed()

    def lua_changed(self) -> None:
        """monitors.lua's scale to the Mac when it changed there. A scale just
        picked (a poke, `scale`) is not undone by the old value still in the
        file: that is sent only once the file itself changes."""
        lua = wanted_scale()
        if lua != getattr(self, "lua_scale", None):
            self.lua_scale = lua
            self.send_scale(lua)

    def send_scale(self, scale: float | None) -> None:
        """The main output's scale to the Mac when it changed (#355)."""
        if scale is not None and scale != getattr(self, "scale", None):
            self.scale = scale
            self.send({"scale": scale})

    def on_poke(self, lines: list[bytes]) -> None:
        for line in lines:
            word, _, value = line.decode(errors="replace").partition(" ")
            if word == "scale":
                try:
                    scale = float(value)
                except ValueError:
                    continue
                if 1 <= scale <= 4:
                    self.send_scale(round(scale, 6))
        if any(not line.startswith(b"scale") for line in lines):
            self.layout_changed()
            self.soon(0.05)

    def look_in(self, delay: float) -> None:
        self.looks.append(time.monotonic() + delay)

    def layout_changed(self) -> None:
        # Look once the layout has been quiet for a moment (one look per burst).
        now = time.monotonic()
        self.looks = [t for t in self.looks if not now < t <= now + SETTLE]
        self.look_in(SETTLE)
        self.suspect = None
        self.follow()

    def watch_shell(self) -> None:
        pid = shell_pid()
        if pid and pid != self.shell:
            for delay in SHELL_LOOKS:
                self.look_in(delay)
        self.shell = pid

    def repair_done(self) -> None:
        """Counts a shell restart once it is known to have happened."""
        if not self.repair or self.repair.poll() is None:
            return
        code, self.repair = self.repair.returncode, None
        if code != 0:
            log(f"shell restart failed (exit {code}); not counted")
            return
        self.repairs += 1
        self.repaired_for = self.repairing
        try:  # for omacvm check
            REPAIRS.parent.mkdir(parents=True, exist_ok=True)
            REPAIRS.write_text(json.dumps({"count": self.repairs, "at": time.time(),
                                           "why": self.repairing}) + "\n")
        except OSError:
            pass

    def check_desktop(self) -> None:
        """Restarts the shell when a display shows nothing drawn (undrawn_outputs)."""
        now = time.monotonic()
        if not self.looks or min(self.looks) > now:
            return
        self.looks = [t for t in self.looks if t > now]
        if self.repair:
            return  # a restart is under way; the new shell gets its looks
        if screen_locked():
            # The lock screen covers the displays, and omarchy-restart-shell
            # keeps a live locker: look again once unlocked.
            self.look_in(30.0)
            return
        problems = undrawn_outputs()
        if not problems:
            # A good look ends a repair: the same outputs going grey again
            # later is a new problem, not "a restart does not help".
            self.suspect = None
            self.repaired_for = []
            self.said = []
            return
        if not self.suspect or self.suspect[0] != problems:
            self.suspect = (problems, now)
            self.look_in(CONFIRM)
            return
        if now - self.suspect[1] < CONFIRM:
            self.look_in(CONFIRM - (now - self.suspect[1]))
            return
        self.suspect = None
        moved = misplaced_wallpapers(hypr_json("j/monitors"), hypr_json("j/layers"))
        detail = ", ".join(problems) + (f"; {'; '.join(moved)}" if moved else "")
        say = problems != self.said  # one log line per distinct problem
        self.said = problems
        if not config_flag("repair-shell"):
            if say:
                log(f"no desktop drawn on {detail}; repair-shell=off")
            return
        if problems == self.repaired_for:
            # The same after a fresh shell: a restart does not help. Stop here.
            if self.repairs < REPAIR_MAX:
                log(f"still no desktop on {detail} after a shell restart; not restarting it again")
            self.repairs = REPAIR_MAX
            return
        if (self.repairs >= REPAIR_MAX or self.attempts >= 2 * REPAIR_MAX
                or now - self.repaired_at < REPAIR_EVERY):
            if say:
                log(f"no desktop drawn on {detail}; not restarting the shell again yet")
            return
        log(f"no desktop drawn on {detail}: restarting the shell")
        self.repairing = problems
        # Rate-limited from the attempt: a restart that fails counts here too.
        self.attempts += 1
        self.repaired_at = now
        try:
            self.repair = subprocess.Popen(["omarchy-restart-shell"], stdout=subprocess.DEVNULL,
                                           stderr=subprocess.DEVNULL)
        except OSError as error:
            log(f"shell restart failed: {error}")

    def on_line(self, line: bytes) -> None:
        try:
            message = json.loads(line)
        except ValueError:
            return
        if isinstance(message, dict) and isinstance(message.get("unseen"), list):
            self.pause.mac(message["unseen"])
            self.pause.apply()
            return
        if not isinstance(message, dict) or not isinstance(message.get("layout"), list):
            return
        write_state(message)
        run_sync()
        self.layout_changed()
        self.soon(0.3)

    def safety_every(self) -> float:
        return SAFETY_WITH_EVENTS if self.events else SAFETY_WITHOUT_EVENTS

    def timeout(self, now: float) -> float:
        """Seconds until the agent has something to do. Idle on the desktop
        that is the safety report: the agent does not wake the VM every
        second (events and the Mac's lines wake it)."""
        due = [self.last_check + self.safety_every(), self.last_report + self.report_every(now)]
        if self.check_at:
            due.append(self.check_at)
        if self.looks:
            due.append(min(self.looks))
        if self.repair or not self.config_watch.ok:
            due.append(now + 1.0)   # a shell restart under way; displays.conf without inotify
        pause = getattr(self, "pause", None)
        at = pause.due_at() if pause else None
        if at is not None:
            due.append(at + 0.05)
        return max(0.0, min(due) - now)

    def run(self) -> None:
        self.pause.restore()
        self.send({"hello": 1, "external": self.external, "pause": 1})
        self.lua_changed()
        # Started in the middle of a change (a config reload restarts it):
        # the first report may be a passing layout.
        self.follow()
        while True:
            self.connect_events()
            readers = [self.fd] + ([self.events] if self.events else [])
            if self.config_watch.ok:
                readers.append(self.config_watch)
            if self.poke.ok:
                readers.append(self.poke)
            writers = [self.fd] if self.outbox else []
            ready, writable, _ = select.select(readers, writers, [], self.timeout(time.monotonic()))
            if self.config_watch in ready:
                self.config_watch.drain()
            if self.poke in ready:
                self.on_poke(self.poke.drain())
            if writable:
                self.flush()
            if self.fd in ready:
                try:
                    data = os.read(self.fd, 65536)
                except OSError as error:
                    if error.errno not in (errno.EAGAIN, errno.EINTR):
                        raise
                    data = None
                if data:
                    self.buffer += data
                    while b"\n" in self.buffer:
                        line, self.buffer = self.buffer.split(b"\n", 1)
                        self.on_line(line)
                    if len(self.buffer) > 1 << 20:
                        self.buffer = b""
                elif data == b"":
                    # The Mac side is not connected (yet): say hello again
                    # once it is, so it sends the layout.
                    if b'"hello"' not in self.outbox:
                        self.send({"hello": 1, "external": self.external, "pause": 1})
                    time.sleep(1)
            if self.events and self.events in ready:
                try:
                    data = self.events.recv(65536)
                except OSError:
                    data = b""
                if not data:
                    self.events.close()
                    self.events = None
                    self.pause.casts_lost()
                    self.pause.guard.recheck()
                else:
                    self.on_events(data)
            mtime = config_mtime()
            if mtime != self.mtime:
                self.mtime = mtime
                on = external_on()
                if on != self.external:
                    self.external = on
                    self.send({"external": on})
            self.due()

    def on_events(self, data: bytes) -> None:
        """Lines from Hyprland's event socket."""
        casts = screencasts(data)
        for on, kind, name in casts:
            self.pause.cast(on, kind, name)
        reloaded = config_reloaded(data)
        if reloaded:
            self.pause.guard.recheck()
        if (casts or reloaded) and self.pause.busy():
            self.pause.apply()
        if layout_event(data):
            self.layout_changed()
            self.soon(0.3)
        if shell_event(data):
            self.watch_shell()

    def due(self) -> None:
        """What is due now: the report (and a look for the shell), the
        layout compare, the desktop check."""
        now = time.monotonic()
        if (self.check_at and now >= self.check_at) or now - self.last_check >= self.safety_every():
            self.check_at = 0.0
            self.last_check = now
            self.report()
            self.watch_shell()
            pause = getattr(self, "pause", None)
            if pause and pause.busy():
                pause.apply()   # a display turned on again by a key, Hyprland restarted
        elif now - self.last_report >= self.report_every(now):
            self.report()
        self.repair_done()
        self.check_desktop()
        pause = getattr(self, "pause", None)
        at = pause.due_at() if pause else None
        if at is not None and now >= at:
            pause.tick()


def notify(text: str) -> None:
    try:
        subprocess.run(["notify-send", "-a", "OmacVM", "-t", "2500", text],
                       timeout=5, check=False)
    except (OSError, subprocess.TimeoutExpired):
        pass


def main(argv: list[str]) -> int:
    if len(argv) >= 2 and argv[1] == "external":
        want = argv[2] if len(argv) > 2 else "toggle"
        if want not in ("on", "off", "toggle"):
            print("usage: omacvm-displays external on|off|toggle", file=sys.stderr)
            return 2
        on = (not external_on()) if want == "toggle" else want == "on"
        set_external(on)
        notify("External displays: " + ("on (in full screen)" if on else "off"))
        return 0
    if len(argv) >= 2 and argv[1] == "state":
        if PORT.exists():
            print("on" if external_on() else "off")
        return 0
    if len(argv) >= 2 and argv[1] == "status":
        layout = None
        try:
            layout = json.loads(STATE.read_text())
        except (OSError, ValueError):
            pass
        print(json.dumps({"external": external_on(), "port": PORT.exists(),
                          "layout": layout, "monitors": monitors()}, indent=2))
        return 0
    if len(argv) >= 2 and argv[1] == "desktop":
        repairs = None
        try:
            repairs = json.loads(REPAIRS.read_text())
        except (OSError, ValueError):
            pass
        print(json.dumps({"undrawn": undrawn_outputs(),
                          "misplaced": misplaced_wallpapers(hypr_json("j/monitors"),
                                                            hypr_json("j/layers")),
                          "repairs": repairs}, indent=2))
        return 0
    if len(argv) >= 2 and argv[1] == "poke":
        poke()
        return 0
    if len(argv) >= 2 and argv[1] == "pause":
        paused = []
        try:
            paused = json.loads(PAUSED.read_text())
        except (OSError, ValueError):
            pass
        print(json.dumps({"able": True, "paused": paused if isinstance(paused, list) else [],
                          "wake_off": held_wake()}))
        return 0
    if len(argv) >= 2 and argv[1] == "fullpanel":
        out = fullpanel_output()
        if out:
            print(out)
        return 0
    if len(argv) == 3 and argv[1] == "scale":
        return set_scale(argv[2])
    if len(argv) >= 2 and argv[1] not in ("run",):
        print(__doc__.strip(), file=sys.stderr)
        return 2
    if not PORT.exists():
        log(f"{PORT} is missing (an OmacVM.app without external displays)")
        return 0
    threading.Thread(target=refresh_widget, name="widget", daemon=True).start()
    Agent().run()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
