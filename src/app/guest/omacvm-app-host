#!/bin/bash
# OmacVM.app: what the Mac tells the VM at start (QEMU SMBIOS OEM strings
# "omacvm.KEY=VALUE", read by omacvm-smbios) -> /run/omacvm/host.env,
# readable by the desktop user.
# Today: omacvm.notch (rows beside the notch, in pixels, when the window
# covers them; only an OmacVM.app before 3.0.0 sends it), omacvm.screen
# (that full-screen size), omacvm.hdr, omacvm.vkwindows (the app shows Vulkan
# windows Hyprland imports), omacvm.hwcursor (the Mac's cursor shows the
# pointer: omacvm_app.lua) and omacvm.notchpointer (QEMU parks the guest's
# pointer in NOTCH as the Mac's leaves for the strip: notchcast does not hide it)
# and omacvm.vaexport (the runtime draws VA-API's RGB frames: the VA driver
# shim sizes Chromium's surfaces, omacvm_drv_video.c) and omacvm.vadecasync
# (the runtime decodes beside its GPU thread: the shim lets Chromium's decoder
# wait for each picture) and omacvm.valogical (the runtime samples a texture at
# the size the guest says: the shim tells it each video surface's own size).
set -euo pipefail
out=/run/omacvm/host.env
install -d -m755 /run/omacvm
python3 -I /usr/local/lib/omacvm/omacvm-smbios > "$out.tmp"
chmod 644 "$out.tmp"; mv "$out.tmp" "$out"
