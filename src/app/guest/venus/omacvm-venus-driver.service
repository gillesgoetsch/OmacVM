# OmacVM.app: the Venus (Vulkan) driver for the Mac's 16 KiB pages, built
# when the VM has Vulkan and still lacks it (vulkan-virtio.sh is silent and
# quick otherwise). Started by omacvm-venus-driver.timer after the desktop is
# up, never at boot: nothing waits for it and it does not pull in
# network-online.target (the script waits for the network itself, only when
# it builds). Installed by src/app/guest/install.sh.
[Unit]
Description=OmacVM: Vulkan (Venus) driver for the Mac's GPU memory pages
ConditionPathExists=/usr/local/share/omacvm/app/guest/venus/vulkan-virtio.sh

[Service]
Type=oneshot
# Only when the VM's Graphics gives it Vulkan or the vulkan feature is on
# (app/guest/install.sh enables the timer only then; this covers a setting
# changed since).
ExecCondition=/bin/sh -c 'grep -qxE "OMACVM_GRAPHICS=vulkan|OMACVM_FEATURE_vulkan=on" /etc/omacvm/env'
Environment=OMACVM_VENUS_BOOT=1
ExecStart=/usr/local/share/omacvm/app/guest/venus/vulkan-virtio.sh
Nice=19
CPUSchedulingPolicy=idle
IOSchedulingClass=idle
TimeoutStartSec=45min
