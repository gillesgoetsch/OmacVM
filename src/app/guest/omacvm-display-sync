#!/bin/bash
# OmacVM.app: Hyprland follows the Mac window. QEMU passes the window size,
# refresh rate and pixel density by EDID; this applies them on every change.
# In full screen with external displays every Mac display is an output
# (Virtual-1 the main window, Virtual-2 ...): each gets its own mode and
# scale, placed as the Mac's displays are (omacvm-displays writes where).
# From try-omarchy (omarchy-native-display-sync), MIT, (c) Try Omarchy contributors.

set -euo pipefail

drm_root=${OMARCHY_DISPLAY_SYNC_DRM_ROOT:-/sys/class/drm}
monitor_config=${OMARCHY_DISPLAY_SYNC_MONITOR_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/hypr/monitors.lua}
layout_file=${OMACVM_DISPLAYS_LAYOUT:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/omacvm/displays.json}
state_dir=${OMACVM_DISPLAY_SYNC_STATE:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/omacvm/display-sync}

# preferred_mode_from_edid EDID OUTPUT: explicit zoom per output, otherwise
# the main output's legacy Omarchy setting or each display's EDID density.
preferred_mode_from_edid() {
  python3 - "$1" "$monitor_config" "$2" <<'PY'
import os
import pathlib
import re
import sys
from math import gcd, hypot, isfinite, isqrt

data = pathlib.Path(sys.argv[1]).read_bytes()
if (
    len(data) < 128
    or data[:8] != b"\x00\xff\xff\xff\xff\xff\xff\x00"
    or sum(data[:128]) % 256
):
    raise SystemExit(1)

def modeline(
    pixel_clock: int,
    width: int,
    hblank: int,
    hfront: int,
    hsync: int,
    hsync_positive: bool,
    height: int,
    vblank: int,
    vfront: int,
    vsync: int,
    vsync_positive: bool,
) -> str | None:
    if (
        pixel_clock <= 0
        or width < 64
        or height < 64
        or hfront <= 0
        or hsync <= 0
        or vfront <= 0
        or vsync <= 0
        or hblank < hfront + hsync
        or vblank < vfront + vsync
        or width + hblank > 65535
        or height + vblank > 65535
    ):
        return None

    # Hyprland 0.56 truncates a fractional MHz clock before converting it to
    # kHz. Supplying the nearest integral MHz preserves the intended refresh
    # as closely as that parser permits, while the active pixel size is exact.
    clock_mhz = max(1, (pixel_clock + 500_000) // 1_000_000)
    hsync_start = width + hfront
    hsync_end = hsync_start + hsync
    htotal = width + hblank
    vsync_start = height + vfront
    vsync_end = vsync_start + vsync
    vtotal = height + vblank
    hflag = "+hsync" if hsync_positive else "-hsync"
    vflag = "+vsync" if vsync_positive else "-vsync"
    return (
        f"modeline {clock_mhz} {width} {hsync_start} {hsync_end} {htotal} "
        f"{height} {vsync_start} {vsync_end} {vtotal} {hflag} {vflag}"
    )


def scale_for_mode(
    width: int,
    height: int,
    physical_width_mm: int,
    physical_height_mm: int,
) -> str:
    # Omarchy's scaling controls write a numeric local in monitors.lua. Read it
    # on each resync so a running hotplug watcher also sees later zoom changes.
    # Auto/missing settings retain the live EDID's density-based scale.
    requested = None
    try:
        folder = pathlib.Path(os.environ.get("XDG_CONFIG_HOME", pathlib.Path.home() / ".config"))
        saved_scale = float((folder / "omacvm/scales" / sys.argv[3]).read_text())
        if isfinite(saved_scale) and saved_scale >= 0.25:
            requested = saved_scale
    except (OSError, ValueError):
        pass
    try:
        if requested is not None or sys.argv[3] != "Virtual-1":
            raise OSError("no legacy scale needed")
        config = pathlib.Path(sys.argv[2]).read_text()
        # Omarchy 4.5 keeps it in its own one-line rule for the output
        # instead (the last one counts, as in Hyprland; #738).
        rules = re.findall(
            r'^hl\.monitor\(\{ output = "Virtual-1", mode = "preferred", position = "auto", '
            r'scale = ([0-9]+(?:\.[0-9]+)?) \}\)[ \t\r]*$',
            config,
            re.MULTILINE,
        )
        match = re.search(
            r"^\s*local\s+omarchy_monitor_scale\s*=\s*([0-9]+(?:\.[0-9]+)?)\s*(?:--[^\n]*)?$",
            config,
            re.MULTILINE,
        )
        if rules or match:
            saved_scale = float(rules[-1] if rules else match.group(1))
            if isfinite(saved_scale) and saved_scale >= 0.25:
                requested = saved_scale
    except OSError:
        pass

    if requested is None:
        if physical_width_mm <= 0 or physical_height_mm <= 0:
            return "auto"
        diagonal_inches = hypot(physical_width_mm, physical_height_mm) / 25.4
        if diagonal_inches <= 0:
            return "auto"
        ppi = hypot(width, height) / diagonal_inches
        requested = 2.0 if ppi > 200 else 1.5 if ppi > 140 else 1.0

    # Hyprland requires the scaled logical dimensions to land on whole pixels.
    # It searches scale values in 1/120 increments around the requested value;
    # choose the closest clean value here so an explicit dynamic scale does not
    # trigger its stale-physical-size fallback or a warning notification.
    # Omarchy persists the effective clean scale, which can exceed its 4x
    # preset. Enumerate divisors instead of imposing a preset-based upper bound.
    common_120 = gcd(width * 120, height * 120)
    requested_120 = round(min(requested, common_120 / 120) * 120)
    clean_120 = min(
        (
            candidate
            for divisor in range(1, isqrt(common_120) + 1)
            if common_120 % divisor == 0
            for candidate in (divisor, common_120 // divisor)
            if candidate >= 30
        ),
        key=lambda candidate: (abs(candidate - requested_120), -candidate),
    )
    return f"{clean_120 / 120:.6f}".rstrip("0").rstrip(".")


base_physical_width_mm = data[21] * 10
base_physical_height_mm = data[22] * 10

# QEMU puts large and dynamically generated modes in a DisplayID 1.3 Type I
# timing block. Its base EDID contains only compatibility modes, so inspect
# DisplayID before falling back to a legacy base-block detailed timing.
displayid_timings: list[tuple[bool, str, int, int]] = []
available_extensions = len(data) // 128 - 1
extension_count = min(data[126], available_extensions)
for extension_index in range(extension_count):
    block_start = (extension_index + 1) * 128
    block = data[block_start : block_start + 128]
    if (
        len(block) != 128
        or block[0] != 0x70
        or block[1] >> 4 != 1
        or sum(block) % 256
    ):
        continue

    data_end = 5 + block[2]
    if data_end > 126 or sum(block[1 : data_end + 1]) % 256:
        continue

    position = 5
    while position + 3 <= data_end:
        tag = block[position]
        payload_length = block[position + 2]
        payload_start = position + 3
        payload_end = payload_start + payload_length
        if payload_end > data_end:
            break

        if tag == 0x03 and payload_length and payload_length % 20 == 0:
            payload = block[payload_start:payload_end]
            for offset in range(0, len(payload), 20):
                timing = payload[offset : offset + 20]
                pixel_clock = (int.from_bytes(timing[0:3], "little") + 1) * 10_000
                width = int.from_bytes(timing[4:6], "little") + 1
                hblank = int.from_bytes(timing[6:8], "little") + 1
                raw_hfront = int.from_bytes(timing[8:10], "little")
                hfront = (raw_hfront & 0x7FFF) + 1
                raw_hsync = int.from_bytes(timing[10:12], "little")
                hsync = raw_hsync + 1
                height = int.from_bytes(timing[12:14], "little") + 1
                vblank = int.from_bytes(timing[14:16], "little") + 1
                raw_vfront = int.from_bytes(timing[16:18], "little")
                vfront = (raw_vfront & 0x7FFF) + 1
                raw_vsync = int.from_bytes(timing[18:20], "little")
                vsync = raw_vsync + 1
                decoded = modeline(
                    pixel_clock,
                    width,
                    hblank,
                    hfront,
                    hsync,
                    bool(raw_hfront & 0x8000),
                    height,
                    vblank,
                    vfront,
                    vsync,
                    bool(raw_vfront & 0x8000),
                )
                if decoded:
                    displayid_timings.append(
                        (bool(timing[3] & 0x80), decoded, width, height)
                    )

        position = payload_end

if displayid_timings:
    _, preferred, preferred_width, preferred_height = next(
        (entry for entry in displayid_timings if entry[0]),
        displayid_timings[0],
    )
    scale = scale_for_mode(
        preferred_width,
        preferred_height,
        base_physical_width_mm,
        base_physical_height_mm,
    )
    print(f"{preferred}\t{scale}")
    raise SystemExit(0)

for offset in range(54, 126, 18):
    timing = data[offset : offset + 18]
    pixel_clock = int.from_bytes(timing[0:2], "little") * 10_000
    # QEMU emits progressive timings with separate digital sync. Reject the
    # interlaced, stereo, or analog/composite forms that need other handling.
    if (
        not pixel_clock
        or timing[17] & 0x80
        or timing[17] & 0x61
        or timing[17] & 0x18 != 0x18
    ):
        continue

    width = timing[2] | ((timing[4] & 0xF0) << 4)
    hblank = timing[3] | ((timing[4] & 0x0F) << 8)
    hfront = timing[8] | ((timing[11] & 0xC0) << 2)
    hsync = timing[9] | ((timing[11] & 0x30) << 4)
    height = timing[5] | ((timing[7] & 0xF0) << 4)
    vblank = timing[6] | ((timing[7] & 0x0F) << 8)
    vfront = (timing[10] >> 4) | ((timing[11] & 0x0C) << 2)
    vsync = (timing[10] & 0x0F) | ((timing[11] & 0x03) << 4)
    physical_width_mm = timing[12] | ((timing[14] & 0xF0) << 4)
    physical_height_mm = timing[13] | ((timing[14] & 0x0F) << 8)
    if not physical_width_mm or not physical_height_mm:
        physical_width_mm = base_physical_width_mm
        physical_height_mm = base_physical_height_mm
    decoded = modeline(
        pixel_clock,
        width,
        hblank,
        hfront,
        hsync,
        bool(timing[17] & 0x02),
        height,
        vblank,
        vfront,
        vsync,
        bool(timing[17] & 0x04),
    )
    if decoded:
        scale = scale_for_mode(
            width,
            height,
            physical_width_mm,
            physical_height_mm,
        )
        print(f"{decoded}\t{scale}")
        raise SystemExit(0)

raise SystemExit(1)
PY
}

# OmacVM.app, HDR and 10-bit colour (the app's switch; ADR 0049): this start
# asked for it (omacvm.deepcolor=1 from the Mac) and the 10-bit virtio-gpu
# driver runs (omacvm-virtio-gpu-load says "omacvm"): the main window's
# output runs at 10 bits. In BT.2100 PQ while QEMU shows PQ, which it says
# with the headroom of the window's display ("edr" in the layout, >= 1):
# the guest tone-maps into what the panel can show now (max_luminance =
# 203 nits x headroom; QEMU does not let macOS tone-map again), and SDR
# white is 203 nits (BT.2408), the Mac's SDR white. "edr" 0 (QEMU cannot
# show PQ) or none (an older runtime): 10-bit sRGB, still with
# supports_hdr: Hyprland only sets or clears an output's HDR metadata while
# it says it supports HDR, and a KMS recorder (gpu-screen-recorder) reads that
# metadata from the connector (linux-virtio-gpu-hdr-metadata.patch). hl.monitor
# keeps the fields of the output's last rule, so after PQ it stayed on anyway
# and the metadata went back to SDR (measured); said here, it does not hang
# on that. omacvm_app.lua turns Hyprland's auto HDR off, so the output stays
# SDR also for a full-screen HDR window. Before QEMU's first
# layout the output stays as it is. QEMU's EDID has no HDR block, so the
# output's HDR support is stated here. Only the main window's output: the
# other displays' windows draw through an 8-bit layer without PQ
# (omacvm-cocoa-displays.patch). An app before this switch (its hidden hdr
# default: omacvm.hdr=1, QEMU tags 10-bit frames PQ by itself): PQ at 1600.
hdr_fields() {
  local OMACVM_HDR="" OMACVM_DEEPCOLOR="" edr
  [[ ${1:-} == Virtual-1 ]] || return 0
  local host_env=${OMACVM_HOST_ENV:-/run/omacvm/host.env}
  [[ -r $host_env ]] && source "$host_env"
  [[ $OMACVM_DEEPCOLOR == 1 || $OMACVM_HDR == 1 ]] || return 0
  # The running driver must be the 10-bit one: the loader says so, and it is
  # out of tree (taint O).
  [[ $(cat "${OMACVM_VIRTIO_GPU_STATUS:-/run/omacvm/virtio-gpu}" 2>/dev/null) == omacvm* ]] || return 0
  [[ $(cat "${OMACVM_VIRTIO_GPU_TAINT:-/sys/module/virtio_gpu/taint}" 2>/dev/null) == *O* ]] || return 0
  if [[ $OMACVM_DEEPCOLOR != 1 ]]; then
    printf ', bitdepth = 10, cm = "hdr", supports_wide_color = 1, supports_hdr = 1, max_luminance = 1600, min_luminance = 0.0005, sdr_max_luminance = 203'
    return 0
  fi
  edr=$(python3 - "$layout_file" <<'PY' 2>/dev/null
import json, math, sys
try:
    layout = json.load(open(sys.argv[1]))["layout"]
except (OSError, ValueError, KeyError, TypeError):
    raise SystemExit(1)                       # no layout from QEMU yet
for o in layout if isinstance(layout, list) else []:
    if isinstance(o, dict) and o.get("output") == "Virtual-1":
        v = o.get("edr")
        # From QEMU, so a number; anything else counts as none.
        ok = isinstance(v, (int, float)) and not isinstance(v, bool) and math.isfinite(v)
        print(f"{min(max(v, 1.0), 16.0):.2f}" if ok and v >= 1 else "none")
        raise SystemExit(0)
print("none")
PY
) || return 0
  if [[ $edr == none ]]; then
    printf ', bitdepth = 10, cm = "srgb", supports_wide_color = 1, supports_hdr = 1'
  else
    printf ', bitdepth = 10, cm = "hdr", supports_wide_color = 1, supports_hdr = 1, max_luminance = %s, min_luminance = 0.0005, sdr_max_luminance = 203' \
      "$(python3 -c 'import sys; print(round(203 * float(sys.argv[1])))' "$edr")"
  fi
}

# hdr_tonemap HDR: Virtual-1's tone map for windows. On an HDR output Chrome
# and Chromium draw the whole window in PQ (SDR white at 203 nits, HDR video
# already fitted into the headroom by the browser) and say max 1000 nits.
# Hyprland 0.56 tone-maps a window above the output's max_luminance with a
# curve that also lowers SDR white (to about half at headroom 1): every page
# looked gray. So while Virtual-1 runs PQ, windows are only clipped at
# max_luminance (tonemap "clamp"). SDR windows are not tone-mapped either
# way. The rule is for every window, also on the other Mac displays (8-bit
# SDR): a client that always sends PQ there gets its reference white (203
# nits) at that display's white and brighter parts clipped (OmacVM's
# cm_helpers.glsl, hypr-capture/; Hyprland's own clipped it from 80 nits).
# Chrome and mpv draw SDR there. After PQ the same rule says
# Hyprland's default ("on"): 0.56 keeps a rule's tone map on open windows
# when the rule is gone. omacvm_app.lua sets it again after a config reload.
# A refused rule is logged once; the file "tonemap" is for omacvm check.
hdr_tonemap() {
  local want=on had response
  [[ $1 == *'cm = "hdr"'* ]] && want=clamp
  had=$(cat "$state_dir/tonemap" 2>/dev/null || true)
  # Unchanged, or never on: nothing to send.
  [[ $want == "$had" || ($want == on && -z $had) ]] && return 0
  response=$(hyprctl eval "hl.window_rule({ name = \"omacvm-hdr\", match = { class = \".*\" }, tonemap = \"$want\" })" 2>&1) || true
  if [[ $response == ok ]]; then
    printf '%s\n' "$want" > "$state_dir/tonemap"
    rm -f "$state_dir/tonemap.refused"
  elif [[ ! -e $state_dir/tonemap.refused ]]; then
    printf 'omacvm-display-sync: Hyprland rejected tonemap %s: %s\n' "$want" "$response" >&2
    : > "$state_dir/tonemap.refused"
  fi
}

# A rule in monitors.lua that names OUTPUT (not in a comment). Omarchy 4.5's
# own one-line scale rule for Virtual-1 (its scale buttons, keys and menu write
# it) is Omarchy's scale, read above, not the user's rule (#738).
user_rule() {
  [[ -r $monitor_config ]] || return 1
  local code
  code=$(grep -vxE 'hl\.monitor\(\{ output = "Virtual-1", mode = "preferred", position = "auto", scale = [0-9]+(\.[0-9]+)? \}\)[[:space:]]*' "$monitor_config" |
    sed 's/--.*$//') || true
  grep -qE "output[[:space:]]*=[[:space:]]*[\"']$1[\"']" <<<"$code"
}

# output_positions LAYOUT OUTPUT:WIDTH:HEIGHT:SCALE ...: one "OUTPUT XxY" line
# each. The Mac's arrangement is in points; Hyprland's in logical pixels,
# which differ when an output has its own scale (Omarchy's zoom on the main
# one): displays beside the main one stay beside it, the rest keep their
# offset, scaled. Without an arrangement: Virtual-1 at 0x0, the rest to its right.
# The places never overlap (Hyprland warns "Monitor Virtual-2 overlaps with
# other monitor(s)" and the pointer can get lost there): an output that would
# overlap one placed before it moves away from the main one, on the axis it
# sits beside it on the Mac, until it only touches.
output_positions() {
  python3 - "$@" <<'PY'
import json
import sys

try:
    layout = {o["output"]: o for o in json.load(open(sys.argv[1]))["layout"]}
except (OSError, ValueError, KeyError, TypeError):
    layout = {}
outputs = {}
for arg in sys.argv[2:]:
    name, w, h, scale = arg.split(":")
    s = float(scale) if scale not in ("", "auto") else 1.0
    outputs[name] = (int(w) / s, int(h) / s)

main = layout.get("Virtual-1")
if not main or "Virtual-1" not in outputs:
    for name in outputs:
        print(name, "0x0" if name == "Virtual-1" else "auto-right")
    raise SystemExit(0)

mw, mh = outputs["Virtual-1"]
places = {}
for name, (lw, lh) in outputs.items():
    box = layout.get(name)
    if not box:
        continue
    def axis(pos, size, own, main_pos, main_size, main_logical):
        if pos >= main_pos + main_size:          # after the main display
            return pos - (main_pos + main_size) + main_logical
        if pos + size <= main_pos:               # before it
            return pos + size - main_pos - own
        return (pos - main_pos) * main_logical / main_size
    places[name] = (
        axis(box["x"], box["width"], lw, main["x"], main["width"], mw),
        axis(box["y"], box["height"], lh, main["y"], main["height"], mh),
    )


def overlaps(a, b):
    return a[0] < b[0] + b[2] and b[0] < a[0] + a[2] and a[1] < b[1] + b[3] and b[1] < a[1] + a[3]


settled = []
for name in sorted(places, key=lambda n: (n != "Virtual-1", n)):
    x, y = (round(v) for v in places[name])
    w, h = outputs[name]
    box = layout[name]
    vertical = (box["y"] >= main["y"] + main["height"] or
                box["y"] + box["height"] <= main["y"])
    for _ in range(len(settled) + 1):
        hit = next((r for r in settled if overlaps((x, y, w, h), r)), None)
        if not hit:
            break
        if vertical:
            y = hit[1] - h if box["y"] < main["y"] else hit[1] + hit[3]
        else:
            x = hit[0] - w if box["x"] < main["x"] else hit[0] + hit[2]
        x, y = round(x), round(y)
    places[name] = (x, y)
    settled.append((x, y, w, h))
minx = min(x for x, _ in places.values())
miny = min(y for _, y in places.values())
for name in outputs:
    if name in places:
        x, y = places[name]
        print(name, f"{round(x - minx)}x{round(y - miny)}")
    else:
        print(name, "auto-right")
PY
}

# apply_order SHOWN OUTPUT:WIDTH:HEIGHT:SCALE:POSITION ...: the outputs, one a
# line, in an order where no rule puts its output over another one's current
# place (SHOWN: Hyprland's j/monitors). Each rule is its own monitor reload in
# Hyprland: moving the main output down under an external above it before the
# external went up overlapped them for a moment, and Hyprland put up its
# overlap warning. No such order (a swap): the given order.
apply_order() {
  python3 - "$@" <<'PY'
import json
import re
import sys


def overlaps(a, b):
    return a[0] < b[0] + b[2] and b[0] < a[0] + a[2] and a[1] < b[1] + b[3] and b[1] < a[1] + a[3]


try:
    shown = json.loads(sys.argv[1])
except ValueError:
    shown = []
now = {}
for m in shown if isinstance(shown, list) else []:
    try:
        if m.get("disabled"):
            continue
        s = float(m["scale"]) or 1.0
        w, h = m["width"] / s, m["height"] / s
        if int(m.get("transform", 0)) % 2:
            w, h = h, w
        now[m["name"]] = (m["x"], m["y"], w, h)
    except (AttributeError, KeyError, TypeError, ValueError, ZeroDivisionError):
        continue
names, targets = [], {}
for item in sys.argv[2:]:
    name, w, h, scale, pos = item.split(":", 4)
    names.append(name)
    place = re.fullmatch(r"(-?\d+)x(-?\d+)", pos)
    try:
        s = float(scale) if scale not in ("", "auto") else 1.0
        if place:
            targets[name] = (int(place[1]), int(place[2]), int(w) / s, int(h) / s)
    except (ValueError, ZeroDivisionError):
        pass
left = list(names)
while left:
    pick = next((n for n in left if n not in targets or
                 not any(overlaps(targets[n], r) for k, r in now.items() if k != n)), left[0])
    print(pick)
    left.remove(pick)
    if pick in targets:
        now[pick] = targets[pick]
PY
}

# follow_check OUTPUT HASH MODE SCALE POSITION HDR SHOWN: whether to send the
# rule; SHOWN is Hyprland's j/monitors. Exit 0: send it (and it is
# counted); 1: Hyprland already shows exactly that (mode, rate, scale, place),
# so a modeset would only make the screen flash and its buffers be made
# again; 2: held. With scale "auto" Hyprland picks the scale itself, so the
# scale counts as shown when this same rule was the last one Hyprland took.
# HDR is not in j/monitors: the HDR part counts as shown when the last rule
# Hyprland took had it (sent_ok writes both after Hyprland said ok). The hold is the guard against a loop: an output that
# changed 6 times in 10 s between only two states (ping-pong), or 12 times
# in 10 s at all, keeps what it shows for 60 s and the reason is logged once
# (journal, and the file "held" for omacvm check); then it looks once more
# (the window may have changed meanwhile). A window being resized
# changes it about once a second (QEMU waits a second), to new sizes each
# time: that is never held.
follow_check() {
  python3 - "$state_dir" "$0" "$@" <<'PY'
import json
import os
import pathlib
import re
import subprocess
import sys
import time

state, self_path, output, digest, mode, scale, position, hdr, shown = sys.argv[1:10]
WINDOW, PINGPONG, STORM, HOLD = 10.0, 6, 12, 60.0
d = pathlib.Path(state)
d.mkdir(parents=True, exist_ok=True)
now = time.time()


def log(message: str) -> None:
    print(f"omacvm-display-sync: {message}", file=sys.stderr, flush=True)


hold = d / f"{output}.hold"
try:
    until = float(hold.read_text().split()[0])
except (OSError, ValueError, IndexError):
    until = 0.0
if now < until:
    raise SystemExit(2)

# Already shown? modeline CLOCK W HSS HSE HTOTAL H VSS VSE VTOTAL ...
f = mode.split()
try:
    width, height = int(f[2]), int(f[6])
    refresh = int(f[1]) * 1e6 / (int(f[5]) * int(f[9]))
    want_scale = float(scale) if scale != "auto" else None
except (IndexError, ValueError, ZeroDivisionError):
    width = height = 0
try:
    shown_hdr = (d / f"{output}.hdr").read_text()
except OSError:
    shown_hdr = None
try:
    last_sent = (d / f"{output}.sent").read_text().strip()
except OSError:
    last_sent = None
try:
    monitors = json.loads(shown)
except ValueError:
    monitors = []
for m in monitors if isinstance(monitors, list) else []:
    if not isinstance(m, dict) or m.get("name") != output or m.get("disabled"):
        continue
    place = re.fullmatch(r"(-?\d+)x(-?\d+)", position)
    try:
        same = (
            width and m["width"] == width and m["height"] == height
            and abs(float(m["refreshRate"]) - refresh) < 0.5
            and (abs(float(m["scale"]) - want_scale) < 0.001 if want_scale is not None
                 else last_sent == digest)
            and shown_hdr == hdr
        )
        if same and place:
            same = (m["x"], m["y"]) == (int(place[1]), int(place[2]))
    except (KeyError, TypeError, ValueError):
        same = False
    if same:
        raise SystemExit(1)
    # Only the HDR part moved (QEMU's headroom follows the panel's
    # brightness, at most once a second): send it, but it is no layout
    # change, so it does not count towards the hold.
    try:
        if (width and m["width"] == width and m["height"] == height
                and abs(float(m["refreshRate"]) - refresh) < 0.5
                and (abs(float(m["scale"]) - want_scale) < 0.001 if want_scale is not None
                     else True)
                and shown_hdr is not None and shown_hdr != hdr
                and (not place or (m["x"], m["y"]) == (int(place[1]), int(place[2])))):
            raise SystemExit(0)
    except (KeyError, TypeError, ValueError):
        pass

# Count it; hold the output if it keeps changing.
history = d / f"{output}.history"
events = []
try:
    for line in history.read_text().splitlines():
        t, _, h = line.partition(" ")
        if now - float(t) < WINDOW:
            events.append((float(t), h))
except (OSError, ValueError):
    events = []
events.append((now, digest))
distinct = len({h for _, h in events})
if len(events) >= STORM or (len(events) >= PINGPONG and distinct <= 2):
    kind = "between two states" if distinct <= 2 else "to new states"
    reason = (f"{output} changed {len(events)} times in {WINDOW:.0f} s ({kind}); "
              f"keeping what it shows for {HOLD:.0f} s")
    log(reason)
    hold.write_text(f"{now + HOLD}\n")
    history.unlink(missing_ok=True)
    with open(d / "held", "a") as held:
        held.write(f"{time.strftime('%Y-%m-%dT%H:%M:%S')} {reason}\n")
    # One look when the hold ends, with what is current then.
    subprocess.Popen(["sh", "-c", f'sleep {HOLD + 1:.0f}; exec "$0" --once', self_path],
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)
    raise SystemExit(2)
history.write_text("".join(f"{t} {h}\n" for t, h in events))
PY
}

# sent_ok OUTPUT HASH HDR: Hyprland took the rule; what follow_check compares
# with next time (only now, so a rule Hyprland refused is sent again).
sent_ok() {
  printf '%s' "$3" > "$state_dir/$1.hdr"
  printf '%s\n' "$2" > "$state_dir/$1.sent"
}

# keep_rule OUTPUT RULE: the rule the output shows now. omacvm_app.lua sets it
# again while Hyprland reloads its config (an Omarchy theme switch reloads it):
# without it the output falls back to monitors.lua's rule ("auto" place) until
# this script runs after the reload. With Omanotch's NOTCH output placed above
# it, "auto" put the screen to the right of NOTCH for a moment, and the picture
# slid in again (the theme switch flickered).
keep_rule() {
  local tmp
  tmp=$(mktemp "$state_dir/.rule.XXXXXX") || return 0
  printf '%s\n' "$2" > "$tmp" && mv -f "$tmp" "$state_dir/$1.rule"
}

# park_gone SHOWN OUTPUT...: an output this script placed that is gone now
# (the Mac's other display left full screen) gets a rule with an automatic
# place. Hyprland keeps the last rule per output: when the display comes back
# (full screen again) the old place could overlap where the main output is
# now, and Hyprland warned before this script could move anything.
park_gone() {
  local shown=$1 sent name
  shift
  local -A here=()
  for name in "$@"; do here[$name]=1; done
  for sent in "$state_dir"/Virtual-*.sent; do
    [[ -f $sent ]] || continue
    name=${sent##*/}; name=${name%.sent}
    [[ -z ${here[$name]:-} && $name != Virtual-1 ]] || continue
    # Still shown (its connector is not read yet): leave it.
    grep -q "\"name\": *\"$name\"" <<<"$shown" && continue
    if [[ $(hyprctl eval "hl.monitor({ output = \"$name\", mode = \"preferred\", position = \"auto-right\", scale = \"auto\" })" 2>&1) == ok ]]; then
      rm -f "$sent" "$state_dir/$name.hdr" "$state_dir/$name.rule"
    fi
  done
}

apply_preferred_modes() {
  local connector
  local connector_name
  local mode
  local output
  local preferred
  local response
  local rule
  local scale
  local position
  local i w h
  local hdr digest
  local -a outputs=() modes=() scales=() sizes=()
  local -A placed=()

  shopt -s nullglob
  for connector in "$drm_root"/card*-Virtual-*; do
    [[ -d $connector && -r $connector/status && -r $connector/edid ]] || continue
    [[ $(<"$connector/status") == connected ]] || continue

    connector_name=${connector##*/}
    output=${connector_name#*-}
    if ! preferred=$(preferred_mode_from_edid "$connector/edid" "$output"); then
      continue
    fi
    IFS=$'\t' read -r mode scale <<<"$preferred"
    [[ -n $mode && -n $scale ]] || continue
    outputs+=("$output"); modes+=("$mode"); scales+=("$scale")
    # modeline CLOCK WIDTH ... HEIGHT ...
    read -r _ _ w _ _ _ h _ <<<"$mode"
    sizes+=("$output:$w:$h:$scale")
  done
  shopt -u nullglob
  ((${#outputs[@]})) || return 0

  while read -r output position; do
    [[ -n $output ]] && placed[$output]=$position
  done < <(output_positions "$layout_file" "${sizes[@]}" 2>/dev/null || true)

  # One at a time: the watcher, the reload hook and omacvm-displays all call this.
  mkdir -p "$state_dir"
  local lock_fd
  if command -v flock >/dev/null && exec {lock_fd}>"$state_dir/lock"; then
    flock -w 20 "$lock_fd" || true
  fi
  local shown
  shown=$(hyprctl -j monitors 2>/dev/null) || shown='[]'

  local -a items=() order=()
  local -A index=()
  for i in "${!outputs[@]}"; do
    output=${outputs[$i]}
    position=${placed[$output]:-}
    [[ -n $position ]] || { [[ $output == Virtual-1 ]] && position=0x0 || position=auto-right; }
    placed[$output]=$position
    index[$output]=$i
    items+=("${sizes[$i]}:$position")
  done
  mapfile -t order < <(apply_order "$shown" "${items[@]}" 2>/dev/null)
  ((${#order[@]} == ${#outputs[@]})) || order=("${outputs[@]}")

  park_gone "$shown" "${outputs[@]}"

  for output in "${order[@]}"; do
    i=${index[$output]}
    mode=${modes[$i]} scale=${scales[$i]}
    position=${placed[$output]}

    # Aquamarine 0.14 does not refresh its mode cache when an existing DRM
    # connector's EDID or physical size changes. A complete modeline bypasses
    # the stale mode cache; an explicit scale calculated from the fresh EDID
    # avoids using the stale fullscreen dimensions for Hyprland's auto scale.
    # Hyprland's Lua config parser requires eval instead of the legacy keyword
    # command.
    # OmacVM: these outputs only, each placed. A catch-all rule ("", auto
    # position) also hit Omanotch's hidden NOTCH output; the screen then sat
    # to the right of NOTCH, NOTCH followed it, and both kept moving right.
    # A rule naming this output would replace the user's own for it (it comes
    # later): with one in monitors.lua, the user's rule stays and the screen no
    # longer follows the window.
    if user_rule "$output"; then
      rm -f "$state_dir/$output.rule"
      if [[ -z ${said_user_rule:-} ]]; then
        printf 'omacvm-display-sync: %s has its own rule in %s; not following the window\n' "$output" "$monitor_config" >&2
        said_user_rule=1
      fi
      continue
    fi
    hdr=$(hdr_fields "$output")
    rule="hl.monitor({ output = \"$output\", mode = \"$mode\", position = \"$position\", scale = \"$scale\"$hdr })"
    # The notch strip is the main window's (full screen on the built-in display).
    if [[ $output == Virtual-1 ]]; then
      notch_bar "$mode" "$scale"
    fi
    digest=$(cksum <<<"$rule" | cut -d' ' -f1)
    # 1: Hyprland shows it already (keep it for a reload), 2: held (the tone
    # map too: it goes with the output's rule).
    follow_check "$output" "$digest" "$mode" "$scale" "$position" "$hdr" "$shown" || {
      if (($? == 1)); then
        keep_rule "$output" "$rule"
        [[ $output != Virtual-1 ]] || hdr_tonemap "$hdr"
      fi
      continue
    }
    # Before the output goes PQ, so no frame is tone-mapped.
    [[ $output != Virtual-1 ]] || hdr_tonemap "$hdr"
    if ! response=$(hyprctl eval "$rule" 2>&1); then
      printf 'omacvm-display-sync: failed to apply %s to %s: %s\n' \
        "$mode" "$output" "$response" >&2
    elif [[ $response != ok ]]; then
      printf 'omacvm-display-sync: Hyprland rejected %s for %s: %s\n' \
        "$mode" "$output" "$response" >&2
    else
      sent_ok "$output" "$digest" "$hdr"
      keep_rule "$output" "$rule"
    fi
  done
  [[ -z ${lock_fd:-} ]] || exec {lock_fd}>&-
}

# OmacVM.app before 3.0.0: when the window covers the strip beside the notch
# (full screen in notch mode), Omarchy's bar gets that strip's height, so nothing but the
# bar sits beside the camera. Elsewhere the bar keeps its own size. Writes only
# lines marked "omacvm-notch" in ~/.config/omarchy/shell.toml (watched live).
# A 3.0.0 app sends no omacvm.notch: the marked lines are taken out.
notch_bar() {
  local mode=$1 scale=$2 w h want="" f=${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/shell.toml
  read -r _ _ w _ _ _ h _ <<<"$mode"
  local OMACVM_NOTCH="" OMACVM_SCREEN=""
  [[ -r /run/omacvm/host.env ]] && source /run/omacvm/host.env
  if [[ -n $OMACVM_NOTCH && $OMACVM_SCREEN == "${w}x${h}" ]]; then
    want=$(python3 -c "import math,sys; print(math.ceil(float(sys.argv[1]) / float(sys.argv[2])))" "$OMACVM_NOTCH" "$scale" 2>/dev/null || true)
  fi
  [[ -f $f ]] || { [[ -n $want ]] || return 0; mkdir -p "$(dirname "$f")"; : > "$f"; }
  local tmp; tmp=$(mktemp)
  grep -v 'omacvm-notch' "$f" > "$tmp" || true
  if [[ -n $want ]]; then
    if grep -q '^\[bar\]' "$tmp"; then
      grep -q '^size-horizontal' "$tmp" && { rm -f "$tmp"; return 0; }   # the user set a size: keep it
      sed -i "/^\[bar\]/a size-horizontal = $want  # omacvm-notch" "$tmp"
    else
      printf '[bar]  # omacvm-notch\nsize-horizontal = %s  # omacvm-notch\n' "$want" >> "$tmp"
    fi
  fi
  cmp -s "$tmp" "$f" || cat "$tmp" > "$f"
  rm -f "$tmp"
  [[ -s $f ]] || rm -f "$f"
}

reload_on_display_change() {
  local action=""
  local hotplug=""
  local line

  while IFS= read -r line; do
    if [[ -z $line ]]; then
      if [[ $action == change && $hotplug == 1 ]]; then
        apply_preferred_modes
      fi
      action=""
      hotplug=""
      continue
    fi

    case "$line" in
      ACTION=*) action=${line#ACTION=} ;;
      HOTPLUG=*) hotplug=${line#HOTPLUG=} ;;
    esac
  done

  # udev normally separates events with a blank line, but also handle a final
  # complete event when a test stream or a terminating monitor ends at EOF.
  if [[ $action == change && $hotplug == 1 ]]; then
    apply_preferred_modes
  fi
}

# Config reloads can restore Aquamarine's cached preferred mode without a
# DRM hotplug event. Re-read the live EDID once, without starting a watcher.
if [[ ${1:-} == --once ]]; then
  apply_preferred_modes
  exit 0
fi

if [[ ${1:-} == --from-stdin ]]; then
  reload_on_display_change
  exit 0
fi

# QEMU changes the virtio-gpu EDID whenever its Cocoa window changes size.
# Linux exposes that as a DRM hotplug change.
apply_preferred_modes
while true; do
  udevadm monitor --udev --subsystem-match=drm --property |
    reload_on_display_change || true
  sleep 1
done
