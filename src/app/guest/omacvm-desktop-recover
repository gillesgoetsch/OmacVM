#!/bin/bash
# OmacVM.app: a GPU context of the VM's desktop was lost on the Mac. QEMU
# names it in logs/gpu-memory; the app sees it there and runs this through
# the guest agent, as root. Nothing in the VM knows otherwise: its Mesa does
# not report the loss, and Hyprland 0.56 would only stop if it did.
#   omacvm-desktop-recover desktop graphics|memory|guard
#       Hyprland lost its context: it draws black from then on (memory: macOS
#       ran short; guard: the VM's graphics reached the most this Mac lets
#       them have, desktop reserve included). The login
#       manager starts again, which ends the session: every app open in it
#       closes and what was not saved in them is lost. A note for the new
#       session names those apps. With autologin off, the login screen comes.
#       Was the session locked, the new one locks itself again (autologin
#       must not bring back an unlocked desktop with nobody at the Mac).
#   omacvm-desktop-recover shell
#       The shell lost its context (Omarchy's bar and launcher, Quickshell):
#       only the shell starts again, no app closes.
#   omacvm-desktop-recover notify
#       In the new session (Hyprland's autostart, as the user): shows the note.
#   omacvm-desktop-recover app NAME guard|pressure
#       An app (not the desktop) lost its context on the Mac: the graphics
#       memory apps may use was full (the rest is kept for the desktop), or
#       macOS was short of memory. The VM's Mesa cannot tell the app, so
#       Chrome or Chromium would draw nothing until it is restarted: its GPU
#       process (a process of the user's named NAME with the argument
#       --type=gpu-process) is ended, and the app starts a new one by itself,
#       which also gives the lost context's memory back (measured with Chrome
#       and Chromium; other Chromium-based apps such as Electron's have the
#       same GPU process, not measured). At most once per app
#       in 6 minutes and 3 times in an hour: Chrome counts each as a crash
#       and turns its GPU off for the session after 3 recent ones (it
#       forgives one per 5 minutes). A note says what happened.
#   omacvm-desktop-recover venus NAME venus|guard
#       A Vulkan (Venus) context of an app ended on the Mac: the Mac refused
#       its Vulkan commands (venus), or the graphics memory apps may use was
#       full (guard). Nothing is ended: the VM's Vulkan driver ends most apps
#       by itself; a Ghostty on Zink stops drawing and takes no typing, and a
#       new Ghostty window waits for it (one Ghostty serves all its windows).
#       For ghostty, $ZINK_OFF says "Ghostty on the CPU for the rest of this
#       boot" (root's, everyone reads it; one line "lost TIME WHY"), which
#       OmacVM's EGL library reads at the next Ghostty's start. A note says
#       what happened and what to do. (3.2.17; older VMs answer with the usage
#       line, exit 2: `app NAME venus` would be taken for a full graphics
#       memory there and end the app's GPU process.)
#   omacvm-desktop-recover stall SECONDS VM_GB MAC_GB
#       The VM stood still that long because macOS ran out of free memory
#       (QEMU's stall note; the VM held VM_GB of the Mac's MAC_GB). A note
#       says so and what helps; nothing restarts.
# Logs to the journal (journalctl -t omacvm-desktop-recover).
set -uo pipefail
ENV=${OMACVM_RECOVER_ENV:-/etc/omacvm/env}
NOTE=${OMACVM_RECOVER_NOTE:-/run/omacvm/desktop/restarted}
# When each app's GPU process was restarted: root's own folder (0700), never
# the user's /run/omacvm (root never writes into a folder the user owns).
STAMPS=${OMACVM_RECOVER_STAMPS:-/run/omacvm-recover}
# Ghostty on the CPU for the rest of this boot (venus): in root's /run/omacvm.
ZINK_OFF=${OMACVM_RECOVER_ZINK_OFF:-/run/omacvm/gl-zink-off}
say() { logger -t omacvm-desktop-recover -- "$*" 2>/dev/null; echo "$*"; }

U=$(sed -n 's/^OMACVM_USER=//p' "$ENV" 2>/dev/null | tail -1)
# A command in the desktop user's session (Hyprland's and Omarchy's environment).
in_session() {
  local uid run
  uid=$(id -u "$U") || return 1
  run=/run/user/$uid
  sudo -u "$U" env HOME="$(getent passwd "$U" | cut -d: -f6)" XDG_RUNTIME_DIR="$run" WAYLAND_DISPLAY=wayland-1 \
    HYPRLAND_INSTANCE_SIGNATURE="$(ls -t "$run/hypr" 2>/dev/null | head -1)" \
    bash -c 'source /usr/share/omarchy/default/bash/env-bootstrap 2>/dev/null; exec "$@"' _ "$@"
}

# The apps with a window now, by name, once each ("chromium, Alacritty").
open_apps() {
  in_session timeout 3 hyprctl clients -j 2>/dev/null | python3 -c '
import json, sys
seen = []
try:
    for c in json.load(sys.stdin):
        n = " ".join(str(c.get("class") or c.get("initialClass") or "").split())[:40]
        if n and n not in seen:
            seen.append(n)
except Exception:
    pass
print(", ".join(seen))' 2>/dev/null
}

# The restarts of NAME's GPU process within the last hour, one time (s) per line.
gpu_restarts() {
  local now=$1 t
  [[ -f $STAMPS/gpu-$2 && ! -L $STAMPS/gpu-$2 ]] || return 0
  while IFS= read -r t; do
    [[ $t =~ ^[0-9]{1,12}$ ]] && (( t > now - 3600 && t <= now )) && echo "$t"
  done < "$STAMPS/gpu-$2"
}

# Ends NAME's GPU process so the app starts a new one (all of them when two
# copies of the app run: which one was lost is not known). Only the desktop
# user's processes whose name is exactly NAME and that have the argument
# --type=gpu-process (Chrome, Chromium and other Chromium-based apps); never
# the desktop's or a shell's. Fails with the reason in WHY_NOT.
WHY_NOT=""
gpu_restart() {
  local name=$1 now uid p comm key real arg word args=() words=() pids=() last n gpu LC_ALL=C
  now=${OMACVM_RECOVER_NOW:-$(date +%s)}
  case $name in
  Hyprland|quickshell|hyprlock|Xwayland|sddm*|systemd*|bash|sh|dash|zsh|fish|"An app")
    WHY_NOT="not an app with its own GPU process"; return 1 ;;
  esac
  uid=$(id -u "$U" 2>/dev/null) || { WHY_NOT="no such user $U"; return 1; }
  # The folder for the times: made by root, root's only; a link or anything
  # else there and nothing restarts.
  [[ -e $STAMPS || -L $STAMPS ]] || mkdir -m 700 "$STAMPS" 2>/dev/null
  if [[ -L $STAMPS || ! -d $STAMPS || $(stat -c '%u %a' "$STAMPS" 2>/dev/null) != "$(id -u) 700" ]]; then
    WHY_NOT="$STAMPS is not a folder of its own"; return 1
  fi
  last=$(gpu_restarts "$now" "$name" | sort -n | tail -1)
  n=$(gpu_restarts "$now" "$name" | wc -l)
  if [[ -n $last ]] && (( now - last < 360 )); then
    WHY_NOT="restarted $(( (now - last) / 60 )) min ago"; return 1
  fi
  if (( n >= 3 )); then
    WHY_NOT="restarted $n times in the last hour"; return 1
  fi
  # Read with bash alone (no regex: the name may hold "."). One argument must
  # be exactly --type=gpu-process. Chromium's GPU process sets its process
  # title: its arguments joined with spaces into one string, so a command
  # line of one string is split at spaces; any other keeps its arguments.
  for p in /proc/[0-9]*; do
    IFS= read -r comm 2>/dev/null < "$p/comm" || continue
    [[ $comm == "$name" ]] || continue
    real=""
    while IFS=$'\t' read -r key real _; do [[ $key == Uid: ]] && break; real=""; done 2>/dev/null < "$p/status"
    [[ $real == "$uid" ]] || continue
    args=()
    while IFS= read -r -d '' arg || [[ -n $arg ]]; do
      [[ -n $arg ]] && args+=("$arg")
    done 2>/dev/null < "$p/cmdline"
    words=("${args[@]}")
    (( ${#args[@]} == 1 )) && read -ra words <<< "${args[0]}"
    gpu=0
    for word in "${words[@]}"; do [[ $word == "--type=gpu-process" ]] && gpu=1; done
    (( gpu )) && pids+=("${p#/proc/}")
  done
  (( ${#pids[@]} )) || { WHY_NOT="no GPU process of $name"; return 1; }
  kill -KILL "${pids[@]}" 2>/dev/null
  { gpu_restarts "$now" "$name"; echo "$now"; } > "$STAMPS/gpu-$name.tmp" && mv -f "$STAMPS/gpu-$name.tmp" "$STAMPS/gpu-$name"
  say "ended $name's GPU process (pid ${pids[*]}): $name starts a new one"
}

case ${1:-} in
desktop)
  why=${2:-graphics}
  [[ $why == memory || $why == guard ]] || why=graphics
  apps=""; locked=0
  [[ -n $U ]] && apps=$(open_apps)
  [[ -n $U ]] && in_session timeout 3 omarchy-hyprland-session-locked >/dev/null 2>&1 && locked=1
  # Written as the user: root never writes into a folder the user owns.
  if [[ -n $U ]] && install -d -m 700 -o "$U" -g "$(id -gn "$U")" "$(dirname "$NOTE")"; then
    printf 'why=%s\napps=%s\nat=%s\nlocked=%s\n' "$why" "$apps" "$(date +%H:%M)" "$locked" |
      sudo -u "$U" sh -c 'cat > "$1.tmp" && mv -f "$1.tmp" "$1"' _ "$NOTE"
  fi
  say "the desktop lost its GPU context on the Mac ($why): restarting the session; closing: ${apps:-no app windows}"
  # The login manager logs the user in again (autologin) or shows its screen.
  exec systemctl restart sddm
  ;;
shell)
  [[ -n $U ]] || { say "no desktop user in $ENV"; exit 1; }
  say "the shell (Quickshell) lost its GPU context on the Mac: restarting it"
  in_session setsid -f omarchy-restart-shell >/dev/null 2>&1 < /dev/null
  ;;
notify)
  [[ -r $NOTE ]] || exit 0
  why=$(sed -n 's/^why=//p' "$NOTE"); apps=$(sed -n 's/^apps=//p' "$NOTE"); at=$(sed -n 's/^at=//p' "$NOTE")
  locked=$(sed -n 's/^locked=//p' "$NOTE")
  rm -f "$NOTE"
  # Locked before: lock again first. The shell may not take a lock yet this
  # early in the session: ask until Hyprland holds one, for half a minute.
  if [[ $locked == 1 ]]; then
    for _ in $(seq 30); do
      omarchy-hyprland-session-locked >/dev/null 2>&1 && break
      omarchy-system-lock >/dev/null 2>&1
      sleep 1
    done
    omarchy-hyprland-session-locked >/dev/null 2>&1 || say "could not lock the new session again"
  fi
  if [[ $why == memory ]]; then cause="macOS ran short of memory for the VM's graphics"
  elif [[ $why == guard ]]; then cause="the VM's graphics reached the most this Mac lets them use"
  else cause="the VM's graphics on the Mac failed"; fi
  if [[ -n $apps ]]; then closed="These apps were closed: $apps. Anything not saved in them is lost."
  else closed="Apps that were open were closed; anything not saved in them is lost."; fi
  # What was lost first: the popup shows only the first lines.
  text="$closed At ${at:-?} $cause and the screen went black, so OmacVM restarted the desktop."
  # The notification daemon comes up with the session: try for half a minute.
  for _ in $(seq 15); do
    notify-send -a OmacVM -u critical "The desktop was restarted" "$text" 2>/dev/null && exit 0
    sleep 2
  done
  say "could not show the note: $text"
  ;;
app)
  [[ -n $U ]] || { say "no desktop user in $ENV"; exit 1; }
  # The name is the app's process name as QEMU kept it (letters, digits, . _ -).
  name=$(printf '%s' "${2:-}" | tr -cd 'A-Za-z0-9._-' | cut -c1-40); name=${name:-An app}
  if [[ ${3:-} == pressure ]]; then
    cause="macOS ran short of memory, so $name lost its graphics on the Mac."
    helps="Close something on the Mac or in the VM."
  else
    cause="$name used all the graphics memory apps may have on this Mac (the rest is kept for the desktop), so it lost its graphics."
    helps="Close some of its tabs or windows."
  fi
  say "$name lost its GPU context on the Mac (${3:-guard}); the desktop keeps drawing"
  if gpu_restart "$name"; then
    title="$name's graphics were restarted"
    body="$cause OmacVM restarted $name's GPU process: its windows draw again in a few seconds and open tabs stay; pages with WebGL may need a reload. $helps If $name goes blank again, quit it and open it again."
  else
    say "$name's GPU process was not restarted: $WHY_NOT"
    title="$name stopped drawing"
    body="$cause The desktop keeps running. $helps Then reload or restart $name."
  fi
  in_session notify-send -a OmacVM -u normal "$title" "$body" 2>/dev/null || say "could not show the note: $body"
  ;;
venus)
  # The name is the app's process name as QEMU kept it (letters, digits, . _ -).
  name=$(printf '%s' "${2:-}" | tr -cd 'A-Za-z0-9._-' | cut -c1-40); name=${name:-An app}
  why=venus; [[ ${3:-} == guard ]] && why=guard
  if [[ $why == guard ]]; then
    cause="$name used all the graphics memory apps may have on this Mac, so its Vulkan graphics ended."
  else
    cause="The Mac refused $name's Vulkan commands, so its Vulkan graphics ended."
  fi
  say "$name lost its Vulkan (Venus) context on the Mac ($why); nothing is ended, the desktop keeps drawing"
  if [[ $name == ghostty ]]; then
    # Root's own file in root's folder (0755): never through a link, never in a folder
    # someone else owns. Written once per boot; a second loss keeps the first line.
    dir=$(dirname "$ZINK_OFF")
    [[ -e $dir || -L $dir ]] || install -d -m 755 "$dir" 2>/dev/null
    if [[ -L $dir || ! -d $dir || $(stat -c '%u' "$dir" 2>/dev/null) != "$(id -u)" ]]; then
      say "$dir is not root's own folder: Ghostty may start on Zink again"
    elif [[ -L $ZINK_OFF || ( -e $ZINK_OFF && ! -f $ZINK_OFF ) ]]; then
      say "$ZINK_OFF is not a plain file: Ghostty may start on Zink again"
    elif [[ ! -e $ZINK_OFF ]]; then
      printf 'lost %s %s\n' "$(date -Iseconds)" "$why" > "$ZINK_OFF.tmp.$$" && chmod 644 "$ZINK_OFF.tmp.$$" &&
        mv -f "$ZINK_OFF.tmp.$$" "$ZINK_OFF" && say "Ghostty starts on the CPU for the rest of this boot ($ZINK_OFF)"
      rm -f "$ZINK_OFF.tmp.$$"
    fi
    title="Ghostty stopped drawing"
    body="$cause Its windows no longer draw or take typing, and a new Ghostty window waits for it: close it first (Terminate in the window that says it is not responding). Programs running in it end. The next Ghostty starts on the CPU until the VM restarts."
  else
    title="$name stopped drawing"
    body="$cause The desktop keeps running. Restart $name; if it closed by itself, open it again."
  fi
  [[ -n $U ]] || { say "no desktop user in $ENV; the note: $body"; exit 1; }
  in_session notify-send -a OmacVM -u normal "$title" "$body" 2>/dev/null || say "could not show the note: $body"
  ;;
stall)
  [[ -n $U ]] || { say "no desktop user in $ENV"; exit 1; }
  # Digits only, as the app sends them.
  secs=$(printf '%s' "${2:-}" | tr -cd '0-9' | cut -c1-6)
  vm=$(printf '%s' "${3:-}" | tr -cd '0-9' | cut -c1-5)
  mac=$(printf '%s' "${4:-}" | tr -cd '0-9' | cut -c1-5)
  [[ -n $secs ]] || { say "stall: no time given"; exit 2; }
  uses=""
  [[ -n $vm && -n $mac && $mac != 0 ]] && uses=" (the VM uses $vm GB of this Mac's $mac GB)"
  body="macOS ran out of free memory$uses, so the VM's processors had to wait. A smaller VM memory leaves the Mac more: on the Mac, omacvm resources."
  say "the VM stood still for $secs s: macOS ran out of free memory$uses"
  in_session notify-send -a OmacVM -u normal "The VM stood still for $secs s" "$body" 2>/dev/null || say "could not show the note: $body"
  ;;
*)
  echo "usage: omacvm-desktop-recover desktop graphics|memory|guard | shell | notify | app NAME guard|pressure | venus NAME venus|guard | stall SECONDS VM_GB MAC_GB" >&2
  exit 2
  ;;
esac
