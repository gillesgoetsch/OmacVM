#!/bin/bash
# OmacVM.app: Hyprland's aquamarine with cursor hotspots, for the app's
# "Mac pointer for the VM" (the hidden macPointer setting;
# aquamarine-cursor-plane-hotspot.patch says what it changes and why).
# Omarchy's aquamarine package stays as it is. This builds the same package
# again, from Omarchy's own recipe of the installed version
# (github.com/omacom/omarchy-pkgs: its PKGBUILD, its patches, its sources,
# checked by the recipe's sha256 sums, built by makepkg with this VM's
# makepkg.conf), with the one patch on top, and keeps only the library:
# /usr/local/lib/omacvm/aquamarine/<package version>/libaquamarine.so.N,
# where ld.so does not look. omacvm-app-host hands that folder to Hyprland
# (LD_LIBRARY_PATH of the compositor's unit) only in a start that asks for
# the Mac pointer, and only a build of the installed package version from
# this patch; every other start, and any failure, runs Omarchy's library.
# Built on request (a VM that never asks needs no build): by hand, and by
# omacvm apply in a start that asks. Once a build is there the pacman hook
# builds again after an aquamarine update. Download, patch and build run as a
# user id of their own (no account, nothing else runs as it); root only
# checks and installs the result: the library must have the installed one's
# soname and every symbol it has, so Hyprland loads it as it loads Omarchy's.
# Usage (root):
#   omacvm-aquamarine-build            build for the installed aquamarine
#   omacvm-aquamarine-build --hook     build again if a build was there;
#                                      drops the builds of other versions
#   omacvm-aquamarine-build --lib      prints the folder of the current build
#                                      (exit 1 and nothing: there is none)
#   omacvm-aquamarine-build --status   one line: built for the installed
#                                      aquamarine or why not (exit 1)
#   omacvm-aquamarine-build --remove   the builds go
set -euo pipefail
# Tests only: a made-up file system under this folder, stand-ins on the PATH.
P=${OMACVM_AQUAMARINE_TEST_ROOT:-}
[[ -n $P ]] || PATH=/usr/local/bin:/usr/bin:/bin
self=$(readlink -f "$0")
root=$P/usr/local/lib/omacvm/aquamarine
patch_file=$root/aquamarine-cursor-plane-hotspot.patch
system_lib=$P/usr/lib/libaquamarine.so
# Omarchy's recipes: every version it published is in this repository's history.
recipes=${OMACVM_AQUAMARINE_RECIPES:-https://github.com/omacom/omarchy-pkgs.git}
recipe_path=pkgbuilds/aquamarine
# The build's own user id: no account, no other process runs as it.
builder=64917
own=(-o root -g root); [[ -z $P ]] || own=()
budget=900   # seconds: the pacman hook holds the update for it
work="" stage=""
trap 'rm -rf ${work:+"$work"} ${stage:+"$stage"}' EXIT

say() { echo "omacvm-aquamarine: $*"; }

installed() { pacman -Q aquamarine 2>/dev/null | awk '{ print $2 }' || true; }

stamp_for() { echo "$(sha256sum < "$patch_file" 2>/dev/null | cut -d' ' -f1) $1"; }

lib_of() {   # VERSION: its library file
  local f
  for f in "$root/$1"/libaquamarine.so.*; do
    [[ -f $f && ! -L $f ]] && { echo "$f"; return 0; }
  done
  return 1
}

current() {   # VERSION: built, for this version and from this patch
  [[ -n $1 ]] && lib_of "$1" > /dev/null && [[ $(cat "$root/$1/stamp" 2>/dev/null) == "$(stamp_for "$1")" ]]
}

failed() {   # VERSION WHY: said, and kept for --status
  say "$1: not built: $2"
  { mkdir -p "$root/$1" && printf '%s\n' "$2" > "$root/$1/error"; } 2>/dev/null || true
}

soname() { objdump -p "$1" 2>/dev/null | awk '$1 == "SONAME" { print $2 }'; }

symbols() { nm -D --defined-only "$1" 2>/dev/null | awk '{ print $NF }' | sort -u; }

# pkgver-pkgrel of a PKGBUILD on stdin (read, never run).
recipe_version() {
  awk -F= '$1 == "pkgver" && !v { v = $2 } $1 == "pkgrel" && !r { r = $2 } END { if (v && r) print v "-" r }' | tr -d "\"'"
}

# As the build's own user id, in its own WORK folder: Omarchy's recipe of
# VERSION, the patch on top, makepkg. The library goes to stdout, everything
# else to stderr.
fetch_and_make() {   # VERSION WORK
  local version=$1 w=$2 c recipe="" lib
  exec 3>&1 1>&2
  cd "$w"
  # Without the files: only the recipe's own are fetched, for the commits looked at.
  git clone --quiet --filter=blob:none --no-checkout "$recipes" recipes
  for c in $(git -C recipes log --format=%H -- "$recipe_path/PKGBUILD"); do
    if [[ $(git -C recipes show "$c:$recipe_path/PKGBUILD" | recipe_version) == "$version" ]]; then recipe=$c; break; fi
  done
  [[ -n $recipe ]] || { echo "omacvm-aquamarine: no build: Omarchy's recipes have no aquamarine $version"; return 1; }
  git -C recipes archive "$recipe" "$recipe_path" | tar -x
  cd "$recipe_path"
  cp "$patch_file" omacvm-hotspot.patch
  # The patch after the recipe's own prepare (its patches), with no fuzz:
  # each hunk's context must fit exactly, so on a newer aquamarine it either
  # lands where it belongs or the build stops.
  cat >> PKGBUILD <<EOF

source+=(omacvm-hotspot.patch)
sha256sums+=($(sha256sum < omacvm-hotspot.patch | cut -d' ' -f1))
if declare -f prepare > /dev/null; then eval "omarchy_\$(declare -f prepare)"; else omarchy_prepare() { :; }; fi
prepare() {
  omarchy_prepare
  cd "\$srcdir"/aquamarine-*/
  patch -Np1 -F 0 -i "\$srcdir/omacvm-hotspot.patch"
}
EOF
  # The package's files in pkg/, no archive, no install. Its dependencies are
  # the installed package's own; the tools are checked before (tools).
  makepkg --nodeps --noarchive --noconfirm --noprogressbar
  lib=$(find pkg/aquamarine/usr/lib -maxdepth 1 -type f -name 'libaquamarine.so.*' | head -n1)
  [[ -n $lib ]] || { echo "omacvm-aquamarine: no build: the package has no libaquamarine.so"; return 1; }
  cat "$lib" >&3
}

# What the build needs and this VM lacks ("" = nothing).
tools() {
  local t missing=""
  for t in git makepkg fakeroot cmake hyprwayland-scanner g++ objdump nm patch; do
    command -v "$t" > /dev/null 2>&1 || missing+=" $t"
  done
  echo "${missing# }"
}

build() {   # 0 = built or current; 1 = failed
  local version left rc=0 v keep why missing sys ours
  version=$(installed)
  [[ -n $version ]] || { say "no aquamarine package in this VM"; return 1; }
  [[ $version =~ ^[A-Za-z0-9._+:-]+$ && $version != .* ]] || { say "not a package version: $version"; return 1; }
  if current "$version"; then say "$version: up to date"; return 0; fi
  [[ -f $patch_file ]] || { failed "$version" "no $patch_file"; return 1; }
  sys=$(readlink -f "$system_lib" 2>/dev/null) && [[ -f $sys ]] || { failed "$version" "no $system_lib"; return 1; }
  missing=$(tools)
  [[ -z $missing ]] ||
    { failed "$version" "build tools missing: $missing (pacman -S --needed base-devel git cmake hyprwayland-scanner)"; return 1; }
  left=$((budget - SECONDS))
  if ! { work=$(mktemp -d "$P/var/tmp/omacvm-aquamarine.XXXXXX") && stage=$(mktemp -d "$P/var/tmp/omacvm-aquamarine.XXXXXX") &&
         chown "$builder:$builder" "$work"; }; then
    failed "$version" "no work folder for the build"; return 1
  fi
  # A clean environment, but the proxy (the Mac's, from the build) stays.
  # (The recipe's cmake --build takes its jobs from here; one job takes 10 minutes.)
  keep=(PATH=/usr/local/bin:/usr/bin:/bin:/usr/bin/core_perl "HOME=$work" LC_ALL=C "CMAKE_BUILD_PARALLEL_LEVEL=$(nproc)")
  for v in http_proxy https_proxy all_proxy no_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY; do
    [[ -z ${!v:-} ]] || keep+=("$v=${!v}")
  done
  timeout --kill-after=10 "$left" setpriv --reuid="$builder" --regid="$builder" --clear-groups --no-new-privs -- \
    env -i "${keep[@]}" "$self" --unprivileged "$version" "$work" \
    > "$stage/lib" 2> "$stage/log" || rc=$?
  ours=$(soname "$stage/lib")
  if (( rc != 0 )); then
    tail -n 30 "$stage/log" >&2
    why=$(grep -v '^[[:space:]]*$' "$stage/log" | tail -n1 | cut -c1-200) || true
    (( rc != 124 && rc != 137 )) || why="timed out after $left s"
    failed "$version" "${why:-exit $rc}"
  elif [[ -z $ours || $ours != "$(soname "$sys")" ]]; then
    failed "$version" "the build is ${ours:-no library}, Hyprland loads $(soname "$sys")"; rc=1
  elif [[ -n $(comm -23 <(symbols "$sys") <(symbols "$stage/lib")) ]]; then
    failed "$version" "the build lacks symbols of the installed library: not the recipe it was built from"; rc=1
  elif [[ $(symbols "$stage/lib") != *planePropsHotspot* ]]; then
    failed "$version" "the build does not send cursor hotspots"; rc=1
  # The stamp last: a library without its stamp is never loaded.
  elif ! { install -d ${own[@]+"${own[@]}"} -m 0755 "$root/$version" &&
           rm -f "$root/$version/stamp" "$root/$version/error" "$root/$version"/libaquamarine.so.* &&
           install ${own[@]+"${own[@]}"} -m 0755 "$stage/lib" "$root/$version/$ours" &&
           stamp_for "$version" > "$stage/stamp" &&
           install ${own[@]+"${own[@]}"} -m 0644 "$stage/stamp" "$root/$version/stamp"; }; then
    failed "$version" "could not install it into $root/$version"; rc=1
  else
    say "$version: built (Hyprland loads it only in a start that asks for the Mac pointer)"
  fi
  rm -rf "$work" "$stage"; work="" stage=""
  return $(( rc != 0 ))
}

# The builds of versions that are not installed any more.
drop_old() {
  local d v now
  now=$(installed)
  for d in "$root"/*/; do
    [[ -d $d ]] || continue
    v=$(basename "$d")
    [[ $v == "$now" ]] || { rm -rf "$d"; say "$v: removed (aquamarine is ${now:-gone})"; }
  done
}

status() {
  local v why
  v=$(installed)
  [[ -n $v ]] || { echo "no aquamarine package in this VM"; return 1; }
  if current "$v"; then echo "built for aquamarine $v"; return 0; fi
  if [[ -s $root/$v/error ]]; then why="build failed: $(head -n1 "$root/$v/error")"
  elif lib_of "$v" > /dev/null; then why="out of date (another patch)"
  else why="not built yet"; fi
  echo "not built for aquamarine $v: $why"
  return 1
}

case ${1:-} in
  --status|--lib|--unprivileged) ;;
  *) [[ $EUID == 0 || -n $P ]] || { echo "omacvm-aquamarine: run as root" >&2; exit 2; } ;;
esac
case ${1:-} in
  --status)
    status
    ;;
  --lib)
    v=$(installed)
    current "$v" || exit 1
    echo "$root/$v"
    ;;
  --remove)
    for d in "$root"/*/; do [[ -d $d ]] && rm -rf "$d"; done
    say "removed; Hyprland runs Omarchy's aquamarine from the next start"
    ;;
  --hook)
    # Only a VM that has a build (it uses the Mac pointer) builds again.
    had=""
    for d in "$root"/*/; do [[ -d $d ]] && had=1; done
    drop_old
    [[ -z $had ]] || build || true
    exit 0   # never fails the update
    ;;
  "")
    drop_old
    build
    ;;
  --unprivileged)
    [[ $EUID != 0 ]] || { echo "omacvm-aquamarine: --unprivileged is not for root" >&2; exit 2; }
    fetch_and_make "$2" "$3"
    ;;
  *)
    echo "usage: omacvm-aquamarine-build [--hook | --lib | --status | --remove]" >&2
    exit 2
    ;;
esac
