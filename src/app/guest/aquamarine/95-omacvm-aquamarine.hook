# OmacVM.app: after an aquamarine update, build OmacVM's aquamarine (cursor
# hotspots, for the Mac pointer) for the new version, in a VM that has a
# build; a failed build never fails the update (Hyprland then runs Omarchy's).
[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Package
Target = aquamarine

[Action]
Description = OmacVM: aquamarine with cursor hotspots for the new version
When = PostTransaction
Exec = /usr/local/lib/omacvm/aquamarine/omacvm-aquamarine-build --hook
