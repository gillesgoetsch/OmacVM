#!/usr/bin/env python3
"""omacvm in Omarchy: the OmacVM control centre.

  omacvm                     the control centre: a floating window in the
                             middle of the display (also from the Omarchy
                             menu and the bar's OmacVM item); Escape or q closes it
  omacvm --here              the control centre in this terminal
  omacvm status [--json]     the features and how they are, as text
  omacvm report [--print | --save FILE]
                             report a problem: what goes into the GitHub issue,
                             without personal data, shown before the browser opens
  omacvm update-system [--yes]
                             update the VM's own system (omarchy update, not
                             OmacVM), then check the graphics before a restart
  omacvm extra-brightness [on|off] [--json]
                             OmacVM.app on a Mac with an XDR display: the VM's
                             main window up to 2x as bright (the Display panel's
                             switch); use with care: much more battery
  omacvm sound [read | press NAME | mode NAME GROUP OPTION | balance PERCENT [OUTPUT] | allow] [--json]
                             OmacVM.app: the Mac's sound outputs as macOS lists
                             them, AirPlay speakers too, and the modes of
                             headphones such as AirPods (read), a switch to one
                             or, for an AirPlay speaker that plays, away from it
                             (press), a mode such as Noise Cancellation of
                             Listening Mode, in macOS's words (mode), the
                             balance of the output, or of OUTPUT (its CoreAudio
                             UID) only while it plays (0 left, 50 centre, 100 right),
                             and the Mac's settings where OmacVM is allowed to
                             read that list (allow); the audio panel runs it
  omacvm --version
  omacvm --window            what the menu, the bar item and the launcher run:
                             as omacvm, and the window waits for Return before
                             it closes when the control centre cannot start

Switching features asks the Mac (OmacVM Bridge); on the Mac the same is
`omacvm enable|disable FEATURE --vm NAME`."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))


def report_cli(args: list) -> int:
    if args[:1] in (["-h"], ["--help"], ["help"]):
        print("omacvm report [--print | --save FILE]\n"
              "  report a problem: what goes into the GitHub issue, without personal data;\n"
              "  shown first, the browser opens only when you say yes (you submit it there)\n"
              "  --print       print it and stop\n"
              "  --save FILE   write it to FILE")
        return 0
    from omacvm_cc import collect, report

    mac = "--mac" in args
    out = None
    if "--save" in args:
        i = args.index("--save")
        if i + 1 >= len(args):
            print("omacvm report: --save FILE", file=sys.stderr)
            return 2
        out = args[i + 1]
    try:
        if mac:
            root = args[args.index("--root") + 1]
            vm = args[args.index("--vm") + 1] if "--vm" in args else ""
            vm_type = args[args.index("--vm-type") + 1] if "--vm-type" in args else ""
            cli = os.path.join(root, "omacvm")
            print("collecting: omacvm check, versions, logs ...", file=sys.stderr)
            known = collect.mac_known(cli)
            rep = report.build(collect.mac_sections(cli, root, vm, vm_type=vm_type), known, "Problem with OmacVM on the Mac")
        else:
            from omacvm_cc.controller import Controller
            c = Controller()
            print("collecting: checks, versions, logs ...", file=sys.stderr)
            c.refresh_mac()
            c.refresh_vm_checks()
            rows = c.rows()
            known = collect.vm_known(c.local, c.bridge if c.linked else None)
            mac_checks = [ch for r in rows for ch in r.checks if ch.side == "mac"]
            rep = report.build(collect.vm_sections(c.local, rows, (c.vm_checks or []) + mac_checks, c.hello),
                               known, f"Problem in OmacVM {c.local.version} ({c.local.vm_type or 'VM'})")
    except report.RedactionFailed as e:
        print(f"omacvm report: redaction failed ({e}): nothing is shown or sent. Please report this as a bug.", file=sys.stderr)
        return 1
    if out:
        with open(out, "w", encoding="utf-8") as f:
            f.write(f"# {rep.title}\n\n{rep.text}")
        print(f"saved: {out}", file=sys.stderr)
        return 0
    print(f"# {rep.title}\n\n{rep.text}")
    print(f"Taken out: {report.taken_out(rep.counts)}", file=sys.stderr)
    if "--print" in args or not sys.stdin.isatty():
        return 0
    try:
        a = input("\nOpen this as a GitHub issue in the browser (you submit it there)? [Y/n] ").strip().lower()
    except EOFError:
        return 0
    if a not in ("", "y", "yes"):
        return 0
    url, cut = report.issue_url(rep)
    import subprocess
    copier = ["pbcopy"] if mac else ["wl-copy"]
    if cut:
        try:
            subprocess.run(copier, input=rep.text, text=True, check=False)
            print("The full report is on the clipboard: paste it into the issue.", file=sys.stderr)
        except OSError:
            pass
    subprocess.Popen(["open" if mac else "xdg-open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return 0


def extra_brightness(args: list) -> int:
    """OmacVM.app's Extra brightness, read or switched from the VM (the Display
    panel runs this). The app answers on this VM's control port; nothing goes
    to the Bridge. Exit 0 done, 1 no answer or an app without it, 2 usage,
    3 not an OmacVM.app VM (or no control port), 4 the app said no (no XDR
    display, GPU safe mode, the VM's window not in front, too many changes)."""
    import json

    want, as_json = None, False
    for a in args:
        if a in ("on", "off") and want is None:
            want = a == "on"
        elif a == "--json":
            as_json = True
        else:
            print("omacvm extra-brightness [on|off] [--json]", file=sys.stderr)
            return 2
    from omacvm_cc import local
    from omacvm_cc import state as S
    from omacvm_cc.bridge import Bridge, BridgeError

    env = S.parse_env(local.read(local.env_file()))
    b = Bridge(env, local.read(os.path.join(local.share(), "VERSION")).strip())
    if env.get("OMACVM_VM_TYPE") != "app" or not b.port_path:
        print("omacvm extra-brightness: only in an OmacVM.app VM (its control port)", file=sys.stderr)
        return 3
    try:
        a = b.extra_brightness(want)
    except BridgeError as e:
        if e.status in (400, 409, 429):
            if as_json:
                print(json.dumps({"error": str(e), "code": e.code}))
            print(f"omacvm extra-brightness: {e}", file=sys.stderr)
            return 4
        print(f"omacvm extra-brightness: {e} (OmacVM.app 3.1.30 or newer answers this)", file=sys.stderr)
        return 1
    state = {k: a.get(k) is True for k in ("display", "safe_mode", "on", "available")}
    if as_json:
        print(json.dumps(state))
    elif not state["display"]:
        print("Extra brightness: not on this Mac (it needs an XDR display)")
    elif state["safe_mode"]:
        print("Extra brightness: off while GPU safe mode is on")
    else:
        print(f"Extra brightness: {'on' if state['on'] else 'off'}")
    return 0


def sound(args: list) -> int:
    """The Mac's sound beyond OmacVM Bridge's /audio (the audio panel runs
    this): the outputs macOS lists, AirPlay speakers too, with the modes of
    headphones that offer them, a press of a device or of a mode, the
    output's balance, and the Mac's Accessibility settings (allow). The app answers on this VM's control port; nothing
    goes to the Bridge. For a read or a press the app opens Control Center on
    the Mac (off screen) for about a second, and a press waits until macOS
    has connected the speaker or selected the mode. Exit 0 done, 1 no answer or an app without it,
    2 usage, 3 not an OmacVM.app VM (or no control port), 4 the app said no
    (OmacVM not allowed under Accessibility, Control Center open on the Mac,
    the VM's window not in front, no such device or option, macOS did not
    switch, no balance)."""
    import json

    usage = "omacvm sound [read | press NAME | mode NAME GROUP OPTION | balance PERCENT [OUTPUT] | allow] [--json]"
    as_json = args[-1:] == ["--json"]   # last, so a device may have any name
    words = args[:-1] if as_json else list(args)
    body, timeout = None, 3.0
    if words == ["read"]:
        body, timeout = {"read": True}, 10.0
    elif words == ["allow"]:
        body = {"allow": True}
    elif len(words) == 2 and words[0] == "press" and words[1]:
        body, timeout = {"press": words[1]}, 25.0
    elif len(words) == 4 and words[0] == "mode" and all(words[1:]):
        body, timeout = {"mode": dict(zip(("device", "group", "option"), words[1:]))}, 15.0
    elif len(words) in (2, 3) and words[0] == "balance":
        try:
            percent = float(words[1])
        except ValueError:
            percent = -1.0
        if not 0 <= percent <= 100 or words[2:] == [""]:
            print(usage, file=sys.stderr)
            return 2
        body = {"balance": {"value": round(percent / 100, 3), "output": "".join(words[2:])}}
    elif words:
        print(usage, file=sys.stderr)
        return 2
    from omacvm_cc import local
    from omacvm_cc import state as S
    from omacvm_cc.bridge import Bridge, BridgeError

    env = S.parse_env(local.read(local.env_file()))
    b = Bridge(env, local.read(os.path.join(local.share(), "VERSION")).strip())
    if env.get("OMACVM_VM_TYPE") != "app" or not b.port_path:
        print("omacvm sound: only in an OmacVM.app VM (its control port)", file=sys.stderr)
        return 3
    try:
        if body and body.get("balance", {}).get("output") == "":
            # Without OUTPUT, the output that plays now.
            body["balance"]["output"] = b.sound(None, timeout).get("output") or ""
        a = b.sound(body, timeout)
    except BridgeError as e:
        if e.status in (400, 403, 409, 501):
            if as_json:
                print(json.dumps({"error": str(e), "code": e.code}))
            print(f"omacvm sound: {e}", file=sys.stderr)
            return 4
        print(f"omacvm sound: {e} (a newer OmacVM.app answers this)", file=sys.stderr)
        return 1
    # Whatever the answer holds, the panel gets these types.
    balance = a.get("balance")
    number = lambda v: isinstance(v, (int, float)) and not isinstance(v, bool)
    state = {"accessibility": a.get("accessibility") is True,
             "output": a["output"] if isinstance(a.get("output"), str) else None,
             "balance": {"value": min(1.0, max(0.0, float(balance["value"]))), "settable": balance.get("settable") is True}
             if isinstance(balance, dict) and number(balance.get("value")) else None}
    if isinstance(a.get("devices"), list):
        state["devices"] = [sound_device(d) for d in a["devices"] if isinstance(d, dict) and isinstance(d.get("name"), str) and d["name"]]
    if as_json:
        print(json.dumps(state))
        return 0
    if not state["accessibility"]:
        print("AirPlay speakers: OmacVM is not allowed under Accessibility on the Mac")
    for d in state.get("devices", []):
        print(f"{'*' if d['selected'] else ' '} {d['name']}")
        for m in d.get("modes", []):
            options = "  ".join(("*" if o["selected"] else "") + o["title"] + ("" if o["enabled"] else " (not offered)") for o in m["options"])
            print(f"    {m['title']}: {options}")
    if state["balance"]:
        print(f"Balance: {round(state['balance']['value'] * 100)}")
    else:
        print("Balance: this output has none")
    return 0


def sound_device(d: dict) -> dict:
    """A device of the app's list with the types the panel expects: its
    modes only when it has some, each group and option with its title."""
    titled = lambda v: isinstance(v, dict) and isinstance(v.get("title"), str) and v["title"] != ""
    out = {"name": d["name"], "selected": d.get("selected") is True}
    modes = []
    for m in d.get("modes") if isinstance(d.get("modes"), list) else []:
        options = [{"title": o["title"], "selected": o.get("selected") is True, "enabled": o.get("enabled") is True}
                   for o in (m.get("options") if titled(m) and isinstance(m.get("options"), list) else []) if titled(o)]
        if options:
            modes.append({"title": m["title"], "options": options})
    if modes:
        out["modes"] = modes
    return out


def notify() -> int:
    """The user timer's run: one notice per new OmacVM version (none while
    update checks are off on the Mac), and the bar item's dot."""
    import json
    import subprocess

    from omacvm_cc.bridge import BridgeError
    from omacvm_cc.controller import Controller
    from omacvm_cc.local import cache_file

    from omacvm_cc.local import take_resume

    # OmacVM.app restarted this VM for an update: the control centre opens and
    # does this VM's part (it takes the marker; nothing is asked again).
    if take_resume(remove=False):
        subprocess.Popen(["omarchy-launch-or-focus-tui", "omacvm", "--window"], start_new_session=True)
        return 0
    c = Controller()
    try:
        c.hello = c.bridge.hello()
        u = c.bridge.updates()
    except BridgeError:
        return 0
    m = u.get("manifest") if isinstance(u.get("manifest"), dict) else None
    c.updates = u
    c.local.save_cache(updates=u)
    c.write_attention(c.rows())
    # Forward only: never a notice for a release older than this VM or the Mac.
    if not u.get("checks_enabled", True) or not m or not c.update_offered():
        return 0
    seen = os.path.join(os.path.dirname(cache_file()), "notified")
    try:
        with open(seen, encoding="utf-8") as f:
            if f.read().strip() == m["version"]:
                return 0
    except OSError:
        pass
    with open(seen, "w", encoding="utf-8") as f:
        f.write(m["version"])
    n = sum(1 for r in c.rows() if r.update)
    r = subprocess.run(["notify-send", "-a", "OmacVM", "-A", "open=Open", "-i", "system-software-update",
                        f"OmacVM {m['version']} is out",
                        f"{n} feature{'s' if n != 1 else ''} change. Open OmacVM and press u to update."],
                       capture_output=True, text=True)
    if r.stdout.strip() == "open":
        subprocess.Popen(["omarchy-launch-or-focus-tui", "omacvm", "--window"], start_new_session=True)
    return 0


def wait_in_window() -> None:
    """Opened from the menu, the bar or the launcher: the window would close
    with the text in it. It waits for Return, Escape or q instead."""
    if os.environ.get("OMACVM_WINDOW") != "1" or not sys.stdin.isatty():
        return
    prompt = "\nPress Return, Escape or q to close."
    try:
        import termios
        import tty
        fd = sys.stdin.fileno()
        old = termios.tcgetattr(fd)
        # Key by key from before the prompt shows (TCSANOW: a key typed early is kept).
        tty.setcbreak(fd, termios.TCSANOW)
    except Exception:   # no termios or not a real terminal: a line will do
        try:
            input(prompt)
        except EOFError:
            pass
        return
    try:
        print(prompt, end="", flush=True)
        while os.read(fd, 1) not in (b"\r", b"\n", b"\x1b", b"q", b""):
            pass
    except OSError:
        pass
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)


def open_window() -> bool:
    """Typed in a terminal on the desktop: the control centre opens in its own
    window, as from the menu or the bar (the window rules float and centre it).
    Not over ssh or outside Hyprland, and not with --here."""
    import shutil
    import subprocess

    if not (os.environ.get("WAYLAND_DISPLAY") and os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")):
        return False
    if os.environ.get("SSH_CONNECTION"):
        return False
    launcher = shutil.which("omarchy-launch-or-focus-tui")
    if not launcher:
        return False
    try:
        subprocess.Popen([launcher, "omacvm", "--window"], start_new_session=True,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        return False
    print("OmacVM opens in its own window (omacvm --here keeps it in this terminal).")
    return True


def main(args: list) -> int:
    here = False
    if args[:1] == ["--window"]:
        os.environ["OMACVM_WINDOW"] = "1"
        args = args[1:]
    elif args[:1] == ["--here"]:
        here = True
        args = args[1:]
    cmd = args[0] if args else ""
    if cmd in ("-h", "--help", "help"):
        print(__doc__.split("\n", 2)[2].rstrip())
        return 0
    if cmd in ("-v", "--version"):
        here = os.path.dirname(os.path.realpath(__file__))
        try:
            with open(os.path.join(here, "..", "VERSION"), encoding="utf-8") as f:
                print(f"OmacVM {f.read().strip()}")
        except OSError:
            print("OmacVM")
        return 0
    if cmd == "report":
        return report_cli(args[1:])
    if cmd == "notify":
        return notify()
    if cmd == "status":
        from omacvm_cc import plain
        return plain.status("--json" in args)
    if cmd == "extra-brightness":
        return extra_brightness(args[1:])
    if cmd == "sound":
        return sound(args[1:])
    if cmd == "update-system":
        from omacvm_cc import system
        rc = system.run(yes="--yes" in args)
        wait_in_window()
        return rc
    if cmd:
        print(f"omacvm: no command '{cmd}' here (omacvm --help); the Mac's omacvm has the others", file=sys.stderr)
        return 2
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        from omacvm_cc import plain
        return plain.status(False)
    if not here and os.environ.get("OMACVM_WINDOW") != "1" and open_window():
        return 0
    # OmacVM's own Textual (src/control/vendor), not pacman's: the version the
    # tests ran with, and nothing a stale package list can keep out.
    from omacvm_cc import vendor
    why = vendor.use()
    try:
        from omacvm_cc import tui
    except Exception as e:   # Textual missing or broken: the same table as text, never an empty window
        from omacvm_cc import plain
        rc = plain.status(False, fallback=True, why=why or f"{type(e).__name__}: {e}")
        wait_in_window()
        return rc
    try:
        return tui.run()
    except Exception as e:   # the screens failed: say why and show the table, never a window that just closes
        print(f"omacvm: the control centre stopped ({type(e).__name__}: {e})", file=sys.stderr)
        from omacvm_cc import plain
        rc = plain.status(False, fallback=False)
        wait_in_window()
        return rc or 1


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
