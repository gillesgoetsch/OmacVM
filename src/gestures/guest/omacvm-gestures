# ---- Swipe out to macOS (#342) ----
# Off until the Mac says "X on" (OmacVM's "Swipe out to macOS" setting on the
# Mac, off by default). A swipe of three or more fingers (Hyprland's workspace
# swipe; a Magic Mouse's comes as four or three) that goes past the first or
# the last workspace of its display goes on to the macOS Space on that side.
# Decided here at the lift, with the workspaces as they were when the swipe
# began (the swipe itself may make a new one): the way the swipe goes is the
# workspaces' way (gestures:workspace_swipe_invert), past the lowest
# workspace = the Space on the left; on the right the first swipe from the
# last workspace makes a new empty one (workspace_swipe_create_new, as
# Hyprland does), a swipe past that empty one goes to the Space on the right.
# The Mac moves (or, without a Space there, does nothing) as ⌃⌥ Esc does.
# With a Mac that says "X on 2" the Mac decides and follows the
# fingers with macOS's own Space swipe: this daemon only tells it where a
# swipe would go, at once and on every workspace change ("E", from
# Hyprland's event socket), and such a swipe never reaches this VM.
# Sideways travel, share of the trackpad's width: Hyprland 0.56 (Omarchy's
# settings) changes the workspace from about 0.11-0.13 (mini, 2026-10-12).
SWIPE_OUT_MIN = env_float("OMACVM_SWIPE_OUT_MIN", 0.12)
SWIPE_OUT_RATIO = 1.5                                      # ... and this much more sideways than up or down
HYPR_WAIT = 0.3                                            # s to wait at the lift for the workspaces read at its start


def hypr_socket():
    """The desktop user's Hyprland socket (the newest instance), or None."""
    user = desktop_user()
    try:
        uid = pwd.getpwnam(user).pw_uid if user else None
    except KeyError:
        uid = None
    if uid is None:
        return None
    socks = glob.glob(f"/run/user/{uid}/hypr/*/.socket.sock")
    return max(socks, key=lambda p: os.stat(os.path.dirname(p)).st_mtime) if socks else None


def hypr(command, sock=None):
    """One request to Hyprland's socket: its reply, JSON for j/ requests; None
    when it does not answer."""
    path = sock or hypr_socket()
    if not path:
        return None
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as c:
            c.settimeout(1)
            c.connect(path)
            c.sendall(command.encode())
            chunks = []
            while True:
                chunk = c.recv(65536)
                if not chunk:
                    break
                chunks.append(chunk)
        reply = b"".join(chunks).decode(errors="replace")
        return json.loads(reply) if command.startswith("j/") else reply
    except (OSError, ValueError):
        return None


def hypr_option(name, default, sock=None):
    """A bool option: Hyprland 0.56 answers {"bool": true}, older ones {"int": 1}."""
    o = hypr(f"j/getoption {name}", sock)
    if not isinstance(o, dict):
        return default
    v = o.get("bool", o.get("int"))
    return v if isinstance(v, bool) else bool(v) if isinstance(v, int) else default


def workspaces_now(sock=None):
    """The focused display's workspaces, as the swipe sees them: {"monitor",
    "active", "ids" (its normal workspaces), "empty" (the active one has no
    windows), "special" (a special workspace is open there), "invert",
    "create_new"}; None when Hyprland does not answer."""
    sock = sock or hypr_socket()
    monitors, spaces = hypr("j/monitors", sock), hypr("j/workspaces", sock)
    if not isinstance(monitors, list) or not isinstance(spaces, list):
        return None
    m = next((m for m in monitors if isinstance(m, dict) and m.get("focused")), None)
    if not m or not isinstance(m.get("activeWorkspace"), dict):
        return None
    active = m["activeWorkspace"].get("id")
    ids = sorted(w["id"] for w in spaces if isinstance(w, dict) and w.get("monitor") == m.get("name")
                 and isinstance(w.get("id"), int) and w["id"] > 0)
    here = next((w for w in spaces if isinstance(w, dict) and w.get("id") == active), {})
    return {"monitor": m.get("name"), "active": active, "ids": ids,
            "empty": here.get("windows", 0) == 0,
            "special": bool((m.get("specialWorkspace") or {}).get("id")),
            "invert": hypr_option("gestures:workspace_swipe_invert", True, sock),
            "create_new": hypr_option("gestures:workspace_swipe_create_new", True, sock)}


def edge_sides(state):
    """Where a swipe would go from the workspaces now, as (fingers to the
    left, fingers to the right): "left"/"right" (out to that macOS Space) or
    "-" (a workspace swipe here)."""
    if not state or state.get("special") or not isinstance(state.get("active"), int):
        return "-", "-"
    active, ids = state["active"], state.get("ids") or [state["active"]]
    prev = "left" if not any(i < active for i in ids) else "-"
    nxt = "right" if not any(i > active for i in ids) and (state.get("empty") or not state.get("create_new", True)) else "-"
    return (nxt, prev) if state.get("invert", True) else (prev, nxt)


def swipe_out_side(state, dx, dy, width):
    """Where a swipe of dx, dy (touchpad units) goes, given the workspaces at
    its start: "left", "right" or None (a workspace swipe as usual, or no
    swipe at all)."""
    if not state or state.get("special") or not isinstance(state.get("active"), int):
        return None
    if abs(dx) < SWIPE_OUT_MIN * width or abs(dx) < SWIPE_OUT_RATIO * abs(dy):
        return None
    nxt = dx < 0 if state.get("invert", True) else dx > 0   # toward the next workspace
    active, ids = state["active"], state.get("ids") or [state["active"]]
    if not nxt:
        return "left" if not any(i < active for i in ids) else None
    if any(i > active for i in ids):
        return None
    return "right" if state.get("empty") or not state.get("create_new", True) else None


# ---- which swipes switch workspaces: Hyprland's hl.gesture lines ----
# Hyprland (Lua config, 0.55 on) offers no query for its gestures, so they are
# read from the config files in the order Hyprland runs them: hyprland.lua and
# what it requires or dofiles (~/.local/state, ~/.config, then Omarchy's own
# files, as Omarchy's bootstrap sets package.path). Hyprland keeps the first
# gesture for a finger count and way (a later one it would shadow is refused,
# "unset" removes one) and, for a swipe, takes the first of those whose way
# fits (horizontal, left or right, any "swipe"). A swipe out only follows a
# count and way that switch workspaces there: with 3 fingers given to moving
# focus and 4 to workspaces, only 4 fingers swipe out (user, 2026-10-14).
# A count and way that any other sideways gesture uses, even one Hyprland
# would refuse, stays the VM's too: a config can wrap hl.gesture and drop
# lines (one drops OmacVM's own 3-finger line so 3 fingers snap windows), and
# taking a swipe the user gave to something else is the worse mistake.
LUA_STRING = r'"(?:[^"\\]|\\.)*"|' + r"'(?:[^'\\]|\\.)*'"


def lua_code(text):
    """Lua source without its comments (strings kept)."""
    out, i, n = [], 0, len(text)
    while i < n:
        c = text[i]
        if c in "\"'":
            m = re.compile(LUA_STRING).match(text, i)
            j = m.end() if m else n
            out.append(text[i:j])
            i = j
        elif text.startswith("--", i):
            m = re.compile(r"--\[(=*)\[").match(text, i)
            if m:
                j = text.find("]" + m[1] + "]", m.end())
                i = n if j < 0 else j + len(m[1]) + 2
            else:
                j = text.find("\n", i)
                i = n if j < 0 else j
        else:
            out.append(c)
            i += 1
    return "".join(out)


def table_at(code, i):
    """The {...} table that starts at code[i] (strings skipped), or None."""
    depth, j, n = 0, i, len(code)
    while j < n:
        c = code[j]
        if c in "\"'":
            m = re.compile(LUA_STRING).match(code, j)
            j = m.end() if m else n
            continue
        if c == "{":
            depth += 1
        elif c == "}":
            depth -= 1
            if depth == 0:
                return code[i:j + 1]
        j += 1
    return None


def gesture_fields(table):
    """fingers, direction, action ("other" for a function), mods? of one
    hl.gesture table: its own fields only (not those of a function inside)."""
    top, depth, i = [], 0, 0
    while i < len(table):   # the table's own level: depth 1 (strings skipped)
        c = table[i]
        if c in "\"'":
            m = re.compile(LUA_STRING).match(table, i)
            j = m.end() if m else len(table)
            top.append(table[i:j] if depth == 1 else " " * (j - i))
            i = j
            continue
        depth += c in "{([" and 1 or 0
        top.append(c if depth == 1 else " ")
        depth -= c in "})]" and 1 or 0
        i += 1
    top = "".join(top)

    def field(name, pattern):
        m = re.search(r"(?<![\w.])" + name + r"\s*=\s*" + pattern, top)
        return m[1] if m else None
    fingers = field("fingers", r"(\d+)\b")
    direction = field("direction", r"[\"']([A-Za-z]+)[\"']")
    action = field("action", r"[\"']([A-Za-z_]+)[\"']")
    if action is None and re.search(r"(?<![\w.])action\s*=", top):
        action = "other"
    return (int(fingers) if fingers else None, (direction or "").lower(), action,
            bool(re.search(r"(?<![\w.])mods\s*=", top)))


def hypr_lua_files(home, omarchy):
    """(path, code) of Hyprland's config in the order it runs, following
    require("a.b") and dofile("...") with a plain string."""
    roots = [f"{home}/.local/state", f"{home}/.config"] + ([omarchy] if omarchy else [])
    seen, order = set(), []

    def visit(path):
        real = os.path.realpath(path)
        if real in seen or not os.path.isfile(real) or len(seen) > 200:
            return
        seen.add(real)
        try:
            with open(real, errors="replace") as f:
                code = lua_code(f.read())
        except OSError:
            return
        pos = 0
        for m in re.finditer(r"""\b(require|dofile)\s*\(?\s*(["'])([^"']+)\2""", code):
            order.append((real, code[pos:m.start()]))
            pos = m.end()
            name = m[3]
            if m[1] == "dofile":
                visit(name.replace("~", home, 1))
            else:
                for r in roots:
                    p = f"{r}/{name.replace('.', '/')}.lua"
                    if os.path.isfile(p):
                        visit(p)
                        break
        order.append((real, code[pos:]))

    visit(f"{home}/.config/hypr/hyprland.lua")
    return order


# Hyprland's names for a way (dirForString) and the axis each lies on.
WAY_NAMES = {"swipe": "swipe", "left": "left", "l": "left", "right": "right", "r": "right", "up": "up", "u": "up",
             "top": "up", "t": "up", "down": "down", "d": "down", "bottom": "down", "b": "down",
             "horizontal": "horizontal", "horiz": "horizontal", "vertical": "vertical", "vert": "vertical",
             "pinch": "pinch", "pinchin": "pinchin", "zoomin": "pinchin", "pinchout": "pinchout", "zoomout": "pinchout"}
WAY_AXIS = {"left": "horizontal", "right": "horizontal", "horizontal": "horizontal", "up": "vertical",
            "down": "vertical", "vertical": "vertical", "swipe": "swipe", "pinch": "pinch", "pinchin": "pinch",
            "pinchout": "pinch"}


def omarchy_dir(home):
    """Omarchy's own files (omarchy-mac's or the package's), or None."""
    return next((d for d in (f"{home}/.local/share/omarchy", "/usr/share/omarchy")
                 if os.path.isfile(f"{d}/default/hypr/bootstrap.lua")), None)


def hypr_gestures(parts):
    """(fingers, way, action, mods) of each hl.gesture table in these parts."""
    for _, code in parts:
        for m in re.finditer(r"\bhl\s*\.\s*gesture\s*\(\s*(?=\{)", code):
            table = table_at(code, m.end())
            if table:
                fingers, direction, action, mods = gesture_fields(table)
                yield fingers, WAY_NAMES.get(direction), action, mods


def sideways_counts(home):
    """For install.sh: the finger counts a sideways gesture (any action, no
    key held) already uses, in Hyprland's config or any file in
    ~/.config/hypr; None when a count is not written out."""
    parts = hypr_lua_files(home, omarchy_dir(home))
    seen = {path for path, _ in parts}
    for path in sorted(glob.glob(f"{home}/.config/hypr/*.lua")):
        if os.path.realpath(path) not in seen:
            try:
                with open(path, errors="replace") as f:
                    parts.append((path, lua_code(f.read())))
            except OSError:
                pass
    counts = set()
    for fingers, way, action, mods in hypr_gestures(parts):
        if mods or action == "unset" or way not in ("horizontal", "left", "right", "swipe"):
            continue
        if fingers is None:
            return None
        counts.add(fingers)
    return counts


def workspace_swipes(home=None, omarchy=None):
    """Which swipes switch workspaces: {fingers: "l", "r" or "lr"} (fingers
    going left / right), {} for none, None when Hyprland's config cannot be
    read (or one gesture's fingers are not a plain number)."""
    if home is None:
        try:
            home = pwd.getpwnam(desktop_user() or "").pw_dir
        except KeyError:
            return None
    if omarchy is None:
        omarchy = omarchy_dir(home)
    parts = hypr_lua_files(home, omarchy)
    if not parts:
        return None
    gestures = []   # [fingers, direction, action, mods] as Hyprland keeps them
    others = []     # [fingers, direction, mods] of every gesture for something else
    for fingers, direction, action, mods in hypr_gestures(parts):
        if fingers is None:
            if action in ("workspace", None, "other"):
                return None   # a count that is not written out: cannot tell
            continue
        if not direction:
            continue
        if action == "unset":
            gestures = [g for g in gestures if not (g[0] == fingers and g[1] == direction and g[3] == mods)]
            others = [o for o in others if o != [fingers, direction, mods]]
            continue
        if action != "workspace":
            others.append([fingers, direction, mods])
        a = WAY_AXIS[direction]
        if any(g[0] == fingers and g[3] == mods and
               (g[1] == a or g[1] == direction or (a in ("horizontal", "vertical") and g[1] == "swipe"))
               for g in gestures):
            continue   # shadowed: Hyprland refuses it
        gestures.append([fingers, direction, action, mods])
    ways = {}
    for n in sorted({g[0] for g in gestures}):
        for way, word in (("l", "left"), ("r", "right")):
            g = next((g for g in gestures if g[0] == n and not g[3] and g[1] in ("horizontal", word, "swipe")), None)
            if g and g[2] == "workspace" and not any(
                    o[0] == n and not o[2] and o[1] in ("horizontal", word, "swipe") for o in others):
                ways[n] = ways.get(n, "") + way
    return ways


def swipes_line(ways):
    """The "G" line: "G 4lr", "G 3l 4lr", "G -" for none."""
    return "G " + (" ".join(f"{n}{w}" for n, w in sorted(ways.items())) or "-") + "\n"


HYPR_EVENTS = {b"workspace", b"workspacev2", b"focusedmon", b"focusedmonv2", b"createworkspace", b"createworkspacev2",
               b"destroyworkspace", b"destroyworkspacev2", b"moveworkspace", b"moveworkspacev2", b"renameworkspace",
               b"activespecial", b"activespecialv2", b"openwindow", b"closewindow", b"movewindow", b"movewindowv2",
               b"monitoradded", b"monitoraddedv2", b"monitorremoved", b"monitorremovedv2", b"configreloaded"}
EDGE_QUIET = 0.03        # s: a burst of Hyprland's events is read as one change ...
EDGE_BURST = 0.2         # ... for at most this long
EDGE_RECHECK = 30.0      # s: looked at again without an event (a missed one)


LAYOUT_MAX = 65536   # bytes: the display agent's file is a few hundred
RUN_DIR = "/run/user"   # the users' runtime folders (the offline test points it elsewhere)


def mac_layout(uid):
    """OmacVM.app's arrangement of the VM's outputs on the Mac, {output: (x, y, w, h)}
    in points (top-left origin), from the display agent's file in the desktop
    user's runtime folder (omacvm-displays); {} without one (another route, no
    full screen yet). Root reads it only as the user's own plain file."""
    try:
        fd = os.open(f"{RUN_DIR}/{uid}/omacvm/displays.json", os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        return {}
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != uid or st.st_size > LAYOUT_MAX:
            return {}
        data = os.read(fd, LAYOUT_MAX)
    except OSError:
        return {}
    finally:
        os.close(fd)
    try:
        msg = json.loads(data)
    except ValueError:
        return {}
    layout = msg.get("layout") if isinstance(msg, dict) else None
    out = {}
    for o in layout if isinstance(layout, list) else []:
        if not isinstance(o, dict) or not isinstance(o.get("output"), str):
            continue
        try:
            box = tuple(float(o[k]) for k in ("x", "y", "width", "height"))
        except (KeyError, TypeError, ValueError):
            continue
        if all(math.isfinite(v) and abs(v) < 1e6 for v in box) and box[2] > 0 and box[3] > 0:
            out[o["output"]] = box
    return out


def focus_line(sock=None):
    """The answer to "Q": "D x y w h" for Hyprland's focused output on the Mac,
    "D -" when that is not known. Only with two or more outputs on the Mac: with
    one, the Mac's pointer says it as well."""
    user = desktop_user()
    try:
        uid = pwd.getpwnam(user).pw_uid if user else None
    except KeyError:
        uid = None
    monitors = hypr("j/monitors", sock) if uid is not None else None
    m = next((m for m in monitors if isinstance(m, dict) and m.get("focused")), None) if isinstance(monitors, list) else None
    layout = mac_layout(uid) if m else {}
    name = m.get("name") if m else None
    box = layout.get(name) if isinstance(name, str) and len(layout) > 1 else None
    return "D %.0f %.0f %.0f %.0f\n" % box if box else "D -\n"


def answer_focus(send):
    """"Q" from the Mac: the focused output, off the frame loop's thread."""
    def run():
        try:
            line = focus_line()
            if send:
                send(line.encode())
        except OSError:
            pass   # the connection is going
    threading.Thread(target=run, daemon=True).start()


class SwipeOut:
    def __init__(self):
        self.on = False
        self.version = 1         # 2: the Mac takes the swipe ("X on 2"), this daemon only says where it goes
        self.send = None         # run() sets it: a line to the Mac (any thread)
        self.start = self.end = None
        self.box = {}            # the workspaces at this swipe's start ("state"; a thread reads them)
        self.reader = None
        self.said = None         # the last "E" line sent on this connection
        self.gsaid = None        # the last "G" line sent on this connection
        self.fingers = 0         # the most fingers of this swipe (for a Mac from 3.1.0-3.1.5)
        self.waker = None        # (read end, write end): wakes the watcher at once
        self.watcher = None

    def set(self, on, version=1):
        if on != self.on or (on and version != self.version):
            print(f"omacvm-gestures: swipe out to macOS {'on' if on else 'off'}"
                  f"{' (the Mac follows the fingers)' if on and version >= 2 else ''}", flush=True)
        self.on, self.version = on, version
        self.cancel()
        self.said = self.gsaid = None
        if on and version >= 2:
            start = self.watcher is None
            if start:
                self.waker = socket.socketpair()
                self.waker[0].setblocking(False)
                self.watcher = threading.Thread(target=self.watch, daemon=True)
            try:
                self.waker[1].send(b"!")
            except OSError:
                pass
            # A new watcher only after the wake-up: its first look takes it,
            # so it says where swipes go once, not twice.
            if start:
                self.watcher.start()

    def tell(self, state, ways=None):
        """Where swipes go now and which swipes switch workspaces (G, when
        Hyprland's config could be read), to the Mac: only what changed. A
        Mac helper from 3.1.6-3.1.10 skips G and takes any 3+-finger swipe."""
        send = self.send
        if not send or not (self.on and self.version >= 2):
            return
        line = "E %s %s\n" % edge_sides(state)
        gline = swipes_line(ways) if ways is not None else None
        try:
            if gline and gline != self.gsaid:
                send(gline.encode())
                self.gsaid = gline
            if line != self.said:
                send(line.encode())
                self.said = line
        except OSError:
            pass   # the connection is going: run() connects again and the Mac asks anew

    def woken(self, timeout):
        """Waits up to timeout s for a wake-up (set()); True if one came."""
        r, _, _ = select.select([self.waker[0]], [], [], timeout)
        if not r:
            return False
        try:
            while self.waker[0].recv(64):
                pass
        except OSError:
            pass
        return True

    def watch(self):
        """Hyprland's event socket for good (Hyprland may start, stop and
        start again): every workspace change tells the Mac where swipes go."""
        while True:
            if not (self.on and self.version >= 2):
                self.woken(None)
                continue
            sock = hypr_socket()
            if not sock:
                self.tell(None)
                self.woken(2)
                continue
            try:
                with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as ev:
                    ev.connect(os.path.join(os.path.dirname(sock), ".socket2.sock"))
                    self.woken(0)   # events() says it at once anyway
                    self.events(ev, sock)
            except OSError:
                pass
            self.woken(1)

    def events(self, ev, sock):
        """Until Hyprland goes: tell the Mac at once, after each burst of
        workspace events, after a wake-up (a new connection) and now and
        then without one."""
        buf, dirty, last = b"", True, 0.0
        ways = workspace_swipes()   # Hyprland's gestures: read now and after each config reload
        while self.on and self.version >= 2:
            now = time.monotonic()
            if dirty or now - last >= EDGE_RECHECK:
                self.tell(workspaces_now(sock), ways)
                dirty, last = False, now
            r, _, _ = select.select([ev, self.waker[0]], [], [], EDGE_RECHECK)
            if self.waker[0] in r:
                self.woken(0)
                dirty, self.said, self.gsaid = True, None, None
            if ev not in r:
                continue
            data = ev.recv(65536)
            if not data:
                return   # Hyprland went away
            buf += data
            *lines, buf = buf.split(b"\n")
            names = [line.partition(b">>")[0] for line in lines]
            if not any(n in HYPR_EVENTS for n in names):
                continue
            reload = b"configreloaded" in names
            # The rest of the burst (a workspace change is several events):
            # read until it is quiet, at most EDGE_BURST.
            until = time.monotonic() + EDGE_BURST
            while time.monotonic() < until:
                r, _, _ = select.select([ev], [], [], EDGE_QUIET)
                if not r:
                    break
                more = ev.recv(65536)
                if not more:
                    return
                reload = reload or b"configreloaded>>" in buf + more
                buf = (buf + more).rpartition(b"\n")[2]
            if reload:
                ways = workspace_swipes()
            dirty = True

    def cancel(self):
        self.start = self.end = None

    @staticmethod
    def _read(box):
        box["state"] = workspaces_now()
        box["ways"] = workspace_swipes()

    def frame(self, contacts):
        if not self.on or self.version >= 2:
            return
        if len(contacts) >= 3:
            c = (sum(x for _, x, _ in contacts) / len(contacts), sum(y for _, _, y in contacts) / len(contacts))
            if self.start is None:
                self.start, self.box, self.fingers = c, {}, 0
                self.reader = threading.Thread(target=self._read, args=(self.box,), daemon=True)
                self.reader.start()
            self.end = c
            self.fingers = max(self.fingers, len(contacts))
            return
        if self.start is not None:
            start, end = self.start, self.end
            self.cancel()
            self.lift(end[0] - start[0], end[1] - start[1])

    def lift(self, dx, dy):
        if abs(dx) < SWIPE_OUT_MIN * W:
            return   # no swipe: no need to wait for the workspaces
        if self.reader:
            self.reader.join(HYPR_WAIT)
        state = self.box.get("state")
        side = swipe_out_side(state, dx, dy, W)
        if not side or not self.send:
            return
        ways = self.box.get("ways")
        if ways is not None and ("l" if dx < 0 else "r") not in ways.get(self.fingers, ""):
            return   # that many fingers do something else here (Hyprland's gestures)
        print(f"omacvm-gestures: swipe out to the {side} (workspace {state['active']} of {state['ids']} "
              f"on {state['monitor']})", flush=True)
        self.send(f"X {side}\n".encode())
        threading.Thread(target=self.settle, args=(state,), daemon=True).start()

    @staticmethod
    def settle(state, wait=0.4):
        """Hyprland's own swipe may have gone on to a new empty workspace
        meanwhile (past the last one): back to the one the swipe began on,
        so the VM is as it was when the person comes back."""
        time.sleep(wait)
        now = workspaces_now()
        if now and now["monitor"] == state["monitor"] and now["active"] != state["active"] and now["empty"]:
            hypr(f'dispatch hl.dsp.focus({{ workspace = "{state["active"]}" }})')


SWIPE = SwipeOut()


def bridge_token():
    """The Bridge's token in the desktop user's home. This daemon is root:
    only the user's own plain file counts (opened without following a link,
    never waiting on a pipe), so a link there hands it no file of the system."""
    try:
        pw = pwd.getpwnam(os.environ.get("OMACVM_USER") or desktop_user() or "")
        fd = os.open(f"{pw.pw_dir}/.config/omacvm-bridge/token", os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
        try:
            st = os.fstat(fd)
            if not stat.S_ISREG(st.st_mode) or st.st_uid != pw.pw_uid or st.st_size > 4096:
                return ""
            return os.read(fd, 4096).decode().strip()
        finally:
            os.close(fd)
    except (KeyError, OSError, TypeError, UnicodeDecodeError):
        return ""


ROUTES, SYS_NET = "/proc/net/route", "/sys/class/net"


def default_gateway():
    """The IPv4 default gateway the VM uses, from /proc/net/route ("" without
    one): the lowest metric among default routes whose network card has a
    link. When the app switches networks it takes one card's link down; that
    card's route can stay listed (first) for seconds after."""
    best = None
    try:
        with open(ROUTES) as f:
            for line in f.readlines()[1:]:
                p = line.split()
                if len(p) < 7 or p[1] != "00000000" or int(p[3], 16) & 3 != 3:   # RTF_UP | RTF_GATEWAY
                    continue
                try:
                    with open(f"{SYS_NET}/{p[0]}/carrier") as c:
                        if c.read().strip() != "1":
                            continue
                except OSError:
                    pass                                 # no carrier to read: count it
                if best is None or int(p[6]) < best[0]:
                    best = (int(p[6]), socket.inet_ntoa(struct.pack("<I", int(p[2], 16))))
    except (OSError, ValueError):
        pass
    return best[1] if best else ""


def mac_host():
    """(where to connect, the Mac address the helper must have accepted on: both
    proofs name it). OmacVM.app: QEMU's user network's 10.0.2.2 is the Mac's
    127.0.0.1; on its fast network (vmnet, the app picks it at each start) the
    Mac is the gateway 192.168.77.1."""
    if os.environ.get("OMACVM_VM_TYPE") != "app":
        return HOST, HOST
    if not os.environ.get("OMACVM_GESTURES_HOST") and os.path.exists("/run/omacvm/bridged-network"):
        return "10.0.2.2", "127.0.0.1"
    if not os.environ.get("OMACVM_GESTURES_HOST") and default_gateway() == "192.168.77.1":
        return "192.168.77.1", "192.168.77.1"
    return HOST, "127.0.0.1"


# A connection whose path went away (the app switched the VM between its fast
# network and the user network, or the Mac slept) is noticed by TCP keepalive
# in about 5 + 2 * 3 s; an idle one also looks every RECHECK seconds whether the
# way to the Mac changed (a new default gateway) and connects again at once.
KEEPALIVE = (5, 2, 3)   # idle seconds, seconds between probes, probes
RECHECK = 2.0
# Without the Mac's helper (not running yet, waiting for its permissions, an
# update): a try every 2 s for the first 30 s, so a restart or a grant is
# picked up at once, then every 10 s, and one log line per outage.
RETRY_FIRST = 2.0
RETRY_SLOW = 10.0
RETRY_FAST_FOR = 30.0


class Moved(ConnectionError):
    """The way to the Mac changed: connect again now."""


def keepalive(s):
    s.setsockopt(socket.SOL_SOCKET, socket.SO_KEEPALIVE, 1)
    # Linux: TCP_KEEPIDLE; macOS (the offline test): TCP_KEEPALIVE.
    idle = getattr(socket, "TCP_KEEPIDLE", None) or getattr(socket, "TCP_KEEPALIVE", None)
    for opt, v in ((idle, KEEPALIVE[0]), (getattr(socket, "TCP_KEEPINTVL", None), KEEPALIVE[1]),
                   (getattr(socket, "TCP_KEEPCNT", None), KEEPALIVE[2])):
        if opt is not None:
            s.setsockopt(socket.IPPROTO_TCP, opt, v)


def proof(tok, who, addr, gn, mn):
    """HMAC-SHA256(token, "omacvm-gestures <who> <Mac address> <guest nonce> <mac nonce>"), hex.
    With the address, a listener on 127.0.0.1 cannot pass on a proof it got from
    the helper on 10.211.55.2."""
    msg = f"omacvm-gestures {who} {addr} {gn} {mn}"
    return hmac.new(tok.encode(), msg.encode(), hashlib.sha256).hexdigest().encode()


def run(pad, keys, glide):
    # Any VM on the Mac's VM networks can reach the Mac's listener, and on
    # 127.0.0.1 (OmacVM.app) any program on the Mac could listen in its place:
    # both sides prove they know the Bridge's token, the Mac first.
    tok = bridge_token()
    if not tok:
        raise ConnectionError("no Bridge token yet (omacvm apply puts it in ~/.config/omacvm-bridge/token)")
    host, addr = mac_host()
    with socket.create_connection((host, PORT), timeout=5) as s:
        s.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
        keepalive(s)
        gn = secrets.token_hex(16)
        s.sendall(f"C {gn}\n".encode())
        buf = b""
        while b"\n" not in buf and len(buf) < 4096:
            data = s.recv(4096)
            if not data:
                raise ConnectionError(f"{host}:{PORT} closed the connection (OmacVM Gestures on the Mac "
                                      "from before the handshake? omacvm update)")
            buf += data
        line, _, buf = buf.partition(b"\n")
        m = re.fullmatch(rb"M ([0-9a-f]{32}) ([0-9a-f]{64})", line)
        if not m or not hmac.compare_digest(m[2], proof(tok, "mac", addr, gn, m[1].decode())):
            raise ConnectionError(f"{host}:{PORT} did not prove it knows the Bridge's token: not talking to it")
        s.sendall(f"R {int(GESTURES)} {int(GLIDE_ON)} {proof(tok, 'vm', addr, gn, m[1].decode()).decode()}"
                  f"{' ' + NAME if NAME else ''}\n".encode())
        SWIPE.set(False)      # until this Mac says "X on"
        lock = threading.Lock()

        def send(data, s=s):
            with lock:
                s.sendall(data)
        SWIPE.send = send
        CONNECTED.set()
        print(f"omacvm-gestures: connected to {host}:{PORT} (gestures {'on' if GESTURES else 'off'}, "
              f"scroll momentum {'on' if GLIDE_ON else 'off'})", flush=True)
        tick = -1          # forces the first settimeout (create_connection left 5 s)
        recheck = time.monotonic() + RECHECK
        while True:
            # A 2 ms tick (the glide's clock) only while a frame or a held
            # touch waits; otherwise wake every RECHECK seconds (one look at
            # the routing table), so an idle VM is hardly woken.
            want = 0.002 if (pad.pending is not None or glide.held is not None or glide.touch.down) else RECHECK
            if want != tick:
                s.settimeout(want)
                tick = want
            try:
                data = s.recv(65536)
            except socket.timeout:
                data = None
            pad.flush()
            glide.idle()
            now = time.monotonic()
            if now >= recheck:
                recheck = now + RECHECK
                if mac_host() != (host, addr):
                    raise Moved(f"the way to the Mac changed (now {mac_host()[0]}): connecting again")
            if data is None:
                continue
            if not data:
                raise ConnectionError("helper closed the connection")
            buf += data
            *lines, buf = buf.split(b"\n")
            for line in lines:
                p = line.split()
                if not p:
                    continue
                try:
                    handle(p, pad, keys, glide)
                except (ValueError, IndexError):
                    print(f"omacvm-gestures: skipped a malformed line: {line[:80]!r}", file=sys.stderr, flush=True)


def handle(p, pad, keys, glide):
    if p[0] == b"F":
        n = int(p[1])
        contacts = []
        for i in range(n):
            cid, x, y = int(p[2 + 4 * i]), float(p[3 + 4 * i]), float(p[4 + 4 * i])
            contacts.append((cid, OFF_X + round(min(max(x, 0.0), 1.0) * W), OFF_Y + round(min(max(y, 0.0), 1.0) * H)))
        SWIPE.frame(contacts)
        if GLIDE_ON:
            glide.frame(contacts)
        else:
            pad.frame(contacts)
    elif p[0] == b"O":
        set_mac(int(p[1]), int(p[2]), int(p[3]))
    elif p[0] == b"A":
        glide.macos(float(p[1]), float(p[2]))
    elif p[0] == b"W":
        glide.momentum(float(p[1]), float(p[2]))
    elif p[0] == b"P":
        glide.pinch()
    elif p[0] == b"K":
        keys.key(int(p[1]), int(p[2]))
    elif p[0] == b"S":
        state = p[1].decode()
        print(f"omacvm-gestures: capture {state}", flush=True)
        if state != "on":
            SWIPE.cancel()
            glide.release()
            pad.release()
            keys.release()
        if state == "esc":
            escape_notice(p[2].decode() if len(p) > 2 else None)
    elif p[0] == b"X":
        SWIPE.set(p[1] == b"on", int(p[2]) if len(p) > 2 and p[2].isdigit() else 1)
    elif p[0] == b"Q":
        answer_focus(SWIPE.send)


def main():
    ui = make_device()
    pad = Touchpad(ui)
    keys = Keys(make_keyboard())
    glide = Glide(pad)
    print(f"omacvm-gestures: virtual touchpad {ui.device.path}"
          f"{', macOS-native scroll momentum on' if GLIDE_ON else ''}", flush=True)
    serve(pad, keys, glide)


# Set by run() once the Mac's helper took the connection: an outage then
# starts again from the first, quick tries.
CONNECTED = threading.Event()


def retry_wait(outage):
    """Seconds before the next try, `outage` seconds into an outage."""
    return RETRY_FIRST if outage < RETRY_FAST_FOR else RETRY_SLOW


def serve(pad, keys, glide, run=run, sleep=time.sleep, clock=time.monotonic):
    """run() for good: after a lost connection let go of what is held and
    connect again, at once when the way to the Mac changed, else after
    retry_wait(). One log line per outage (the next comes with "connected")."""
    since = None
    while True:
        CONNECTED.clear()
        try:
            run(pad, keys, glide)
        except (OSError, ConnectionError) as err:
            glide.release()
            pad.release()
            keys.release()
            if CONNECTED.is_set():
                since = None
            if isinstance(err, Moved):
                print(f"omacvm-gestures: {err}", file=sys.stderr, flush=True)
                continue
            if since is None:
                since = clock()
                print(f"omacvm-gestures: {err}; trying again (every {RETRY_FIRST:g} s, "
                      f"after {RETRY_FAST_FOR:g} s every {RETRY_SLOW:g} s)", file=sys.stderr, flush=True)
            sleep(retry_wait(clock() - since))


