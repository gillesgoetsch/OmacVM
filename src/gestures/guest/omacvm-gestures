def env_float(name, default):
    """A number from the environment; a malformed value keeps the default."""
    try:
        return float(os.environ.get(name, "") or default)
    except ValueError:
        print(f"omacvm-gestures: {name}={os.environ[name]!r} is not a number, using {default}", file=sys.stderr, flush=True)
        return float(default)


def env_floats(name, default):
    """Several numbers from the environment (space-separated); malformed: the defaults."""
    try:
        v = [float(x) for x in (os.environ.get(name, "") or default).split()]
        if len(v) == len(default.split()):
            return v
    except ValueError:
        pass
    if os.environ.get(name):
        print(f"omacvm-gestures: {name}={os.environ[name]!r} is not {len(default.split())} numbers, using {default!r}",
              file=sys.stderr, flush=True)
    return [float(x) for x in default.split()]


