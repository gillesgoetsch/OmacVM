# 3.0.x (removed in a later version); whoever uses it is told the new one once
# per VM, remembered here.
ESC_HINT_FILE = "/var/lib/omacvm/escape-hint-shown"
_esc_hint_shown = False


def escape_notice(keys):
    """"S esc [<keys>]": no notice (user, 2026-10-12: "never a notice"), but
    for the old ⌃⌥⌘ Esc ("ctrl-opt-cmd" from a 3.0 helper) the new one is
    named once per VM, while that combo still works."""
