def set_mac(natural, w, h):
    """The Mac's scrolling direction and its trackpad's size (1/100 mm = units)."""
    global W, H, OFF_X, OFF_Y, NATURAL
    NATURAL = 1 if natural else -1
    if 2000 < w < 40000 and 2000 < h < 30000:
        W, H = w, h
        OFF_X, OFF_Y = (PAD_W - W) // 2, (PAD_H - H) // 2
    print(f"omacvm-gestures: Mac trackpad {W / RES:.0f} x {H / RES:.0f} mm, "
          f"{'natural' if NATURAL > 0 else 'traditional'} scrolling", flush=True)
SLOTS = 10
TOOLS = [e.BTN_TOOL_FINGER, e.BTN_TOOL_DOUBLETAP, e.BTN_TOOL_TRIPLETAP, e.BTN_TOOL_QUADTAP, e.BTN_TOOL_QUINTTAP]


def make_device():
    caps = {
        e.EV_KEY: [e.BTN_LEFT, e.BTN_TOUCH] + TOOLS,
        e.EV_ABS: [
            (e.ABS_X, AbsInfo(0, 0, PAD_W, 0, 0, RES)),
            (e.ABS_Y, AbsInfo(0, 0, PAD_H, 0, 0, RES)),
            (e.ABS_MT_SLOT, AbsInfo(0, 0, SLOTS - 1, 0, 0, 0)),
            (e.ABS_MT_TRACKING_ID, AbsInfo(0, 0, 65535, 0, 0, 0)),
            (e.ABS_MT_POSITION_X, AbsInfo(0, 0, PAD_W, 0, 0, RES)),
            (e.ABS_MT_POSITION_Y, AbsInfo(0, 0, PAD_H, 0, 0, RES)),
        ],
    }
    # Apple vendor id, Magic Trackpad (USB-C) product id: libinput applies its
    # Apple touchpad handling. INPUT_PROP_BUTTONPAD = clickpad.
    return UInput(caps, name="Apple Inc. Magic Trackpad (OmacVM)", vendor=0x05AC, product=0x0324,
                  version=0x0111, bustype=e.BUS_USB, input_props=[e.INPUT_PROP_POINTER, e.INPUT_PROP_BUTTONPAD])


class Touchpad:
    def __init__(self, ui):
        self.ui = ui
        self.slots = {}          # mac contact id -> slot
        self.next_tid = 1
        self.tool = None
        self.last_write = 0.0
        self.pending = None

    MIN_GAP = 0.003      # seconds between frames: libinput normalizes movement to time,
                         # so frames microseconds apart look like leaps ("touch jump")

    def frame(self, contacts):
        """Write a frame; the same fingers' frames arriving closer than MIN_GAP are
        coalesced (positions are absolute), a lift and a new touch never share
        one frame (libinput rejects that)."""
        ids = {c[0] for c in contacts}
        if contacts and ids == set(self.slots) and time.monotonic() - self.last_write < self.MIN_GAP:
            self.pending = contacts
            return
        self.pending = None
        if contacts and set(self.slots) - ids and ids - set(self.slots):
            self._write([c for c in contacts if c[0] in self.slots])   # lifts first
        self._write(contacts)

    def flush(self):
        if self.pending is not None and time.monotonic() - self.last_write >= self.MIN_GAP:
            contacts, self.pending = self.pending, None
            self._write(contacts)

    def _write(self, contacts):
        ui = self.ui
        ids = {c[0] for c in contacts}
        for cid in [c for c in self.slots if c not in ids]:          # lifted fingers
            ui.write(e.EV_ABS, e.ABS_MT_SLOT, self.slots.pop(cid))
            ui.write(e.EV_ABS, e.ABS_MT_TRACKING_ID, -1)
        free = [s for s in range(SLOTS) if s not in self.slots.values()]
        for cid, x, y in contacts:
            if cid not in self.slots:
                if not free:
                    continue
                self.slots[cid] = free.pop(0)
                ui.write(e.EV_ABS, e.ABS_MT_SLOT, self.slots[cid])
                ui.write(e.EV_ABS, e.ABS_MT_TRACKING_ID, self.next_tid)
                self.next_tid = self.next_tid % 65535 + 1
            ui.write(e.EV_ABS, e.ABS_MT_SLOT, self.slots[cid])
            ui.write(e.EV_ABS, e.ABS_MT_POSITION_X, x)
            ui.write(e.EV_ABS, e.ABS_MT_POSITION_Y, y)
        n = len(self.slots)
        tool = TOOLS[min(n, 5) - 1] if n else None
        if tool != self.tool:
            if self.tool is not None:
                ui.write(e.EV_KEY, self.tool, 0)
            if tool is not None:
                ui.write(e.EV_KEY, tool, 1)
            if (self.tool is None) != (tool is None):
                ui.write(e.EV_KEY, e.BTN_TOUCH, 1 if tool else 0)
            self.tool = tool
        if contacts:
            ui.write(e.EV_ABS, e.ABS_X, contacts[0][1])
            ui.write(e.EV_ABS, e.ABS_Y, contacts[0][2])
        ui.syn()
        self.last_write = time.monotonic()
        if RECORD:
            n = len(contacts)
            ax = sum(c[1] for c in contacts) / n if n else 0
            ay = sum(c[2] for c in contacts) / n if n else 0
            RECORD.write(f"V\t{time.time():.4f}\t{n}\t{ax:.1f}\t{ay:.1f}\n")

    def release(self):
        if self.slots or self.tool:
            self.frame([])


# Scroll momentum's settings (OMACVM_GLIDE_* in a systemd drop-in; defaults = the tuned values).
DEBUG = bool(os.environ.get("OMACVM_GLIDE_DEBUG"))
# OMACVM_GLIDE_RECORD=1: every virtual-touchpad frame (time, fingers, centre)
# to /var/log/omacvm-output.tsv, to compare with the Mac's input recording
# (omacvm-gestures --record on the Mac; docs/experiments/scroll-analysis).
RECORD = open("/var/log/omacvm-output.tsv", "a", buffering=1) if os.environ.get("OMACVM_GLIDE_RECORD") else None
# Seconds without scrolling before the virtual fingers lift. libinput only
# starts a two-finger scroll after the fingers have moved a little; staying
# down through the pauses of slow, fine scrolling avoids paying that again.
HOLD = env_float("OMACVM_GLIDE_HOLD", 0.5)


class TouchScroll:
    """macOS's scroll deltas as two fingers moving on the virtual touchpad: for
    continuous scrolling without fingers on the built-in trackpad (Magic Mouse)."""
    IDS = (100001, 100002)

    def __init__(self, pad):
        self.pad = pad
        self.down = False
        self.last = 0.0
        self.x = self.y = 0.0

    def _place(self):
        self.x, self.y = PAD_W / 2, PAD_H / 2
        self.down = True

    def _frame(self):
        x, y, gap = round(self.x), round(self.y), 1500
        self.pad.frame([(self.IDS[0], x - gap // 2, y), (self.IDS[1], x + gap // 2, y)])

    def scroll(self, dx, dy):
        # macOS's deltas already follow its scrolling direction: content moves
        # with the fingers.
        if not self.down:
            self._place()
            self._frame()
        nx = self.x + dx * POINT_UNITS
        ny = self.y + dy * POINT_UNITS
        if not (1500 < nx < PAD_W - 1500 and 1000 < ny < PAD_H - 1000):
            # Off the edge: hold still for a moment, lift, start again in the middle.
            for _ in range(3):
                self._frame()
                time.sleep(0.008)
            self.pad.frame([])
            self._place()
            self._frame()
            nx, ny = self.x + dx * POINT_UNITS, self.y + dy * POINT_UNITS
        self.x, self.y = nx, ny
        self._frame()
        self.last = time.monotonic()

    def idle(self):
        if self.down and time.monotonic() - self.last > HOLD:
            self.pad.frame([])
            self.down = False


class OneEuro:
    """One Euro filter (Casiez et al.): smooths strongly when slow or still (finger
    jitter), hardly at all when fast (no lag). Values in millimetres."""

    def __init__(self, min_cutoff, beta, d_cutoff=1.0):
        self.min_cutoff, self.beta, self.d_cutoff = min_cutoff, beta, d_cutoff
        self.x = self.dx = self.t = None

    @staticmethod
    def _alpha(cutoff, dt):
        tau = 1.0 / (2 * math.pi * cutoff)
        return 1.0 / (1.0 + tau / dt)

    def __call__(self, x, t):
        if self.x is None:
            self.x, self.dx, self.t = x, 0.0, t
            return x
        dt = max(t - self.t, 1e-4)
        dx = (x - self.x) / dt
        if abs(dx) > abs(self.dx):
            # Fast attack: a finger that speeds up is followed at once (measured:
            # starting from "still", the filter lagged ~100 ms into every flick
            # and the movement it had not caught up with by the lift was lost);
            # slowing down is smoothed as before.
            self.dx = dx
        else:
            a_d = self._alpha(self.d_cutoff, dt)
            self.dx = a_d * dx + (1 - a_d) * self.dx
        a = self._alpha(self.min_cutoff + self.beta * abs(self.dx), dt)
        self.x = a * x + (1 - a) * self.x
        self.t = t
        return self.x


# "min_cutoff beta d_cutoff": smoothing at rest (Hz), how fast it opens with
# speed, and how quickly a change of speed is noticed (Hz).
FILTER_MIN_CUTOFF, FILTER_BETA, FILTER_D_CUTOFF = env_floats("OMACVM_GLIDE_FILTER", "1.5 0.4 8")
# Slow scrolling follows the raw fingers, fast scrolling macOS's own accelerated
# scroll (the "A" lines): below BLEND_V0 mm/s raw, above BLEND_V1 macOS's,
# smoothly blended in between.
BLEND_V0, BLEND_V1 = env_floats("OMACVM_GLIDE_BLEND", "80 160")
# Virtual touchpad units per 1/100 mm of real finger movement while scrolling:
# below 1 keeps the virtual fingers slow, so libinput's touch-jump limit never
# caps a fast scroll; the compositor's scroll factor for the virtual trackpad
# makes up for it (omacvm_glide.lua).
RAW_SCALE = env_float("OMACVM_GLIDE_RAW_SCALE", 0.184)
# Units per macOS point: measured at display scale 2 (1 unit = 0.408 px on
# screen), 2.45 units make 1 macOS point one on-screen pixel, like macOS.
POINT_UNITS = env_float("OMACVM_GLIDE_POINT_UNITS", 2.45)
# How far the glide after a flick carries, relative to macOS's momentum (1 =
# macOS's distance; measured within 5-10 %), and the time constant (s) that
# smooths macOS's momentum steps into a continuous movement.
GLIDE = env_float("OMACVM_GLIDE_DISTANCE", 1.0)
GLIDE_TAU = env_float("OMACVM_GLIDE_TAU", 0.025)
# Top speed of the virtual fingers (units/s): 1000 mm/s, under libinput's
# touch-jump limit (about 20 mm per 12 ms).
MAX_RATE = env_float("OMACVM_GLIDE_MAX_RATE", 100000)

# Self-calibration of slow (raw) scrolling to this Mac's scrolling speed: macOS
# points per millimetre of finger at medium speed (40-120 mm/s), relative to
# the reference Mac OmacVM was tuned on (6.74; MacBook Pro 16", default
# scrolling speed, measured over five recordings).
CAL_REF = 6.74
CAL_FILE = "/var/lib/omacvm/scroll-calibration"


def load_cal():
    try:
        return min(max(float(open(CAL_FILE).read().split()[0]), 0.5), 2.0)
    except (OSError, ValueError, IndexError):
        return 1.0


class Glide:
    """Glide: the real two-finger frames while the fingers touch (precise to
    hundredths of a millimetre, macOS's acceleration blended in when fast), then
    macOS's momentum on the same virtual fingers, which stay down until it has
    died down, so apps add no fling of their own."""
    MOMENTUM_WAIT = 0.15     # seconds to wait for macOS's momentum after a lift

    def __init__(self, pad):
        self.pad = pad
        self.touch = TouchScroll(pad)
        self.contacts = []   # the last real contacts
        self.hist = []       # (time, x, y) of the two-finger centroid, last frames
        self.held = None     # contacts kept down after the real fingers lifted
        self.lifted = 0.0
        self.moved = 0.0     # last momentum step
        self.pending = [0.0, 0.0]   # momentum not yet applied, touchpad units
        self.tick = 0.0
        self.two = None      # current two-finger touch: ids, offsets, mode, filters
        self.adelta = [0.0, 0.0]   # macOS's scroll since the last frame (points)
        self.cal = load_cal()       # slow-scrolling gain for this Mac's scrolling speed
        self.cal_pts = self.cal_mm = 0.0
        self.logged = 0.0

    def frame(self, contacts):
        now = time.monotonic()
        if contacts:
            if self.held is not None:
                # Fingers back during a glide: end the glide's touch first, so
                # the new touch does not continue it (the trackpad reuses ids)
                # and leap back from where the glide had got to.
                self.held = None
                self.pending = [0.0, 0.0]
                self.pad.frame([])
            self.touch.down = False
            if len(contacts) == 2:
                contacts = self.two_fingers(contacts, now)
            elif self.two is not None:
                # Leaving a two-finger scroll (a third finger, a swipe): its
                # virtual positions differ from the raw ones, so end that touch
                # instead of letting the fingers leap (libinput drops leaps as jumps).
                if not self.two["pinch"]:
                    self.pad.frame([])
                self.two = None
            if len(contacts) == 2:
                self.hist = (self.hist + [(now, (contacts[0][1] + contacts[1][1]) / 2,
                                           (contacts[0][2] + contacts[1][2]) / 2)])[-5:]
            else:
                self.hist = []
            self.contacts = contacts
            self.pad.frame(contacts)
            return
        self.calibrate()
        self.two = None
        if len(self.contacts) == 2 and len(self.hist) >= 2:
            # Two fingers lifted: stay down, macOS's momentum may follow.
            self.held = [list(c) for c in self.contacts]
            self.lifted = now
            self.pending = [0.0, 0.0]
            self.contacts = []
            return
        self.contacts, self.hist = [], []
        self.pad.frame([])

    def two_fingers(self, contacts, now):
        """Scroll stays scroll: the fingers' spacing is fixed at touch-down and the
        filtered centre moves; a pinch (macOS's call) switches to raw fingers."""
        ids = (contacts[0][0], contacts[1][0])
        cx = (contacts[0][1] + contacts[1][1]) / 2
        cy = (contacts[0][2] + contacts[1][2]) / 2
        t = self.two
        if t is None or t["ids"] != ids:
            t = self.two = {"ids": ids, "pinch": False,
                            "off": [(c[1] - cx, c[2] - cy) for c in contacts],
                            "fx": OneEuro(FILTER_MIN_CUTOFF, FILTER_BETA, FILTER_D_CUTOFF),
                            "fy": OneEuro(FILTER_MIN_CUTOFF, FILTER_BETA, FILTER_D_CUTOFF)}
        if t["pinch"]:
            if t.pop("restart", False):
                self.pad.frame([])   # lift; the raw fingers below begin a new touch
            return contacts
        fx = t["fx"](cx / RES, now) * RES
        fy = t["fy"](cy / RES, now) * RES
        ad, self.adelta = self.adelta, [0.0, 0.0]        # macOS's scroll since the last frame
        if "vx" not in t:
            t.update(vx=fx, vy=fy, px=fx, py=fy)
        else:
            dx, dy = fx - t["px"], fy - t["py"]
            # Finger speed (mm/s) from the filter's own speed estimate.
            v = math.hypot(t["fx"].dx or 0.0, t["fy"].dx or 0.0)
            x = min(1.0, max(0.0, (v - BLEND_V0) / (BLEND_V1 - BLEND_V0)))
            w = x * x * (3 - 2 * x)
            raw = RAW_SCALE * self.cal * NATURAL
            t["vx"] += (1 - w) * dx * raw + w * ad[0] * POINT_UNITS
            t["vy"] += (1 - w) * dy * raw + w * ad[1] * POINT_UNITS
            if 40 <= v < 120:          # calibration samples
                self.cal_mm += math.hypot(dx, dy) / RES
                self.cal_pts += math.hypot(ad[0], ad[1])
            if DEBUG and now - self.logged > 0.3:
                print(f"glide: {v:.0f} mm/s, macOS share {w:.2f}", flush=True)
                self.logged = now
            t.update(px=fx, py=fy)
        vx = min(max(t["vx"], 2000), PAD_W - 2000)
        vy = min(max(t["vy"], 2000), PAD_H - 2000)
        return [(c[0], round(vx + o[0]), round(vy + o[1])) for c, o in zip(contacts, t["off"])]

    def macos(self, dx, dy):
        """macOS's scroll for the current touch (points, with its acceleration)."""
        if self.held is not None:
            # Arrived just after the lift (measured: ~10 % of a touch's steps):
            # it belongs to the glide.
            self.pending[0] += dx * POINT_UNITS * GLIDE
            self.pending[1] += dy * POINT_UNITS * GLIDE
            self.moved = time.monotonic()
            return
        self.adelta[0] += dx
        self.adelta[1] += dy

    def calibrate(self):
        """After a touch: once enough medium-speed movement is collected, move
        the slow-scrolling gain towards this Mac's points per mm / reference."""
        if self.cal_mm < 20:
            return
        g = min(max(self.cal_pts / self.cal_mm / CAL_REF, 0.5), 2.0)
        self.cal = 0.8 * self.cal + 0.2 * g
        self.cal_pts = self.cal_mm = 0.0
        try:
            os.makedirs(os.path.dirname(CAL_FILE), exist_ok=True)
            with open(CAL_FILE, "w") as f:
                f.write(f"{self.cal:.4f}\n")
        except OSError:
            pass
        if DEBUG:
            print(f"glide: calibration {g:.2f} this touch, slow-scrolling gain {self.cal:.3f}", flush=True)

    def pinch(self):
        """macOS recognized a pinch: the current two-finger touch goes raw. libinput
        never turns a running scroll into a pinch, so the touch starts afresh."""
        if self.two is not None and not self.two["pinch"]:
            self.two["pinch"] = True
            self.two["restart"] = True
            if DEBUG:
                print("glide: pinch", flush=True)

    def momentum(self, dx, dy):
        if self.held is None:
            self.touch.scroll(dx, dy)      # no fingers just lifted: Magic Mouse & co.
            return
        self.pending[0] += dx * POINT_UNITS * GLIDE
        self.pending[1] += dy * POINT_UNITS * GLIDE
        self.moved = time.monotonic()
        self.drain()

    def drain(self):
        """Apply pending momentum in small, evenly timed steps."""
        if self.held is None or not (self.pending[0] or self.pending[1]):
            return
        now = time.monotonic()
        dt = now - self.tick
        if dt < 0.002:
            return
        dt = min(dt, 0.02)
        self.tick = now
        px, py = self.pending
        d = math.hypot(px, py)
        if d < 0.25:
            self.pending = [0.0, 0.0]
            return
        # The share of what is left that matches the time since the last tick:
        # a continuous glide easing out exponentially (time constant GLIDE_TAU),
        # the same movement in every display frame however the ticks fall.
        step = min(d * (1 - math.exp(-dt / GLIDE_TAU)), MAX_RATE * dt) if d > 1 else d
        k = step / d
        sx, sy = px * k, py * k
        if not all(500 <= c[1] + sx <= PAD_W - 500 and 500 <= c[2] + sy <= PAD_H - 500 for c in self.held):
            self.pending = [0.0, 0.0]      # at the edge: stop here, lift after the hold
            return
        for c in self.held:
            c[1] += sx
            c[2] += sy
        self.pending = [px - sx, py - sy]
        self.pad.frame([(c[0], round(c[1]), round(c[2])) for c in self.held])

    def idle(self):
        self.touch.idle()
        if self.held is None:
            return
        self.drain()
        now = time.monotonic()
        if (self.moved < self.lifted and now - self.lifted > self.MOMENTUM_WAIT) or \
           (self.moved >= self.lifted and now - self.moved > HOLD):
            self.pad.frame([])
            self.held = None

    def release(self):
        self.held = None
        self.two = None
        self.contacts, self.hist = [], []


def make_keyboard():
    """A virtual keyboard for the Mac's Cmd shortcuts on UTM (sent as Super+key)."""
    return UInput({e.EV_KEY: list(range(1, 249))}, name="OmacVM keyboard (Mac shortcuts)")


class Keys:
    def __init__(self, ui):
        self.ui, self.down = ui, set()

    def key(self, code, value):
        if not 0 < code < 249:
            return
        self.ui.write(e.EV_KEY, code, value)
        self.ui.syn()
        if value:
            self.down.add(code)
        else:
            self.down.discard(code)

    def release(self):
        for code in list(self.down):
            self.key(code, 0)


def desktop_user():
    """OMACVM_GESTURES_USER, else the owner of the running Wayland session."""
    if USER:
        return USER
    for sock in glob.glob("/run/user/*/wayland-*"):
        if not sock.endswith(".lock"):
            return pwd.getpwuid(os.stat(sock).st_uid).pw_name
    return None


def notify(text):
    user = desktop_user()
    if not user:
        return
    uid = subprocess.run(["id", "-u", user], capture_output=True, text=True).stdout.strip()
    if not uid:
        return
    env = dict(os.environ, DBUS_SESSION_BUS_ADDRESS=f"unix:path=/run/user/{uid}/bus", XDG_RUNTIME_DIR=f"/run/user/{uid}")
    subprocess.Popen(["runuser", "-u", user, "--", "notify-send", "-a", "Trackpad", "-t", "2500", text],
                     env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def bridge_token():
    try:
        home = pwd.getpwnam(os.environ.get("OMACVM_USER") or desktop_user() or "").pw_dir
        with open(f"{home}/.config/omacvm-bridge/token") as f:
            return f.read().strip()
    except (KeyError, OSError, TypeError):
        return ""


def default_gateway():
    """The IPv4 default gateway, from /proc/net/route ("" without one)."""
    try:
        with open("/proc/net/route") as f:
            for line in f.readlines()[1:]:
                p = line.split()
                if len(p) > 2 and p[1] == "00000000":
                    return socket.inet_ntoa(struct.pack("<I", int(p[2], 16)))
    except (OSError, ValueError):
        pass
    return ""


def mac_host():
    """(where to connect, the Mac address the helper must have accepted on: both
    proofs name it). OmacVM.app: QEMU's user network's 10.0.2.2 is the Mac's
    127.0.0.1; with the fast network (vmnet, the app picks it at each start) the
    Mac is the gateway 192.168.64.1, as on UTM."""
    if os.environ.get("OMACVM_VM_TYPE") != "app":
        return HOST, HOST
    if not os.environ.get("OMACVM_GESTURES_HOST") and default_gateway() == "192.168.64.1":
        return "192.168.64.1", "192.168.64.1"
    return HOST, "127.0.0.1"


def proof(tok, who, addr, gn, mn):
    """HMAC-SHA256(token, "omacvm-gestures <who> <Mac address> <guest nonce> <mac nonce>"), hex.
    With the address, a listener on 127.0.0.1 cannot pass on a proof it got from
    the helper on 10.211.55.2."""
    msg = f"omacvm-gestures {who} {addr} {gn} {mn}"
    return hmac.new(tok.encode(), msg.encode(), hashlib.sha256).hexdigest().encode()


def run(pad, keys, glide):
    # Any VM on the Mac's VM networks can reach the Mac's listener, and on
    # 127.0.0.1 (OmacVM.app) any program on the Mac could listen in its place:
    # both sides prove they know the Bridge's token, the Mac first.
    tok = bridge_token()
    if not tok:
        raise ConnectionError("no Bridge token yet (omacvm apply puts it in ~/.config/omacvm-bridge/token)")
    host, addr = mac_host()
    with socket.create_connection((host, PORT), timeout=5) as s:
        s.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
        gn = secrets.token_hex(16)
        s.sendall(f"C {gn}\n".encode())
        buf = b""
        while b"\n" not in buf and len(buf) < 4096:
            data = s.recv(4096)
            if not data:
                raise ConnectionError(f"{host}:{PORT} closed the connection (OmacVM Gestures on the Mac "
                                      "from before the handshake? omacvm update)")
            buf += data
        line, _, buf = buf.partition(b"\n")
        m = re.fullmatch(rb"M ([0-9a-f]{32}) ([0-9a-f]{64})", line)
        if not m or not hmac.compare_digest(m[2], proof(tok, "mac", addr, gn, m[1].decode())):
            raise ConnectionError(f"{host}:{PORT} did not prove it knows the Bridge's token: not talking to it")
        # An OmacVM.app VM says so after its name ("=": none): on the fast
        # network it comes in on UTM's address, and the Mac must not count it
        # as a UTM VM. Mac helpers from before read only up to the name.
        app = " app" if os.environ.get("OMACVM_VM_TYPE") == "app" else ""
        s.sendall(f"R {int(GESTURES)} {int(GLIDE_ON)} {proof(tok, 'vm', addr, gn, m[1].decode()).decode()}"
                  f"{' ' + (NAME or '=') if NAME or app else ''}{app}\n".encode())
        print(f"omacvm-gestures: connected to {host}:{PORT} (gestures {'on' if GESTURES else 'off'}, "
              f"scroll momentum {'on' if GLIDE_ON else 'off'})", flush=True)
        tick = -1          # forces the first settimeout (create_connection left 5 s)
        while True:
            # A 2 ms tick (the glide's clock) only while a frame or a held
            # touch waits; otherwise block, so an idle VM is not woken.
            want = 0.002 if (pad.pending is not None or glide.held is not None or glide.touch.down) else None
            if want != tick:
                s.settimeout(want)
                tick = want
            try:
                data = s.recv(65536)
            except socket.timeout:
                pad.flush()
                glide.idle()
                continue
            pad.flush()
            glide.idle()
            if not data:
                raise ConnectionError("helper closed the connection")
            buf += data
            *lines, buf = buf.split(b"\n")
            for line in lines:
                p = line.split()
                if not p:
                    continue
                try:
                    handle(p, pad, keys, glide)
                except (ValueError, IndexError):
                    print(f"omacvm-gestures: skipped a malformed line: {line[:80]!r}", file=sys.stderr, flush=True)


def handle(p, pad, keys, glide):
    if p[0] == b"F":
        n = int(p[1])
        contacts = []
        for i in range(n):
            cid, x, y = int(p[2 + 4 * i]), float(p[3 + 4 * i]), float(p[4 + 4 * i])
            contacts.append((cid, OFF_X + round(min(max(x, 0.0), 1.0) * W), OFF_Y + round(min(max(y, 0.0), 1.0) * H)))
        if GLIDE_ON:
            glide.frame(contacts)
        else:
            pad.frame(contacts)
    elif p[0] == b"O":
        set_mac(int(p[1]), int(p[2]), int(p[3]))
    elif p[0] == b"A":
        glide.macos(float(p[1]), float(p[2]))
    elif p[0] == b"W":
        glide.momentum(float(p[1]), float(p[2]))
    elif p[0] == b"P":
        glide.pinch()
    elif p[0] == b"K":
        keys.key(int(p[1]), int(p[2]))
    elif p[0] == b"S":
        state = p[1].decode()
        print(f"omacvm-gestures: capture {state}", flush=True)
        if state != "on":
            glide.release()
            pad.release()
            keys.release()
        if state == "esc":
            notify("Trackpad gestures → macOS (⌃⌥⌘ Esc to take them back)")


def main():
    ui = make_device()
    pad = Touchpad(ui)
    keys = Keys(make_keyboard())
    glide = Glide(pad)
    print(f"omacvm-gestures: virtual touchpad {ui.device.path}"
          f"{', macOS-native scroll momentum on' if GLIDE_ON else ''}", flush=True)
    while True:
        try:
            run(pad, keys, glide)
        except (OSError, ConnectionError) as err:
            glide.release()
            pad.release()
            keys.release()
            print(f"omacvm-gestures: {err}; retrying", file=sys.stderr, flush=True)
            time.sleep(2)


if __name__ == "__main__":
    main()
