#!/bin/bash
# OmacVM prebuilt VM, first boot (omacvm-firstboot.service, before the login
# screen). Once:
#  * grows the system partition and btrfs to the whole disk
#  * with a disk labelled OMACVM-SEED (omacvm build --prebuilt makes it):
#    applies it: user, password hash, root's SSH key, hostname, keyboard,
#    timezone, language, display mode, the Mac's network for SSH
#  * without one (an image downloaded by hand): asks on the console for the
#    user name, password, keyboard and timezone
# then creates the user from the image's home template and disables itself.
# SSH host keys and the machine id are new on this boot (sshdgenkeys,
# systemd: the image has none).
set -uo pipefail
P=/var/lib/omacvm/prebuilt
[[ -f $P/pending ]] || exit 0
LOG=/var/log/omacvm-firstboot.log
exec > >(tee -a "$LOG") 2>&1
log() { printf '\033[1;32m==>\033[0m %s\n' "$*"; }
PLACEHOLDER=$(sed -n 's/^OMACVM_PREBUILT_USER=//p' "$P/image")
S=/usr/local/share/omacvm

# ---------- the disk ----------
grow_disk() {
  local part disk n
  part=$(findmnt -no SOURCE / | sed 's/\[.*//')
  disk=/dev/$(lsblk -no PKNAME "$part" | head -1)
  n=$(cat "/sys/class/block/$(basename "$part")/partition" 2>/dev/null) || return 0
  [[ -b $disk && -n $n ]] || return 0
  sfdisk --relocate gpt-bak-std "$disk" >/dev/null 2>&1 || true
  echo ", +" | sfdisk --force --no-reread --no-tell-kernel -N "$n" "$disk" >/dev/null 2>&1 || true
  partx -u -n "$n" "$disk" 2>/dev/null || true
  btrfs filesystem resize max / >/dev/null 2>&1 || true
  log "disk: $(df -h --output=size / | tail -1 | tr -d ' ')"
}
grow_disk

# ---------- the answers ----------
NAME=""; FULL=""; HASH=""; KEY=""; HOST=omarchy; KB=us; TZ=UTC; LANGV=en_US.UTF-8; MODE=""; NET=""
seed=""
for _ in $(seq 20); do seed=$(blkid -L OMACVM-SEED 2>/dev/null || blkid -L OMACVM_SEED 2>/dev/null) && break; sleep 1; done
if [[ -n $seed ]]; then
  log "seed from the Mac ($seed)"
  M=/run/omacvm-seed; mkdir -p "$M"
  mount -o ro "$seed" "$M" || { echo "could not mount the seed" >&2; exit 1; }
  f=$(ls "$M"/seed.env "$M"/SEED.ENV "$M"/SEED.ENV\;1 2>/dev/null | head -1)
  # KEY=base64 lines, nothing is executed
  val() { local v; v=$(sed -n "s/^$1=//p" "$f" | head -1); [[ -n $v ]] && base64 -d <<<"$v" 2>/dev/null; }
  NAME=$(val USER); FULL=$(val FULLNAME); HASH=$(val HASH); KEY=$(val ROOT_KEY)
  HOST=$(val HOSTNAME); KB=$(val KEYBOARD); TZ=$(val TIMEZONE); LANGV=$(val LANG); MODE=$(val DISPLAY); NET=$(val NET)
  umount "$M"
  : "${HOST:=omarchy}" "${KB:=us}" "${TZ:=UTC}" "${LANGV:=en_US.UTF-8}"
fi

# Root's key and SSH from the Mac first: sshd runs alongside.
if [[ -n $KEY ]]; then
  log "root's SSH key (from the Mac)"
  install -d -m700 /root/.ssh
  printf '%s\n' "$KEY" > /root/.ssh/authorized_keys; chmod 600 /root/.ssh/authorized_keys
fi
if [[ $NET =~ ^[0-9]+\.[0-9]+\.[0-9]+\.0/24$ ]]; then
  ufw allow from "$NET" to any port 22 proto tcp comment "omacvm: ssh from the Mac" >/dev/null 2>&1 || true
fi

if [[ -z $NAME ]]; then
  # ---------- console setup (no seed, or one without a user) ----------
  T=${OMACVM_FIRSTBOOT_TTY:-/dev/tty1}
  export TERM=linux
  stty sane < "$T" 2>/dev/null || true
  plymouth quit 2>/dev/null || true
  chvt 1 2>/dev/null || true
  G=$(command -v gum)
  ask() {   # PROMPT DEFAULT [--password]
    local a
    if [[ -n $G ]]; then
      a=$("$G" input --prompt "$1: " --value "$2" ${3:+--password} --width 60 < $T 2>$T) || a=""
    else
      if [[ -n ${3:-} ]]; then read -r -s -p "$1: " a < $T; echo
      else read -r -e -p "$1 [$2]: " a < $T; fi
      [[ -n $a ]] || a=$2
    fi
    printf '%s' "$a"
  }
  pick() {   # PROMPT DEFAULT < choices
    local a
    # the default first, so Return keeps it
    if [[ -n $G ]]; then a=$({ echo "$2"; grep -vx -- "$2"; } | "$G" filter --header "$1 (type to search, Return picks)" --height 15 2>$T) || a=""
    else read -r -e -p "$1 [$2]: " a < $T; fi
    printf '%s' "${a:-$2}"
  }
  # Straight to the console: through the log pipe they would arrive after gum
  # has put the terminal in raw mode.
  clear > "$T"
  printf '\n  \033[1mOmacVM: set up this Omarchy VM\033[0m\n\n' > "$T"
  printf '  Your user, password, keyboard and timezone. Afterwards, on your Mac:\n' > "$T"
  printf '    omacvm apply --vm "NAME OF THIS VM"\n' > "$T"
  printf '  sets up the Mac side and the features (it shows one command to run here first).\n\n' > "$T"
  while :; do
    NAME=$(ask "user name (lower case)" "")
    [[ $NAME =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] && ! id "$NAME" >/dev/null 2>&1 && break
    echo "  lower-case letters, digits, - and _, not a name that exists" > "$T"
  done
  FULL=$(ask "full name" "$NAME")
  while :; do
    p1=$(ask "password" "" pw); p2=$(ask "password again" "" pw)
    [[ -n $p1 && $p1 == "$p2" ]] && break
    echo "  the passwords differ or are empty" > "$T"
  done
  HASH=$(printf '%s' "$p1" | openssl passwd -6 -stdin); unset p1 p2
  layouts=$(sed -n '/^! layout/,/^$/p' /usr/share/X11/xkb/rules/base.lst 2>/dev/null | awk 'NR > 1 && NF { l = $1; $1 = ""; printf "%-8s%s\n", l, $0 }')
  KB=$(pick "keyboard layout" "$(grep -m1 '^us ' <<<"$layouts" || echo us)" <<<"$layouts" | awk '{ print $1 }')
  TZ=$(timedatectl list-timezones 2>/dev/null | pick "timezone" UTC)
  HOST=$(ask "hostname" omarchy)
fi

# ---------- apply ----------
[[ $NAME =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || { echo "first boot: no valid user name" >&2; exit 1; }
[[ $HASH == '$6$'* ]] || { echo "first boot: no password hash" >&2; exit 1; }
log "user $NAME"
groups=$(cat "$P/groups" 2>/dev/null)
useradd -M -d "/home/$NAME" -u 1000 ${groups:+-G "$groups"} -s /bin/bash -c "$FULL" "$NAME"
usermod -p "$HASH" "$NAME"
cp -a --reflink=auto "$P/home" "/home/$NAME"
if [[ -n $PLACEHOLDER && $PLACEHOLDER != "$NAME" ]]; then
  grep -rlIF "/home/$PLACEHOLDER" "/home/$NAME" 2>/dev/null | while IFS= read -r f; do
    sed -i "s|/home/$PLACEHOLDER|/home/$NAME|g" "$f"
  done
  # Links too: Omarchy's wallpaper and btop theme are absolute links into the
  # home (left alone they point at the placeholder: a black desktop).
  find "/home/$NAME" -xdev -type l \( -lname "/home/$PLACEHOLDER" -o -lname "/home/$PLACEHOLDER/*" \) -print0 2>/dev/null |
    while IFS= read -r -d '' l; do
      t=$(readlink "$l"); ln -sfn "/home/$NAME${t#/home/$PLACEHOLDER}" "$l"
    done
fi
G2=/home/$NAME/.gitconfig
[[ -f $G2 ]] && sed -i "s/^\(\s*name = \)OmacVM User$/\1$(sed 's/[\/&]/\\&/g' <<<"$FULL")/" "$G2"
chown -R -h "$NAME:$NAME" "/home/$NAME"
chmod 700 "/home/$NAME"
# Omarchy's default keyring (its installer makes it for a full build; the
# image's home has none): without it Chromium asks for a keyring password.
if [[ -x $S/guest/default-keyring.sh ]]; then
  log "keyring: $("$S/guest/default-keyring.sh" setup "$NAME" "/home/$NAME" 2>&1)"
fi
sed -i "s/^OMACVM_USER=.*/OMACVM_USER=$NAME/" /etc/omacvm/env 2>/dev/null || true
# Omarchy's login screen logs in as SDDM's last user.
if [[ -d /var/lib/sddm ]]; then
  st=/var/lib/sddm/state.conf
  if grep -q '^User=' "$st" 2>/dev/null; then sed -i "s/^User=.*/User=$NAME/" "$st"
  else
    sess=/usr/share/wayland-sessions/hyprland-uwsm.desktop
    { echo "[Last]"; [[ -f $sess ]] && echo "Session=$sess"; echo "User=$NAME"; } > "$st"
  fi
  chown sddm:sddm "$st" 2>/dev/null || true
fi

log "hostname $HOST"
[[ $HOST =~ ^[A-Za-z0-9][A-Za-z0-9-]{0,62}$ ]] || HOST=omarchy
echo "$HOST" > /etc/hostname
printf '127.0.0.1 localhost\n::1 localhost\n127.0.1.1 %s.localdomain %s\n' "$HOST" "$HOST" > /etc/hosts
hostname "$HOST" 2>/dev/null || true

if [[ -f /usr/share/zoneinfo/$TZ ]]; then
  log "timezone $TZ"; ln -sf "/usr/share/zoneinfo/$TZ" /etc/localtime
fi
if [[ $LANGV != en_US.UTF-8 ]] && grep -q "^${LANGV} " /usr/share/i18n/SUPPORTED 2>/dev/null; then
  log "language $LANGV"
  sed -i "s/^#${LANGV}/${LANGV}/" /etc/locale.gen
  locale-gen >/dev/null 2>&1 || true
  echo "LANG=$LANGV" > /etc/locale.conf
fi

read -r layout variant <<<"$KB"
if [[ -n $layout ]]; then
  log "keyboard $layout${variant:+ ($variant)}"
  keymap=$(awk -v l="$layout" -v v="${variant:-}" \
    '!/^#/ && $2 == l && ($4 == v || (v == "" && $4 == "-")) { print $1; exit }' /usr/share/systemd/kbd-model-map)
  echo "KEYMAP=${keymap:-us}" > /etc/vconsole.conf
  if [[ -x $S/keyboard/guest/install.sh ]]; then "$S/keyboard/guest/install.sh" "$NAME" "$layout" "${variant:-}" >/dev/null 2>&1 || true; fi
fi

# UTM and VMware Fusion: the display mode is fixed in monitors.lua (the Mac's).
M=/home/$NAME/.config/hypr/monitors.lua
if [[ $MODE =~ ^[0-9]+x[0-9]+(@[0-9.]+)?$ && -f $M ]]; then
  log "display $MODE"
  sed -i "s|^\(hl.monitor({ output = \"Virtual-1\", mode = \)\"[^\"]*\"|\1\"$MODE\"|" "$M"
fi

rm -rf "$P/home" "$P/pending"
systemctl disable omacvm-firstboot.service >/dev/null 2>&1 || true
log "first boot done: log in as $NAME"
